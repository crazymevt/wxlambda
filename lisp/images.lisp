(in-package #:wxlambda)
(defclass image-resource () ((handle :initform nil :reader handle)))
(defclass image (image-resource) ())
(defclass bitmap (image-resource) ())
(defclass static-bitmap (window) ())
(defmethod handle :around ((object image-resource))
  (or (and (slot-boundp object 'handle) (call-next-method)) (error 'native-error :message "Image resource construction did not complete")))
(defmethod initialize-instance :around ((object image-resource) &rest initargs)
  (declare (ignore initargs))
  (when (or (typep object 'event-handler) (typep object 'owned-event) (typep object 'menu-resource)
            (/= 1 (count-if (lambda (kind) (typep object kind)) '(image bitmap))))
    (error "Image resource requires exactly one image/bitmap ancestry and no other native resource ancestry"))
  (require-active-application)
  (when (and (slot-boundp object 'handle) (slot-value object 'handle)) (error "Image resource already initialized"))
  (let* ((*initializing-handlers* (cons object *initializing-handlers*))
         (parent-context *construction-context*)
         (*construction-context* (list (list object))) (complete nil))
    (unwind-protect
         (multiple-value-prog1 (call-next-method)
           (handle object)
           (when parent-context
             (setf (car parent-context) (nconc (car *construction-context*) (car parent-context))))
           (setf complete t))
      (unless complete (rollback-construction (car *construction-context*))))))
(defun image-buffer (value length)
  (check-type value (simple-array (unsigned-byte 8) (*)))
  (unless (= (length value) length) (error "Image buffer requires exactly ~D bytes" length))
  (copy-seq value))
(defun call-image-buffer (bytes function)
  (if bytes
      (cffi:with-pointer-to-vector-data (pointer bytes) (funcall function pointer (length bytes)))
      (funcall function (cffi:null-pointer) 0)))
(defun image-dimension (value) (check-type value (integer 1 4096)) value)
(defmethod initialize-instance :after ((object image) &key path source width height rgb alpha (quality :high))
  (when (> (count-if #'identity (list path source rgb)) 1) (error "Choose one image source: PATH, SOURCE or RGB"))
  (adopt-native object
    (cond
      (path
        (when (or width height alpha) (error "Loaded image dimensions/channels come from PNG"))
        (let ((name (uiop:native-namestring path))) (check-text-value name)
          (cffi:with-foreign-string ((pointer bytes) name :encoding :utf-8) (%load-image pointer (1- bytes)))))
      (source
        (when alpha (error "Scaled image alpha comes from SOURCE"))
        (etypecase source
          (image (%scale-image (handle source) (image-dimension width) (image-dimension height)
                               (ecase quality (:nearest 0) (:high 1))))
          (bitmap (when (or width height) (error "Bitmap conversion retains native size")) (%bitmap-image (handle source)))))
      (t
        (image-dimension width) (image-dimension height)
        (let* ((pixels (* width height))
               (colours (if rgb (image-buffer rgb (* pixels 3)) (make-array (* pixels 3) :element-type '(unsigned-byte 8) :initial-element 0)))
               (opacity (when alpha (image-buffer alpha pixels))))
          (call-image-buffer colours (lambda (p n) (call-image-buffer opacity (lambda (a m) (%image width height p n a m))))))))))
(defmethod initialize-instance :after ((object bitmap) &key image source)
  (unless (= 1 (count-if #'identity (list image source))) (error "Bitmap requires exactly one IMAGE or SOURCE"))
  (adopt-native object
    (if image (progn (check-type image image) (%bitmap (handle image)))
        (etypecase source
          (bitmap (%copy-bitmap (handle source)))
          (static-bitmap (%static-bitmap-get (handle source)))))))
(defun make-image (&rest initargs &key (class 'image) &allow-other-keys)
  (apply #'make-widget class 'image initargs))
(defun make-bitmap (&rest initargs &key (class 'bitmap) &allow-other-keys)
  (apply #'make-widget class 'bitmap initargs))
(defgeneric image-size (image))
(defgeneric bitmap-size (bitmap))
(defun native-image-size (object bitmap-p)
  (cffi:with-foreign-objects ((width :int) (height :int))
    (check-status (%image-size (handle object) bitmap-p width height))
    (list (cffi:mem-ref width :int) (cffi:mem-ref height :int))))
(defmethod image-size ((object image)) (native-image-size object 0))
(defmethod bitmap-size ((object bitmap)) (native-image-size object 1))
(defun native-bitmap-geometry (object)
  (cffi:with-foreign-objects ((logical :int 2) (dip :int 2) (scale :double))
    (check-status (%bitmap-geometry (handle object) logical dip scale))
    (values (loop for i below 2 collect (cffi:mem-aref logical :int i))
            (loop for i below 2 collect (cffi:mem-aref dip :int i)) (cffi:mem-ref scale :double))))
(defgeneric bitmap-logical-size (bitmap))
(defmethod bitmap-logical-size ((object bitmap)) (nth-value 0 (native-bitmap-geometry object)))
(defgeneric bitmap-dip-size (bitmap))
(defmethod bitmap-dip-size ((object bitmap)) (nth-value 1 (native-bitmap-geometry object)))
(defgeneric bitmap-scale-factor (bitmap))
(defmethod bitmap-scale-factor ((object bitmap)) (nth-value 2 (native-bitmap-geometry object)))
(defgeneric image-rgb (image))
(defgeneric image-alpha (image))
(defgeneric (setf image-rgb) (bytes image))
(defgeneric (setf image-alpha) (bytes image))
(defun native-image-bytes (object alpha)
  (destructuring-bind (width height) (image-size object)
    (let ((bytes (make-array (* width height (if alpha 1 3)) :element-type '(unsigned-byte 8))))
      (call-image-buffer bytes (lambda (pointer size) (check-status (%image-copy-bytes (handle object) (if alpha 1 0) pointer size)))) bytes)))
(defmethod image-rgb ((object image)) (native-image-bytes object nil))
(defmethod image-alpha ((object image)) (native-image-bytes object t))
(defun assign-image-bytes (object bytes alpha)
  (destructuring-bind (width height) (image-size object)
    (let ((copy (when bytes (image-buffer bytes (* width height (if alpha 1 3))))))
      (call-image-buffer copy (lambda (pointer size) (check-status (%image-set-bytes (handle object) (if alpha 1 0) pointer size)))))) bytes)
(defmethod (setf image-rgb) (bytes (object image))
  (when (null bytes) (error "RGB cannot be NIL")) (assign-image-bytes object bytes nil))
(defmethod (setf image-alpha) (bytes (object image)) (assign-image-bytes object bytes t))
(defgeneric image-alpha-p (image))
(defmethod image-alpha-p ((object image)) (boolean-result (%image-has-alpha (handle object))))
(defgeneric image-pixel (image x y))
(defgeneric (setf image-pixel) (rgba image x y))
(defmethod image-pixel ((object image) x y)
  (check-type x (integer 0 4095)) (check-type y (integer 0 4095))
  (cffi:with-foreign-object (rgba :uint8 4)
    (check-status (%image-pixel (handle object) x y rgba 0))
    (loop for i below 4 collect (cffi:mem-aref rgba :uint8 i))))
(defmethod (setf image-pixel) (value (object image) x y)
  (check-type value (cons (unsigned-byte 8) (cons (unsigned-byte 8) (cons (unsigned-byte 8) (cons (unsigned-byte 8) null)))))
  (check-type x (integer 0 4095)) (check-type y (integer 0 4095))
  (cffi:with-foreign-object (rgba :uint8 4)
    (loop for byte in value for i from 0 do (setf (cffi:mem-aref rgba :uint8 i) byte))
    (check-status (%image-pixel (handle object) x y rgba 1))) value)
(defgeneric scale-image (image width height &key quality class))
(defmethod scale-image ((object image) width height &key (quality :high) (class 'image))
  (make-image :class class :source object :width width :height height :quality quality))
(defgeneric save-image (image path))
(defmethod save-image ((object image) path)
  (let ((name (uiop:native-namestring path))) (check-text-value name)
    (cffi:with-foreign-string ((pointer bytes) name :encoding :utf-8)
      (check-status (%save-image (handle object) pointer (1- bytes))))) path)
(defgeneric bitmap-image (bitmap &key class))
(defmethod bitmap-image ((object bitmap) &key (class 'image)) (make-image :class class :source object))
(defgeneric image-alive-p (image))
(defgeneric bitmap-alive-p (bitmap))
(defmethod image-alive-p ((object image)) (and (slot-value object 'handle) (boolean-result (%image-alive (handle object) 0))))
(defmethod bitmap-alive-p ((object bitmap)) (and (slot-value object 'handle) (boolean-result (%image-alive (handle object) 1))))
(defgeneric destroy-image (image))
(defgeneric destroy-bitmap (bitmap))
(defmethod destroy-image ((object image)) (check-status (%image-destroy (handle object) 0)) (setf (slot-value object 'handle) nil) object)
(defmethod destroy-bitmap ((object bitmap)) (check-status (%image-destroy (handle object) 1)) (setf (slot-value object 'handle) nil) object)
(defmethod initialize-instance :after ((control static-bitmap) &key parent bitmap)
  (check-type parent window) (check-type bitmap bitmap) (adopt-native control (%static-bitmap (handle parent) (handle bitmap))))
(defgeneric make-static-bitmap (parent bitmap &rest initargs &key class &allow-other-keys))
(defmethod make-static-bitmap ((parent window) (bitmap bitmap) &rest initargs &key (class 'static-bitmap) &allow-other-keys)
  (apply #'make-widget class 'static-bitmap :parent parent :bitmap bitmap initargs))
(defgeneric bitmap-value (static-bitmap))
(defgeneric (setf bitmap-value) (bitmap static-bitmap))
(defmethod bitmap-value ((control static-bitmap))
  ;; A new independently disposable copy on every read; no source object retention.
  (make-bitmap :source control))
(defmethod (setf bitmap-value) ((value bitmap) (control static-bitmap))
  (call-setter (lambda () (%static-bitmap-set (handle control) (handle value))) t) value)
(defun display-count ()
  (let ((count (%display-count))) (when (< count 0) (error 'native-error :message (%last-error))) count))
(defun display-information (index client)
  (check-type index (integer 0 2147483647))
  (cffi:with-foreign-objects ((rectangle :int 4) (ppi :int 2) (scale :double))
    (check-status (%display-info index (if client 1 0) rectangle ppi scale))
    (values (loop for i below 4 collect (cffi:mem-aref rectangle :int i))
            (loop for i below 2 collect (cffi:mem-aref ppi :int i)) (cffi:mem-ref scale :double))))
(defun display-geometry (index &key client-p) (nth-value 0 (display-information index client-p)))
(defun display-ppi (index) (nth-value 1 (display-information index nil)))
(defun display-scale-factor (index) (nth-value 2 (display-information index nil)))
(defgeneric window-display-index (window))
(defmethod window-display-index ((object window))
  (let ((index (%window-display (handle object))))
    (when (< index -1) (error 'native-error :message (%last-error)))
    (unless (= index -1) index)))
(defun native-window-point (object operation x y)
  (check-type x (integer -1000000 1000000)) (check-type y (integer -1000000 1000000))
  (cffi:with-foreign-object (point :int 2)
    (check-status (%window-point (handle object) operation x y point))
    (list (cffi:mem-aref point :int 0) (cffi:mem-aref point :int 1))))
(defgeneric window-client-size (window))
(defmethod window-client-size ((object window)) (native-window-point object 0 0 0))
(defgeneric client-to-screen (window x y))
(defmethod client-to-screen ((object window) x y) (native-window-point object 1 x y))
(defgeneric screen-to-client (window x y))
(defmethod screen-to-client ((object window) x y) (native-window-point object 2 x y))
(defgeneric from-dip (window x y))
(defmethod from-dip ((object window) x y) (native-window-point object 3 x y))
(defgeneric to-dip (window x y))
(defmethod to-dip ((object window) x y) (native-window-point object 4 x y))
(defgeneric window-content-scale-factor (window))
(defmethod window-content-scale-factor ((object window))
  (cffi:with-foreign-object (scale :double)
    (check-status (%window-content-scale (handle object) scale)) (cffi:mem-ref scale :double)))
