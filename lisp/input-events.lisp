(in-package #:wxlambda)
(defparameter *input-event-kinds*
  '((:key-down . 45) (:key-up . 46) (:char . 47) (:char-hook . 48)
    (:left-down . 49) (:left-up . 50) (:left-double-click . 51)
    (:middle-down . 52) (:middle-up . 53) (:middle-double-click . 54)
    (:right-down . 55) (:right-up . 56) (:right-double-click . 57)
    (:aux1-down . 58) (:aux1-up . 59) (:aux1-double-click . 60)
    (:aux2-down . 61) (:aux2-up . 62) (:aux2-double-click . 63)
    (:mouse-motion . 64) (:mouse-enter . 65) (:mouse-leave . 66) (:mouse-wheel . 67)
    (:focus-gained . 68) (:focus-lost . 69) (:context-menu . 70) (:size . 71)))
(dolist (entry *input-event-kinds*)
  (pushnew (cons (cdr entry) (car entry)) *extension-event-kinds* :test #'equal))
(defun input-detail (event index kinds)
  (unless (member (event-kind event) kinds) (error "Input detail is unavailable for ~S" (event-kind event)))
  (etypecase event
    (event (aref (event-details event) index))
    (event-context
      (require-active-application)
      (cffi:with-foreign-object (value :int64)
        (check-status (%input-detail (event-context-token event) index value))
        (cffi:mem-ref value :int64)))))
(defparameter *key-input-kinds* '(:key-down :key-up :char :char-hook))
(defparameter *mouse-input-kinds*
  (mapcar #'car (remove-if-not (lambda (entry) (<= 49 (cdr entry) 67)) *input-event-kinds*)))
(defmacro define-input-reader (name index kinds &optional transform)
  `(progn
     (defgeneric ,name (event))
     (defmethod ,name ((event event))
       (let ((value (input-detail event ,index ,kinds))) ,(or transform 'value)))
     (defmethod ,name ((event event-context))
       (let ((value (input-detail event ,index ,kinds))) ,(or transform 'value)))))
(define-input-reader event-key-code 0 *key-input-kinds*)
(define-input-reader event-unicode-key 1 *key-input-kinds* (unless (minusp value) value))
(define-input-reader event-raw-key-code 2 *key-input-kinds* (unless (minusp value) value))
(define-input-reader event-raw-key-flags 3 *key-input-kinds* (unless (minusp value) value))
(define-input-reader event-modifiers 4 (append *key-input-kinds* *mouse-input-kinds*))
(define-input-reader event-auto-repeat-p 5 *key-input-kinds* (not (zerop value)))
(defgeneric event-position (event))
(defmethod event-position ((event event))
  (let ((kinds (append *key-input-kinds* *mouse-input-kinds* '(:context-menu))))
    (unless (zerop (input-detail event 20 kinds))
      (list (input-detail event 6 kinds) (input-detail event 7 kinds)))))
(defmethod event-position ((event event-context))
  (let ((kinds (append *key-input-kinds* *mouse-input-kinds* '(:context-menu))))
    (unless (zerop (input-detail event 20 kinds))
      (list (input-detail event 6 kinds) (input-detail event 7 kinds)))))
(define-input-reader event-mouse-button 8 *mouse-input-kinds*
  (ecase value (0 nil) (1 :left) (2 :middle) (3 :right) (4 :aux1) (5 :aux2)))
(define-input-reader event-mouse-buttons 9 *mouse-input-kinds*
  (loop for button in '(:left :middle :right :aux1 :aux2) for bit from 0
        when (logbitp bit value) collect button))
(define-input-reader event-wheel-rotation 10 '(:mouse-wheel))
(define-input-reader event-wheel-delta 11 '(:mouse-wheel))
(define-input-reader event-wheel-axis 12 '(:mouse-wheel) (if (zerop value) :vertical :horizontal))
(define-input-reader event-wheel-lines 13 '(:mouse-wheel))
(define-input-reader event-wheel-columns 14 '(:mouse-wheel))
(define-input-reader event-wheel-page-scroll-p 15 '(:mouse-wheel) (not (zerop value)))
(define-input-reader event-wheel-inverted-p 16 '(:mouse-wheel) (not (zerop value)))
(define-input-reader event-related-window-id 17 '(:focus-gained :focus-lost) (unless (zerop value) value))
(defgeneric event-size (event))
(defmethod event-size ((event event))
  (list (input-detail event 18 '(:size)) (input-detail event 19 '(:size))))
(defmethod event-size ((event event-context))
  (list (input-detail event 18 '(:size)) (input-detail event 19 '(:size))))
(define-input-reader event-dragging-p 21 *mouse-input-kinds* (not (zerop value)))
(define-input-reader event-next-key-event-allowed-p 22 '(:char-hook) (not (zerop value)))
(define-input-reader event-mouse-click-count 23 *mouse-input-kinds*)
(defgeneric allow-next-key-event (context))
(defmethod allow-next-key-event ((context event-context))
  (require-active-application)
  (check-status (%input-allow-next (event-context-token context))) context)

(defun input-command-modifier (event key-index mouse-index)
  (not (zerop (if (member (event-kind event) *key-input-kinds*)
                   (input-detail event key-index *key-input-kinds*)
                   (input-detail event mouse-index *mouse-input-kinds*)))))
(defgeneric event-cmd-down-p (event))
(defmethod event-cmd-down-p ((event event)) (input-command-modifier event 8 0))
(defmethod event-cmd-down-p ((event event-context)) (input-command-modifier event 8 0))
(defgeneric event-raw-control-down-p (event))
(defmethod event-raw-control-down-p ((event event)) (input-command-modifier event 9 1))
(defmethod event-raw-control-down-p ((event event-context)) (input-command-modifier event 9 1))
