(in-package #:wxlambda)
(defclass grid (window) ())
(defmethod initialize-instance :after ((object grid) &key parent (rows 10) (columns 5) (editable-p t))
  (check-type parent window)
  (check-type rows (integer 1 256)) (check-type columns (integer 1 256))
  (when (> (* rows columns) 16384) (error "Grid dimensions exceed16384 cells"))
  (adopt-native object (%grid (handle parent) rows columns (if editable-p 1 0))))
(defgeneric make-grid (parent &rest initargs &key class rows columns editable-p &allow-other-keys))
(defmethod make-grid ((parent window) &rest initargs &key (class 'grid) &allow-other-keys)
  (apply #'make-widget class 'grid :parent parent initargs))
(defgeneric grid-rows (grid))
(defmethod grid-rows ((grid grid)) (gauge-integer-result (%grid-property (handle grid) 0)))
(defgeneric grid-columns (grid))
(defmethod grid-columns ((grid grid)) (gauge-integer-result (%grid-property (handle grid) 1)))
(defgeneric grid-editable-p (grid))
(defmethod grid-editable-p ((grid grid)) (boolean-result (%grid-property (handle grid) 2)))
(defgeneric grid-editing-p (grid))
(defmethod grid-editing-p ((grid grid)) (boolean-result (%grid-property (handle grid) 3)))
(defgeneric (setf grid-editable-p) (value grid))
(defmethod (setf grid-editable-p) (value (grid grid))
  (call-setter (lambda () (%set-grid-editable (handle grid) (if value 1 0))) t) value)
(defun native-grid-text (grid field row column)
  (check-type row (integer 0 255)) (check-type column (integer 0 255))
  (cffi:with-foreign-object (length :size)
    (let ((pointer (%grid-text (handle grid) field row column length)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))
(defun assign-grid-text (grid field row column value)
  (check-type row (integer 0 255)) (check-type column (integer 0 255)) (check-text-value value)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (when (> (1- bytes) 65536) (error "Grid text exceeds65536 UTF-8 bytes"))
    (call-setter (lambda () (%set-grid-text (handle grid) field row column pointer (1- bytes))) t)) value)
(defgeneric grid-cell-text (grid row column))
(defmethod grid-cell-text ((grid grid) row column) (native-grid-text grid 0 row column))
(defgeneric (setf grid-cell-text) (value grid row column))
(defmethod (setf grid-cell-text) (value (grid grid) row column) (assign-grid-text grid 0 row column value))
(defgeneric grid-row-label (grid row))
(defmethod grid-row-label ((grid grid) row) (native-grid-text grid 1 row 0))
(defgeneric (setf grid-row-label) (value grid row))
(defmethod (setf grid-row-label) (value (grid grid) row) (assign-grid-text grid 1 row 0 value))
(defgeneric grid-column-label (grid column))
(defmethod grid-column-label ((grid grid) column) (native-grid-text grid 2 0 column))
(defgeneric (setf grid-column-label) (value grid column))
(defmethod (setf grid-column-label) (value (grid grid) column) (assign-grid-text grid 2 0 column value))
