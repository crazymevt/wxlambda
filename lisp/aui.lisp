(in-package #:wxlambda)
(defparameter *aui-event-kinds*
  '((100 . :aui-page-changing) (101 . :aui-page-changed) (102 . :aui-page-close)
    (103 . :aui-page-closed) (104 . :aui-drag-done)))
(setf *extension-event-kinds*
      (append *aui-event-kinds* (remove-if (lambda (entry) (assoc (car entry) *aui-event-kinds*)) *extension-event-kinds*)))
(defclass aui-notebook (window) ((pages :initform nil :accessor notebook-pages)))
(defun prune-aui-pages (book)
  (setf (notebook-pages book)
        (remove-if-not (lambda (page)
                         (and (handler-alive-p page) (not (minusp (%aui-page-index (handle book) (handle page))))))
                       (notebook-pages book))))
(defun prune-aui-closed-event (origin-id)
  ;; The internal book binding supplies canonical identity even if a later
  ;; user CLOSED context consumes the event before that observer can run.
  ;; Called by the transport before any user CLOSED callback is invoked.
  (when (plusp origin-id)
    (block found
      (maphash
        (lambda (token handler)
          (declare (ignore token))
          (let ((source (handler-source handler)))
            (when (and (typep source 'aui-notebook) (slot-boundp source 'handle)
                       (eql origin-id (slot-value source 'handle)))
              (prune-aui-pages source) (return-from found nil))))
        *handlers*))))
(defmethod initialize-instance :after ((book aui-notebook) &key parent)
  (check-type parent window) (adopt-native book (%aui-notebook (handle parent)))
  ;; Native close destroys pages without passing through a Lisp deletion writer.
  ;; Entry-owned binding roots book/page identities until native owner teardown.
  (bind-event book :aui-page-closed (lambda (event) (declare (ignore event)) (prune-aui-pages book))))
(defgeneric make-aui-notebook (parent &rest initargs &key class &allow-other-keys))
(defmethod make-aui-notebook ((parent window) &rest initargs &key (class 'aui-notebook) &allow-other-keys)
  (apply #'make-widget class 'aui-notebook :parent parent initargs))
(defmethod notebook-page-count ((book aui-notebook))
  (gauge-integer-result (%aui-count (handle book))))
(defmethod notebook-page ((book aui-notebook) index)
  (check-notebook-index index)
  (let ((id (%aui-page (handle book) index)))
    (when (zerop id) (error 'native-error :message (%last-error)))
    (or (find id (notebook-pages book) :key #'handle)
        (error 'native-error :message "AUI page has no canonical Lisp wrapper"))))
(defgeneric notebook-page-index (book page))
(defmethod notebook-page-index ((book aui-notebook) (page panel))
  (let ((index (%aui-page-index (handle book) (handle page))))
    (when (= index -2) (error 'native-error :message (%last-error))) (unless (= index -1) index)))
(defgeneric insert-notebook-page (book page index &key label select))
(defmethod insert-notebook-page ((book aui-notebook) (page panel) index &key (label "") select)
  (require-active-application) (check-notebook-index index) (check-menu-text label t) (check-callback-error)
  (when (member page *initializing-handlers* :test #'eq) (error "Complete page initialization before attachment"))
  (let ((previous (notebook-pages book)) (complete nil))
    (pushnew page (notebook-pages book) :test #'eq)
    (unwind-protect
         (progn
           (cffi:with-foreign-string ((pointer bytes) label :encoding :utf-8)
             (check-status (with-native-notifier (%aui-insert (handle book) (handle page) index pointer (1- bytes) (if select 1 0)))))
           (setf complete t) (prune-aui-pages book) (check-callback-error) page)
      (unless complete (setf (notebook-pages book) previous)))))
(defmethod add-notebook-page ((book aui-notebook) (page panel) &key (label "") select)
  (insert-notebook-page book page (notebook-page-count book) :label label :select select))
(defgeneric remove-notebook-page (book index))
(defmethod remove-notebook-page ((book aui-notebook) index)
  (let ((page (notebook-page book index)))
    (check-status (with-native-notifier (%aui-remove (handle book) index 0)))
    (setf (notebook-pages book) (remove page (notebook-pages book) :test #'eq))
    (check-callback-error) page))
(defgeneric delete-notebook-page (book index))
(defmethod delete-notebook-page ((book aui-notebook) index)
  (check-notebook-index index)
  (check-status (with-native-notifier (%aui-remove (handle book) index 1)))
  (prune-aui-pages book) (reap-event-bindings) (check-callback-error) t)
(defgeneric move-notebook-page (book from to))
(defmethod move-notebook-page ((book aui-notebook) from to)
  (check-notebook-index from) (check-notebook-index to)
  (call-setter (lambda () (%aui-move (handle book) from to)) t) book)
(defgeneric split-notebook-page (book index direction))
(defmethod split-notebook-page ((book aui-notebook) index direction)
  (check-notebook-index index)
  (let ((code (ecase direction (:left 0) (:right 1) (:top 2) (:bottom 3))))
    (call-setter (lambda () (%aui-split (handle book) index code)) t)) book)
(defmethod notebook-page-label ((book aui-notebook) index)
  (check-notebook-index index)
  (cffi:with-foreign-object (length :size)
    (let ((pointer (%aui-label (handle book) index length)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))
(defmethod (setf notebook-page-label) (value (book aui-notebook) index)
  (check-notebook-index index) (check-menu-text value t)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (call-setter (lambda () (%set-aui-label (handle book) index pointer (1- bytes))) t)) value)
(defmethod selection ((book aui-notebook) &key notify)
  (declare (ignore notify))
  (let ((index (%aui-selection (handle book))))
    (when (= index -2) (error 'native-error :message (%last-error))) (unless (= index -1) index)))
(defmethod (setf selection) (index (book aui-notebook) &key notify)
  (check-notebook-index index)
  (call-setter (lambda () (%set-aui-selection (handle book) index (if notify 1 0))) notify) index)
(defun aui-event-detail (event index)
  (etypecase event
    (event (when (rassoc (event-kind event) *aui-event-kinds*) (aref (event-details event) index)))
    (event-context
      (cffi:with-foreign-object (value :int64)
        (check-status (%aui-detail (event-context-token event) index value)) (cffi:mem-ref value :int64)))))
(defgeneric event-old-selection (event))
(defmethod event-old-selection ((event event))
  (let ((value (aui-event-detail event 0))) (when (and value (not (minusp value))) value)))
(defmethod event-old-selection ((event event-context))
  (let ((value (aui-event-detail event 0))) (unless (minusp value) value)))
(defgeneric event-aui-page-id (event))
(defmethod event-aui-page-id ((event event))
  (let ((value (aui-event-detail event 1))) (when (and value (plusp value)) value)))
(defmethod event-aui-page-id ((event event-context))
  (let ((value (aui-event-detail event 1))) (unless (zerop value) value)))

(defgeneric notebook-tab-colours (book))
(defgeneric (setf notebook-tab-colours) (value book))
(defmethod notebook-tab-colours ((book aui-notebook))
  (cffi:with-foreign-objects ((base :int64) (active :int64) (present :int))
    (check-status (%aui-tab-colours (handle book) 0 0 base active present))
    (unless (zerop (cffi:mem-ref present :int)) (list (cffi:mem-ref base :int64) (cffi:mem-ref active :int64)))))
(defmethod (setf notebook-tab-colours) (value (book aui-notebook))
  (when value (check-type value (cons (integer 0 16777215) (cons (integer 0 16777215) null))))
  (cffi:with-foreign-objects ((base :int64) (active :int64) (present :int))
    (setf (cffi:mem-ref base :int64) (if value (first value) 0) (cffi:mem-ref active :int64) (if value (second value) 0))
    (call-setter (lambda () (%aui-tab-colours (handle book) 1 (if value 0 1) base active present)) t))
  value)
