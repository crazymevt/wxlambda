(defun copy-list-string (function)
 (let (text failure)
  (cffi:with-foreign-object (length :size)
   (let ((pointer (with-native-notifier (funcall function length))))
    (if (cffi:null-pointer-p pointer) (setf failure (%last-error))
        (setf text (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8)))))
  (check-callback-error) (when failure (error 'native-error :message failure)) text))
(defmethod list-item-text :around ((control list-control) row column)
 (check-list-row row) (check-list-column column)
 (check-status (%report-list-validate-cell (handle control) row column))
 (if (and (list-virtual-p control) (not (eq control *native-list-provider*)))
     (copy-list-string (lambda (length) (%report-list-text (handle control) row column length)))
     (progn
      (when (and (eq control *native-list-provider*) (eq control *list-provider-query*))
       (error "Recursive virtual list text query"))
      (let* ((*list-provider-query* (if (eq control *native-list-provider*) control *list-provider-query*))
             (value (call-next-method)))
       (check-text-value value)
       (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
        (when (> (1- bytes) 65536) (error "List text exceeds65536 UTF8 bytes")))
       (copy-seq value)))))
(defmethod list-item-text ((control list-control) row column)
 (if (list-virtual-p control)
     (if (list-text-function control) (funcall (list-text-function control) control row column) "")
     (copy-list-string (lambda (length) (%report-list-text (handle control) row column length)))))
