(defun reap-list-provider-roots ()
 (when (and *active* *list-provider-roots*)
  (let (expired)
   (maphash (lambda (token source) (declare (ignore source))
              (unless (boolean-result (%report-list-provider-active token)) (push token expired))) *list-provider-roots*)
   (dolist (token expired) (remhash token *list-provider-roots*)))))
(cffi:defcallback dispatch-list-text :void ((token :uint64) (request :uint64) (row :int) (column :int))
 (handler-case
  (unless *callback-error*
   (let ((returned nil) (failed nil) (*callback-user-data* nil))
    (unwind-protect
     (handler-case
      (progn
       (let* ((source (or (and *list-provider-roots* (gethash token *list-provider-roots*)) (error "Missing live virtual list provider")))
              (*native-list-provider* source)
              (value (list-item-text source row column)))
        (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
         (check-status (%report-list-text-reply request pointer (1- bytes)))))
       (setf returned t))
      (error (condition) (setf failed t) (error condition)))
     (unless (or returned failed) (error "Virtual list providers must return normally; nonlocal exit rejected")))))
  (error (condition)
   (unless *callback-error* (setf *callback-error* condition))
   (%callback-error-pending 1)
   (unless (and *in-notifying-setter* (= *notifying-modal-depth* (%dialog-depth)))
    (unless (plusp (%dialog-abort)) (%stop))))))
(defmethod initialize-instance :after ((control list-control) &key parent virtual-p item-text-function)
 (check-type parent window) (when item-text-function (check-type item-text-function function))
 (when (and item-text-function (not virtual-p)) (error "ITEM-TEXT-FUNCTION requires a virtual list"))
 (boolean-result (%report-list-provider-active 0)) ; validate native thread before touching roots
 (when (and virtual-p (>= *next-list-provider* 18446744073709551615)) (error "List provider tokens exhausted"))
 (let ((token (if virtual-p (incf *next-list-provider*) 0)) (complete nil))
  (when virtual-p
   (unless *list-provider-roots* (setf *list-provider-roots* (make-hash-table)))
   (setf (gethash token *list-provider-roots*) control))
  (unwind-protect
   (progn (adopt-native control (%report-list-control (handle parent) (if virtual-p 1 0) token
                                  (if virtual-p (cffi:callback dispatch-list-text) (cffi:null-pointer))))
          (setf complete t))
   (unless complete (when *list-provider-roots* (remhash token *list-provider-roots*))))))
