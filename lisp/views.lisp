(defmethod append-item ((control list-control) values)
 (unless (and (listp values) (list-length values) (<= 1 (length values) 64)) (error "List row requires1..64 strings"))
 (let (strings lengths)
  (unwind-protect
   (progn
    (dolist (value values)
     (check-text-value value)
     (multiple-value-bind (pointer bytes) (cffi:foreign-string-alloc value :encoding :utf-8)
      (push pointer strings) (push (1- bytes) lengths)))
    (setf strings (nreverse strings) lengths (nreverse lengths))
    (cffi:with-foreign-objects ((array :pointer (length strings)) (sizes :size (length strings)))
     (loop for pointer in strings for bytes in lengths for i from 0
           do (setf (cffi:mem-aref array :pointer i) pointer (cffi:mem-aref sizes :size i) bytes))
     (let ((index (with-native-notifier (%report-list-append-row (handle control) array sizes (length strings)))))
      (check-callback-error) (gauge-integer-result index))))
   (dolist (pointer strings) (cffi:foreign-string-free pointer)))))
