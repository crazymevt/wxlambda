(in-package #:wxlambda)
(defclass web-view (window) ())
(defmethod initialize-instance :after ((view web-view) &key parent)
  (check-type parent window)
  (adopt-native view (%web-view (handle parent))))
(defgeneric make-web-view (parent &rest initargs &key class &allow-other-keys))
(defmethod make-web-view ((parent window) &rest initargs &key (class 'web-view) &allow-other-keys)
  (apply #'make-widget class 'web-view :parent parent initargs))
(defun read-web-string (view field)
  (cffi:with-foreign-object (length :size)
    (let ((pointer (%web-view-string (handle view) field length)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))
(defgeneric web-view-url (view))
(defmethod web-view-url ((view web-view)) (read-web-string view 0))
(defgeneric web-view-title (view))
(defmethod web-view-title ((view web-view)) (read-web-string view 1))
(defun load-web-content (view text base html)
  (check-text-value text) (check-text-value base)
  (cffi:with-foreign-string ((pointer bytes) text :encoding :utf-8)
    (cffi:with-foreign-string ((base-pointer base-bytes) base :encoding :utf-8)
      (call-setter (lambda () (%web-view-load (handle view) pointer (1- bytes) base-pointer (1- base-bytes) (if html 1 0))) t)))
  text)
(defgeneric (setf web-view-url) (value view))
(defmethod (setf web-view-url) (value (view web-view)) (load-web-content view value "" nil))
(defgeneric set-web-page (view html &key base-url))
(defmethod set-web-page ((view web-view) html &key (base-url "about:blank"))
  (load-web-content view html base-url t))
(defgeneric web-view-busy-p (view))
(defmethod web-view-busy-p ((view web-view)) (boolean-result (%web-view-property (handle view) 0)))
(defgeneric web-view-can-go-back-p (view))
(defmethod web-view-can-go-back-p ((view web-view)) (boolean-result (%web-view-property (handle view) 1)))
(defgeneric web-view-can-go-forward-p (view))
(defmethod web-view-can-go-forward-p ((view web-view)) (boolean-result (%web-view-property (handle view) 2)))
(defgeneric web-view-go-back (view))
(defmethod web-view-go-back ((view web-view)) (call-setter (lambda () (%web-view-action (handle view) 0)) t) view)
(defgeneric web-view-go-forward (view))
(defmethod web-view-go-forward ((view web-view)) (call-setter (lambda () (%web-view-action (handle view) 1)) t) view)
(defgeneric web-view-reload (view))
(defmethod web-view-reload ((view web-view)) (call-setter (lambda () (%web-view-action (handle view) 2)) t) view)
(defgeneric web-view-stop (view))
(defmethod web-view-stop ((view web-view)) (call-setter (lambda () (%web-view-action (handle view) 3)) t) view)
(defgeneric run-web-script (view script))
(defmethod run-web-script ((view web-view) script)
  (check-text-value script)
  (cffi:with-foreign-string ((pointer bytes) script :encoding :utf-8)
    (let ((ticket (with-native-notifier (%web-view-script (handle view) pointer (1- bytes)))))
      (when (minusp ticket) (error 'native-error :message (%last-error)))
      (check-callback-error) ticket)))
