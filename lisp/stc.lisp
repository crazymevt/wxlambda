(in-package #:wxlambda)
(defparameter *stc-event-kinds*
  '((31 . :stc-modified) (32 . :stc-update-ui) (33 . :stc-style-needed)
    (34 . :stc-margin-click) (35 . :stc-margin-right-click) (36 . :stc-dwell-start)
    (37 . :stc-dwell-end) (38 . :stc-save-point-reached) (39 . :stc-save-point-left)
    (40 . :stc-autocomplete-selection) (41 . :stc-autocomplete-completed)
    (42 . :stc-call-tip-click) (43 . :stc-need-shown) (44 . :stc-read-only-attempt) (80 . :stc-char-added)))
(setf *extension-event-kinds* (append *stc-event-kinds* *extension-event-kinds*))
(defclass styled-text-control (window) ())
(defmethod initialize-instance :after ((control styled-text-control) &key parent (value ""))
  (check-type parent window) (check-type value string)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (adopt-native control (%stc (handle parent) pointer (1- bytes)))))
(defgeneric make-styled-text-control (parent &rest initargs &key class value &allow-other-keys))
(defmethod make-styled-text-control ((parent window) &rest initargs &key (class 'styled-text-control) &allow-other-keys)
  (apply #'make-widget class 'styled-text-control :parent parent initargs))
(defun stc-int (value)
  (check-type value (signed-byte 32)) value)
(defun stc-native-get (control field index)
  (cffi:with-foreign-object (result :int64)
    (check-status (%stc-get (handle control) field (stc-int index) result))
    (cffi:mem-ref result :int64)))
(defun stc-native-set (control field index value)
  (check-type value (signed-byte 64))
  (call-setter (lambda () (%stc-set (handle control) field (stc-int index) value)) t))
(defun stc-native-action (control operation a b)
  (cffi:with-foreign-object (result :int64)
    (call-setter (lambda () (%stc-action (handle control) operation (stc-int a) (stc-int b) result)) t)
    (cffi:mem-ref result :int64)))
(defun stc-copy-string (function)
  (cffi:with-foreign-object (length :size)
    (let ((pointer (funcall function length)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))
(defgeneric stc-text-range (control start end))
(defmethod stc-text-range ((control styled-text-control) start end)
  (stc-copy-string (lambda (length) (%stc-text (handle control) (stc-int start) (stc-int end) length))))
(defgeneric stc-text (control))
(defmethod stc-text ((control styled-text-control)) (stc-text-range control 0 (stc-native-get control 0 0)))
(defgeneric replace-stc-range (control start end value))
(defmethod replace-stc-range ((control styled-text-control) start end value)
  (check-type value string)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (call-setter (lambda () (%stc-replace (handle control) (stc-int start) (stc-int end) pointer (1- bytes))) t)) value)
(defgeneric (setf stc-text) (value control))
(defmethod (setf stc-text) (value (control styled-text-control))
  (replace-stc-range control 0 (stc-native-get control 0 0) value))
(defgeneric stc-style-font (control style))
(defmethod stc-style-font ((control styled-text-control) style)
  (stc-copy-string (lambda (length) (%stc-font (handle control) (stc-int style) length))))
(defun stc-send-string (control operation argument value)
  (check-text-value value)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (call-setter (lambda () (%stc-string (handle control) operation (stc-int argument) pointer (1- bytes))) t)) value)
(defgeneric (setf stc-style-font) (value control style))
(defmethod (setf stc-style-font) (value (control styled-text-control) style) (stc-send-string control 0 style value))
(defgeneric show-stc-autocomplete (control length-entered items))
(defmethod show-stc-autocomplete ((control styled-text-control) length-entered items) (stc-send-string control 1 length-entered items))
(defgeneric show-stc-call-tip (control position text))
(defmethod show-stc-call-tip ((control styled-text-control) position text) (stc-send-string control 2 position text))
(defgeneric stc-point-from-position (control position))
(defmethod stc-point-from-position ((control styled-text-control) position)
  (cffi:with-foreign-objects ((x :int) (y :int))
    (check-status (%stc-point (handle control) (stc-int position) x y))
    (list (cffi:mem-ref x :int) (cffi:mem-ref y :int))))
(defgeneric stc-position-from-point (control x y))
(defmethod stc-position-from-point ((control styled-text-control) x y)
  (cffi:with-foreign-object (position :int)
    (check-status (%stc-position (handle control) (stc-int x) (stc-int y) position))
    (let ((value (cffi:mem-ref position :int))) (unless (minusp value) value))))
(defun styled-event-detail (event index)
  (unless (rassoc (event-kind event) *stc-event-kinds*) (error "Not a styled text event"))
  (let* ((kind (car (rassoc (event-kind event) *stc-event-kinds*)))
         (valid (case index
                  (0 '(31 33 34 35 36 37 40 41 42 43)) (1 '(31 43))
                  ((2 3 4 5 6) '(31)) ((7 8) '(34 35)) ((9 10) '(36 37)) (11 '(32)) (12 '(80)))))
    (unless (member kind valid) (error "Styled text detail unavailable for this event kind")))
  (etypecase event
    (event (aref (event-details event) index))
    (event-context
      (cffi:with-foreign-object (value :int64)
        (check-status (%stc-detail (event-context-token event) index value)) (cffi:mem-ref value :int64)))))

(defgeneric event-stc-position (event))
(defmethod event-stc-position ((event event)) (styled-event-detail event 0))
(defmethod event-stc-position ((event event-context)) (styled-event-detail event 0))

(defgeneric event-stc-length (event))
(defmethod event-stc-length ((event event)) (styled-event-detail event 1))
(defmethod event-stc-length ((event event-context)) (styled-event-detail event 1))

(defgeneric event-stc-lines-added (event))
(defmethod event-stc-lines-added ((event event)) (styled-event-detail event 2))
(defmethod event-stc-lines-added ((event event-context)) (styled-event-detail event 2))

(defgeneric event-stc-modification-type (event))
(defmethod event-stc-modification-type ((event event)) (styled-event-detail event 3))
(defmethod event-stc-modification-type ((event event-context)) (styled-event-detail event 3))

(defgeneric event-stc-line (event))
(defmethod event-stc-line ((event event)) (styled-event-detail event 4))
(defmethod event-stc-line ((event event-context)) (styled-event-detail event 4))

(defgeneric event-stc-fold-level-now (event))
(defmethod event-stc-fold-level-now ((event event)) (styled-event-detail event 5))
(defmethod event-stc-fold-level-now ((event event-context)) (styled-event-detail event 5))

(defgeneric event-stc-fold-level-previous (event))
(defmethod event-stc-fold-level-previous ((event event)) (styled-event-detail event 6))
(defmethod event-stc-fold-level-previous ((event event-context)) (styled-event-detail event 6))

(defgeneric event-stc-margin (event))
(defmethod event-stc-margin ((event event)) (styled-event-detail event 7))
(defmethod event-stc-margin ((event event-context)) (styled-event-detail event 7))

(defgeneric event-stc-modifiers (event))
(defmethod event-stc-modifiers ((event event)) (styled-event-detail event 8))
(defmethod event-stc-modifiers ((event event-context)) (styled-event-detail event 8))

(defgeneric event-stc-x (event))
(defmethod event-stc-x ((event event)) (styled-event-detail event 9))
(defmethod event-stc-x ((event event-context)) (styled-event-detail event 9))

(defgeneric event-stc-y (event))
(defmethod event-stc-y ((event event)) (styled-event-detail event 10))
(defmethod event-stc-y ((event event-context)) (styled-event-detail event 10))

(defgeneric event-stc-update-mask (event))
(defmethod event-stc-update-mask ((event event)) (styled-event-detail event 11))
(defmethod event-stc-update-mask ((event event-context)) (styled-event-detail event 11))

(defgeneric event-stc-key (event))
(defmethod event-stc-key ((event event)) (styled-event-detail event 12))
(defmethod event-stc-key ((event event-context)) (styled-event-detail event 12))

(defgeneric set-stc-style-bytes (control bytes))
(defmethod set-stc-style-bytes ((control styled-text-control) bytes)
  (check-type bytes (simple-array (unsigned-byte 8) (*)))
  (when (> (length bytes) 67108864) (error "Styling byte buffer exceeds64MiB"))
  (let ((copy (copy-seq bytes)))
    (cffi:with-pointer-to-vector-data (pointer copy)
      (call-setter (lambda () (%stc-style-bytes (handle control) pointer (length copy))) t))) bytes)

(defgeneric stc-caret-colour (control))
(defgeneric (setf stc-caret-colour) (value control))
(defmethod stc-caret-colour ((control styled-text-control))
  (cffi:with-foreign-object (colour :int64)
    (check-status (%stc-caret-colour (handle control) 0 colour)) (cffi:mem-ref colour :int64)))
(defmethod (setf stc-caret-colour) (value (control styled-text-control))
  (check-type value (integer 0 16777215))
  (cffi:with-foreign-object (colour :int64)
    (setf (cffi:mem-ref colour :int64) value)
    (call-setter (lambda () (%stc-caret-colour (handle control) 1 colour)) t)) value)
(defgeneric stc-selection-colours (control))
(defgeneric (setf stc-selection-colours) (value control))
(defmethod stc-selection-colours ((control styled-text-control))
  (cffi:with-foreign-objects ((fg :int64) (bg :int64) (present :int))
    (check-status (%stc-selection-colours (handle control) 0 0 fg bg present))
    (unless (zerop (cffi:mem-ref present :int)) (list (cffi:mem-ref fg :int64) (cffi:mem-ref bg :int64)))))
(defmethod (setf stc-selection-colours) (value (control styled-text-control))
  (when value (check-type value (cons (integer 0 16777215) (cons (integer 0 16777215) null))))
  (cffi:with-foreign-objects ((fg :int64) (bg :int64) (present :int))
    (setf (cffi:mem-ref fg :int64) (if value (first value) 0) (cffi:mem-ref bg :int64) (if value (second value) 0))
    (call-setter (lambda () (%stc-selection-colours (handle control) 1 (if value 0 1) fg bg present)) t)) value)

(defgeneric stc-tab-width (control))
(defmethod stc-tab-width ((control styled-text-control)) (stc-native-get control 48 0))
(defgeneric (setf stc-tab-width) (value control))
(defmethod (setf stc-tab-width) (value (control styled-text-control))
  (check-type value (integer 1 16)) (stc-native-set control 48 0 value) value)
