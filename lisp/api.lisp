(defun check-dialog-wildcard (value)
  (check-dialog-text value)
  (let ((parts (uiop:split-string value :separator "|")))
    (unless (and (plusp (length parts)) (evenp (length parts))
                 (every (lambda (part) (plusp (length part))) parts))
      (error "File wildcard requires nonempty description/pattern pairs"))) value)
