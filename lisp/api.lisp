(defun adopt-dialog-native (object constructor)
  (check-callback-error)
  (let* ((id (with-native-notifier (funcall constructor)))
         (native-message (when (zerop id) (%last-error))))
    (unless (zerop id) (adopt-native object id))
    (check-callback-error)
    (when (zerop id) (error 'native-error :message native-message)) object))
