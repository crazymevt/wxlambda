        (icon-code (ecase icon (:none 0) (:information 1) (:warning 2) (:error 3) (:question 4))))
    (mapc #'check-dialog-text (list message title))
    (cffi:with-foreign-string ((mp mb) message :encoding :utf-8)
      (cffi:with-foreign-string ((tp tb) title :encoding :utf-8)
        (adopt-dialog-native object
          (lambda () (%message-dialog parent-id mp (1- mb) tp (1- tb) button-code icon-code)))))))
(defmethod initialize-instance :after ((object file-dialog) &key parent (title nil title-supplied)
                                      (directory "") (filename "") (wildcard "All files|*")
                                      (mode :open) (must-exist nil must-supplied)
                                      (overwrite-prompt nil overwrite-supplied) (filter-index 0)
                                      (path nil path-supplied))
  (let* ((parent-id (dialog-parent-id parent))
         (mode-code (ecase mode (:open 0) (:save 1)))
         (caption (if title-supplied title (if (eq mode :open) "Open file" "Save file")))
         (dir (native-dialog-path directory t))
         (must (if must-supplied must-exist (eq mode :open)))
         (overwrite (if overwrite-supplied overwrite-prompt (eq mode :save))))
    (mapc #'check-dialog-text (list caption filename)) (check-dialog-wildcard wildcard)
    (check-type filter-index (integer 0 2147483647))
    (unless (< filter-index (/ (length (uiop:split-string wildcard :separator "|")) 2))
      (error "File filter index is outside its wildcard list"))
    (when (and must (eq mode :save)) (error "MUST-EXIST applies only to open mode"))
    (when (and overwrite (eq mode :open)) (error "OVERWRITE-PROMPT applies only to save mode"))
    (when path-supplied (native-dialog-path path))
    (cffi:with-foreign-string ((tp tb) caption :encoding :utf-8)
      (cffi:with-foreign-string ((dp db) dir :encoding :utf-8)
        (cffi:with-foreign-string ((fp fb) filename :encoding :utf-8)
          (cffi:with-foreign-string ((wp wb) wildcard :encoding :utf-8)
            (adopt-dialog-native object
              (lambda () (%file-dialog parent-id tp (1- tb) dp (1- db) fp (1- fb) wp (1- wb)
                                       mode-code (if must 1 0) (if overwrite 1 0))))))))
    (setf (file-dialog-filter-index object) filter-index)
    (when path-supplied (setf (file-dialog-path object) path))))
