(defstruct (event (:constructor %make-event (kind-value source payload-text checked-value selection-value identifier native-type-code can-veto veto family-code payload-integer logging-off time-stamp command origin-code category-code extra-long-data selection-action user-data-value more-requested tree-item-value sash-position-value date-code-value time-code-value &optional details)))
  "A Lisp-owned snapshot. Slots are read-only; TEXT is an independent string."
  (kind-value nil :read-only t)
  (source nil :read-only t)
  (payload-text nil :read-only t)
  (checked-value nil :read-only t)
  (selection-value nil :read-only t)
  (identifier 0 :read-only t)
  (native-type-code 0 :read-only t)
  (can-veto nil :read-only t)
  (veto nil :read-only t)
  (family-code 0 :read-only t)
  (payload-integer 0 :read-only t)
  (logging-off nil :read-only t)
  (time-stamp 0 :read-only t)
  (command nil :read-only t)
  (origin-code 0 :read-only t)
  (category-code 0 :read-only t)
  (extra-long-data 0 :read-only t)
  (selection-action nil :read-only t)
  (user-data-value nil :read-only t)
  (more-requested nil :read-only t)
  (tree-item-value nil :read-only t)
  (sash-position-value nil :read-only t)
  (date-code-value 0 :read-only t)
  (time-code-value 0 :read-only t)
  (details nil :read-only t))

(defstruct (ui-action (:constructor %make-ui-action (token)))
  "Immutable session-owned deferred-action identity; closures are rooted separately."
  (token 0 :type (unsigned-byte 64) :read-only t))
(defvar *ui-actions* nil)
(defstruct (ui-timer (:constructor %make-ui-timer (token)))
  "Immutable session-owned scheduler timer identity, not a native event receiver."
  (token 0 :type (unsigned-byte 64) :read-only t))
(defvar *ui-timers* nil)
(defstruct (event-binding (:constructor %make-event-binding (source kind token)))
  (source nil :read-only t) (kind nil :read-only t) (token 0 :read-only t))
(defvar *registered-event-types* nil)
(defvar *registered-event-kinds* nil)
(defvar *registered-event-families* nil)
(defvar *event-bindings* nil)
(defstruct (event-context (:constructor %make-event-context (token)))
  (token 0 :read-only t))
(defstruct handler source function with-context user-data)
(defvar *callback-user-data* nil)
(defvar *active* nil)
(defvar *repl-running* nil)
(defvar *repl-debugging* nil)
(defvar *handlers* nil)
(defvar *standalone-handler-objects* nil)
(defvar *handler-client-data-roots* nil)
(defvar *callback-error* nil)
(defvar *in-notifying-setter* nil)
(defvar *notifying-modal-depth* 0)
(defvar *next-token* 0)
(defvar *construction-context* nil)

(defun check-status (status)
  (unless (zerop status) (error 'native-error :message (%last-error)))
  t)

(defun native-modal-depth ()
  (require-active-application)
  (let ((depth (%dialog-depth)))
    (when (minusp depth) (error 'native-error :message (%last-error))) depth))
(defmacro with-native-notifier (&body body)
  `(let ((*in-notifying-setter* t) (*notifying-modal-depth* (native-modal-depth))) ,@body))

(cffi:defcallback dispatch-event :void ((token :uint64) (payload :pointer))
  ;; Copy borrowed payloads before user code, including reentrant native calls.
  ;; Unwinding through C++ is unsafe. Re-signal after the native call returns.
  (handler-case
      (progn
        ;; Native page-cache cleanup precedes both consumption and a pending user error.
        (unless (cffi:null-pointer-p payload)
          (let ((native-kind (cffi:foreign-slot-value payload '(:struct native-event) 'kind))
                (origin (cffi:foreign-slot-value payload '(:struct native-event) 'origin-id)))
            (when (and (= native-kind 103) (fboundp 'prune-aui-closed-event))
              (if *callback-error* (ignore-errors (prune-aui-closed-event origin))
                  (prune-aui-closed-event origin)))))
      (unless *callback-error*
        (let ((handler (gethash token *handlers*)))
          (when handler
            (when (cffi:null-pointer-p payload) (error "Missing event payload"))
            (cffi:with-foreign-slots ((kind text checked selection id text-length context native-type can-veto vetoed family integer logging-off timestamp command origin-id category extra-long selection-action user-data-token more-requested tree-item sash-position date-code time-code) payload (:struct native-event))
              (let* ((event-kind (or (case kind (1 :click) (2 :text-change) (3 :toggle) (4 :selection) (5 :close) (6 :query-end-session) (7 :end-session) (8 :idle) (9 :menu) (10 :notebook-page-changing) (11 :notebook-page-changed) (12 :listbox-selection) (13 :listbox-double-click) (14 :tree-selection-changing) (15 :tree-selection-changed) (16 :splitter-sash-changing) (17 :splitter-sash-changed) (18 :slider-change) (19 :spin-change) (20 :radio-selection) (21 :toggle-button-change) (22 :combo-selection) (23 :date-change) (24 :time-change) (25 :search) (26 :search-cancel) (27 :web-message) (28 :web-script-result) (29 :web-loaded) (30 :web-error))
                                     (cdr (assoc kind *extension-event-kinds*))
                                     (gethash kind *registered-event-kinds*)
                                     (error "Unregistered native event kind ~S" kind)))
                     (user-data (unless (zerop user-data-token)
                                  (unless (= user-data-token token)
                                    (error "Binding user-data token does not match callback"))
                                  (handler-user-data handler)))
                     ;; Keep the current association rooted even after self-unbinding.
                     ;; Nested callbacks replace this view only for their own extent.
                     (*callback-user-data* (cons user-data-token user-data))
                     (value (progn
                              (when (and (= kind 2) (cffi:null-pointer-p text))
                                (error "Missing text-change payload"))
                              (unless (cffi:null-pointer-p text)
                                (cffi:foreign-string-to-lisp text :count text-length :encoding :utf-8))))
                     (checked-p (and (member kind '(3 9 21)) (not (zerop checked))))
                     (event (%make-event event-kind (handler-source handler) value checked-p
                                         (when (member kind '(4 10 11 12 13 20 22 100 101 102 103 104)) (unless (= selection -1) selection)) id native-type
                                         (not (zerop can-veto)) (not (zerop vetoed)) family integer (not (zerop logging-off)) timestamp (not (zerop command)) origin-id category extra-long (not (zerop selection-action)) user-data (not (zerop more-requested)) (canonical-tree-item tree-item) (when (member kind '(16 17)) sash-position) date-code time-code
                                         (let ((pointer (cffi:foreign-slot-pointer payload '(:struct native-event) 'detail)))
                                           (map-into (make-array 24) (let ((i -1)) (lambda () (cffi:mem-aref pointer :int64 (incf i)))))))))
                (capture-grid-event-value event)
                (if (handler-with-context handler)
                    (funcall (handler-function handler) event (%make-event-context context))
                    (funcall (handler-function handler) event))))))))
    (error (condition)
      (unless *callback-error* (setf *callback-error* condition))
      ;; Native code must not open another prompt before the nearer Lisp
      ;; notifier boundary gets a chance to re-signal this condition.
      (%callback-error-pending 1)
      ;; Notifying setters have a nearer Lisp boundary where their caller can
      ;; handle this error. Escaping errors cancel a modal or stop the outer loop.
      (unless (and *in-notifying-setter* (= *notifying-modal-depth* (%dialog-depth)))
        (unless (plusp (%dialog-abort)) (%stop))))))

(cffi:defcallback dispatch-ui-action :void ((token :uint64) (execute :int))
  ;; Native code removes pending identity before entry. Keep the closure in a
  ;; local root across modal callbacks/GC and release the queue root immediately.
  (let* ((timer-p (member execute '(2 3)))
         (function (gethash token (if timer-p *ui-timers* *ui-actions*))))
    (cond ((= execute 3) (remhash token *ui-timers*))
          ((/= execute 2) (remhash token *ui-actions*)
           (when (zerop execute) (remhash token *ui-timers*))))
    (when (and function (not (zerop execute)) (not *callback-error*))
      (let ((*callback-user-data* nil) (*in-notifying-setter* nil) (*notifying-modal-depth* 0))
        (handler-case
            (let ((returned nil) (failed nil))
              (unwind-protect
                   (handler-case
                       (progn (funcall function) (setf returned t))
                     (error (condition) (setf failed t) (error condition)))
                (unless (or returned failed)
                  (error "Deferred UI work must return normally; nonlocal exit rejected"))))
          (error (condition)
            ;; A failing periodic timer must not rethrow forever on every recovery pump.
            (when timer-p
              (%cancel-ui-timer token)
              (remhash token *ui-timers*))
            (unless *callback-error* (setf *callback-error* condition))
            (%callback-error-pending 1)
            (unless (plusp (%dialog-abort)) (%stop))))))))

(defun reap-ui-actions ()
  (when (and *active* *ui-actions*)
    (let (expired)
      (maphash (lambda (token function)
                 (declare (ignore function))
                 (unless (boolean-result (%ui-action-pending token)) (push token expired))) *ui-actions*)
      (dolist (token expired) (remhash token *ui-actions*)))))

(defun defer-ui-action (function &key owner)
  "Queue FUNCTION (no arguments) at a safe idle boundary; optional OWNER must remain live."
  (require-active-application)
  (boolean-result (%ui-action-pending 0)) ; Reject foreign threads before touching session roots.
  (check-type function function) (check-type owner (or null window))
  (reap-ui-actions)
  (let* ((token (incf *next-token*)) (ticket (%make-ui-action token)) (complete nil))
    (setf (gethash token *ui-actions*) function)
    (unwind-protect
         (progn (check-status (%defer-ui-action token (if owner (handle owner) 0)))
                (setf complete t) ticket)
      (unless complete (remhash token *ui-actions*)))))
(defgeneric cancel-ui-action (action))
(defmethod cancel-ui-action ((action ui-action))
  (require-active-application)
  (let ((canceled (boolean-result (%cancel-ui-action (ui-action-token action)))))
    (remhash (ui-action-token action) *ui-actions*) canceled))
(defgeneric ui-action-pending-p (action))
(defmethod ui-action-pending-p ((action ui-action))
  (require-active-application)
  (let ((pending (boolean-result (%ui-action-pending (ui-action-token action)))))
    (unless pending (remhash (ui-action-token action) *ui-actions*)) pending))

(defun reap-ui-timers ()
  (when (and *active* *ui-timers*)
    (let (expired)
      (maphash (lambda (token function)
                 (declare (ignore function))
                 (unless (boolean-result (%ui-timer-active token)) (push token expired))) *ui-timers*)
      (dolist (token expired) (remhash token *ui-timers*)))))

(defun start-ui-timer (function milliseconds &key owner one-shot)
  "Start coalesced periodic UI work; ONE-SHOT retires before its one safe-idle delivery."
  (require-active-application)
  (boolean-result (%ui-timer-active 0)) ; Validate GUI thread before touching roots.
  (check-type function function) (check-type milliseconds (integer 1 86400000))
  (check-type owner (or null window))
  (reap-ui-timers)
  (let* ((token (incf *next-token*)) (ticket (%make-ui-timer token)) (complete nil))
    (setf (gethash token *ui-timers*) function)
    (unwind-protect
         (progn (check-status (%start-ui-timer token milliseconds (if one-shot 1 0) (if owner (handle owner) 0)))
                (setf complete t) ticket)
      (unless complete (remhash token *ui-timers*)))))
(defgeneric cancel-ui-timer (timer))
(defmethod cancel-ui-timer ((timer ui-timer))
  (require-active-application)
  (let ((canceled (boolean-result (%cancel-ui-timer (ui-timer-token timer)))))
    (remhash (ui-timer-token timer) *ui-timers*) canceled))
(defgeneric ui-timer-active-p (timer))
(defmethod ui-timer-active-p ((timer ui-timer))
  (require-active-application)
  (let ((active (boolean-result (%ui-timer-active (ui-timer-token timer)))))
    (unless active (remhash (ui-timer-token timer) *ui-timers*)) active))

(defun reap-client-data-roots ()
  ;; Native destruction can precede Lisp wrapper cleanup (notably child windows).
  ;; Only numeric identities cross the FFI; native storage never holds Lisp data.
  (when (and *active* *handler-client-data-roots*)
    (let (expired)
      (maphash (lambda (token value)
                 (declare (ignore value))
                 (let ((active (%client-data-active token)))
                   (when (minusp active) (check-status active))
                   (when (zerop active) (push token expired))))
               *handler-client-data-roots*)
      (dolist (token expired) (remhash token *handler-client-data-roots*)))))

(defun reap-event-bindings ()
  (when (fboundp 'reap-list-provider-roots) (reap-list-provider-roots))
  (reap-client-data-roots)
  (when (and *active* *event-bindings*)
    (let (expired)
      (maphash (lambda (token binding)
                 (declare (ignore binding))
                 (let ((active (%binding-active token)))
                   (when (minusp active) (check-status active))
                   (when (zerop active) (push token expired))))
               *event-bindings*)
      (dolist (token expired)
        (remhash token *event-bindings*)
        (remhash token *handlers*)))))

(defun check-callback-error ()
  ;; Preserve an escaping user condition if cleanup itself encounters an error.
  (flet ((cleanup () (reap-event-bindings) (reap-tree-items) (reap-ui-actions) (reap-ui-timers)))
    (if *callback-error* (ignore-errors (cleanup)) (cleanup)))
  (when *callback-error*
    (let ((condition *callback-error*))
      (setf *callback-error* nil)
      (when *active* (%callback-error-pending 0))
      (error condition))))

(defun %call-with-application (function)
  "Call FUNCTION in one GUI session on the process main thread.
Run explicitly with RUN. Only one session per process is currently supported."
  (when *active* (error "An application session is already active"))
  (load-native-library)
  (let ((*tree-item-objects* (make-hash-table)) (*tree-item-revision* 0)
        (*active* t) (*application-handler* nil) (*standalone-handler-objects* (make-hash-table)) (*handlers* (make-hash-table)) (*event-bindings* (make-hash-table)) (*callback-error* nil)
        (*handler-client-data-roots* (make-hash-table)) (*ui-actions* (make-hash-table)) (*ui-timers* (make-hash-table))
        (*registered-event-types* (make-hash-table)) (*registered-event-kinds* (make-hash-table))
        (*registered-event-families* (make-hash-table)))
    (check-status (%start (cffi:callback dispatch-event) (cffi:callback dispatch-ui-action)))
    (unwind-protect (funcall function)
      (unwind-protect (check-status (%finish))
        (clrhash *ui-timers*)
        (clrhash *ui-actions*)
        (clrhash *handler-client-data-roots*)
        (clrhash *tree-item-objects*)
        (when (boundp '*list-provider-roots*) (setf (symbol-value '*list-provider-roots*) nil))))))

(defun call-with-application (function)
  "Run FUNCTION in a main-thread GUI session, masking SBCL floating-point traps
while native GUI code runs. The REPL blocks until FUNCTION returns."
  #+sbcl (sb-int:with-float-traps-masked (:invalid :divide-by-zero :overflow
                                        :underflow :inexact)
           (%call-with-application function))
  #+(and ccl darwin)
  (if (eq ccl:*current-process* ccl::*initial-process*)
      (%call-with-application function)
      (let ((failure nil))
        (multiple-value-prog1
            (ccl::call-in-initial-process
             (lambda ()
               (handler-case (%call-with-application function)
                 (error (condition) (setf failure condition) nil))))
          (when failure (error failure)))))
  #-(or sbcl (and ccl darwin)) (%call-with-application function))

(defmacro with-application (() &body body)
  `(call-with-application (lambda () ,@body)))

(defun run ()
  "Block in the GUI event loop until the last frame closes or STOP is called."
  (when *repl-running*
    (error "RUN is unavailable inside the application REPL; events are already being processed"))
  (check-status (%run))
  (check-callback-error))
(defun stop ()
  "Leave RUN or the application REPL."
  (if *repl-running* (setf *repl-running* nil) (check-status (%stop))))

(defun process-events ()
  "Process GUI events and idle work without blocking; forbidden inside pumps or callbacks."
  (when *repl-debugging*
    (error "GUI event processing is paused in the application REPL debugger"))
  (check-status (%poll))
  (check-callback-error))

(defun require-active-application ()
  (unless *active*
    (error 'native-error :message "An active application session is required")))

(defun main-loop-running-p ()
  "Return true while the active application's native blocking main loop runs."
  (require-active-application)
  (boolean-result (%main-loop-running)))
(defun pending-events-p ()
  "Query queued wx events, excluding OS input, idle work and future timers."
  (require-active-application)
  (boolean-result (%pending-events)))
(defun process-pending-events ()
  "Dispatch queued wx events only, outside RUN, other pumps and callbacks."
  (require-active-application)
  (when *repl-debugging*
    (error "GUI event processing is paused in the application REPL debugger"))
  (check-status (%process-pending-events))
  (check-callback-error))

(defun repl-input-ready-p (input)
  "Skip available standard whitespace without waiting. Return READY-P, EOF-P."
  (let ((eof (gensym "EOF")))
    (loop for character = (read-char-no-hang input nil eof) do
      (cond ((eq character eof) (return (values nil t)))
            ((null character) (return (values nil nil)))
            ((find character '(#\Space #\Tab #\Newline #\Return #\Page)))
            (t (unread-char character input)
               (return (values t nil)))))))

(defun report-repl-error (condition output)
  "Report before unwinding so the fallback backtrace retains evaluation frames."
  (format output "~&~A: ~A~%" (type-of condition) condition)
  (format output "Backtrace (up to 20 frames):~%")
  (let ((*print-level* 4) (*print-length* 8))
    (unless (ignore-errors
              #+sbcl (sb-debug:print-backtrace :stream output :count 20)
              #+ccl (ccl:print-call-history :stream output :count 20)
              #+(or sbcl ccl) t
              #-(or sbcl ccl) nil)
      (format output "Backtrace unavailable on this Lisp.~%")))
  (finish-output output))

(defun call-with-repl-recovery (function on-error output)
  (restart-case
      (handler-bind
          ((error (lambda (condition)
                    ;; This handler is reached only at a Lisp boundary, after
                    ;; foreign callbacks have returned. Do not pump GUI events
                    ;; during diagnosis, including explicit PROCESS-EVENTS calls.
                    (let ((*repl-debugging* t))
                      (ecase on-error
                        (:debug (invoke-debugger condition))
                        (:report
                         (report-repl-error condition output)
                         (invoke-restart 'return-to-application-repl)))))))
        (funcall function))
    (return-to-application-repl ()
      :report "Abandon the current operation and return to the application REPL."
      nil)))

(defun application-repl (input output on-error)
  (check-type on-error (member :debug :report))
  (let ((*repl-running* t)
        (eof (gensym "EOF")))
    (loop while *repl-running* do
      (call-with-repl-recovery
       (lambda ()
         (process-events)
         (unless *repl-running* (return))
         (multiple-value-bind (ready-p eof-p) (repl-input-ready-p input)
           (when eof-p (return))
           (when ready-p
             (let ((form (read input nil eof)))
               (when (eq form eof) (return))
               (dolist (value (multiple-value-list (eval form)))
                 (prin1 value output)
                 (terpri output))
               (finish-output output)))))
       on-error output)
      (unless *repl-running* (return))
      (sleep 0.01))))

(defmacro with-repl-application ((&key (input '*standard-input*)
                                     (output '*standard-output*)
                                     (on-error :debug)) &body body)
  "Run BODY, then a cooperative terminal REPL in the same GUI session.
Use STOP or EOF to leave. Live objects can be kept in special variables.
Incomplete input, evaluation, and the debugger suspend event processing.
ON-ERROR is :DEBUG (the default), preserving evaluation restarts, or :REPORT,
printing a backtrace and abandoning the operation. The debugger offers the
RETURN-TO-APPLICATION-REPL restart. Setup errors propagate to the caller."
  `(call-with-application
    (lambda ()
      ,@body
      (application-repl ,input ,output ,on-error))))

;;; Native-backed CLOS initialization. A concrete class owns exactly one native kind.
(defun adopt-native (object id)
  (when (zerop id) (error 'native-error :message (%last-error)))
  (setf (slot-value object 'handle) id)
  (when (and (typep object 'event-handler) (not (typep object 'window))
             (not (typep object 'application-handler)))
    (setf (gethash id *standalone-handler-objects*) object))
  object)

(defun rollback-construction (objects)
  (when *event-bindings*
    (let (tokens)
      (maphash (lambda (token binding)
                 (when (member (event-binding-source binding) objects :test #'eq)
                   (push token tokens))) *event-bindings*)
      (dolist (token tokens)
        (ignore-errors (%unbind token))
        (remhash token *event-bindings*))))
  ;; Remove Lisp callback roots before requesting native destruction. Children
  ;; created by nested initializers appear before their parents in this list.
  (when *handlers*
    (let ((tokens nil))
      (maphash (lambda (token handler)
                 (when (member (handler-source handler) objects :test #'eq)
                   (push token tokens)))
               *handlers*)
      (dolist (token tokens) (remhash token *handlers*))))
  (dolist (object objects)
    (when (and (slot-exists-p object 'handler-token)
               (slot-boundp object 'handler-token))
      (setf (handler-token object) nil))
    (when (and (slot-boundp object 'handle) (slot-value object 'handle))
      ;; Keep the original initialization condition/nonlocal exit intact.
      (ignore-errors (funcall (cond ((typep object 'image-resource) (lambda (id) (%image-destroy id (if (typep object 'bitmap) 1 0)))) ((typep object 'window) #'%destroy) ((typep object 'owned-event) #'%event-destroy) ((typep object 'menu-resource) #'%menu-destroy) (t #'%handler-destroy))
                             (slot-value object 'handle)))
      (when *standalone-handler-objects*
        (remhash (slot-value object 'handle) *standalone-handler-objects*))
      (setf (slot-value object 'handle) nil)))
  (ignore-errors (reap-client-data-roots))
  (ignore-errors (reap-tree-items))
  (ignore-errors (reap-ui-actions))
  (ignore-errors (reap-ui-timers))
  (when (fboundp 'reap-list-provider-roots) (ignore-errors (reap-list-provider-roots))))

(defmethod initialize-instance :around ((object event-handler) &rest initargs)
  (declare (ignore initargs))
  (when (or (typep object 'owned-event) (typep object 'menu-resource))
    (error "EVENT-HANDLER cannot share ancestry with OWNED-EVENT or MENU-RESOURCE"))
  (when (typep object 'application-handler)
    (error "APPLICATION-HANDLER is borrowed; use CURRENT-APPLICATION-HANDLER"))
  (when (and (typep object 'window)
             (/= 1 (count-if (lambda (kind) (typep object kind))
                         '(frame toolbar status-bar panel scrolled-panel notebook list-box tree-control splitter-window button text-control label checkbox choice gauge slider spin-control radio-box toggle-button combo-box date-picker time-picker search-control drawing-canvas activity-indicator grid web-view styled-text-control aui-notebook list-control static-bitmap text-entry-dialog single-choice-dialog message-dialog file-dialog))))
    (error "~A must inherit exactly one concrete wxlambda widget class; WINDOW is abstract"
           (class-name (class-of object))))
  (unless *active*
    (error 'native-error :message "Native construction requires an active application session"))
  (when (and (slot-boundp object 'handle) (slot-value object 'handle))
    (error "This object already has a native handle"))
  (let* ((*initializing-handlers* (cons object *initializing-handlers*))
         (parent-context *construction-context*)
         (*construction-context* (list (list object)))
         (complete nil))
    (unwind-protect
         (multiple-value-prog1 (call-next-method)
           (unless (and (slot-boundp object 'handle) (slot-value object 'handle))
             (error "No native object was created; INITIALIZE-INSTANCE must call its inherited method"))
           (when parent-context
             (setf (car parent-context) (nconc (car *construction-context*) (car parent-context))))
           (setf complete t))
      (unless complete (rollback-construction (car *construction-context*))))))

(defmethod initialize-instance :after ((object event-handler) &rest initargs)
