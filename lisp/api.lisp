;;; Accelerator specs are Lisp data, not native resource wrappers.
(defparameter +accelerator-function-keys+ '(:f1 :f2 :f3 :f4 :f5 :f6 :f7 :f8 :f9 :f10 :f11 :f12))
(defun accelerator-list-length (value)
  (check-type value list)
  (or (list-length value) (error "Accelerator specifications must be finite proper lists")))
(defun accelerator-key-code (key)
  (cond ((and (characterp key) (or (find key "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") (find key "0123456789")))
         (char-code (char-upcase key)))
        ((position key +accelerator-function-keys+) (+ 1001 (position key +accelerator-function-keys+)))
        (t (error "Accelerator key must be an ASCII letter/digit or :F1..:F12"))))
(defun accelerator-entry-codes (entry)
  (let ((length (accelerator-list-length entry)))
    (unless (<= 2 length 6) (error "Accelerator entry is (KEY ID &rest MODIFIERS)")))
  (destructuring-bind (key id &rest modifiers) entry
    (check-type id (integer 1 32767))
    (let ((flags 0) (code (accelerator-key-code key)))
      (dolist (modifier modifiers)
        (let ((bit (ecase modifier (:ctrl 1) (:shift 2) (:alt 4) (:raw-ctrl 8))))
          (when (logtest bit flags) (error "Duplicate accelerator modifier"))
          (setf flags (logior bit flags))))
      (when (= 9 (logand flags 9)) (error "Use :CTRL or :RAW-CTRL, not both"))
      (when (and (< code 1001) (zerop (logand flags 13)))
        (error "Letter/digit accelerators require :CTRL, :ALT or :RAW-CTRL"))
      (values code flags id))))
(defgeneric frame-accelerators (frame))
(defmethod frame-accelerators ((frame frame))
  (let ((count (gauge-integer-result (%frame-accelerator-count (handle frame)))))
    (cffi:with-foreign-objects ((key :int) (flags :int) (command :int))
      (loop for index below count collect
        (progn
          (check-status (%frame-accelerator-entry (handle frame) index key flags command))
          (let ((code (cffi:mem-ref key :int)) (bits (cffi:mem-ref flags :int)))
            (list* (if (< code 1001) (code-char code) (nth (- code 1001) +accelerator-function-keys+))
                   (cffi:mem-ref command :int)
                   (loop for (modifier . bit) in '((:ctrl . 1) (:shift . 2) (:alt . 4) (:raw-ctrl . 8))
                         when (logtest bit bits) collect modifier))))))))
(defgeneric (setf frame-accelerators) (value frame))
(defmethod (setf frame-accelerators) (value (frame frame))
  (let ((count (accelerator-list-length value)))
    (unless (<= count 256) (error "At most 256 accelerator entries are supported"))
    (cffi:with-foreign-objects ((keys :int (max 1 count)) (flags :int (max 1 count)) (commands :int (max 1 count)))
      (loop for entry in value for index from 0 do
        (multiple-value-bind (key bits command) (accelerator-entry-codes entry)
          (setf (cffi:mem-aref keys :int index) key
                (cffi:mem-aref flags :int index) bits
                (cffi:mem-aref commands :int index) command)))
      (check-status (%set-frame-accelerators (handle frame) keys flags commands count)))) value)

