(defmethod fit-scroll-content ((panel scrolled-panel))
  (call-setter (lambda () (%fit-scroll-content (handle panel))) t) panel)

;;; Native focus requests and bounded tab-order traversal.
(defgeneric focus-window (window &key from-keyboard))
(defmethod focus-window ((window window) &key from-keyboard)
  (call-setter (lambda () (%focus-window (handle window) (if from-keyboard 1 0))) t)
  window)
(defgeneric navigate-focus (window &key forward))
(defmethod navigate-focus ((window window) &key (forward t))
  (let ((handled (with-native-notifier
                   (boolean-result (%navigate-focus (handle window) (if forward 1 0))))))
    (check-callback-error) handled))

;;; Window-owned tooltip text, with NIL removal and copied string reads.
(defgeneric tooltip-text (window))
(defmethod tooltip-text ((window window))
  (cffi:with-foreign-objects ((length :size) (present :int))
    (let ((pointer (%tooltip-text (handle window) length present)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (unless (zerop (cffi:mem-ref present :int))
        (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8)))))
(defgeneric (setf tooltip-text) (value window))
(defmethod (setf tooltip-text) (value (window window))
  (if (null value)
      (call-setter (lambda () (%set-tooltip-text (handle window) (cffi:null-pointer) 0 0)) t)
      (progn
        (check-text-value value)
        (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
          (when (> (1- bytes) 4096) (error "Tooltip text supports at most4096 UTF-8 bytes"))
          (call-setter (lambda () (%set-tooltip-text (handle window) pointer (1- bytes) 1)) t))))
  value)

;;; Required calendar date with a portable bounded Gregorian tuple adapter.
(defun check-calendar-date (value)
  (check-type value (cons (integer 1900 2100) (cons (integer 1 12) (cons (integer 1 31) null))))
  (destructuring-bind (year month day) value
    (let* ((leap (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400)))))
           (days (if (= month 2) (if leap 29 28) (nth (1- month) '(31 28 31 30 31 30 31 31 30 31 30 31)))))
      (unless (<= day days) (error "Invalid Gregorian date ~S" value)))) value)
(defun decode-calendar-date (code)
  (unless (zerop code) (list (floor code 10000) (mod (floor code 100) 100) (mod code 100))))
(defmethod initialize-instance :after ((object date-picker) &key parent (date '(2000 1 1)))
  (check-type parent window) (check-calendar-date date)
  (adopt-native object (%date-picker (handle parent) (first date) (second date) (third date))))
(defgeneric make-date-picker (parent &rest initargs &key class date &allow-other-keys))
(defmethod make-date-picker ((parent window) &rest initargs &key (class 'date-picker) &allow-other-keys)
  (apply #'make-widget class 'date-picker :parent parent initargs))
(defgeneric calendar-date (control &key notify))
(defmethod calendar-date ((control date-picker) &key notify)
  (declare (ignore notify))
  (cffi:with-foreign-object (code :int)
    (check-status (%calendar-date (handle control) code))
    (decode-calendar-date (cffi:mem-ref code :int))))
(defgeneric (setf calendar-date) (value control &key notify))
(defmethod (setf calendar-date) (value (control date-picker) &key notify)
  (check-calendar-date value)
  (call-setter (lambda () (%set-calendar-date (handle control) (first value) (second value) (third value) (if notify 1 0))) notify)
  value)
(defgeneric event-date (event))
(defmethod event-date ((event event)) (decode-calendar-date (event-date-code-value event)))
(defmethod event-date ((event event-context)) (decode-calendar-date (read-event-field event 19)))

;;; Required time-of-day values, independent of dates and timestamps.
(defun check-clock-time (value)
  (check-type value (cons (integer 0 23) (cons (integer 0 59) (cons (integer 0 59) null)))) value)
(defun decode-clock-time (code)
  (unless (zerop code)
    (let ((seconds (1- code))) (list (floor seconds 3600) (mod (floor seconds 60) 60) (mod seconds 60)))))
(defmethod initialize-instance :after ((object time-picker) &key parent (time '(0 0 0)))
  (check-type parent window) (check-clock-time time)
  (adopt-native object (%time-picker (handle parent) (first time) (second time) (third time))))
(defgeneric make-time-picker (parent &rest initargs &key class time &allow-other-keys))
(defmethod make-time-picker ((parent window) &rest initargs &key (class 'time-picker) &allow-other-keys)
  (apply #'make-widget class 'time-picker :parent parent initargs))
(defgeneric clock-time (control &key notify))
(defmethod clock-time ((control time-picker) &key notify)
  (declare (ignore notify))
  (cffi:with-foreign-object (code :int)
    (check-status (%clock-time (handle control) code))
    (decode-clock-time (cffi:mem-ref code :int))))
(defgeneric (setf clock-time) (value control &key notify))
(defmethod (setf clock-time) (value (control time-picker) &key notify)
  (check-clock-time value)
  (call-setter (lambda () (%set-clock-time (handle control) (first value) (second value) (third value) (if notify 1 0))) notify)
  value)
(defgeneric event-time (event))
(defmethod event-time ((event event)) (decode-clock-time (event-time-code-value event)))
(defmethod event-time ((event event-context)) (decode-clock-time (read-event-field event 20)))

;;; Search inputs retain native command text and use only the bounded text protocol.
(defun check-search-text (value)
  (check-text-value value)
  (when (or (find #\Return value) (find #\Newline value)) (error "Search text/hint must be single-line")) value)
(defmethod initialize-instance :after ((object search-control) &key parent (value "") (hint "Search"))
  (check-type parent window) (check-search-text value) (check-search-text hint)
  (cffi:with-foreign-strings (((text bytes) value :encoding :utf-8) ((placeholder hint-bytes) hint :encoding :utf-8))
    (adopt-native object (%search-control (handle parent) text (1- bytes) placeholder (1- hint-bytes)))))
(defgeneric make-search-control (parent &rest initargs &key class value hint &allow-other-keys))
(defmethod make-search-control ((parent window) &rest initargs &key (class 'search-control) &allow-other-keys)
  (apply #'make-widget class 'search-control :parent parent initargs))
(defun native-search-field (control field)
  (cffi:with-foreign-object (length :size)
    (let ((pointer (%search-field (handle control) field length)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))
(defmethod text ((control search-control) &key notify)
  (declare (ignore notify)) (native-search-field control 0))
(defun assign-search-field (control field value notify)
  (check-search-text value)
  (cffi:with-foreign-string ((pointer bytes) value :encoding :utf-8)
    (call-setter (lambda () (%set-search-field (handle control) field pointer (1- bytes) (if notify 1 0))) notify)) value)
(defmethod (setf text) (value (control search-control) &key notify) (assign-search-field control 0 value notify))
(defgeneric search-hint (control))
(defmethod search-hint ((control search-control)) (native-search-field control 1))
(defgeneric (setf search-hint) (value control))
(defmethod (setf search-hint) (value (control search-control)) (assign-search-field control 1 value nil))
