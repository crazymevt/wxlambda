(in-package #:wxlambda)
(defun check-new-splitter-pane (pane)
  (when (member pane *initializing-handlers* :test #'eq) (error "Complete pane initialization before attachment")))
(defgeneric initialize-splitter (splitter pane))
(defmethod initialize-splitter ((splitter splitter-window) (pane panel))
  (check-new-splitter-pane pane)
  (let ((previous (splitter-panes splitter)) (complete nil))
    (setf (splitter-panes splitter) (list pane))
    (unwind-protect
         (progn (check-status (with-native-notifier (%splitter-initialize (handle splitter) (handle pane))))
                (setf complete t) (check-callback-error) pane)
      (unless complete (setf (splitter-panes splitter) previous)))))
(defgeneric unsplit-window (splitter &key remove))
(defmethod unsplit-window ((splitter splitter-window) &key (remove 1))
  (check-type remove (member 0 1))
  (let ((pane (splitter-pane splitter remove)) (remaining (splitter-pane splitter (- 1 remove))))
    (check-status (with-native-notifier (%splitter-unsplit (handle splitter) remove)))
    (setf (splitter-panes splitter) (list remaining)) (check-callback-error) pane))
(defgeneric replace-splitter-pane (splitter index pane))
(defmethod replace-splitter-pane ((splitter splitter-window) index (pane panel))
  (check-type index (member 0 1)) (check-new-splitter-pane pane)
  (let ((old (splitter-pane splitter index)) (previous (splitter-panes splitter)) (complete nil))
    (setf (splitter-panes splitter) (adjoin pane previous :test #'eq))
    (unwind-protect
         (progn (check-status (with-native-notifier (%splitter-replace (handle splitter) index (handle pane))))
                (setf complete t (splitter-panes splitter) (remove old (splitter-panes splitter) :test #'eq))
                (check-callback-error) old)
      (unless complete (setf (splitter-panes splitter) previous)))))
(defgeneric resplit-window (splitter pane))
(defmethod resplit-window ((splitter splitter-window) (pane panel))
  (check-new-splitter-pane pane)
  (let ((previous (splitter-panes splitter)) (complete nil))
    (pushnew pane (splitter-panes splitter) :test #'eq)
    (unwind-protect
         (progn (check-status (with-native-notifier (%splitter-resplit (handle splitter) (handle pane))))
                (setf complete t) (check-callback-error) pane)
      (unless complete (setf (splitter-panes splitter) previous)))))
(defgeneric (setf splitter-orientation) (value splitter))
(defmethod (setf splitter-orientation) (value (splitter splitter-window))
  (let ((code (ecase value (:vertical 0) (:horizontal 1))))
    (call-setter (lambda () (%set-splitter-orientation (handle splitter) code)) t)) value)
