(in-package #:wxlambda)

(defclass activity-indicator (window) ())
(defmethod initialize-instance :after ((object activity-indicator) &key parent running-p)
  (check-type parent window)
  (adopt-native object (%activity-indicator (handle parent) (if running-p 1 0))))
(defgeneric make-activity-indicator (parent &rest initargs &key class running-p &allow-other-keys))
(defmethod make-activity-indicator ((parent window) &rest initargs &key (class 'activity-indicator) &allow-other-keys)
  (apply #'make-widget class 'activity-indicator :parent parent initargs))
(defgeneric activity-running-p (indicator))
(defmethod activity-running-p ((indicator activity-indicator))
  (boolean-result (%activity-running (handle indicator))))
(defgeneric (setf activity-running-p) (value indicator))
(defmethod (setf activity-running-p) (value (indicator activity-indicator))
  (call-setter (lambda () (%set-activity-running (handle indicator) (if value 1 0))) t)
  value)
