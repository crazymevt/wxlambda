(in-package #:wxlambda)
(defclass drawing-canvas (window) ((content :initform nil)))
(defun canvas-list (value maximum)
  (check-type value list)
  (let ((size (list-length value)))
    (unless (and size (<= size maximum)) (error "Canvas requires a finite proper list of at most ~D elements" maximum)) size))
(defun canvas-rgb (value)
  (check-type value (cons (integer 0 255) (cons (integer 0 255) (cons (integer 0 255) null)))) (copy-list value))
(defun packed-canvas-rgb (value) (+ (ash (first value) 16) (ash (second value) 8) (third value)))
(defun normalize-canvas-content (value)
  (unless (and (= (canvas-list value 4) 4) (= (count :background value) 1) (= (count :items value) 1)
               (loop for key in value by #'cddr always (member key '(:background :items))))
    (error "Canvas content requires exactly :BACKGROUND and :ITEMS"))
  (let ((background (canvas-rgb (getf value :background))) (items (getf value :items))
        (text-bytes 0) (bitmap-bytes 0))
    (canvas-list items 512)
    (list :background background :items
      (mapcar
        (lambda (item)
          (let ((count (canvas-list item 7)))
            (unless (and (member (first item) '(:rect :line :ellipse :text :bitmap))
                         (= count (if (eq (first item) :line) 7 6))) (error "Invalid canvas primitive shape or kind")))
          (let ((kind (first item)) (x (second item)) (y (third item))
                (a (fourth item)) (b (fifth item)) (payload (sixth item)))
            (check-type x (integer -10000 10000)) (check-type y (integer -10000 10000))
            (case kind
              (:line
                (check-type a (integer -10000 10000)) (check-type b (integer -10000 10000))
                (check-type (seventh item) (integer 1 32))
                (list kind x y a b (canvas-rgb payload) (seventh item)))
              (:text
                (check-text-value a) (check-type b (integer 6 72))
                (when (or (> (length a) 65536) (find #\Return a) (find #\Newline a))
                  (error "Canvas text must be bounded and single-line"))
                (cffi:with-foreign-string ((pointer bytes) a :encoding :utf-8)
                  (incf text-bytes (1- bytes)))
                (when (> text-bytes 65536) (error "Canvas scene exceeds65536 UTF-8 text bytes"))
                (list kind x y (copy-seq a) b (canvas-rgb payload)))
              (:bitmap
                (check-type a (integer 1 256)) (check-type b (integer 1 256))
                (check-type payload (simple-array (unsigned-byte 8) (*)))
                (unless (= (length payload) (* a b 3)) (error "Bitmap requires exact width*height*3 RGB bytes"))
                (incf bitmap-bytes (length payload))
                (when (> bitmap-bytes 2097152) (error "Canvas scene exceeds2MiB bitmap bytes"))
                (list kind x y a b (copy-seq payload)))
              (otherwise
                (check-type a (integer 1 10000)) (check-type b (integer 1 10000))
                (list kind x y a b (canvas-rgb payload)))))) items))))
(defgeneric canvas-client-size (canvas))
(defmethod canvas-client-size ((canvas drawing-canvas))
  (cffi:with-foreign-objects ((width :int) (height :int))
    (check-status (%canvas-client-size (handle canvas) width height))
    (list (cffi:mem-ref width :int) (cffi:mem-ref height :int))))
(defun assign-canvas-content (canvas normalized)
  (let ((items (getf normalized :items)) (allocated nil))
    (unwind-protect
         (cffi:with-foreign-object (array '(:struct native-canvas-item) (max 1 (length items)))
           (loop for item in items for i from 0 do
             (let ((record (cffi:mem-aptr array '(:struct native-canvas-item) i)))
               (cffi:with-foreign-slots ((kind x y width height rgb option text text-length pixels pixel-length) record (:struct native-canvas-item))
                 (setf kind (ecase (first item) (:rect 1) (:line 2) (:ellipse 3) (:text 4) (:bitmap 5))
                       x (second item) y (third item) width 0 height 0 rgb 0 option 1
                       text (cffi:null-pointer) text-length 0 pixels (cffi:null-pointer) pixel-length 0)
                 (if (= kind 4)
                     (multiple-value-bind (pointer bytes) (cffi:foreign-string-alloc (fourth item) :encoding :utf-8)
                       (push pointer allocated) (setf text pointer text-length (1- bytes) option (fifth item)))
                     (setf width (fourth item) height (fifth item)))
                 (if (= kind 5)
                     (let* ((data (sixth item)) (pointer (cffi:foreign-alloc :uint8 :count (length data))))
                       (push pointer allocated)
                       (dotimes (j (length data)) (setf (cffi:mem-aref pointer :uint8 j) (aref data j)))
                       (setf pixels pointer pixel-length (length data)))
                     (setf rgb (packed-canvas-rgb (sixth item))))
                 (when (= kind 2) (setf option (seventh item))))))
           (with-native-notifier
             (check-status (%set-canvas-content (handle canvas) (packed-canvas-rgb (getf normalized :background)) array (length items)))
             (setf (slot-value canvas 'content) normalized))
           (check-callback-error))
      (dolist (pointer allocated) (cffi:foreign-free pointer)))))
(defmethod initialize-instance :after ((canvas drawing-canvas) &key parent (content '(:background (255 255 255) :items nil)))
  (check-type parent window)
  (let ((normalized (normalize-canvas-content content)))
    (adopt-native canvas (%drawing-canvas (handle parent)))
    (assign-canvas-content canvas normalized)))
(defgeneric make-drawing-canvas (parent &rest initargs &key class content &allow-other-keys))
(defmethod make-drawing-canvas ((parent window) &rest initargs &key (class 'drawing-canvas) &allow-other-keys)
  (apply #'make-widget class 'drawing-canvas :parent parent initargs))
(defgeneric canvas-content (canvas))
(defmethod canvas-content ((canvas drawing-canvas))
  (canvas-client-size canvas) ; Validate native lifetime and report native paint failures.
  (normalize-canvas-content (slot-value canvas 'content)))
(defgeneric (setf canvas-content) (value canvas))
(defmethod (setf canvas-content) (value (canvas drawing-canvas))
  (assign-canvas-content canvas (normalize-canvas-content value)) value)
(defgeneric save-canvas-image (canvas path &key width height))
(defmethod save-canvas-image ((canvas drawing-canvas) path &key (width 640) (height 480))
  (check-type path (or string pathname)) (check-type width (integer 1 2048)) (check-type height (integer 1 2048))
  (let ((filename (uiop:native-namestring path)))
    (check-text-value filename)
    (cffi:with-foreign-string ((pointer bytes) filename :encoding :utf-8)
      (call-setter (lambda () (%save-canvas-image (handle canvas) pointer (1- bytes) width height)) t)))
  (pathname path))
