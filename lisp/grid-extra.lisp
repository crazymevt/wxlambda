(in-package #:wxlambda)
(defgeneric grid-cell-read-only-p (grid row column))
(defgeneric (setf grid-cell-read-only-p) (value grid row column))
(defgeneric grid-cell-background (grid row column))
(defgeneric (setf grid-cell-background) (value grid row column))
(defgeneric grid-cell-foreground (grid row column))
(defgeneric (setf grid-cell-foreground) (value grid row column))
(defgeneric enable-grid-cell-edit-control (grid))
(defgeneric save-grid-edit-control-value (grid))
(defgeneric hide-grid-cell-edit-control (grid))
(defgeneric disable-grid-cell-edit-control (grid))
(defgeneric reset-grid-cell-editor (grid))
(defgeneric append-grid-rows (grid &optional count))
(defgeneric append-grid-columns (grid &optional count))
(defgeneric insert-grid-rows (grid position &optional count))
(defgeneric insert-grid-columns (grid position &optional count))
(defgeneric delete-grid-rows (grid position &optional count))
(defgeneric delete-grid-columns (grid position &optional count))
(defgeneric event-grid-row (event))
(defgeneric event-grid-column (event))
(defgeneric event-grid-modifiers (event))
(defparameter *grid-event-kinds*
  '((160 . :grid-cell-changing) (161 . :grid-cell-changed) (162 . :grid-select-cell)
    (163 . :grid-range-selecting) (164 . :grid-range-selected) (165 . :grid-editor-shown)
    (166 . :grid-editor-hidden) (167 . :grid-cell-left-click) (168 . :grid-cell-right-click)
    (169 . :grid-cell-left-double-click) (170 . :grid-cell-right-double-click)))
(setf *extension-event-kinds*
  (append *grid-event-kinds* (remove-if (lambda (entry) (assoc (car entry) *grid-event-kinds*)) *extension-event-kinds*)))
(defun grid-extra-index (value) (check-type value (signed-byte 32)) value)
(defun grid-extra-read (grid property &optional (row 0) (column 0))
  (cffi:with-foreign-object (value :int64)
    (check-status (%grid-extra-get (handle grid) property (grid-extra-index row) (grid-extra-index column) value))
    (cffi:mem-ref value :int64)))
(defmacro define-grid-cell-property (name property boolean)
  `(progn
     (defmethod ,name ((grid grid) row column)
       (let ((value (grid-extra-read grid ,property row column))) ,(if boolean '(not (zerop value)) 'value)))
     (defmethod (setf ,name) (value (grid grid) row column)
       ,@(unless boolean '((check-type value (unsigned-byte 24))))
       (call-setter (lambda () (%grid-extra-set (handle grid) ,property (grid-extra-index row) (grid-extra-index column)
                                               ,(if boolean '(if value 1 0) 'value))) t) value)))
(define-grid-cell-property grid-cell-read-only-p 0 t)
(define-grid-cell-property grid-cell-background 1 nil)
(define-grid-cell-property grid-cell-foreground 2 nil)
(defgeneric grid-cell-editor-shown-p (grid))
(defmethod grid-cell-editor-shown-p ((grid grid)) (not (zerop (grid-extra-read grid 3))))
(defgeneric grid-can-enable-cell-control-p (grid))
(defmethod grid-can-enable-cell-control-p ((grid grid)) (not (zerop (grid-extra-read grid 4))))
(defgeneric grid-cursor (grid))
(defmethod grid-cursor ((grid grid))
  (let ((row (grid-extra-read grid 5)) (column (grid-extra-read grid 6)))
    (when (and (not (minusp row)) (not (minusp column)))
      (list row column))))
(defgeneric (setf grid-cursor) (value grid))
(defmethod (setf grid-cursor) (value (grid grid))
  (check-type value (cons integer (cons integer null)))
  (call-setter (lambda () (%set-grid-cursor (handle grid) (grid-extra-index (first value)) (grid-extra-index (second value)))) t) value)
(defmacro define-grid-editor-operation (name code)
  `(progn
          (defmethod ,name ((grid grid)) (call-setter (lambda () (%grid-editor-action (handle grid) ,code)) t) grid)))
(define-grid-editor-operation enable-grid-cell-edit-control 0)
(define-grid-editor-operation save-grid-edit-control-value 1)
(define-grid-editor-operation hide-grid-cell-edit-control 2)
(define-grid-editor-operation disable-grid-cell-edit-control 3)
(define-grid-editor-operation reset-grid-cell-editor 4)
(defmacro define-grid-table-operation (name axis action appendp)
  `(progn
     (defmethod ,name ((grid grid) ,@(unless appendp '(position)) &optional (count 1))
       (call-setter (lambda () (%grid-table-action (handle grid) ,axis ,action
                                  ,(if appendp 0 '(grid-extra-index position)) (grid-extra-index count))) t) grid)))
(define-grid-table-operation append-grid-rows 0 0 t)
(define-grid-table-operation insert-grid-rows 0 1 nil)
(define-grid-table-operation delete-grid-rows 0 2 nil)
(define-grid-table-operation append-grid-columns 1 0 t)
(define-grid-table-operation insert-grid-columns 1 1 nil)
(define-grid-table-operation delete-grid-columns 1 2 nil)
(defgeneric select-grid-block (grid top left bottom right &key add))
(defmethod select-grid-block ((grid grid) top left bottom right &key add)
  (call-setter (lambda () (%grid-select-block (handle grid) (grid-extra-index top) (grid-extra-index left)
                                (grid-extra-index bottom) (grid-extra-index right) (if add 1 0))) t) grid)
(defgeneric clear-grid-selection (grid))
(defmethod clear-grid-selection ((grid grid)) (call-setter (lambda () (%grid-clear-selection (handle grid))) t) grid)
(defun capture-grid-event-value (snapshot)
  ;; The shared transport calls this before invoking any user callback. Existing
  ;; native getter copies a value while actual-source input guards are active.
  (when (member (event-kind snapshot) '(:grid-cell-changing :grid-cell-changed))
    (let* ((details (event-details snapshot)) (id (event-origin-code snapshot))
           (row (aref details 0)) (column (aref details 1)))
      (setf (aref details 23)
        (when (and (plusp id) (<= 0 row) (<= 0 column)
                   (< row (%grid-property id 0)) (< column (%grid-property id 1)))
          (cffi:with-foreign-object (length :size)
            (let ((pointer (%grid-text id 0 row column length)))
              (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
              (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8))))))))
(defun grid-event-detail (event field range-only)
  (let* ((kind (event-kind event)) (code (car (rassoc kind *grid-event-kinds*)))
         (range (member code '(163 164))))
    (unless (and code (or (eq range-only :either) (if range-only range (not range))))
      (error "Grid detail is unavailable for ~S" kind)))
  (etypecase event
    (event (aref (event-details event) field))
    (event-context
      (cffi:with-foreign-object (value :int64)
        (check-status (%grid-event-detail (event-context-token event) field value)) (cffi:mem-ref value :int64)))))
(defmacro define-grid-event-reader (name field range-only)
  `(progn
          (defmethod ,name ((event event)) (grid-event-detail event ,field ,range-only))
          (defmethod ,name ((event event-context)) (grid-event-detail event ,field ,range-only))))
(define-grid-event-reader event-grid-row 0 nil)
(define-grid-event-reader event-grid-column 1 nil)
(define-grid-event-reader event-grid-modifiers 5 :either)
(defgeneric event-grid-selecting-p (event))
(defmethod event-grid-selecting-p ((event event)) (not (zerop (grid-event-detail event 4 :either))))
(defmethod event-grid-selecting-p ((event event-context)) (not (zerop (grid-event-detail event 4 :either))))
(defgeneric event-grid-position (event))
(defmethod event-grid-position ((event event))
  (let ((x (grid-event-detail event 2 nil)) (y (grid-event-detail event 3 nil)))
    (unless (and (= x -1) (= y -1)) (list x y))))
(defmethod event-grid-position ((event event-context))
  (let ((x (grid-event-detail event 2 nil)) (y (grid-event-detail event 3 nil)))
    (unless (and (= x -1) (= y -1)) (list x y))))
(defgeneric event-grid-range (event))
(defmethod event-grid-range ((event event)) (loop for i from 6 to 9 collect (grid-event-detail event i t)))
(defmethod event-grid-range ((event event-context)) (loop for i from 6 to 9 collect (grid-event-detail event i t)))
(defgeneric event-grid-cell-value (event))
(defmethod event-grid-cell-value ((event event))
  (unless (member (event-kind event) '(:grid-cell-changing :grid-cell-changed)) (error "Not a grid cell value event"))
  (let ((value (aref (event-details event) 23))) (when value (copy-seq value))))
(defmethod event-grid-cell-value ((event event-context))
  (cffi:with-foreign-objects ((length :size) (available :int))
    (let ((pointer (%grid-event-value (event-context-token event) length available)))
      (when (cffi:null-pointer-p pointer) (error 'native-error :message (%last-error)))
      (unless (zerop (cffi:mem-ref available :int))
        (cffi:foreign-string-to-lisp pointer :count (cffi:mem-ref length :size) :encoding :utf-8)))))
