(load (merge-pathnames "../examples/date-picker.lisp" *load-truename*))
(defun date-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-date-picker (wxlambda:date-picker) ((tag :initarg :tag :reader date-tag))
  (:default-initargs :date '(2000 2 29) :tag :default))
(defmethod initialize-instance :after ((object custom-date-picker) &key)
  (assert (equal '(2000 2 29) (wxlambda:calendar-date object))))
(defclass mixed-date-picker (wxlambda:date-picker wxlambda:text-control) ())
(defclass failing-date-picker (custom-date-picker) ())
(defvar *failed-date-picker* nil)
(defmethod initialize-instance :after ((object failing-date-picker) &key)
  (setf *failed-date-picker* object)
  (wxlambda:bind-event object :date-change (lambda (event) (declare (ignore event))))
  (error "Expected date construction rollback"))
(defvar *date-snapshot* nil)
(defvar *date-context* nil)
(wxlambda:with-application ()
  (assert (wxlambda-date-picker:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (picker (wxlambda:make-date-picker panel :class 'custom-date-picker :tag :factory))
         (peer (wxlambda:make-date-picker panel)) (calls 0) (parent-calls 0))
    (assert (eq :factory (date-tag picker)))
    (assert (equal '(2000 1 1) (wxlambda:calendar-date peer)))
    (date-error (lambda () (make-instance 'mixed-date-picker :parent panel)))
    (date-error (lambda () (wxlambda:make-date-picker panel :class 'wxlambda:text-control)))
    (dolist (bad '(nil (1899 12 31) (2101 1 1) (1900 2 29) (2100 2 29) (2000 2 30)
                   (2001 4 31) (2001 0 1) (2001 13 1) (2001 1 0) (2001 1 32)
                   (2001 1) (2001 1 1 1) ("2000" 1 1) (2000 1 1/2)))
      (date-error (lambda () (wxlambda:make-date-picker panel :date bad)))
      (date-error (lambda () (setf (wxlambda:calendar-date picker) bad))))
    (assert (equal '(2000 2 29) (wxlambda:calendar-date picker)))
    (dolist (date '((1900 1 1) (2000 2 29) (2100 12 31)))
      (let ((value (copy-list date)))
        (assert (eq value (setf (wxlambda:calendar-date picker) value)))
        (setf (first value) 1999)
        (assert (equal date (wxlambda:calendar-date picker))))
      (let ((copy (wxlambda:calendar-date picker)))
        (setf (first copy) 1999) (assert (equal date (wxlambda:calendar-date picker)))))
    (wxlambda:bind-event picker :date-change
      (lambda (event context)
        (incf calls) (setf *date-snapshot* event *date-context* context)
        (assert (eq :date-change (wxlambda:event-kind event)))
        (assert (eq :command (wxlambda:event-family event)))
        (assert (not (wxlambda:event-can-veto-p context)))
        (assert (equal (wxlambda:calendar-date picker) (wxlambda:event-date event)))
        (assert (equal (wxlambda:event-date event) (wxlambda:event-date context)))
        (assert (null (wxlambda:event-text event)))
        (let ((copy (wxlambda:event-date event)))
          (setf (first copy) 1999)
          (assert (equal (wxlambda:calendar-date picker) (wxlambda:event-date event))))
        (dolist (operation (list (lambda () (setf (wxlambda:calendar-date picker) '(2024 1 1)))
                                (lambda () (wxlambda:destroy-window picker))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame :force t))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text-available-p))
                                (lambda () (wxlambda:clone-event context))))
          (date-error operation 'wxlambda:native-error))
        (setf (wxlambda:calendar-date peer) (wxlambda:event-date event))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:bind-event panel :date-change
      (lambda (event)
        (incf parent-calls)
        (assert (= (wxlambda:event-origin-id event) (wxlambda::handle picker)))
        (date-error (lambda () (setf (wxlambda:calendar-date picker) '(2024 1 1))) 'wxlambda:native-error)))
    (setf (wxlambda:calendar-date picker) '(2024 2 29))
    (assert (zerop calls))
    (setf (wxlambda:calendar-date picker :notify :truthy) '(2024 2 29))
    (assert (= 1 calls parent-calls))
    (assert (equal '(2024 2 29) (wxlambda:calendar-date peer)))
    (date-error (lambda () (wxlambda:event-date *date-context*)) 'wxlambda:native-error)
    (date-error (lambda () (wxlambda:make-event :kind :date-change)))
    (date-error (lambda () (wxlambda:process-event picker :date-change)))
    (let* ((condition (make-condition 'simple-error :format-control "date callback condition"))
           (binding (wxlambda:bind-event peer :date-change
                      (lambda (event) (declare (ignore event)) (error condition)))))
      (assert (eq condition (handler-case (setf (wxlambda:calendar-date peer :notify t) '(2025 1 1))
                              (error (actual) actual))))
      (assert (equal '(2025 1 1) (wxlambda:calendar-date peer)))
      (wxlambda:unbind-event binding))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (date-error (lambda () (make-instance 'failing-date-picker :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (date-error (lambda () (wxlambda:calendar-date *failed-date-picker*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (date-error (lambda () (wxlambda:calendar-date picker)) 'wxlambda:native-error)))
(assert (equal '(2024 2 29) (wxlambda:event-date *date-snapshot*)))
(format t "PASS: bounded calendar dates, CLOS rollback, copied snapshots/context expiry, notify/silence and callback lifetime protection~%")
