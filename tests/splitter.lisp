(load (merge-pathnames "../examples/splitter-manager.lisp" *load-truename*))
(defun expect-splitter-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-splitter (wxlambda:splitter-window) ((tag :initarg :tag :reader splitter-tag))
  (:default-initargs :orientation :horizontal :minimum-pane-size 30 :sash-gravity 1/3 :tag :default))
(defmethod initialize-instance :after ((splitter named-splitter) &key)
  (assert (eq :horizontal (wxlambda:splitter-orientation splitter)))
  (assert (= 30 (wxlambda:splitter-minimum-pane-size splitter)))
  (assert (not (wxlambda:splitter-split-p splitter)))
  (assert (null (wxlambda:splitter-pane splitter 0))))
(defvar *failed-split-ids* nil)
(defclass failing-splitter (wxlambda:splitter-window) ())
(defmethod initialize-instance :after ((splitter failing-splitter) &key)
  (let* ((left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
         (button (wxlambda:make-button left)))
    (setf *failed-split-ids* (mapcar #'wxlambda::handle (list splitter left right button)))
    (wxlambda:on-click button (lambda () (error "Should not run")))
    (wxlambda:split-window splitter left right))
  (error "Splitter initialization failure"))
(defclass early-split-pane (wxlambda:panel) ())
(defmethod initialize-instance :after ((pane early-split-pane) &key splitter other)
  (wxlambda:split-window splitter pane other))

(wxlambda:with-application ()
  (assert (wxlambda-splitter-manager:exercise))
  (let* ((frame (wxlambda:make-frame :width 640 :height 480))
         (splitter (wxlambda:make-splitter-window frame :class 'named-splitter :tag :factory))
         (first (wxlambda:make-panel splitter)) (second (wxlambda:make-panel splitter))
         (other (make-instance 'named-splitter :parent frame))
         (unrelated (wxlambda:make-panel frame)))
    (unwind-protect
         (progn
           (assert (eq :factory (splitter-tag splitter))) (assert (eq :default (splitter-tag other)))
           (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :border 0)
           (assert (wxlambda:split-window splitter first second))
           (assert (wxlambda:splitter-split-p splitter))
           (assert (eq first (wxlambda:splitter-pane splitter 0)))
           (assert (eq second (wxlambda:splitter-pane splitter 1)))
           (assert (< (abs (- 1/3 (wxlambda:splitter-sash-gravity splitter))) 1d-10))
           (let ((value 2/3)) (assert (eq value (setf (wxlambda:splitter-sash-gravity splitter) value))))
           (assert (= 40 (setf (wxlambda:splitter-minimum-pane-size splitter) 40)))
           (assert (= 40 (wxlambda:splitter-minimum-pane-size splitter)))
           (assert (= 100 (setf (wxlambda:splitter-sash-position splitter) 100)))
           (wxlambda:process-events)
           (assert (<= 40 (wxlambda:splitter-sash-position splitter)))
           (dolist (value '(-1 536870912 1.5 nil))
             (expect-splitter-error (lambda () (setf (wxlambda:splitter-sash-position splitter) value)))
             (expect-splitter-error (lambda () (setf (wxlambda:splitter-minimum-pane-size splitter) value))))
           (expect-splitter-error (lambda () (setf (wxlambda:splitter-minimum-pane-size splitter) 0)))
           (dolist (value '(-0.1 1.1 :bad))
             (expect-splitter-error (lambda () (setf (wxlambda:splitter-sash-gravity splitter) value))))
           (dolist (index '(-1 2 nil)) (expect-splitter-error (lambda () (wxlambda:splitter-pane splitter index))))
           (expect-splitter-error (lambda () (wxlambda:split-window splitter first second)))
           (expect-splitter-error (lambda () (wxlambda:split-window other unrelated unrelated)))
           (expect-splitter-error (lambda () (wxlambda:split-window other first second)))
           (expect-splitter-error (lambda () (wxlambda:destroy-window first)) 'wxlambda:native-error)
           (expect-splitter-error (lambda () (wxlambda:make-column splitter)) 'wxlambda:native-error)
           (let ((pane (wxlambda:make-panel other)))
             (expect-splitter-error (lambda () (make-instance 'early-split-pane :parent other :splitter other :other pane)))
             (assert (not (wxlambda:splitter-split-p other))))
           (dolist (args '((:orientation :bad) (:minimum-pane-size 0) (:sash-gravity 2) (:sash-position -1)))
             (expect-splitter-error (lambda () (apply #'wxlambda:make-splitter-window frame args))))
           (dolist (kind '(:splitter-sash-changing :splitter-sash-changed))
             (expect-splitter-error (lambda () (wxlambda:register-event-type kind)))
             (expect-splitter-error (lambda () (wxlambda:make-event :kind kind)))
             (expect-splitter-error (lambda () (wxlambda:process-event splitter kind))))
           ;; A non-sash snapshot returns NIL without interpreting native event unions.
           (let ((button (wxlambda:make-button first)) (seen nil))
             (wxlambda:on-click button (lambda () nil))
             (wxlambda:bind-event button :click
               (lambda (event context)
                 (setf seen event)
                 (expect-splitter-error (lambda () (wxlambda:event-sash-position context)) 'wxlambda:native-error)
                 (expect-splitter-error (lambda () (setf (wxlambda:event-sash-position context) 10)) 'wxlambda:native-error)
                 (expect-splitter-error (lambda () (wxlambda:split-window other first second)) 'wxlambda:native-error))
               :with-context t)
             (wxlambda:queue-click button) (wxlambda:process-events)
             (assert seen) (assert (null (wxlambda:event-sash-position seen))))
           (let ((roots (hash-table-count wxlambda::*handlers*)))
             (expect-splitter-error (lambda () (make-instance 'failing-splitter :parent frame)))
             (wxlambda:process-events)
             (assert (= roots (hash-table-count wxlambda::*handlers*)))
             (dolist (id *failed-split-ids*) (assert (zerop (wxlambda::%handler-alive id))))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))
    (expect-splitter-error (lambda () (wxlambda:splitter-pane splitter 0)) 'wxlambda:native-error)
    (expect-splitter-error (lambda () (wxlambda:shown-p first)) 'wxlambda:native-error)))
(format t "PASS: fixed splitter panes, CLOS properties/rollback, canonical ownership and two-pane manager example~%")
