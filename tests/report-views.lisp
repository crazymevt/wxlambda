(load (merge-pathnames "../examples/report-views.lisp" *load-truename*))
(defun views-error (function &optional (type 'error))
 (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-report (wxlambda:list-control) ((tag :initarg :tag :reader report-tag))
 (:default-initargs :virtual-p t :tag "Custom λ"))
(defmethod wxlambda:list-item-text ((control custom-report) row column)
 (format nil "~A/~D/~D" (report-tag control) row column))
(defmethod initialize-instance :after ((control custom-report) &key)
 (wxlambda:insert-list-column control 0 "Ready")
 (setf (wxlambda:item-count control) 2)
 (assert (string= "Custom λ/1/0" (wxlambda:list-item-text control 1 0))))
(defclass failing-report (custom-report) ())
(defvar *failed-report* nil)
(defmethod initialize-instance :after ((control failing-report) &key)
 (setf *failed-report* control) (error "Expected report rollback"))
(defclass mixed-report (wxlambda:list-control wxlambda:panel) ())
(wxlambda:with-application ()
 (assert (wxlambda-report-views:exercise))
 (let* ((frame (wxlambda:make-frame)) (stored (wxlambda:make-list-control frame))
        (custom (wxlambda:make-list-control frame :class 'custom-report))
        (button (wxlambda:make-button frame)) (mode :normal) (calls 0) (outer nil)
        (virtual (wxlambda:make-list-control frame :virtual-p t
          :item-text-function
          (lambda (source row column)
           (incf calls)
           (views-error (lambda () (setf (wxlambda:item-count source) 1)) 'wxlambda:native-error)
           (views-error (lambda () (wxlambda:destroy-window source)) 'wxlambda:native-error)
           (views-error (lambda () (wxlambda:close-window frame :force t)) 'wxlambda:native-error)
           (views-error (lambda () (wxlambda:process-events)) 'wxlambda:native-error)
           (when outer (views-error (lambda () (setf (wxlambda:event-skipped-p outer) t)) 'wxlambda:native-error))
           (case mode
            (:bad 42)
            (:nonlocal (throw 'provider-escape :escaped))
            (:recursive (wxlambda:list-item-text source row column))
            (t (format nil "Cell λ ~D/~D" row column)))))))
  (assert (not (wxlambda:list-virtual-p stored))) (assert (wxlambda:list-virtual-p virtual))
  (assert (string= "Custom λ/0/0" (wxlambda:list-item-text custom 0 0)))
  (views-error (lambda () (make-instance 'mixed-report :parent frame)))
  (views-error (lambda () (wxlambda:make-list-control frame :class 'wxlambda:panel)))
  (views-error (lambda () (wxlambda:make-list-control frame :item-text-function (lambda (&rest args) (declare (ignore args)) "bad"))))
  (let ((roots (hash-table-count wxlambda::*list-provider-roots*)))
   (views-error (lambda () (make-instance 'failing-report :parent frame)))
   (assert (= roots (hash-table-count wxlambda::*list-provider-roots*))))
  (views-error (lambda () (wxlambda:item-count *failed-report*)) 'wxlambda:native-error)
  (dolist (control (list stored virtual))
   (wxlambda:insert-list-column control 0 "Name λ" :width 160)
   (wxlambda:insert-list-column control 1 "Value" :width 80))
  (assert (= 2 (wxlambda:list-column-count stored)))
  (setf (wxlambda:list-column-label stored 1) "Notes λ" (wxlambda:list-column-width stored 1) 120)
  (assert (string= "Notes λ" (wxlambda:list-column-label stored 1)))
  (assert (plusp (wxlambda:list-column-width stored 1)))
  (assert (= 0 (wxlambda:append-item stored '("First λ" "A"))))
  (assert (= 1 (wxlambda:append-item stored '("Second" "B"))))
  (setf (wxlambda:list-item-text stored 0 1) "Changed λ")
  (let ((copy (wxlambda:list-item-text stored 0 1)))
   (setf (char copy 0) #\X) (assert (string= "Changed λ" (wxlambda:list-item-text stored 0 1))))
  (views-error (lambda () (wxlambda:append-item stored '("wrong shape"))))
  (views-error (lambda () (wxlambda:delete-list-column stored 0)))
  (views-error (lambda () (setf (wxlambda:item-count stored) 3)))
  (views-error (lambda () (wxlambda:list-item-text stored 2 0)))
  (views-error (lambda () (setf (wxlambda:list-item-text stored 0 0) (string (code-char 0)))))
  (setf (wxlambda:selection stored) 1)
  (assert (= 1 (wxlambda:selection stored)))
  (wxlambda:delete-item stored 0)
  (assert (or (null (wxlambda:selection stored)) (= 0 (wxlambda:selection stored))))
  (wxlambda:clear-items stored) (assert (null (wxlambda:selection stored)))
  (wxlambda:delete-list-column stored 1) (assert (= 1 (wxlambda:list-column-count stored)))
  (setf (wxlambda:item-count virtual) 1000000)
  (assert (string= "Cell λ 999999/1" (wxlambda:list-item-text virtual 999999 1)))
  (assert (plusp calls))
  (views-error (lambda () (setf (wxlambda:list-item-text virtual 0 0) "owned by provider")))
  (views-error (lambda () (wxlambda:append-item virtual '("A" "B"))))
  (views-error (lambda () (wxlambda:delete-item virtual 0)))
  (setf mode :bad) (views-error (lambda () (wxlambda:list-item-text virtual 0 0)) 'type-error)
  (setf mode :recursive) (views-error (lambda () (wxlambda:list-item-text virtual 0 0)))
  (setf mode :nonlocal)
  (assert (not (eq :escaped (catch 'provider-escape
                            (views-error (lambda () (wxlambda:list-item-text virtual 0 0)))))))
  (setf mode :normal)
  (assert (string= "Cell λ 0/0" (wxlambda:list-item-text virtual 0 0)))
  (wxlambda:bind-event button :click
   (lambda (event context)
    (declare (ignore event))
    (setf outer context)
    (assert (string= "Cell λ 0/0" (wxlambda:list-item-text virtual 0 0)))
    (setf outer nil)
    (setf (wxlambda:event-skipped-p context) t)) :with-context t)
  (wxlambda:queue-click button) (dotimes (i 10) (wxlambda:process-events))
  (assert (null outer))
  (let* ((tree (wxlambda:make-tree-control frame))
         (root (wxlambda:add-tree-root tree "Root λ"))
         (child (wxlambda:append-tree-item root "Child")) (expanding nil))
   (setf (wxlambda:tree-item-bold-p root) :true
         (wxlambda:tree-item-foreground child) #x123456
         (wxlambda:tree-item-background child) #xf0f5fa)
   (assert (wxlambda:tree-item-bold-p root))
   (assert (= #x123456 (wxlambda:tree-item-foreground child)))
   (setf (wxlambda:tree-item-foreground child) nil)
   (assert (or (null (wxlambda:tree-item-foreground child)) (typep (wxlambda:tree-item-foreground child) '(integer 0 #xffffff))))
   (wxlambda:bind-event tree :tree-item-expanding
    (lambda (event context)
     (setf expanding (wxlambda:event-tree-item event))
     (views-error (lambda () (setf (wxlambda:tree-item-bold-p root) nil)))
     (views-error (lambda () (wxlambda:append-tree-item root "unsafe")))
     (setf (wxlambda:event-vetoed-p context) t)) :with-context t)
   (setf (wxlambda:tree-item-expanded-p root) t)
   (assert (eq root expanding)) (assert (not (wxlambda:tree-item-expanded-p root)))
   (wxlambda:delete-tree-item child)
   (views-error (lambda () (wxlambda:tree-item-bold-p child))))
  (dolist (kind '(:list-item-selected :list-item-deselected :list-item-activated :list-item-right-click :list-cache-hint :list-column-click
                  :tree-item-activated :tree-item-menu :tree-item-expanding :tree-item-expanded :tree-item-collapsing :tree-item-collapsed))
   (views-error (lambda () (wxlambda:make-event :kind kind))))
  (wxlambda:destroy-window frame) (wxlambda:process-events)
  (assert (zerop (hash-table-count wxlambda::*list-provider-roots*)))
  (views-error (lambda () (wxlambda:item-count virtual)) 'wxlambda:native-error)))
(format t "PASS: stored/virtual report lists, real native provider CLOS/errors/nonlocal containment/context suspension, checked tree interaction/decorations and root cleanup~%")
