(load (merge-pathnames "../examples/message-file-dialogs.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defvar *fixture-directory* nil)
(defvar *modal-context* nil)
(defclass named-message-dialog (wxlambda:message-dialog)
  ((tag :initarg :tag :reader dialog-tag))
  (:default-initargs :tag :message :message "Body 日本語" :title "Titre λ" :buttons :yes-no-cancel :icon :question))
(defmethod initialize-instance :after ((dialog named-message-dialog) &key)
  (assert (string= "Body 日本語" (wxlambda:dialog-message dialog)))
  (assert (string= "Titre λ" (wxlambda:dialog-title dialog)))
  (assert (eq :yes-no-cancel (wxlambda:message-dialog-buttons dialog))))
(defclass named-file-dialog (wxlambda:file-dialog)
  ((tag :initarg :tag :reader dialog-tag))
  (:default-initargs :tag :file :wildcard "Text files|*.txt|All files|*" :filter-index 1 :mode :save))
(defmethod initialize-instance :after ((dialog named-file-dialog) &key)
  (assert (eq :save (wxlambda:file-dialog-mode dialog)))
  (assert (= 1 (wxlambda:file-dialog-filter-index dialog))))
(defvar *failed-dialog* nil)
(defvar *failed-dialog-id* nil)
(defclass failing-message-dialog (wxlambda:message-dialog) ())
(defmethod initialize-instance :after ((dialog failing-message-dialog) &key)
  (setf *failed-dialog* dialog *failed-dialog-id* (wxlambda::handle dialog)) (error "message initializer failure"))
(defclass failing-file-dialog (wxlambda:file-dialog) ())
(defmethod initialize-instance :after ((dialog failing-file-dialog) &key)
  (setf *failed-dialog* dialog *failed-dialog-id* (wxlambda::handle dialog)) (error "file initializer failure"))
(defclass mixed-message-file (wxlambda:message-dialog wxlambda:file-dialog) ())
(defclass mixed-file-frame (wxlambda:file-dialog wxlambda:frame) ())
(defclass mixed-frame-message (wxlambda:frame wxlambda:message-dialog) ())
(defclass mixed-message-owned (wxlambda:message-dialog wxlambda:owned-event) ())

(defun modal-action (dialog action)
  (let ((binding nil) (fired nil))
    (unwind-protect
         (progn
           (setf binding (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                           (lambda (snapshot context)
                             (declare (ignore snapshot))
                             (when (and (not fired) (wxlambda:dialog-modal-p dialog))
                               (setf fired t)
                               (let ((*modal-context* context)) (funcall action)))) :with-context t))
           (wxlambda:wake-up-idle)
           (multiple-value-prog1 (wxlambda:show-modal dialog) (assert fired)))
      (when binding (wxlambda:unbind-event binding)))))

(defun check-message-construction ()
  (let* ((parent (wxlambda:make-frame))
         (dialog (wxlambda:make-message-dialog :parent parent :class 'named-message-dialog :tag :custom)))
    (unwind-protect
         (progn
           (assert (eq :custom (dialog-tag dialog)))
           (setf (wxlambda:dialog-title dialog) "Changed λ")
           (assert (string= "Changed λ" (wxlambda:dialog-title dialog)))
           (expect-error (lambda () (wxlambda:dialog-value dialog)))
           (expect-error (lambda () (wxlambda:file-dialog-path dialog)))
           (expect-error (lambda () (wxlambda:show-window dialog)))
           (expect-error (lambda () (setf (wxlambda:shown-p dialog) t)))
           (dolist (initargs (list (list :buttons :invalid) (list :icon :invalid)
                                  (list :message 3) (list :message (string #\Null))
                                  (list :title (string #\Null)) (list :parent 1)))
             (expect-error (lambda () (apply #'wxlambda:make-message-dialog initargs))))
           (dolist (class '(wxlambda:dialog wxlambda:file-dialog wxlambda:frame))
             (expect-error (lambda () (wxlambda:make-message-dialog :class class))))
           (dolist (class '(mixed-message-file mixed-file-frame mixed-frame-message mixed-message-owned))
             (let ((object (allocate-instance (find-class class))))
               (expect-error (lambda () (initialize-instance object :parent parent)))
               (assert (not (slot-boundp object 'wxlambda::handle))))))
      (wxlambda:destroy-window parent) (wxlambda:process-events))
    (assert (not (wxlambda:handler-alive-p dialog)))
    (expect-error (lambda () (wxlambda:dialog-message dialog))))
  (expect-error (lambda () (wxlambda:make-message-dialog :class 'failing-message-dialog)))
  (assert (zerop (wxlambda::%handler-alive *failed-dialog-id*)))
  (expect-error (lambda () (wxlambda:handler-alive-p *failed-dialog*)) 'wxlambda:native-error))

(defun check-file-properties-and-validation ()
  (let* ((parent (wxlambda:make-frame))
         (path (merge-pathnames "existing-λ.txt" *fixture-directory*))
         (dialog (wxlambda:make-file-dialog :parent parent :class 'named-file-dialog
                                          :directory *fixture-directory* :filename "existing-λ.txt")))
    (unwind-protect
         (progn
           (assert (eq :file (dialog-tag dialog)))
           (assert (equal path (pathname (wxlambda:file-dialog-path dialog))))
           (assert (= 1 (wxlambda:file-dialog-filter-index dialog)))
           (assert (zerop (setf (wxlambda:file-dialog-filter-index dialog) 0)))
           (assert (eq path (setf (wxlambda:file-dialog-path dialog) path)))
           (let ((value (namestring (merge-pathnames "new-日本語.txt" *fixture-directory*))))
             (assert (eq value (setf (wxlambda:file-dialog-path dialog) value)))
             (assert (string= value (wxlambda:file-dialog-path dialog))))
           (dolist (index '(-1 2 nil 1/2))
             (expect-error (lambda () (setf (wxlambda:file-dialog-filter-index dialog) index))))
           (dolist (path (list "" 4 (string #\Null)
                               (merge-pathnames "missing-directory/file.txt" *fixture-directory*)))
             (expect-error (lambda () (setf (wxlambda:file-dialog-path dialog) path))))
           (dolist (initargs (list (list :mode :invalid) (list :mode :save :must-exist t)
                                  (list :mode :open :overwrite-prompt t)
                                  (list :wildcard "Odd") (list :wildcard "Description|")
                                  (list :wildcard "|*.txt") (list :filter-index 1)
                                  (list :directory (merge-pathnames "missing/" *fixture-directory*))
                                  (list :filename (string #\Null))))
             (expect-error (lambda () (apply #'wxlambda:make-file-dialog initargs))))
           (expect-error (lambda () (wxlambda:make-file-dialog :class 'wxlambda:message-dialog))))
      (wxlambda:destroy-window parent) (wxlambda:process-events)))
  (expect-error (lambda () (wxlambda:make-file-dialog :class 'failing-file-dialog :directory *fixture-directory*)))
  (assert (zerop (wxlambda::%handler-alive *failed-dialog-id*)))
  (expect-error (lambda () (wxlambda:handler-alive-p *failed-dialog*)) 'wxlambda:native-error))

(defun check-modal-results ()
  (dolist (entry '((:ok :ok :cancel) (:ok-cancel :ok :cancel)
                   (:yes-no :yes :no :cancel) (:yes-no-cancel :yes :no :cancel)))
    (let ((dialog (wxlambda:make-message-dialog :buttons (first entry) :message "Bounded native result")))
      (unwind-protect
           (progn
             (dolist (result (rest entry))
               (assert (eq result (modal-action dialog (lambda ()
                                                       (expect-error (lambda () (wxlambda:end-modal dialog :invalid)))
                                                       (when (member (first entry) '(:yes-no :yes-no-cancel))
                                                         (expect-error (lambda () (wxlambda:end-modal dialog :ok))))
                                                       (when (member (first entry) '(:ok :ok-cancel))
                                                         (expect-error (lambda () (wxlambda:end-modal dialog :yes))))
                                                       (assert (eq dialog (wxlambda:end-modal dialog result))))))))
             (assert (not (wxlambda:dialog-modal-p dialog)))
             (expect-error (lambda () (wxlambda:end-modal dialog :cancel))))
        (wxlambda:destroy-window dialog) (wxlambda:process-events))))
  (dolist (mode '(:open :save))
    (let* ((path (merge-pathnames "existing-λ.txt" *fixture-directory*))
           (dialog (wxlambda:make-file-dialog :mode mode :path path)))
      (unwind-protect
           (progn
             (assert (string= (if (eq mode :open) "Open file" "Save file") (wxlambda:dialog-title dialog)))
             (dolist (result '(:ok :cancel))
               (assert (eq result (modal-action dialog (lambda ()
                                                       (expect-error (lambda () (wxlambda:end-modal dialog :yes)))
                                                       (expect-error (lambda () (wxlambda:end-modal dialog :no)))
                                                       (wxlambda:end-modal dialog result)))))))
        (wxlambda:destroy-window dialog) (wxlambda:process-events)))))

(defvar *latched-construction* nil)
(defclass pending-error-message-dialog (wxlambda:message-dialog) ())
(defmethod initialize-instance :before ((dialog pending-error-message-dialog) &key)
  (setf *latched-construction* dialog))
(defun check-pending-callback-error-handshake ()
  (let ((dialog (wxlambda:make-message-dialog :message "Pending error boundary"))
        (primary (make-condition 'simple-error :format-control "pending callback primary")))
    (unwind-protect
         (progn
           ;; This first probe deliberately primes only Lisp state. No auto-close
           ;; callback is present, so SHOW must fail before entering native UI.
           (setf wxlambda::*callback-error* primary)
           (assert (eq primary (handler-case (wxlambda:show-modal dialog)
                                 (error (caught) caught))))
           (assert (not (wxlambda:dialog-modal-p dialog)))
           (assert (eq :cancel (modal-action dialog (lambda () (wxlambda:end-modal dialog :cancel)))))
           ;; Exercise the private bridge invariant separately: pending native
           ;; and Lisp state must clear together even during failed construction.
           (setf wxlambda::*callback-error* primary *latched-construction* nil)
           (assert (zerop (wxlambda::%callback-error-pending 1)))
           (assert (eq primary (handler-case
                                   (wxlambda:make-message-dialog :class 'pending-error-message-dialog)
                                 (error (caught) caught))))
           (assert *latched-construction*)
           (assert (or (not (slot-boundp *latched-construction* 'wxlambda::handle))
                       (null (slot-value *latched-construction* 'wxlambda::handle))))
           ;; MODAL-ACTION requires its idle callback to fire. A stale native
           ;; latch would return Cancel immediately and fail that assertion.
           (assert (eq :cancel (modal-action dialog (lambda () (wxlambda:end-modal dialog :cancel)))))
           (assert (null wxlambda::*callback-error*)))
      (setf wxlambda::*callback-error* nil)
      (wxlambda::%callback-error-pending 0)
      (wxlambda:destroy-window dialog) (wxlambda:process-events))))

(defun check-pending-parent-lifetime ()
  (let* ((parent (wxlambda:make-frame))
         (message (wxlambda:make-message-dialog :parent parent))
         (file (wxlambda:make-file-dialog :parent parent :directory *fixture-directory*)))
    (wxlambda:destroy-window parent)
    (dolist (dialog (list message file))
      (assert (not (wxlambda:handler-alive-p dialog)))
      (expect-error (lambda () (wxlambda:show-modal dialog)) 'wxlambda:native-error))
    (wxlambda:process-events)))

(defun check-modal-callback-recovery ()
  (let* ((frame (wxlambda:make-frame))
         (control (wxlambda:make-text frame))
         (message (wxlambda:make-message-dialog :parent frame))
         (file (wxlambda:make-file-dialog :parent frame :directory *fixture-directory*))
         (condition (make-condition 'simple-error :format-control "nested notifier failure"))
         (data (list :keep)) (outer nil) (calls 0) (running nil)
         (notify (wxlambda:bind-event control :text-change (lambda (event) (declare (ignore event)) (error condition))))
         (binding (wxlambda:bind-event frame :menu
                    (lambda (snapshot context)
                      (declare (ignore snapshot)) (setf outer context)
                      (dolist (dialog (list message file))
                        (assert (eq condition (handler-case (modal-action dialog (lambda () (error condition)))
                                                (error (caught) caught))))
                        (assert (eq :cancel
                                    (modal-action dialog
                                      (lambda ()
                                        (expect-error (lambda () (wxlambda:event-id outer)))
                                        (assert (eq condition (handler-case
                                                                 (setf (wxlambda:text control :notify t) (format nil "Notify λ ~A ~A" calls (class-name (class-of dialog))))
                                                               (error (caught) caught))))
                                        (assert (wxlambda:dialog-modal-p dialog))
                                        (assert (eq :idle (wxlambda:event-kind *modal-context*)))
                                        #+sbcl (sb-ext:gc :full t)
                                        #+ccl (ccl:gc)
                                        (wxlambda:end-modal dialog :cancel)))))
                        (assert (eq data (wxlambda:event-user-data context))))
                      (incf calls) (when running (wxlambda:stop)))
                    :with-context t :user-data data)))
    (unwind-protect
         (progn
           (wxlambda:process-event frame :menu :id 32401)
           (assert (= 1 calls))
           (setf running t) (wxlambda:show-window frame)
           (wxlambda:queue-event frame :menu :id 32401) (wxlambda:run)
           (assert (= 2 calls))
           (expect-error (lambda () (wxlambda:event-id outer))))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event notify)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(let* ((fixture-directory (merge-pathnames (format nil "wxlambda-dialog-test-~A-~A/" (get-universal-time) (random most-positive-fixnum (make-random-state t))) (uiop:temporary-directory)))
       (escaped nil))
  (setf *fixture-directory* fixture-directory)
  (assert (not (probe-file *fixture-directory*)))
  (ensure-directories-exist *fixture-directory*)
  (unwind-protect
       (progn
         (with-open-file (stream (merge-pathnames "existing-λ.txt" *fixture-directory*) :direction :output :if-exists :error)
           (write-line "Owned dialog regression fixture" stream))
         (wxlambda:with-application ()
           (assert (wxlambda-message-file-dialogs:exercise))
           (check-message-construction)
           (check-file-properties-and-validation)
           (check-modal-results)
           (check-pending-parent-lifetime)
           (check-pending-callback-error-handshake)
           (check-modal-callback-recovery)
           (setf escaped (wxlambda:make-message-dialog :message "Session owned")))
         (expect-error (lambda () (wxlambda:dialog-message escaped)) 'wxlambda:native-error)
         (expect-error (lambda () (wxlambda:show-modal escaped)) 'wxlambda:native-error))
    (uiop:delete-directory-tree fixture-directory :validate t :if-does-not-exist :ignore)
    (setf *fixture-directory* nil)))
(format t "PASS: generic message/file dialogs, CLOS, paths/filters, modal results and callback lifetime~%")
