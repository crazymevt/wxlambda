(load (merge-pathnames "../examples/webview.lisp" *load-truename*))
(defun web-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-web-view (wxlambda:web-view) ((tag :initarg :tag :reader web-tag))
  (:default-initargs :tag :default))
(defmethod initialize-instance :after ((view custom-web-view) &key)
  (assert (stringp (wxlambda:web-view-url view))))
(defclass failing-web-view (custom-web-view) ())
(defvar *failed-web-view* nil)
(defmethod initialize-instance :after ((view failing-web-view) &key)
  (setf *failed-web-view* view)
  (wxlambda:bind-event view :web-message (lambda (event) (declare (ignore event))))
  (error "Expected WebView rollback"))
(defclass mixed-web-view (wxlambda:web-view wxlambda:panel) ())
(if (string= (or (uiop:getenv "WXLAMBDA_WEBVIEW_TEST_MODE") "supported") "unavailable")
    (progn
      (wxlambda:with-application ()
        (let ((frame (wxlambda:make-frame)))
          (assert (handler-case (progn (wxlambda:make-web-view frame) nil)
                    (wxlambda:native-error (condition)
                      (search "Interactive WebView requires" (princ-to-string condition)))))
          (wxlambda:destroy-window frame)))
      (format t "PASS: WebView unavailable contract (not backend execution)~%"))
    (progn
(wxlambda:with-application ()
  (assert (wxlambda-webview:exercise))
  (let* ((frame (wxlambda:make-frame :width 500 :height 400))
         (view (wxlambda:make-web-view frame :class 'custom-web-view :tag :factory))
         (results nil) (messages nil) (loaded nil) (guarded nil) (late nil))
    (assert (eq :factory (web-tag view)))
    (web-error (lambda () (make-instance 'mixed-web-view :parent frame)))
    (web-error (lambda () (wxlambda:make-web-view frame :class 'wxlambda:panel)))
    (web-error (lambda () (make-instance 'failing-web-view :parent frame)))
    (web-error (lambda () (wxlambda:web-view-title *failed-web-view*)))
    (web-error (lambda () (wxlambda:set-web-page view (string #\Null))))
    (web-error (lambda () (setf (wxlambda:web-view-url view) "")))
    (web-error (lambda () (wxlambda:run-web-script view (string #\Null))))
    (dolist (url '("http://" "http://[" "https://example.test/a b" "%" "relative.html" "javascript:alert(1)"))
      (web-error (lambda () (setf (wxlambda:web-view-url view) url))))
    (web-error (lambda () (wxlambda:set-web-page view "HTML" :base-url "relative.html")))
    ;; URL validation must agree across the Cocoa and experimental GTK adapters.
    (dolist (space (list #\Space #\Tab #\Newline (code-char 160)))
      (web-error (lambda () (setf (wxlambda:web-view-url view)
        (format nil "https://example.test/a~Ab" space)))))
    (dolist (kind '(:web-message :web-script-result :web-loaded :web-error))
      (web-error (lambda () (wxlambda:make-event :kind kind))))
    (wxlambda:bind-event view :web-script-result (lambda (event) (push event results)))
    (wxlambda:bind-event view :web-loaded (lambda (event) (declare (ignore event))
      (setf loaded t)))
    (wxlambda:bind-event frame :web-message
      (lambda (event context)
        (declare (ignore event))
        (setf guarded t)
        (web-error (lambda () (wxlambda:destroy-window view)))
        (web-error (lambda () (wxlambda:close-window frame :force t)))
        (web-error (lambda () (wxlambda:run-web-script view "1")))
        (web-error (lambda () (setf (wxlambda:web-view-url view) "about:blank")))
        (web-error (lambda () (wxlambda:process-events)))
        (web-error (lambda () (setf (wxlambda:event-text context) "mutate")))
        (web-error (lambda () (setf (wxlambda:event-extra-long context) 10)))
        (web-error (lambda () (wxlambda:clone-event context)))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:bind-event view :web-message (lambda (event) (push event messages)))
    (wxlambda:show-window frame)
    (wxlambda:set-web-page view "<!doctype html><meta charset='utf-8'><title>Tests λ</title><script>window.webkit.messageHandlers.wxlambda.postMessage({hello:'λ 😀'});</script>")
    (wxlambda-webview::wait-for (lambda () (and loaded messages guarded (string= "Tests λ" (wxlambda:web-view-title view)))))
    (assert (= (wxlambda::handle view) (wxlambda:event-origin-id (first messages))))
    (assert (search "hello" (wxlambda:event-text (first messages))))
    (let ((ticket (wxlambda:run-web-script view "alert('suppressed'); var c=confirm('no'); var p=prompt('cancel'); ({confirmed:c,prompted:p})")))
      (wxlambda-webview::wait-for (lambda () (find ticket results :key #'wxlambda:event-extra-long)))
      (let ((event (find ticket results :key #'wxlambda:event-extra-long)))
        (assert (= 1 (wxlambda:event-integer event)))
        (assert (search "false" (wxlambda:event-text event)))
        (assert (search "null" (wxlambda:event-text event)))))
    (let ((ticket (wxlambda:run-web-script view "throw new Error('expected-script-failure')")))
      (wxlambda-webview::wait-for (lambda () (find ticket results :key #'wxlambda:event-extra-long)))
      (assert (zerop (wxlambda:event-integer (find ticket results :key #'wxlambda:event-extra-long)))))
    (wxlambda:bind-event view :web-script-result (lambda (event) (declare (ignore event)) (setf late t)))
    (wxlambda:run-web-script view "({late:true})")
    (let ((keeper (wxlambda:make-frame)) (done nil))
      (wxlambda:show-window keeper)
      (wxlambda:destroy-window frame)
      (wxlambda:start-ui-timer (lambda () (setf done t)) 200 :one-shot t)
      (wxlambda-webview::wait-for (lambda () done))
      (wxlambda:destroy-window keeper))
    (assert (not late))
    (web-error (lambda () (wxlambda:web-view-title view)))))
(format t "PASS: interactive WebView real JavaScript JSON messages/results, dialog suppression, callback guards, CLOS rollback and pending teardown~%")))
