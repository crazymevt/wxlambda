(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-error (thunk &optional message)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition)
              (assert (not (typep condition 'unbound-slot)))
              (or (null message) (search message (princ-to-string condition)))))))
(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(dolist (name '(wxlambda:window wxlambda:frame wxlambda:panel wxlambda:button
                wxlambda:text-control wxlambda:label wxlambda:checkbox wxlambda:choice))
  (assert (eq :external (nth-value 1 (find-symbol (symbol-name name) :wxlambda))))
  (assert (typep (find-class name) 'standard-class))
  (assert (subtypep name 'wxlambda:window)))
(dolist (operation '(wxlambda:make-panel wxlambda:make-button wxlambda:make-text
                      wxlambda:make-label wxlambda:make-checkbox wxlambda:make-choice
                      wxlambda:make-column wxlambda:make-row wxlambda:add-child wxlambda:add-spacer
                      wxlambda:add-stretch wxlambda:layout-window wxlambda:window-position
                      wxlambda:window-size wxlambda:window-name wxlambda:frame-title wxlambda:show-window
                      wxlambda:shown-p wxlambda:enable-window wxlambda:enabled-p wxlambda:destroy-window
                      wxlambda:label-text wxlambda:text wxlambda:checked-p wxlambda:selection
                      wxlambda:on-click wxlambda:off-click wxlambda:queue-click
                      wxlambda:on-text-change wxlambda:off-text-change wxlambda:on-toggle wxlambda:off-toggle
                      wxlambda:on-selection wxlambda:off-selection))
  (assert (typep (fdefinition operation) 'generic-function)))
(dolist (reader '(wxlambda:text wxlambda:label-text wxlambda:checked-p wxlambda:selection
                   wxlambda:window-name wxlambda:frame-title wxlambda:shown-p wxlambda:enabled-p))
  (assert (typep (fdefinition (list 'setf reader)) 'generic-function)))

(dolist (name '("SET-TEXT" "SET-LABEL" "SET-CHECKED" "SET-SELECTION" "SET-WINDOW-NAME" "SET-FRAME-TITLE"))
  (assert (not (fboundp (find-symbol name :wxlambda)))))

(dolist (name '("GET-TEXT" "GET-LABEL"))
  (assert (not (fboundp (find-symbol name :wxlambda))))
  (assert (not (fboundp (list 'setf (or (find-symbol name :wxlambda) (make-symbol name)))))))

(defclass tagged () ((tag :initarg :tag :initform :default :reader tag)))
(defclass my-frame (wxlambda:frame tagged) () (:default-initargs :title "Default λ"))
(defclass my-panel (wxlambda:panel tagged) ())
(defclass my-button (wxlambda:button tagged) ())
(defclass my-text (wxlambda:text-control tagged) () (:default-initargs :value "Default text λ"))
(defclass my-label (wxlambda:label tagged) () (:default-initargs :label "Default label λ"))
(defclass my-checkbox (wxlambda:checkbox tagged) () (:default-initargs :checked t))
(defclass my-choice (wxlambda:choice tagged) () (:default-initargs :items '("First" "Second λ") :selection 1))
(defmethod initialize-instance :after ((object my-text) &key)
  ;; Native-backed properties are available to ordinary subclass AFTER hooks.
  (setf (wxlambda:text object) (concatenate 'string "hook/" (wxlambda:text object))))

(defvar *failed-objects* nil)
(defvar *failed-handles* nil)
(defclass failing-button (wxlambda:button) ())
(defmethod initialize-instance :after ((object failing-button) &key)
  (push object *failed-objects*)
  (push (wxlambda::handle object) *failed-handles*)
  (wxlambda:on-click object (lambda () (error "Must never dispatch")))
  (error "intentional button initialization failure"))
(defclass failing-frame (wxlambda:frame) ())
(defmethod initialize-instance :after ((object failing-frame) &key)
  (let ((child (make-instance 'my-button :parent object)))
    (wxlambda:on-click child (lambda () (error "Must never dispatch")))
    (push child *failed-objects*)
    (push (wxlambda::handle child) *failed-handles*))
  (push object *failed-objects*)
  (push (wxlambda::handle object) *failed-handles*)
  (error "intentional frame initialization failure"))
(defclass uncooperative-button (wxlambda:button) ())
(defmethod initialize-instance ((object uncooperative-button) &rest initargs)
  (declare (ignore initargs))
  object)
(defclass unsupported-window (wxlambda:window) ())
(defclass ambiguous-window (wxlambda:frame wxlambda:button) ())

(defclass tracked-frame (wxlambda:frame)
  ((history :initform nil :accessor history) (children :initform 0 :accessor children)))
(defclass tracked-button (wxlambda:button)
  ((queued :initform 0 :accessor queued)))
(defmethod (setf wxlambda:frame-title) :around (value (frame tracked-frame))
  (declare (ignorable value))
  (push :around-start (history frame))
  (unwind-protect (call-next-method) (push :around-end (history frame))))
(defmethod (setf wxlambda:frame-title) :before (value (frame tracked-frame))
  (declare (ignore value)) (push :before (history frame)))
(defmethod (setf wxlambda:frame-title) :after (value (frame tracked-frame))
  (declare (ignore value)) (push :after (history frame)))
(defmethod (setf wxlambda:window-name) (value (frame tracked-frame))
  (call-next-method (concatenate 'string "app/" value) frame))
(defmethod wxlambda:make-button :after ((parent tracked-frame) &key &allow-other-keys)
  (incf (children parent)))
(defmethod wxlambda:queue-click :before ((button tracked-button)) (incf (queued button)))

(let (saved (called nil))
  (wxlambda:with-application ()
    (let* ((frame (make-instance 'my-frame :tag :direct))
           (panel (make-instance 'my-panel :parent frame :tag :direct))
           (button (make-instance 'my-button :parent panel :tag :direct))
           (text (make-instance 'my-text :parent panel :tag :direct))
           (label (make-instance 'my-label :parent panel :tag :direct))
           (checkbox (make-instance 'my-checkbox :parent panel :tag :direct))
           (choice (make-instance 'my-choice :parent panel :tag :direct)))
      (dolist (object (list frame panel button text label checkbox choice))
        (assert (eq :direct (tag object)))
        (assert (stringp (wxlambda:window-name object))))
      (assert (string= "Default λ" (wxlambda:frame-title frame)))
      (assert (string= "hook/Default text λ" (wxlambda:text text)))
      (assert (string= "Default label λ" (wxlambda:label-text label)))
      (assert (wxlambda:checked-p checkbox))
      (assert (= 1 (wxlambda:selection choice)))
      ;; Factories forward subclass initargs; both class names and class objects work.
      (let ((other (wxlambda:make-frame :class (find-class 'my-frame) :tag :factory :title "Override")))
        (assert (eq :factory (tag other)))
        (assert (string= "Override" (wxlambda:frame-title other)))
        (wxlambda:destroy-window other))
      (dolist (pair (list (cons #'wxlambda:make-panel 'my-panel)
                          (cons #'wxlambda:make-button 'my-button)
                          (cons #'wxlambda:make-text 'my-text)
                          (cons #'wxlambda:make-label 'my-label)
                          (cons #'wxlambda:make-checkbox 'my-checkbox)
                          (cons #'wxlambda:make-choice 'my-choice)))
        (let ((object (funcall (car pair) panel :class (cdr pair) :tag :factory)))
          (assert (eq :factory (tag object)))
          (assert (stringp (wxlambda:window-name object)))
          (typecase object
            (my-text (assert (string= "hook/Default text λ" (wxlambda:text object))))
            (my-label (assert (string= "Default label λ" (wxlambda:label-text object))))
            (my-checkbox (assert (wxlambda:checked-p object)))
            (my-choice (assert (= 1 (wxlambda:selection object)))))))
      (expect-error (lambda () (make-instance 'wxlambda:window)) "abstract")
      (expect-error (lambda () (make-instance 'unsupported-window)) "abstract")
      (expect-error (lambda () (make-instance 'uncooperative-button :parent frame)) "inherited")
      (expect-error (lambda () (make-instance 'ambiguous-window)) "exactly one")
      (expect-error (lambda () (make-instance 'wxlambda:button)))
      (expect-error (lambda () (make-instance 'wxlambda:button :parent frame :handle 10)))
      (expect-error (lambda () (make-instance 'wxlambda:button :parent frame :typo t)))
      (expect-error (lambda () (wxlambda:make-button panel :class 'my-frame)) "subclass")
      (expect-error (lambda () (initialize-instance button :parent panel)) "already")
      ;; Initializer failure rolls back native widgets, nested construction and closures.
      (expect-error (lambda () (make-instance 'failing-button :parent panel)) "intentional button")
      (expect-error (lambda () (make-instance 'failing-frame)) "intentional frame")
      (assert (zerop (hash-table-count wxlambda::*handlers*)))
      (dolist (object *failed-objects*) (expect-native-error (lambda () (wxlambda:window-name object))))
      (wxlambda:process-events)
      (dolist (id *failed-handles*)
        (cffi:with-foreign-object (length :size)
          (assert (cffi:null-pointer-p (wxlambda::%name id length)))))
      ;; All eight property writers return the supplied value; BOOL reads normalize.
      (assert (eq :yes (setf (wxlambda:checked-p checkbox) :yes)))
      (assert (eq t (wxlambda:checked-p checkbox)))
      (assert (= 0 (setf (wxlambda:selection choice) 0)))
      (assert (= 1 (incf (wxlambda:selection choice :notify t))))
      (assert (string= "Assigned" (setf (wxlambda:label-text label) "Assigned")))
      (assert (string= "Changed" (setf (wxlambda:text text :notify t) "Changed")))
      (multiple-value-bind (value changed) (setf (wxlambda:shown-p button) nil)
        (assert (null value)) (assert changed))
      (assert (not (wxlambda:shown-p button)))
      (assert (eq :yes (setf (wxlambda:shown-p button) :yes)))
      (multiple-value-bind (value changed) (setf (wxlambda:enabled-p button) nil)
        (assert (null value)) (assert changed))
      (assert (not (wxlambda:enabled-p button)))
      (assert (eq :yes (setf (wxlambda:enabled-p button) :yes)))
      (wxlambda:destroy-window frame))
    ;; Direct subclass construction and native SETF writes support method combination.
    (let* ((frame (make-instance 'tracked-frame))
           (button (wxlambda:make-button frame :class 'tracked-button))
           (title (copy-seq "CLOS title — λ")))
      (setf saved button)
      (assert (= 1 (children frame)))
      (assert (eq title (setf (wxlambda:frame-title frame) title)))
      (assert (string= title (wxlambda:frame-title frame)))
      (assert (equal '(:around-start :before :after :around-end) (reverse (history frame))))
      (assert (string= "app/name" (setf (wxlambda:window-name frame) "name")))
      (assert (string= "app/name" (wxlambda:window-name frame)))
      (wxlambda:on-click button
        (lambda (event)
          (assert (eq button (wxlambda:event-source event)))
          (assert (typep (wxlambda:event-source event) 'tracked-button))
          (assert (= 1 (queued button)))
          (setf called t)
          (wxlambda:off-click button)
          (wxlambda:destroy-window frame)) :with-event t)
      (wxlambda:show-window frame)
      (wxlambda:queue-click button)
      (wxlambda:run)
      (assert called)))
  (expect-native-error (lambda () (wxlambda:window-name saved))))
(expect-native-error (lambda () (make-instance 'wxlambda:frame)))
(format t "PASS: direct construction of all seven native types, subclass initargs/factories, rollback, eight SETF writers and method combination~%")
