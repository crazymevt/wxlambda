(load (merge-pathnames "../examples/drawing-monitor.lisp" *load-truename*))
(defun canvas-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-canvas (wxlambda:drawing-canvas) ((tag :initarg :tag :reader canvas-tag))
  (:default-initargs :tag :default :content '(:background (20 30 40) :items ((:rect 1 2 30 40 (255 0 0))))))
(defmethod initialize-instance :after ((canvas custom-canvas) &key)
  (assert (equal '(20 30 40) (getf (wxlambda:canvas-content canvas) :background))))
(defclass failing-canvas (custom-canvas) ())
(defclass mixed-canvas (wxlambda:drawing-canvas wxlambda:panel) ())
(defvar *failed-canvas* nil)
(defmethod initialize-instance :after ((canvas failing-canvas) &key)
  (setf *failed-canvas* canvas)
  (wxlambda:bind-event canvas :idle (lambda (event) (declare (ignore event))))
  (error "Expected canvas rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-drawing-monitor:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (canvas (wxlambda:make-drawing-canvas panel :class 'custom-canvas :tag :factory))
         (button (wxlambda:make-button panel)) (delivered nil)
         (path (uiop:native-namestring
                (merge-pathnames (format nil "wxl-canvas-λ-~A.png" (lisp-implementation-type))
                                 (uiop:temporary-directory)))))
    (assert (eq :factory (canvas-tag canvas)))
    (canvas-error (lambda () (make-instance 'mixed-canvas :parent panel)))
    (canvas-error (lambda () (wxlambda:make-drawing-canvas panel :class 'wxlambda:panel)))
    (let* ((pixels (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(0 0 255)))
           (text (copy-seq "Text λ"))
           (scene (list :background (list 255 255 255) :items
                    (list (list :text 2 3 text 12 (list 10 20 30)) (list :bitmap 4 5 1 1 pixels)))))
      (assert (eq scene (setf (wxlambda:canvas-content canvas) scene)))
      (setf (char text 0) #\X (aref pixels 2) 0 (first (getf scene :background)) 0)
      (let ((copy (wxlambda:canvas-content canvas)))
        (assert (equal '(255 255 255) (getf copy :background)))
        (assert (string= "Text λ" (fourth (first (getf copy :items)))))
        (assert (= 255 (aref (sixth (second (getf copy :items))) 2)))
        (setf (first (getf copy :background)) 0)
        (assert (equal '(255 255 255) (getf (wxlambda:canvas-content canvas) :background)))))
    (dolist (bad (list nil '(:background (0 0 0) :items nil :extra 1)
                       '(:background (256 0 0) :items nil) '(:background (0 0) :items nil)
                       '(:background (0 0 0) :items ((:rect 0 0 0 1 (0 0 0))))
                       '(:background (0 0 0) :items ((:line 0 0 1 1 (0 0 0) 33)))
                       '(:background (0 0 0) :items ((:text 0 0 "text" 73 (0 0 0))))
                       '(:background (0 0 0) :items ((:unknown 0 0 1 1 (0 0 0))))
                       (list :background '(0 0 0) :items (list (list :text 0 0 (format nil "a~%b") 12 '(0 0 0))))))
      (canvas-error (lambda () (setf (wxlambda:canvas-content canvas) bad))))
    (assert (string= "Text λ" (fourth (first (getf (wxlambda:canvas-content canvas) :items)))))
    (wxlambda:save-canvas-image canvas path :width 120 :height 80)
    (with-open-file (stream path :element-type '(unsigned-byte 8))
      (let ((signature (make-array 8))) (read-sequence signature stream)
        (assert (equalp signature #(137 80 78 71 13 10 26 10)))))
    (canvas-error (lambda () (wxlambda:save-canvas-image canvas path :width 0)))
    (canvas-error (lambda () (wxlambda:save-canvas-image canvas path :height 2049)))
    (wxlambda:on-click button
      (lambda ()
        (assert (= 2 (length (wxlambda:canvas-client-size canvas))))
        (canvas-error (lambda () (setf (wxlambda:canvas-content canvas) '(:background (0 0 0) :items nil))) 'wxlambda:native-error)
        (canvas-error (lambda () (wxlambda:save-canvas-image canvas path)) 'wxlambda:native-error)
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:canvas-content canvas) '(:background (1 2 3) :items nil) delivered t)) :owner canvas)))
    (wxlambda:queue-click button)
    (loop repeat 30 until delivered do (wxlambda:process-events))
    (assert delivered) (assert (equal '(1 2 3) (getf (wxlambda:canvas-content canvas) :background)))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (canvas-error (lambda () (make-instance 'failing-canvas :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (canvas-error (lambda () (wxlambda:canvas-content *failed-canvas*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (canvas-error (lambda () (wxlambda:canvas-client-size canvas)) 'wxlambda:native-error)))
(format t "PASS: retained drawing/monitor workflow, deep scene copies, validation/atomicity, Unicode PNG, CLOS rollback and deferred writes~%")
