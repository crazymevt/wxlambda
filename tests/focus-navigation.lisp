(load (merge-pathnames "../examples/focus-navigation.lisp" *load-truename*))
(defun focus-error (function)
  (assert (handler-case (progn (funcall function) nil) (wxlambda:native-error () t))))
(wxlambda:with-application ()
  (assert (wxlambda-focus-navigation:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel)) (button (wxlambda:make-button panel))
         (delivered nil))
    (focus-error (lambda () (wxlambda:focus-window text)))
    (focus-error (lambda () (wxlambda:navigate-focus text)))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text) (wxlambda:add-child panel button)
    (wxlambda:show-window frame) (wxlambda:process-events)
    (wxlambda:enable-window panel nil)
    (focus-error (lambda () (wxlambda:focus-window text)))
    (wxlambda:enable-window panel t)
    (assert (eq text (wxlambda:focus-window text :from-keyboard :truthy)))
    (assert (typep (wxlambda:navigate-focus text) 'boolean))
    (wxlambda:on-click button
      (lambda ()
        (focus-error (lambda () (wxlambda:focus-window text)))
        (focus-error (lambda () (wxlambda:navigate-focus text :forward nil)))
        (wxlambda:defer-ui-action
          (lambda () (wxlambda:focus-window text) (setf delivered t)) :owner text)))
    (wxlambda:queue-click button)
    (loop repeat 30 until delivered do (wxlambda:process-events))
    (assert delivered)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (focus-error (lambda () (wxlambda:focus-window text)))
    (focus-error (lambda () (wxlambda:navigate-focus text)))))
(format t "PASS: focus requests, traversal, hidden/disabled/stale validation and callback deferral~%")
