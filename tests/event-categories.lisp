(load (merge-pathnames "../examples/event-categories.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(assert (= 31 (logand (wxlambda:event-category-mask :all)
           (logior (wxlambda:event-category-mask :ui) (wxlambda:event-category-mask :user-input)
                   (wxlambda:event-category-mask :socket) (wxlambda:event-category-mask :timer) (wxlambda:event-category-mask :thread)))))
(expect-error (lambda () (wxlambda:event-category-mask :invalid)))
(let (saved expired outer)
  (wxlambda:with-application ()
    (setf saved (wxlambda-event-categories:exercise))
    (wxlambda:register-event-type :category-notify)
    (let ((receiver (wxlambda:make-event-handler)))
      (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session :category-message :category-notify))
        (let ((binding (wxlambda:bind-event receiver kind
                         (lambda (e c)
                           (setf saved e expired c)
                           (assert (= (wxlambda:event-category-mask (if (member kind '(:close :query-end-session :end-session)) :ui :user-input)) (wxlambda:event-category e) (wxlambda:event-category c)))) :with-context t)))
          (wxlambda:process-event receiver kind)
          (expect-error (lambda () (wxlambda:event-category expired)) 'wxlambda:native-error)
          (wxlambda:unbind-event binding)))
      (let* ((inner (wxlambda:bind-event receiver :category-notify
                      (lambda (e c)
                        (declare (ignore e c))
                        (expect-error (lambda () (wxlambda:event-category outer)) 'wxlambda:native-error)) :with-context t))
             (binding (wxlambda:bind-event receiver :close
                        (lambda (e c)
                          (declare (ignore e))
                          (setf outer c)
                          (wxlambda:process-event receiver :category-notify)
                          (assert (= (wxlambda:event-category-mask :ui) (wxlambda:event-category c)))) :with-context t)))
        (wxlambda:process-event receiver :close)
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      (wxlambda:destroy-event-handler receiver))
    ;; Exercise all convenience snapshot aggregates as well as generic hooks.
    (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
           (button (wxlambda:make-button panel)) (text (wxlambda:make-text panel))
           (checkbox (wxlambda:make-checkbox panel)) (choice (wxlambda:make-choice panel :items '("One"))))
      (flet ((capture (e) (setf saved e) (assert (= (wxlambda:event-category-mask :user-input) (wxlambda:event-category e)))))
        (wxlambda:on-click button #'capture :with-event t)
        (wxlambda:on-text-change text #'capture)
        (wxlambda:on-toggle checkbox #'capture)
        (wxlambda:on-selection choice #'capture)
        (dolist (pair (list (list button :click) (list text :text-change) (list checkbox :toggle) (list choice :selection)))
          (setf saved nil)
          (wxlambda:process-event (first pair) (second pair))
          (assert saved)))
      (wxlambda:off-click button) (wxlambda:off-text-change text)
      (wxlambda:off-toggle checkbox) (wxlambda:off-selection choice)
      (wxlambda:destroy-window frame))
    (assert (not (fboundp '(setf wxlambda:event-category))))
    (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-category)) 2 saved))))
  (assert (= (wxlambda:event-category-mask :user-input) (wxlambda:event-category saved)))
  (expect-error (lambda () (wxlambda:event-category expired)) 'wxlambda:native-error))
(format t "PASS: native category snapshots/contexts, masks, convenience hooks and lifetime isolation~%")
