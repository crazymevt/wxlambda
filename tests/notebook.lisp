(load (merge-pathnames "../examples/notebook.lisp" *load-truename*))
(defun expect-notebook-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-notebook (wxlambda:notebook) ((tag :initarg :tag :reader notebook-tag))
  (:default-initargs :tag :default))
(defmethod initialize-instance :after ((book named-notebook) &key)
  (assert (zerop (wxlambda:notebook-page-count book)))
  (assert (null (wxlambda:selection book))))
(defvar *failed-notebook-id* nil)
(defvar *failed-page-id* nil)
(defclass failing-notebook (wxlambda:notebook) ())
(defmethod initialize-instance :after ((book failing-notebook) &key)
  (setf *failed-notebook-id* (wxlambda::handle book))
  (let* ((page (wxlambda:make-panel book)) (text (wxlambda:make-text page)))
    (setf *failed-page-id* (wxlambda::handle page))
    (wxlambda:add-notebook-page book page)
    (wxlambda:on-text-change text (lambda (event) (declare (ignore event)) (error "Should not run"))))
  (error "Notebook initialization failure"))
(defclass early-page (wxlambda:panel) ((book :initarg :book)))
(defmethod initialize-instance :after ((page early-page) &key book)
  (wxlambda:add-notebook-page book page)
  (error "Must reject attachment before this point"))

(wxlambda:with-application ()
  (assert (wxlambda-notebook:exercise))
  (let* ((frame (wxlambda:make-frame))
         (book (wxlambda:make-notebook frame :class 'named-notebook :tag :factory))
         (one (wxlambda:make-panel book)) (two (wxlambda:make-panel book))
         (other (wxlambda:make-panel frame))
         (dialog (wxlambda:make-message-dialog :parent frame :message "Must not enter a nested loop"))
         (events nil) (veto nil) (saved-context nil) (changing nil) (changed nil))
    (unwind-protect
         (progn
           (assert (eq :factory (notebook-tag book)))
           (wxlambda:bind-event book :notebook-page-changed
             (lambda (event)
               ;; Newly published native pages already have canonical wrapper roots.
               (assert (typep (wxlambda:notebook-page book (wxlambda:event-selection event)) 'wxlambda:panel))))
           (assert (eq one (wxlambda:add-notebook-page book one :label "Editor λ")))
           (assert (eq two (wxlambda:add-notebook-page book two :label "日本語 😀" :select t)))
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (assert (eq one (wxlambda:notebook-page book 0)))
           (assert (eq two (wxlambda:notebook-page book 1)))
           (setf (wxlambda:notebook-page-label book 1) "")
           (assert (string= "" (wxlambda:notebook-page-label book 1)))
           (setf (wxlambda:notebook-page-label book 1) "Settings λ")
           (setf changing
                 (wxlambda:bind-event book :notebook-page-changing
                   (lambda (event context)
                     (push event events) (setf saved-context context)
                     (assert (eq :notify (wxlambda:event-family event)))
                     (assert (eql (wxlambda:event-selection event) (wxlambda:event-selection context)))
                     (assert (eq book (wxlambda:event-source event)))
                     (expect-notebook-error (lambda () (setf (wxlambda:selection book) 0)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (wxlambda:destroy-window book)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (wxlambda:destroy-window frame)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (wxlambda:close-window frame)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (wxlambda:show-modal dialog)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (setf (wxlambda:event-selection context) 0)) 'wxlambda:native-error)
                     (expect-notebook-error (lambda () (wxlambda:clone-event context)) 'wxlambda:native-error)
                     (when veto (setf (wxlambda:event-vetoed-p context) t)))
                   :with-context t)
                 changed
                 (wxlambda:bind-event book :notebook-page-changed (lambda (event) (push event events))))
           (setf (wxlambda:selection book) 0)
           (assert (null events))
           (setf veto t)
           (assert (= 1 (setf (wxlambda:selection book :notify t) 1)))
           (assert (= 0 (wxlambda:selection book)))
           (assert (find :notebook-page-changing events :key #'wxlambda:event-kind))
           (assert (not (wxlambda:event-context-active-p saved-context)))
           (setf veto nil events nil)
           (setf (wxlambda:selection book :notify t) 1)
           (assert (= 1 (wxlambda:selection book)))
           (assert (find :notebook-page-changed events :key #'wxlambda:event-kind))
           (dolist (index (list -1 2 (ash 1 32) nil))
             (expect-notebook-error (lambda () (setf (wxlambda:selection book) index)))
             (expect-notebook-error (lambda () (wxlambda:notebook-page book index))))
           (expect-notebook-error (lambda () (wxlambda:add-notebook-page book one)))
           (expect-notebook-error (lambda () (wxlambda:add-notebook-page book other)))
           (expect-notebook-error (lambda () (wxlambda:add-notebook-page book (wxlambda:make-button book))))
           (expect-notebook-error (lambda () (wxlambda:destroy-window one)) 'wxlambda:native-error)
           (expect-notebook-error (lambda () (wxlambda:make-column book)) 'wxlambda:native-error)
           (expect-notebook-error (lambda () (setf (wxlambda:notebook-page-label book 0) (string (code-char 0)))))
           (expect-notebook-error (lambda () (make-instance 'early-page :parent book :book book)))
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (dolist (kind '(:notebook-page-changing :notebook-page-changed))
             (expect-notebook-error (lambda () (wxlambda:register-event-type kind)))
             (expect-notebook-error (lambda () (wxlambda:make-event :kind kind)))
             (expect-notebook-error (lambda () (wxlambda:process-event book kind))))
           (wxlambda:unbind-event changing) (wxlambda:unbind-event changed)
           ;; Callback errors preserve native outcome and leave navigation reusable.
           (setf changed (wxlambda:bind-event book :notebook-page-changed
                          (lambda (event) (declare (ignore event)) (error "Page callback error"))))
           (expect-notebook-error (lambda () (setf (wxlambda:selection book :notify t) 0)))
           (wxlambda:unbind-event changed)
           (setf (wxlambda:selection book) 1)
           (assert (= 1 (wxlambda:selection book)))
           (let ((roots (hash-table-count wxlambda::*handlers*)))
             (expect-notebook-error (lambda () (make-instance 'failing-notebook :parent frame)))
             (wxlambda:process-events)
             (assert (= roots (hash-table-count wxlambda::*handlers*)))
             (assert (zerop (wxlambda::%handler-alive *failed-notebook-id*)))
             (assert (zerop (wxlambda::%handler-alive *failed-page-id*)))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))
    (expect-notebook-error (lambda () (wxlambda:notebook-page-count book)) 'wxlambda:native-error)
    (expect-notebook-error (lambda () (wxlambda:selection book)) 'wxlambda:native-error)
    (expect-notebook-error (lambda () (wxlambda:shown-p one)) 'wxlambda:native-error)))
(format t "PASS: notebook CLOS/pages, canonical identity, selection/veto, guards, callbacks and rollback~%")
