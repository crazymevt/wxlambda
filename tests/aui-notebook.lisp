(load (merge-pathnames "../examples/aui-notebook.lisp" *load-truename*))
(defun aui-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-aui (wxlambda:aui-notebook) ((tag :initarg :tag :reader aui-tag)) (:default-initargs :tag :default))
(defmethod initialize-instance :after ((book custom-aui) &key)
  (assert (zerop (wxlambda:notebook-page-count book))))
(defclass failing-aui (custom-aui) ())
(defvar *failed-aui* nil)
(defmethod initialize-instance :after ((book failing-aui) &key)
  (setf *failed-aui* book) (error "Expected AUI rollback"))
(defclass mixed-aui (wxlambda:aui-notebook wxlambda:notebook) ())
(defclass attaching-aui-page (wxlambda:panel) ())
(defmethod initialize-instance :after ((page attaching-aui-page) &key parent)
  (wxlambda:add-notebook-page parent page))
(wxlambda:with-application ()
  (assert (wxlambda-aui-notebook:exercise))
  (let* ((frame (wxlambda:make-frame))
         (book (wxlambda:make-aui-notebook frame :class 'custom-aui :tag :factory))
         (a (wxlambda:make-panel book)) (b (wxlambda:make-panel book)) (c (wxlambda:make-panel book))
         (button (wxlambda:make-button frame)) (events nil) (deferred nil))
    (assert (eq :factory (aui-tag book))) (assert (null (wxlambda:selection book)))
    (aui-error (lambda () (make-instance 'mixed-aui :parent frame)))
    (aui-error (lambda () (wxlambda:make-aui-notebook frame :class 'wxlambda:panel)))
    (aui-error (lambda () (make-instance 'attaching-aui-page :parent book)))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (aui-error (lambda () (make-instance 'failing-aui :parent frame)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (aui-error (lambda () (wxlambda:notebook-page-count *failed-aui*)) 'wxlambda:native-error)
    (assert (eq a (wxlambda:add-notebook-page book a :label "A λ")))
    (wxlambda:add-notebook-page book c :label "C")
    (wxlambda:insert-notebook-page book b 1 :label "B")
    (assert (eq b (wxlambda:notebook-page book 1)))
    (aui-error (lambda () (wxlambda:add-notebook-page book a)))
    (aui-error (lambda () (wxlambda:destroy-window b)))
    (aui-error (lambda () (wxlambda:make-column book)))
    (aui-error (lambda () (wxlambda:window-event-handler book)))
    (aui-error (lambda () (setf (wxlambda:notebook-page-label book 0) (make-string 4097 :initial-element #\x))))
    (setf (wxlambda:notebook-page-label book 1) "B λ" (wxlambda:selection book) 1)
    (assert (string= "B λ" (wxlambda:notebook-page-label book 1)))
    (wxlambda:move-notebook-page book 1 0)
    (assert (eq b (wxlambda:notebook-page book 0)))
    (assert (= 0 (wxlambda:selection book)))
    (assert (= 0 (wxlambda:notebook-page-index book b)))
    (assert (eq b (wxlambda:remove-notebook-page book 0)))
    (assert (wxlambda:handler-alive-p b)) (assert (null (wxlambda:notebook-page-index book b)))
    (assert (not (wxlambda:shown-p b)))
    (wxlambda:add-notebook-page book b :label "Reattached")
    (wxlambda:show-window frame) (wxlambda:process-events)
    (assert (eq book (wxlambda:split-notebook-page book 2 :right)))
    (assert (eq b (wxlambda:notebook-page book 2)))
    (assert (= 2 (wxlambda:notebook-page-index book b)))
    (aui-error (lambda () (wxlambda:split-notebook-page book 0 :diagonal)))
    (wxlambda:bind-event book :aui-page-changing
      (lambda (event context)
        (push event events)
        (aui-error (lambda () (setf (wxlambda:selection book) 0)))
        (aui-error (lambda () (wxlambda:delete-notebook-page book 0)))
        (aui-error (lambda () (wxlambda:split-notebook-page book 0 :top)))
        (aui-error (lambda () (wxlambda:destroy-window frame)))
        (aui-error (lambda () (setf (wxlambda:event-integer context) 2)))
        (aui-error (lambda () (wxlambda:clone-event context)))
        (setf (wxlambda:event-vetoed-p context) t)) :with-context t)
    (setf (wxlambda:selection book) 0)
    (setf (wxlambda:selection book :notify t) 1)
    (assert (= 0 (wxlambda:selection book)))
    (assert events)
    (assert (integerp (wxlambda:event-old-selection (first events))))
    (assert (integerp (wxlambda:event-aui-page-id (first events))))
    (setf (wxlambda:selection book) 1)
    (wxlambda:on-click button (lambda ()
      (aui-error (lambda () (wxlambda:remove-notebook-page book 0)))
      (aui-error (lambda () (setf (wxlambda:notebook-page-label book 0) "callback")))
      (wxlambda:defer-ui-action (lambda () (wxlambda:delete-notebook-page book 2) (setf deferred t)) :owner book)))
    (wxlambda:queue-click button)
    (loop repeat 40 until deferred do (wxlambda:process-events))
    (assert deferred) (assert (= 2 (wxlambda:notebook-page-count book)))
    (assert (not (wxlambda:handler-alive-p b)))
    ;; Fabricated Lisp transport regression, separate from actual native close
    ;; tests: a consuming newest-first CLOSED context must see caches pruned
    ;; before user code, without depending on the older internal observer.
    (pushnew b (wxlambda::notebook-pages book) :test #'eq)
    (let* ((seen nil)
           (binding (wxlambda:bind-event book :aui-page-closed
                      (lambda (event context)
                        (declare (ignore event context))
                        (assert (not (member b (wxlambda::notebook-pages book) :test #'eq)))
                        (setf seen t)) :with-context t)))
      (unwind-protect
           (cffi:with-foreign-object (payload '(:struct wxlambda::native-event))
             (loop for byte below (cffi:foreign-type-size '(:struct wxlambda::native-event))
                   do (setf (cffi:mem-aref payload :uint8 byte) 0))
             (setf (cffi:foreign-slot-value payload '(:struct wxlambda::native-event) 'wxlambda::kind) 103
                   (cffi:foreign-slot-value payload '(:struct wxlambda::native-event) 'wxlambda::origin-id) (wxlambda::handle book)
                   (cffi:foreign-slot-value payload '(:struct wxlambda::native-event) 'wxlambda::family) 2
                   (cffi:foreign-slot-value payload '(:struct wxlambda::native-event) 'wxlambda::command) 1)
             (cffi:foreign-funcall-pointer (cffi:callback wxlambda::dispatch-event) ()
               :uint64 (wxlambda::event-binding-token binding) :pointer payload :void)
             (wxlambda::check-callback-error) (assert seen)
             (pushnew b (wxlambda::notebook-pages book) :test #'eq)
             (setf seen nil)
             (let ((original (make-condition 'simple-error :format-control "Expected pending callback condition")))
               (let ((wxlambda::*callback-error* original))
                 (cffi:foreign-funcall-pointer (cffi:callback wxlambda::dispatch-event) ()
                   :uint64 (wxlambda::event-binding-token binding) :pointer payload :void)
                 (assert (eq original wxlambda::*callback-error*))
                 (assert (not seen))
                 (assert (not (member b (wxlambda::notebook-pages book) :test #'eq)))))
             (wxlambda::check-callback-error))
        (wxlambda:unbind-event binding)))
    (dolist (kind '(:aui-page-changing :aui-page-changed :aui-page-close :aui-page-closed :aui-drag-done :aui-tab-right-up))
      (aui-error (lambda () (wxlambda:make-event :kind kind))))
    (let* ((splitter (wxlambda:make-splitter-window frame))
           (first (wxlambda:make-panel splitter)) (second (wxlambda:make-panel splitter)) (third (wxlambda:make-panel splitter)))
      (wxlambda:initialize-splitter splitter first)
      (assert (eq first (wxlambda:splitter-pane splitter 0)))
      (assert (null (wxlambda:splitter-pane splitter 1)))
      (wxlambda:resplit-window splitter second)
      (assert (wxlambda:splitter-split-p splitter))
      (assert (eq second (wxlambda:replace-splitter-pane splitter 1 third)))
      (assert (not (wxlambda:shown-p second))) (assert (wxlambda:handler-alive-p second))
      (assert (eq third (wxlambda:unsplit-window splitter)))
      (assert (not (wxlambda:splitter-split-p splitter)))
      (assert (wxlambda:handler-alive-p third))
      (setf (wxlambda:splitter-orientation splitter) :horizontal)
      (assert (eq :horizontal (wxlambda:splitter-orientation splitter)))
      (wxlambda:resplit-window splitter third)
      (wxlambda:destroy-window second))
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (aui-error (lambda () (wxlambda:notebook-page-count book)))))
(format t "PASS: AUI dynamic pages, canonical detach/delete/move, selection veto, callback deferral, rollback and dynamic splitter panes~%")
