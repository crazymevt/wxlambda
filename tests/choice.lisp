(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-dispatch-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (not (typep condition 'wxlambda:native-error))))))

(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(let ((saved nil) (snapshots nil) (calls 0)
      (mode (or (uiop:getenv "WXLAMBDA_CHOICE_TEST_MODE") "normal"))
      (failed nil))
  (handler-case
      (wxlambda:with-application ()
        (let* ((frame (wxlambda:make-frame :title "Choice controls"))
               (panel (wxlambda:make-panel frame))
               (choice (wxlambda:make-choice panel :items '("" "λ 日本語 😀" "Third") :selection 1))
               (empty (wxlambda:make-choice panel))
               (button (wxlambda:make-button panel)))
          (setf saved choice)
          (wxlambda:make-column panel)
          (dolist (child (list choice empty button)) (wxlambda:add-child panel child))
          (assert (= 1 (wxlambda:selection choice)))
          (assert (null (wxlambda:selection empty)))
          (assert (null (setf (wxlambda:selection empty) nil)))
          (expect-native-error (lambda () (setf (wxlambda:selection empty) 0)))
          (expect-native-error (lambda () (wxlambda:make-choice panel :items '("Only") :selection 1)))
          (expect-native-error (lambda () (setf (wxlambda:selection choice) 3)))
          (assert (= 1 (wxlambda:selection choice)))
          (expect-dispatch-error (lambda () (wxlambda:selection button)))
          (expect-dispatch-error (lambda () (setf (wxlambda:selection button) 0)))
          (wxlambda:on-selection choice (lambda (event) (declare (ignore event)) (error "Replaced handler")))
          (wxlambda:on-selection choice
            (lambda (event)
              (incf calls)
              (assert (eq :selection (wxlambda:event-kind event)))
              (assert (eq choice (wxlambda:event-source event)))
              (assert (null (wxlambda:event-text event)))
              (assert (null (wxlambda:event-checked-p event)))
              (push event snapshots)
              (unless (string= mode "normal") (error "Expected selection error"))
              (when (eql 2 (wxlambda:event-selection event))
                (setf (wxlambda:selection choice :notify t) nil)
                (assert (= 2 (wxlambda:event-selection event))))))
          (assert (= 1 (hash-table-count wxlambda::*handlers*)))
          (assert (= 0 (setf (wxlambda:selection choice) 0)))
          (assert (zerop calls))
          (cond
            ((string= mode "error-before-run") (setf (wxlambda:selection choice :notify t) 2))
            (t
             (wxlambda:on-click button
               (lambda ()
                 (if (string= mode "error-in-loop")
                     (setf (wxlambda:selection choice :notify t) 2)
                     (progn
                       (assert (= 2 (setf (wxlambda:selection choice :notify t) 2)))
                       (assert (null (wxlambda:selection choice)))
                       (assert (= 2 calls))
                       (assert (equal '(nil 2) (mapcar #'wxlambda:event-selection snapshots)))
                       (setf (wxlambda:selection choice :notify t) nil)
                       (assert (= 3 calls))
                       (expect-dispatch-error (lambda () (wxlambda:on-selection button #'identity)))
                       (expect-dispatch-error (lambda () (wxlambda:off-selection button)))
                       (assert (= 2 (hash-table-count wxlambda::*handlers*)))
                       (wxlambda:on-selection choice
                         (lambda (event)
                           (declare (ignore event))
                           (incf calls)
                           (wxlambda:off-selection choice)))
                       (setf (wxlambda:selection choice :notify t) 1)
                       (assert (= 4 calls))
                       (wxlambda:off-selection choice)
                       (setf (wxlambda:selection choice :notify t) 0)
                       (assert (= 4 calls))
                       ;; A setter error caught by its caller must not escape the event callback.
                       (wxlambda:on-selection choice (lambda (event) (declare (ignore event)) (error "Handled selection error")))
                       (assert (handler-case (progn (setf (wxlambda:selection choice :notify t) 1) nil)
                                 (error (condition) (search "Handled selection error" (princ-to-string condition)))))
                       (assert (null wxlambda::*callback-error*))
                       (wxlambda:off-selection choice)
                       (wxlambda:off-click button)
                       (assert (zerop (hash-table-count wxlambda::*handlers*)))
                       (wxlambda:destroy-window frame)))))
             (wxlambda:show-window frame)
             (wxlambda:queue-click button)
             (wxlambda:run)
             (when (string= mode "normal")
               (expect-native-error (lambda () (wxlambda:selection choice)))
               (expect-native-error (lambda () (wxlambda:off-selection choice))))))))
    (error (condition)
      (unless (and (not (string= mode "normal"))
                   (search "Expected selection error" (princ-to-string condition)))
        (error condition))
      (setf failed t)))
  (assert (eq failed (not (string= mode "normal"))))
  (assert (not wxlambda::*active*))
  (expect-native-error (lambda () (wxlambda:selection saved)))
  (format t "PASS: choices ~A, selection snapshots, bounds, handlers, and cleanup~%" mode))
