(load (merge-pathnames "../examples/gauge.lisp" *load-truename*))

(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))

(defclass observed-gauge (wxlambda:gauge)
  ((tag :initarg :tag :reader tag)
   (initial-value :reader initial-value))
  (:default-initargs :range 12 :value 3 :orientation :vertical :tag :default))
(defmethod initialize-instance :after ((object observed-gauge) &key)
  (setf (slot-value object 'initial-value) (wxlambda:gauge-value object)))
(defvar *failed-gauge*)
(defclass failing-gauge (wxlambda:gauge) ())
(defmethod initialize-instance :after ((object failing-gauge) &key)
  (setf *failed-gauge* object)
  (error "Gauge initialization failure"))

(let (saved)
  (wxlambda:with-application ()
    (wxlambda-gauge:exercise)
    (let* ((frame (wxlambda:make-frame))
           (panel (wxlambda:make-panel frame))
           (horizontal (make-instance 'wxlambda:gauge :parent panel))
           (vertical (wxlambda:make-gauge panel :class 'observed-gauge :tag :forwarded)))
      (setf saved horizontal)
      (assert (= 100 (wxlambda:gauge-range horizontal)))
      (assert (zerop (wxlambda:gauge-value horizontal)))
      (assert (not (wxlambda:gauge-vertical-p horizontal)))
      (assert (wxlambda:gauge-vertical-p vertical))
      (assert (= 3 (initial-value vertical)))
      (assert (eq :forwarded (tag vertical)))
      (assert (= 12 (setf (wxlambda:gauge-value vertical) 12)))
      (assert (= 5 (setf (wxlambda:gauge-range vertical) 5)))
      (assert (= 5 (wxlambda:gauge-value vertical)))
      (setf (wxlambda:gauge-range vertical) 20)
      (assert (= 5 (wxlambda:gauge-value vertical)))
      (assert (eq vertical (wxlambda:pulse-gauge vertical)))
      (setf (wxlambda:gauge-value vertical) 0)
      (assert (zerop (wxlambda:gauge-value vertical)))
      (setf (wxlambda:window-name horizontal) "progress λ")
      (assert (string= "progress λ" (wxlambda:window-name horizontal)))
      (setf (wxlambda:enabled-p horizontal) nil)
      (assert (not (wxlambda:enabled-p horizontal)))
      (wxlambda:make-column panel)
      (wxlambda:add-child panel horizontal)
      (wxlambda:add-child panel vertical)
      (wxlambda:show-window frame)
      (wxlambda:process-events)
      (assert (plusp (wxlambda:window-size horizontal)))
      (dolist (args '((:range 0) (:range -1) (:range 2147483648) (:value -1)
                      (:value 101) (:orientation :diagonal)))
        (expect-error (lambda () (apply #'wxlambda:make-gauge panel args))))
      (expect-error (lambda () (wxlambda:make-gauge panel :class 'wxlambda:button)))
      (expect-error (lambda () (wxlambda:make-gauge panel :unknown t)))
      (expect-error (lambda () (setf (wxlambda:gauge-range horizontal) 0)) 'type-error)
      (expect-error (lambda () (setf (wxlambda:gauge-value horizontal) 101)) 'wxlambda:native-error)
      (assert (= 100 (wxlambda:gauge-range horizontal)))
      (assert (zerop (wxlambda:gauge-value horizontal)))
      (expect-error (lambda () (wxlambda:gauge-value panel)))
      ;; Native callers also get range/type checks before reaching wx assertions.
      (assert (= -1 (wxlambda::%gauge-value (wxlambda::handle panel))))
      (assert (= -1 (wxlambda::%set-gauge-range (wxlambda::handle horizontal) 0)))
      (assert (= -1 (wxlambda::%set-gauge-value (wxlambda::handle horizontal) -1)))
      (assert (zerop (wxlambda::%gauge (wxlambda::handle panel) 0 0 0)))
      (expect-error (lambda () (wxlambda:make-gauge panel :class 'failing-gauge)))
      (assert (null (slot-value *failed-gauge* 'wxlambda::handle)))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events)
      (expect-error (lambda () (wxlambda:gauge-value saved)) 'wxlambda:native-error)))
  (expect-error (lambda () (wxlambda:gauge-range saved)) 'wxlambda:native-error))
(format t "PASS: gauges, subclass construction, properties, validation, rollback, lifetime and example callbacks~%")
