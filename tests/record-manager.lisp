(load (merge-pathnames "../examples/record-manager.lisp" *load-truename*))
(in-package #:wxlambda-record-manager)
(wxlambda:with-application ()
  (assert (exercise))
  (let ((prompt-count 0) (copied nil) (manager nil))
    (setf manager
          (build-manager
            :prompt (lambda (frame operation current)
                      (declare (ignore frame operation))
                      (incf prompt-count)
                      (assert (= 1 (record-id current)))
                      (assert (manager-active manager))
                      (assert (null (request-action manager :new)))
                      (values "Stable target λ" "Updated by ID" t))
            :confirm (lambda (frame record) (declare (ignore frame record)) nil)
            :copy-text (lambda (value) (setf copied value))))
    (unwind-protect
         (progn
           (wxlambda:show-window (manager-frame manager)) (wxlambda:process-events)
           (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
           (request-action manager :edit)
           ;; Navigation changes before delivery cannot retarget the queued edit by row.
           (setf (wxlambda:selection (manager-tree manager) :notify t) (car (third (manager-categories manager))))
           (drain-manager manager)
           (assert (= 1 prompt-count))
           (assert (string= "Stable target λ" (record-title (find-record manager 1))))
           (assert (string= "Diagram" (record-title (find-record manager 3))))
           (assert (equal '(3) (manager-visible-ids manager)))
           (assert (not (manager-active manager)))
           (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
           (wxlambda:activate-toolbar-tool (manager-toolbar manager) +copy+)
           (drain-manager manager)
           (assert (string= (format nil "Diagram~%Retained scene reference") copied))
           ;; A cancel request merges into an already pending text refresh.
           (setf (wxlambda:text (manager-query manager) :notify t) "absent")
           (let ((ticket (manager-refresh-ticket manager)))
             (request-refresh manager t)
             (assert (eq ticket (manager-refresh-ticket manager))))
           (drain-manager manager)
           (assert (string= "" (wxlambda:text (manager-query manager))))
           (assert (equal '(3) (manager-visible-ids manager)))
           (setf (wxlambda:selection (manager-listing manager) :notify t) nil)
           (assert (null (manager-selected-id manager)))
           (assert (not (wxlambda:tool-enabled-p (manager-toolbar manager) +copy+)))
           ;; A queued details request cannot resurrect a selection hidden by an earlier refresh.
           (setf (wxlambda:selection (manager-tree manager) :notify t) (car (second (manager-categories manager))))
           (drain-manager manager)
           (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
           (setf (wxlambda:text (manager-query manager) :notify t) "日本語")
           (request-action manager :details)
           (drain-manager manager)
           (assert (null (manager-selected-id manager)))
           (assert (not (wxlambda:tool-enabled-p (manager-toolbar manager) +copy+)))
           ;; Delete keeps a later selection when it is a different stable record.
           (setf (wxlambda:text (manager-query manager) :notify t) "") (drain-manager manager)
           (setf (wxlambda:selection (manager-listing manager) :notify t) 0
                 (manager-confirm manager) (lambda (&rest args) (declare (ignore args)) t))
           (request-action manager :delete)
           (setf (wxlambda:selection (manager-listing manager) :notify t) 1)
           (drain-manager manager)
           (assert (not (find-record manager 1)))
           (assert (= 2 (manager-selected-id manager)))
           (assert (= 0 (wxlambda:selection (manager-listing manager)))))
      (dispose-manager manager) (wxlambda:process-events)))
  (let* ((condition (make-condition 'simple-error :format-control "Injected prompt failure"))
         (manager (build-manager :prompt (lambda (&rest args) (declare (ignore args)) (error condition))
                                 :confirm (lambda (&rest args) (declare (ignore args)) nil)
                                 :copy-text (lambda (value) (declare (ignore value))))))
    (unwind-protect
         (progn
           (request-action manager :new)
           (let ((actual nil))
             (loop repeat 30 while (manager-pending manager)
                   do (handler-case (wxlambda:process-events) (error (value) (setf actual value))))
             (assert (eq condition actual)))
           (assert (not (manager-active manager)))
           (assert (null (manager-pending manager)))
           (assert (= 3 (length (manager-records manager)))))
      (dispose-manager manager) (wxlambda:process-events)))
  (let* ((prompt-count 0)
         (manager (build-manager :prompt (lambda (&rest args) (declare (ignore args)) (incf prompt-count) (values "Unused" "" t))
                                 :confirm (lambda (&rest args) (declare (ignore args)) nil)
                                 :copy-text (lambda (value) (declare (ignore value))))))
    (request-action manager :new)
    (let ((ticket (manager-pending manager)))
      (dispose-manager manager)
      (wxlambda:process-events)
      (assert (not (wxlambda:ui-action-pending-p ticket)))
      (assert (zerop prompt-count))
      (assert (manager-disposed manager)))))
(format t "PASS: integrated manager tree/filter/CRUD/actions/details, stable IDs, coalescing, cancellation/failure and owner disposal~%")
