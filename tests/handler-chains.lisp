(load (merge-pathnames "../examples/handler-chains.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass named-chain-handler (wxlambda:event-handler)
  ((name :initarg :name :reader chain-name)) (:default-initargs :name "default node"))
(defvar *failed-chain-id*)
(defclass failing-chain-handler (wxlambda:event-handler) ((anchor :initarg :anchor)))
(defmethod initialize-instance :after ((node failing-chain-handler) &key)
  (setf *failed-chain-id* (wxlambda::handle node))
  (setf (wxlambda:next-handler (slot-value node 'anchor)) node)
  (error "linked initializer failure"))

(defun assert-chain-links (node previous next)
  (assert (eq previous (wxlambda:previous-handler node)))
  (assert (eq next (wxlambda:next-handler node)))
  (assert (eql (and (null previous) (null next)) (wxlambda:handler-unlinked-p node))))

(defun check-reciprocal-chain-editing ()
  (let* ((a (wxlambda:make-event-handler))
         (b (wxlambda:make-event-handler :class 'named-chain-handler :name "canonical subclass"))
         (c (wxlambda:make-event-handler)) (d (wxlambda:make-event-handler))
         (free (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (assert-chain-links a nil nil)
           (assert (eq b (setf (wxlambda:next-handler a) b)))
           (assert (eq c (setf (wxlambda:previous-handler d) c)))
           (setf (wxlambda:next-handler b) c)
           (assert-chain-links a nil b) (assert-chain-links b a c)
           (assert-chain-links c b d) (assert-chain-links d c nil)
           (assert (typep (wxlambda:next-handler a) 'named-chain-handler))
           (assert (string= "canonical subclass" (chain-name (wxlambda:next-handler a))))
           ;; Reassigning an established reciprocal pair is idempotent.
           (setf (wxlambda:next-handler a) b (wxlambda:previous-handler b) a)
           (dolist (operation (list (lambda () (setf (wxlambda:next-handler a) a))
                                    (lambda () (setf (wxlambda:previous-handler a) a))
                                    (lambda () (setf (wxlambda:next-handler d) a))
                                    (lambda () (setf (wxlambda:previous-handler a) d))
                                    (lambda () (setf (wxlambda:next-handler a) c))
                                    (lambda () (setf (wxlambda:next-handler free) b))
                                    (lambda () (setf (wxlambda:previous-handler d) free))))
             (expect-error operation 'wxlambda:native-error)
             (assert-chain-links a nil b) (assert-chain-links b a c)
             (assert-chain-links c b d) (assert-chain-links d c nil)
             (assert-chain-links free nil nil))
           (assert (null (setf (wxlambda:next-handler b) nil)))
           (assert-chain-links b a nil) (assert-chain-links c nil d)
           (setf (wxlambda:previous-handler c) b)
           (assert (eq b (wxlambda:unlink-event-handler b)))
           (assert-chain-links a nil c) (assert-chain-links c a d)
           (assert-chain-links b nil nil)
           (assert (wxlambda:handler-alive-p b))
           (wxlambda:unlink-event-handler b) ; already detached is harmless
           (assert (null (setf (wxlambda:previous-handler d) nil)))
           (assert-chain-links c a nil) (assert-chain-links d nil nil)
           (wxlambda:destroy-event-handler a)
           (assert-chain-links c nil nil)
           (assert (not (wxlambda:handler-alive-p a)))
           ;; Build again and delete a middle node, then the tail and head.
           (setf (wxlambda:next-handler b) c (wxlambda:next-handler c) d)
           (wxlambda:destroy-event-handler c)
           (expect-error (lambda () (wxlambda:next-handler c)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:previous-handler c)) 'wxlambda:native-error)
           (assert-chain-links b nil d) (assert-chain-links d b nil)
           (wxlambda:destroy-event-handler d)
           (assert-chain-links b nil nil))
      (dolist (node (list free d c b a))
        (when (wxlambda:handler-alive-p node) (wxlambda:destroy-event-handler node))))))

(defun check-chain-receiver-policy ()
  (let* ((frame (wxlambda:make-frame)) (owned (wxlambda:make-event))
         (node (wxlambda:make-event-handler)) (app (wxlambda:current-application-handler)))
    (unwind-protect
         (progn
           (dolist (receiver (list frame app owned))
             (dolist (query (list #'wxlambda:next-handler #'wxlambda:previous-handler
                                  #'wxlambda:handler-unlinked-p #'wxlambda:unlink-event-handler))
               (expect-error (lambda () (funcall query receiver))))
             (expect-error (lambda () (setf (wxlambda:next-handler receiver) node)))
             (expect-error (lambda () (setf (wxlambda:previous-handler receiver) node)))
             (expect-error (lambda () (setf (wxlambda:next-handler node) receiver)))
             (expect-error (lambda () (setf (wxlambda:previous-handler node) receiver)))
             (assert-chain-links node nil nil))
           (dolist (bad '(17 :invalid "not a handler"))
             (expect-error (lambda () (setf (wxlambda:next-handler node) bad)))
             (expect-error (lambda () (setf (wxlambda:previous-handler node) bad)))
             (assert-chain-links node nil nil)))
      (wxlambda:destroy-event owned) (wxlambda:destroy-event-handler node)
      (wxlambda:destroy-window frame))))

(defun check-chain-dispatch-and-callback-guards ()
  (let* ((a (wxlambda:make-event-handler))
         (b (wxlambda:make-event-handler :class 'named-chain-handler))
         (inner (wxlambda:make-event-handler))
         (outer-context nil) (source (wxlambda:make-event :kind :chain-message :id 42))
         (a-calls 0) (b-calls 0) (forward t) (b-consume nil) (seen nil)
         (inner-binding (wxlambda:bind-event inner :chain-message
                          (lambda (event context)
                            (declare (ignore event context))
                            (assert (eq b (wxlambda:next-handler a)))
                            (expect-error (lambda () (wxlambda:event-id outer-context)) 'wxlambda:native-error)
                            (expect-error (lambda () (wxlambda:unlink-event-handler a)) 'wxlambda:native-error))
                          :with-context t))
         (a-binding (wxlambda:bind-event a :chain-message
                      (lambda (event context)
                        (declare (ignore event)) (incf a-calls) (setf outer-context context)
                        (assert-chain-links a nil b)
                        (dolist (mutation (list (lambda () (setf (wxlambda:next-handler a) nil))
                                                (lambda () (setf (wxlambda:previous-handler b) nil))
                                                (lambda () (wxlambda:unlink-event-handler b))
                                                (lambda () (wxlambda:destroy-event-handler a))
                                                (lambda () (wxlambda:destroy-event-handler b))))
                          (expect-error mutation 'wxlambda:native-error)
                          (assert-chain-links a nil b) (assert-chain-links b a nil))
                        (wxlambda:process-event inner source)
                        (assert (= 42 (wxlambda:event-id context)))
                        (setf (wxlambda:event-skipped-p context) forward)) :with-context t))
         (b-binding (wxlambda:bind-event b :chain-message
                      (lambda (event context)
                        (incf b-calls) (setf seen event)
                        (assert (eq b (wxlambda:event-source event)))
                        (assert (= (wxlambda::handle a) (wxlambda:event-origin-id event)))
                        (setf (wxlambda:event-skipped-p context) (not b-consume))) :with-context t)))
    (setf (wxlambda:next-handler a) b)
    (unwind-protect
         (progn
           (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event a source))))
           (assert (= 1 a-calls b-calls))
           (assert (null (wxlambda:event-origin-id source)))
           (setf forward nil)
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event a source))))
           (assert (= 2 a-calls)) (assert (= 1 b-calls))
           (setf forward t b-consume t)
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event-locally a source))))
           (assert (= 3 a-calls)) (assert (= 2 b-calls))
           ;; Disabled current node still forwards to its next handler.
           (setf (wxlambda:handler-enabled-p a) nil)
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event a source))))
           (assert (= 3 a-calls b-calls))
           (assert (eq b (wxlambda:event-source seen))))
      (setf (wxlambda:handler-enabled-p a) t)
      (wxlambda:unbind-event a-binding) (wxlambda:unbind-event b-binding)
      (wxlambda:unbind-event inner-binding)
      (wxlambda:unlink-event-handler a)
      (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler inner) (wxlambda:destroy-event-handler a)
      (wxlambda:destroy-event-handler b))))

(defun check-chain-session-isolation ()
  (let ((a (wxlambda:make-event-handler)) (b (wxlambda:make-event-handler)))
    (setf (wxlambda:next-handler a) b)
    (unwind-protect
         (dolist (kind '(:query-end-session :end-session))
           (let* ((source (wxlambda:make-event :kind kind :logging-off-p t)) (calls 0)
                  (binding (wxlambda:bind-event b kind
                             (lambda (event context)
                               (incf calls)
                               (assert (wxlambda:event-logging-off-p event))
                               (setf (wxlambda:event-vetoed-p context) t)) :with-context t)))
             (unwind-protect
                  (progn
                    (assert (equal '(t t) (multiple-value-list (wxlambda:process-event a source))))
                    (assert (equal '(t t) (multiple-value-list (wxlambda:process-event-locally a source))))
                    (wxlambda:queue-event a source)
                    (wxlambda:process-pending-events)
                    (assert (= 3 calls))
                    (assert (not (wxlambda:event-vetoed-p source))))
               (wxlambda:unbind-event binding) (wxlambda:destroy-event source)))
           ;; Unmatched events must still stop before application defaults.
           (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event a kind)))))
      (wxlambda:unlink-event-handler a)
      (wxlambda:destroy-event-handler a) (wxlambda:destroy-event-handler b))))

(defun check-chain-pending-disposal-and-rollback ()
  (let* ((a (wxlambda:make-event-handler)) (b (wxlambda:make-event-handler))
         (c (wxlambda:make-event-handler)) (calls 0)
         (source (wxlambda:make-event :kind :chain-message))
         (binding (wxlambda:bind-event c :chain-message
                    (lambda (event) (declare (ignore event)) (incf calls)))))
    (setf (wxlambda:next-handler a) b (wxlambda:next-handler b) c)
    (unwind-protect
         (progn
           (let ((moved (wxlambda:clone-event source)))
             (wxlambda:transfer-event b moved)
             (assert (not (wxlambda:event-alive-p moved))))
           (wxlambda:queue-event a source)
           (wxlambda:destroy-event-handler b)
           (assert-chain-links a nil c) (assert-chain-links c a nil)
           (wxlambda:process-pending-events)
           (assert (= 1 calls))
           (wxlambda:queue-event a source)
           (wxlambda:destroy-event-handler a)
           (assert-chain-links c nil nil)
           (wxlambda:process-pending-events)
           (assert (= 1 calls))
           (expect-error (lambda () (make-instance 'failing-chain-handler :anchor c)))
           (assert (zerop (wxlambda::%handler-alive *failed-chain-id*)))
           (assert-chain-links c nil nil))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (dolist (node (list c b a))
        (when (wxlambda:handler-alive-p node) (wxlambda:destroy-event-handler node))))))

(defun check-unlinked-callback-disposal ()
  (let* ((node (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :chain-message))
         (binding (wxlambda:bind-event node :chain-message
                    (lambda (event context)
                      (declare (ignore event context))
                      (assert (wxlambda:handler-unlinked-p node))
                      (assert (wxlambda:destroy-event-handler node))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event node source)
           (assert (not (wxlambda:handler-alive-p node)))
           (expect-error (lambda () (wxlambda:next-handler node)) 'wxlambda:native-error)
           (wxlambda:process-events))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (when (wxlambda:handler-alive-p node) (wxlambda:destroy-event-handler node)))))

(defun check-chain-run-guard ()
  (let* ((frame (wxlambda:make-frame)) (a (wxlambda:make-event-handler))
         (b (wxlambda:make-event-handler)) (calls 0)
         (binding (wxlambda:bind-event b :chain-message
                    (lambda (event context)
                      (declare (ignore event context))
                      (assert-chain-links a nil b)
                      (expect-error (lambda () (setf (wxlambda:next-handler a) nil)) 'wxlambda:native-error)
                      (expect-error (lambda () (wxlambda:destroy-event-handler b)) 'wxlambda:native-error)
                      (incf calls)
                      (if (= calls 2) (wxlambda:stop)
                          (wxlambda:queue-event a :chain-message))) :with-context t)))
    (setf (wxlambda:next-handler a) b)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (wxlambda:queue-event a :chain-message)
           (wxlambda:run)
           (assert (= 2 calls)))
      (wxlambda:unbind-event binding) (wxlambda:unlink-event-handler a)
      (wxlambda:destroy-event-handler a) (wxlambda:destroy-event-handler b)
      (wxlambda:destroy-window frame))))

(let (escaped)
  (wxlambda:with-application ()
    (wxlambda-handler-chains:exercise)
    (check-reciprocal-chain-editing)
    (check-chain-receiver-policy)
    (check-chain-dispatch-and-callback-guards)
    (check-chain-session-isolation)
    (check-chain-pending-disposal-and-rollback)
    (check-chain-run-guard)
    (check-unlinked-callback-disposal)
    (setf escaped (wxlambda:make-event-handler :class 'named-chain-handler))
    (assert (string= "default node" (chain-name escaped))))
  (expect-error (lambda () (wxlambda:next-handler escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:previous-handler escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:handler-unlinked-p escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:unlink-event-handler escaped)) 'wxlambda:native-error))
(format t "PASS: reciprocal managed chains, atomic edits, dispatch/isolation, callback guards and lifetime cleanup~%")
