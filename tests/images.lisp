(load (merge-pathnames "../examples/image-viewer.lisp" *load-truename*))
(in-package #:wxlambda)
(defun image-test-error (function)
  (assert (handler-case (progn (funcall function) nil) (error () t))))
(defclass labelled-image (image) ((tag :initarg :tag :reader image-test-tag))
  (:default-initargs :width 2 :height 2 :tag :default))
(defmethod initialize-instance :after ((object labelled-image) &key)
  (assert (equal '(2 2) (image-size object))))
(defclass failing-image (image) ((parent :initarg :parent)))
(defvar *failed-image* nil)
(defvar *failed-image-bitmap* nil)
(defvar *failed-image-control* nil)
(defmethod initialize-instance :after ((object failing-image) &key)
  (setf *failed-image* object *failed-image-bitmap* (make-bitmap :image object)
        *failed-image-control* (make-static-bitmap (slot-value object 'parent) *failed-image-bitmap*))
  (error "Expected constructor rollback"))
(defclass mixed-image (image event-handler) ())
(with-application ()
  (assert (wxlambda-image-viewer:exercise))
  (let* ((frame (make-frame :width 400 :height 300))
         (rgb (make-array 12 :element-type '(unsigned-byte 8) :initial-contents '(255 0 0 0 255 0 0 0 255 1 2 3)))
         (alpha (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(0 64 128 255)))
         (image (make-image :class 'labelled-image :tag :supplied :rgb rgb :alpha alpha))
         (bitmap (make-bitmap :image image))
         (display (make-static-bitmap frame bitmap))
         (scaled nil) (loaded nil) (converted nil) (displayed nil)
         (path (make-pathname :name (format nil "wxlambda-image-~A" (lisp-implementation-type)) :type "png" :defaults #p"/private/tmp/")))
    (unwind-protect
         (progn
           (assert (eq :supplied (image-test-tag image)))
           (let* ((canvas (make-drawing-canvas frame))
                  (rgba (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(255 0 0 0))))
             (setf (canvas-content canvas) (list :background '(255 255 255) :items (list (list :rgba-bitmap 0 0 1 1 rgba))))
             (setf (aref rgba 3) 255)
             (assert (= 0 (aref (sixth (first (getf (canvas-content canvas) :items))) 3)))
             (save-canvas-image canvas path :width 1 :height 1)
             (let ((rendered (make-image :path path)))
               (unwind-protect (assert (equal '(255 255 255 255) (image-pixel rendered 0 0))) (destroy-image rendered)))
             (dolist (bad (list (list :rgba-bitmap 0 0 0 1 rgba) (list :rgba-bitmap 0 0 257 1 rgba)
                               (list :rgba-bitmap 0 0 1 1 (make-array 3 :element-type '(unsigned-byte 8)))))
               (image-test-error (lambda () (setf (canvas-content canvas) (list :background '(0 0 0) :items (list bad)))))))
           (setf (aref rgb 0) 0 (aref alpha 0) 255)
           (assert (equal '(255 0 0 0) (image-pixel image 0 0)))
           (let ((copy (image-rgb image))) (setf (aref copy 0) 12)
             (assert (= 255 (first (image-pixel image 0 0)))))
           (setf (image-pixel image 0 0) '(4 5 6 200))
           (assert (equal '(4 5 6 200) (image-pixel image 0 0)))
           (setf converted (bitmap-image bitmap))
           (assert (= 0 (fourth (image-pixel converted 0 0))))
           (assert (equal '(1 2 3 255) (image-pixel converted 1 1)))
           (setf scaled (scale-image image 32 32 :quality :nearest))
           (assert (equal '(32 32) (image-size scaled)))
           (save-image image path) (setf loaded (make-image :path path))
           (assert (equal '(4 5 6 200) (image-pixel loaded 0 0)))
           (setf (image-alpha image) nil)
           (assert (not (image-alpha-p image)))
           (assert (every (lambda (byte) (= 255 byte)) (image-alpha image)))
           (setf (image-alpha image) (make-array 4 :element-type '(unsigned-byte 8) :initial-element 128))
           (assert (image-alpha-p image))
           (setf (image-rgb image) (make-array 12 :element-type '(unsigned-byte 8) :initial-element 10))
           (assert (equal '(10 10 10 128) (image-pixel image 1 0)))
           (setf displayed (bitmap-value display))
           (destroy-bitmap bitmap) (setf bitmap nil)
           (setf (bitmap-value display) displayed)
           (assert (equal '(2 2) (bitmap-logical-size displayed)))
           (assert (every (lambda (size) (>= size 2)) (bitmap-size displayed)))
           (assert (= 2 (length (bitmap-dip-size displayed))))
           (assert (> (bitmap-scale-factor displayed) 0))
           (show-window frame) (process-events)
           (assert (> (display-count) 0))
           (assert (= 4 (length (display-geometry 0))))
           (assert (= 2 (length (display-ppi 0))))
           (assert (> (display-scale-factor 0) 0))
           (assert (> (window-content-scale-factor display) 0))
           (assert (= 2 (length (window-client-size display))))
           (destructuring-bind (x y) (client-to-screen display 3 4)
             (assert (equal '(3 4) (screen-to-client display x y))))
           (assert (equal '(10 12) (apply #'to-dip display (from-dip display 10 12))))
           (image-test-error (lambda () (make-instance 'mixed-image :width 1 :height 1)))
           (image-test-error (lambda () (make-instance 'failing-image :width 1 :height 1 :parent frame)))
           (assert (not (image-alive-p *failed-image*)))
           (assert (not (bitmap-alive-p *failed-image-bitmap*)))
           (image-test-error (lambda () (bitmap-value *failed-image-control*)))
           (image-test-error (lambda () (make-image :width 0 :height 1)))
           (image-test-error (lambda () (image-pixel image 2 0)))
           (image-test-error (lambda () (setf (image-rgb image) #())))
           (image-test-error (lambda () (display-geometry 2147483647)))
           (format t "PASS images copied channels/pixels, PNG, scale/display, coordinates and CLOS rollback~%"))
      (dolist (value (list image scaled loaded converted)) (when (and value (image-alive-p value)) (destroy-image value)))
      (dolist (value (list bitmap displayed)) (when (and value (bitmap-alive-p value)) (destroy-bitmap value)))
      (when (probe-file path) (delete-file path))
      (destroy-window frame))))
