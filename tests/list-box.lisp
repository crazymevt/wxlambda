(load (merge-pathnames "../examples/list-manager.lisp" *load-truename*))
(defun expect-list-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-list (wxlambda:list-box) ((tag :initarg :tag :reader list-tag))
  (:default-initargs :items '("" "λ" "λ" "日本語 😀") :selection 1 :tag :default))
(defmethod initialize-instance :after ((object named-list) &key)
  (assert (= 4 (wxlambda:item-count object)))
  (assert (= 1 (wxlambda:selection object)))
  (assert (string= "日本語 😀" (wxlambda:item-text object 3))))
(defvar *failed-list-id* nil)
(defclass failing-list (wxlambda:list-box) ())
(defmethod initialize-instance :after ((object failing-list) &key)
  (setf *failed-list-id* (wxlambda::handle object))
  (wxlambda:on-selection object (lambda (event) (declare (ignore event)) (error "Should not run")))
  (error "List initialization failure"))

(wxlambda:with-application ()
  (assert (wxlambda-list-manager:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (items (wxlambda:make-list-box panel :class 'named-list :tag :factory))
         (direct (make-instance 'named-list :parent panel))
         (empty (wxlambda:make-list-box panel))
         (events nil))
    (unwind-protect
         (progn
           (assert (eq :factory (list-tag items))) (assert (eq :default (list-tag direct)))
           (assert (zerop (wxlambda:item-count empty))) (assert (null (wxlambda:selection empty)))
           (let ((saved (wxlambda:item-text items 3)))
             (setf (wxlambda:item-text items 3) "Renamed")
             (assert (string= saved "日本語 😀")))
           (wxlambda:on-selection items (lambda (event) (push event events)))
           (setf (wxlambda:selection items) nil)
           (assert (null (wxlambda:selection items)))
           (setf (wxlambda:selection items :notify t) 1)
           (assert (= 1 (length events)))
           (assert (eq :listbox-selection (wxlambda:event-kind (first events))))
           (assert (string= "λ" (wxlambda:event-text (first events))))
           (assert (wxlambda:event-selection-p (first events)))
           (setf events nil)
           (assert (= 4 (wxlambda:append-item items "Tail")))
           (let ((value (copy-seq "Renamed λ"))) (assert (eq value (setf (wxlambda:item-text items 1) value))))
           (assert (= 1 (wxlambda:selection items)))
           (wxlambda:delete-item items 0)
           (assert (= 0 (wxlambda:selection items)))
           (assert (string= "Renamed λ" (wxlambda:item-text items 0)))
           (wxlambda:delete-item items 2)
           (assert (= 0 (wxlambda:selection items)))
           (wxlambda:delete-item items 0)
           (assert (null (wxlambda:selection items)))
           (wxlambda:clear-items items)
           (assert (null events))
           (assert (zerop (wxlambda:item-count items)))
           (assert (= 0 (wxlambda:append-item items "")))
           (assert (null (wxlambda:selection items)))
           (setf (wxlambda:selection items :notify t) nil)
           (assert (null (wxlambda:event-selection (first events))))
           (assert (string= "" (wxlambda:event-text (first events))))
           (assert (not (wxlambda:event-selection-p (first events))))
           (dolist (index (list -1 1 (ash 1 32) nil))
             (expect-list-error (lambda () (wxlambda:item-text items index)))
             (expect-list-error (lambda () (wxlambda:delete-item items index))))
           (expect-list-error (lambda () (setf (wxlambda:selection items) 1)))
           (expect-list-error (lambda () (setf (wxlambda:selection empty) 0)))
           (dolist (value (list 1 (string (code-char 0))))
             (expect-list-error (lambda () (wxlambda:append-item items value)))
             (expect-list-error (lambda () (setf (wxlambda:item-text items 0) value)))
             (expect-list-error (lambda () (wxlambda:make-list-box panel :items (list value)))))
           (let ((circle (list "circular")))
             (setf (cdr circle) circle)
             (expect-list-error (lambda () (wxlambda:make-list-box panel :items circle))))
           (expect-list-error (lambda () (wxlambda:make-list-box panel :items '("x") :selection 1)))
           (expect-list-error (lambda () (wxlambda:item-count panel)))
           (expect-list-error (lambda () (wxlambda:make-list-box panel :class 'wxlambda:choice)))
           (wxlambda:off-selection items)
           ;; The temporary native event blocker must restore a managed pushed handler.
           (let ((handler (wxlambda:make-event-handler)))
             (wxlambda:push-event-handler items handler)
             (assert (eq handler (wxlambda:window-event-handler items)))
             (wxlambda:append-item items "Stack")
             (setf (wxlambda:item-text items 0) "Updated")
             (wxlambda:delete-item items 1)
             (wxlambda:clear-items items)
             (assert (eq handler (wxlambda:window-event-handler items)))
             (assert (eq handler (wxlambda:pop-event-handler items)))
             (wxlambda:destroy-event-handler handler))
           (wxlambda:append-item items "First") (wxlambda:append-item items "Second")
           ;; Live context writes change payload only; callback edits do not rewrite snapshots.
           (let ((snapshot nil) (clone nil) (saved-context nil)
                 (binding nil))
             (setf binding
                   (wxlambda:bind-event items :listbox-selection
                     (lambda (event context)
                       (setf snapshot event saved-context context clone (wxlambda:clone-event context))
                       (assert (= 0 (wxlambda:event-selection context)))
                       (expect-list-error (lambda () (wxlambda:destroy-window items)) 'wxlambda:native-error)
                       (expect-list-error (lambda () (wxlambda:destroy-window frame)) 'wxlambda:native-error)
                       (expect-list-error (lambda () (wxlambda:close-window frame)) 'wxlambda:native-error)
                       (expect-list-error #'wxlambda:clipboard-text-available-p 'wxlambda:native-error)
                       (setf (wxlambda:event-selection context) 7 (wxlambda:event-text context) "Metadata")
                       (wxlambda:delete-item items 0)
                       (assert (string= "First" (wxlambda:event-text event)))
                       (assert (= 7 (wxlambda:event-selection context))))
                     :with-context t))
             (unwind-protect
                  (progn
                    (setf (wxlambda:selection items :notify t) 0)
                    (assert (null (wxlambda:selection items)))
                    (assert (= 0 (wxlambda:event-selection snapshot)))
                    (assert (eq :listbox-selection (wxlambda:event-kind clone)))
                    (assert (string= "First" (wxlambda:event-text clone)))
                    (assert (not (wxlambda:event-context-active-p saved-context))))
               (wxlambda:unbind-event binding)
               (when clone (wxlambda:destroy-event clone))))
           ;; Double-click synthetic dispatch is metadata, never automatic model mutation.
           (let ((activated nil)
                 (binding nil))
             (setf binding (wxlambda:bind-event items :listbox-double-click
                            (lambda (event) (setf activated event))))
             (unwind-protect
                  (progn
                    (wxlambda:process-event items :listbox-double-click :selection 0 :text "Activation λ")
                    (assert (string= "Activation λ" (wxlambda:event-text activated)))
                    (assert (= 0 (wxlambda:event-selection activated)))
                    (assert (null (wxlambda:selection items))))
               (wxlambda:unbind-event binding)))
           ;; Constructible list commands can also target non-list handlers.
           (let ((handler (wxlambda:make-event-handler)) (seen nil) (binding nil))
             (setf binding (wxlambda:bind-event handler :listbox-selection
                             (lambda (event) (setf seen event))))
             (unwind-protect
                  (progn
                    (wxlambda:process-event handler :listbox-selection :selection 3 :text "Standalone")
                    (assert (= 3 (wxlambda:event-selection seen)))
                    (assert (string= "Standalone" (wxlambda:event-text seen))))
               (wxlambda:unbind-event binding) (wxlambda:destroy-event-handler handler)))
           (let ((event (wxlambda:make-event :kind :listbox-selection :selection 0 :text "Detached λ")))
             (unwind-protect
                  (let ((copy (wxlambda:clone-event event)))
                    (assert (eq :listbox-selection (wxlambda:event-kind copy)))
                    (assert (string= "Detached λ" (wxlambda:event-text copy)))
                    (wxlambda:destroy-event copy))
               (wxlambda:destroy-event event)))
           (wxlambda:on-selection items (lambda (event) (declare (ignore event)) (error "List callback error")))
           (expect-list-error (lambda () (setf (wxlambda:selection items :notify t) 0)))
           (assert (= 0 (wxlambda:selection items)))
           (wxlambda:off-selection items)
           (setf (wxlambda:selection items :notify t) nil)
           (let ((roots (hash-table-count wxlambda::*handlers*)))
             (expect-list-error (lambda () (make-instance 'failing-list :parent panel)))
             (wxlambda:process-events)
             (assert (= roots (hash-table-count wxlambda::*handlers*)))
             (assert (zerop (wxlambda::%handler-alive *failed-list-id*)))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))
    (expect-list-error (lambda () (wxlambda:item-count items)) 'wxlambda:native-error)
    (expect-list-error (lambda () (wxlambda:selection items)) 'wxlambda:native-error)))
(format t "PASS: single-selection list items, events/owned payloads, mutation policy, handler stacks, errors and CLOS rollback~%")
