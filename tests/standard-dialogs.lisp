(load (merge-pathnames "../examples/standard-dialogs.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass named-text-dialog (wxlambda:text-entry-dialog)
  ((tag :initarg :tag :reader dialog-tag))
  (:default-initargs :tag :default :title "Titre λ" :message "Message 日本語" :value "Initial λ"))
(defmethod initialize-instance :after ((dialog named-text-dialog) &key)
  (assert (string= "Initial λ" (wxlambda:dialog-value dialog)))
  (assert (not (wxlambda:dialog-modal-p dialog))))
(defclass named-choice-dialog (wxlambda:single-choice-dialog)
  ((tag :initarg :tag :reader dialog-tag))
  (:default-initargs :tag :choice :items #("First" "日本語") :selection 1))
(defmethod initialize-instance :after ((dialog named-choice-dialog) &key)
  (assert (= 1 (wxlambda:dialog-selection dialog))))
(defvar *failed-dialog* nil)
(defclass failing-text-dialog (wxlambda:text-entry-dialog) ())
(defmethod initialize-instance :after ((dialog failing-text-dialog) &key)
  (setf *failed-dialog* dialog)
  (wxlambda:make-button dialog :label "Rollback child")
  (error "dialog constructor failure"))
(defclass mixed-dialog-frame (wxlambda:text-entry-dialog wxlambda:frame) ())
(defclass mixed-frame-dialog (wxlambda:frame wxlambda:text-entry-dialog) ())
(defclass mixed-dialog-choice (wxlambda:text-entry-dialog wxlambda:single-choice-dialog) ())
(defclass mixed-dialog-event (wxlambda:text-entry-dialog wxlambda:owned-event) ())

(defvar *modal-context* nil)
(defvar *modal-snapshot* nil)
(defun call-with-modal-action (dialog action)
  ;; One-shot application idle is delivered by the modal loop itself.
  (let ((binding nil) (fired nil))
    (unwind-protect
         (progn
           (setf binding (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                           (lambda (snapshot context)
                             (unless fired
                               (setf fired t)
                               (let ((*modal-context* context) (*modal-snapshot* snapshot))
                                 (funcall action)))) :with-context t))
           (wxlambda:wake-up-idle)
           (multiple-value-prog1 (wxlambda:show-modal dialog) (assert fired)))
      (when binding (wxlambda:unbind-event binding)))))

(defun check-dialog-construction ()
  (let* ((parent (wxlambda:make-frame))
         (text (wxlambda:make-text-entry-dialog :parent parent :class 'named-text-dialog :tag :custom))
         (choice (make-instance 'named-choice-dialog :parent parent)))
    (unwind-protect
         (progn
           (assert (eq :custom (dialog-tag text)))
           (assert (eq :choice (dialog-tag choice)))
           (assert (string= "Titre λ" (wxlambda:dialog-title text)))
           (let ((title "Changed 日本語") (value "Text λ"))
             (assert (eq title (setf (wxlambda:dialog-title text) title)))
             (assert (eq value (setf (wxlambda:dialog-value text) value)))
             (assert (string= title (wxlambda:dialog-title text)))
             (assert (string= value (wxlambda:dialog-value text))))
           (assert (string= "" (wxlambda:dialog-selection-text choice)))
           (assert (zerop (setf (wxlambda:dialog-selection choice) 0)))
           (assert (string= "" (wxlambda:dialog-selection-text choice)))
           (dolist (index '(nil -1 2 1/2 "0"))
             (expect-error (lambda () (setf (wxlambda:dialog-selection choice) index))))
           (dolist (string (list 3 (string #\Null)))
             (expect-error (lambda () (setf (wxlambda:dialog-value text) string)))
             (expect-error (lambda () (setf (wxlambda:dialog-title text) string))))
           (expect-error (lambda () (wxlambda:dialog-value choice)))
           (expect-error (lambda () (wxlambda:dialog-selection text)))
           (expect-error (lambda () (wxlambda:end-modal text :ok)))
           (expect-error (lambda () (wxlambda:show-window text)))
           (expect-error (lambda () (setf (wxlambda:shown-p text) t)))
           (dolist (class '(mixed-dialog-frame mixed-frame-dialog mixed-dialog-choice mixed-dialog-event))
             (let ((object (allocate-instance (find-class class))))
               (expect-error (lambda () (initialize-instance object :parent parent :items '("a"))))
               (assert (not (slot-boundp object 'wxlambda::handle)))))
           (dolist (class '(wxlambda:dialog wxlambda:frame wxlambda:single-choice-dialog))
             (expect-error (lambda () (wxlambda:make-text-entry-dialog :class class))))
           (dolist (items (list nil #() '("a" 1) "abc" (list (string #\Null))))
             (expect-error (lambda () (wxlambda:make-single-choice-dialog :items items))))
           (expect-error (lambda () (wxlambda:make-single-choice-dialog :items '("a") :selection nil)))
           (expect-error (lambda () (wxlambda:make-text-entry-dialog :parent (wxlambda:make-event :kind :close)))))
      (wxlambda:destroy-window parent) (wxlambda:process-events))
    (expect-error (lambda () (wxlambda:dialog-value text)))
    (expect-error (lambda () (wxlambda:show-modal choice))))
  (expect-error (lambda () (wxlambda:make-text-entry-dialog :class 'failing-text-dialog)))
  (expect-error (lambda () (wxlambda:dialog-value *failed-dialog*))))

(defun check-dialog-modal-boundaries ()
  (let* ((parent (wxlambda:make-frame))
         (text (wxlambda:make-text-entry-dialog :parent parent :value "Cached λ"))
         (choice (wxlambda:make-single-choice-dialog :parent parent :items '("One" "Deux λ") :selection 1)))
    (unwind-protect
         (progn
           (dolist (result '(:ok :cancel))
             (assert (eq result
                         (call-with-modal-action text
                           (lambda ()
                             (assert (wxlambda:dialog-modal-p text))
                             (expect-error (lambda () (wxlambda:show-modal choice)))
                             (expect-error (lambda () (wxlambda:destroy-window parent)))
                             (expect-error (lambda () (wxlambda:close-window parent)))
                             (expect-error (lambda () (wxlambda:destroy-window text)))
                             (expect-error (lambda () (wxlambda:end-modal text :invalid)))
                             (assert (eq text (wxlambda:end-modal text result)))
                             ;; Still owned by the SHOW-MODAL call until it returns.
                             (expect-error (lambda () (wxlambda:destroy-window text)))))))
             (assert (not (wxlambda:dialog-modal-p text)))
             (expect-error (lambda () (wxlambda:end-modal text result))))
           (assert (eq :cancel (call-with-modal-action choice (lambda () (wxlambda:end-modal choice :cancel)))))
           (assert (= 1 (wxlambda:dialog-selection choice)))
           (assert (string= "" (wxlambda:dialog-selection-text choice)))
           (let* ((control (wxlambda:make-text parent))
                  (primary (make-condition 'simple-error :format-control "nested notifier failure"))
                  (nested-context nil)
                  (binding (wxlambda:bind-event control :text-change
                             (lambda (snapshot context)
                               (declare (ignore snapshot))
                               (setf nested-context context)
                               (error primary)) :with-context t)))
             (unwind-protect
                  (assert (eq :cancel
                              (call-with-modal-action text
                                (lambda ()
                                  (assert (eq primary (handler-case
                                                          (setf (wxlambda:text control :notify t) "Notify λ")
                                                        (error (condition) condition))))
                                  (assert (wxlambda:dialog-modal-p text))
                                  (assert (eq :idle (wxlambda:event-kind *modal-context*)))
                                  (expect-error (lambda () (wxlambda:event-id nested-context)))
                                  (wxlambda:end-modal text :cancel)))))
               (wxlambda:unbind-event binding)))
           (let ((primary (make-condition 'simple-error :format-control "modal callback failure")))
             (assert (eq primary
                         (handler-case
                             (call-with-modal-action text (lambda () (error primary)))
                           (error (condition) condition))))
             (assert (not (wxlambda:dialog-modal-p text)))
             (assert (eq :cancel (call-with-modal-action text (lambda () (wxlambda:end-modal text :cancel)))))))
      (wxlambda:destroy-window parent) (wxlambda:process-events))))

(defun check-dialog-menu-callback ()
  (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label "Dialogs"))
         (item (wxlambda:make-menu-item menu :id 32201 :label "Open"))
         (dialog (wxlambda:make-text-entry-dialog :parent frame))
         (data (list :retained)) (outer nil) (inner nil) (binding nil) (calls 0) (running nil))
    (unwind-protect
         (progn
           (setf binding (wxlambda:bind-event frame :menu
                           (lambda (snapshot context)
                             (declare (ignore snapshot))
                             (setf outer context)
                             (assert (eq data (wxlambda:event-user-data context)))
                             (let ((primary (make-condition 'simple-error :format-control "Handled modal failure")))
                               (assert (eq primary (handler-case
                                                       (call-with-modal-action dialog (lambda () (error primary)))
                                                     (error (condition) condition)))))
                             (assert (eq :cancel
                                         (call-with-modal-action dialog
                                           (lambda ()
                                             (expect-error (lambda () (wxlambda:event-id outer)))
                                             (setf inner *modal-context*)
                                             #+sbcl (sb-ext:gc :full t)
                                             #+ccl (ccl:gc)
                                             (assert (eq :idle (wxlambda:event-kind inner)))
                                             (assert (null (wxlambda:event-user-data inner)))
                                             (expect-error (lambda () (wxlambda:event-user-data context)))
                                             (wxlambda:end-modal dialog :cancel)))))
                             (assert (= 32201 (wxlambda:event-id context)))
                             (assert (eq data (wxlambda:event-user-data context)))
                             (incf calls)
                             (when running (wxlambda:stop))) :id 32201 :with-context t :user-data data))
           (assert (wxlambda:activate-menu-item item))
           (assert (= 1 calls))
           (setf running t)
           (wxlambda:show-window frame)
           (wxlambda:queue-event frame :menu :id 32201)
           (wxlambda:run)
           (assert (= 2 calls))
           (expect-error (lambda () (wxlambda:event-kind inner)))
           (expect-error (lambda () (wxlambda:event-id outer))))
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun check-dialog-pending-parent-destruction ()
  (dolist (from-callback '(nil t))
    (let* ((parent (wxlambda:make-frame))
           (dialog (wxlambda:make-text-entry-dialog :parent parent))
           (binding nil) (called nil))
      (unwind-protect
           (progn
             (if from-callback
                 (progn
                   (setf binding
                         (wxlambda:bind-event parent :menu
                           (lambda (snapshot context)
                             (declare (ignore snapshot context))
                             (setf called t)
                             (wxlambda:destroy-window parent)) :with-context t))
                   (wxlambda:process-event parent :menu :id 32301)
                   (assert called))
                 (wxlambda:destroy-window parent))
             ;; No idle auto-close is installed: this must reject before entering
             ;; ShowModal, even while native deletion is only scheduled.
             (assert (not (wxlambda:handler-alive-p parent)))
             (assert (not (wxlambda:handler-alive-p dialog)))
             (expect-error (lambda () (wxlambda:show-modal dialog)) 'wxlambda:native-error)
             (wxlambda:process-events)
             (assert (not (wxlambda:handler-alive-p parent)))
             (assert (not (wxlambda:handler-alive-p dialog))))
        (when binding (ignore-errors (wxlambda:unbind-event binding)))
        (wxlambda:process-events)))))

(expect-error (lambda () (make-instance 'wxlambda:dialog)))
(let (expired)
  (wxlambda:with-application ()
    (assert (wxlambda-standard-dialogs:exercise))
    (check-dialog-construction)
    (check-dialog-modal-boundaries)
    (check-dialog-menu-callback)
    (check-dialog-pending-parent-destruction)
    (setf expired (wxlambda:make-text-entry-dialog :value "Session owned")))
  (expect-error (lambda () (wxlambda:dialog-value expired)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:show-modal expired)) 'wxlambda:native-error))
(format t "PASS: native-backed standard dialogs, modal callback boundaries, validation and owned lifetime~%")
