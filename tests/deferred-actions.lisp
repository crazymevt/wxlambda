(load (merge-pathnames "../examples/deferred-actions.lisp" *load-truename*))
(defun deferred-expect-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defun drain-ui (ticket)
  (loop repeat 40 while (wxlambda:ui-action-pending-p ticket) do (wxlambda:process-events))
  (assert (not (wxlambda:ui-action-pending-p ticket))))
(defun check-deferred-normal ()
  (assert (wxlambda-deferred-actions:exercise))
  (let* ((frame (wxlambda:make-frame :accelerators '((:f1 32201))))
         (child (wxlambda:make-panel frame))
         (order nil) (nested nil) (captured-context nil) (ticket nil))
    (wxlambda:bind-event frame :menu
      (lambda (event context)
        (declare (ignore event)) (setf captured-context context)
        (setf ticket (wxlambda:defer-ui-action
                       (lambda ()
                         (assert (not (wxlambda:ui-action-pending-p ticket)))
                         (assert (not (wxlambda:cancel-ui-action ticket)))
                         (deferred-expect-error (lambda () (wxlambda:event-id captured-context)) 'wxlambda:native-error)
                         (dolist (function (list #'wxlambda:process-events #'wxlambda:process-pending-events #'wxlambda:run))
                           (deferred-expect-error function 'wxlambda:native-error))
                         (push :first order)
                         (setf nested (wxlambda:defer-ui-action (lambda () (push :third order)) :owner frame)))
                       :owner frame))) :id 32201 :with-context t)
    (wxlambda:process-event frame :menu :id 32201)
    (assert (null order))
    (assert (wxlambda:ui-action-p ticket))
    (let* ((canceled (wxlambda:defer-ui-action (lambda () (error "Canceled action ran")) :owner frame))
           (second (wxlambda:defer-ui-action (lambda () (push :second order)))))
      (assert (wxlambda:cancel-ui-action canceled))
      (assert (not (wxlambda:cancel-ui-action canceled)))
      (assert (not (wxlambda:ui-action-pending-p canceled)))
      (wxlambda:process-pending-events) (assert (null order))
      (drain-ui second) (drain-ui nested)
      (assert (equal '(:first :second :third) (reverse order))))
    ;; Owner/ancestor pending destruction cancels delivery and eventually releases roots.
    (let ((drop (wxlambda:defer-ui-action (lambda () (error "Dead owner action ran")) :owner child)))
      (wxlambda:destroy-window child)
      (assert (not (wxlambda:ui-action-pending-p drop)))
      (assert (not (gethash (wxlambda::ui-action-token drop) wxlambda::*ui-actions*))))
    ;; A real modal inside an action cannot reenter the action queue through idle.
    (let ((message (wxlambda:make-message-dialog :parent frame :message "Deferred modal" :buttons :ok-cancel))
          (file (wxlambda:make-file-dialog :parent frame))
          (binding nil) (first-active nil) (modal-seen 0) (following nil))
      (unwind-protect
           (progn
             (setf binding (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                             (lambda (event) (declare (ignore event))
                               (when (or (wxlambda:dialog-modal-p message) (wxlambda:dialog-modal-p file))
                                 (assert first-active) (assert (not following))
                                 (incf modal-seen)
                                 (wxlambda:end-modal (if (wxlambda:dialog-modal-p message) message file) :cancel)))))
             (let ((action (wxlambda:defer-ui-action
                             (lambda ()
                               (setf first-active t)
                               (assert (eq :cancel (wxlambda:show-modal message)))
                               (assert (eq :cancel (wxlambda:show-modal file)))
                               (assert (typep (wxlambda:clipboard-text-available-p) 'boolean))
                               ;; Structural operations are safe here even under the poll driver.
                               (let* ((bar (wxlambda:make-toolbar frame))
                                      (status (wxlambda:make-status-bar frame))
                                      (book (wxlambda:make-notebook frame))
                                      (page (wxlambda:make-panel book)))
                                 (wxlambda:add-toolbar-tool bar 1 "Deferred") (wxlambda:realize-toolbar bar)
                                 (wxlambda:add-notebook-page book page :label "Page")
                                 (wxlambda:destroy-window book) (wxlambda:destroy-window bar) (wxlambda:destroy-window status))
                               (setf first-active nil)) :owner frame)))
               (let ((next (wxlambda:defer-ui-action (lambda () (assert (not first-active)) (setf following t)) :owner frame)))
                 (drain-ui action) (drain-ui next)))
             (assert following) (assert (>= modal-seen 2)))
        (when binding (wxlambda:unbind-event binding))
        (wxlambda:destroy-window message) (wxlambda:destroy-window file)))
    ;; Native callback errors during an action's notifying operation can be handled locally.
    (let ((button (wxlambda:make-button frame)))
      (wxlambda:on-click button (lambda () (error "Contained nested callback")))
      (let ((action (wxlambda:defer-ui-action
                      (lambda ()
                        (deferred-expect-error (lambda () (wxlambda:process-event button :click)))
                        (setf (wxlambda:frame-title frame) "Recovered action")))))
        (drain-ui action)
        (assert (string= "Recovered action" (wxlambda:frame-title frame)))))
    ;; The action phase is also available under the blocking RUN driver.
    (wxlambda:show-window frame)
    (let ((run-action (wxlambda:defer-ui-action
                        (lambda ()
                          (let ((bar (wxlambda:make-toolbar frame)))
                            (wxlambda:add-toolbar-tool bar 2 "Run") (wxlambda:realize-toolbar bar)
                            (wxlambda:destroy-window bar))
                          (wxlambda:stop)) :owner frame)))
      (wxlambda:run) (assert (not (wxlambda:ui-action-pending-p run-action))))
    (wxlambda:destroy-window frame) (wxlambda:process-events)))
(defun check-deferred-error (run-p)
  (let* ((frame (wxlambda:make-frame))
         (failure (make-condition 'simple-error :format-control "Deferred expected failure"))
         (seen nil) (later nil)
         (first (wxlambda:defer-ui-action (lambda () (error failure)) :owner frame))
         (second (wxlambda:defer-ui-action (lambda () (setf later t)) :owner frame)))
    (wxlambda:show-window frame)
    (handler-case (if run-p (wxlambda:run) (wxlambda:process-events)) (error (condition) (setf seen condition)))
    (assert (eq failure seen)) (assert (not later))
    (assert (not (wxlambda:ui-action-pending-p first)))
    (assert (wxlambda:ui-action-pending-p second))
    (drain-ui second) (assert later)
    (wxlambda:destroy-window frame) (wxlambda:process-events)))
(deferred-expect-error (lambda () (wxlambda:defer-ui-action (lambda () nil))) 'wxlambda:native-error)
(let ((mode (or (uiop:getenv "WXLAMBDA_UI_ACTION_TEST_MODE") "normal"))
      (roots nil) (orphan nil) (ran-after-exit nil))
  (wxlambda:with-application ()
    (deferred-expect-error (lambda () (wxlambda:defer-ui-action 42)))
    (deferred-expect-error (lambda () (wxlambda:defer-ui-action (lambda () nil) :owner (wxlambda:current-application-handler))))
    (cond ((string= mode "normal") (check-deferred-normal))
          ((string= mode "error-pump") (check-deferred-error nil))
          ((string= mode "error-run") (check-deferred-error t))
          ((string= mode "nonlocal")
           (let* ((frame (wxlambda:make-frame))
                  (ticket (wxlambda:defer-ui-action (lambda () (throw 'outside :escaped)) :owner frame)))
             (assert (eq :contained
                         (catch 'outside (deferred-expect-error #'wxlambda:process-events) :contained)))
             (assert (not (wxlambda:ui-action-pending-p ticket)))
             (wxlambda:destroy-window frame) (wxlambda:process-events)))
          (t (error "Unknown deferred-action test mode")))
    ;; Finish discards the queue before toolkit cleanup, then clears Lisp roots.
    (setf roots wxlambda::*ui-actions*
          orphan (wxlambda:defer-ui-action (lambda () (setf ran-after-exit t)))))
  (assert (not ran-after-exit)) (assert (zerop (hash-table-count roots)))
  (deferred-expect-error (lambda () (wxlambda:ui-action-pending-p orphan)) 'wxlambda:native-error)
  (deferred-expect-error (lambda () (wxlambda:cancel-ui-action orphan)) 'wxlambda:native-error))
(format t "PASS: deferred UI actions, safe modal/clipboard/structural boundary, FIFO/cancel/owner/error/shutdown lifecycle~%")
