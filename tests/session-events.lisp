(load (merge-pathnames "../examples/session-events.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(let (saved expired outer plain)
  (wxlambda:with-application ()
    (wxlambda-session-events:exercise)
    (let ((receiver (wxlambda:make-event-handler))
          (app (wxlambda:current-application-handler))
          (frame (wxlambda:make-frame)))
      (dolist (kind '(:query-end-session :end-session))
        (assert (plusp (wxlambda:event-type kind)))
        (expect-error (lambda () (wxlambda:register-event-type kind)))
        ;; Guard both entry points before any live application/default handling.
        (dolist (source (list app frame))
          (expect-error (lambda () (wxlambda:process-event source kind)) 'wxlambda:native-error)
          (expect-error (lambda () (wxlambda:queue-event source kind)) 'wxlambda:native-error))
        (expect-error (lambda () (wxlambda:bind-event frame kind #'identity)) 'wxlambda:native-error)
        ;; Native application bindings can be installed and removed without emission.
        (let ((binding (wxlambda:bind-event app kind (lambda (e) (declare (ignore e))))))
          (assert (wxlambda:binding-active-p binding))
          (assert (wxlambda:unbind-event binding)))
        ;; No matching handler and skipped observers must not reach wxApp defaults.
        (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event receiver kind))))
        (let* ((calls 0)
              (binding (wxlambda:bind-event receiver kind
                         (lambda (e) (setf saved e) (incf calls)))))
          (assert (equal '(nil nil) (multiple-value-list
                     (wxlambda:process-event receiver kind :logging-off-p t))))
          (assert (= calls 1))
          (assert (eq :close (wxlambda:event-family saved)))
          (assert (wxlambda:event-logging-off-p saved))
          (assert (= (wxlambda:event-type kind) (wxlambda:event-native-type saved)))
          (wxlambda:queue-event receiver kind :logging-off-p nil :can-veto-p nil)
          (wxlambda:process-pending-events)
          (assert (= calls 2))
          (assert (not (wxlambda:event-logging-off-p saved)))
          (assert (not (wxlambda:event-can-veto-p saved)))
          (unwind-protect
               (progn (setf (wxlambda:handler-enabled-p receiver) nil)
                      (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event receiver kind)))))
            (setf (wxlambda:handler-enabled-p receiver) t))
          (wxlambda:unbind-event binding)))
      (let* ((inner (wxlambda:bind-event receiver :end-session
                      (lambda (e c)
                        (declare (ignore e))
                        (expect-error (lambda () (wxlambda:event-logging-off-p outer)) 'wxlambda:native-error)
                        (setf (wxlambda:event-logging-off-p c) nil)) :with-context t))
             (binding (wxlambda:bind-event receiver :query-end-session
                        (lambda (e c)
                          (setf saved e expired c outer c)
                          (assert (not (wxlambda:event-logging-off-p c)))
                          (assert (eq :yes (setf (wxlambda:event-logging-off-p c) :yes)))
                          (assert (wxlambda:event-logging-off-p c))
                          (assert (not (wxlambda:event-logging-off-p e)))
                          (wxlambda:process-event receiver :end-session :can-veto-p nil)
                          (assert (wxlambda:event-logging-off-p c))
                          (if (wxlambda:event-can-veto-p c)
                              (setf (wxlambda:event-vetoed-p c) t)
                              (expect-error (lambda () (setf (wxlambda:event-vetoed-p c) nil)) 'wxlambda:native-error))) :with-context t)))
        (assert (equal '(t t) (multiple-value-list (wxlambda:process-event receiver :query-end-session))))
        (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event receiver :query-end-session :can-veto-p nil))))
        (expect-error (lambda () (wxlambda:event-logging-off-p expired)) 'wxlambda:native-error)
        (expect-error (lambda () (setf (wxlambda:event-logging-off-p expired) t)) 'wxlambda:native-error)
        (expect-error (lambda () (setf (wxlambda:event-logging-off-p saved) t)))
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      (let ((binding (wxlambda:bind-event receiver :close
                       (lambda (e c)
                         (setf plain e)
                         (expect-error (lambda () (wxlambda:event-logging-off-p c)) 'wxlambda:native-error)
                         (expect-error (lambda () (setf (wxlambda:event-logging-off-p c) t)) 'wxlambda:native-error)) :with-context t)))
        (wxlambda:process-event receiver :close)
        (expect-error (lambda () (wxlambda:event-logging-off-p plain)))
        (wxlambda:unbind-event binding))
      (expect-error (lambda () (wxlambda:process-event receiver :close :logging-off-p nil)))
      (expect-error (lambda () (wxlambda:process-event receiver :end-session :text "bad")))
      (wxlambda:destroy-event-handler receiver)
      (wxlambda:destroy-window frame)))
  (assert (not (wxlambda:event-logging-off-p saved)))
  (expect-error (lambda () (wxlambda:event-logging-off-p expired)) 'wxlambda:native-error))
(format t "PASS: session snapshots, scoped logging-off/veto, isolated synthetic routing and native application bindings~%")
