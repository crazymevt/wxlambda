(load (merge-pathnames "../examples/window-handler-stacks.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass named-stack-handler (wxlambda:event-handler)
  ((name :initarg :name :reader stack-name)) (:default-initargs :name "default stack node"))
(defvar *failed-stack-handler-id*)
(defclass failing-pushed-handler (wxlambda:event-handler) ((owner :initarg :owner)))
(defmethod initialize-instance :after ((handler failing-pushed-handler) &key)
  (setf *failed-stack-handler-id* (wxlambda::handle handler))
  (wxlambda:push-event-handler (slot-value handler 'owner) handler)
  (error "pushed handler initialization failed"))
(defvar *failed-stack-window-id*)
(defclass failing-stack-frame (wxlambda:frame) ((pushed :initarg :pushed)))
(defmethod initialize-instance :after ((window failing-stack-frame) &key)
  (setf *failed-stack-window-id* (wxlambda::handle window))
  (wxlambda:push-event-handler window (slot-value window 'pushed))
  (error "stack window initialization failed"))

(defun check-stack-lifo-and-removal ()
  (let* ((window (wxlambda:make-frame)) (other (wxlambda:make-frame))
         (a (wxlambda:make-event-handler :class 'named-stack-handler :name "bottom"))
         (b (wxlambda:make-event-handler)) (c (wxlambda:make-event-handler))
         (free (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (assert (eq window (wxlambda:window-event-handler window)))
           (expect-error (lambda () (wxlambda:pop-event-handler window)) 'wxlambda:native-error)
           (assert (eq a (wxlambda:push-event-handler window a)))
           (assert (eq a (wxlambda:window-event-handler window)))
           (assert (string= "bottom" (stack-name (wxlambda:window-event-handler window))))
           (wxlambda:push-event-handler window b)
           (wxlambda:push-event-handler window c)
           (assert (eq c (wxlambda:window-event-handler window)))
           (assert (not (wxlambda:handler-unlinked-p a)))
           (dolist (node (list a b c))
             (expect-error (lambda () (wxlambda:next-handler node)) 'wxlambda:native-error)
             (expect-error (lambda () (wxlambda:previous-handler node)) 'wxlambda:native-error)
             (expect-error (lambda () (wxlambda:unlink-event-handler node)) 'wxlambda:native-error)
             (expect-error (lambda () (setf (wxlambda:next-handler node) nil)) 'wxlambda:native-error)
             (expect-error (lambda () (setf (wxlambda:previous-handler node) nil)) 'wxlambda:native-error))
           (assert (not (wxlambda:remove-event-handler window free)))
           (assert (not (wxlambda:remove-event-handler other b)))
           (assert (eq c (wxlambda:window-event-handler window)))
           (assert (wxlambda:remove-event-handler window b))
           (assert (wxlambda:handler-unlinked-p b))
           (assert (eq c (wxlambda:window-event-handler window)))
           (assert (not (wxlambda:remove-event-handler window b)))
           (assert (eq c (wxlambda:pop-event-handler window)))
           (assert (wxlambda:handler-alive-p c))
           (assert (wxlambda:handler-unlinked-p c))
           (assert (eq a (wxlambda:window-event-handler window)))
           (wxlambda:push-event-handler window b)
           (assert (wxlambda:remove-event-handler window a)) ; bottom removal
           (assert (wxlambda:handler-unlinked-p a))
           (assert (eq b (wxlambda:window-event-handler window)))
           (assert (null (wxlambda:pop-event-handler window :delete t)))
           (assert (not (wxlambda:handler-alive-p b)))
           (expect-error (lambda () (wxlambda:remove-event-handler window b)) 'wxlambda:native-error)
           (assert (eq window (wxlambda:window-event-handler window)))
           ;; Explicit attached destruction safely removes a middle and a head.
           (wxlambda:push-event-handler window a)
           (wxlambda:push-event-handler window c)
           (assert (wxlambda:remove-event-handler window c)) ; head removal
           (assert (wxlambda:handler-unlinked-p c))
           (assert (eq a (wxlambda:window-event-handler window)))
           (wxlambda:push-event-handler window c)
           (wxlambda:destroy-event-handler a)
           (assert (eq c (wxlambda:window-event-handler window)))
           (wxlambda:destroy-event-handler c)
           (assert (eq window (wxlambda:window-event-handler window))))
      (dolist (node (list free c b a))
        (when (wxlambda:handler-alive-p node) (wxlambda:destroy-event-handler node)))
      (wxlambda:destroy-window other) (wxlambda:destroy-window window))))

(defun check-stack-preflight-policy ()
  (let* ((window (wxlambda:make-frame)) (other (wxlambda:make-frame))
         (app (wxlambda:current-application-handler)) (event (wxlambda:make-event))
         (a (wxlambda:make-event-handler)) (b (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (dolist (invalid (list window other app event 17))
             (expect-error (lambda () (wxlambda:push-event-handler window invalid)))
             (assert (eq window (wxlambda:window-event-handler window))))
           (dolist (invalid (list a app event 17))
             (expect-error (lambda () (wxlambda:window-event-handler invalid)))
             (expect-error (lambda () (wxlambda:push-event-handler invalid b)))
             (expect-error (lambda () (wxlambda:pop-event-handler invalid))))
           (setf (wxlambda:next-handler a) b)
           (expect-error (lambda () (wxlambda:push-event-handler window a)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:push-event-handler window b)) 'wxlambda:native-error)
           (wxlambda:unlink-event-handler a)
           (wxlambda:push-event-handler window a)
           (expect-error (lambda () (wxlambda:push-event-handler window a)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:push-event-handler other a)) 'wxlambda:native-error)
           (assert (eq a (wxlambda:window-event-handler window)))
           (assert (eq other (wxlambda:window-event-handler other)))
           (expect-error (lambda () (wxlambda:remove-event-handler window app)))
           (expect-error (lambda () (wxlambda:remove-event-handler window window)))
           (wxlambda:destroy-event-handler b)
           (expect-error (lambda () (wxlambda:push-event-handler window b)) 'wxlambda:native-error))
      (dolist (node (list b a))
        (when (wxlambda:handler-alive-p node) (wxlambda:destroy-event-handler node)))
      (wxlambda:destroy-event event) (wxlambda:destroy-window other) (wxlambda:destroy-window window))))

(defun check-explicit-window-routing ()
  (let* ((frame (wxlambda:make-frame)) (window (wxlambda:make-panel frame))
         (a (wxlambda:make-event-handler)) (b (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :stack-test-message :text "original"))
         (a-calls 0) (b-calls 0) (window-calls 0) (parent-calls 0) (consume nil)
         (a-binding (wxlambda:bind-event a :stack-test-message
                      (lambda (event context)
                        (incf a-calls)
                        (assert (eq a (wxlambda:event-source event)))
                        (assert (= (wxlambda::handle window) (wxlambda:event-origin-id event)))
                        (expect-error (lambda () (wxlambda:process-window-event window event)))
                        (expect-error (lambda () (wxlambda:process-window-event-locally window context)))
                        (setf (wxlambda:event-text context) "dispatch copy"
                              (wxlambda:event-skipped-p context) (not consume))) :with-context t))
         (b-binding (wxlambda:bind-event b :stack-test-message
                      (lambda (event)
                        (incf b-calls)
                        (assert (eq b (wxlambda:event-source event)))
                        (assert (= (wxlambda::handle window) (wxlambda:event-origin-id event))))))
         (window-binding (wxlambda:bind-event window :stack-test-message
                           (lambda (event) (declare (ignore event)) (incf window-calls))))
         (parent-binding (wxlambda:bind-event frame :stack-test-message
                           (lambda (event) (declare (ignore event)) (incf parent-calls)))))
    (wxlambda:push-event-handler window b) (wxlambda:push-event-handler window a)
    (unwind-protect
         (progn
           (wxlambda:process-event window source)
           (assert (equal '(0 0 1 1) (list a-calls b-calls window-calls parent-calls)))
           (wxlambda:process-event-locally window source)
           (assert (equal '(0 0 2 1) (list a-calls b-calls window-calls parent-calls)))
           (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-window-event window source))))
           (assert (equal '(1 1 3 2) (list a-calls b-calls window-calls parent-calls)))
           (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-window-event-locally window source))))
           (assert (equal '(2 2 4 2) (list a-calls b-calls window-calls parent-calls)))
           (setf consume t)
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-window-event window source))))
           (assert (equal '(3 2 4 2) (list a-calls b-calls window-calls parent-calls)))
           (assert (string= "original" (wxlambda:event-text source)))
           (setf consume nil (wxlambda:handler-enabled-p a) nil)
           (wxlambda:process-window-event window source)
           (assert (equal '(3 3 5 3) (list a-calls b-calls window-calls parent-calls)))
           (wxlambda:queue-event window source)
           (wxlambda:process-pending-events)
           (assert (equal '(3 3 6 4) (list a-calls b-calls window-calls parent-calls))))
      (wxlambda:unbind-event a-binding) (wxlambda:unbind-event b-binding)
      (wxlambda:unbind-event window-binding) (wxlambda:unbind-event parent-binding)
      (wxlambda:destroy-event source) (wxlambda:destroy-event-handler a)
      (wxlambda:destroy-event-handler b) (wxlambda:destroy-window frame))))

(defun check-stack-callback-and-run-guards ()
  (let* ((window (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (free (wxlambda:make-event-handler)) (calls 0)
         (binding (wxlambda:bind-event handler :stack-test-message
                    (lambda (event context)
                      (declare (ignore event context))
                      (assert (eq handler (wxlambda:window-event-handler window)))
                      (dolist (operation (list (lambda () (wxlambda:push-event-handler window free))
                                               (lambda () (wxlambda:pop-event-handler window))
                                               (lambda () (wxlambda:pop-event-handler window :delete t))
                                               (lambda () (wxlambda:remove-event-handler window handler))
                                               (lambda () (wxlambda:destroy-event-handler handler))))
                        (expect-error operation 'wxlambda:native-error)
                        (assert (eq handler (wxlambda:window-event-handler window)))
                        (assert (wxlambda:handler-unlinked-p free)))
                      (incf calls)
                      (when (wxlambda:main-loop-running-p)
                        (if (= calls 3) (wxlambda:stop)
                            (wxlambda:queue-event handler :stack-test-message)))) :with-context t)))
    (wxlambda:push-event-handler window handler)
    (unwind-protect
         (progn
           (let ((source (wxlambda:make-event :kind :stack-test-message)))
             (unwind-protect (wxlambda:process-window-event window source)
               (wxlambda:destroy-event source)))
           (assert (= 1 calls))
           (wxlambda:show-window window)
           (wxlambda:queue-event handler :stack-test-message)
           (wxlambda:run)
           (assert (= 3 calls)))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler free) (wxlambda:destroy-event-handler handler)
      (wxlambda:destroy-window window))))

(defun check-all-window-destructors-detach ()
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (windows (list frame panel (wxlambda:make-button panel) (wxlambda:make-text panel)
                        (wxlambda:make-label panel) (wxlambda:make-checkbox panel)
                        (wxlambda:make-choice panel :items '("One")) (wxlambda:make-gauge panel)))
         (handlers (loop repeat (length windows) collect (wxlambda:make-event-handler))))
    (loop for window in windows for handler in handlers
          do (wxlambda:push-event-handler window handler)
             (setf (wxlambda:handler-enabled-p window) nil))
    (wxlambda:destroy-window frame)
    (wxlambda:process-events)
    (loop for window in windows for handler in handlers
          do (assert (not (wxlambda:handler-alive-p window)))
             (assert (wxlambda:handler-alive-p handler))
             (assert (wxlambda:handler-unlinked-p handler))
             (assert (null (wxlambda:next-handler handler)))
             (assert (null (wxlambda:previous-handler handler)))
             (expect-error (lambda () (wxlambda:window-event-handler window)) 'wxlambda:native-error)
             (wxlambda:destroy-event-handler handler))))

(defun check-pushed-session-rejection ()
  (let ((window (wxlambda:make-frame)) (handler (wxlambda:make-event-handler)))
    (unwind-protect
         (dolist (kind '(:query-end-session :end-session))
           (let ((binding (wxlambda:bind-event handler kind (lambda (event) (declare (ignore event))))))
             (expect-error (lambda () (wxlambda:push-event-handler window handler)) 'wxlambda:native-error)
             (assert (eq window (wxlambda:window-event-handler window)))
             (wxlambda:unbind-event binding))
           (let ((source (wxlambda:make-event :kind kind)))
             (unwind-protect
                  (progn
                    (wxlambda:queue-event handler source)
                    (wxlambda:post-event handler source)
                    (let ((moved (wxlambda:clone-event source)))
                      (wxlambda:transfer-event handler moved)
                      (assert (not (wxlambda:event-alive-p moved))))
                    (expect-error (lambda () (wxlambda:push-event-handler window handler)) 'wxlambda:native-error)
                    (wxlambda:process-pending-events)
                    (wxlambda:push-event-handler window handler)
                    (expect-error (lambda () (wxlambda:bind-event handler kind #'identity)) 'wxlambda:native-error)
                    (dolist (operation (list #'wxlambda:queue-event #'wxlambda:post-event
                                             #'wxlambda:transfer-event #'wxlambda:process-event
                                             #'wxlambda:process-event-locally))
                      (expect-error (lambda () (funcall operation handler source)) 'wxlambda:native-error)
                      (assert (wxlambda:event-alive-p source)))
                    (expect-error (lambda () (wxlambda:process-event handler kind)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:queue-event handler kind)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:process-window-event window source)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:process-window-event-locally window source)) 'wxlambda:native-error)
                    (assert (eq handler (wxlambda:pop-event-handler window)))
                    (wxlambda:queue-event handler source)
                    (expect-error (lambda () (wxlambda:push-event-handler window handler)) 'wxlambda:native-error)
                    (wxlambda:delete-pending-events handler)
                    (wxlambda:push-event-handler window handler)
                    (assert (eq handler (wxlambda:pop-event-handler window))))
               (wxlambda:destroy-event source))))
      (when (not (eq window (wxlambda:window-event-handler window)))
        (wxlambda:pop-event-handler window))
      (wxlambda:destroy-event-handler handler) (wxlambda:destroy-window window))))

(defun check-popped-handler-keeps-pending-events ()
  (let* ((window (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :stack-test-message :text "survives pop"))
         (captured nil)
         (binding (wxlambda:bind-event handler :stack-test-message (lambda (event) (setf captured event)))))
    (unwind-protect
         (progn
           (wxlambda:push-event-handler window handler)
           (wxlambda:queue-event handler source)
           (assert (eq handler (wxlambda:pop-event-handler window)))
           (assert (wxlambda:handler-unlinked-p handler))
           (wxlambda:process-pending-events)
           (assert captured)
           (assert (string= "survives pop" (wxlambda:event-text captured)))
           (assert (= (wxlambda::handle handler) (wxlambda:event-origin-id captured))))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler handler) (wxlambda:destroy-window window))))

(defun check-stack-pending-lifetime-and-rollback ()
  (let* ((window (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :stack-test-message :text "pending handler"))
         (captured nil)
         (binding (wxlambda:bind-event handler :stack-test-message (lambda (event) (setf captured event)))))
    (wxlambda:push-event-handler window handler)
    (unwind-protect
         (progn
           (wxlambda:queue-event handler source)
           (wxlambda:destroy-window window)
           (wxlambda:process-events)
           (assert (wxlambda:handler-alive-p handler))
           (assert (wxlambda:handler-unlinked-p handler))
           ;; Whether processed before or after native deletion, origin is handler,
           ;; never a borrowed pointer into the destroyed owner window.
           (unless captured (wxlambda:process-pending-events))
           (assert (eq handler (wxlambda:event-source captured)))
           (assert (= (wxlambda::handle handler) (wxlambda:event-origin-id captured)))
           (assert (string= "pending handler" (wxlambda:event-text captured))))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler handler)))
  (let* ((window (wxlambda:make-frame)) (anchor (wxlambda:make-event-handler))
         (survivor (wxlambda:make-event-handler)))
    (wxlambda:push-event-handler window anchor)
    (unwind-protect
         (progn
           (expect-error (lambda () (make-instance 'failing-pushed-handler :owner window)))
           (assert (zerop (wxlambda::%handler-alive *failed-stack-handler-id*)))
           (assert (eq anchor (wxlambda:window-event-handler window)))
           (expect-error (lambda () (make-instance 'failing-stack-frame :pushed survivor)))
           (wxlambda:process-events)
           (assert (zerop (wxlambda::%handler-alive *failed-stack-window-id*)))
           (assert (wxlambda:handler-alive-p survivor))
           (assert (wxlambda:handler-unlinked-p survivor)))
      (wxlambda:destroy-event-handler survivor) (wxlambda:destroy-event-handler anchor)
      (wxlambda:destroy-window window))))

(let (escaped-window escaped-handler)
  (wxlambda:with-application ()
    (wxlambda-window-handler-stacks:exercise)
    (wxlambda:register-event-type :stack-test-message :family :command)
    (check-stack-lifo-and-removal)
    (check-stack-preflight-policy)
    (check-explicit-window-routing)
    (check-stack-callback-and-run-guards)
    (check-all-window-destructors-detach)
    (check-pushed-session-rejection)
    (check-stack-pending-lifetime-and-rollback)
    (check-popped-handler-keeps-pending-events)
    ;; Session cleanup must detach the remaining stack before native window
    ;; destruction, then destroy the independently owned handler exactly once.
    (setf escaped-window (wxlambda:make-frame)
          escaped-handler (wxlambda:make-event-handler :class 'named-stack-handler))
    (wxlambda:push-event-handler escaped-window escaped-handler)
    (assert (string= "default stack node"
                     (stack-name (wxlambda:window-event-handler escaped-window)))))
  (expect-error (lambda () (wxlambda:window-event-handler escaped-window)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:handler-alive-p escaped-handler)) 'wxlambda:native-error))
(format t "PASS: managed window handler stacks, explicit routing, ownership, session isolation and rollback~%")
