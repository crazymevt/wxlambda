(load (merge-pathnames "../examples/handler-client-data.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defun client-root-count ()
  (wxlambda::reap-client-data-roots)
  (hash-table-count wxlambda::*handler-client-data-roots*))
(defun client-data-gc ()
  #+sbcl (sb-ext:gc :full t)
  #+ccl (ccl:gc))
(defun root-only-client-value (handler)
  ;; Once this function returns, the session client-data registry is the only
  ;; intended strong Lisp owner; the observer table retains only a weak value.
  (let ((table #+sbcl (make-hash-table :weakness :value)
               #+ccl (make-hash-table :weak :value)
               #-(or sbcl ccl) (make-hash-table))
        (value (list :rooted (make-string 4096 :initial-element #\λ))))
    (setf (gethash :value table) value
          (wxlambda:event-handler-client-data handler) value)
    table))
(defclass data-handler (wxlambda:event-handler)
  ((payload :initarg :payload :reader data-handler-payload))
  (:default-initargs :payload (list :default-handler-payload)))
(defmethod initialize-instance :after ((handler data-handler) &key)
  (setf (wxlambda:event-handler-client-data handler) (data-handler-payload handler))
  (assert (eq (data-handler-payload handler) (wxlambda:event-handler-client-data handler))))
(defclass data-frame (wxlambda:frame)
  ((payload :initarg :payload :reader data-frame-payload))
  (:default-initargs :payload (list :default-window-payload)))
(defmethod initialize-instance :after ((window data-frame) &key)
  (setf (wxlambda:event-handler-client-data window) (data-frame-payload window))
  (assert (eq (data-frame-payload window) (wxlambda:event-handler-client-data window))))
(defvar *failed-data-handler-id*)
(defvar *failed-data-window-id*)
(defvar *failed-data-child-id*)
(defclass failing-data-handler (wxlambda:event-handler) ())
(defmethod initialize-instance :after ((handler failing-data-handler) &key)
  (setf *failed-data-handler-id* (wxlambda::handle handler)
        (wxlambda:event-handler-client-data handler) (list :failed-handler-root))
  (error "client-data handler initializer failure"))
(defclass failing-data-frame (wxlambda:frame) ())
(defmethod initialize-instance :after ((window failing-data-frame) &key)
  (let ((child (wxlambda:make-button window)))
    (setf *failed-data-window-id* (wxlambda::handle window)
          *failed-data-child-id* (wxlambda::handle child)
          (wxlambda:event-handler-client-data window) (list :failed-window-root)
          (wxlambda:event-handler-client-data child) (list :failed-child-root)))
  (error "client-data window initializer failure"))

(defun check-client-data-values-and-identity ()
  (let* ((handler (wxlambda:make-event-handler)) (window (wxlambda:make-frame))
         (app (wxlambda:current-application-handler))
         (values (list 0 19 :keyword (copy-seq "client string") (list :mutable 1)
                       (lambda (x) (+ x 7))))
         (baseline (client-root-count)))
    (unwind-protect
         (progn
           (dolist (receiver (list handler window app))
             (assert (null (wxlambda:event-handler-client-data receiver)))
             (dolist (value values)
               (assert (eq value (setf (wxlambda:event-handler-client-data receiver) value)))
               (assert (eq value (wxlambda:event-handler-client-data receiver)))
               (client-data-gc)
               (assert (eq value (wxlambda:event-handler-client-data receiver)))
               ;; Replacement releases the previous token rather than accumulating roots.
               (assert (= (1+ baseline) (client-root-count))))
             (assert (= 12 (funcall (wxlambda:event-handler-client-data receiver) 5)))
             (assert (null (setf (wxlambda:event-handler-client-data receiver) nil)))
             (assert (null (wxlambda:event-handler-client-data receiver)))
             (assert (= baseline (client-root-count))))
           (let ((value (list :old 1)))
             (setf (wxlambda:event-handler-client-data handler) value)
             (setf (second value) :changed)
             (assert (eq value (wxlambda:event-handler-client-data handler)))
             (assert (eq :changed (second (wxlambda:event-handler-client-data handler)))))
           (let* ((weak (root-only-client-value handler))
                  (before (client-root-count)))
             (client-data-gc)
             (let ((value (gethash :value weak)))
               (assert value)
               (assert (eq value (wxlambda:event-handler-client-data handler))))
             (assert (= before (client-root-count)))))
      (setf (wxlambda:event-handler-client-data app) nil)
      (wxlambda:destroy-event-handler handler) (wxlambda:destroy-window window)
      (wxlambda:process-events))
    (assert (= baseline (client-root-count)))))

(defun check-client-data-native-construction-and-rollback ()
  (let* ((baseline (client-root-count))
         (payload (list :explicit-subclass-data))
         (handler (wxlambda:make-event-handler :class 'data-handler :payload payload))
         (window (wxlambda:make-frame :class 'data-frame)))
    (unwind-protect
         (progn
           (assert (eq payload (wxlambda:event-handler-client-data handler)))
           (assert (eq (data-frame-payload window) (wxlambda:event-handler-client-data window)))
           (assert (= (+ baseline 2) (client-root-count)))
           (expect-error (lambda () (make-instance 'failing-data-handler)))
           (assert (zerop (wxlambda::%handler-alive *failed-data-handler-id*)))
           (assert (= (+ baseline 2) (client-root-count)))
           (expect-error (lambda () (make-instance 'failing-data-frame)))
           (wxlambda:process-events)
           (assert (zerop (wxlambda::%handler-alive *failed-data-window-id*)))
           (assert (zerop (wxlambda::%handler-alive *failed-data-child-id*)))
           (assert (= (+ baseline 2) (client-root-count))))
      (wxlambda:destroy-event-handler handler) (wxlambda:destroy-window window)
      (wxlambda:process-events))
    (assert (= baseline (client-root-count)))))

(defun check-client-data-parent-death-and-detached-survivor ()
  (let* ((baseline (client-root-count)) (frame (wxlambda:make-frame))
         (panel (wxlambda:make-panel frame)) (button (wxlambda:make-button panel))
         (handler (wxlambda:make-event-handler)) (survivor (list :pushed-handler-data)))
    (setf (wxlambda:event-handler-client-data frame) (list :parent-data)
          (wxlambda:event-handler-client-data panel) (list :panel-data)
          (wxlambda:event-handler-client-data button) (list :child-data)
          (wxlambda:event-handler-client-data handler) survivor)
    (wxlambda:push-event-handler panel handler)
    (setf (wxlambda:handler-enabled-p frame) nil
          (wxlambda:handler-enabled-p panel) nil
          (wxlambda:handler-enabled-p button) nil)
    (assert (= (+ baseline 4) (client-root-count)))
    (wxlambda:destroy-window frame)
    (wxlambda:process-events)
    (assert (= (1+ baseline) (client-root-count)))
    (assert (wxlambda:handler-alive-p handler))
    (assert (wxlambda:handler-unlinked-p handler))
    (assert (eq survivor (wxlambda:event-handler-client-data handler)))
    (dolist (receiver (list frame panel button))
      (expect-error (lambda () (wxlambda:event-handler-client-data receiver)) 'wxlambda:native-error)
      (expect-error (lambda () (setf (wxlambda:event-handler-client-data receiver) (list :cannot-leak)))
                    'wxlambda:native-error)
      (assert (= (1+ baseline) (client-root-count))))
    (wxlambda:destroy-event-handler handler)
    (assert (= baseline (client-root-count)))))

(defun check-client-data-callback-lifetime-and-errors ()
  (let* ((baseline (client-root-count)) (handler (wxlambda:make-event-handler))
         (original (list :initial-data)) (replacement (lambda () :replacement))
         (condition (make-condition 'simple-error :format-control "client data callback failure"))
         (binding (wxlambda:bind-event handler :client-data-message
                    (lambda (snapshot context)
                      (declare (ignore snapshot))
                      (assert (eq original (wxlambda:event-handler-client-data handler)))
                      (expect-error (lambda () (wxlambda:event-handler-client-data context)))
                      (assert (eq replacement (setf (wxlambda:event-handler-client-data handler) replacement)))
                      (assert (eq :replacement (funcall (wxlambda:event-handler-client-data handler))))
                      (wxlambda:destroy-event-handler handler)
                      (error condition)) :with-context t)))
    (setf (wxlambda:event-handler-client-data handler) original)
    (assert (eq condition (handler-case (wxlambda:process-event handler :client-data-message)
                           (error (caught) caught))))
    (assert (not (wxlambda:handler-alive-p handler)))
    (wxlambda:unbind-event binding)
    ;; The native wxClientData object survives until deferred receiver deletion.
    (wxlambda:process-events)
    (assert (= baseline (client-root-count)))
    (expect-error (lambda () (wxlambda:event-handler-client-data handler)) 'wxlambda:native-error)
    (expect-error (lambda () (setf (wxlambda:event-handler-client-data handler) :stale)) 'wxlambda:native-error)
    (assert (= baseline (client-root-count)))))

(defun check-client-data-receiver-errors ()
  (let* ((handler (wxlambda:make-event-handler)) (owned (wxlambda:make-event))
         (uninitialized (allocate-instance (find-class 'wxlambda:event-handler)))
         (snapshot nil)
         (binding (wxlambda:bind-event handler :client-data-message (lambda (event) (setf snapshot event))))
         (baseline (client-root-count)))
    (unwind-protect
         (progn
           (wxlambda:process-event handler :client-data-message)
           (dolist (receiver (list owned snapshot nil 19 :not-a-handler uninitialized))
             (expect-error (lambda () (wxlambda:event-handler-client-data receiver)))
             (expect-error (lambda () (setf (wxlambda:event-handler-client-data receiver) (list :bad-receiver))))
             (assert (= baseline (client-root-count)))))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event owned)
      (wxlambda:destroy-event-handler handler))))

(let (escaped roots)
  (wxlambda:with-application ()
    (assert (wxlambda-handler-client-data:exercise))
    (wxlambda:register-event-type :client-data-message :family :command)
    (check-client-data-values-and-identity)
    (check-client-data-native-construction-and-rollback)
    (check-client-data-parent-death-and-detached-survivor)
    (check-client-data-callback-lifetime-and-errors)
    (check-client-data-receiver-errors)
    (setf escaped (wxlambda:make-event-handler)
          (wxlambda:event-handler-client-data escaped) (list :session-owned-root)
          (wxlambda:event-handler-client-data (wxlambda:current-application-handler)) (list :application-root)
          roots wxlambda::*handler-client-data-roots*)
    (assert (= 2 (client-root-count))))
  (assert (zerop (hash-table-count roots)))
  (expect-error (lambda () (wxlambda:event-handler-client-data escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (setf (wxlambda:event-handler-client-data escaped) :outside-session)) 'wxlambda:native-error))
(format t "PASS: EQ Lisp client data, GC roots, replacement, native lifetimes, rollback and session cleanup~%")
