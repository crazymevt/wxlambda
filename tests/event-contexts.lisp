(load (merge-pathnames "../examples/event-contexts.lisp" *load-truename*))
(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil) (wxlambda:native-error () t))))
(expect-native-error (lambda () (wxlambda:event-type :click)))
(let (saved-context saved-event)
  (wxlambda:with-application ()
    (wxlambda-event-contexts:exercise)
    (let ((types (mapcar #'wxlambda:event-type '(:click :text-change :toggle :selection))))
      (assert (= 4 (length (remove-duplicates types)))))
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame))
           (text (wxlambda:make-text frame)) (mode :consume) (parents 0) child-context child-binding
           (parent-binding (wxlambda:bind-event frame :click (lambda (e) (declare (ignore e)) (incf parents)))))
      (setf child-binding
            (wxlambda:bind-event button :click
              (lambda (event context)
                (setf child-context context saved-context context saved-event event)
                (assert (wxlambda:event-context-p context))
                (assert (wxlambda:event-context-active-p context))
                (assert (not (wxlambda:event-skipped-p context)))
                (assert (wxlambda:event-propagates-p context))
                (ecase mode
                  (:consume nil)
                  (:forward (assert (eq :yes (setf (wxlambda:event-skipped-p context) :yes))))
                  (:stop (assert (plusp (wxlambda:stop-event-propagation context)))
                         (assert (not (wxlambda:event-propagates-p context)))
                         (setf (wxlambda:event-skipped-p context) t))
                  (:restore (let ((level (wxlambda:stop-event-propagation context)))
                              (assert (eq context (wxlambda:resume-event-propagation context level)))
                              (assert (wxlambda:event-propagates-p context)))
                            (setf (wxlambda:event-skipped-p context) t))))
              :with-context t))
      (dolist (case '((:consume 0) (:forward 1) (:stop 1) (:restore 2)))
        (setf mode (first case))
        (wxlambda:queue-click button)
        (wxlambda:process-pending-events)
        (assert (= parents (second case)))
        (assert (not (wxlambda:event-context-active-p child-context)))
        (dolist (operation (list #'wxlambda:event-skipped-p #'wxlambda:event-propagates-p
                                 #'wxlambda:stop-event-propagation
                                 (lambda (c) (setf (wxlambda:event-skipped-p c) t))
                                 (lambda (c) (wxlambda:resume-event-propagation c 1))))
          (expect-native-error (lambda () (funcall operation child-context)))))
      (wxlambda:unbind-event child-binding)
      ;; Outer capabilities must not be usable in nested contextual, observer or
      ;; control-specific callbacks. They become usable again after the setter.
      (let (outer inner (nested 0))
        (wxlambda:on-text-change text
          (lambda (e) (declare (ignore e)) (incf nested)
            (assert (not (wxlambda:event-context-active-p outer)))
            (expect-native-error (lambda () (wxlambda:event-skipped-p outer)))))
        (let* ((nested-context
                 (wxlambda:bind-event text :text-change
                   (lambda (e c) (declare (ignore e)) (incf nested) (setf inner c)
                     (assert (wxlambda:event-context-active-p c))
                     (assert (not (wxlambda:event-context-active-p outer)))
                     (expect-native-error (lambda () (wxlambda:stop-event-propagation outer)))
                     (setf (wxlambda:event-skipped-p c) t)) :with-context t))
               (nested-observer
                 (wxlambda:bind-event text :text-change
                   (lambda (e) (declare (ignore e)) (incf nested)
                     (assert (not (wxlambda:event-context-active-p outer)))
                     (expect-native-error (lambda () (setf (wxlambda:event-skipped-p outer) nil))))))
               (outer-binding
                 (wxlambda:bind-event button :click
                   (lambda (e c) (declare (ignore e)) (setf outer c)
                     (setf (wxlambda:text text :notify t) "nested")
                     (assert (= 3 nested))
                     (assert (not (wxlambda:event-context-active-p inner)))
                     (assert (wxlambda:event-context-active-p c))
                     (wxlambda:unbind-event nested-context)
                     (assert (wxlambda:event-context-active-p c))
                     (setf (wxlambda:event-skipped-p c) t)) :with-context t)))
          (wxlambda:queue-click button)
          (wxlambda:process-pending-events)
          (assert (not (wxlambda:event-context-active-p outer)))
          (mapc #'wxlambda:unbind-event (list nested-context nested-observer outer-binding)))
        (wxlambda:off-text-change text))
      (let* ((failure (make-condition 'simple-error :format-control "scoped callback error"))
             (binding (wxlambda:bind-event button :click
                        (lambda (e c) (setf saved-event e saved-context c) (error failure)) :with-context t)))
        (wxlambda:queue-click button)
        (assert (handler-case (progn (wxlambda:process-pending-events) nil)
                  (error (condition) (eq failure condition))))
        (assert (not (wxlambda:event-context-active-p saved-context)))
        (expect-native-error (lambda () (wxlambda:event-skipped-p saved-context)))
        (wxlambda:unbind-event binding))
      (wxlambda:unbind-event parent-binding)
      (wxlambda:destroy-window frame))
    ;; Native type metadata is copied for every control-specific callback mode,
    ;; not only for generic contextual dispatch.
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame))
           (text (wxlambda:make-text frame)) (check (wxlambda:make-checkbox frame))
           (choice (wxlambda:make-choice frame :items '("a" "b"))) seen)
      (flet ((capture (event)
               (assert (= (wxlambda:event-type (wxlambda:event-kind event))
                          (wxlambda:event-native-type event)))
               (push (wxlambda:event-kind event) seen)))
        (wxlambda:on-click button #'capture :with-event t)
        (wxlambda:on-text-change text #'capture)
        (wxlambda:on-toggle check #'capture)
        (wxlambda:on-selection choice #'capture)
        (wxlambda:queue-click button)
        (wxlambda:process-pending-events)
        (setf (wxlambda:text text :notify t) "type metadata"
              (wxlambda:checked-p check :notify t) t
              (wxlambda:selection choice :notify t) 1)
        (assert (= 4 (length seen)))
        (assert (= 4 (length (remove-duplicates seen)))))
      (wxlambda:off-click button)
      (wxlambda:off-text-change text)
      (wxlambda:off-toggle check)
      (wxlambda:off-selection choice)
      (wxlambda:destroy-window frame))
    ;; A nested contextual error can be handled at the notifying writer boundary;
    ;; the outer context must still be current after that recovery.
    (let* ((frame (wxlambda:make-frame)) (text (wxlambda:make-text frame))
           (receiver (wxlambda:make-event-handler)) inner outer
           (failure (make-condition 'simple-error :format-control "nested scoped error"))
           (nested (wxlambda:bind-event text :text-change
                     (lambda (e c) (declare (ignore e)) (setf inner c) (error failure)) :with-context t))
           (binding (wxlambda:bind-event receiver :click
                      (lambda (e c) (declare (ignore e)) (setf outer c)
                        (assert (handler-case (progn (setf (wxlambda:text text :notify t) "error") nil)
                                  (error (condition) (eq failure condition))))
                        (assert (wxlambda:event-context-active-p c))
                        (assert (not (wxlambda:event-context-active-p inner)))
                        (wxlambda:resume-event-propagation c 0)
                        (assert (not (wxlambda:event-propagates-p c)))
                        (setf (wxlambda:event-skipped-p c) t)) :with-context t)))
      (wxlambda:queue-event receiver :click)
      (wxlambda:process-pending-events)
      (assert (not (wxlambda:event-context-active-p outer)))
      (wxlambda:unbind-event nested)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver)
      (wxlambda:destroy-window frame))
    ;; Unbinding and disposing a receiver do not invalidate its still-running
    ;; event context; expiration happens precisely when the callback returns.
    (let ((receiver (wxlambda:make-event-handler)) binding context)
      (setf binding (wxlambda:bind-event receiver :click
                      (lambda (e c) (declare (ignore e)) (setf context c)
                        (wxlambda:unbind-event binding)
                        (wxlambda:destroy-event-handler receiver)
                        (assert (wxlambda:event-context-active-p c))
                        (setf (wxlambda:event-skipped-p c) t)) :with-context t))
      (wxlambda:queue-event receiver :click)
      (wxlambda:process-pending-events)
      (assert (not (wxlambda:event-context-active-p context)))
      (expect-native-error (lambda () (wxlambda:resume-event-propagation context 1)))))
  (assert (integerp (wxlambda:event-native-type saved-event)))
  (expect-native-error (lambda () (wxlambda:event-context-active-p saved-context))))
(format t "PASS: native event types, scoped Skip/propagation, nesting, expiration, disposal, errors and example~%")
