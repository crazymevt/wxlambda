(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun check-report-backtrace ()
  (let ((output (make-string-output-stream)))
    (wxlambda::report-repl-error
     (make-condition 'simple-error :format-control "Backtrace probe") output)
    (let ((printed (get-output-stream-string output)))
      #+(or sbcl ccl)
      (progn
        (assert (not (search "Backtrace unavailable" printed)))
        (assert (search "REPORT-REPL-ERROR" printed :test #'char-equal))))))

(check-report-backtrace)

(defvar *live-text*)
(defvar *clicks* 0)
(defvar *after-stop* nil)
(let ((output (make-string-output-stream)))
  (wxlambda:with-repl-application
      (:input (make-string-input-stream
               "(error \"Recoverable REPL error\")
(wxlambda:run)
(setf (wxlambda:text *live-text*) \"Changed live\")
(assert (string= (wxlambda:text *live-text*) \"Changed live\"))
(values :first :second)
(wxlambda:stop)
(setf *after-stop* t)")
       :output output :on-error :report)
    (let* ((frame (wxlambda:make-frame :title "REPL test"))
           (panel (wxlambda:make-panel frame))
           (button (wxlambda:make-button panel)))
      (setf *live-text* (wxlambda:make-text panel))
      (wxlambda:on-click button (lambda () (incf *clicks*) (error "Recoverable callback error")))
      (wxlambda:show-window frame)
      (wxlambda:queue-click button)))
  (assert (= *clicks* 1))
  (let ((printed (get-output-stream-string output)))
    (assert (search "Recoverable REPL error" printed))
    (assert (search "Recoverable callback error" printed))
    (assert (search "RUN is unavailable inside the application REPL" printed))
    (assert (search ":FIRST" printed))
    (assert (search ":SECOND" printed))
    #+(or sbcl ccl) (assert (search "Backtrace" printed :test #'char-equal))
    (assert (not *after-stop*)))
  (assert (not wxlambda::*active*))
  (assert (handler-case (progn (wxlambda:text *live-text*) nil)
            (wxlambda:native-error () t))))
(format t "PASS: REPL evaluation, event dispatch, error recovery, stop, cleanup~%")

;; Standard whitespace, including CRLF and trailing spaces, must never enter READ.
(let ((stream (make-string-input-stream
               (format nil " ~C~C~C~C~C" #\Tab #\Return #\Newline #\Page #\Space))))
  (multiple-value-bind (ready eof) (wxlambda::repl-input-ready-p stream)
    (assert (not ready))
    (assert eof)))
(let ((stream (make-string-input-stream (format nil " ~C~C (+ 1 2)" #\Return #\Newline))))
  (assert (wxlambda::repl-input-ready-p stream))
  (assert (equal (read stream) '(+ 1 2))))
(format t "PASS: nonblocking whitespace skipping and CRLF input~%")
