(load (merge-pathnames "../examples/application-handler.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass invalid-application-view (wxlambda:application-handler) ())
(expect-error #'wxlambda:current-application-handler 'wxlambda:native-error)
(let (saved saved-binding snapshot)
  (wxlambda:with-application ()
    (setf saved (wxlambda-application-handler:exercise))
    (assert (typep saved 'wxlambda:event-handler))
    (assert (typep saved 'wxlambda:application-handler))
    (assert (not (typep saved 'wxlambda:window)))
    (assert (wxlambda:handler-alive-p saved))
    (expect-error (lambda () (make-instance 'wxlambda:application-handler)))
    (expect-error (lambda () (make-instance 'invalid-application-view)))
    (expect-error (lambda () (wxlambda:make-event-handler :class 'wxlambda:application-handler)))
    (expect-error (lambda () (wxlambda:destroy-event-handler saved)) 'wxlambda:native-error)
    (assert (eq saved (wxlambda:current-application-handler)))
    (wxlambda:register-event-type :application-policy)
    (setf saved-binding
          (wxlambda:bind-event saved :application-policy
            (lambda (event context)
              (setf snapshot event)
              (expect-error (lambda () (wxlambda:destroy-event-handler saved)) 'wxlambda:native-error)
              (assert (eq saved (wxlambda:current-application-handler)))
              (setf (wxlambda:event-vetoed-p context) t)) :with-context t))
    (assert (equal '(t t) (multiple-value-list (wxlambda:process-event saved :application-policy))))
    (assert (eq saved (wxlambda:event-source snapshot)))
    (assert (wxlambda:handler-enabled-p saved))
    (unwind-protect
         (progn
           (setf (wxlambda:handler-enabled-p saved) nil)
           (assert (not (wxlambda:handler-enabled-p saved)))
           (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event saved :application-policy)))))
      (setf (wxlambda:handler-enabled-p saved) t))
    ;; Leave this binding to session cleanup. The borrowed application must survive.
    (assert (wxlambda:binding-active-p saved-binding))
    (assert (wxlambda:handler-alive-p saved)))
  (expect-error #'wxlambda:current-application-handler 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:handler-alive-p saved)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:handler-enabled-p saved)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:process-event saved :application-policy)) 'wxlambda:native-error)
  (assert (eq :notify (wxlambda:event-family snapshot)))
  (assert (eq saved (wxlambda:event-source snapshot))))
(format t "PASS: borrowed application identity, dispatch, construction/disposal rejection and session cleanup~%")
