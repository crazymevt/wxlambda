(load (merge-pathnames "../examples/tooltips.lisp" *load-truename*))
(defun tooltip-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass guided-text (wxlambda:text-control) ((hint :initarg :hint))
  (:default-initargs :hint "Subclass guidance λ"))
(defmethod initialize-instance :after ((object guided-text) &key)
  (setf (wxlambda:tooltip-text object) (slot-value object 'hint)))
(defclass failing-guided-text (guided-text) ())
(defvar *failed-guided-text* nil)
(defmethod initialize-instance :after ((object failing-guided-text) &key)
  (setf *failed-guided-text* object)
  (wxlambda:bind-event object :text-change (lambda (event) (declare (ignore event))))
  (error "Expected guided construction rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-tooltips:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (text (make-instance 'guided-text :parent panel))
         (button (wxlambda:make-button panel)) (delivered nil))
    (assert (string= "Subclass guidance λ" (wxlambda:tooltip-text text)))
    (assert (null (wxlambda:tooltip-text button)))
    (dolist (object (list frame panel text button))
      (let ((value (copy-seq "Guidance λ 😀")))
        (assert (eq value (setf (wxlambda:tooltip-text object) value)))
        (setf (char value 0) #\X)
        (assert (string= "Guidance λ 😀" (wxlambda:tooltip-text object))))
      (let ((copy (wxlambda:tooltip-text object)))
        (setf (char copy 0) #\X)
        (assert (string= "Guidance λ 😀" (wxlambda:tooltip-text object))))
      (assert (string= "" (setf (wxlambda:tooltip-text object) "")))
      (assert (string= "" (wxlambda:tooltip-text object)))
      (assert (null (setf (wxlambda:tooltip-text object) nil)))
      (assert (null (wxlambda:tooltip-text object))))
    (dolist (value (list 42 #\a t (format nil "A~CB" #\Null)
                         (make-string 4097 :initial-element #\a)
                         (make-string 2049 :initial-element #\λ)))
      (tooltip-error (lambda () (setf (wxlambda:tooltip-text text) value)))
      (assert (null (wxlambda:tooltip-text text))))
    (let ((limit (make-string 2048 :initial-element #\λ)))
      (setf (wxlambda:tooltip-text text) limit)
      (assert (string= limit (wxlambda:tooltip-text text))))
    (setf (wxlambda:tooltip-text text) (format nil "Line1~%Line2"))
    (assert (stringp (wxlambda:tooltip-text text))) ; native line handling varies
    (wxlambda:on-click button
      (lambda ()
        (assert (stringp (wxlambda:tooltip-text text)))
        (tooltip-error (lambda () (setf (wxlambda:tooltip-text text) "callback")) 'wxlambda:native-error)
        (tooltip-error (lambda () (setf (wxlambda:tooltip-text text) nil)) 'wxlambda:native-error)
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:tooltip-text text) "Deferred λ" delivered t)) :owner text)))
    (wxlambda:queue-click button)
    (loop repeat 30 until delivered do (wxlambda:process-events))
    (assert delivered) (assert (string= "Deferred λ" (wxlambda:tooltip-text text)))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (tooltip-error (lambda () (make-instance 'failing-guided-text :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (tooltip-error (lambda () (wxlambda:tooltip-text *failed-guided-text*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (tooltip-error (lambda () (wxlambda:tooltip-text text)) 'wxlambda:native-error)
    (tooltip-error (lambda () (setf (wxlambda:tooltip-text text) "stale")) 'wxlambda:native-error)))
(format t "PASS: tooltip ownership, absent/empty, Unicode byte bounds, copied strings, CLOS rollback and callback deferral~%")
