(load (merge-pathnames "../examples/frame-actions.lisp" *load-truename*))
(defun expect-action-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-toolbar (wxlambda:toolbar) ((tag :initarg :tag :reader action-tag))
  (:default-initargs :tag :toolbar))
(defmethod initialize-instance :after ((bar named-toolbar) &key)
  (assert (zerop (wxlambda:toolbar-tool-count bar))))
(defclass named-status (wxlambda:status-bar) ((tag :initarg :tag :reader action-tag))
  (:default-initargs :fields 2 :tag :status))
(defmethod initialize-instance :after ((bar named-status) &key)
  (assert (= 2 (wxlambda:status-field-count bar)))
  (setf (wxlambda:status-text bar 1) "Subclass λ"))
(defvar *failed-bar* nil)
(defclass failed-toolbar (wxlambda:toolbar) ())
(defmethod initialize-instance :after ((bar failed-toolbar) &key)
  (setf *failed-bar* (wxlambda::handle bar))
  (wxlambda:bind-event bar :menu (lambda (event) (declare (ignore event))))
  (wxlambda:add-toolbar-tool bar 1 "Fail")
  (error "Expected rollback"))
(defclass mixed-bar (wxlambda:toolbar wxlambda:status-bar) ())
(wxlambda:with-application ()
  (assert (wxlambda-frame-actions:exercise))
  (let* ((frame (wxlambda:make-frame))
         (bar (wxlambda:make-toolbar frame :class 'named-toolbar :tag :factory))
         (status (make-instance 'named-status :parent frame))
         (seen nil) (context nil) (calls 0))
    (assert (eq :factory (action-tag bar)))
    (assert (string= "Subclass λ" (wxlambda:status-text status 1)))
    (expect-action-error (lambda () (wxlambda:make-toolbar frame)) 'wxlambda:native-error)
    (expect-action-error (lambda () (wxlambda:make-status-bar frame)) 'wxlambda:native-error)
    (expect-action-error (lambda () (make-instance 'mixed-bar :parent frame)))
    (expect-action-error (lambda () (wxlambda:make-toolbar frame :class 'wxlambda:panel)))
    (expect-action-error (lambda () (wxlambda:make-status-bar frame :fields 0)))
    (expect-action-error (lambda () (wxlambda:realize-toolbar bar)))
    (assert (= 1001 (wxlambda:add-toolbar-tool bar 1001 "Open 日本語 😀" :art :open :help "Open λ")))
    (wxlambda:add-toolbar-tool bar 1002 "Details" :kind :check)
    (wxlambda:add-toolbar-separator bar)
    (assert (= 3 (wxlambda:toolbar-tool-count bar)))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 1001 "Duplicate")))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 0 "Zero")))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 1003 "")))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 1003 "Invalid" :art :bad)))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 1003 "Radio" :kind :radio)))
    (expect-action-error (lambda () (wxlambda:activate-toolbar-tool bar 1001)))
    (assert (wxlambda:realize-toolbar bar))
    (expect-action-error (lambda () (wxlambda:realize-toolbar bar)))
    (expect-action-error (lambda () (wxlambda:add-toolbar-separator bar)))
    (expect-action-error (lambda () (wxlambda:add-toolbar-tool bar 1003 "Late")))
    (expect-action-error (lambda () (wxlambda:tool-checked-p bar 1001)))
    (expect-action-error (lambda () (wxlambda:tool-enabled-p bar 9999)))
    (expect-action-error (lambda () (setf (wxlambda:tool-checked-p bar 1001) t)))
    (expect-action-error (lambda () (wxlambda:make-column bar)))
    (expect-action-error (lambda () (wxlambda:make-row status)))
    (wxlambda:make-column frame)
    (expect-action-error (lambda () (wxlambda:add-child frame bar)))
    (expect-action-error (lambda () (wxlambda:add-child frame status)))
    (dolist (text '("" "Unicode λ 日本語 😀"))
      (assert (eq text (setf (wxlambda:status-text status) text)))
      (assert (string= text (wxlambda:status-text status))))
    (dolist (field '(-1 2 16 :bad))
      (expect-action-error (lambda () (wxlambda:status-text status field)))
      (expect-action-error (lambda () (setf (wxlambda:status-text status field) "Bad"))))
    (expect-action-error (lambda () (setf (wxlambda:status-text status) (string #\Null))))
    (let ((binding (wxlambda:bind-event frame :menu
                     (lambda (event current)
                       (setf seen event context current) (incf calls)
                       (assert (= (wxlambda:event-origin-id event) (wxlambda::handle bar)))
                       (assert (eq :menu (wxlambda:event-kind event)))
                       (assert (= 1002 (wxlambda:event-id event)))
                       (assert (wxlambda:tool-checked-p bar 1002))
                       (setf (wxlambda:status-text status) "Action observed")
                       (dolist (operation (list (lambda () (wxlambda:destroy-window frame))
                                               (lambda () (wxlambda:close-window frame))
                                               (lambda () (wxlambda:destroy-window bar))
                                               (lambda () (wxlambda:destroy-window status))
                                               (lambda () (wxlambda:activate-toolbar-tool bar 1001))
                                               (lambda () (setf (wxlambda:tool-checked-p bar 1002) nil))
                                               (lambda () (setf (wxlambda:tool-enabled-p bar 1001) nil))
                                               (lambda () (wxlambda:process-events))
                                               (lambda () (wxlambda:clipboard-text-available-p))))
                         (expect-action-error operation 'wxlambda:native-error)))
                     :id 1002 :with-context t)))
      (assert (wxlambda:activate-toolbar-tool bar 1002))
      (assert (= calls 1))
      (assert (wxlambda:event-checked-p seen))
      (assert (string= "Action observed" (wxlambda:status-text status)))
      (expect-action-error (lambda () (wxlambda:event-id context)) 'wxlambda:native-error)
      (wxlambda:unbind-event binding))
    (setf (wxlambda:tool-enabled-p bar 1002) nil)
    (assert (not (wxlambda:activate-toolbar-tool bar 1002)))
    (assert (= calls 1))
    (setf (wxlambda:tool-enabled-p bar 1002) t (wxlambda:tool-checked-p bar 1002) nil)
    (assert (not (wxlambda:tool-checked-p bar 1002)))
    (wxlambda:destroy-window bar) (wxlambda:destroy-window status)
    (wxlambda:process-events)
    (expect-action-error (lambda () (wxlambda:toolbar-tool-count bar)) 'wxlambda:native-error)
    (expect-action-error (lambda () (wxlambda:status-text status)) 'wxlambda:native-error)
    ;; Detached bars can be replaced; failed subclass initialization frees slots/roots.
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (expect-action-error (lambda () (make-instance 'failed-toolbar :parent frame)))
      (wxlambda:process-events)
      (assert (= roots (hash-table-count wxlambda::*event-bindings*)))
      (assert (zerop (wxlambda::%handler-alive *failed-bar*))))
    (let ((replacement (make-instance 'named-toolbar :parent frame))
          (status2 (wxlambda:make-status-bar frame :class 'named-status)))
      (wxlambda:destroy-window frame) (wxlambda:process-events)
      (expect-action-error (lambda () (wxlambda:toolbar-tool-count replacement)))
      (expect-action-error (lambda () (wxlambda:status-field-count status2))))))
(format t "PASS: frame toolbar/status actions, Unicode fields, shared menu routing, CLOS rollback and guarded lifetimes~%")
