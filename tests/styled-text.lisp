(load (merge-pathnames "../examples/styled-text.lisp" *load-truename*))
(defun stc-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-stc (wxlambda:styled-text-control) ((tag :initarg :tag :reader stc-tag))
  (:default-initargs :value "λ 😀" :tag :default))
(defmethod initialize-instance :after ((control custom-stc) &key)
  (assert (= 7 (wxlambda:stc-length control))))
(defclass failing-stc (custom-stc) ())
(defvar *failed-stc* nil)
(defmethod initialize-instance :after ((control failing-stc) &key)
  (setf *failed-stc* control)
  (wxlambda:bind-event control :stc-modified (lambda (event) (declare (ignore event))))
  (error "Expected initialization rollback"))
(defclass mixed-stc (wxlambda:styled-text-control wxlambda:text-control) ())
(wxlambda:with-application ()
  (assert (wxlambda-styled-text:exercise))
  (let* ((frame (wxlambda:make-frame :width 600 :height 400))
         (control (wxlambda:make-styled-text-control frame :class 'custom-stc :tag :factory))
         (changes nil) (borrowed nil) (deferred nil))
    (assert (eq :factory (stc-tag control)))
    (stc-error (lambda () (make-instance 'mixed-stc :parent frame)))
    (stc-error (lambda () (make-instance 'failing-stc :parent frame)))
    (stc-error (lambda () (wxlambda:stc-text *failed-stc*)))
    ;; Native edits adjust GetEndStyled independently of previous StartStyling.
    (let ((probe (wxlambda:make-styled-text-control frame :value "abcdefgh")))
      (wxlambda:start-stc-styling probe 0) (wxlambda:set-stc-styling probe 6 1)
      (wxlambda:replace-stc-range probe 7 8 "z")
      (stc-error (lambda () (wxlambda:set-stc-style-bytes probe (make-array 8 :element-type '(unsigned-byte 8) :initial-element 1))))
      (stc-error (lambda () (wxlambda:set-stc-styling probe 8 1)))
      (let ((remaining (- (wxlambda:stc-length probe) (wxlambda:stc-end-styled probe))))
        (wxlambda:set-stc-style-bytes probe (make-array remaining :element-type '(unsigned-byte 8) :initial-element 1)))
      (assert (= 8 (wxlambda:stc-end-styled probe))))
    (wxlambda:bind-event frame :stc-modified
      (lambda (event context)
        (push event changes) (setf borrowed context)
        (assert (stringp (wxlambda:stc-text control)))
        (assert (integerp (wxlambda:event-stc-position context)))
        (stc-error (lambda () (wxlambda:destroy-window control)))
        (stc-error (lambda () (wxlambda:close-window frame :force t)))
        (stc-error (lambda () (setf (wxlambda:stc-text control) "nested")))
        (stc-error (lambda () (wxlambda:process-events)))
        (stc-error (lambda () (setf (wxlambda:event-text context) "payload")))
        (stc-error (lambda () (wxlambda:clone-event context)))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:replace-stc-range control 0 2 "日本")
    (assert (string= "日本 😀" (wxlambda:stc-text control)))
    (assert (= 11 (wxlambda:stc-length control)))
    (assert (find-if (lambda (event) (and (logbitp 0 (wxlambda:event-stc-modification-type event))
                                         (= 6 (wxlambda:event-stc-length event))
                                         (string= "日本" (wxlambda:event-text event)))) changes))
    (stc-error (lambda () (wxlambda:event-stc-position borrowed)))
    (stc-error (lambda () (wxlambda:replace-stc-range control 1 3 "bad")))
    (assert (string= "日本 😀" (wxlambda:stc-text control)))
    (setf (wxlambda:stc-text control) (concatenate 'string "A" (string #\Null) "λ"))
    (assert (equal (coerce (wxlambda:stc-text control) 'list) (list #\A #\Null #\λ)))
    (setf (wxlambda:stc-text control) (format nil "first λ~%second 😀~%third"))
    (wxlambda:set-stc-save-point control) (assert (not (wxlambda:stc-modified-p control)))
    (wxlambda:replace-stc-range control 0 0 "X") (assert (wxlambda:stc-modified-p control))
    (wxlambda:stc-undo control) (assert (not (wxlambda:stc-modified-p control)))
    (assert (wxlambda:stc-can-redo-p control)) (wxlambda:stc-redo control)
    (setf (wxlambda:stc-read-only-p control) t)
    (stc-error (lambda () (wxlambda:replace-stc-range control 0 0 "blocked")))
    (setf (wxlambda:stc-read-only-p control) nil)
    (stc-error (lambda () (wxlambda:end-stc-undo-action control)))
    (setf (wxlambda:stc-multiple-selection-p control) t)
    (wxlambda:set-stc-selection control 0 2)
    (wxlambda:add-stc-selection control 4 3)
    (assert (= 2 (wxlambda:stc-selection-count control)))
    (assert (= 4 (wxlambda:stc-selection-caret control 1)))
    (wxlambda:clear-stc-selections control)
    (setf (wxlambda:stc-selection-mode control) 1
          (wxlambda:stc-rectangular-anchor control) 0
          (wxlambda:stc-rectangular-caret control) 4)
    (assert (= 1 (wxlambda:stc-selection-mode control)))
    (setf (wxlambda:stc-selection-mode control) 0)
    (let ((styles (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(1 2 3))))
      (wxlambda:start-stc-styling control 0) (wxlambda:set-stc-style-bytes control styles)
      (setf (aref styles 0) 9)
      (assert (= 1 (wxlambda:stc-style-at control 0)))
      (assert (= 2 (wxlambda:stc-style-at control 1)))
      (assert (>= (wxlambda:stc-end-styled control) 3)))
    (wxlambda:show-window frame) (wxlambda:process-events)
    (assert (= 1 (wxlambda:stc-line-from-position control (wxlambda:stc-position-from-line control 1))))
    (assert (= 2 (length (wxlambda:stc-point-from-position control 0))))
    (setf (wxlambda:stc-fold-level control 0) #x2400
          (wxlambda:stc-fold-level control 1) #x401
          (wxlambda:stc-fold-level control 2) #x400)
    (wxlambda:toggle-stc-fold control 0) (assert (not (wxlambda:stc-line-visible-p control 1)))
    (wxlambda:toggle-stc-fold control 0) (assert (wxlambda:stc-line-visible-p control 1))
    (let ((original (wxlambda:stc-text control)))
      (setf (wxlambda:stc-text control) "λ" (wxlambda:stc-current-position control) 2)
      (stc-error (lambda () (wxlambda:show-stc-autocomplete control 1 "bad")))
      (setf (wxlambda:stc-text control) original))
    (wxlambda:show-stc-autocomplete control 0 "alpha beta")
    (assert (wxlambda:stc-autocomplete-active-p control)) (wxlambda:cancel-stc-autocomplete control)
    (wxlambda:show-stc-call-tip control 0 "function(arg)")
    (assert (wxlambda:stc-call-tip-active-p control)) (wxlambda:cancel-stc-call-tip control)
    (wxlambda:defer-ui-action (lambda () (setf (wxlambda:stc-style-background control 1) #xffffff deferred t)) :owner control)
    (loop repeat 50 until deferred do (wxlambda:process-events) (sleep .005)) (assert deferred)
    (dolist (kind '(:stc-modified :stc-update-ui :stc-style-needed :stc-margin-click :stc-dwell-start))
      (stc-error (lambda () (wxlambda:make-event :kind kind))))
    (wxlambda:destroy-window frame)
    (stc-error (lambda () (wxlambda:stc-text control)))))
(format t "PASS: STC UTF8/NUL byte ranges, changes, undo/savepoints, selections, styling/folding/assist, CLOS and lifetime guards~%")
