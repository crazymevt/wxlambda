(load (merge-pathnames "../examples/binding-user-data.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defun binding-data-gc ()
  #+sbcl (sb-ext:gc :full t)
  #+ccl (ccl:gc))
(defvar *failed-user-data-binding*)
(defvar *failed-user-data-handler-id*)
(defclass failing-user-data-handler (wxlambda:event-handler) ())
(defmethod initialize-instance :after ((handler failing-user-data-handler) &key)
  (setf *failed-user-data-handler-id* (wxlambda::handle handler)
        *failed-user-data-binding*
        (wxlambda:bind-event handler :binding-data-message (lambda (event) (declare (ignore event)))
                            :user-data (list :failed-constructor-data)))
  (error "binding user-data initialization failed"))

(defun check-binding-data-values-and-defaults ()
  (let* ((receiver (wxlambda:make-event-handler)) (saved nil)
         (owned (wxlambda:make-event :kind :binding-data-message))
         (handler-data (list :handler-data))
         (values (list nil 0 :keyword (copy-seq "userdata string") (list :count 0) (lambda () :function-data))))
    (setf (wxlambda:event-handler-client-data receiver) handler-data)
    (unwind-protect
         (progn
           (assert (null (wxlambda:event-user-data owned)))
           (dolist (value values)
             (let ((binding (wxlambda:bind-event receiver :binding-data-message
                              (lambda (snapshot context)
                                (setf saved snapshot)
                                (assert (eq value (wxlambda:event-user-data snapshot)))
                                (assert (eq value (wxlambda:event-user-data context)))
                                (assert (eq handler-data (wxlambda:event-handler-client-data receiver)))
                                (binding-data-gc)
                                (assert (eq value (wxlambda:event-user-data context)))
                                (when value
                                  ;; Even Lisp zero denotes a non-null native userData object.
                                  (expect-error (lambda () (wxlambda:clone-event context)) 'wxlambda:native-error)))
                              :with-context t :user-data value)))
               (unwind-protect
                    (progn
                      (wxlambda:process-event receiver owned)
                      (assert (eq value (wxlambda:event-user-data saved)))
                      (when (functionp value) (assert (eq :function-data (funcall (wxlambda:event-user-data saved)))))
                      (when (consp value)
                        (let ((data (wxlambda:event-user-data saved)))
                          (incf (getf data :count))
                          (assert (= 1 (getf value :count))))))
                 (wxlambda:unbind-event binding))))
           (assert (null (wxlambda:event-user-data owned)))
           (assert (not (fboundp '(setf wxlambda:event-user-data))))
           (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-user-data)) nil saved)))
           (let ((binding (wxlambda:bind-event receiver :binding-data-message
                            (lambda (snapshot context)
                              (assert (null (wxlambda:event-user-data snapshot)))
                              (assert (null (wxlambda:event-user-data context)))
                              (let ((clone (wxlambda:clone-event context)))
                                (assert (null (wxlambda:event-user-data clone)))
                                (wxlambda:destroy-event clone))) :with-context t)))
             (unwind-protect (wxlambda:process-event receiver owned)
               (wxlambda:unbind-event binding))))
      (wxlambda:destroy-event owned) (wxlambda:destroy-event-handler receiver))))

(defun check-binding-only-gc-root (receiver)
  (let ((weak #+sbcl (make-hash-table :weakness :value)
              #+ccl (make-hash-table :weak :value)
              #-(or sbcl ccl) (make-hash-table))
        (binding nil) (saved nil) (expired nil)
        (baseline (hash-table-count wxlambda::*handlers*)))
    (flet ((install ()
             (let ((value (list :only-binding-root (make-string 4096 :initial-element #\λ))))
               (setf (gethash :value weak) value
                     binding
                     (wxlambda:bind-event receiver :binding-data-message
                       (lambda (snapshot context)
                         (setf saved snapshot expired context)
                         (let ((datum (wxlambda:event-user-data snapshot)))
                           (assert (eq datum (gethash :value weak)))
                           (wxlambda:unbind-event binding)
                           (assert (= baseline (hash-table-count wxlambda::*handlers*)))
                           (binding-data-gc)
                           (assert (eq datum (wxlambda:event-user-data context)))))
                       :with-context t :user-data value)))))
      (install))
    (binding-data-gc)
    (assert (gethash :value weak))
    (wxlambda:process-event receiver :binding-data-message)
    (assert (not (wxlambda:binding-active-p binding)))
    (assert (= baseline (hash-table-count wxlambda::*handlers*)))
    (assert (eq (gethash :value weak) (wxlambda:event-user-data saved)))
    (expect-error (lambda () (wxlambda:event-user-data expired)) 'wxlambda:native-error)
    (values saved expired)))

(defun check-nested-and-peer-unbinding ()
  (let* ((receiver (wxlambda:make-event-handler))
         (outer-data (list :outer)) (inner-data (list :inner)) (peer-data (list :peer))
         (outer-context nil) (outer-binding nil) (inner-binding nil)
         (peer (wxlambda:bind-event receiver :binding-data-peer
                 (lambda (event) (declare (ignore event))) :user-data peer-data))
         (baseline (1- (hash-table-count wxlambda::*handlers*))))
    (setf inner-binding
          (wxlambda:bind-event receiver :binding-data-inner
            (lambda (snapshot context)
              (assert (eq inner-data (wxlambda:event-user-data snapshot)))
              (assert (eq inner-data (wxlambda:event-user-data context)))
              (expect-error (lambda () (wxlambda:event-user-data outer-context)) 'wxlambda:native-error)
              (wxlambda:unbind-event peer)
              (wxlambda:unbind-event inner-binding)
              (binding-data-gc)
              (assert (eq inner-data (wxlambda:event-user-data context))))
            :with-context t :user-data inner-data)
          outer-binding
          (wxlambda:bind-event receiver :binding-data-message
            (lambda (snapshot context)
              (setf outer-context context)
              (assert (eq outer-data (wxlambda:event-user-data snapshot)))
              (wxlambda:unbind-event outer-binding)
              (binding-data-gc)
              (assert (eq outer-data (wxlambda:event-user-data context)))
              (wxlambda:process-event receiver :binding-data-inner)
              (assert (eq outer-data (wxlambda:event-user-data context)))
              (expect-error (lambda () (wxlambda:clone-event context)) 'wxlambda:native-error))
            :with-context t :user-data outer-data))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver :binding-data-message)
           (assert (= baseline (hash-table-count wxlambda::*handlers*)))
           (assert (not (wxlambda:binding-active-p peer)))
           (assert (not (wxlambda:binding-active-p inner-binding)))
           (expect-error (lambda () (wxlambda:event-user-data outer-context)) 'wxlambda:native-error))
      (wxlambda:unbind-event peer) (wxlambda:unbind-event inner-binding)
      (wxlambda:unbind-event outer-binding) (wxlambda:destroy-event-handler receiver))))

(defun check-queued-and-transferred-user-data ()
  (let* ((receiver (wxlambda:make-event-handler)) (data (list :mutable 0))
         (source (wxlambda:make-event :kind :binding-data-message))
         (snapshots nil)
         (binding (wxlambda:bind-event receiver :binding-data-message
                    (lambda (snapshot) (push snapshot snapshots)) :user-data data)))
    (unwind-protect
         (progn
           (wxlambda:queue-event receiver :binding-data-message)
           (wxlambda:queue-event receiver source)
           (wxlambda:post-event receiver source)
           (wxlambda:transfer-event receiver source)
           (assert (not (wxlambda:event-alive-p source)))
           (wxlambda:process-pending-events)
           (assert (= 4 (length snapshots)))
           (assert (every (lambda (snapshot) (eq data (wxlambda:event-user-data snapshot))) snapshots))
           (wxlambda:unbind-event binding)
           (let ((new-data (list :replacement)))
             (setf binding (wxlambda:bind-event receiver :binding-data-message
                             (lambda (snapshot) (assert (eq new-data (wxlambda:event-user-data snapshot))))
                             :user-data new-data))
             (wxlambda:process-event receiver :binding-data-message)
             (assert (every (lambda (snapshot) (eq data (wxlambda:event-user-data snapshot))) snapshots)))
           (setf (second data) 7)
           (assert (every (lambda (snapshot) (= 7 (second (wxlambda:event-user-data snapshot)))) snapshots)))
      (wxlambda:unbind-event binding)
      (when (wxlambda:event-alive-p source) (wxlambda:destroy-event source))
      (wxlambda:destroy-event-handler receiver))))

(defun check-user-data-errors-and-rollback ()
  (let* ((receiver (wxlambda:make-event-handler)) (context nil) (saved nil)
         (data (list :error-data))
         (condition (make-condition 'simple-error :format-control "user data callback failure"))
         (baseline (hash-table-count wxlambda::*handlers*))
         (binding (wxlambda:bind-event receiver :binding-data-message
                    (lambda (snapshot current)
                      (setf context current saved snapshot)
                      (assert (eq data (wxlambda:event-user-data current)))
                      (error condition)) :with-context t :user-data data)))
    (unwind-protect
         (progn
           (assert (eq condition (handler-case (wxlambda:process-event receiver :binding-data-message)
                                  (error (caught) caught))))
           (assert (eq data (wxlambda:event-user-data saved)))
           (expect-error (lambda () (wxlambda:event-user-data context)) 'wxlambda:native-error)
           (wxlambda:unbind-event binding)
           (assert (= baseline (hash-table-count wxlambda::*handlers*)))
           (expect-error (lambda () (make-instance 'failing-user-data-handler)))
           (assert (zerop (wxlambda::%handler-alive *failed-user-data-handler-id*)))
           (assert (not (wxlambda:binding-active-p *failed-user-data-binding*)))
           (assert (= baseline (hash-table-count wxlambda::*handlers*)))
           (let ((dead (wxlambda:make-event-handler)))
             (wxlambda:destroy-event-handler dead)
             (expect-error (lambda () (wxlambda:bind-event dead :binding-data-message #'identity :user-data data))
                           'wxlambda:native-error)
             (assert (= baseline (hash-table-count wxlambda::*handlers*)))))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event-handler receiver))))

(defun check-user-data-receiver-family-matrix ()
  (let* ((standalone (wxlambda:make-event-handler))
         (app (wxlambda:current-application-handler))
         (baseline (hash-table-count wxlambda::*handlers*)))
    (unwind-protect
         (dolist (case (list (list app :binding-data-message :command)
                            (list standalone :binding-data-notify :notify)
                            (list standalone :close :close)
                            (list standalone :query-end-session :close)
                            (list standalone :end-session :close)))
           (destructuring-bind (receiver kind family) case
             (dolist (datum (list 0 (list :family kind :receiver receiver)))
               (let* ((source (wxlambda:make-event :kind kind))
                      (saved nil) (expired nil)
                      (binding (wxlambda:bind-event receiver kind
                                 (lambda (snapshot context)
                                   (setf saved snapshot expired context)
                                   (assert (eq family (wxlambda:event-family snapshot)))
                                   (assert (eq receiver (wxlambda:event-source snapshot)))
                                   (assert (eq datum (wxlambda:event-user-data snapshot)))
                                   (assert (eq datum (wxlambda:event-user-data context))))
                                 :with-context t :user-data datum)))
                 (unwind-protect
                      (progn
                        ;; The borrowed application receives only a custom command;
                        ;; every close/session probe uses an isolated owned handler.
                        (assert (equal '(t nil) (multiple-value-list
                                   (wxlambda:process-event receiver source))))
                        (assert (eq datum (wxlambda:event-user-data saved)))
                        (assert (null (wxlambda:event-user-data source)))
                        (expect-error (lambda () (wxlambda:event-user-data expired)) 'wxlambda:native-error))
                   (wxlambda:unbind-event binding) (wxlambda:destroy-event source)))
               (assert (= baseline (hash-table-count wxlambda::*handlers*))))))
      (wxlambda:destroy-event-handler standalone))))

(defun check-convenience-user-data-defaults ()
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (button (wxlambda:make-button panel)) (text (wxlambda:make-text panel))
         (checkbox (wxlambda:make-checkbox panel)) (choice (wxlambda:make-choice panel :items '("One")))
         (data (list :generic-only)) (generic-calls 0) (convenience-calls 0) (bindings nil))
    (unwind-protect
         (flet ((capture (snapshot)
                  (incf convenience-calls)
                  (assert (null (wxlambda:event-user-data snapshot)))))
           (wxlambda:on-click button #'capture :with-event t)
           (wxlambda:on-text-change text #'capture)
           (wxlambda:on-toggle checkbox #'capture)
           (wxlambda:on-selection choice #'capture)
           (dolist (pair (list (list button :click) (list text :text-change)
                              (list checkbox :toggle) (list choice :selection)))
             (push (wxlambda:bind-event (first pair) (second pair)
                     (lambda (snapshot)
                       (incf generic-calls)
                       (assert (eq data (wxlambda:event-user-data snapshot)))) :user-data data) bindings)
             (wxlambda:process-event (first pair) (second pair)))
           (assert (= 4 generic-calls convenience-calls)))
      (dolist (binding bindings) (wxlambda:unbind-event binding))
      (wxlambda:off-click button) (wxlambda:off-text-change text)
      (wxlambda:off-toggle checkbox) (wxlambda:off-selection choice)
      (wxlambda:destroy-window frame))))

(let (saved expired)
  (wxlambda:with-application ()
    (assert (wxlambda-binding-user-data:exercise))
    (wxlambda:register-event-type :binding-data-message :family :command)
    (wxlambda:register-event-type :binding-data-inner :family :command)
    (wxlambda:register-event-type :binding-data-peer :family :command)
    (wxlambda:register-event-type :binding-data-notify)
    (check-binding-data-values-and-defaults)
    (let ((receiver (wxlambda:make-event-handler)))
      (multiple-value-setq (saved expired) (check-binding-only-gc-root receiver))
      (wxlambda:destroy-event-handler receiver))
    (check-nested-and-peer-unbinding)
    (check-queued-and-transferred-user-data)
    (check-user-data-errors-and-rollback)
    (check-user-data-receiver-family-matrix)
    (check-convenience-user-data-defaults))
  (binding-data-gc)
  (assert (consp (wxlambda:event-user-data saved)))
  (expect-error (lambda () (wxlambda:event-user-data expired)) 'wxlambda:native-error))
(format t "PASS: binding user-data identity/rooting, self/peer unbind, nested callbacks and immutable snapshot lifetime~%")
