(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(defun geometry (window)
  (multiple-value-call #'list (wxlambda:window-position window) (wxlambda:window-size window)))

(let ((verified nil))
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Layout geometry" :width 900 :height 700))
           (root (wxlambda:make-panel frame))
           (ratio-row (wxlambda:make-panel root))
           (align-row (wxlambda:make-panel root))
           (align-column (wxlambda:make-panel root))
           (left (wxlambda:make-panel ratio-row))
           (right (wxlambda:make-panel ratio-row))
           (middle (wxlambda:make-button align-row :label "Center"))
           (bottom (wxlambda:make-button align-row :label "End"))
           (center (wxlambda:make-button align-column :label "Center"))
           (end (wxlambda:make-button align-column :label "End")))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame root :border 0 :proportion 1)
      (wxlambda:make-column root)
      (dolist (child (list ratio-row align-row align-column))
        (wxlambda:add-child root child :proportion 1))
      (expect-native-error (lambda () (wxlambda:add-spacer ratio-row 10)))
      (wxlambda:make-row ratio-row)
      (expect-native-error (lambda () (wxlambda:make-column ratio-row)))
      (expect-native-error (lambda () (wxlambda:add-child ratio-row left :border -1)))
      (expect-native-error (lambda () (wxlambda:add-child ratio-row left :proportion -1)))
      (expect-native-error (lambda () (wxlambda:add-child ratio-row left :align :center)))
      (expect-native-error (lambda () (wxlambda:add-child root left)))
      (assert (handler-case (progn (wxlambda:add-child ratio-row left :align :invalid) nil)
                (type-error () t)))
      (wxlambda:add-child ratio-row left :border 0 :proportion 1)
      (wxlambda:add-spacer ratio-row 17)
      (wxlambda:add-child ratio-row right :border 0 :proportion 2)
      (expect-native-error (lambda () (wxlambda:add-child ratio-row left)))
      (expect-native-error (lambda () (wxlambda:add-spacer ratio-row -1)))
      (expect-native-error (lambda () (wxlambda:add-stretch ratio-row :proportion 0)))
      (expect-native-error (lambda () (wxlambda:add-stretch ratio-row :proportion -1)))
      (wxlambda:make-row align-row)
      (wxlambda:add-spacer align-row 11)
      (wxlambda:add-child align-row middle :border 3 :expand nil :align :center)
      (wxlambda:add-stretch align-row)
      (wxlambda:add-child align-row bottom :border 3 :expand nil :align :end)
      (wxlambda:make-column align-column)
      (wxlambda:add-child align-column center :border 2 :expand nil :align :center)
      (wxlambda:add-spacer align-column 13)
      (wxlambda:add-child align-column end :border 4 :expand nil :align :end)
      (wxlambda:on-click middle
        (lambda ()
          ;; Settle the hierarchy explicitly; assertions use no font-size constants.
          (dolist (window (list frame root ratio-row align-row align-column))
            (wxlambda:layout-window window))
          (destructuring-bind (rx ry rw rh) (geometry root)
            (declare (ignore rx ry rh))
            (destructuring-bind (x y width height) (geometry ratio-row)
              (declare (ignore height))
              (assert (= 8 x y))
              (assert (= (- rw 16) width))))
          (destructuring-bind (x y width height) (geometry ratio-row)
            (declare (ignore x y))
            (destructuring-bind (lx ly lw lh) (geometry left)
              (destructuring-bind (rx ry rw rh) (geometry right)
                (assert (= 0 lx ly ry))
                (assert (= height lh rh))
                (assert (= 17 (- rx (+ lx lw))))
                (assert (= width (+ lw 17 rw)))
                (assert (<= (abs (- (* 2 lw) rw)) 2)))))
          (destructuring-bind (x y width height) (geometry align-row)
            (declare (ignore x y))
            (destructuring-bind (mx my mw mh) (geometry middle)
              (destructuring-bind (bx by bw bh) (geometry bottom)
                (assert (= 14 mx))
                (assert (<= (abs (- (+ (* 2 my) mh) height)) 2))
                (assert (= (- height 3) (+ by bh)))
                (assert (= (- width 3) (+ bx bw)))
                (assert (> (- bx (+ mx mw)) 100)))))
          (destructuring-bind (x y width height) (geometry align-column)
            (declare (ignore x y height))
            (destructuring-bind (cx cy cw ch) (geometry center)
              (destructuring-bind (ex ey ew eh) (geometry end)
                (declare (ignore eh))
                (assert (<= (abs (- (+ (* 2 cx) cw) width)) 2))
                (assert (= (- width 4) (+ ex ew)))
                (assert (= 19 (- ey (+ cy ch)))))))
          (setf verified t)
          (wxlambda:destroy-window frame)))
      (wxlambda:show-window frame)
      (wxlambda:queue-click middle)
      (wxlambda:run)
      (assert verified)
      (expect-native-error (lambda () (wxlambda:window-size left)))
      (expect-native-error (lambda () (wxlambda:window-position right)))
      (expect-native-error (lambda () (wxlambda:layout-window root)))
      (expect-native-error (lambda () (wxlambda:add-spacer ratio-row 1)))))
  (assert verified))
(format t "PASS: layout geometry, proportions, alignment, spacing, and stale handles~%")
