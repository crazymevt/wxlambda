(load (merge-pathnames "../examples/owned-events.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(defclass named-event (wxlambda:owned-event) ((name :initarg :name :reader event-name))
  (:default-initargs :kind :owned-notify :name "default"))
(defmethod initialize-instance :after ((e named-event) &key)
  (assert (wxlambda:event-alive-p e))
  (assert (eq :notify (wxlambda:event-family e))))
(defvar *failed-event*)
(defvar *failed-event-id*)
(defvar *nested-window-id*)
(defvar *nested-event-id*)
(defvar *nested-window*)
(defclass failing-event (wxlambda:owned-event) ())
(defmethod initialize-instance :after ((e failing-event) &key)
  (setf *failed-event* e *failed-event-id* (wxlambda::handle e)
        *nested-window* (wxlambda:make-frame) *nested-window-id* (wxlambda::handle *nested-window*))
  (error "owned initializer failure"))
(defvar *nested-event*)
(defclass failing-frame-with-event (wxlambda:frame) ())
(defmethod initialize-instance :after ((w failing-frame-with-event) &key)
  (declare (ignore w)) (setf *nested-event* (wxlambda:make-event) *nested-event-id* (wxlambda::handle *nested-event*)) (error "frame initializer failure"))
;;; These classes must fail before standard initialization or native allocation,
;;; regardless of which unrelated resource branch appears first in the CPL.
(defclass invalid-event-handler (wxlambda:owned-event wxlambda:event-handler) ())
(defclass invalid-handler-event (wxlambda:event-handler wxlambda:owned-event) ())
(defclass invalid-event-window (wxlambda:owned-event wxlambda:window) ())
(defclass invalid-window-event (wxlambda:window wxlambda:owned-event) ())
(defclass invalid-event-frame (wxlambda:owned-event wxlambda:frame) ())
(defclass invalid-frame-event (wxlambda:frame wxlambda:owned-event) ())
(defclass clone-default-event (wxlambda:owned-event)
  ((name :initarg :name :reader clone-name))
  (:default-initargs :kind :close :integer 99 :text "ignored default" :name "clone default"))

(defun check-mixed-event-ancestry ()
  (dolist (class '(invalid-event-handler invalid-handler-event invalid-event-window
                   invalid-window-event invalid-event-frame invalid-frame-event))
    (let ((object (allocate-instance (find-class class))))
      (assert (not (slot-boundp object 'wxlambda::handle)))
      (expect-error (lambda () (initialize-instance object)))
      ;; A preallocation guard does not even bind HANDLE through standard init.
      (assert (not (slot-boundp object 'wxlambda::handle))))
    (expect-error (lambda () (wxlambda:make-event :class class)))
    (expect-error (lambda () (wxlambda:make-event-handler :class class)))
    (when (subtypep class 'wxlambda:frame)
      (expect-error (lambda () (wxlambda:make-frame :class class))))))

(defun check-owned-event-bounds ()
  (let* ((e (wxlambda:make-event :kind :owned-command :text "unchanged"))
         (bits (* 8 (cffi:foreign-type-size :long)))
         (minimum (- (ash 1 (1- bits)))) (maximum (1- (ash 1 (1- bits)))))
    (unwind-protect
         (progn
           (dolist (value '(-2147483648 -1 0 2147483647))
             (assert (= value (setf (wxlambda:event-integer e) value)))
             (assert (= value (wxlambda:event-integer e)))
             (assert (= value (setf (wxlambda:event-id e) value)))
             (assert (= value (wxlambda:event-id e))))
           (dolist (bad '(-2147483649 2147483648 1/2 "bad" nil))
             (expect-error (lambda () (setf (wxlambda:event-integer e) bad)) 'type-error)
             (expect-error (lambda () (setf (wxlambda:event-id e) bad)) 'type-error))
           (assert (= 2147483647 (wxlambda:event-integer e) (wxlambda:event-id e)))
           (dolist (value (list minimum -1 0 maximum))
             (assert (= value (setf (wxlambda:event-timestamp e) value)))
             (assert (= value (wxlambda:event-timestamp e))))
           (dolist (bad (list (1- minimum) (1+ maximum) 1/2 nil))
             (expect-error (lambda () (setf (wxlambda:event-timestamp e) bad)) 'type-error))
           (assert (= maximum (wxlambda:event-timestamp e)))
           (let ((text (concatenate 'string "λ" (string (code-char 0)) "independent")))
             (assert (eq text (setf (wxlambda:event-text e) text)))
             (setf (char text 0) #\X)
             (assert (string= (concatenate 'string "λ" (string (code-char 0)) "independent")
                              (wxlambda:event-text e))))
           (dolist (bad (list nil 3 #(1 2)))
             (expect-error (lambda () (setf (wxlambda:event-text e) bad)) 'type-error))
           (setf (wxlambda:event-text e) "")
           (assert (string= "" (wxlambda:event-text e)))
           (let ((clone (make-instance 'clone-default-event :clone-from e :id 3
                                      :integer 77 :text "ignored explicit" :name "custom clone")))
             ;; Direct native-backed clone construction is source-wins, including
             ;; inherited payload defaults. Subclass slots are still initialized.
             (assert (eq :owned-command (wxlambda:event-kind clone)))
             (assert (= 2147483647 (wxlambda:event-integer clone) (wxlambda:event-id clone)))
             (assert (string= "" (wxlambda:event-text clone)))
             (assert (string= "custom clone" (clone-name clone)))
             (wxlambda:destroy-event clone))
           (expect-error (lambda () (wxlambda:make-event :clone-from e :text "override")))
           (expect-error (lambda () (wxlambda:clone-event e :kind :close))))
      (wxlambda:destroy-event e))))

(defun check-nested-owned-contexts ()
  (let* ((receiver (wxlambda:make-event-handler)) (outer nil) (captured nil)
         (inner (wxlambda:bind-event receiver :owned-notify
                  (lambda (e c)
                    (declare (ignore e))
                    (assert (eq :owned-notify (wxlambda:event-kind c)))
                    (assert (eq :notify (wxlambda:event-family c)))
                    (expect-error (lambda () (wxlambda:clone-event outer)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:event-text outer)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:event-integer outer)) 'wxlambda:native-error)
                    (expect-error (lambda () (setf (wxlambda:event-text outer) "bad")) 'wxlambda:native-error)
                    (expect-error (lambda () (setf (wxlambda:event-integer outer) 4)) 'wxlambda:native-error)
                    (let ((copy (wxlambda:clone-event c)))
                      (assert (null (wxlambda:event-origin-id copy)))
                      (wxlambda:destroy-event copy))) :with-context t))
         (binding (wxlambda:bind-event receiver :owned-command
                    (lambda (e c)
                      (setf captured e outer c)
                      (setf (wxlambda:event-text c) "changed context"
                            (wxlambda:event-integer c) -1)
                      (wxlambda:process-event receiver :owned-notify)
                      (assert (string= "changed context" (wxlambda:event-text c)))
                      (assert (= -1 (wxlambda:event-integer c)))
                      (let ((copy (wxlambda:clone-event c)))
                        (assert (string= "changed context" (wxlambda:event-text copy)))
                        (assert (= -1 (wxlambda:event-integer copy)))
                        (wxlambda:destroy-event copy))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver :owned-command :text "before" :integer 3)
           (assert (string= "before" (wxlambda:event-text captured)))
           (assert (= 3 (wxlambda:event-integer captured)))
           (expect-error (lambda () (wxlambda:clone-event captured)))
           (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-text)) "bad" captured)))
           (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-integer)) 4 captured)))
           (expect-error (lambda () (wxlambda:clone-event outer)) 'wxlambda:native-error))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event inner)
      (wxlambda:destroy-event-handler receiver))))

(defun check-owned-queue-independence ()
  (let* ((receiver (wxlambda:make-event-handler))
         (text (concatenate 'string "λ" (string (code-char 0)) "queued"))
         (e (wxlambda:make-event :kind :owned-command :id 42 :text text :integer 3))
         (captured nil)
         (binding (wxlambda:bind-event receiver :owned-command (lambda (event) (setf captured event)))))
    (unwind-protect
         (progn
           (setf (wxlambda:event-timestamp e) -1)
           (wxlambda:queue-event receiver e)
           (setf (wxlambda:event-text e) "later" (wxlambda:event-integer e) 99
                 (wxlambda:event-id e) 77 (wxlambda:event-timestamp e) 0
                 (wxlambda:event-native-type e) (wxlambda:event-type :reusable-message))
           (wxlambda:destroy-event e) (setf e nil)
           (wxlambda:process-pending-events)
           (assert captured)
           (assert (eq :owned-command (wxlambda:event-kind captured)))
           (assert (string= text (wxlambda:event-text captured)))
           (assert (= 3 (wxlambda:event-integer captured)))
           (assert (= 42 (wxlambda:event-id captured)))
           (assert (= -1 (wxlambda:event-timestamp captured)))
           (assert (= (wxlambda::handle receiver) (wxlambda:event-origin-id captured))))
      (when e (wxlambda:destroy-event e))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event-handler receiver))))

(defun check-lazy-text-event-policy ()
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (control (wxlambda:make-text panel :value "before"))
         (receiver (wxlambda:make-event-handler))
         (template (wxlambda:make-event :kind :text-change :text "owned payload"))
         (clone nil) (calls 0) (binding nil) (handler-binding nil))
    (unwind-protect
         (progn
           (setf binding
                 (wxlambda:bind-event control :text-change
                   (lambda (snapshot context)
                     (incf calls)
                     (assert (every (lambda (value) (string= "native control text" value))
                                    (list (wxlambda:event-text snapshot) (wxlambda:event-text context)
                                          (wxlambda:text control))))
                     (expect-error (lambda () (setf (wxlambda:event-text context) "not a control write"))
                                   'wxlambda:native-error)
                     (assert (string= "native control text" (wxlambda:text control)))
                     (setf clone (wxlambda:clone-event context))) :with-context t))
           (setf (wxlambda:text control :notify t) "native control text")
           (assert (= 1 calls))
           (assert (string= "native control text" (wxlambda:event-text clone)))
           ;; Effective lazy text is frozen before origin detachment.
           (setf (wxlambda:text control) "control changed later")
           (assert (string= "native control text" (wxlambda:event-text clone)))
           (expect-error (lambda () (wxlambda:process-event control template)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:queue-event control template)) 'wxlambda:native-error)
           (wxlambda:process-pending-events)
           (assert (= 1 calls))
           (setf handler-binding
                 (wxlambda:bind-event receiver :text-change
                   (lambda (snapshot context)
                     (assert (string= "owned payload" (wxlambda:event-text snapshot)))
                     (assert (string= "owned payload" (wxlambda:event-text context)))
                     (setf (wxlambda:event-text context) "mutable non-control copy")
                     (assert (string= "mutable non-control copy" (wxlambda:event-text context))))
                   :with-context t))
           (assert (first (multiple-value-list (wxlambda:process-event receiver template))))
           (assert (string= "owned payload" (wxlambda:event-text template))))
      (when handler-binding (wxlambda:unbind-event handler-binding))
      (when binding (wxlambda:unbind-event binding))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:destroy-event template) (wxlambda:destroy-event-handler receiver)
      (wxlambda:destroy-window frame))))

(defun check-native-payload-versus-snapshot-scope ()
  (let ((receiver (wxlambda:make-event-handler)))
    (unwind-protect
         (dolist (kind '(:click :toggle :selection))
           (let ((binding (wxlambda:bind-event receiver kind
                            (lambda (snapshot context)
                              (assert (null (wxlambda:event-text snapshot)))
                              (setf (wxlambda:event-text context) "native command payload")
                              (assert (string= "native command payload" (wxlambda:event-text context)))
                              (assert (null (wxlambda:event-text snapshot)))
                              (let ((copy (wxlambda:clone-event context)))
                                (assert (string= "native command payload" (wxlambda:event-text copy)))
                                (wxlambda:destroy-event copy))) :with-context t)))
             (unwind-protect (wxlambda:process-event receiver kind)
               (wxlambda:unbind-event binding))))
      (wxlambda:destroy-event-handler receiver))))

(defun check-owned-callback-errors ()
  (let* ((receiver (wxlambda:make-event-handler))
         (e (wxlambda:make-event :kind :owned-notify))
         (condition (make-condition 'simple-error :format-control "owned dispatch failure"))
         (binding (wxlambda:bind-event receiver :owned-notify
                    (lambda (snapshot context)
                      (declare (ignore snapshot context))
                      (wxlambda:destroy-event e)
                      (wxlambda:destroy-event-handler receiver)
                      (error condition)) :with-context t)))
    (assert (eq condition (handler-case (wxlambda:process-event receiver e) (error (c) c))))
    (assert (not (wxlambda:event-alive-p e)))
    (assert (not (wxlambda:handler-alive-p receiver)))
    (wxlambda:unbind-event binding)
    (wxlambda:process-events))
  ;; A handled nested copy-dispatch error does not leave the enclosing operation
  ;; or subsequent callback dispatch poisoned by the nearer error boundary.
  (let* ((receiver (wxlambda:make-event-handler))
         (e (wxlambda:make-event :kind :owned-notify))
         (condition (make-condition 'simple-error :format-control "nested owned failure"))
         (continued 0)
         (inner (wxlambda:bind-event receiver :owned-notify
                  (lambda (snapshot context) (declare (ignore snapshot context)) (error condition)) :with-context t))
         (binding (wxlambda:bind-event receiver :owned-command
                    (lambda (snapshot context)
                      (declare (ignore snapshot context))
                      (assert (eq condition (handler-case (wxlambda:process-event receiver e) (error (c) c))))
                      (incf continued)) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver :owned-command)
           (wxlambda:process-event receiver :owned-command)
           (assert (= 2 continued)))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event inner)
      (wxlambda:destroy-event e) (wxlambda:destroy-event-handler receiver))))

(expect-error (lambda () (wxlambda:make-event)) 'wxlambda:native-error)
(let (saved escaped expired)
  (wxlambda:with-application ()
    (wxlambda-owned-events:exercise)
    (wxlambda:register-event-type :owned-notify) (wxlambda:register-event-type :owned-notify-b)
    (wxlambda:register-event-type :owned-command :family :command)
    (check-mixed-event-ancestry)
    (check-owned-event-bounds)
    (check-nested-owned-contexts)
    (check-owned-queue-independence)
    (check-owned-callback-errors)
    (check-lazy-text-event-policy)
    (check-native-payload-versus-snapshot-scope)
    (let* ((receiver (wxlambda:make-event-handler))
           (e (wxlambda:make-event :class 'named-event :name "custom" :text "λ" :integer -1))
           (duplicate (wxlambda:clone-event e :class 'named-event)))
      (assert (string= "custom" (event-name e)))
      (assert (string= "default" (event-name duplicate)))
      (assert (eq :owned-notify (wxlambda:event-kind duplicate)))
      (assert (= -1 (wxlambda:event-integer duplicate)))
      (assert (null (wxlambda:event-origin-id duplicate)))
      (setf (wxlambda:event-id e) -1 (wxlambda:event-timestamp e) -1
            (wxlambda:event-text e) (concatenate 'string "λ" (string (code-char 0)) "copied")
            (wxlambda:event-integer e) -2147483648 (wxlambda:event-vetoed-p e) t
            (wxlambda:event-skipped-p e) t)
      (assert (= -1 (wxlambda:event-id e) (wxlambda:event-timestamp e)))
      (assert (wxlambda:event-vetoed-p e))
      (assert (wxlambda:event-skipped-p e))
      (assert (wxlambda:event-command-p e))
      (assert (= (wxlambda:event-category-mask :user-input) (wxlambda:event-category e)))
      (let ((level (wxlambda:stop-event-propagation e)))
        (assert (not (wxlambda:event-propagates-p e)))
        (assert (eq e (wxlambda:resume-event-propagation e level))))
      (assert (string= "λ" (wxlambda:event-text duplicate)))
      (setf (wxlambda:event-native-type e) (wxlambda:event-type :owned-notify-b))
      (assert (eq :owned-notify-b (wxlambda:event-kind e)))
      (expect-error (lambda () (setf (wxlambda:event-native-type e) (wxlambda:event-type :owned-command))) 'wxlambda:native-error)
      (expect-error (lambda () (setf (wxlambda:event-can-veto-p e) nil)) 'wxlambda:native-error)
      (expect-error (lambda () (setf (wxlambda:event-logging-off-p e) t)) 'wxlambda:native-error)
      (let ((binding (wxlambda:bind-event receiver :owned-notify-b
                       (lambda (snapshot context)
                         (setf saved snapshot expired context)
                         (assert (= -1 (wxlambda:event-id snapshot)))
                         (assert (wxlambda:event-vetoed-p snapshot))
                         (assert (wxlambda:event-text context))
                         (setf (wxlambda:event-integer context) 19
                               (wxlambda:event-text context) "live"
                               (wxlambda:event-vetoed-p context) nil)
                         (setf escaped (wxlambda:clone-event context))
                         ;; Dispatch owns a separate copy; original can die here.
                         (wxlambda:destroy-event e)) :with-context t)))
        (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event receiver e))))
        (assert (not (wxlambda:event-alive-p e)))
        (assert (= 19 (wxlambda:event-integer escaped)))
        (assert (string= "live" (wxlambda:event-text escaped)))
        (assert (null (wxlambda:event-origin-id escaped)))
        (assert (= -2147483648 (wxlambda:event-integer saved)))
        (expect-error (lambda () (wxlambda:clone-event expired)) 'wxlambda:native-error)
        (expect-error (lambda () (setf (wxlambda:event-integer expired) 2)) 'wxlambda:native-error)
        (expect-error (lambda () (setf (wxlambda:event-text expired) "bad")) 'wxlambda:native-error)
        (wxlambda:unbind-event binding))
      (expect-error (lambda () (wxlambda:destroy-event e)) 'wxlambda:native-error)
      (expect-error (lambda () (wxlambda:clone-event e)) 'wxlambda:native-error)
      (expect-error (lambda () (wxlambda:queue-event receiver e)) 'wxlambda:native-error)
      (expect-error (lambda () (wxlambda:process-event receiver escaped :text "override")))
      (expect-error (lambda () (wxlambda:clone-event escaped :integer 3)))
      (expect-error (lambda () (wxlambda:make-event :class 'wxlambda:frame)))
      (wxlambda:destroy-event duplicate)
      (wxlambda:destroy-event-handler receiver))
    (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session))
      (let ((e (wxlambda:make-event :kind kind)))
        (assert (eq kind (wxlambda:event-kind e)))
        (assert (zerop (wxlambda:event-id e)))
        (let ((copy (wxlambda:clone-event e)))
          (setf (wxlambda:event-id copy) 2147483647)
          (assert (zerop (wxlambda:event-id e)))
          (wxlambda:destroy-event copy))
        (when (member kind '(:close :query-end-session :end-session))
          (assert (null (wxlambda:event-text e)))
          (expect-error (lambda () (setf (wxlambda:event-text e) "bad")) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-integer e) 1)) 'wxlambda:native-error)
          (setf (wxlambda:event-vetoed-p e) t (wxlambda:event-can-veto-p e) nil)
          (assert (not (wxlambda:event-vetoed-p e)))
          (setf (wxlambda:event-can-veto-p e) t)
          (assert (wxlambda:event-vetoed-p e)))
        (when (member kind '(:query-end-session :end-session))
          (setf (wxlambda:event-logging-off-p e) :yes)
          (assert (wxlambda:event-logging-off-p e))
          (expect-error (lambda () (wxlambda:queue-event (wxlambda:current-application-handler) e)) 'wxlambda:native-error)
          (expect-error (lambda () (wxlambda:process-event (wxlambda:current-application-handler) e)) 'wxlambda:native-error)
          (let ((receiver (wxlambda:make-event-handler)))
            (assert (equal (list nil t) (multiple-value-list (wxlambda:process-event receiver e))))
            (wxlambda:queue-event receiver e)
            (wxlambda:process-pending-events)
            (wxlambda:destroy-event-handler receiver)))
        (wxlambda:destroy-event e)))
    (expect-error (lambda () (make-instance 'failing-event)))
    (assert (zerop (wxlambda::%event-alive *failed-event-id*)))
    (expect-error (lambda () (wxlambda:event-alive-p *failed-event*)) 'wxlambda:native-error)
    (wxlambda:process-events) ; wxFrame destruction is asynchronous.
    (assert (zerop (wxlambda::%handler-alive *nested-window-id*)))
    (expect-error (lambda () (make-instance 'failing-frame-with-event)))
    (assert (zerop (wxlambda::%event-alive *nested-event-id*)))
    ;; Escape one event without disposal: session cleanup owns the remaining native resource.
    (assert (wxlambda:event-alive-p escaped)))
  (assert (integerp (wxlambda:event-native-type saved)))
  (expect-error (lambda () (wxlambda:event-alive-p escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:clone-event escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:event-text escaped)) 'wxlambda:native-error))
(format t "PASS: owned CLOS events, detached clones, copy dispatch, payload mutation, rollback and session cleanup~%")
