(load (merge-pathnames "../examples/idle-events.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defun idle-data-gc ()
  #+sbcl (sb-ext:gc :full t)
  #+ccl (ccl:gc))
(defclass named-idle-event (wxlambda:owned-event)
  ((name :initarg :name :reader idle-event-name)
   (after-more :reader idle-after-more))
  (:default-initargs :kind :idle :more-requested-p t :name "idle default"))
(defmethod initialize-instance :after ((event named-idle-event) &key)
  (assert (wxlambda:event-alive-p event))
  (assert (eq :idle (wxlambda:event-family event)))
  (setf (slot-value event 'after-more) (wxlambda:event-more-requested-p event)))
(defvar *failed-idle-event-id*)
(defvar *failed-idle-frame-id*)
(defvar *failed-idle-nested-event-id*)
(defclass failing-idle-event (wxlambda:owned-event) () (:default-initargs :kind :idle))
(defmethod initialize-instance :after ((event failing-idle-event) &key)
  (setf *failed-idle-event-id* (wxlambda::handle event)
        (wxlambda:event-more-requested-p event) t
        *failed-idle-frame-id* (wxlambda::handle (wxlambda:make-frame)))
  (error "idle constructor failure"))
(defclass failing-frame-with-idle (wxlambda:frame) ())
(defmethod initialize-instance :after ((window failing-frame-with-idle) &key)
  (declare (ignore window))
  (setf *failed-idle-nested-event-id* (wxlambda::handle (wxlambda:make-event :kind :idle)))
  (error "frame with idle constructor failure"))

(defun check-idle-construction-and-errors ()
  (let ((event (wxlambda:make-event :class 'named-idle-event :name "custom idle")))
    (unwind-protect
         (progn
           (assert (eq :idle (wxlambda:event-kind event)))
           (assert (wxlambda:event-more-requested-p event))
           (assert (idle-after-more event))
           (assert (string= "custom idle" (idle-event-name event)))
           (setf (wxlambda:event-id event) 42 (wxlambda:event-timestamp event) -1)
           (assert (= 42 (wxlambda:event-id event)))
           (assert (= -1 (wxlambda:event-timestamp event)))
           (assert (null (wxlambda:event-text event)))
           (assert (zerop (wxlambda:event-integer event)))
           (assert (not (wxlambda:event-command-p event)))
           (assert (not (wxlambda:event-selection-p event)))
           (assert (null (wxlambda:event-selection event)))
           (assert (null (wxlambda:event-checked-p event)))
           (setf (wxlambda:event-more-requested-p event) nil)
           (let ((copy (wxlambda:clone-event event :class 'named-idle-event)))
             (assert (not (wxlambda:event-more-requested-p copy)))
             (assert (not (idle-after-more copy)))
             (assert (string= "idle default" (idle-event-name copy)))
             (assert (= 42 (wxlambda:event-id copy)))
             (wxlambda:destroy-event copy))
           (let ((copy (make-instance 'named-idle-event :clone-from event :more-requested-p t)))
             (assert (not (wxlambda:event-more-requested-p copy)))
             (wxlambda:destroy-event copy))
           (expect-error (lambda () (wxlambda:clone-event event :more-requested-p nil)))
           (expect-error (lambda () (wxlambda:make-event :clone-from event :more-requested-p t)))
           (expect-error (lambda () (setf (wxlambda:event-native-type event) (wxlambda:event-type :idle-test-command)))
                         'wxlambda:native-error)
           (expect-error (lambda () (setf (wxlambda:event-text event) "command payload")) 'wxlambda:native-error)
           (expect-error (lambda () (setf (wxlambda:event-integer event) 3)) 'wxlambda:native-error))
      (wxlambda:destroy-event event)))
  (expect-error (lambda () (wxlambda:register-event-type :idle)))
  (dolist (options '((:text "command") (:integer 0) (:checked-p t) (:selection 0)
                     (:can-veto-p nil) (:vetoed-p nil) (:logging-off-p nil) (:extra-long 0)))
    (expect-error (lambda () (apply #'wxlambda:make-event :kind :idle options))))
  (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session
                  :idle-test-command :idle-test-notify))
    (expect-error (lambda () (wxlambda:make-event :kind kind :more-requested-p nil)))
    (let ((event (wxlambda:make-event :kind kind)))
      (assert (not (wxlambda:event-more-requested-p event)))
      (expect-error (lambda () (setf (wxlambda:event-more-requested-p event) t)) 'wxlambda:native-error)
      (wxlambda:destroy-event event)))
  (expect-error (lambda () (make-instance 'failing-idle-event)))
  (assert (zerop (wxlambda::%event-alive *failed-idle-event-id*)))
  (wxlambda:process-events)
  (assert (zerop (wxlambda::%handler-alive *failed-idle-frame-id*)))
  (expect-error (lambda () (make-instance 'failing-frame-with-idle)))
  (assert (zerop (wxlambda::%event-alive *failed-idle-nested-event-id*))))

(defun check-idle-contexts-and-receiver-copies ()
  (let* ((receiver (wxlambda:make-event-handler)) (frame (wxlambda:make-frame))
         (app (wxlambda:current-application-handler))
         (source (wxlambda:make-event :kind :idle :more-requested-p t))
         (saved nil) (expired nil))
    (unwind-protect
         (progn
           (dolist (destination (list receiver frame app))
             (let ((binding (wxlambda:bind-event destination :idle
                              (lambda (snapshot context)
                                (setf saved snapshot expired context)
                                (assert (eq :idle (wxlambda:event-family snapshot)))
                                (assert (wxlambda:event-more-requested-p snapshot))
                                (assert (wxlambda:event-more-requested-p context))
                                (assert (eq :again (setf (wxlambda:event-more-requested-p context) :again)))
                                (setf (wxlambda:event-more-requested-p context) nil)
                                (assert (not (wxlambda:event-more-requested-p context)))
                                (assert (wxlambda:event-more-requested-p snapshot))) :with-context t)))
               (unwind-protect
                    (progn
                      (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event destination source))))
                      (assert (wxlambda:event-more-requested-p source))
                      (assert (wxlambda:event-more-requested-p saved))
                      (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-more-requested-p)) nil saved)))
                      (expect-error (lambda () (wxlambda:event-more-requested-p expired)) 'wxlambda:native-error)
                      (expect-error (lambda () (setf (wxlambda:event-more-requested-p expired) t)) 'wxlambda:native-error))
                 (wxlambda:unbind-event binding))))
           (let ((outer nil)
                 (inner-binding nil) (binding nil))
             (unwind-protect
                  (progn
                    (setf inner-binding
                          (wxlambda:bind-event receiver :idle-test-command
                            (lambda (snapshot context)
                              (assert (not (wxlambda:event-more-requested-p snapshot)))
                              (assert (not (wxlambda:event-more-requested-p context)))
                              (expect-error (lambda () (setf (wxlambda:event-more-requested-p context) t)) 'wxlambda:native-error)
                              (expect-error (lambda () (wxlambda:event-more-requested-p outer)) 'wxlambda:native-error)
                              (expect-error (lambda () (setf (wxlambda:event-more-requested-p outer) nil)) 'wxlambda:native-error)) :with-context t)
                          binding
                          (wxlambda:bind-event receiver :idle
                            (lambda (snapshot context)
                              (declare (ignore snapshot)) (setf outer context)
                              (wxlambda:process-event receiver :idle-test-command)
                              (assert (wxlambda:event-more-requested-p context))) :with-context t))
                    (wxlambda:process-event receiver source))
               (when binding (wxlambda:unbind-event binding))
               (when inner-binding (wxlambda:unbind-event inner-binding))))
           (let ((flag t) (binding nil))
             (unwind-protect
                  (progn
                    (setf binding (wxlambda:bind-event receiver :idle
                                    (lambda (snapshot) (setf flag (wxlambda:event-more-requested-p snapshot)))))
                    (wxlambda:process-event receiver :idle)
                    (assert (not flag))
                    (wxlambda:queue-event receiver :idle)
                    (wxlambda:process-pending-events)
                    (assert (not flag))
                    (expect-error (lambda () (wxlambda:process-event receiver :idle :more-requested-p t)))
                    (expect-error (lambda () (wxlambda:queue-event receiver :idle :more-requested-p t))))
               (when binding (wxlambda:unbind-event binding))))
           (values saved expired))
      (wxlambda:destroy-event source) (wxlambda:destroy-event-handler receiver)
      (wxlambda:destroy-window frame))))

(defun check-idle-queue-and-transfer ()
  (let* ((receiver (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :idle :more-requested-p t))
         (copy (wxlambda:clone-event source)) (saved nil)
         (binding (wxlambda:bind-event receiver :idle (lambda (snapshot) (push snapshot saved)))))
    (unwind-protect
         (progn
           (wxlambda:queue-event receiver source)
           (setf (wxlambda:event-more-requested-p source) nil)
           (wxlambda:post-event receiver copy)
           (wxlambda:transfer-event receiver copy)
           (assert (not (wxlambda:event-alive-p copy)))
           (setf copy nil)
           (wxlambda:process-pending-events)
           (assert (= 3 (length saved)))
           (assert (every #'wxlambda:event-more-requested-p saved))
           (assert (not (wxlambda:event-more-requested-p source)))
           (wxlambda:process-event-locally receiver source)
           (assert (not (wxlambda:event-more-requested-p (first saved)))))
      (when copy (wxlambda:destroy-event copy))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler receiver))))

(defun check-idle-userdata-and-chain-routing ()
  (let* ((a (wxlambda:make-event-handler)) (b (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :idle :more-requested-p t))
         (datum (list :idle-data)) (calls 0)
         (binding (wxlambda:bind-event b :idle
                    (lambda (snapshot context)
                      (incf calls)
                      (assert (eq datum (wxlambda:event-user-data snapshot)))
                      (assert (eq datum (wxlambda:event-user-data context)))
                      (idle-data-gc)
                      (assert (eq datum (wxlambda:event-user-data context)))
                      (expect-error (lambda () (wxlambda:clone-event context)) 'wxlambda:native-error)
                      (setf (wxlambda:event-more-requested-p context) nil)) :with-context t :user-data datum)))
    (setf (wxlambda:next-handler a) b)
    (unwind-protect
         (progn
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event a source))))
           (assert (= 1 calls))
           (assert (wxlambda:event-more-requested-p source)))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler a) (wxlambda:destroy-event-handler b))))

(defun check-idle-pushed-window-routing ()
  (let* ((window (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :idle :more-requested-p t))
         (origins nil)
         (binding (wxlambda:bind-event handler :idle
                    (lambda (snapshot context)
                      (assert (eq handler (wxlambda:event-source snapshot)))
                      (assert (eql 0 (wxlambda:event-user-data snapshot)))
                      (assert (eql 0 (wxlambda:event-user-data context)))
                      (push (wxlambda:event-origin-id snapshot) origins)
                      (assert (wxlambda:event-more-requested-p snapshot))
                      (setf (wxlambda:event-more-requested-p context) nil)
                      (expect-error (lambda () (wxlambda:clone-event context)) 'wxlambda:native-error))
                    :with-context t :user-data 0)))
    (wxlambda:push-event-handler window handler)
    (unwind-protect
         (progn
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-window-event window source))))
           (assert (equal '(t nil) (multiple-value-list (wxlambda:process-window-event-locally window source))))
           (assert (= 2 (length origins)))
           (assert (every (lambda (origin) (= (wxlambda::handle window) origin)) origins))
           (wxlambda:queue-event handler source)
           (wxlambda:process-pending-events)
           (assert (= 3 (length origins)))
           (assert (= (wxlambda::handle handler) (first origins)))
           (assert (wxlambda:event-more-requested-p source)))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler handler) (wxlambda:destroy-window window))))

(defun check-idle-modes-and-window-policy ()
  (let* ((mode (wxlambda:idle-mode)) (window (wxlambda:make-frame))
         (source (wxlambda:make-event :kind :idle)) (calls 0)
         (name (wxlambda:window-name window))
         (binding (wxlambda:bind-event window :idle
                    (lambda (snapshot context)
                      (declare (ignore snapshot context)) (incf calls)) :with-context t)))
    (unwind-protect
         (progn
           (dolist (value '(:all :specified))
             (assert (eq value (setf (wxlambda:idle-mode) value)))
             (assert (eq value (wxlambda:idle-mode))))
           (dolist (bad '(nil :invalid 0 "all"))
             (expect-error (lambda () (setf (wxlambda:idle-mode) bad)))
             (assert (eq :specified (wxlambda:idle-mode))))
           (setf (wxlambda:window-process-idle-p window) nil)
           (assert (not (wxlambda:window-process-idle-p window)))
           ;; The own style bit is independent of global mode and explicit dispatch.
           (wxlambda:process-window-event window source)
           (wxlambda:process-event window source)
           (wxlambda:process-event-locally window source)
           (wxlambda:queue-event window source)
           (wxlambda:process-pending-events)
           (assert (= 4 calls))
           (setf (wxlambda:idle-mode) :all)
           (assert (not (wxlambda:window-process-idle-p window)))
           (assert (eq :enabled (setf (wxlambda:window-process-idle-p window) :enabled)))
           (assert (wxlambda:window-process-idle-p window))
           (setf (wxlambda:window-process-idle-p window) nil)
           (assert (string= name (wxlambda:window-name window)))
           (dolist (invalid (list (wxlambda:current-application-handler) source))
             (expect-error (lambda () (wxlambda:window-process-idle-p invalid)))
             (expect-error (lambda () (setf (wxlambda:window-process-idle-p invalid) t)))))
      (setf (wxlambda:idle-mode) mode)
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-window window))))

(defun check-bounded-native-idle-delivery ()
  (let* ((mode (wxlambda:idle-mode)) (app (wxlambda:current-application-handler))
         (calls 0) (requested nil) (clone nil) (binding nil))
    (unwind-protect
         (progn
           (setf (wxlambda:idle-mode) :all
                 binding (wxlambda:bind-event app :idle
                           (lambda (snapshot context)
                             (incf calls)
                             (assert (eq :idle (wxlambda:event-family snapshot)))
                             (assert (not (wxlambda:event-command-p snapshot)))
                             (unless requested
                               (setf requested t
                                     (wxlambda:event-more-requested-p context) t
                                     clone (wxlambda:clone-event context)))) :with-context t))
           (assert (wxlambda:wake-up-idle))
           (assert (zerop calls)) ; scheduling never invokes the callback inline
           (wxlambda:process-pending-events)
           (assert (zerop calls)) ; pending-only dispatch does not generate idle events
           (loop repeat 8 until (plusp calls) do (wxlambda:process-events))
           (assert (plusp calls))
           (assert requested)
           (assert clone)
           (assert (wxlambda:event-more-requested-p clone))
           (let ((before calls))
             (wxlambda:process-pending-events)
             (assert (= before calls))))
      (when binding (wxlambda:unbind-event binding))
      (when clone (wxlambda:destroy-event clone))
      (setf (wxlambda:idle-mode) mode))))

(expect-error #'wxlambda:idle-mode 'wxlambda:native-error)
(expect-error #'wxlambda:wake-up-idle 'wxlambda:native-error)
(let (saved expired escaped-window)
  (wxlambda:with-application ()
    (assert (wxlambda-idle-events:exercise))
    (wxlambda:register-event-type :idle-test-command :family :command)
    (wxlambda:register-event-type :idle-test-notify)
    (check-idle-construction-and-errors)
    (multiple-value-setq (saved expired) (check-idle-contexts-and-receiver-copies))
    (check-idle-queue-and-transfer)
    (check-idle-userdata-and-chain-routing)
    (check-idle-pushed-window-routing)
    (check-idle-modes-and-window-policy)
    (check-bounded-native-idle-delivery)
    (setf escaped-window (wxlambda:make-frame)))
  (assert (wxlambda:event-more-requested-p saved))
  (expect-error (lambda () (wxlambda:event-more-requested-p expired)) 'wxlambda:native-error)
  (expect-error (lambda () (setf (wxlambda:event-more-requested-p expired) nil)) 'wxlambda:native-error)
  (expect-error #'wxlambda:idle-mode 'wxlambda:native-error)
  (expect-error (lambda () (setf (wxlambda:idle-mode) :all)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:window-process-idle-p escaped-window)) 'wxlambda:native-error))
(format t "PASS: idle event snapshots/contexts, owned delivery, bounded native idle and scheduling/policy guards~%")
