(load (merge-pathnames "../examples/event-routing.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(let (saved expired outer)
  (wxlambda:with-application ()
    (wxlambda-event-routing:exercise)
    (wxlambda:register-event-type :routing-notify)
    (let ((receiver (wxlambda:make-event-handler)))
      (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session :routing-notify))
        (let ((binding (wxlambda:bind-event receiver kind
                         (lambda (event context)
                           (setf saved event expired context)
                           (assert (= 123 (wxlambda:event-id event) (wxlambda:event-id context)))
                           (dolist (id '(-2147483648 -1 0 2147483647))
                             (assert (= id (setf (wxlambda:event-id context) id)))
                             (assert (= id (wxlambda:event-id context))))
                           (dolist (bad '(-2147483649 2147483648 1/2 nil))
                             (expect-error (lambda () (setf (wxlambda:event-id context) bad)) 'type-error))
                           (assert (= 2147483647 (wxlambda:event-id context)))
                           (assert (= 123 (wxlambda:event-id event)))) :id 123 :with-context t)))
          (wxlambda:process-event receiver kind :id 123)
          (expect-error (lambda () (wxlambda:event-id expired)) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-id expired) 0)) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-id saved) 0)))
          (wxlambda:unbind-event binding)))
      (let* ((inner (wxlambda:bind-event receiver :click
                      (lambda (e c)
                        (declare (ignore e c))
                        (expect-error (lambda () (wxlambda:event-id outer)) 'wxlambda:native-error)
                        (expect-error (lambda () (setf (wxlambda:event-id outer) 0)) 'wxlambda:native-error)) :with-context t))
             (binding (wxlambda:bind-event receiver :close
                        (lambda (e c)
                          (declare (ignore e))
                          (setf outer c (wxlambda:event-id c) -1)
                          (wxlambda:process-event receiver :click)
                          (assert (= -1 (wxlambda:event-id c)))) :with-context t)))
        (wxlambda:process-event receiver :close)
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      (wxlambda:destroy-event-handler receiver))
    ;; Parent routing establishes callback order without assuming local Bind ordering.
    (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
           (child (wxlambda:make-button panel)) (destination 42) (forward t)
           (old-calls 0) (new-calls 0) (range-calls 0) (any-calls 0)
           (old (wxlambda:bind-event panel :routed-command (lambda (e) (declare (ignore e)) (incf old-calls)) :id 10))
           (new (wxlambda:bind-event panel :routed-command (lambda (e) (setf saved e) (incf new-calls)) :id 42))
           (range (wxlambda:bind-event panel :routed-command (lambda (e) (declare (ignore e)) (incf range-calls)) :id 40 :last-id 45))
           (any (wxlambda:bind-event panel :routed-command (lambda (e) (declare (ignore e)) (incf any-calls))))
           (mutator (wxlambda:bind-event child :routed-command
                      (lambda (e c)
                        (assert (= 10 (wxlambda:event-id e)))
                        (setf (wxlambda:event-id c) destination (wxlambda:event-skipped-p c) forward))
                      :id 10 :with-context t)))
      (wxlambda:process-event child :routed-command :id 10)
      (assert (equal '(0 1 1 1) (list old-calls new-calls range-calls any-calls)))
      (assert (= 42 (wxlambda:event-id saved)))
      (setf forward nil)
      (assert (first (multiple-value-list (wxlambda:process-event child :routed-command :id 10))))
      (assert (= 1 any-calls))
      (setf destination -1 forward t)
      (wxlambda:queue-event child :routed-command :id 10)
      (wxlambda:process-pending-events)
      (assert (equal '(0 1 1 2) (list old-calls new-calls range-calls any-calls)))
      ;; Binding filters and synthetic initial IDs retain their explicit -1 restriction.
      (expect-error (lambda () (wxlambda:bind-event child :routed-command #'identity :id -1)))
      (expect-error (lambda () (wxlambda:process-event child :routed-command :id -1)))
      (dolist (binding (list mutator any range new old)) (wxlambda:unbind-event binding))
      (wxlambda:destroy-window frame)))
  (assert (= 42 (wxlambda:event-id saved)))
  (expect-error (lambda () (wxlambda:event-id expired)) 'wxlambda:native-error))
(format t "PASS: scoped native ID mutation, snapshot isolation, signed bounds and parent exact/range/wildcard routing~%")
