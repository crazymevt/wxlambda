(load (merge-pathnames "../examples/numeric-input.lisp" *load-truename*))
(defun numeric-expect-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-slider (wxlambda:slider) ((tag :initarg :tag :reader numeric-tag))
  (:default-initargs :minimum -10 :maximum 10 :value 3 :orientation :vertical :tag :slider))
(defclass named-spin (wxlambda:spin-control) ((tag :initarg :tag :reader numeric-tag))
  (:default-initargs :minimum -10 :maximum 10 :value 3 :tag :spin))
(defmethod initialize-instance :after ((control named-slider) &key)
  (assert (= 3 (wxlambda:numeric-value control)))
  (assert (eq :vertical (wxlambda:slider-orientation control))))
(defmethod initialize-instance :after ((control named-spin) &key)
  (assert (equal '(-10 10) (wxlambda:numeric-range control))))
(defclass invalid-numeric (wxlambda:slider wxlambda:spin-control) ())
(defvar *failed-numeric-id* nil)
(defclass failed-spin (wxlambda:spin-control) ())
(defmethod initialize-instance :after ((control failed-spin) &key)
  (setf *failed-numeric-id* (wxlambda::handle control))
  (wxlambda:bind-event control :spin-change (lambda (event) (declare (ignore event))))
  (error "Expected numeric initialization rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-numeric-input:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (slider (wxlambda:make-slider panel :class 'named-slider :tag :factory))
         (spin (make-instance 'named-spin :parent panel)) (events nil) (context nil))
    (assert (eq :factory (numeric-tag slider)))
    (assert (eq :spin (numeric-tag spin)))
    (numeric-expect-error (lambda () (make-instance 'invalid-numeric :parent panel)))
    (numeric-expect-error (lambda () (wxlambda:make-slider panel :class 'wxlambda:spin-control)))
    (dolist (args '((:minimum 1 :maximum 1) (:minimum -1000001) (:maximum 1000001) (:value 101)))
      (numeric-expect-error (lambda () (apply #'wxlambda:make-slider panel args)))
      (numeric-expect-error (lambda () (apply #'wxlambda:make-spin-control panel args))))
    (numeric-expect-error (lambda () (wxlambda:make-slider panel :orientation :bad)))
    (numeric-expect-error (lambda () (wxlambda:make-spin-control panel :orientation :vertical)))
    (dolist (pair (list (cons slider :slider-change) (cons spin :spin-change)))
      (let* ((control (car pair)) (kind (cdr pair))
             (binding (wxlambda:bind-event frame kind
                        (lambda (event current)
                          (push event events) (setf context current)
                          (numeric-expect-error (lambda () (wxlambda:clone-event current)) 'wxlambda:native-error)
                          (assert (= -2 (wxlambda:event-numeric-value event) (wxlambda:event-numeric-value current)))
                          (assert (null (wxlambda:event-selection event)))
                          (assert (eq (if (eq kind :spin-change) :notify :command) (wxlambda:event-family event)))
                          (dolist (operation (list (lambda () (setf (wxlambda:numeric-value control) 0))
                                                  (lambda () (setf (wxlambda:numeric-range control) '(0 5)))
                                                  (lambda () (wxlambda:destroy-window control))
                                                  (lambda () (wxlambda:destroy-window panel))
                                                  (lambda () (wxlambda:close-window frame))
                                                  (lambda () (wxlambda:clipboard-text-available-p))
                                                  #'wxlambda:process-events))
                            (numeric-expect-error operation 'wxlambda:native-error))
                          (when (eq kind :spin-change) (setf (wxlambda:event-vetoed-p current) t)))
                        :with-context t)))
        (setf (wxlambda:numeric-value control) 4)
        (assert (null events))
        (assert (= -2 (setf (wxlambda:numeric-value control :notify t) -2)))
        (assert (= -2 (wxlambda:numeric-value control))) ; spin veto is observational
        (numeric-expect-error (lambda () (wxlambda:event-numeric-value context)) 'wxlambda:native-error)
        (wxlambda:unbind-event binding)
        (let ((range (list 0 5)))
          (assert (eq range (setf (wxlambda:numeric-range control) range)))
          (setf (car range) 1)
          (assert (equal '(0 5) (wxlambda:numeric-range control)))
          (assert (= 0 (wxlambda:numeric-value control))))
        (setf events nil)
        (dolist (value '(-1 6 1.5 nil 1000001))
          (numeric-expect-error (lambda () (setf (wxlambda:numeric-value control) value))))
        (dolist (range '(nil (1 1) (2 1) (-1000001 5) (0 1000001) (0 1 2) (0 . 1)))
          (numeric-expect-error (lambda () (setf (wxlambda:numeric-range control) range))))
        (dolist (operation (list (lambda () (wxlambda:make-event :kind kind))
                                (lambda () (wxlambda:process-event control kind))
                                (lambda () (wxlambda:register-event-type kind))))
          (numeric-expect-error operation))))
    (let ((button (wxlambda:make-button panel)))
      (wxlambda:bind-event button :click
        (lambda (event current)
          (assert (null (wxlambda:event-numeric-value event)))
          (numeric-expect-error (lambda () (wxlambda:event-numeric-value current)) 'wxlambda:native-error)) :with-context t)
      (wxlambda:process-event button :click))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (numeric-expect-error (lambda () (make-instance 'failed-spin :parent panel)))
      (wxlambda:process-events)
      (assert (= roots (hash-table-count wxlambda::*event-bindings*)))
      (assert (zerop (wxlambda::%handler-alive *failed-numeric-id*))))
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (dolist (control (list slider spin))
      (numeric-expect-error (lambda () (wxlambda:numeric-value control)) 'wxlambda:native-error)
      (numeric-expect-error (lambda () (setf (wxlambda:numeric-range control) '(0 5))) 'wxlambda:native-error))))
(format t "PASS: bounded slider/spin construction/properties, silent clamp, notified snapshots, cross-control sync, lifetime/veto/rollback checks~%")
