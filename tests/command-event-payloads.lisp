(load (merge-pathnames "../examples/command-event-payloads.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass extra-default-event (wxlambda:owned-event)
  ((name :initarg :name :reader extra-event-name))
  (:default-initargs :kind :close :extra-long 99 :name "extra default"))

(defun check-extra-long-bounds-and-cloning ()
  (let* ((bits (* 8 (cffi:foreign-type-size :long)))
         (minimum (- (ash 1 (1- bits)))) (maximum (1- (ash 1 (1- bits)))))
    (dolist (kind '(:payload-test-command :payload-test-notify))
      (let ((event (wxlambda:make-event :kind kind :extra-long minimum :integer 42)))
        (unwind-protect
             (progn
               (assert (= minimum (wxlambda:event-extra-long event)))
               (assert (wxlambda:event-selection-p event))
               (assert (null (wxlambda:event-selection event)))
               (assert (null (wxlambda:event-checked-p event)))
               (dolist (value (list minimum -1 0 1 maximum))
                 (assert (= value (setf (wxlambda:event-extra-long event) value)))
                 (assert (= value (wxlambda:event-extra-long event)))
                 (assert (eql (not (zerop value)) (wxlambda:event-selection-p event))))
               (dolist (bad (list (1- minimum) (1+ maximum) 1/2 "bad" nil))
                 (expect-error (lambda () (setf (wxlambda:event-extra-long event) bad)) 'type-error)
                 (expect-error (lambda () (wxlambda:make-event :kind kind :extra-long bad)) 'type-error))
               (assert (= maximum (wxlambda:event-extra-long event)))
               (let ((copy (wxlambda:clone-event event :class 'extra-default-event)))
                 (assert (eq kind (wxlambda:event-kind copy)))
                 (assert (= maximum (wxlambda:event-extra-long copy)))
                 (assert (string= "extra default" (extra-event-name copy)))
                 (wxlambda:destroy-event copy))
               (let ((copy (make-instance 'extra-default-event :clone-from event :extra-long 0 :name "source wins")))
                 (assert (= maximum (wxlambda:event-extra-long copy)))
                 (assert (string= "source wins" (extra-event-name copy)))
                 (wxlambda:destroy-event copy))
               (expect-error (lambda () (wxlambda:clone-event event :extra-long 0)))
               (expect-error (lambda () (wxlambda:make-event :clone-from event :extra-long 0))))
          (wxlambda:destroy-event event))))
    (dolist (kind '(:click :text-change :toggle :selection))
      (let ((event (wxlambda:make-event :kind kind :extra-long 5)))
        (assert (= 5 (wxlambda:event-extra-long event)))
        (assert (wxlambda:event-selection-p event))
        (wxlambda:destroy-event event)))
    (dolist (kind '(:close :query-end-session :end-session))
      (expect-error (lambda () (wxlambda:make-event :kind kind :extra-long 0)))
      (let ((event (wxlambda:make-event :kind kind)))
        (assert (zerop (wxlambda:event-extra-long event)))
        (assert (not (wxlambda:event-selection-p event)))
        (expect-error (lambda () (setf (wxlambda:event-extra-long event) 0)) 'wxlambda:native-error)
        (wxlambda:destroy-event event)))))

(defun check-semantic-owned-command-properties ()
  (let ((toggle (wxlambda:make-event :kind :toggle))
        (choice (wxlambda:make-event :kind :selection))
        (click (wxlambda:make-event :kind :click)))
    (unwind-protect
         (progn
           (assert (not (wxlambda:event-checked-p toggle)))
           (assert (eq :yes (setf (wxlambda:event-checked-p toggle) :yes)))
           (assert (= 1 (wxlambda:event-integer toggle)))
           (assert (wxlambda:event-checked-p toggle))
           (setf (wxlambda:event-integer toggle) -3)
           (assert (wxlambda:event-checked-p toggle))
           (assert (null (setf (wxlambda:event-checked-p toggle) nil)))
           (assert (zerop (wxlambda:event-integer toggle)))
           (assert (null (wxlambda:event-selection choice)))
           (dolist (value '(0 2147483647 nil))
             (assert (eql value (setf (wxlambda:event-selection choice) value)))
             (assert (eql value (wxlambda:event-selection choice))))
           (dolist (bad '(-1 -3 2147483648 1/2 "bad"))
             (expect-error (lambda () (setf (wxlambda:event-selection choice) bad)) 'type-error))
           (assert (null (wxlambda:event-selection choice)))
           (setf (wxlambda:event-integer choice) -3)
           (assert (= -3 (wxlambda:event-selection choice)))
           (assert (not (wxlambda:event-selection-p choice)))
           (setf (wxlambda:event-extra-long choice) -1)
           (assert (wxlambda:event-selection-p choice))
           (assert (= -3 (wxlambda:event-selection choice)))
           (setf (wxlambda:event-integer click) 7 (wxlambda:event-extra-long click) 1)
           (assert (null (wxlambda:event-checked-p click)))
           (assert (null (wxlambda:event-selection click)))
           (assert (wxlambda:event-selection-p click))
           (dolist (event (list choice click))
             (expect-error (lambda () (setf (wxlambda:event-checked-p event) t)) 'wxlambda:native-error))
           (dolist (event (list toggle click))
             (expect-error (lambda () (setf (wxlambda:event-selection event) 0)) 'wxlambda:native-error)))
      (wxlambda:destroy-event click) (wxlambda:destroy-event choice) (wxlambda:destroy-event toggle))))

(defun check-payload-contexts-and-origin-clear ()
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel))
         (source (wxlambda:make-event :kind :payload-test-command :id 42 :integer 13 :extra-long -1))
         (before nil) (after nil) (expired nil)
         (parent (wxlambda:bind-event panel :payload-test-command (lambda (snapshot) (setf after snapshot))))
         (binding (wxlambda:bind-event child :payload-test-command
                    (lambda (snapshot context)
                      (setf before snapshot expired context)
                      (assert (= -1 (wxlambda:event-extra-long snapshot) (wxlambda:event-extra-long context)))
                      (assert (wxlambda:event-selection-p snapshot))
                      (assert (= (wxlambda::handle child) (wxlambda:event-origin-id snapshot)
                                 (wxlambda:event-origin-id context)))
                      (dolist (bad (list 0 (wxlambda::handle child) child :origin))
                        (expect-error (lambda () (setf (wxlambda:event-origin-id context) bad))))
                      (assert (null (setf (wxlambda:event-origin-id context) nil)))
                      (assert (null (wxlambda:event-origin-id context)))
                      (assert (eq child (wxlambda:event-source snapshot)))
                      (assert (wxlambda:handler-alive-p child))
                      (setf (wxlambda:event-extra-long context) 0)
                      (assert (not (wxlambda:event-selection-p context)))
                      (assert (wxlambda:event-selection-p snapshot))
                      (assert (= 13 (wxlambda:event-integer context)))
                      (setf (wxlambda:event-skipped-p context) t)) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event child source)
           (assert before) (assert after)
           (assert (eq panel (wxlambda:event-source after)))
           (assert (null (wxlambda:event-origin-id after)))
           (assert (zerop (wxlambda:event-extra-long after)))
           (assert (not (wxlambda:event-selection-p after)))
           (assert (= (wxlambda::handle child) (wxlambda:event-origin-id before)))
           (assert (= 42 (wxlambda:event-id before) (wxlambda:event-id after)))
           (assert (eq :payload-test-command (wxlambda:event-kind after)))
           (assert (wxlambda:handler-alive-p child))
           (dolist (property '(wxlambda:event-extra-long wxlambda:event-checked-p
                               wxlambda:event-selection wxlambda:event-origin-id))
             (expect-error (lambda () (funcall (fdefinition (list 'setf property)) nil before))))
           (expect-error (lambda () (wxlambda:event-extra-long expired)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:event-selection-p expired)) 'wxlambda:native-error)
           (expect-error (lambda () (setf (wxlambda:event-extra-long expired) 1)) 'wxlambda:native-error)
           (expect-error (lambda () (setf (wxlambda:event-origin-id expired) nil)) 'wxlambda:native-error)
           (values before after expired))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event parent)
      (wxlambda:destroy-event source) (wxlambda:destroy-window frame))))

(defun check-kind-and-origin-restrictions ()
  (let ((receiver (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session))
             (let ((event (wxlambda:make-event :kind kind))
                   (binding (wxlambda:bind-event receiver kind
                              (lambda (snapshot context)
                                (assert (wxlambda:event-origin-id snapshot))
                                (expect-error (lambda () (setf (wxlambda:event-origin-id context) nil)) 'wxlambda:native-error)
                                (assert (wxlambda:event-origin-id context))) :with-context t)))
               (unwind-protect
                    (progn
                      (assert (null (setf (wxlambda:event-origin-id event) nil)))
                      (assert (null (wxlambda:event-origin-id event)))
                      (expect-error (lambda () (setf (wxlambda:event-origin-id event) 0)))
                      (wxlambda:process-event receiver event))
                 (wxlambda:unbind-event binding) (wxlambda:destroy-event event))))
           (let* ((event (wxlambda:make-event :kind :payload-test-notify :extra-long 31))
                  (binding (wxlambda:bind-event receiver :payload-test-notify
                             (lambda (snapshot context)
                               (assert (= 31 (wxlambda:event-extra-long snapshot)))
                               (assert (wxlambda:event-selection-p snapshot))
                               (setf (wxlambda:event-origin-id context) nil
                                     (wxlambda:event-extra-long context) -1)
                               (assert (null (wxlambda:event-origin-id context)))
                               (assert (wxlambda:event-selection-p context))) :with-context t)))
             (unwind-protect
                  (progn (wxlambda:process-event receiver event)
                         (assert (= 31 (wxlambda:event-extra-long event))))
               (wxlambda:unbind-event binding) (wxlambda:destroy-event event))))
      (wxlambda:destroy-event-handler receiver))))

(defun check-nested-payload-context-guards ()
  (let* ((receiver (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :payload-test-command :extra-long 17))
         (outer nil)
         (inner (wxlambda:bind-event receiver :payload-test-notify
                  (lambda (snapshot context)
                    (declare (ignore snapshot context))
                    (expect-error (lambda () (wxlambda:event-extra-long outer)) 'wxlambda:native-error)
                    (expect-error (lambda () (wxlambda:event-selection-p outer)) 'wxlambda:native-error)
                    (expect-error (lambda () (setf (wxlambda:event-extra-long outer) 1)) 'wxlambda:native-error)
                    (expect-error (lambda () (setf (wxlambda:event-origin-id outer) nil)) 'wxlambda:native-error)) :with-context t))
         (binding (wxlambda:bind-event receiver :payload-test-command
                    (lambda (snapshot context)
                      (declare (ignore snapshot)) (setf outer context)
                      (wxlambda:process-event receiver :payload-test-notify)
                      (assert (= 17 (wxlambda:event-extra-long context)))
                      (assert (wxlambda:event-origin-id context))) :with-context t)))
    (unwind-protect (wxlambda:process-event receiver source)
      (wxlambda:unbind-event binding) (wxlambda:unbind-event inner)
      (wxlambda:destroy-event source) (wxlambda:destroy-event-handler receiver))))

(defun check-payload-copy-and-transfer-metadata (kind)
  (let* ((receiver (wxlambda:make-event-handler))
         (bits (* 8 (cffi:foreign-type-size :long)))
         (minimum (- (ash 1 (1- bits)))) (maximum (1- (ash 1 (1- bits))))
         (source (wxlambda:make-event :kind kind :extra-long minimum))
         (copy (wxlambda:clone-event source)) (captured nil)
         (binding (wxlambda:bind-event receiver kind
                    (lambda (snapshot) (push snapshot captured)))))
    (unwind-protect
         (progn
           (assert (= minimum (wxlambda:event-extra-long copy)))
           (wxlambda:queue-event receiver source)
           (setf (wxlambda:event-extra-long source) 0)
           (wxlambda:post-event receiver copy)
           (setf (wxlambda:event-extra-long copy) maximum)
           (wxlambda:transfer-event receiver copy)
           (assert (not (wxlambda:event-alive-p copy)))
           (setf copy nil)
           (wxlambda:process-pending-events)
           (assert (= 3 (length captured)))
           (assert (equal (sort (list minimum minimum maximum) #'<)
                          (sort (mapcar #'wxlambda:event-extra-long captured) #'<)))
           (assert (every #'wxlambda:event-selection-p captured))
           (assert (every (lambda (snapshot) (null (wxlambda:event-selection snapshot))) captured))
           (wxlambda:process-event receiver source)
           (assert (zerop (wxlambda:event-extra-long (first captured))))
           (assert (not (wxlambda:event-selection-p (first captured))))
           (setf (wxlambda:event-extra-long source) -1)
           (wxlambda:process-event-locally receiver source)
           (assert (= -1 (wxlambda:event-extra-long (first captured))))
           (assert (wxlambda:event-selection-p (first captured))))
      (when copy (wxlambda:destroy-event copy))
      (wxlambda:unbind-event binding) (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler receiver))))

(defun check-control-state-and-convenience-snapshots ()
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (button (wxlambda:make-button panel)) (text (wxlambda:make-text panel))
         (checkbox (wxlambda:make-checkbox panel :checked t))
         (choice (wxlambda:make-choice panel :items '("One" "Two") :selection 1))
         (toggle-source (wxlambda:make-event :kind :toggle :checked-p nil))
         (choice-source (wxlambda:make-event :kind :selection :selection 0))
         (captured nil) (toggle-binding nil) (choice-binding nil))
    (unwind-protect
         (progn
           (flet ((capture (snapshot)
                    (setf captured snapshot)
                    (assert (zerop (wxlambda:event-extra-long snapshot)))
                    (assert (not (wxlambda:event-selection-p snapshot)))))
             (wxlambda:on-click button #'capture :with-event t)
             (wxlambda:on-text-change text #'capture)
             (wxlambda:on-toggle checkbox #'capture)
             (wxlambda:on-selection choice #'capture)
             ;; All four convenience native aggregates must carry both new fields.
             (dolist (pair (list (list button :click) (list text :text-change)
                                (list checkbox :toggle) (list choice :selection)))
               (setf captured nil)
               (wxlambda:process-event (first pair) (second pair))
               (assert captured)))
           (wxlambda:off-click button) (wxlambda:off-text-change text)
           (wxlambda:off-toggle checkbox) (wxlambda:off-selection choice)
           (setf toggle-binding
                 (wxlambda:bind-event checkbox :toggle
                   (lambda (snapshot context)
                     (assert (not (wxlambda:event-checked-p snapshot)))
                     (setf (wxlambda:event-checked-p context) nil)
                     (assert (wxlambda:checked-p checkbox))
                     (setf (wxlambda:event-checked-p context) :yes)
                     (assert (= 1 (wxlambda:event-integer context)))
                     (assert (wxlambda:event-checked-p context))
                     (assert (not (wxlambda:event-checked-p snapshot)))) :with-context t)
                 choice-binding
                 (wxlambda:bind-event choice :selection
                   (lambda (snapshot context)
                     (assert (zerop (wxlambda:event-selection snapshot)))
                     (assert (not (wxlambda:event-selection-p context)))
                     (setf (wxlambda:event-selection context) nil)
                     (assert (= -1 (wxlambda:event-integer context)))
                     (assert (= 1 (wxlambda:selection choice)))
                     (setf (wxlambda:event-selection context) 42)
                     (assert (= 42 (wxlambda:event-selection context)))
                     (assert (zerop (wxlambda:event-selection snapshot)))) :with-context t))
           (wxlambda:process-event checkbox toggle-source)
           (wxlambda:process-event choice choice-source)
           (assert (wxlambda:checked-p checkbox))
           (assert (= 1 (wxlambda:selection choice))))
      (when toggle-binding (wxlambda:unbind-event toggle-binding))
      (when choice-binding (wxlambda:unbind-event choice-binding))
      (wxlambda:off-click button) (wxlambda:off-text-change text)
      (wxlambda:off-toggle checkbox) (wxlambda:off-selection choice)
      (wxlambda:destroy-event toggle-source) (wxlambda:destroy-event choice-source)
      (wxlambda:destroy-window frame))))

(let (saved later expired)
  (wxlambda:with-application ()
    (wxlambda-command-event-payloads:exercise)
    (wxlambda:register-event-type :payload-test-command :family :command)
    (wxlambda:register-event-type :payload-test-notify)
    (check-extra-long-bounds-and-cloning)
    (check-semantic-owned-command-properties)
    (multiple-value-setq (saved later expired) (check-payload-contexts-and-origin-clear))
    (check-kind-and-origin-restrictions)
    (check-nested-payload-context-guards)
    (check-payload-copy-and-transfer-metadata :payload-test-command)
    (check-payload-copy-and-transfer-metadata :payload-test-notify)
    (check-control-state-and-convenience-snapshots))
  (assert (= -1 (wxlambda:event-extra-long saved)))
  (assert (wxlambda:event-selection-p saved))
  (assert (null (wxlambda:event-origin-id later)))
  (expect-error (lambda () (wxlambda:event-extra-long expired)) 'wxlambda:native-error)
  (expect-error (lambda () (setf (wxlambda:event-origin-id expired) nil)) 'wxlambda:native-error))
(format t "PASS: command extra-long/selection flags, semantic properties, detached origins and copied metadata~%")
