(load (merge-pathnames "../examples/event-tags.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(let (saved expired outer)
  (wxlambda:with-application ()
    (wxlambda-event-tags:exercise)
    (wxlambda:register-event-type :notify-a) (wxlambda:register-event-type :notify-b)
    (let ((receiver (wxlambda:make-event-handler)))
      (dolist (pair '((:raw-tag :translated-tag) (:notify-a :notify-b)))
        (let* ((source (first pair)) (target (second pair))
               (binding (wxlambda:bind-event receiver source
                          (lambda (e c)
                            (setf saved e expired c)
                            (assert (= (wxlambda:event-type source) (wxlambda:event-native-type e)))
                            (dolist (bad (list -1 0 (wxlambda:event-type :click) (wxlambda:event-type :close)
                                              (wxlambda:event-type :end-session)
                                              (wxlambda:event-type (if (eq source :raw-tag) :notify-b :translated-tag))))
                              (expect-error (lambda () (setf (wxlambda:event-native-type c) bad)) 'wxlambda:native-error)
                              (assert (= (wxlambda:event-type source) (wxlambda:event-native-type c))))
                            (dolist (bad '(2147483648 -2147483649 :notify-b 1/2))
                              (expect-error (lambda () (setf (wxlambda:event-native-type c) bad)) 'type-error))
                            (assert (= (wxlambda:event-type target)
                                       (setf (wxlambda:event-native-type c) (wxlambda:event-type target))))
                            (assert (= (wxlambda:event-type target) (wxlambda:event-native-type c)))
                            (assert (= (wxlambda:event-type source) (wxlambda:event-native-type e)))
                            (when (eq source :notify-a) (setf (wxlambda:event-vetoed-p c) t))) :with-context t)))
          (assert (equal (list t (eq source :notify-a))
                         (multiple-value-list (wxlambda:process-event receiver source))))
          (expect-error (lambda () (setf (wxlambda:event-native-type expired) (wxlambda:event-type target))) 'wxlambda:native-error)
          (expect-error (lambda () (funcall (fdefinition '(setf wxlambda:event-native-type)) 1 saved)))
          (wxlambda:unbind-event binding)))
      ;; Built-in source objects, including session events, cannot change tags.
      (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session))
        (let ((binding (wxlambda:bind-event receiver kind
                         (lambda (e c)
                           (expect-error (lambda () (setf (wxlambda:event-native-type c) (wxlambda:event-type :translated-tag))) 'wxlambda:native-error)
                           (assert (= (wxlambda:event-native-type e) (wxlambda:event-native-type c)))) :with-context t)))
          (wxlambda:process-event receiver kind) (wxlambda:unbind-event binding)))
      (let* ((inner (wxlambda:bind-event receiver :notify-b
                      (lambda (e c)
                        (declare (ignore e c))
                        (expect-error (lambda () (setf (wxlambda:event-native-type outer) (wxlambda:event-type :translated-tag))) 'wxlambda:native-error)) :with-context t))
             (binding (wxlambda:bind-event receiver :raw-tag
                        (lambda (e c)
                          (declare (ignore e)) (setf outer c)
                          (wxlambda:process-event receiver :notify-b)
                          (setf (wxlambda:event-native-type c) (wxlambda:event-type :translated-tag))) :with-context t)))
        (wxlambda:process-event receiver :raw-tag)
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      (wxlambda:destroy-event-handler receiver)))
  (assert (integerp (wxlambda:event-native-type saved)))
  (expect-error (lambda () (setf (wxlambda:event-native-type expired) 1)) 'wxlambda:native-error))
(format t "PASS: registered same-family tag mutation, rejected built-in/cross-family changes and snapshot/current isolation~%")
