(load (merge-pathnames "../examples/time-picker.lisp" *load-truename*))
(defun time-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-time-picker (wxlambda:time-picker) ((tag :initarg :tag :reader time-tag))
  (:default-initargs :time '(12 34 56) :tag :default))
(defmethod initialize-instance :after ((object custom-time-picker) &key)
  (assert (equal '(12 34 56) (wxlambda:clock-time object))))
(defclass mixed-time-picker (wxlambda:time-picker wxlambda:text-control) ())
(defclass failing-time-picker (custom-time-picker) ())
(defvar *failed-time-picker* nil)
(defmethod initialize-instance :after ((object failing-time-picker) &key)
  (setf *failed-time-picker* object)
  (wxlambda:bind-event object :time-change (lambda (event) (declare (ignore event))))
  (error "Expected time construction rollback"))
(defvar *time-snapshot* nil)
(defvar *time-context* nil)
(wxlambda:with-application ()
  (assert (wxlambda-time-picker:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (picker (wxlambda:make-time-picker panel :class 'custom-time-picker :tag :factory))
         (peer (wxlambda:make-time-picker panel)) (calls 0) (parent-calls 0))
    (assert (eq :factory (time-tag picker)))
    (assert (equal '(0 0 0) (wxlambda:clock-time peer)))
    (time-error (lambda () (make-instance 'mixed-time-picker :parent panel)))
    (time-error (lambda () (wxlambda:make-time-picker panel :class 'wxlambda:text-control)))
    (dolist (bad '(nil (-1 0 0) (24 0 0) (0 -1 0) (0 60 0) (0 0 -1) (0 0 60)
                   (12 34) (12 34 56 0) ("12" 34 56) (12 34 1/2)))
      (time-error (lambda () (wxlambda:make-time-picker panel :time bad)))
      (time-error (lambda () (setf (wxlambda:clock-time picker) bad))))
    (assert (equal '(12 34 56) (wxlambda:clock-time picker)))
    (dolist (date '((0 0 0) (12 34 56) (23 59 59)))
      (let ((value (copy-list date)))
        (assert (eq value (setf (wxlambda:clock-time picker) value)))
        (setf (first value) 1)
        (assert (equal date (wxlambda:clock-time picker))))
      (let ((copy (wxlambda:clock-time picker)))
        (setf (first copy) 1) (assert (equal date (wxlambda:clock-time picker)))))
    (wxlambda:bind-event picker :time-change
      (lambda (event context)
        (incf calls) (setf *time-snapshot* event *time-context* context)
        (assert (eq :time-change (wxlambda:event-kind event)))
        (assert (eq :command (wxlambda:event-family event)))
        (assert (not (wxlambda:event-can-veto-p context)))
        (assert (equal (wxlambda:clock-time picker) (wxlambda:event-time event)))
        (assert (equal (wxlambda:event-time event) (wxlambda:event-time context)))
        (assert (null (wxlambda:event-text event)))
        (assert (null (wxlambda:event-date event)))
        (time-error (lambda () (wxlambda:event-date context)) 'wxlambda:native-error)
        (let ((copy (wxlambda:event-time event)))
          (setf (first copy) 1)
          (assert (equal (wxlambda:clock-time picker) (wxlambda:event-time event))))
        (dolist (operation (list (lambda () (setf (wxlambda:clock-time picker) '(1 2 3)))
                                (lambda () (wxlambda:destroy-window picker))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame :force t))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text-available-p))
                                (lambda () (wxlambda:clone-event context))))
          (time-error operation 'wxlambda:native-error))
        (setf (wxlambda:clock-time peer) (wxlambda:event-time event))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:bind-event panel :time-change
      (lambda (event)
        (incf parent-calls)
        (assert (= (wxlambda:event-origin-id event) (wxlambda::handle picker)))
        (time-error (lambda () (setf (wxlambda:clock-time picker) '(1 2 3))) 'wxlambda:native-error)))
    (setf (wxlambda:clock-time picker) '(2 30 45))
    (assert (zerop calls))
    (setf (wxlambda:clock-time picker :notify :truthy) '(2 30 45))
    (assert (= 1 calls parent-calls))
    (assert (equal '(2 30 45) (wxlambda:clock-time peer)))
    (time-error (lambda () (wxlambda:event-time *time-context*)) 'wxlambda:native-error)
    (time-error (lambda () (wxlambda:make-event :kind :time-change)))
    (time-error (lambda () (wxlambda:process-event picker :time-change)))
    (let* ((condition (make-condition 'simple-error :format-control "time callback condition"))
           (binding (wxlambda:bind-event peer :time-change
                      (lambda (event) (declare (ignore event)) (error condition)))))
      (assert (eq condition (handler-case (setf (wxlambda:clock-time peer :notify t) '(4 5 6))
                              (error (actual) actual))))
      (assert (equal '(4 5 6) (wxlambda:clock-time peer)))
      (wxlambda:unbind-event binding))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (time-error (lambda () (make-instance 'failing-time-picker :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (time-error (lambda () (wxlambda:clock-time *failed-time-picker*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (time-error (lambda () (wxlambda:clock-time picker)) 'wxlambda:native-error)))
(assert (equal '(2 30 45) (wxlambda:event-time *time-snapshot*)))
(format t "PASS: bounded clock times, CLOS rollback, copied snapshots/context expiry, notify/silence and callback lifetime protection~%")
