(load (merge-pathnames "../examples/search-controls.lisp" *load-truename*))
(defun search-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-search (wxlambda:search-control) ((tag :initarg :tag :reader search-tag))
  (:default-initargs :value "Initial λ" :hint "Find λ" :tag :default))
(defmethod initialize-instance :after ((object custom-search) &key)
  (assert (string= "Initial λ" (wxlambda:text object)))
  (assert (string= "Find λ" (wxlambda:search-hint object))))
(defclass mixed-search (wxlambda:search-control wxlambda:text-control) ())
(defclass failing-search (custom-search) ())
(defvar *failed-search* nil)
(defmethod initialize-instance :after ((object failing-search) &key)
  (setf *failed-search* object)
  (wxlambda:bind-event object :text-change (lambda (event) (declare (ignore event))))
  (error "Expected search rollback"))
(defvar *search-snapshot* nil)
(defvar *search-context* nil)
(defvar *search-command-snapshots* nil)
(wxlambda:with-application ()
  (assert (wxlambda-search-controls:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (control (wxlambda:make-search-control panel :class 'custom-search :tag :factory))
         (peer (wxlambda:make-search-control panel)) (calls 0) (parent-calls 0))
    (assert (eq :factory (search-tag control)))
    (assert (string= "" (wxlambda:text peer))) (assert (string= "Search" (wxlambda:search-hint peer)))
    (search-error (lambda () (make-instance 'mixed-search :parent panel)))
    (search-error (lambda () (wxlambda:make-search-control panel :class 'wxlambda:text-control)))
    (dolist (bad (list nil 42 (format nil "a~Cb" #\Null) (format nil "a~Cb" #\Return) (format nil "a~%b")))
      (search-error (lambda () (wxlambda:make-search-control panel :value bad)))
      (search-error (lambda () (wxlambda:make-search-control panel :hint bad)))
      (search-error (lambda () (setf (wxlambda:text control) bad)))
      (search-error (lambda () (setf (wxlambda:search-hint control) bad))))
    (assert (string= "Initial λ" (wxlambda:text control)))
    (let ((value (copy-seq "Copied λ 😀")))
      (assert (eq value (setf (wxlambda:text control) value)))
      (assert (eq value (setf (wxlambda:search-hint control) value)))
      (setf (char value 0) #\X)
      (assert (string= "Copied λ 😀" (wxlambda:text control)))
      (assert (string= "Copied λ 😀" (wxlambda:search-hint control))))
    (let ((copy (wxlambda:text control)) (hint (wxlambda:search-hint control)))
      (setf (char copy 0) #\X (char hint 0) #\X)
      (assert (string= "Copied λ 😀" (wxlambda:text control)))
      (assert (string= "Copied λ 😀" (wxlambda:search-hint control))))
    (wxlambda:bind-event control :text-change
      (lambda (event context)
        (incf calls) (setf *search-snapshot* event *search-context* context)
        (assert (eq :text-change (wxlambda:event-kind event)))
        (assert (string= (wxlambda:text control) (wxlambda:event-text event)))
        (search-error (lambda () (setf (wxlambda:event-text context) "metadata")) 'wxlambda:native-error)
        (dolist (operation (list (lambda () (setf (wxlambda:text control) "nested"))
                                (lambda () (setf (wxlambda:search-hint control) "nested"))
                                (lambda () (wxlambda:destroy-window control))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame :force t))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text-available-p))))
          (search-error operation 'wxlambda:native-error))
        (setf (wxlambda:text peer) (wxlambda:event-text event))
        (let ((clone (wxlambda:clone-event context)))
          (unwind-protect (assert (string= (wxlambda:event-text event) (wxlambda:event-text clone)))
            (wxlambda:destroy-event clone)))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:bind-event panel :text-change
      (lambda (event)
        (incf parent-calls)
        (assert (= (wxlambda:event-origin-id event) (wxlambda::handle control)))
        (search-error (lambda () (setf (wxlambda:text control) "parent")) 'wxlambda:native-error)))
    (setf (wxlambda:text control) "Query λ" (wxlambda:search-hint control) "")
    (assert (zerop calls))
    (setf (wxlambda:text control :notify :truthy) "Query λ")
    (assert (= 1 calls parent-calls))
    (assert (string= "Query λ" (wxlambda:text peer)))
    (search-error (lambda () (wxlambda:event-text *search-context*)) 'wxlambda:native-error)
    (dolist (kind '(:search :search-cancel))
      (assert (plusp (wxlambda:event-type kind)))
      (search-error (lambda () (wxlambda:make-event :kind kind)))
      (search-error (lambda () (wxlambda:process-event control kind))))
    ;; ABI callback-copy probe only: no native search gesture/context is simulated.
    (dolist (pair '((25 . :search) (26 . :search-cancel)))
      (let ((binding (wxlambda:bind-event control (cdr pair)
                       (lambda (event) (push event *search-command-snapshots*)))))
        (unwind-protect
             (cffi:with-foreign-object (payload '(:struct wxlambda::native-event))
               (dotimes (i (cffi:foreign-type-size '(:struct wxlambda::native-event)))
                 (setf (cffi:mem-aref payload :uint8 i) 0))
               (cffi:with-foreign-string ((text bytes) "Native payload λ" :encoding :utf-8)
                 (cffi:with-foreign-slots ((wxlambda::kind wxlambda::text wxlambda::text-length wxlambda::native-type)
                                           payload (:struct wxlambda::native-event))
                   (setf wxlambda::kind (car pair) wxlambda::text text wxlambda::text-length (1- bytes)
                         wxlambda::native-type (wxlambda:event-type (cdr pair))))
                 (cffi:foreign-funcall-pointer (cffi:callback wxlambda::dispatch-event) ()
                   :uint64 (wxlambda::event-binding-token binding) :pointer payload :void))
               (wxlambda::check-callback-error))
          (wxlambda:unbind-event binding))))
    (let* ((condition (make-condition 'simple-error :format-control "search callback condition"))
           (binding (wxlambda:bind-event peer :text-change
                      (lambda (event) (declare (ignore event)) (error condition)))))
      (assert (eq condition (handler-case (setf (wxlambda:text peer :notify t) "Committed λ") (error (actual) actual))))
      (assert (string= "Committed λ" (wxlambda:text peer)))
      (wxlambda:unbind-event binding))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (search-error (lambda () (make-instance 'failing-search :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (search-error (lambda () (wxlambda:text *failed-search*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (search-error (lambda () (wxlambda:text control)) 'wxlambda:native-error)
    (search-error (lambda () (wxlambda:search-hint control)) 'wxlambda:native-error)))
(assert (string= "Query λ" (wxlambda:event-text *search-snapshot*)))
(assert (= 2 (length *search-command-snapshots*)))
(assert (equal '(:search-cancel :search) (mapcar #'wxlambda:event-kind *search-command-snapshots*)))
(dolist (event *search-command-snapshots*) (assert (string= "Native payload λ" (wxlambda:event-text event))))
(format t "PASS: search input/filter example, Unicode fields, CLOS rollback, TEXT guards, command ABI copies and native-only kinds~%")
