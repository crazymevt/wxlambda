(load (merge-pathnames "../examples/event-bindings.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defvar *failed-bindings* nil)
(defclass failing-binding-handler (wxlambda:event-handler) ())
(defmethod initialize-instance :after ((handler failing-binding-handler) &key)
  (push (wxlambda:bind-event handler :click (lambda (event) (declare (ignore event)))) *failed-bindings*)
  (let ((nested (wxlambda:make-event-handler)))
    (push (wxlambda:bind-event nested :click (lambda (event) (declare (ignore event)))) *failed-bindings*))
  (error "binding initialization failure"))

(expect-error (lambda () (wxlambda:bind-event (allocate-instance (find-class 'wxlambda:event-handler)) :click #'identity))
              'wxlambda:native-error)
(let (saved saved-event)
  (wxlambda:with-application ()
    (wxlambda-event-bindings:exercise)
    (let* ((handler (wxlambda:make-event-handler)) (any 0) (exact 0) (range 0)
           (all (wxlambda:bind-event handler :click (lambda (e) (incf any) (setf saved-event e))))
           (one (wxlambda:bind-event handler :click (lambda (e) (declare (ignore e)) (incf exact)) :id 7))
           (span (wxlambda:bind-event handler :click (lambda (e) (declare (ignore e)) (incf range)) :id 7 :last-id 9)))
      (setf saved all)
      (assert (wxlambda:event-binding-p all))
      (dolist (id '(6 7 9 10)) (wxlambda:queue-event handler :click :id id))
      (wxlambda:process-pending-events)
      (assert (= 4 any)) (assert (= 1 exact)) (assert (= 2 range))
      (assert (eq handler (wxlambda:event-source saved-event)))
      (assert (= 10 (wxlambda:event-id saved-event)))
      (dolist (binding (list all one span)) (assert (wxlambda:unbind-event binding)))
      (assert (not (wxlambda:binding-active-p all)))
      (let ((text (concatenate 'string "λ" (string (code-char 0)) "tail")) events)
        (dolist (kind '(:text-change :toggle :selection))
          (wxlambda:bind-event handler kind (lambda (e) (push e events))))
        (wxlambda:queue-event handler :text-change :text text)
        (setf (char text 0) #\X)
        (wxlambda:queue-event handler :toggle :checked-p t)
        (wxlambda:queue-event handler :selection :selection 3)
        (wxlambda:process-pending-events)
        (assert (= 3 (length events)))
        (assert (= 3 (wxlambda:event-selection (first events))))
        (assert (wxlambda:event-checked-p (second events)))
        (assert (string= (concatenate 'string "λ" (string (code-char 0)) "tail")
                         (wxlambda:event-text (third events)))))
      (let (self (calls 0))
        (setf self (wxlambda:bind-event handler :click
                     (lambda (e) (declare (ignore e)) (incf calls) (assert (wxlambda:unbind-event self)))))
        (wxlambda:queue-event handler :click)
        (wxlambda:queue-event handler :click)
        (wxlambda:process-pending-events)
        (assert (= 1 calls)))
      (let ((calls 0) (removed nil) victim)
        (setf victim (wxlambda:bind-event handler :click
                       (lambda (e) (declare (ignore e)) (assert (not removed)) (incf calls))))
        (let ((killer (wxlambda:bind-event handler :click
                        (lambda (e) (declare (ignore e)) (wxlambda:unbind-event victim) (setf removed t)))))
          (wxlambda:queue-event handler :click)
          (wxlambda:process-pending-events)
          (let ((before calls))
            (wxlambda:queue-event handler :click)
            (wxlambda:process-pending-events)
            (assert (= before calls)))
          (wxlambda:unbind-event killer)))
      (dolist (args '((:id -1) (:last-id 3) (:id 4 :last-id 2) (:id 2147483648)))
        (expect-error (lambda () (apply #'wxlambda:bind-event handler :click #'identity args))))
      (expect-error (lambda () (wxlambda:bind-event handler :unsupported #'identity)))
      (expect-error (lambda () (wxlambda:queue-event handler :click :text "wrong payload")))
      (expect-error (lambda () (make-instance 'failing-binding-handler)))
      (dolist (binding *failed-bindings*) (assert (not (wxlambda:binding-active-p binding))))
      (let* ((failure (make-condition 'simple-error :format-control "generic callback failure"))
             (bad (wxlambda:bind-event handler :click (lambda (e) (declare (ignore e)) (error failure)))))
        (wxlambda:queue-event handler :click)
        (assert (handler-case (progn (wxlambda:process-pending-events) nil)
                  (error (condition) (eq failure condition))))
        (wxlambda:unbind-event bad))
      (let* ((calls 0)
             (good (wxlambda:bind-event handler :click (lambda (e) (declare (ignore e)) (incf calls)))))
        (setf (wxlambda:handler-enabled-p handler) nil)
        (assert (wxlambda:binding-active-p good))
        (wxlambda:queue-event handler :click)
        (wxlambda:process-pending-events)
        (assert (zerop calls))
        (setf (wxlambda:handler-enabled-p handler) t)
        (wxlambda:queue-event handler :click)
        (wxlambda:process-pending-events)
        (assert (= 1 calls))
        (wxlambda:unbind-event good))
      ;; Self-disposal is deferred until after the native receiver's dispatch stack.
      (let ((binding (wxlambda:bind-event handler :click
                       (lambda (e) (declare (ignore e))
                         (wxlambda:destroy-event-handler handler)
                         (assert (not (wxlambda:handler-alive-p handler)))))))
        (wxlambda:queue-event handler :click)
        (wxlambda:process-pending-events)
        (assert (not (wxlambda:binding-active-p binding))))
      (assert (zerop (hash-table-count wxlambda::*event-bindings*)))
      (assert (zerop (hash-table-count wxlambda::*handlers*))))
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame)) (calls 0)
           (binding (wxlambda:bind-event button :click
                      (lambda (e) (declare (ignore e)) (incf calls) (wxlambda:destroy-window button)))))
      (wxlambda:queue-event button :click)
      (wxlambda:queue-event button :click)
      (wxlambda:process-pending-events)
      (assert (= 1 calls))
      (assert (not (wxlambda:handler-alive-p button)))
      (assert (not (wxlambda:binding-active-p binding)))
      (wxlambda:destroy-window frame))
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame))
           (specific 0) (child 0) (parent 0) child-id)
      (wxlambda:on-click button (lambda () (incf specific)))
      (wxlambda:bind-event button :click
        (lambda (e) (incf child) (setf child-id (wxlambda:event-id e))))
      (wxlambda:bind-event frame :click
        (lambda (e) (incf parent) (assert (eq frame (wxlambda:event-source e)))
          (assert (= child-id (wxlambda:event-id e)))))
      (wxlambda:queue-click button)
      (wxlambda:process-pending-events)
      (assert (= 1 specific child parent))
      (wxlambda:off-click button)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))
    ;; Synchronous notifying writers must finish their native setter stacks before
    ;; their own receivers are deleted, just as queued dispatch must.
    (let ((frame (wxlambda:make-frame)))
      (dolist (kind '(:text-change :toggle :selection))
        (let* ((control (ecase kind
                          (:text-change (wxlambda:make-text frame))
                          (:toggle (wxlambda:make-checkbox frame))
                          (:selection (wxlambda:make-choice frame :items '("a" "b")))))
               (calls 0)
               (binding (wxlambda:bind-event control kind
                          (lambda (e) (declare (ignore e)) (incf calls)
                            (wxlambda:destroy-window control)))))
          (ecase kind
            (:text-change (setf (wxlambda:text control :notify t) "destroy from setter"))
            (:toggle (setf (wxlambda:checked-p control :notify t) t))
            (:selection (setf (wxlambda:selection control :notify t) 1)))
          (assert (= 1 calls))
          (assert (not (wxlambda:handler-alive-p control)))
          (assert (not (wxlambda:binding-active-p binding)))
          (wxlambda:process-pending-events)))
      (wxlambda:destroy-window frame))
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame))
           (binding (wxlambda:bind-event button :click
                      (lambda (e) (declare (ignore e)) (error "disabled receiver must not dispatch")))))
      (setf (wxlambda:handler-enabled-p button) nil
            (wxlambda:handler-enabled-p frame) nil)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events)
      (assert (not (wxlambda:binding-active-p binding)))
      (assert (zerop (hash-table-count wxlambda::*event-bindings*)))
      (assert (zerop (hash-table-count wxlambda::*handlers*)))))
  (expect-error (lambda () (wxlambda:binding-active-p saved)) 'wxlambda:native-error)
  (assert (= 10 (wxlambda:event-id saved-event))))
(format t "PASS: independent command bindings, ID filters, snapshots, self/peer unbinding, disposal, rollback and example~%")
