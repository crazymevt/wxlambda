(load (merge-pathnames "../examples/radio-groups.lisp" *load-truename*))
(defun radio-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-radio (wxlambda:radio-box) ((tag :initarg :tag :reader radio-tag))
  (:default-initargs :items '("First λ" "Second") :selection 1 :orientation :horizontal :tag :default))
(defmethod initialize-instance :after ((object custom-radio) &key)
  (assert (= 2 (wxlambda:item-count object))) (assert (= 1 (wxlambda:selection object))))
(defclass bad-radio (wxlambda:radio-box wxlambda:slider) ())
(defvar *radio-failed-id* nil)
(defclass failing-radio (wxlambda:radio-box) ())
(defmethod initialize-instance :after ((object failing-radio) &key)
  (setf *radio-failed-id* (wxlambda::handle object))
  (wxlambda:bind-event object :radio-selection (lambda (event) (declare (ignore event))))
  (error "Expected rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-radio-groups:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (group (make-instance 'custom-radio :parent panel))
         (other (wxlambda:make-radio-box panel :class 'custom-radio :tag :factory))
         (snapshots nil) (context nil))
    (assert (eq :factory (radio-tag other)))
    (assert (string= "First λ" (wxlambda:item-text group 0)))
    (dolist (args '((:items nil) (:items ("one")) (:items ("a" "b") :selection 2)
                    (:items ("a" "b") :selection nil) (:items ("a" "b") :orientation :bad)))
      (radio-error (lambda () (apply #'wxlambda:make-radio-box panel args))))
    (radio-error (lambda () (wxlambda:make-radio-box panel :items (make-list 65 :initial-element "a"))))
    (radio-error (lambda () (wxlambda:make-radio-box panel :items (list "a" (string #\Null)))))
    (radio-error (lambda () (wxlambda:make-radio-box panel :class 'wxlambda:choice :items '("a" "b"))))
    (radio-error (lambda () (make-instance 'bad-radio :parent panel :items '("a" "b"))))
    (radio-error (lambda () (wxlambda:item-text group 2)))
    (radio-error (lambda () (setf (wxlambda:selection group) nil)))
    (radio-error (lambda () (setf (wxlambda:selection group) 2)))
    (wxlambda:bind-event frame :radio-selection
      (lambda (event current)
        (push event snapshots) (setf context current)
        (assert (= 0 (wxlambda:event-selection event) (wxlambda:event-selection current)))
        (assert (eq :command (wxlambda:event-family event)))
        (assert (string= "First λ" (wxlambda:event-text event)))
        (assert (null (wxlambda:event-numeric-value event)))
        (dolist (operation (list (lambda () (setf (wxlambda:selection group) 1))
                                (lambda () (wxlambda:destroy-window group))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text))
                                (lambda () (wxlambda:clone-event current))
                                (lambda () (setf (wxlambda:event-selection current) 1))))
          (radio-error operation 'wxlambda:native-error))
        (setf (wxlambda:selection other) 0)) :with-context t)
    (setf (wxlambda:selection group) 0)
    (assert (null snapshots))
    (setf (wxlambda:selection group :notify t) 0)
    (assert (= 1 (length snapshots)))
    (assert (= 0 (wxlambda:selection other)))
    (radio-error (lambda () (wxlambda:event-selection context)) 'wxlambda:native-error)
    (radio-error (lambda () (wxlambda:make-event :kind :radio-selection)))
    (radio-error (lambda () (wxlambda:process-event frame :radio-selection)))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (radio-error (lambda () (make-instance 'failing-radio :parent panel :items '("a" "b"))))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (assert (= 0 (wxlambda:event-selection (first snapshots))))
    (radio-error (lambda () (wxlambda:selection group)) 'wxlambda:native-error)))
(format t "PASS: bounded radio groups, CLOS, selection, snapshots, callback/lifetime protection, rollback and example~%")
