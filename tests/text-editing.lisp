(load (merge-pathnames "../examples/text-editor.lisp" *load-truename*))
(defun expect-text-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-editor (wxlambda:text-control) ((tag :initarg :tag :reader editor-tag))
  (:default-initargs :multiline t :editable-p nil :value (format nil "Default λ~%日本語 😀") :tag :default))
(defmethod initialize-instance :after ((object custom-editor) &key)
  (assert (wxlambda:text-multiline-p object))
  (assert (not (wxlambda:text-editable-p object)))
  (assert (search "Default" (wxlambda:text object))))
(defvar *failed-editor* nil)
(defvar *failed-editor-id* nil)
(defclass failing-editor (wxlambda:text-control) ())
(defmethod initialize-instance :after ((object failing-editor) &key)
  (setf *failed-editor* object *failed-editor-id* (wxlambda::handle object))
  (wxlambda:on-text-change object (lambda (event) (declare (ignore event)) (error "Must never run")))
  (error "Initializer failure"))

(wxlambda:with-application ()
  (assert (wxlambda-text-editor:exercise))
  (let* ((frame (wxlambda:make-frame))
         (panel (wxlambda:make-panel frame))
         (single (wxlambda:make-text panel :value "abc"))
         (text (wxlambda:make-text panel :class 'custom-editor :tag :factory))
         (direct (make-instance 'custom-editor :parent panel))
         (calls nil))
    (unwind-protect
         (progn
           (assert (not (wxlambda:text-multiline-p single)))
           (assert (wxlambda:text-editable-p single))
           (assert (eq :factory (editor-tag text)))
           (assert (eq :default (editor-tag direct)))
           (assert (string= (wxlambda:text text) (format nil "Default λ~%日本語 😀")))
           (wxlambda:on-text-change text (lambda (event) (push (wxlambda:event-text event) calls)))
           ;; Read-only is native user-input policy, not a prohibition on Lisp edits.
           (setf (wxlambda:text text) "abcdef")
           (assert (null calls))
           (assert (equal '(0 0) (multiple-value-list (wxlambda:text-selection text))))
           (assert (= 6 (wxlambda:text-last-position text)))
           (let ((range (list 1 4)))
             (assert (eq range (setf (wxlambda:text-selection text) range)))
             (assert (equal range (multiple-value-list (wxlambda:text-selection text)))))
           (assert (= 2 (setf (wxlambda:text-insertion-point text) 2)))
           (assert (= 2 (wxlambda:text-insertion-point text)))
           (assert (equal '(2 2) (multiple-value-list (wxlambda:text-selection text))))
           (let ((value (copy-seq "λ")))
             (assert (eq value (wxlambda:replace-text text 1 4 value))))
           (assert (string= "aλef" (wxlambda:text text)))
           (assert (member "aλef" calls :test #'string=))
           (setf (wxlambda:text-editable-p text) t)
           (assert (wxlambda:text-editable-p text))
           ;; Use native endpoints for Unicode/multiline; never Lisp string length.
           (let ((value (format nil "λ 日本語 😀~%second~%")))
             (setf (wxlambda:text text) value)
             (let ((end (wxlambda:text-last-position text)))
               (setf (wxlambda:text-selection text) (list 0 end))
               (assert (equal (list 0 end) (multiple-value-list (wxlambda:text-selection text))))
               (wxlambda:replace-text text end end "Tail")
               (assert (string= (concatenate 'string value "Tail") (wxlambda:text text)))))
           (let ((saved (wxlambda:text text)) (end (wxlambda:text-last-position text)))
             (dolist (range (list (list -1 0) (list 2 1) (list 0 (1+ end))
                                 (list 0 (ash 1 63)) '(1) '(0 1 2) '(0 :end)))
               (expect-text-error (lambda () (setf (wxlambda:text-selection text) range))))
             (dolist (position (list -1 (1+ end) (ash 1 63) 1.5))
               (expect-text-error (lambda () (setf (wxlambda:text-insertion-point text) position))))
             (expect-text-error (lambda () (wxlambda:replace-text text 3 2 "bad")) 'wxlambda:native-error)
             (expect-text-error (lambda () (wxlambda:replace-text text 0 (1+ end) "bad")) 'wxlambda:native-error)
             (dolist (value (list 123 (string (code-char 0))))
               (expect-text-error (lambda () (setf (wxlambda:text text) value)))
               (expect-text-error (lambda () (wxlambda:replace-text text 0 0 value)))
               (expect-text-error (lambda () (wxlambda:make-text panel :value value))))
             (assert (string= saved (wxlambda:text text))))
           (expect-text-error (lambda () (wxlambda:text-selection panel)))
           (expect-text-error (lambda () (wxlambda:make-text panel :class 'wxlambda:button :multiline t)))
           (setf (wxlambda:text text :notify t) (format nil "Notified~%λ"))
           (assert (member (format nil "Notified~%λ") calls :test #'string=))
           (setf (wxlambda:text text) "abc")
           (wxlambda:replace-text text 1 2 "")
           (assert (string= "ac" (wxlambda:text text)))
           (wxlambda:replace-text text 1 1 "")
           (assert (string= "ac" (wxlambda:text text)))
           ;; Inner text callbacks suspend the outer borrowed click context.
           (let ((driver (wxlambda:make-button panel)) (outer nil) (nested nil))
             (wxlambda:on-text-change text
               (lambda (event)
                 (declare (ignore event))
                 (assert (not (wxlambda:event-context-active-p outer)))
                 (setf nested t)))
             (wxlambda:bind-event driver :click
               (lambda (event context)
                 (declare (ignore event))
                 (setf outer context)
                 (wxlambda:replace-text text 0 (wxlambda:text-last-position text) "Nested")
                 (assert (wxlambda:event-context-active-p context)))
               :with-context t)
             (wxlambda:queue-click driver)
             (wxlambda:process-events)
             (assert nested)
             (assert (not (wxlambda:event-context-active-p outer))))
           ;; Deferred callback-time destruction cannot invalidate native Replace's stack.
           (let ((temporary (wxlambda:make-text panel :multiline t)))
             (wxlambda:on-text-change temporary
               (lambda (event) (declare (ignore event)) (wxlambda:destroy-window temporary)))
             (wxlambda:replace-text temporary 0 0 "Disposed")
             (expect-text-error (lambda () (wxlambda:text temporary)) 'wxlambda:native-error)
             (wxlambda:process-events))
           ;; A callback condition escapes only after native Replace returns.
           (wxlambda:on-text-change text (lambda (event) (declare (ignore event)) (error "replace callback")))
           (expect-text-error (lambda () (wxlambda:replace-text text 0 (wxlambda:text-last-position text) "Committed")))
           (assert (string= "Committed" (wxlambda:text text)))
           (wxlambda:off-text-change text)
           (wxlambda:replace-text text 0 (wxlambda:text-last-position text) "Recovered")
           (assert (string= "Recovered" (wxlambda:text text)))
           (let ((roots (hash-table-count wxlambda::*handlers*)))
             (expect-text-error (lambda () (make-instance 'failing-editor :parent panel :multiline t)))
             (wxlambda:process-events)
             (assert (= roots (hash-table-count wxlambda::*handlers*)))
             (assert (zerop (wxlambda::%handler-alive *failed-editor-id*)))
             (expect-text-error (lambda () (wxlambda:text *failed-editor*)) 'wxlambda:native-error)))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))
    (dolist (function (list (lambda () (wxlambda:text text)) (lambda () (wxlambda:text-multiline-p text))
                            (lambda () (wxlambda:text-selection text)) (lambda () (wxlambda:replace-text text 0 0 "stale"))))
      (expect-text-error function 'wxlambda:native-error))))
(format t "PASS: multiline CLOS construction, native text ranges, editing, notifications, rollback and lifetime guards~%")
