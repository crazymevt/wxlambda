(load (merge-pathnames "../examples/grid.lisp" *load-truename*))
(defun grid-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-grid (wxlambda:grid) ((tag :initarg :tag :reader grid-tag))
  (:default-initargs :rows 2 :columns 3 :editable-p nil :tag :default))
(defmethod initialize-instance :after ((object custom-grid) &key)
  (assert (= 2 (wxlambda:grid-rows object)))
  (setf (wxlambda:grid-cell-text object 0 0) "Ready λ"))
(defclass mixed-grid (wxlambda:grid wxlambda:panel) ())
(defclass failing-grid (custom-grid) ())
(defvar *failed-grid* nil)
(defmethod initialize-instance :after ((object failing-grid) &key)
  (setf *failed-grid* object)
  (wxlambda:bind-event object :idle (lambda (event) (declare (ignore event))))
  (error "Expected grid rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-grid:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (grid (wxlambda:make-grid panel))
         (custom (wxlambda:make-grid panel :class 'custom-grid :tag :factory))
         (button (wxlambda:make-button panel)) (delivered nil))
    (assert (= 10 (wxlambda:grid-rows grid))) (assert (= 5 (wxlambda:grid-columns grid)))
    (assert (wxlambda:grid-editable-p grid)) (assert (not (wxlambda:grid-editing-p grid)))
    (assert (not (wxlambda:grid-editable-p custom)))
    (assert (eq :factory (grid-tag custom)))
    (assert (string= "Ready λ" (wxlambda:grid-cell-text custom 0 0)))
    (dolist (initargs '((:rows 0) (:columns 257) (:rows 256 :columns 256)))
      (grid-error (lambda () (apply #'wxlambda:make-grid panel initargs))))
    (grid-error (lambda () (make-instance 'mixed-grid :parent panel)))
    (grid-error (lambda () (wxlambda:make-grid panel :class 'wxlambda:panel)))
    (grid-error (lambda () (wxlambda:grid-cell-text custom 2 0)) 'wxlambda:native-error)
    (grid-error (lambda () (setf (wxlambda:grid-cell-text custom 0 3) "bad")) 'wxlambda:native-error)
    (grid-error (lambda () (wxlambda:grid-row-label grid -1)))
    (grid-error (lambda () (setf (wxlambda:grid-column-label grid 0) (string (code-char 0)))))
    (grid-error (lambda () (setf (wxlambda:grid-cell-text grid 0 0) (make-string 65537 :initial-element #\x))))
    (let ((text (format nil "Multiline λ~%text")))
      (assert (eq text (setf (wxlambda:grid-cell-text grid 9 4) text)))
      (let ((copy (wxlambda:grid-cell-text grid 9 4)))
        (assert (string= text copy)) (setf (char copy 0) #\X)
        (assert (string= text (wxlambda:grid-cell-text grid 9 4)))))
    (setf (wxlambda:grid-row-label grid 9) "Last λ" (wxlambda:grid-column-label grid 4) "Notes λ")
    (assert (string= "Last λ" (wxlambda:grid-row-label grid 9)))
    (assert (string= "Notes λ" (wxlambda:grid-column-label grid 4)))
    (assert (eq :yes (setf (wxlambda:grid-editable-p custom) :yes)))
    (setf (wxlambda:grid-editable-p custom) nil)
    (wxlambda:on-click button
      (lambda ()
        (assert (= 10 (wxlambda:grid-rows grid)))
        (grid-error (lambda () (setf (wxlambda:grid-cell-text grid 0 0) "callback")) 'wxlambda:native-error)
        (grid-error (lambda () (setf (wxlambda:grid-row-label custom 0) "callback")) 'wxlambda:native-error)
        (grid-error (lambda () (setf (wxlambda:grid-column-label grid 0) "callback")) 'wxlambda:native-error)
        (grid-error (lambda () (setf (wxlambda:grid-editable-p grid) nil)) 'wxlambda:native-error)
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:grid-cell-text grid 0 0) "Deferred λ" delivered t)) :owner grid)))
    (wxlambda:queue-click button)
    (loop repeat 30 until delivered do (wxlambda:process-events))
    (assert delivered) (assert (string= "Deferred λ" (wxlambda:grid-cell-text grid 0 0)))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (grid-error (lambda () (make-instance 'failing-grid :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (grid-error (lambda () (wxlambda:grid-rows *failed-grid*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (grid-error (lambda () (wxlambda:grid-cell-text grid 0 0)) 'wxlambda:native-error)
    (grid-error (lambda () (setf (wxlambda:grid-editable-p grid) nil)) 'wxlambda:native-error)))
(format t "PASS: fixed grid text/labels, bounds, CLOS rollback, callback deferral and lifetime~%")
