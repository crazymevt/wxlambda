(load (merge-pathnames "../examples/bitmap-toggles.lisp" *load-truename*))
(defun bitmap-toggle-error (function)
  (assert (handler-case (progn (funcall function) nil) (error () t))))
(defclass tagged-bitmap-toggle (wxlambda:bitmap-toggle-button) ((tag :initarg :tag :reader bitmap-toggle-tag))
  (:default-initargs :tag :default :checked t))
(defmethod initialize-instance :after ((object tagged-bitmap-toggle) &key)
  (assert (wxlambda:checked-p object))
  (let ((copy (wxlambda:bitmap-value object))) (wxlambda:destroy-bitmap copy)))
(defclass failed-bitmap-toggle (wxlambda:bitmap-toggle-button) ())
(defvar *failed-bitmap-toggle* nil)
(defmethod initialize-instance :after ((object failed-bitmap-toggle) &key)
  (setf *failed-bitmap-toggle* object)
  (wxlambda:bind-event object :toggle-button-change (lambda (event) (declare (ignore event))))
  (error "Expected bitmap-toggle rollback"))
(wxlambda:with-application ()
  (assert (wxlambda:bitmap-toggle-button-supported-p))
  (assert (wxlambda-bitmap-toggles:exercise))
  (let* ((frame (wxlambda:make-frame)) (icon (wxlambda-bitmap-toggles:make-icon))
         (button (wxlambda:make-bitmap-toggle-button frame icon :class 'tagged-bitmap-toggle :tag :factory :border :none))
         (other (make-instance 'tagged-bitmap-toggle :parent frame :bitmap icon))
         (calls 0))
    (unwind-protect
         (progn
           (assert (eq :factory (bitmap-toggle-tag button)))
           (assert (eq :default (bitmap-toggle-tag other)))
           (multiple-value-bind (fg bg) (wxlambda:window-colours frame)
             (assert (and (= 3 (length fg)) (= 3 (length bg))))
             (assert (every (lambda (value) (typep value '(unsigned-byte 8))) (append fg bg))))

           (assert (typep button 'wxlambda:toggle-button))
           (wxlambda:destroy-bitmap icon)
           (let ((copy (wxlambda:bitmap-value button)))
             (assert (equal '(16 16) (wxlambda:bitmap-size copy)))
             (setf (wxlambda:bitmap-value other) copy)
             (wxlambda:destroy-bitmap copy))
           (let ((copy (wxlambda:make-bitmap :source other))) (wxlambda:destroy-bitmap copy))
           (let ((replacement (wxlambda-bitmap-toggles:make-icon '(200 40 40))))
             (assert (eq replacement (setf (wxlambda:bitmap-value button) replacement)))
             (wxlambda:destroy-bitmap replacement))
           (let ((copy (wxlambda:bitmap-value button)))
             (unwind-protect
                  (let ((image (wxlambda:bitmap-image copy)))
                    (unwind-protect (assert (equal '(200 40 40 255) (wxlambda:image-pixel image 8 8)))
                      (wxlambda:destroy-image image)))
               (wxlambda:destroy-bitmap copy)))
           (bitmap-toggle-error (lambda () (wxlambda:make-bitmap-toggle-button frame icon)))
           (bitmap-toggle-error (lambda () (wxlambda:make-bitmap-toggle-button frame button)))
           (let ((valid (wxlambda-bitmap-toggles:make-icon)))
             (unwind-protect
                  (progn
                    (bitmap-toggle-error (lambda () (wxlambda:make-bitmap-toggle-button frame valid :class 'wxlambda:button)))
                    (bitmap-toggle-error (lambda () (wxlambda:make-bitmap-toggle-button frame valid :label "text")))
                    (bitmap-toggle-error (lambda () (wxlambda:make-bitmap-toggle-button frame valid :border :raised)))
                    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
                      (bitmap-toggle-error (lambda () (make-instance 'failed-bitmap-toggle :parent frame :bitmap valid)))
                      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
                    (bitmap-toggle-error (lambda () (wxlambda:checked-p *failed-bitmap-toggle*)))
                    (wxlambda:bind-event button :toggle-button-change
                      (lambda (event)
                        (incf calls)
                        (assert (not (wxlambda:event-checked-p event)))
                        (bitmap-toggle-error (lambda () (setf (wxlambda:bitmap-value button) valid)))
                        (bitmap-toggle-error (lambda () (wxlambda:bitmap-value button)))
                        (bitmap-toggle-error (lambda () (setf (wxlambda:checked-p button) t)))
                        (bitmap-toggle-error (lambda () (wxlambda:destroy-window frame)))))
                    (setf (wxlambda:checked-p button) t)
                    (assert (zerop calls))
                    (setf (wxlambda:checked-p button :notify t) nil)
                    (assert (= calls 1)))
               (wxlambda:destroy-bitmap valid)))
           (wxlambda:destroy-window frame) (wxlambda:process-events)
           (bitmap-toggle-error (lambda () (wxlambda:bitmap-value button))))
      (when (wxlambda:bitmap-alive-p icon) (wxlambda:destroy-bitmap icon))
      (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
      (wxlambda:process-events))))
(format t "PASS: native bitmap toggles, copied pixels, disposal, inheritance, CLOS rollback and callback guards~%")
