(load (merge-pathnames "../examples/keyboard-actions.lisp" *load-truename*))
(defun expect-accelerator-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass accelerator-frame (wxlambda:frame) ((tag :initarg :tag :reader accelerator-tag))
  (:default-initargs :accelerators '((#\q 3201 :ctrl) (:f1 3202)) :tag :default))
(defmethod initialize-instance :after ((frame accelerator-frame) &key)
  (assert (equal '((#\Q 3201 :ctrl) (:f1 3202)) (wxlambda:frame-accelerators frame))))
(defvar *failed-accelerator-frame* nil)
(defclass failed-accelerator-frame (wxlambda:frame) ())
(defmethod initialize-instance :after ((frame failed-accelerator-frame) &key)
  (setf *failed-accelerator-frame* (wxlambda::handle frame))
  (setf (wxlambda:frame-accelerators frame) '((:f1 3202)))
  (wxlambda:bind-event frame :menu (lambda (event) (declare (ignore event))))
  (error "Expected frame rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-keyboard-actions:exercise))
  (let* ((frame (wxlambda:make-frame :class 'accelerator-frame :tag :factory))
         (other (wxlambda:make-frame))
         (panel (wxlambda:make-panel frame))
         (input (copy-tree '((#\a 3201 :shift :ctrl) (:f12 32767) (#\0 3202 :alt)))))
    (assert (eq :factory (accelerator-tag frame)))
    (assert (null (wxlambda:frame-accelerators other)))
    (assert (eq input (setf (wxlambda:frame-accelerators frame) input)))
    (let ((expected '((#\A 3201 :ctrl :shift) (:f12 32767) (#\0 3202 :alt))))
      (assert (equal expected (wxlambda:frame-accelerators frame)))
      (setf (caar input) #\Z)
      (let ((read (wxlambda:frame-accelerators frame))) (setf (caar read) #\B (cadar read) 999))
      (assert (equal expected (wxlambda:frame-accelerators frame)))
      (dolist (bad '(t ((#\a 0 :ctrl)) ((#\a 32768 :ctrl)) ((#\a 1)) ((#\a 1 :shift))
                      ((#\λ 1 :ctrl)) ((#\! 1 :alt)) ((:f13 1)) ((42 1))
                      ((#\a 1 :meta)) ((#\a 1 :ctrl :ctrl)) ((#\a 1 :ctrl :raw-ctrl))
                      ((#\a 1 :ctrl) (#\A 2 :ctrl)) ((:f1 1) (:f1 2))
                      ((:f1)) ((:f1 1 . :ctrl)) ((:f1 1) . invalid)))
        (expect-accelerator-error (lambda () (setf (wxlambda:frame-accelerators frame) bad)))
        (assert (equal expected (wxlambda:frame-accelerators frame))))
      (let ((cycle (list '(:f1 1))))
        (setf (cdr cycle) cycle)
        (expect-accelerator-error (lambda () (setf (wxlambda:frame-accelerators frame) cycle))))
      (expect-accelerator-error (lambda () (setf (wxlambda:frame-accelerators frame) (make-list 257 :initial-element '(:f1 1))))))
    (let ((seen nil) (context nil)
          (binding nil))
      (setf binding (wxlambda:bind-event frame :menu
        (lambda (event current)
          (setf seen event context current)
          (dolist (operation (list (lambda () (setf (wxlambda:frame-accelerators frame) nil))
                                  (lambda () (wxlambda:destroy-window frame))
                                  (lambda () (wxlambda:close-window frame))
                                  (lambda () (wxlambda:destroy-window panel))
                                  (lambda () (wxlambda:process-events))
                                  (lambda () (wxlambda:clipboard-text-available-p))))
            (expect-accelerator-error operation 'wxlambda:native-error))
          (setf (wxlambda:frame-title frame) "Action observed"))
        :id 3201 :with-context t))
      (assert (wxlambda:process-event frame :menu :id 3201))
      (assert (= 3201 (wxlambda:event-id seen)))
      (expect-accelerator-error (lambda () (wxlambda:event-id context)) 'wxlambda:native-error)
      (wxlambda:unbind-event binding))
    ;; Conservative protection also covers callbacks on unrelated handlers,
    ;; because native accelerator origins are not portable identifiers.
    (let ((handler (wxlambda:make-event-handler)))
      (wxlambda:bind-event handler :menu
        (lambda (event) (declare (ignore event))
          (expect-accelerator-error (lambda () (wxlambda:destroy-window panel)) 'wxlambda:native-error)))
      (wxlambda:process-event handler :menu :id 9999)
      (wxlambda:destroy-event-handler handler))
    (assert (null (setf (wxlambda:frame-accelerators frame) nil)))
    (assert (null (wxlambda:frame-accelerators frame)))
    ;; Clearing restores the existing menu callback lifetime policy.
    (wxlambda:bind-event other :menu
      (lambda (event) (declare (ignore event)) (wxlambda:destroy-window panel)))
    (wxlambda:process-event other :menu :id 1)
    (wxlambda:process-events)
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (expect-accelerator-error (lambda () (make-instance 'failed-accelerator-frame)))
      (wxlambda:process-events)
      (assert (= roots (hash-table-count wxlambda::*event-bindings*)))
      (assert (zerop (wxlambda::%handler-alive *failed-accelerator-frame*))))
    (wxlambda:destroy-window frame) (wxlambda:destroy-window other) (wxlambda:process-events)
    (expect-accelerator-error (lambda () (wxlambda:frame-accelerators frame)) 'wxlambda:native-error)
    (expect-accelerator-error (lambda () (setf (wxlambda:frame-accelerators frame) nil)) 'wxlambda:native-error)))
(format t "PASS: copied frame accelerator tables, validation, shared model actions, CLOS rollback and conservative menu guards~%")
