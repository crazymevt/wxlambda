(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(load (merge-pathnames "../examples/window-metadata.lisp" *load-truename*))

(defun expect-dispatch-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (not (typep condition 'wxlambda:native-error))))))

(defun expect-native-error (function)
  (assert (handler-case (progn (funcall function) nil)
            (wxlambda:native-error () t))))

(let (saved-frame saved-child saved-name saved-title)
  (wxlambda:with-application ()
    (wxlambda-window-metadata:exercise)
    (let* ((frame (wxlambda:make-frame :title "Initial — λ 日本語 😀"))
           (panel (wxlambda:make-panel frame))
           (controls (list frame panel
                           (wxlambda:make-button panel :label "Unchanged button")
                           (wxlambda:make-text panel :value "Unchanged input")
                           (wxlambda:make-label panel :label "Unchanged label")
                           (wxlambda:make-checkbox panel)
                           (wxlambda:make-choice panel :items '("Choice")))))
      (setf saved-frame frame saved-child panel)
      (assert (string= "Initial — λ 日本語 😀" (wxlambda:frame-title frame)))
      ;; Names work on every currently bound widget; labels and text stay independent.
      (dolist (control controls)
        (dolist (name (list "" "λ 日本語 😀" (concatenate 'string "before" (string (code-char 0)) "after")))
          (assert (eq name (setf (wxlambda:window-name control) name)))
          (assert (string= name (wxlambda:window-name control)))))
      (assert (string= "Unchanged input" (wxlambda:text (fourth controls))))
      (assert (string= "Unchanged label" (wxlambda:label-text (fifth controls))))
      ;; Setters copy their input. Getter results outlive subsequent shared-buffer queries.
      (let ((name (copy-seq "Stored name λ")))
        (setf (wxlambda:window-name frame) name)
        (setf (char name 0) #\X)
        (assert (string= "Stored name λ" (wxlambda:window-name frame))))
      (setf saved-name (wxlambda:window-name frame)
            saved-title (wxlambda:frame-title frame))
      (dolist (title '("" "Changed — λ 日本語 😀"))
        (assert (eq title (setf (wxlambda:frame-title frame) title)))
        (assert (string= title (wxlambda:frame-title frame))))
      (assert (string= saved-name "Stored name λ"))
      (assert (string= saved-title "Initial — λ 日本語 😀"))
      (expect-dispatch-error (lambda () (wxlambda:frame-title panel)))
      (expect-dispatch-error (lambda () (setf (wxlambda:frame-title panel) "Wrong type")))
      ;; Native pointer/length contracts reject invalid arguments instead of crashing.
      (dolist (setter (list #'wxlambda::%set-name #'wxlambda::%set-title))
        (expect-native-error
         (lambda () (wxlambda::check-status (funcall setter (wxlambda::handle frame) (cffi:null-pointer) 0)))))
      (dolist (getter (list #'wxlambda::%name #'wxlambda::%title))
        (assert (cffi:null-pointer-p (funcall getter (wxlambda::handle frame) (cffi:null-pointer))))
        (assert (plusp (length (wxlambda::%last-error)))))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events)
      (dolist (operation (list #'wxlambda:window-name
                              (lambda (window) (setf (wxlambda:window-name window) "stale"))))
        (expect-native-error (lambda () (funcall operation panel))))
      (expect-native-error (lambda () (wxlambda:frame-title frame)))
      (expect-native-error (lambda () (setf (wxlambda:frame-title frame) "stale")))))
  (expect-native-error (lambda () (wxlambda:window-name saved-child)))
  (expect-native-error (lambda () (setf (wxlambda:window-name saved-child) "inactive")))
  (expect-native-error (lambda () (wxlambda:frame-title saved-frame)))
  (expect-native-error (lambda () (setf (wxlambda:frame-title saved-frame) "inactive")))
  (assert (string= saved-name "Stored name λ"))
  (assert (string= saved-title "Initial — λ 日本語 😀"))
  (format t "PASS: metadata example, Unicode/empty/NUL names, copied strings, receiver checks and cleanup~%"))
