(load (merge-pathnames "../examples/scrolling-panels.lisp" *load-truename*))
(defun scroll-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-scroll (wxlambda:scrolled-panel) ((tag :initarg :tag :reader scroll-tag))
  (:default-initargs :scroll-rate '(8 16) :tag :default))
(defmethod initialize-instance :after ((object custom-scroll) &key)
  (assert (equal '(8 16) (wxlambda:scroll-rate object))))
(defclass mixed-scroll (wxlambda:scrolled-panel wxlambda:panel) ())
(defclass failing-scroll (wxlambda:scrolled-panel) ())
(defvar *failed-scroll* nil)
(defmethod initialize-instance :after ((object failing-scroll) &key)
  (setf *failed-scroll* object)
  (wxlambda:bind-event object :idle (lambda (event) (declare (ignore event))))
  (error "Expected rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-scrolling-panels:exercise))
  (let* ((frame (wxlambda:make-frame :width 400 :height 220))
         (viewport (wxlambda:make-scrolled-panel frame :class 'custom-scroll :tag :factory))
         (button (wxlambda:make-button viewport :label "Deferred scroll"))
         (calls 0))
    (assert (eq :factory (scroll-tag viewport)))
    (scroll-error (lambda () (make-instance 'mixed-scroll :parent frame)))
    (scroll-error (lambda () (wxlambda:make-scrolled-panel frame :class 'wxlambda:panel)))
    (let ((handler (wxlambda:make-event-handler)) (event (wxlambda:make-event :kind :click)))
      (unwind-protect
           (dolist (operation (list (lambda () (wxlambda:window-event-handler viewport))
                                   (lambda () (wxlambda:push-event-handler viewport handler))
                                   (lambda () (wxlambda:pop-event-handler viewport))
                                   (lambda () (wxlambda:remove-event-handler viewport handler))
                                   (lambda () (wxlambda:process-window-event viewport event))
                                   (lambda () (wxlambda:process-window-event-locally viewport event))))
             (scroll-error operation 'wxlambda:native-error))
        (wxlambda:destroy-event event) (wxlambda:destroy-event-handler handler)))
    (scroll-error (lambda () (wxlambda:fit-scroll-content viewport)) 'wxlambda:native-error)
    (dolist (invalid '((-1 16) (0 257) (0) (0 1 2) (0 "x")))
      (scroll-error (lambda () (wxlambda:make-scrolled-panel frame :scroll-rate invalid)))
      (scroll-error (lambda () (setf (wxlambda:scroll-rate viewport) invalid))))
    (dolist (invalid '((-1 0) (0 1000001) (0) (0 1 2) (0 "x")))
      (scroll-error (lambda () (setf (wxlambda:scroll-position viewport) invalid))))
    (wxlambda:make-column viewport)
    (wxlambda:add-child viewport button)
    (wxlambda:add-spacer viewport 1400)
    (wxlambda:show-window frame) (wxlambda:process-events)
    (let ((before (multiple-value-list (wxlambda:window-size frame))))
      (assert (eq viewport (wxlambda:fit-scroll-content viewport)))
      (assert (equal before (multiple-value-list (wxlambda:window-size frame)))))
    (let ((rate (wxlambda:scroll-rate viewport)))
      (setf (first rate) 200) (assert (equal '(8 16) (wxlambda:scroll-rate viewport))))
    (setf (wxlambda:scroll-position viewport) '(1000000 1000000))
    (let ((position (wxlambda:scroll-position viewport)))
      (assert (<= 0 (first position) 1000000)) (assert (< 0 (second position) 1000000)))
    (setf (wxlambda:scroll-rate viewport) '(0 0))
    (assert (equal '(0 0) (wxlambda:scroll-rate viewport)))
    (setf (wxlambda:scroll-position viewport) '(20 20))
    (assert (equal '(0 0) (wxlambda:scroll-position viewport)))
    (setf (wxlambda:scroll-rate viewport) '(0 16))
    (wxlambda:on-click button
      (lambda ()
        (incf calls)
        (dolist (operation (list (lambda () (setf (wxlambda:scroll-position viewport) '(0 5)))
                                (lambda () (setf (wxlambda:scroll-rate viewport) '(0 8)))
                                (lambda () (wxlambda:fit-scroll-content viewport))))
          (scroll-error operation 'wxlambda:native-error))
        (wxlambda:defer-ui-action (lambda () (setf (wxlambda:scroll-position viewport) '(0 5))) :owner viewport)))
    (wxlambda:queue-click button)
    (loop repeat 30 until (and (plusp calls) (= 5 (second (wxlambda:scroll-position viewport))))
          do (wxlambda:process-events))
    (assert (= 1 calls)) (assert (= 5 (second (wxlambda:scroll-position viewport))))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (scroll-error (lambda () (make-instance 'failing-scroll :parent frame)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (scroll-error (lambda () (wxlambda:scroll-rate *failed-scroll*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (scroll-error (lambda () (wxlambda:scroll-position viewport)) 'wxlambda:native-error)))
(format t "PASS: scrolled form, CLOS, unit/extent properties, native clamp/disable, fit, callback deferral and rollback~%")
