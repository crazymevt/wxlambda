(require :asdf)
(asdf:load-asd (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defun overlay-error-p (function)
  (handler-case (progn (funcall function) nil) (error () t)))
(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :width 700 :height 500))
         (host (wxlambda:make-panel frame))
         (overlay (wxlambda:make-panel host))
         (list (wxlambda:make-list-box overlay :items '("One" "Two")))
         (refused nil))
    (unwind-protect
         (progn
           (wxlambda:make-column frame)
           (wxlambda:add-child frame host :proportion 1 :border 0)
           (wxlambda:make-column overlay)
           (wxlambda:add-child overlay list :proportion 1)
           (wxlambda:show-window frame)
           (wxlambda:position-panel overlay 50 30 400 200)
           (assert (equal '(50 30) (multiple-value-list (wxlambda:window-position overlay))))
           (assert (equal '(400 200) (multiple-value-list (wxlambda:window-size overlay))))
           (assert (= 2 (length (wxlambda:window-descendants host))))
           (assert (overlay-error-p (lambda () (wxlambda:position-panel host 0 0 100 100))))
           (assert (overlay-error-p (lambda () (wxlambda:position-panel overlay -1 0 100 100))))
           (assert (overlay-error-p (lambda () (wxlambda:position-panel overlay 0 0 0 100))))
           (assert (null (wxlambda:list-item-at-point list -1 -1)))
           (assert (loop for y below 80 thereis (eql 0 (wxlambda:list-item-at-point list 8 y))))
           (wxlambda:focus-window list)
           (loop repeat 5 do (wxlambda:process-events))
           (assert (wxlambda:window-focus-within-p overlay))
           (let ((button (wxlambda:make-button host :label "Outside")))
             (wxlambda:on-click button
               (lambda () (setf refused (overlay-error-p (lambda () (wxlambda:position-panel overlay 0 0 100 100))))))
             (wxlambda:queue-click button)
             (loop repeat 5 do (wxlambda:process-events))
             (assert refused))
           (let ((split (wxlambda:make-splitter-window host)))
             (let ((pane (wxlambda:make-panel split)))
               (assert (overlay-error-p (lambda () (wxlambda:position-panel pane 0 0 100 100))))))
           (let ((views (wxlambda:window-descendants overlay)))
             (wxlambda:destroy-window overlay)
             (assert (every (lambda (view) (not (wxlambda:handler-alive-p view))) views))
             (assert (overlay-error-p (lambda () (wxlambda:position-panel overlay 0 0 100 100))))))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))
(format t "Overlay geometry, focus, hit-test, callback, container and lifetime checks passed.~%")
