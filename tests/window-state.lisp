(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(load (merge-pathnames "../examples/window-state.lisp" *load-truename*))

(defun expect-native-error (function)
  (assert (handler-case (progn (funcall function) nil)
            (wxlambda:native-error () t))))

(let (saved)
  (wxlambda:with-application ()
    ;; Run the documented example's callbacks and cleanup first.
    (wxlambda-window-state:exercise)
    (let* ((frame (wxlambda:make-frame :title "Window state contracts"))
           (parent (wxlambda:make-panel frame))
           (child (wxlambda:make-button parent)))
      (setf saved child)
      (assert (typep (wxlambda:maximized-p frame) 'boolean))
      (assert (null (setf (wxlambda:maximized-p frame) nil)))
      (assert (handler-case (progn (wxlambda:maximized-p child) nil) (error () t)))
      (let ((delivered nil))
        (wxlambda:on-click child
          (lambda ()
            (assert (typep (wxlambda:maximized-p frame) 'boolean))
            (expect-native-error (lambda () (setf (wxlambda:maximized-p frame) nil)))
            (wxlambda:defer-ui-action
              (lambda () (assert (null (setf (wxlambda:maximized-p frame) nil)))
                (setf delivered t)) :owner frame)))
        (wxlambda:queue-click child)
        (loop repeat 30 until delivered do (wxlambda:process-events))
        (assert delivered)
        (wxlambda:off-click child))
      (assert (not (wxlambda:shown-p frame)))
      (assert (wxlambda:shown-p child))
      (multiple-value-bind (value changed) (wxlambda:show-window frame)
        (assert (eq frame value)) (assert changed))
      (assert (wxlambda:shown-p frame))
      (assert (not (nth-value 1 (wxlambda:show-window frame))))
      (assert (nth-value 1 (wxlambda:show-window parent nil)))
      (assert (not (wxlambda:shown-p parent)))
      ;; IsShown is an intrinsic flag, not effective screen visibility.
      (assert (wxlambda:shown-p child))
      (assert (nth-value 1 (wxlambda:show-window parent 'yes)))
      (assert (wxlambda:enabled-p child))
      (multiple-value-bind (value changed) (wxlambda:enable-window parent nil)
        (assert (eq parent value)) (assert changed))
      ;; IsEnabled includes disabled ancestors.
      (assert (not (wxlambda:enabled-p child)))
      (assert (not (nth-value 1 (wxlambda:enable-window parent nil))))
      (assert (nth-value 1 (wxlambda:enable-window parent 'yes)))
      (assert (wxlambda:enabled-p child))
      ;; A child's explicit disabled state survives parent disable/re-enable.
      (wxlambda:enable-window child nil)
      (wxlambda:enable-window parent nil)
      (wxlambda:enable-window parent t)
      (assert (not (wxlambda:enabled-p child)))
      (wxlambda:enable-window child t)
      (wxlambda:show-window frame nil)
      (assert (not (wxlambda:shown-p frame)))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events)
      (dolist (operation (list #'wxlambda:shown-p #'wxlambda:show-window
                              #'wxlambda:enabled-p #'wxlambda:enable-window))
        (expect-native-error (lambda () (funcall operation child))))))
  (dolist (operation (list #'wxlambda:shown-p #'wxlambda:show-window
                          #'wxlambda:enabled-p #'wxlambda:enable-window))
    (expect-native-error (lambda () (funcall operation saved))))
  (format t "PASS: window-state example, setter results, ancestor semantics and stale/inactive handles~%"))
