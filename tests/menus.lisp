(load (merge-pathnames "../examples/menus.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defclass named-menu-bar (wxlambda:menu-bar)
  ((name :initarg :name :reader bar-name)) (:default-initargs :name "bar default"))
(defmethod initialize-instance :after ((bar named-menu-bar) &key)
  (assert (wxlambda:menu-resource-alive-p bar))
  (assert (zerop (wxlambda:menu-count bar))))
(defclass named-menu (wxlambda:menu)
  ((name :initarg :name :reader menu-name))
  (:default-initargs :name "menu default" :label "&Fichier λ"))
(defmethod initialize-instance :after ((menu named-menu) &key)
  (assert (wxlambda:menu-resource-alive-p menu))
  (assert (stringp (wxlambda:menu-label menu))))
(defclass named-check-item (wxlambda:menu-item)
  ((name :initarg :name :reader item-name))
  (:default-initargs :name "item default" :id 31001 :label "&Check λ" :kind :check :checked-p t :enabled-p nil))
(defmethod initialize-instance :after ((item named-check-item) &key)
  (assert (wxlambda:menu-resource-alive-p item))
  (assert (eq :check (wxlambda:menu-item-kind item)))
  (assert (wxlambda:checked-p item))
  (assert (not (wxlambda:enabled-p item))))
(defclass invalid-menu-handler (wxlambda:menu wxlambda:event-handler) ())
(defclass invalid-handler-menu (wxlambda:event-handler wxlambda:menu) ())
(defclass invalid-menu-frame (wxlambda:menu wxlambda:frame) ())
(defclass invalid-frame-menu (wxlambda:frame wxlambda:menu) ())
(defclass invalid-menu-owned (wxlambda:menu wxlambda:owned-event) ())
(defclass invalid-owned-menu (wxlambda:owned-event wxlambda:menu) ())
(defclass invalid-menu-two-kinds (wxlambda:menu wxlambda:menu-item) ())
(defvar *failed-menu-ids* nil)
(defclass failing-menu (wxlambda:menu) ())
(defmethod initialize-instance :after ((menu failing-menu) &key)
  (push (wxlambda::handle menu) *failed-menu-ids*)
  (push (wxlambda::handle (wxlambda:make-menu-item menu :id 31901 :label "Rollback child")) *failed-menu-ids*)
  (error "menu initializer failure"))
(defclass failing-menu-item (wxlambda:menu-item) ())
(defmethod initialize-instance :after ((item failing-menu-item) &key)
  (push (wxlambda::handle item) *failed-menu-ids*)
  (error "menu item initializer failure"))
(defclass failing-menu-bar (wxlambda:menu-bar) ())
(defmethod initialize-instance :after ((bar failing-menu-bar) &key)
  (push (wxlambda::handle bar) *failed-menu-ids*)
  (let ((menu (wxlambda:make-menu bar :label "Rollback menu")))
    (push (wxlambda::handle menu) *failed-menu-ids*)
    (push (wxlambda::handle (wxlambda:make-menu-item menu :id 31902 :label "Rollback item")) *failed-menu-ids*))
  (error "menu bar initializer failure"))
(defclass failing-menu-frame (wxlambda:frame) ())
(defmethod initialize-instance :after ((frame failing-menu-frame) &key)
  (let* ((bar (wxlambda:make-menu-bar frame)) (menu (wxlambda:make-menu bar :label "Nested menu"))
         (item (wxlambda:make-menu-item menu :id 31903 :label "Nested item")))
    (dolist (resource (list bar menu item)) (push (wxlambda::handle resource) *failed-menu-ids*)))
  (error "frame with menus initializer failure"))

(defun check-menu-construction-and-scalar-properties ()
  (let* ((frame (wxlambda:make-frame))
         (bar (wxlambda:make-menu-bar frame :class 'named-menu-bar :name "custom bar"))
         (menu (make-instance 'named-menu :parent bar))
         (item (wxlambda:make-menu-item menu :class (find-class 'named-check-item) :name "custom item"))
         (normal (wxlambda:make-menu-item menu :id 31002 :label (format nil "&Ouvrir λ~CCtrl+O" #\Tab) :help "Open λ file"))
         (separator (wxlambda:make-menu-item menu :kind :separator)))
    (unwind-protect
         (progn
           (assert (string= "custom bar" (bar-name bar)))
           (assert (string= "menu default" (menu-name menu)))
           (assert (string= "custom item" (item-name item)))
           (assert (= 1 (wxlambda:menu-count bar)))
           (assert (= 3 (wxlambda:menu-item-count menu)))
           (assert (= 31001 (wxlambda:menu-item-id item)))
           (assert (eq :normal (wxlambda:menu-item-kind normal)))
           (assert (eq :separator (wxlambda:menu-item-kind separator)))
           (assert (null (wxlambda:menu-item-id separator)))
           (assert (string= "" (wxlambda:label-text separator)))
           (let ((label "&Éditer 日本語"))
             (assert (eq label (setf (wxlambda:menu-label menu) label)))
             (assert (string= label (wxlambda:menu-label menu))))
           (let ((label "&Nouveau λ"))
             (assert (eq label (setf (wxlambda:label-text item) label)))
             (assert (string= label (wxlambda:label-text item))))
           (assert (equal '(nil nil) (multiple-value-list (setf (wxlambda:enabled-p item) nil))))
           (assert (equal '(:enabled t) (multiple-value-list (setf (wxlambda:enabled-p item) :enabled))))
           (assert (equal '(t nil) (multiple-value-list (setf (wxlambda:enabled-p item) t))))
           (assert (null (setf (wxlambda:checked-p item) nil)))
           (assert (not (wxlambda:checked-p item)))
           (assert (eq :checked (setf (wxlambda:checked-p item) :checked)))
           (assert (wxlambda:checked-p item))
           (expect-error (lambda () (setf (wxlambda:checked-p item :notify t) nil)))
           (assert (wxlambda:checked-p item))
           (dolist (invalid (list normal separator))
             (expect-error (lambda () (wxlambda:checked-p invalid)))
             (expect-error (lambda () (setf (wxlambda:checked-p invalid) t))))
           (expect-error (lambda () (wxlambda:enabled-p separator)))
           (expect-error (lambda () (setf (wxlambda:enabled-p separator) nil)))
           (expect-error (lambda () (setf (wxlambda:label-text separator) "")))
           (expect-error (lambda () (wxlambda:activate-menu-item separator)))
           (let ((nul (concatenate 'string "before" (string (code-char 0)) "after")))
             (dolist (bad (list "" nul 17))
               (expect-error (lambda () (setf (wxlambda:menu-label menu) bad)))
               (expect-error (lambda () (setf (wxlambda:label-text normal) bad))))
             (assert (string= "&Éditer 日本語" (wxlambda:menu-label menu)))
             (assert (string= (format nil "&Ouvrir λ~CCtrl+O" #\Tab) (wxlambda:label-text normal)))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))
    (dolist (resource (list bar menu item normal separator))
      (assert (not (wxlambda:menu-resource-alive-p resource))))))

(defun check-menu-validation-and-id-ownership ()
  (let* ((frame (wxlambda:make-frame)) (other-frame (wxlambda:make-frame))
         (bar (wxlambda:make-menu-bar frame)) (other-bar (wxlambda:make-menu-bar other-frame))
         (menu (wxlambda:make-menu bar :label "First")) (second (wxlambda:make-menu bar :label "Second"))
         (other-menu (wxlambda:make-menu other-bar :label "Other"))
         (item (wxlambda:make-menu-item menu :id 31101 :label "Unique")))
    (unwind-protect
         (progn
           (expect-error (lambda () (make-instance 'wxlambda:menu-resource)))
           (expect-error (lambda () (wxlambda:make-menu-bar frame)))
           (expect-error (lambda () (wxlambda:make-menu-bar frame :class 'wxlambda:menu)))
           (expect-error (lambda () (wxlambda:make-menu bar :class 'wxlambda:menu-item :label "bad")))
           (expect-error (lambda () (wxlambda:make-menu-item menu :class 'wxlambda:event-handler :id 31102 :label "bad")))
           (expect-error (lambda () (wxlambda:make-menu frame :label "bad parent")))
           (expect-error (lambda () (wxlambda:make-menu-item bar :id 31102 :label "bad parent")))
           (dolist (class '(invalid-menu-handler invalid-handler-menu invalid-menu-frame invalid-frame-menu
                            invalid-menu-owned invalid-owned-menu invalid-menu-two-kinds))
             (let ((object (allocate-instance (find-class class))))
               (expect-error (lambda () (initialize-instance object :parent bar :label "bad" :id 31109)))
               (assert (not (slot-boundp object 'wxlambda::handle)))))
           (dolist (bad '(nil 0 -1 2147483648 1/2 "id"))
             (expect-error (lambda () (wxlambda:make-menu-item second :id bad :label "bad id"))))
           (dolist (options '((:kind :unknown :id 31102 :label "bad")
                              (:kind :normal :id 31102 :label "bad" :checked-p t)
                              (:kind :separator :id 31102)
                              (:kind :separator :label "bad")
                              (:kind :separator :help "bad")
                              (:kind :separator :checked-p nil)
                              (:kind :separator :enabled-p nil)))
             (expect-error (lambda () (apply #'wxlambda:make-menu-item second options))))
           (let ((nul (concatenate 'string "a" (string (code-char 0)) "b")))
             (expect-error (lambda () (wxlambda:make-menu bar :label nul)))
             (expect-error (lambda () (wxlambda:make-menu-item second :id 31102 :label nul)))
             (expect-error (lambda () (wxlambda:make-menu-item second :id 31102 :label "Good" :help nul))))
           (expect-error (lambda () (wxlambda:make-menu-item second :id 31101 :label "duplicate across same bar")))
           (assert (zerop (wxlambda:menu-item-count second)))
           ;; The same positive ID in another frame/bar is independent.
           (let ((copy (wxlambda:make-menu-item other-menu :id 31101 :label "Other bar")))
             (assert (= 31101 (wxlambda:menu-item-id copy))))
           (let ((maximum (wxlambda:make-menu-item second :id 2147483647 :label "Maximum ID")))
             (assert (= 2147483647 (wxlambda:menu-item-id maximum)))
             (wxlambda:destroy-menu-resource maximum))
           (wxlambda:destroy-menu-resource item)
           (assert (not (wxlambda:menu-resource-alive-p item)))
           (let ((reused (wxlambda:make-menu-item second :id 31101 :label "Reused ID")))
             (assert (= 31101 (wxlambda:menu-item-id reused))))
           (assert (= 2 (wxlambda:menu-count bar))))
      (wxlambda:destroy-window other-frame) (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun check-menu-independent-destruction-and-rollback ()
  (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label "Surviving parent"))
         (item (wxlambda:make-menu-item menu :id 31201 :label "Child")))
    (unwind-protect
         (progn
           (expect-error (lambda () (wxlambda:make-menu bar :class 'failing-menu :label "Failing menu")))
           (assert (= 1 (wxlambda:menu-count bar)))
           (expect-error (lambda () (wxlambda:make-menu-item menu :class 'failing-menu-item :id 31202 :label "Failing item")))
           (assert (= 1 (wxlambda:menu-item-count menu)))
           (let ((reused (wxlambda:make-menu-item menu :id 31202 :label "Reused after rollback")))
             (wxlambda:destroy-menu-resource reused))
           (wxlambda:destroy-menu-resource menu)
           (assert (wxlambda:menu-resource-alive-p bar))
           (assert (not (wxlambda:menu-resource-alive-p menu)))
           (assert (not (wxlambda:menu-resource-alive-p item)))
           (assert (zerop (wxlambda:menu-count bar)))
           (expect-error (lambda () (wxlambda:label-text item)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:activate-menu-item item)) 'wxlambda:native-error)
           (expect-error (lambda () (wxlambda:destroy-menu-resource menu)) 'wxlambda:native-error)
           (wxlambda:destroy-menu-resource bar)
           (assert (wxlambda:handler-alive-p frame))
           (assert (not (wxlambda:menu-resource-alive-p bar)))
           (expect-error (lambda () (wxlambda:make-menu-bar frame :class 'failing-menu-bar)))
           (let ((new-bar (wxlambda:make-menu-bar frame)))
             (assert (zerop (wxlambda:menu-count new-bar)))
             (wxlambda:destroy-menu-resource new-bar))
           (expect-error (lambda () (make-instance 'failing-menu-frame)))
           (wxlambda:process-events)
           (dolist (id *failed-menu-ids*) (assert (zerop (wxlambda::%menu-alive id)))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun check-menu-activation-and-event-routing ()
  (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label "Commands"))
         (normal (wxlambda:make-menu-item menu :id 31301 :label "Normal"))
         (check (wxlambda:make-menu-item menu :id 31302 :label "Check" :kind :check))
         (data (list :menu-data)) (calls 0) (range-calls 0) (snapshots nil)
         (exact (wxlambda:bind-event frame :menu
                  (lambda (snapshot context)
                    (incf calls) (push snapshot snapshots)
                    (assert (eq :command (wxlambda:event-family snapshot)))
                    (assert (eq :menu (wxlambda:event-kind snapshot)))
                    (assert (eq frame (wxlambda:event-source snapshot)))
                    (assert (eq data (wxlambda:event-user-data snapshot)))
                    (assert (eq data (wxlambda:event-user-data context)))
                    (assert (eql (wxlambda:event-origin-id snapshot) (wxlambda:event-origin-id context)))
                    (assert (eql (not (zerop (wxlambda:event-integer snapshot))) (wxlambda:event-checked-p snapshot)))
                    (when (= 31302 (wxlambda:event-id snapshot))
                      (assert (eql (wxlambda:checked-p check) (wxlambda:event-checked-p snapshot))))
                    (setf (wxlambda:event-skipped-p context) t)) :id 31301 :last-id 31302 :with-context t :user-data data))
         (range (wxlambda:bind-event frame :menu
                  (lambda (snapshot) (declare (ignore snapshot)) (incf range-calls)) :id 31300 :last-id 31399)))
    (unwind-protect
         (progn
           (wxlambda:activate-menu-item normal)
           (assert (= 1 calls range-calls))
           (assert (not (wxlambda:checked-p check)))
           (wxlambda:activate-menu-item check)
           (assert (wxlambda:checked-p check))
           (wxlambda:activate-menu-item check)
           (assert (not (wxlambda:checked-p check)))
           (assert (= 3 calls range-calls))
           (setf (wxlambda:enabled-p normal) nil)
           (assert (not (wxlambda:activate-menu-item normal)))
           (assert (= 3 calls range-calls))
           (setf (wxlambda:enabled-p normal) t)
           (wxlambda:unbind-event exact) (wxlambda:unbind-event range)
           (setf exact
                 (wxlambda:bind-event frame :menu
                   (lambda (snapshot context)
                     (assert (wxlambda:event-checked-p snapshot))
                     (setf (wxlambda:event-checked-p context) nil)
                     (assert (not (wxlambda:event-checked-p context)))
                     (assert (wxlambda:checked-p check))
                     (assert (wxlambda:event-checked-p snapshot))) :id 31302 :with-context t))
           (assert (wxlambda:activate-menu-item check))
           (assert (wxlambda:checked-p check))
           (let ((source (wxlambda:make-event :kind :menu :checked-p nil :id 31301)))
             (unwind-protect
                  (progn
                    (setf (wxlambda:event-checked-p source) :yes)
                    (assert (= 1 (wxlambda:event-integer source)))
                    (assert (wxlambda:event-checked-p source))
                    (setf (wxlambda:event-integer source) -1)
                    (assert (wxlambda:event-checked-p source)))
               (wxlambda:destroy-event source)))
           ;; Deleting an item invalidates its wrapper, not an independent frame binding.
           (wxlambda:destroy-menu-resource check)
           (assert (not (wxlambda:menu-resource-alive-p check)))
           (assert (wxlambda:binding-active-p exact))
           (assert (= 3 (length snapshots))))
      (wxlambda:unbind-event exact) (wxlambda:unbind-event range)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun check-menu-callback-boundaries ()
  (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label "Boundaries"))
         (outer (wxlambda:make-menu-item menu :id 31401 :label "Outer"))
         (inner (wxlambda:make-menu-item menu :id 31402 :label "Inner"))
         (condition (make-condition 'simple-error :format-control "nested menu callback failure"))
         (calls 0) (running nil)
         (inner-binding (wxlambda:bind-event frame :menu
                          (lambda (snapshot context) (declare (ignore snapshot context)) (error condition))
                          :id 31402 :with-context t))
         (binding (wxlambda:bind-event frame :menu
                    (lambda (snapshot context)
                      (declare (ignore snapshot context))
                      (incf calls)
                      (dolist (operation (list (lambda () (wxlambda:make-menu bar :label "Callback menu"))
                                               (lambda () (wxlambda:make-menu-item menu :id 31403 :label "Callback item"))
                                               (lambda () (wxlambda:destroy-menu-resource outer))
                                               (lambda () (wxlambda:destroy-menu-resource menu))
                                               (lambda () (wxlambda:destroy-menu-resource bar))))
                        (expect-error operation 'wxlambda:native-error)
                        (assert (= 1 (wxlambda:menu-count bar)))
                        (assert (= 2 (wxlambda:menu-item-count menu))))
                      (setf (wxlambda:menu-label menu) "Scalar callback label"
                            (wxlambda:label-text outer) "Scalar item label")
                      (assert (eq condition (handler-case (wxlambda:activate-menu-item inner)
                                             (error (caught) caught))))
                      (when running
                        (if (= calls 3) (wxlambda:stop)
                            (wxlambda:queue-event frame :menu :id 31401)))) :id 31401 :with-context t)))
    (unwind-protect
         (progn
           (assert (wxlambda:activate-menu-item outer))
           (assert (= 1 calls))
           (setf running t)
           (wxlambda:show-window frame)
           (wxlambda:queue-event frame :menu :id 31401)
           (wxlambda:run)
           (assert (= 3 calls)))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event inner-binding)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(expect-error (lambda () (make-instance 'wxlambda:menu-resource)))
(let (escaped)
  (wxlambda:with-application ()
    (assert (wxlambda-menus:exercise))
    (check-menu-construction-and-scalar-properties)
    (check-menu-validation-and-id-ownership)
    (check-menu-independent-destruction-and-rollback)
    (check-menu-activation-and-event-routing)
    (check-menu-callback-boundaries)
    (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
           (menu (wxlambda:make-menu bar :label "Session cleanup")))
      (setf escaped (wxlambda:make-menu-item menu :id 31501 :label "Left to session"))
      (setf (wxlambda:handler-enabled-p frame) nil)))
  (expect-error (lambda () (wxlambda:menu-resource-alive-p escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:label-text escaped)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:activate-menu-item escaped)) 'wxlambda:native-error))
(format t "PASS: native-backed menus, scalar state, ID routing/activation, guarded structure and lifetime rollback~%")
