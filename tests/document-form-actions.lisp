(load (merge-pathnames "../examples/document-form.lisp" *load-truename*))
(in-package #:wxlambda-document-form)
(defun test-form-actions ()
  (let* ((directory (merge-pathnames (format nil "wxlambda-form-actions-~36R/" (random (expt 36 12))) (uiop:temporary-directory)))
         (saved (merge-pathnames "saved-λ.wxform" directory))
         (save-as (merge-pathnames "save-as.wxform" directory))
         (input (merge-pathnames "input.wxform" directory))
         (bad (merge-pathnames "bad.wxform" directory))
         (choices nil) (answers nil) (errors nil) (modes nil) (confirms 0)
         (copied nil) (incoming nil) (report-throws nil) (form nil)
         (old-read (fdefinition 'wxlambda:clipboard-text))
         (old-write (fdefinition '(setf wxlambda:clipboard-text)))
         (old-flush (fdefinition 'wxlambda:flush-clipboard)))
    (ensure-directories-exist saved)
    (unwind-protect
         (progn
           ;; Application-level clipboard fixture: no system text is accessed.
           (setf (fdefinition 'wxlambda:clipboard-text) (lambda () incoming)
                 (fdefinition '(setf wxlambda:clipboard-text)) (lambda (value) (setf copied value))
                 (fdefinition 'wxlambda:flush-clipboard) (lambda () nil))
           (write-document input '("日本語 😀" nil 1))
           (with-open-file (stream bad :direction :output :external-format :utf-8) (write-line "Invalid" stream))
           (setf form (open-form
                       :choose-path (lambda (current mode)
                                      (assert (document-form-action-active current))
                                      (assert (document-form-busy current))
                                      (assert (not (request-command current :save)))
                                      (assert (not (wxlambda:close-window (document-form-frame current))))
                                      (assert (not (wxlambda:enabled-p (first (document-form-items current)))))
                                      (assert (not (wxlambda:tool-enabled-p (document-form-toolbar current) 12101)))
                                      (push mode modes) (pop choices))
                       :confirm-changes (lambda (current)
                                          (assert (document-form-action-active current))
                                          (assert (not (request-command current :open)))
                                          (incf confirms) (pop answers))
                       :report-error (lambda (current condition)
                                       (declare (ignore current)) (push condition errors)
                                       (when report-throws (error condition)))))
           (assert (typep (document-form-status form) 'wxlambda:status-bar))
           (assert (= 8 (wxlambda:toolbar-tool-count (document-form-toolbar form))))
           (assert (equal '((#\O 12101 :ctrl) (#\S 12102 :ctrl) (#\S 12103 :ctrl :shift)
                            (#\W 12104 :ctrl) (#\C 12105 :ctrl :shift) (#\V 12106 :ctrl :shift))
                          (wxlambda:frame-accelerators (document-form-frame form))))
           (labels ((send (index source)
                      (let ((id (first (nth index +form-commands+))))
                        (ecase source
                          (:menu (wxlambda:activate-menu-item (nth index (document-form-items form))))
                          (:tool (wxlambda:activate-toolbar-tool (document-form-toolbar form) id))
                          ;; Verifies the configured shortcut's command path, not physical typing.
                          (:shortcut-command (wxlambda:process-event (document-form-frame form) :menu :id id)))))
                    (drain ()
                      (drain-form-action form)
                      (assert (not (document-form-action-active form)))
                      (assert (not (document-form-busy form)))
                      (when (wxlambda:handler-alive-p (document-form-frame form))
                        (assert (every #'wxlambda:enabled-p (document-form-items form)))
                        (assert (every (lambda (entry) (wxlambda:tool-enabled-p (document-form-toolbar form) (first entry))) +form-commands+)))))
             ;; The first pending request wins; edits are read at delivery.
             (setf choices (list saved) (wxlambda:text (document-form-name form) :notify t) "Before request")
             (send 1 :menu)
             (let ((ticket (document-form-pending-action form)))
               (assert (wxlambda:ui-action-pending-p ticket)) (assert (null modes))
               (send 0 :shortcut-command)
               (assert (not (wxlambda:close-window (document-form-frame form))))
               (assert (eq ticket (document-form-pending-action form)))
               (assert (not (probe-file saved)))
               (setf (wxlambda:text (document-form-name form) :notify t) "At delivery λ")
               (drain))
             (assert (equal '("At delivery λ" t 0) (read-document saved)))
             (assert (not (dirty-p form))) (assert (= confirms 0))
             (assert (equal '(:save) modes))
             ;; Save As shares the action path through the shortcut command ID.
             (setf choices (list save-as)) (send 2 :shortcut-command) (drain)
             (assert (equal save-as (document-form-path form)))
             ;; Canceled pending work can be replaced without leaving the latch stuck.
             (send 2 :tool)
             (assert (wxlambda:cancel-ui-action (document-form-pending-action form)))
             (setf choices (list nil)) (send 2 :menu) (drain)
             (assert (equal save-as (document-form-path form)))
             ;; Cancel/failed Open retain current values, path, baseline and dirty state.
             (setf (wxlambda:text (document-form-name form) :notify t) "Keep me"
                   answers (list :cancel))
             (let ((before modes)) (send 0 :tool) (drain) (assert (eq before modes)))
             (assert (string= "Keep me" (first (form-values form))))
             (setf choices (list bad) answers (list :no)) (send 0 :tool) (drain)
             (assert (= 1 (length errors))) (assert (dirty-p form))
             (assert (equal save-as (document-form-path form)))
             (setf choices (list input) answers (list :no)) (send 0 :tool) (drain)
             (assert (equal '("日本語 😀" nil 1) (form-values form)))
             (assert (not (dirty-p form)))
             ;; Whole-name Copy/Paste do not depend on the native command checked field.
             (send 4 :tool) (assert (null copied)) (drain)
             (assert (string= "日本語 😀" copied)) (assert (not (dirty-p form)))
             (assert (string= "Copied name; persistence unavailable" (wxlambda:status-text (document-form-status form))))
             (send 5 :shortcut-command) (drain) (assert (not (dirty-p form)))
             (setf incoming "At request") (send 5 :shortcut-command)
             (setf incoming "At paste delivery") (drain)
             (assert (string= "At paste delivery" (first (form-values form))))
             (assert (dirty-p form))
             (setf incoming (format nil "bad~%name")) (send 5 :menu) (drain)
             (assert (= 2 (length errors))) (assert (string= "At paste delivery" (first (form-values form))))
             (setf incoming "") (send 5 :tool) (drain) (assert (string= "" (first (form-values form))))
             ;; An escaping reporter error still clears busy/active and re-enables views.
             (setf choices (list bad) answers (list :no) report-throws t)
             (send 0 :shortcut-command)
             (let ((seen nil))
               (handler-case (wxlambda:process-events) (error (condition) (setf seen condition)))
               (assert (eq seen (first errors))))
             (setf report-throws nil) (drain)
             (send 4 :menu) (drain) (assert (string= "" copied))
             ;; Approval cannot leak to a later close if another handler vetoes replay.
             (let ((veto (wxlambda:bind-event (document-form-frame form) :close
                           (lambda (event context)
                             (declare (ignore event))
                             (when (document-form-close-approved form)
                               (setf (wxlambda:event-vetoed-p context) t))
                             (setf (wxlambda:event-skipped-p context) t)) :with-context t)))
               (unwind-protect
                    (progn (setf answers (list :no))
                           (send 3 :shortcut-command) (drain)
                           (assert (wxlambda:handler-alive-p (document-form-frame form)))
                           (assert (not (document-form-close-approved form))))
                 (wxlambda:unbind-event veto)))
             (let ((before confirms))
               (setf answers (list :cancel))
               (assert (not (wxlambda:close-window (document-form-frame form))))
               (assert (= before confirms)) (drain) (assert (= (1+ before) confirms)))
             (assert (wxlambda:handler-alive-p (document-form-frame form))))
           (dispose-form form) (setf form nil)
           ;; Force/dispose cancel an owner-bound pending request before any file IO.
           (dolist (force '(t nil))
             (let ((called nil))
               (setf form (open-form :choose-path (lambda (current mode) (declare (ignore current mode)) (setf called t) saved)))
               (request-command form :save-as)
               (let ((ticket (document-form-pending-action form)))
                 (if force (wxlambda:close-window (document-form-frame form) :force t) (dispose-form form))
                 (assert (not (wxlambda:ui-action-pending-p ticket)))
                 (wxlambda:process-events) (assert (not called))
                 (assert (not (wxlambda:handler-alive-p (document-form-frame form)))))
               (dispose-form form) (setf form nil)))
           ;; Full RUN delivers Save and then an OS-style veto/deferred-close replay.
           (let ((called 0))
             (setf form (open-form :choose-path
                          (lambda (current mode)
                            (declare (ignore mode)) (incf called)
                            (assert (wxlambda:main-loop-running-p))
                            (wxlambda:defer-ui-action (lambda () (wxlambda:close-window (document-form-frame current)))
                                                    :owner (document-form-frame current))
                            nil)))
             (request-command form :save)
             (wxlambda:run)
             (assert (= 1 called))
             (assert (not (wxlambda:handler-alive-p (document-form-frame form))))))
      (when form (dispose-form form))
      (setf (fdefinition 'wxlambda:clipboard-text) old-read
            (fdefinition '(setf wxlambda:clipboard-text)) old-write
            (fdefinition 'wxlambda:flush-clipboard) old-flush)
      (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore))))
(wxlambda:with-application () (test-form-actions))
(format t "PASS: deferred document menu/tool/shortcut commands, delivery-time state, coalescing, file/clipboard cancellation, close replay and RUN~%")
