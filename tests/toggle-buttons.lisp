(load (merge-pathnames "../examples/toggle-buttons.lisp" *load-truename*))
(defun toggle-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-toggle (wxlambda:toggle-button) ((tag :initarg :tag :reader toggle-tag))
  (:default-initargs :label "Preview λ" :checked t :tag :default))
(defmethod initialize-instance :after ((object named-toggle) &key)
  (assert (wxlambda:checked-p object)) (assert (string= "Preview λ" (wxlambda:label-text object))))
(defclass mixed-toggle (wxlambda:toggle-button wxlambda:checkbox) ())
(defclass failing-toggle (wxlambda:toggle-button) ())
(defvar *failed-toggle* nil)
(defmethod initialize-instance :after ((object failing-toggle) &key)
  (setf *failed-toggle* object)
  (wxlambda:bind-event object :toggle-button-change (lambda (event) (declare (ignore event))))
  (error "Expected rollback"))
(defvar *saved-toggle-snapshot* nil)
(wxlambda:with-application ()
  (assert (wxlambda-toggle-buttons:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (toggle (make-instance 'named-toggle :parent panel))
         (other (wxlambda:make-toggle-button panel :class 'named-toggle :tag :factory))
         (calls 0) (context nil))
    (assert (eq :factory (toggle-tag other)))
    (assert (eq :default (toggle-tag toggle)))
    (assert (eq :truthy (setf (wxlambda:checked-p toggle) :truthy)))
    (assert (eq t (wxlambda:checked-p toggle)))
    (setf (wxlambda:label-text toggle) "Paused λ")
    (assert (string= "Paused λ" (wxlambda:label-text toggle)))
    (toggle-error (lambda () (setf (wxlambda:label-text toggle) (string #\Null))))
    (toggle-error (lambda () (wxlambda:make-toggle-button panel :label (string #\Null))))
    (toggle-error (lambda () (wxlambda:make-toggle-button panel :class 'wxlambda:button)))
    (toggle-error (lambda () (make-instance 'mixed-toggle :parent panel)))
    (toggle-error (lambda () (wxlambda:make-toggle-button panel :orientation :vertical)))
    (let ((binding (wxlambda:bind-event frame :toggle-button-change
      (lambda (event current)
        (incf calls) (setf context current *saved-toggle-snapshot* event)
        (assert (wxlambda:event-checked-p event))
        (assert (wxlambda:event-checked-p current))
        (assert (= 1 (wxlambda:event-integer event)))
        (assert (eq :command (wxlambda:event-family event)))
        (assert (null (wxlambda:event-selection event)))
        (assert (string= "" (wxlambda:event-text event)))
        (dolist (operation (list (lambda () (setf (wxlambda:checked-p toggle) nil))
                                (lambda () (setf (wxlambda:label-text toggle) "Nested"))
                                (lambda () (wxlambda:destroy-window toggle))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text))
                                (lambda () (wxlambda:clone-event current))
                                (lambda () (setf (wxlambda:event-checked-p current) nil))))
          (toggle-error operation 'wxlambda:native-error))
        (setf (wxlambda:checked-p other) nil)) :with-context t)))
      (setf (wxlambda:checked-p toggle) t) (assert (zerop calls))
      (setf (wxlambda:checked-p toggle :notify t) t)
      (assert (= 1 calls)) (assert (not (wxlambda:checked-p other)))
      (toggle-error (lambda () (wxlambda:event-checked-p context)) 'wxlambda:native-error)
      (wxlambda:unbind-event binding))
    (toggle-error (lambda () (wxlambda:make-event :kind :toggle-button-change)))
    (toggle-error (lambda () (wxlambda:process-event frame :toggle-button-change)))
    ;; Committed state survives an escaping callback condition.
    (let* ((expected (make-condition 'simple-error :format-control "Toggle callback condition"))
           (binding (wxlambda:bind-event toggle :toggle-button-change (lambda (event) (declare (ignore event)) (error expected)))))
      (assert (eq expected (handler-case (setf (wxlambda:checked-p toggle :notify t) nil) (error (c) c))))
      (assert (not (wxlambda:checked-p toggle))) (wxlambda:unbind-event binding))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (toggle-error (lambda () (make-instance 'failing-toggle :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (toggle-error (lambda () (wxlambda:checked-p *failed-toggle*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (toggle-error (lambda () (wxlambda:checked-p toggle)) 'wxlambda:native-error)))
(assert (wxlambda:event-checked-p *saved-toggle-snapshot*))
(format t "PASS: toggle state/labels, CLOS, callback guards, snapshots, rollback, committed errors and example~%")
