(load (merge-pathnames "../examples/close-events.lisp" *load-truename*))
(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil) (wxlambda:native-error () t))))
(expect-native-error (lambda () (wxlambda:event-type :close)))
(assert (not (fboundp (find-symbol "COMMAND-EVENT-TYPE" :wxlambda))))
(let (saved-context saved-event)
  (wxlambda:with-application ()
    (wxlambda-close-events:exercise)
    (assert (= 5 (length (remove-duplicates
                           (mapcar #'wxlambda:event-type '(:click :text-change :toggle :selection :close))))))
    (let* ((frame (wxlambda:make-frame)) (mode :veto) (calls 0)
           (binding (wxlambda:bind-event frame :close
                      (lambda (event context)
                        (incf calls) (setf saved-context context saved-event event)
                        (assert (eq :close (wxlambda:event-kind event)))
                        (assert (eq :close (wxlambda:event-family event)))
                        (assert (= (wxlambda:event-type :close) (wxlambda:event-native-type event)))
                        (assert (wxlambda:event-can-veto-p event))
                        (assert (wxlambda:event-can-veto-p context))
                        (assert (not (wxlambda:event-vetoed-p event)))
                        (assert (handler-case (progn (setf (wxlambda:event-vetoed-p event) t) nil)
                                  (error (condition) (not (typep condition 'wxlambda:native-error)))))
                        (ecase mode
                          (:veto (assert (eq :veto (setf (wxlambda:event-vetoed-p context) :veto)))
                                 (assert (wxlambda:event-vetoed-p context))
                                 (assert (not (wxlambda:event-vetoed-p event))))
                          (:hold nil)
                          (:allow (setf (wxlambda:event-skipped-p context) t)))) :with-context t)))
      (assert (not (wxlambda:close-window frame)))
      (assert (= 1 calls))
      (assert (wxlambda:handler-alive-p frame))
      (setf mode :hold)
      (assert (wxlambda:close-window frame))
      (assert (wxlambda:handler-alive-p frame)) ; acceptance is not destruction
      (assert (not (wxlambda:event-context-active-p saved-context)))
      (expect-native-error (lambda () (wxlambda:event-vetoed-p saved-context)))
      (expect-native-error (lambda () (setf (wxlambda:event-vetoed-p saved-context) nil)))
      (setf mode :allow)
      (assert (wxlambda:close-window frame))
      (wxlambda:process-events)
      (assert (not (wxlambda:handler-alive-p frame)))
      (assert (not (wxlambda:binding-active-p binding)))
      (expect-native-error (lambda () (wxlambda:close-window frame))))
    (let* ((frame (wxlambda:make-frame)) (forward nil)
           (binding (wxlambda:bind-event frame :close
                      (lambda (event context)
                        (assert (not (wxlambda:event-can-veto-p event)))
                        (assert (not (wxlambda:event-can-veto-p context)))
                        (assert (not (wxlambda:event-vetoed-p context)))
                        (dolist (value '(t nil))
                          (expect-native-error (lambda () (setf (wxlambda:event-vetoed-p context) value))))
                        (when forward (setf (wxlambda:event-skipped-p context) t))) :with-context t)))
      (assert (wxlambda:close-window frame :force t))
      (assert (wxlambda:handler-alive-p frame)) ; force disables veto, not consumption
      (setf forward t)
      (assert (wxlambda:close-window frame :force t))
      (wxlambda:process-events)
      (assert (not (wxlambda:binding-active-p binding))))
    ;; Synthetic close-family events work on owned handlers without any default
    ;; window deletion. Captured flags remain immutable while the context changes.
    (let* ((receiver (wxlambda:make-event-handler)) (vetoable t) (calls 0)
           (binding (wxlambda:bind-event receiver :close
                      (lambda (event context)
                        (incf calls)
                        (assert (eql vetoable (wxlambda:event-can-veto-p event)))
                        (assert (eql vetoable (wxlambda:event-can-veto-p context)))
                        (when vetoable
                          (setf (wxlambda:event-vetoed-p context) t)
                          (assert (wxlambda:event-vetoed-p context))
                          (setf (wxlambda:event-vetoed-p context) nil)
                          (assert (not (wxlambda:event-vetoed-p context))))) :id 42 :with-context t)))
      (wxlambda:queue-event receiver :close :id 42)
      (wxlambda:process-pending-events)
      (setf vetoable nil)
      (wxlambda:queue-event receiver :close :id 42 :can-veto-p nil)
      (wxlambda:process-pending-events)
      (assert (= 2 calls))
      (wxlambda:unbind-event binding)
      (let ((command (wxlambda:bind-event receiver :click
                       (lambda (event context)
                         (assert (eq :command (wxlambda:event-family event)))
                         (assert (not (wxlambda:event-can-veto-p event)))
                         (assert (not (wxlambda:event-can-veto-p context)))
                         (expect-native-error (lambda () (wxlambda:event-vetoed-p context)))
                         (expect-native-error (lambda () (setf (wxlambda:event-vetoed-p context) t))))
                       :with-context t)))
        (wxlambda:queue-event receiver :click)
        (wxlambda:process-pending-events)
        (wxlambda:unbind-event command))
      (wxlambda:destroy-event-handler receiver))
    ;; An observer error is not a veto: observer Skip still permits the default
    ;; frame close action before the condition reaches the Lisp caller.
    (let* ((frame (wxlambda:make-frame))
           (failure (make-condition 'simple-error :format-control "observer close error"))
           (binding (wxlambda:bind-event frame :close
                      (lambda (e) (declare (ignore e)) (error failure)))))
      (assert (handler-case (progn (wxlambda:close-window frame) nil)
                (error (condition) (eq failure condition))))
      (wxlambda:process-events)
      (assert (not (wxlambda:handler-alive-p frame)))
      (assert (not (wxlambda:binding-active-p binding))))
    ;; A handled error from a nested synchronous close request must not stop RUN.
    (let* ((outer (wxlambda:make-frame)) (button (wxlambda:make-button outer))
           (target (wxlambda:make-frame)) (calls 0)
           (failure (make-condition 'simple-error :format-control "close callback error"))
           (binding (wxlambda:bind-event target :close
                      (lambda (e c) (declare (ignore e)) (setf saved-context c) (error failure)) :with-context t)))
      (wxlambda:on-click button
        (lambda ()
          (incf calls)
          (if (= calls 1)
              (progn
                (assert (handler-case (progn (wxlambda:close-window target) nil)
                          (error (condition) (eq failure condition))))
                (assert (not (wxlambda:event-context-active-p saved-context)))
                (wxlambda:queue-click button))
              (wxlambda:stop))))
      (wxlambda:queue-click button)
      (wxlambda:run)
      (assert (= 2 calls))
      (wxlambda:off-click button)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-window target)
      (wxlambda:destroy-window outer)))
  (assert (eq :close (wxlambda:event-family saved-event)))
  (assert (wxlambda:event-can-veto-p saved-event))
  (expect-native-error (lambda () (wxlambda:event-vetoed-p saved-context))))
(format t "PASS: close-family binding, veto/force policy, immutable flags, synthetic events, error boundaries and example~%")
