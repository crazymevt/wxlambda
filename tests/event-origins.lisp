(load (merge-pathnames "../examples/event-origins.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(let (saved expired outer captured)
  (wxlambda:with-application ()
    (assert (plusp (wxlambda-event-origins:exercise)))
    (let ((receiver (wxlambda:make-event-handler))
          (app (wxlambda:current-application-handler)))
      (wxlambda:register-event-type :origin-notify)
      (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session :origin-notify :origin-message))
        (let ((binding (wxlambda:bind-event receiver kind
                         (lambda (e c)
                           (setf saved e expired c captured (wxlambda:event-origin-id e))
                           (assert (= captured (wxlambda:event-origin-id c)))
                           (assert (= (wxlambda:event-type kind) (wxlambda:event-native-type e) (wxlambda:event-native-type c)))) :with-context t)))
          (wxlambda:process-event receiver kind)
          (assert (= captured (wxlambda::handle receiver)))
          (expect-error (lambda () (wxlambda:event-origin-id expired)) 'wxlambda:native-error)
          (expect-error (lambda () (wxlambda:event-native-type expired)) 'wxlambda:native-error)
          (wxlambda:unbind-event binding)))
      (let ((binding (wxlambda:bind-event app :origin-message (lambda (e) (setf saved e)))))
        (wxlambda:process-event app :origin-message)
        (assert (= (wxlambda::handle app) (wxlambda:event-origin-id saved)))
        (wxlambda:unbind-event binding))
      (let* ((inner (wxlambda:bind-event receiver :origin-message
                      (lambda (e c)
                        (declare (ignore e c))
                        (expect-error (lambda () (wxlambda:event-origin-id outer)) 'wxlambda:native-error)
                        (expect-error (lambda () (wxlambda:event-native-type outer)) 'wxlambda:native-error)) :with-context t))
             (binding (wxlambda:bind-event receiver :close
                        (lambda (e c)
                          (setf saved e outer c)
                          (wxlambda:process-event receiver :origin-message)
                          (assert (= (wxlambda:event-origin-id e) (wxlambda:event-origin-id c)))) :with-context t)))
        (wxlambda:process-event receiver :close)
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      (assert (not (fboundp '(setf wxlambda:event-origin-id))))
      (assert (not (fboundp '(setf wxlambda:event-native-type))))
      (wxlambda:destroy-event-handler receiver)
      (assert (= captured (wxlambda:event-origin-id saved)))))
  (assert (= captured (wxlambda:event-origin-id saved)))
  (assert (integerp (wxlambda:event-native-type saved)))
  (expect-error (lambda () (wxlambda:event-origin-id expired)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:event-native-type expired)) 'wxlambda:native-error))
(format t "PASS: native type/current origin identities, propagated receiver distinction and saved/context lifetimes~%")
