(load (merge-pathnames "../examples/notify-events.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (condition) (typep condition type)))))
(defvar *failed-binding*)
(defclass failing-notify-handler (wxlambda:event-handler) ())
(defmethod initialize-instance :after ((receiver failing-notify-handler) &key)
  (setf *failed-binding* (wxlambda:bind-event receiver :policy (lambda (e) (declare (ignore e)))))
  (error "notify initializer failure"))
(expect-error (lambda () (wxlambda:register-event-type :policy)) 'wxlambda:native-error)

(let (saved)
  (wxlambda:with-application ()
    (wxlambda-notify-events:exercise)
    (assert (eq :policy (wxlambda:register-event-type :policy)))
    (wxlambda:register-event-type :custom-command :family :command)
    (assert (/= (wxlambda:event-type :policy) (wxlambda:event-type :custom-command)))
    (let ((native (wxlambda:event-type :policy)))
      (expect-error (lambda () (wxlambda:register-event-type :policy)))
      (expect-error (lambda () (wxlambda:register-event-type :click)))
      (expect-error (lambda () (wxlambda:register-event-type :bad :family :close)))
      (expect-error (lambda () (wxlambda:register-event-type "not a keyword")))
      (assert (= native (wxlambda:event-type :policy))))
    (let* ((receiver (wxlambda:make-event-handler)) (calls 0)
           (binding (wxlambda:bind-event receiver :policy
                      (lambda (event context)
                        (incf calls) (setf saved event)
                        (assert (eq :policy (wxlambda:event-kind event)))
                        (assert (eq :notify (wxlambda:event-family event)))
                        (assert (wxlambda:event-can-veto-p context))
                        (assert (= (wxlambda:event-type :policy) (wxlambda:event-native-type event)))
                        (setf (wxlambda:event-vetoed-p context) (minusp (wxlambda:event-integer event))))
                      :id 42 :with-context t)))
      (assert (equal '(t t) (multiple-value-list (wxlambda:process-event receiver :policy :id 42 :integer -1))))
      ;; Allow() clears an initial Veto() while the saved pre-callback state stays true.
      (assert (equal '(t nil) (multiple-value-list (wxlambda:process-event receiver :policy :id 42 :integer 3 :vetoed-p t))))
      (assert (wxlambda:event-vetoed-p saved))
      (assert (= 2 calls))
      (assert (equal '(nil t) (multiple-value-list (wxlambda:process-event receiver :policy :id 43 :vetoed-p t))))
      (assert (= 2 calls))
      (wxlambda:unbind-event binding)
      (let* ((observed 0)
            (observer (wxlambda:bind-event receiver :custom-command
                        (lambda (e) (incf observed) (assert (eq :command (wxlambda:event-family e)))))))
        (assert (equal '(nil nil) (multiple-value-list (wxlambda:process-event receiver :custom-command))))
        (assert (= 1 observed))
        (wxlambda:unbind-event observer))
      (let* ((text (concatenate 'string "λ" (string (code-char 0)) "copied"))
             (queued (wxlambda:bind-event receiver :policy (lambda (e) (setf saved e)))))
        (wxlambda:queue-event receiver :policy :text text :integer -2147483648 :vetoed-p t)
        (setf (char text 0) #\X)
        (wxlambda:process-pending-events)
        (assert (string= (concatenate 'string "λ" (string (code-char 0)) "copied") (wxlambda:event-text saved)))
        (assert (= -2147483648 (wxlambda:event-integer saved)))
        (assert (wxlambda:event-vetoed-p saved))
        (wxlambda:unbind-event queued))
      (expect-error (lambda () (wxlambda:queue-event receiver :click :integer 2)))
      (expect-error (lambda () (wxlambda:process-event receiver :custom-command :vetoed-p t)))
      (expect-error (lambda () (wxlambda:process-event receiver :policy :can-veto-p t)))
      (expect-error (lambda () (wxlambda:queue-event receiver :policy :integer 2147483648)))
      (expect-error (lambda () (wxlambda:process-event receiver :unknown)))
      (expect-error (lambda () (make-instance 'failing-notify-handler)))
      (assert (not (wxlambda:binding-active-p *failed-binding*)))
      ;; Receiver disposal during a synchronous call leaves the owned native event
      ;; valid until its final veto state has been copied out.
      (let ((dispose (wxlambda:bind-event receiver :policy
                       (lambda (e c) (declare (ignore e))
                         (wxlambda:destroy-event-handler receiver)
                         (setf (wxlambda:event-vetoed-p c) t)) :with-context t)))
        (assert (equal '(t t) (multiple-value-list (wxlambda:process-event receiver :policy))))
        (assert (not (wxlambda:binding-active-p dispose))))
      (wxlambda:process-pending-events))
    ;; Nested dispatch errors are handled at PROCESS-EVENT's nearer Lisp boundary.
    (let* ((frame (wxlambda:make-frame)) (button (wxlambda:make-button frame))
           (receiver (wxlambda:make-event-handler)) (calls 0)
           (failure (make-condition 'simple-error :format-control "notify callback error"))
           (bad (wxlambda:bind-event receiver :policy
                  (lambda (e c) (declare (ignore e c)) (error failure)) :with-context t)))
      (wxlambda:on-click button
        (lambda () (incf calls)
          (if (= calls 1)
              (progn
                (assert (handler-case (progn (wxlambda:process-event receiver :policy) nil)
                          (error (condition) (eq condition failure))))
                (wxlambda:queue-click button))
              (wxlambda:stop))))
      (wxlambda:queue-click button)
      (wxlambda:run)
      (assert (= 2 calls))
      (wxlambda:off-click button)
      (wxlambda:unbind-event bad)
      (wxlambda:destroy-event-handler receiver)
      (wxlambda:destroy-window frame)))
  (assert (eq :policy (wxlambda:event-kind saved)))
  (assert (eq :notify (wxlambda:event-family saved)))
  (assert (= -2147483648 (wxlambda:event-integer saved)))
  (expect-error (lambda () (wxlambda:event-type :policy)) 'wxlambda:native-error))
(format t "PASS: registered notify/command types, synchronous handled/veto results, Allow/Veto, payload copying, rollback and example~%")
