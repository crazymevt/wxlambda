(load (merge-pathnames "../examples/input-events.lisp" *load-truename*))
(defun input-error (function)
  (assert (handler-case (progn (funcall function) nil) (error () t))))
(defvar *saved-input-context* nil)
(defvar *saved-size-event* nil)
(wxlambda:with-application ()
  (assert (wxlambda-input-events:exercise))
  (let* ((frame (wxlambda:make-frame :width 400 :height 260))
         (text (wxlambda:make-text frame :value "Native defaults")))
    (dolist (entry wxlambda::*input-event-kinds*)
      (let ((kind (car entry)))
        (input-error (lambda () (wxlambda:make-event :kind kind)))
        (let ((binding (wxlambda:bind-event text kind (lambda (event) (declare (ignore event))))))
          (wxlambda:unbind-event binding))))
    (wxlambda:bind-event frame :size
      (lambda (event context)
        (setf *saved-input-context* context *saved-size-event* event)
        (assert (equal (wxlambda:event-size event) (wxlambda:event-size context)))
        (input-error (lambda () (wxlambda:event-key-code event)))
        (input-error (lambda () (wxlambda:allow-next-key-event context)))
        (input-error (lambda () (wxlambda:clone-event context)))
        (input-error (lambda () (wxlambda:destroy-window frame)))
        (input-error (lambda () (wxlambda:process-events)))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:show-window frame) (wxlambda:layout-window frame)
    (loop repeat 8 do (wxlambda:process-events))
    (assert *saved-size-event*)
    (progn
      (let ((size (wxlambda:event-size *saved-size-event*)))
        (setf (first size) -100)
        (assert (/= -100 (first (wxlambda:event-size *saved-size-event*)))))
      (input-error (lambda () (wxlambda:event-size *saved-input-context*))))
    (assert (string= "Native defaults" (wxlambda:text text)))
    (wxlambda:destroy-window frame)))
