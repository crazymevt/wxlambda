(load (merge-pathnames "../examples/tree-navigation.lisp" *load-truename*))
(defun expect-tree-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass named-tree (wxlambda:tree-control) ((tag :initarg :tag :reader tree-tag)) (:default-initargs :tag :default))
(defmethod initialize-instance :after ((tree named-tree) &key)
  (assert (null (wxlambda:tree-root tree)))
  (assert (null (wxlambda:selection tree))))
(defvar *failed-tree-items* nil)
(defvar *failed-tree-id* nil)
(defclass failing-tree (wxlambda:tree-control) ())
(defmethod initialize-instance :after ((tree failing-tree) &key)
  (setf *failed-tree-id* (wxlambda::handle tree))
  (let* ((root (wxlambda:add-tree-root tree "Failed root")) (child (wxlambda:append-tree-item root "Failed child")))
    (setf *failed-tree-items* (list root child))
    (wxlambda:bind-event tree :tree-selection-changed (lambda (event) (declare (ignore event)) (error "Should not run"))))
  (error "Tree initialization failure"))
(defvar *saved-tree-snapshot* nil)
(wxlambda:with-application ()
  (assert (wxlambda-tree-navigation:exercise))
  (let* ((frame (wxlambda:make-frame))
         (tree (wxlambda:make-tree-control frame :class 'named-tree :tag :factory))
         (other (make-instance 'named-tree :parent frame))
         (other-root (wxlambda:add-tree-root other "Other"))
         (root (wxlambda:add-tree-root tree "Root λ"))
         (branch (wxlambda:append-tree-item root "Branch"))
         (leaf (wxlambda:append-tree-item branch "日本語 😀"))
         (sibling (wxlambda:append-tree-item root "Sibling"))
         (events nil) (veto nil) (context nil) (changing nil) (changed nil))
    (unwind-protect
         (progn
           (assert (eq :factory (tree-tag tree))) (assert (eq :default (tree-tag other)))
           (assert (eq root (wxlambda:tree-root tree))) (assert (eq root (wxlambda:selection tree)))
           (assert (null (wxlambda:tree-item-parent root)))
           (assert (eq root (wxlambda:tree-item-parent branch)))
           (assert (equal (list branch sibling) (wxlambda:tree-item-children root)))
           (assert (null (wxlambda:tree-item-children leaf)))
           (assert (wxlambda:tree-item-alive-p leaf))
           (let ((value (copy-seq "Renamed λ")) (old (wxlambda:tree-item-text leaf)))
             (assert (eq value (setf (wxlambda:tree-item-text leaf) value)))
             (assert (string= "日本語 😀" old)))
           (setf (wxlambda:tree-item-expanded-p root) t (wxlambda:tree-item-expanded-p branch) t)
           (assert (wxlambda:tree-item-expanded-p root))
           (setf changing
                 (wxlambda:bind-event tree :tree-selection-changing
                   (lambda (event borrowed)
                     (setf context borrowed) (push event events)
                     (assert (eq :notify (wxlambda:event-family event)))
                     (assert (eq leaf (wxlambda:event-tree-item event)))
                     (assert (eq leaf (wxlambda:event-tree-item borrowed)))
                     (assert (null (wxlambda:event-selection event)))
                     (expect-tree-error (lambda () (wxlambda:delete-tree-item branch)) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (wxlambda:append-tree-item root "Unsafe")) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (setf (wxlambda:tree-item-text root) "Unsafe")) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (setf (wxlambda:tree-item-expanded-p root) nil)) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (setf (wxlambda:selection tree) root)) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (wxlambda:destroy-window tree)) 'wxlambda:native-error)
                     (expect-tree-error (lambda () (wxlambda:close-window frame)) 'wxlambda:native-error)
                     (expect-tree-error #'wxlambda:clipboard-text-available-p 'wxlambda:native-error)
                     (expect-tree-error (lambda () (wxlambda:clone-event borrowed)) 'wxlambda:native-error)
                     (when veto (setf (wxlambda:event-vetoed-p borrowed) t))) :with-context t)
                 changed (wxlambda:bind-event tree :tree-selection-changed
                           (lambda (event) (push event events) (setf *saved-tree-snapshot* event))))
           (setf veto t)
           (assert (eq leaf (setf (wxlambda:selection tree :notify t) leaf)))
           (assert (eq root (wxlambda:selection tree)))
           (assert (not (wxlambda:event-context-active-p context)))
           (setf veto nil events nil)
           (setf (wxlambda:selection tree :notify t) leaf)
           (assert (eq leaf (wxlambda:selection tree)))
           (assert (find :tree-selection-changed events :key #'wxlambda:event-kind))
           (wxlambda:unbind-event changing) (wxlambda:unbind-event changed)
           (setf events nil changed (wxlambda:bind-event tree :tree-selection-changed (lambda (event) (push event events))))
           ;; Collapse/delete normalize under blockers, without delayed idle selection events.
           (setf (wxlambda:tree-item-expanded-p branch) nil)
           (assert (eq branch (wxlambda:selection tree)))
           (wxlambda:process-events)
           (assert (eq branch (wxlambda:selection tree))) (assert (null events))
           (setf (wxlambda:selection tree) sibling)
           (wxlambda:delete-tree-item branch)
           (wxlambda:process-events)
           (assert (eq sibling (wxlambda:selection tree))) (assert (null events))
           (assert (not (wxlambda:tree-item-alive-p branch))) (assert (not (wxlambda:tree-item-alive-p leaf)))
           (assert (eq leaf (wxlambda:event-tree-item *saved-tree-snapshot*)))
           (assert (not (gethash (wxlambda::handle leaf) wxlambda::*tree-item-objects*)))
           (expect-tree-error (lambda () (wxlambda:tree-item-text leaf)) 'wxlambda:native-error)
           (expect-tree-error (lambda () (wxlambda:append-tree-item leaf "Stale")) 'wxlambda:native-error)
           (expect-tree-error (lambda () (setf (wxlambda:selection tree) leaf)) 'wxlambda:native-error)
           (expect-tree-error (lambda () (setf (wxlambda:selection tree) other-root)) 'wxlambda:native-error)
           (expect-tree-error (lambda () (setf (wxlambda:selection tree) nil)) 'wxlambda:native-error)
           (expect-tree-error (lambda () (wxlambda:add-tree-root tree "Second root")))
           (expect-tree-error (lambda () (make-instance 'wxlambda:tree-item)))
           (dolist (value (list 1 (string (code-char 0))))
             (expect-tree-error (lambda () (wxlambda:append-tree-item root value)))
             (expect-tree-error (lambda () (setf (wxlambda:tree-item-text root) value))))
           (dolist (kind '(:tree-selection-changing :tree-selection-changed))
             (expect-tree-error (lambda () (wxlambda:register-event-type kind)))
             (expect-tree-error (lambda () (wxlambda:make-event :kind kind)))
             (expect-tree-error (lambda () (wxlambda:process-event tree kind))))
           (wxlambda:unbind-event changed)
           (setf changed (wxlambda:bind-event tree :tree-selection-changed
                          (lambda (event) (declare (ignore event)) (error "Tree callback error"))))
           (expect-tree-error (lambda () (setf (wxlambda:selection tree :notify t) root)))
           (wxlambda:unbind-event changed)
           (setf (wxlambda:selection tree) sibling)
           (let ((roots (hash-table-count wxlambda::*handlers*)))
             (expect-tree-error (lambda () (make-instance 'failing-tree :parent frame)))
             (dolist (item *failed-tree-items*)
               (assert (not (gethash (wxlambda::handle item) wxlambda::*tree-item-objects*))))
             (wxlambda:process-events)
             (assert (= roots (hash-table-count wxlambda::*handlers*)))
             (assert (zerop (wxlambda::%handler-alive *failed-tree-id*)))
             (dolist (item *failed-tree-items*) (assert (not (wxlambda:tree-item-alive-p item)))))
           (wxlambda:delete-tree-item sibling)
           (wxlambda:process-events)
           (assert (eq root (wxlambda:selection tree)))
           (wxlambda:delete-tree-item root)
           (wxlambda:process-events)
           (assert (null (wxlambda:tree-root tree))) (assert (null (wxlambda:selection tree)))
           (assert (null (setf (wxlambda:selection tree) nil)))
           (let ((replacement (wxlambda:add-tree-root tree "Replacement")))
             (assert (not (eq root replacement))) (assert (wxlambda:tree-item-alive-p replacement))
             (assert (not (wxlambda:tree-item-alive-p root)))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))
    (assert (not (wxlambda:tree-item-alive-p other-root)))
    (expect-tree-error (lambda () (wxlambda:tree-root tree)) 'wxlambda:native-error)))
(assert (typep (wxlambda:event-tree-item *saved-tree-snapshot*) 'wxlambda:tree-item))
(expect-tree-error (lambda () (wxlambda:tree-item-alive-p (wxlambda:event-tree-item *saved-tree-snapshot*))) 'wxlambda:native-error)
(format t "PASS: tree canonical items, native navigation/veto, idle normalization, deletion/stale guards and CLOS rollback~%")
