(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-dispatch-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (not (typep condition 'wxlambda:native-error))))))

(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(let ((suppressed-calls 0) (driver-calls 0) (rebound-calls 0))
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "wxlambda text and handlers"))
           (panel (wxlambda:make-panel frame))
           (text (wxlambda:make-text panel :value "λ 日本語 😀"))
           (button (wxlambda:make-button panel :label "Unbind/rebind"))
           (driver (wxlambda:make-button panel :label "Continue"))
           (initial (wxlambda:text text))
           (long-value (apply #'concatenate 'string (make-list 2048 :initial-element "λ日本語😀"))))
      (assert (string= initial "λ 日本語 😀"))
      (setf (wxlambda:text text) "")
      (assert (string= "" (wxlambda:text text)))
      (setf (wxlambda:text text) long-value)
      (assert (string= long-value (wxlambda:text text)))
      ;; Previously returned Lisp strings must survive later native reads/writes.
      (assert (string= initial "λ 日本語 😀"))
      (expect-dispatch-error (lambda () (wxlambda:text button)))
      (assert (string= long-value (wxlambda:text text)))
      (wxlambda:make-column panel)
      (dolist (child (list text button driver)) (wxlambda:add-child panel child))
      ;; Replacement must not accumulate retained closures.
      (dotimes (i 50)
        (wxlambda:on-click button (lambda () (incf suppressed-calls)))
        (assert (= 1 (hash-table-count wxlambda::*handlers*))))
      (expect-dispatch-error (lambda () (wxlambda:off-click text)))
      (assert (= 1 (hash-table-count wxlambda::*handlers*)))
      ;; Removing a handler also suppresses events already queued for that button.
      (wxlambda:queue-click button)
      (wxlambda:off-click button)
      (wxlambda:off-click button)
      (assert (zerop (hash-table-count wxlambda::*handlers*)))
      (wxlambda:on-click driver
        (lambda ()
          (incf driver-calls)
          (assert (zerop suppressed-calls))
          (wxlambda:off-click driver)
          (assert (zerop (hash-table-count wxlambda::*handlers*)))
          ;; Rebinding redirects this already queued event to the new closure.
          (wxlambda:queue-click button)
          (wxlambda:on-click button
            (lambda ()
              (incf rebound-calls)
              (wxlambda:off-click button)
              (assert (zerop (hash-table-count wxlambda::*handlers*)))
              (assert (string= long-value (wxlambda:text text)))
              (wxlambda:destroy-window frame)))))
      (wxlambda:show-window frame)
      (wxlambda:queue-click driver)
      (wxlambda:run)
      (assert (= 1 driver-calls rebound-calls))
      (assert (zerop suppressed-calls))
      (expect-native-error (lambda () (wxlambda:text text)))
      (expect-native-error (lambda () (wxlambda:off-click button)))
      (expect-native-error (lambda () (wxlambda:on-click button (lambda () nil))))
      (assert (zerop (hash-table-count wxlambda::*handlers*))))))
(format t "PASS: UTF-8 text copies, handler release, queued unbinding, and rebinding~%")
