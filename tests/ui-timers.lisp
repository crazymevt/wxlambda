(load (merge-pathnames "../examples/periodic-status.lisp" *load-truename*))
(defun timer-expect-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defun timer-wait (predicate)
  (loop repeat 300 until (funcall predicate) do (wxlambda:process-events) (sleep 0.005))
  (assert (funcall predicate)))
(defvar *failed-owner-timer* nil)
(defclass failed-timer-owner (wxlambda:frame) ())
(defmethod initialize-instance :after ((frame failed-timer-owner) &key)
  (setf *failed-owner-timer* (wxlambda:start-ui-timer (lambda () (error "Failed owner timer ran")) 1 :owner frame))
  (error "Expected timer owner initialization rollback"))
(defun timer-normal-tests ()
  (assert (wxlambda-periodic-status:exercise))
  (let* ((frame (wxlambda:make-frame)) (child (wxlambda:make-panel frame))
         (calls 0) (ticket nil))
    (wxlambda:show-window frame)
    (dolist (interval '(-1 0 86400001 1.5 nil))
      (timer-expect-error (lambda () (wxlambda:start-ui-timer (lambda () nil) interval))))
    (timer-expect-error (lambda () (wxlambda:start-ui-timer 42 1)))
    (timer-expect-error (lambda () (wxlambda:start-ui-timer (lambda () nil) 1 :owner (wxlambda:current-application-handler))))
    (setf ticket (wxlambda:start-ui-timer
                   (lambda ()
                     (incf calls)
                     (assert (not (wxlambda:ui-timer-active-p ticket)))
                     (assert (not (wxlambda:cancel-ui-timer ticket)))) 5 :owner frame :one-shot t))
    (assert (wxlambda:ui-timer-p ticket)) (assert (wxlambda:ui-timer-active-p ticket))
    (sleep 0.02) (wxlambda:process-pending-events) (assert (zerop calls))
    (timer-wait (lambda () (= calls 1)))
    (dotimes (n 3) (declare (ignore n)) (wxlambda:process-events)) (assert (= calls 1))
    ;; Cancel-before-fire and owner/ancestor destruction retire closure roots.
    (let ((timer (wxlambda:start-ui-timer (lambda () (error "Canceled timer ran")) 100 :owner frame)))
      (assert (wxlambda:cancel-ui-timer timer)) (assert (not (wxlambda:cancel-ui-timer timer))))
    (let* ((parent (wxlambda:make-panel frame)) (owned (wxlambda:make-panel parent))
           (timer (wxlambda:start-ui-timer (lambda () (error "Dead owner timer ran")) 1 :owner owned)))
      (wxlambda:destroy-window parent)
      (assert (not (wxlambda:ui-timer-active-p timer)))
      (assert (not (gethash (wxlambda::ui-timer-token timer) wxlambda::*ui-timers*))))
    (let ((before (hash-table-count wxlambda::*ui-timers*)))
      (timer-expect-error (lambda () (make-instance 'failed-timer-owner)))
      (wxlambda:process-events)
      (assert (not (wxlambda:ui-timer-active-p *failed-owner-timer*)))
      (assert (= before (hash-table-count wxlambda::*ui-timers*))))
    ;; The periodic function runs outside native Notify, can open a modal,
    ;; coalesces its ticks there, and can cancel itself without reentrant entry.
    (let ((timer nil) (inside nil) (seen 0) (modal-idles 0) (binding nil)
          (dialog (wxlambda:make-message-dialog :parent frame :message "Timer modal" :buttons :ok-cancel)))
      (unwind-protect
           (progn
             (setf binding (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                             (lambda (event) (declare (ignore event))
                               (when (wxlambda:dialog-modal-p dialog)
                                 (incf modal-idles) (assert inside) (assert (= seen 1))
                                 (sleep 0.005)
                                 (wxlambda:end-modal dialog :cancel)))))
             (setf timer (wxlambda:start-ui-timer
                           (lambda ()
                             (assert (not inside)) (setf inside t) (incf seen)
                             (assert (wxlambda:ui-timer-active-p timer))
                             (assert (eq :cancel (wxlambda:show-modal dialog)))
                             (assert (typep (wxlambda:clipboard-text-available-p) 'boolean))
                             (timer-expect-error #'wxlambda:process-events 'wxlambda:native-error)
                             (let ((bar (wxlambda:make-status-bar frame))) (wxlambda:destroy-window bar))
                             (assert (wxlambda:cancel-ui-timer timer))
                             (setf inside nil)) 1 :owner frame))
             (timer-wait (lambda () (= seen 1)))
             (assert (plusp modal-idles))
             (sleep 0.01) (wxlambda:process-events) (assert (= seen 1)))
        (when timer (wxlambda:cancel-ui-timer timer))
        (when binding (wxlambda:unbind-event binding))
        (wxlambda:destroy-window dialog)))
    ;; Session-owned callbacks continue under RUN and stop it explicitly.
    (let ((run-calls 0) (timer nil))
      (setf timer (wxlambda:start-ui-timer
                    (lambda () (incf run-calls) (when (= run-calls 2) (wxlambda:cancel-ui-timer timer) (wxlambda:stop))) 5))
      (wxlambda:run) (assert (= run-calls 2)) (assert (not (wxlambda:ui-timer-active-p timer))))
    (wxlambda:destroy-window child) (wxlambda:destroy-window frame) (wxlambda:process-events)))
(defun timer-error-test (run-p nonlocal-p)
  (let* ((frame (wxlambda:make-frame))
         (failure (make-condition 'simple-error :format-control "Expected UI timer failure"))
         (calls 0) (seen nil)
         (timer (wxlambda:start-ui-timer (lambda () (incf calls) (if nonlocal-p (throw 'timer-outside :escaped) (error failure))) 1 :owner frame)))
    (wxlambda:show-window frame)
    (assert (eq :contained
                (catch 'timer-outside
                  (handler-case
                      (if run-p (wxlambda:run) (timer-wait (lambda () (plusp calls))))
                    (error (condition) (setf seen condition)))
                  :contained)))
    (assert seen) (unless nonlocal-p (assert (eq seen failure)))
    (assert (= 1 calls))
    (assert (not (wxlambda:ui-timer-active-p timer)))
    (assert (not (gethash (wxlambda::ui-timer-token timer) wxlambda::*ui-timers*)))
    (sleep 0.01) (wxlambda:process-events) (assert (= 1 calls))
    (wxlambda:destroy-window frame) (wxlambda:process-events)))
(timer-expect-error (lambda () (wxlambda:start-ui-timer (lambda () nil) 1)) 'wxlambda:native-error)
(let ((mode (or (uiop:getenv "WXLAMBDA_UI_TIMER_TEST_MODE") "normal")) (roots nil) (orphan nil))
  (wxlambda:with-application ()
    (cond ((string= mode "normal") (timer-normal-tests))
          ((string= mode "error-pump") (timer-error-test nil nil))
          ((string= mode "error-run") (timer-error-test t nil))
          ((string= mode "nonlocal") (timer-error-test nil t))
          (t (error "Unknown UI timer test mode")))
    (setf roots wxlambda::*ui-timers*
          orphan (wxlambda:start-ui-timer (lambda () (error "Shutdown timer ran")) 1)))
  (assert (zerop (hash-table-count roots)))
  (timer-expect-error (lambda () (wxlambda:ui-timer-active-p orphan)) 'wxlambda:native-error)
  (timer-expect-error (lambda () (wxlambda:cancel-ui-timer orphan)) 'wxlambda:native-error))
(format t "PASS: bounded UI timers, real periodic/one-shot delivery, safe modal/self-cancel, owner/root/error/RUN/shutdown lifecycle~%")
