(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-dispatch-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (not (typep condition 'wxlambda:native-error))))))

(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(let ((mode (or (uiop:getenv "WXLAMBDA_EVENT_TEST_MODE") "payloads"))
      (text-calls 0)
      (click-calls 0)
      (saved-events nil)
      (saved-click nil)
      (observed-error nil)
      (handled-error nil)
      (setter-returned nil)
      (saved-control nil))
  (handler-case
      (wxlambda:with-application ()
        (let* ((frame (wxlambda:make-frame :title "Event payload tests"))
               (panel (wxlambda:make-panel frame))
               (text (wxlambda:make-text panel :value "Initial"))
               (button (wxlambda:make-button panel :label "Test events")))
          (setf saved-control text)
          (wxlambda:make-column panel)
          (wxlambda:add-child panel text)
          (wxlambda:add-child panel button)
          (if (string= mode "payloads")
              (progn
                (wxlambda:on-text-change text
                  (lambda (event)
                    (assert (wxlambda:event-p event))
                    (assert (eq :text-change (wxlambda:event-kind event)))
                    (assert (eq text (wxlambda:event-source event)))
                    (incf text-calls)
                    (push event saved-events)
                    ;; Reentrant writes must not alter the outer event snapshot.
                    (cond ((string= "Outer λ 日本語 😀" (wxlambda:event-text event))
                           (setf (wxlambda:text text :notify t) "Inner 😀")
                           (assert (string= "Outer λ 日本語 😀" (wxlambda:event-text event))))
                          ((string= "Inner 😀" (wxlambda:event-text event))
                           (setf (wxlambda:text text) "Silent update")))))
                ;; Event delivery also works before starting the event loop.
                (setf (wxlambda:text text :notify t) "Outer λ 日本語 😀")
                (assert (= 2 text-calls))
                (assert (string= "Silent update" (wxlambda:text text)))
                (setf (wxlambda:text text) "Silent again")
                (assert (= 2 text-calls))
                (setf (wxlambda:text text :notify t) "")
                (assert (= 3 text-calls))
                (assert (string= "" (wxlambda:event-text (first saved-events))))
                (wxlambda:on-click button
                  (lambda (event)
                    (incf click-calls)
                    (setf saved-click event)
                    (assert (eq :click (wxlambda:event-kind event)))
                    (assert (eq button (wxlambda:event-source event)))
                    (assert (null (wxlambda:event-text event)))
                    (assert (= 2 (hash-table-count wxlambda::*handlers*)))
                    ;; Wrong-type registration must preserve both existing handlers.
                    (expect-dispatch-error
                     (lambda () (wxlambda:on-text-change button (lambda (event) (declare (ignore event))))))
                    (expect-dispatch-error (lambda () (wxlambda:off-text-change button)))
                    (assert (= 2 (hash-table-count wxlambda::*handlers*)))
                    (dotimes (i 20)
                      (wxlambda:on-text-change text
                        (lambda (event)
                          (incf text-calls)
                          (push event saved-events)
                          (wxlambda:off-text-change text)))
                      (assert (= 2 (hash-table-count wxlambda::*handlers*))))
                    (setf (wxlambda:text text :notify t) "Self-unbind λ")
                    (assert (= 4 text-calls))
                    (assert (= 1 (hash-table-count wxlambda::*handlers*)))
                    (wxlambda:off-text-change text)
                    (setf (wxlambda:text text :notify t) "Unbound")
                    (assert (= 4 text-calls))
                    (wxlambda:off-click button)
                    (assert (zerop (hash-table-count wxlambda::*handlers*)))
                    (wxlambda:destroy-window frame))
                  :with-event t)
                (wxlambda:show-window frame)
                (wxlambda:queue-click button)
                (wxlambda:run)
                (assert (= 1 click-calls))
                ;; Copies remain usable after native events and windows are gone.
                (assert (wxlambda:event-p saved-click))
                (assert (equal '("Self-unbind λ" "" "Inner 😀" "Outer λ 日本語 😀")
                               (mapcar #'wxlambda:event-text saved-events)))
                (expect-native-error (lambda () (wxlambda:text (wxlambda:event-source (first saved-events)))))
                (expect-native-error (lambda () (wxlambda:off-text-change text)))
                (expect-native-error (lambda () (wxlambda:on-text-change text (lambda (event) (declare (ignore event))))))
                (assert (zerop (hash-table-count wxlambda::*handlers*))))
              (progn
                (wxlambda:on-text-change text
                  (lambda (event)
                    (declare (ignore event))
                    (incf text-calls)
                    (error "Expected text-handler failure")))
                (flet ((trigger ()
                         (setf (wxlambda:text text :notify t) "Raise λ")
                         (setf setter-returned t)))
                  (if (string= mode "error-before-run")
                      (trigger)
                      (progn
                        (wxlambda:on-click button
                          (if (string= mode "error-handled-in-loop")
                              (lambda ()
                                (incf click-calls)
                                (if (= click-calls 1)
                                    (progn
                                      ;; wxWidgets can drain queued events after an exit
                                      ;; request, so later delivery alone is insufficient.
                                      (let ((original-stop (symbol-function 'wxlambda::%stop))
                                            (stop-requests 0))
                                        (unwind-protect
                                             (progn
                                               (setf (symbol-function 'wxlambda::%stop)
                                                     (lambda ()
                                                       (incf stop-requests)
                                                       (funcall original-stop)))
                                               (handler-case (trigger)
                                                 (error (condition)
                                                   (assert (search "Expected text-handler failure"
                                                                   (princ-to-string condition)))
                                                   (setf handled-error t))))
                                          (setf (symbol-function 'wxlambda::%stop) original-stop))
                                        (assert (zerop stop-requests)))
                                      (assert handled-error)
                                      (assert (null wxlambda::*callback-error*))
                                      ;; The loop must dispatch a later event before returning.
                                      (wxlambda:queue-click button))
                                    (wxlambda:destroy-window frame)))
                              #'trigger))
                        (wxlambda:show-window frame)
                        (wxlambda:queue-click button)
                        (wxlambda:run)
                        (when (string= mode "error-handled-in-loop")
                          (assert handled-error)
                          (assert (= 2 click-calls))))))))))
    (error (condition)
      (unless (and (member mode '("error-before-run" "error-in-loop") :test #'string=)
                   (search "Expected text-handler failure" (princ-to-string condition)))
        (error condition))
      (setf observed-error t)))
  (assert (eq observed-error
              (not (null (member mode '("error-before-run" "error-in-loop") :test #'string=)))))
  (unless (string= mode "payloads")
    (assert (= 1 text-calls))
    (assert (not setter-returned)))
  (assert (not wxlambda::*active*))
  (assert (not wxlambda::*handlers*))
  (expect-native-error (lambda () (wxlambda:text saved-control)))
  (format t "PASS: events ~A, copied payloads, and cleanup~%" mode))
