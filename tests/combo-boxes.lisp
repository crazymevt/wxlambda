(load (merge-pathnames "../examples/combo-boxes.lisp" *load-truename*))
(defun combo-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-combo (wxlambda:combo-box) ((tag :initarg :tag :reader combo-tag))
  (:default-initargs :items '("First λ" "Second") :selection 1 :tag :default))
(defmethod initialize-instance :after ((object custom-combo) &key)
  (assert (= 2 (wxlambda:item-count object))) (assert (= 1 (wxlambda:selection object)))
  (assert (string= "Second" (wxlambda:text object))))
(defclass mixed-combo (wxlambda:combo-box wxlambda:choice) ())
(defclass failing-combo (wxlambda:combo-box) ())
(defvar *failed-combo* nil)
(defmethod initialize-instance :after ((object failing-combo) &key)
  (setf *failed-combo* object)
  (wxlambda:bind-event object :text-change (lambda (event) (declare (ignore event))))
  (error "Expected rollback"))
(defvar *combo-snapshot* nil)
(wxlambda:with-application ()
  (assert (wxlambda-combo-boxes:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (combo (make-instance 'custom-combo :parent panel))
         (other (wxlambda:make-combo-box panel :class 'custom-combo :tag :factory))
         (empty (wxlambda:make-combo-box panel :value "Custom λ"))
         (calls 0) (context nil))
    (assert (eq :factory (combo-tag other))) (assert (zerop (wxlambda:item-count empty)))
    (assert (string= "Custom λ" (wxlambda:text empty)))
    (assert (string= "First λ" (wxlambda:item-text combo 0)))
    (dolist (args '((:items ("a" "A")) (:items ("")) (:items ("a") :selection 1)
                    (:items ("a") :selection 0 :value "conflict") (:selection -1) (:read-only t)))
      (combo-error (lambda () (apply #'wxlambda:make-combo-box panel args))))
    (combo-error (lambda () (wxlambda:make-combo-box panel :items (make-list 257 :initial-element "a"))))
    (dolist (invalid (list (string #\Null) (format nil "a~%b") (string #\Return)))
      (combo-error (lambda () (wxlambda:make-combo-box panel :value invalid)))
      (combo-error (lambda () (wxlambda:make-combo-box panel :items (list invalid))))
      (combo-error (lambda () (setf (wxlambda:text combo) invalid))))
    (combo-error (lambda () (make-instance 'mixed-combo :parent panel)))
    (combo-error (lambda () (wxlambda:make-combo-box panel :class 'wxlambda:choice)))
    (combo-error (lambda () (wxlambda:item-text combo 2)))
    (combo-error (lambda () (setf (wxlambda:item-text combo 0) "new")))
    (combo-error (lambda () (setf (wxlambda:selection empty) 0)))
    (let ((binding (wxlambda:bind-event frame :combo-selection
      (lambda (event current)
        (incf calls) (setf context current *combo-snapshot* event)
        (assert (eq :command (wxlambda:event-family event)))
        (assert (= 0 (wxlambda:event-selection event) (wxlambda:event-selection current)))
        (assert (string= "First λ" (wxlambda:event-text event)))
        (dolist (operation (list (lambda () (setf (wxlambda:selection combo) 1))
                                (lambda () (setf (wxlambda:text combo) "nested"))
                                (lambda () (wxlambda:destroy-window combo))
                                (lambda () (wxlambda:destroy-window panel))
                                (lambda () (wxlambda:close-window frame))
                                (lambda () (wxlambda:process-events))
                                (lambda () (wxlambda:clipboard-text))
                                (lambda () (wxlambda:clone-event current))
                                (lambda () (setf (wxlambda:event-selection current) 1))))
          (combo-error operation 'wxlambda:native-error))
        (setf (wxlambda:text other) "Silent sync")) :with-context t)))
      (setf (wxlambda:selection combo) 0) (assert (zerop calls))
      (setf (wxlambda:selection combo :notify t) 0) (assert (= 1 calls))
      (assert (string= "Silent sync" (wxlambda:text other)))
      (combo-error (lambda () (wxlambda:event-selection context)) 'wxlambda:native-error)
      (wxlambda:unbind-event binding))
    (let ((binding (wxlambda:bind-event combo :text-change
      (lambda (event)
        (incf calls) (assert (string= "New λ" (wxlambda:event-text event)))
        (combo-error (lambda () (setf (wxlambda:selection combo) 0)) 'wxlambda:native-error)))))
      (setf (wxlambda:text combo) "Silent") (assert (= 1 calls))
      (setf (wxlambda:text combo :notify t) "New λ") (assert (= 2 calls))
      (wxlambda:unbind-event binding))
    (setf (wxlambda:text combo) "First λ")
    (assert (string= "First λ" (wxlambda:text combo)))
    (setf (wxlambda:selection combo) nil)
    (assert (null (wxlambda:selection combo))) (assert (string= "" (wxlambda:text combo)))
    (combo-error (lambda () (wxlambda:make-event :kind :combo-selection)))
    (combo-error (lambda () (wxlambda:process-event frame :combo-selection)))
    (let* ((expected (make-condition 'simple-error :format-control "Combo callback condition"))
           (binding (wxlambda:bind-event combo :combo-selection (lambda (event) (declare (ignore event)) (error expected)))))
      (assert (eq expected (handler-case (setf (wxlambda:selection combo :notify t) 1) (error (c) c))))
      (assert (= 1 (wxlambda:selection combo))) (assert (string= "Second" (wxlambda:text combo)))
      (wxlambda:unbind-event binding))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (combo-error (lambda () (make-instance 'failing-combo :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (combo-error (lambda () (wxlambda:text *failed-combo*)) 'wxlambda:native-error)
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (combo-error (lambda () (wxlambda:text combo)) 'wxlambda:native-error)))
(assert (string= "First λ" (wxlambda:event-text *combo-snapshot*)))
(format t "PASS: editable fixed combo choices, text/selection, CLOS, native event guards, rollback, errors and example~%")
