(load (merge-pathnames "../examples/event-handlers.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (typep condition type)))))
(defvar *failed-handles* nil)
(defclass failing-handler (wxlambda:event-handler) ())
(defmethod initialize-instance :after ((object failing-handler) &key)
  (push (wxlambda::handle object) *failed-handles*)
  (push (wxlambda::handle (make-instance 'wxlambda:event-handler)) *failed-handles*)
  (let* ((frame (wxlambda:make-frame))
         (button (wxlambda:make-button frame)))
    (push (wxlambda::handle frame) *failed-handles*)
    (push (wxlambda::handle button) *failed-handles*)
    (wxlambda:on-click button (lambda () (error "must be released on rollback"))))
  (error "managed handler failure"))

(expect-error (lambda () (make-instance 'wxlambda:event-handler)) 'wxlambda:native-error)
(let (saved)
  (wxlambda:with-application ()
    (wxlambda-event-handlers:exercise)
    (let* ((handler (make-instance 'wxlambda:event-handler))
           (custom (wxlambda:make-event-handler :class (find-class 'wxlambda-event-handlers::named-handler)
                                               :name "custom"))
           (frame (wxlambda:make-frame))
           (button (wxlambda:make-button frame)))
      (setf saved handler)
      (assert (typep frame 'wxlambda:event-handler))
      (assert (wxlambda:handler-alive-p handler))
      (assert (wxlambda:handler-alive-p button))
      (assert (string= "custom" (wxlambda-event-handlers::name custom)))
      (assert (wxlambda-event-handlers::initially-enabled custom))
      (assert (eq :enabled (setf (wxlambda:handler-enabled-p handler) :enabled)))
      (setf (wxlambda:handler-enabled-p handler) nil)
      (assert (not (wxlambda:handler-enabled-p handler)))
      (expect-error (lambda () (wxlambda:make-event-handler :class 'wxlambda:frame)))
      (expect-error (lambda () (wxlambda:make-event-handler :class 'standard-object)))
      (expect-error (lambda () (wxlambda:make-event-handler :unexpected t)))
      (expect-error (lambda () (initialize-instance handler)))
      (expect-error (lambda () (make-instance 'failing-handler)))
      (wxlambda:process-events)
      (assert (zerop (hash-table-count wxlambda::*handlers*)))
      (dolist (id *failed-handles*) (assert (zerop (wxlambda::%handler-alive id))))
      ;; Window-backed identities are borrowed and cannot be independently deleted.
      (expect-error (lambda () (wxlambda:destroy-event-handler button)) 'wxlambda:native-error)
      (assert (wxlambda:handler-alive-p button))
      (expect-error (lambda () (wxlambda::check-status (wxlambda::%destroy (wxlambda::handle handler))))
                    'wxlambda:native-error)
      ;; Disabling event processing also suppresses wxEVT_DESTROY delivery. Native
      ;; weak tracking must still reject destroyed pointers, including children.
      (wxlambda:off-click button)
      (setf (wxlambda:handler-enabled-p button) nil
            (wxlambda:handler-enabled-p frame) nil)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events)
      (assert (not (wxlambda:handler-alive-p frame)))
      (assert (not (wxlambda:handler-alive-p button)))
      (expect-error (lambda () (wxlambda:handler-enabled-p button)) 'wxlambda:native-error)
      (expect-error (lambda () (wxlambda:window-name frame)) 'wxlambda:native-error)
      (wxlambda:destroy-event-handler custom)
      (wxlambda:destroy-event-handler handler)
      (assert (not (wxlambda:handler-alive-p handler)))
      (expect-error (lambda () (wxlambda:handler-enabled-p handler)) 'wxlambda:native-error)
      (expect-error (lambda () (wxlambda:destroy-event-handler handler)) 'wxlambda:native-error)
      (expect-error (lambda () (setf (wxlambda:handler-enabled-p handler) t)) 'wxlambda:native-error)
      ;; Session cleanup owns this final object even after its Lisp wrapper is gone.
      (make-instance 'wxlambda:event-handler)))
  (expect-error (lambda () (wxlambda:handler-alive-p saved)) 'wxlambda:native-error))
(format t "PASS: event-handler ownership, CLOS construction, dispatch gating, weak invalidation, rollback and cleanup~%")
