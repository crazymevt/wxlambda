(load (merge-pathnames "../examples/event-metadata.lisp" *load-truename*))
(defun expect-error (thunk &optional (type 'error))
  (assert (handler-case (progn (funcall thunk) nil) (error (c) (typep c type)))))
(let (saved expired outer)
  (wxlambda:with-application ()
    (wxlambda-event-metadata:exercise)
    (wxlambda:register-event-type :metadata-notify)
    (wxlambda:register-event-type :metadata-command :family :command)
    (let* ((receiver (wxlambda:make-event-handler))
           (bits (* 8 (cffi:foreign-type-size :long)))
           (minimum (- (ash 1 (1- bits)))) (maximum (1- (ash 1 (1- bits)))))
      (dolist (kind '(:click :text-change :toggle :selection :close :query-end-session :end-session :metadata-notify :metadata-command))
        (let* ((close-p (member kind '(:close :query-end-session :end-session)))
               (command-p (not close-p))
               (binding (wxlambda:bind-event receiver kind
                          (lambda (event context)
                            (setf saved event expired context)
                            (assert (eql command-p (wxlambda:event-command-p event)))
                            (assert (eql command-p (wxlambda:event-command-p context)))
                            (assert (zerop (wxlambda:event-timestamp event)))
                            (dolist (value (list minimum -1 0 maximum))
                              (assert (= value (setf (wxlambda:event-timestamp context) value)))
                              (assert (= value (wxlambda:event-timestamp context))))
                            (dolist (bad (list (1- minimum) (1+ maximum) 1/2 "bad"))
                              (expect-error (lambda () (setf (wxlambda:event-timestamp context) bad)) 'type-error))
                            (assert (= maximum (wxlambda:event-timestamp context)))
                            (assert (zerop (wxlambda:event-timestamp event)))
                            (if close-p
                                (progn
                                  (assert (wxlambda:event-can-veto-p event))
                                  (assert (eq :yes (setf (wxlambda:event-can-veto-p context) :yes)))
                                  (setf (wxlambda:event-vetoed-p context) t)
                                  (setf (wxlambda:event-can-veto-p context) nil)
                                  (assert (not (wxlambda:event-vetoed-p context)))
                                  (expect-error (lambda () (setf (wxlambda:event-vetoed-p context) nil)) 'wxlambda:native-error)
                                  ;; SetCanVeto hides a stored veto; it does not clear it.
                                  (setf (wxlambda:event-can-veto-p context) t)
                                  (assert (wxlambda:event-vetoed-p context)))
                                (expect-error (lambda () (setf (wxlambda:event-can-veto-p context) t)) 'wxlambda:native-error)))
                          :with-context t)))
          (assert (equal (list t (not (null close-p)))
                         (multiple-value-list (wxlambda:process-event receiver kind))))
          (expect-error (lambda () (wxlambda:event-timestamp expired)) 'wxlambda:native-error)
          (expect-error (lambda () (wxlambda:event-command-p expired)) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-timestamp expired) 1)) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-can-veto-p expired) t)) 'wxlambda:native-error)
          (expect-error (lambda () (setf (wxlambda:event-timestamp saved) 1)))
          (expect-error (lambda () (setf (wxlambda:event-can-veto-p saved) t)))
          (wxlambda:unbind-event binding)))
      (let* ((inner (wxlambda:bind-event receiver :metadata-command
                      (lambda (e c)
                        (declare (ignore e c))
                        (expect-error (lambda () (wxlambda:event-timestamp outer)) 'wxlambda:native-error)
                        (expect-error (lambda () (wxlambda:event-command-p outer)) 'wxlambda:native-error)
                        (expect-error (lambda () (setf (wxlambda:event-timestamp outer) 2)) 'wxlambda:native-error)
                        (expect-error (lambda () (setf (wxlambda:event-can-veto-p outer) nil)) 'wxlambda:native-error)) :with-context t))
             (binding (wxlambda:bind-event receiver :close
                        (lambda (e c)
                          (declare (ignore e))
                          (setf outer c (wxlambda:event-timestamp c) -1)
                          (wxlambda:process-event receiver :metadata-command)
                          (assert (= -1 (wxlambda:event-timestamp c)))) :with-context t)))
        (wxlambda:process-event receiver :close)
        (wxlambda:unbind-event binding) (wxlambda:unbind-event inner))
      ;; Later snapshots observe changed metadata; the first snapshot stays immutable.
      (let* ((later nil)
             (observer (wxlambda:bind-event receiver :close (lambda (e) (setf later e))))
             (mutator (wxlambda:bind-event receiver :close
                        (lambda (e c)
                          (setf saved e (wxlambda:event-timestamp c) 77)
                          (setf (wxlambda:event-skipped-p c) t)) :with-context t)))
        (wxlambda:process-event receiver :close)
        (assert (= 77 (wxlambda:event-timestamp later)))
        (assert (zerop (wxlambda:event-timestamp saved)))
        (wxlambda:unbind-event mutator) (wxlambda:unbind-event observer))
      (wxlambda:destroy-event-handler receiver)))
  (assert (zerop (wxlambda:event-timestamp saved)))
  (assert (not (wxlambda:event-command-p saved)))
  (expect-error (lambda () (wxlambda:event-timestamp expired)) 'wxlambda:native-error)
  (expect-error (lambda () (wxlambda:event-command-p expired)) 'wxlambda:native-error))
(format t "PASS: immutable timestamp/classification snapshots, native long bounds, scoped CanVeto and nested lifetime~%")
