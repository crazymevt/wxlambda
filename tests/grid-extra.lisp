(load (merge-pathnames "../examples/grid-editing.lisp" *load-truename*))
(in-package #:wxlambda)
(defun grid-extra-error (function)
  (assert (handler-case (progn (funcall function) nil) (error () t))))
(with-application ()
  (assert (wxlambda-grid-editing:exercise))
  (let* ((frame (make-frame)) (panel (make-panel frame))
         (grid (make-grid panel :rows 3 :columns 3)) (selected nil) (context nil))
    (setf (grid-cell-text grid 1 1) "Middle λ"
          (grid-cell-read-only-p grid 0 0) :yes
          (grid-cell-background grid 0 0) #x123456
          (grid-cell-foreground grid 0 0) #xabcdef)
    (assert (grid-cell-read-only-p grid 0 0))
    (assert (= #x123456 (grid-cell-background grid 0 0)))
    (assert (= #xabcdef (grid-cell-foreground grid 0 0)))
    (grid-extra-error (lambda () (setf (grid-cell-background grid 0 0) -1)))
    (bind-event grid :grid-select-cell
      (lambda (event current)
        (setf selected event context current)
        (assert (= (event-grid-row event) (event-grid-row current)))
        (assert (= (event-grid-column event) (event-grid-column current)))
        (grid-extra-error (lambda () (setf (grid-cell-text grid 0 0) "unsafe")))
        (when (= 2 (event-grid-row current)) (setf (event-vetoed-p current) t))) :with-context t)
    (setf (grid-cursor grid) '(1 1))
    (assert selected) (assert (equal '(1 1) (grid-cursor grid)))
    (grid-extra-error (lambda () (event-grid-row context)))
    (setf (grid-cursor grid) '(2 2))
    (assert (equal '(1 1) (grid-cursor grid)))
    (insert-grid-rows grid 1)
    (assert (string= "Middle λ" (grid-cell-text grid 2 1)))
    (delete-grid-rows grid 1)
    (assert (string= "Middle λ" (grid-cell-text grid 1 1)))
    (insert-grid-columns grid 1)
    (assert (string= "Middle λ" (grid-cell-text grid 1 2)))
    (delete-grid-columns grid 1)
    (append-grid-rows grid 2) (append-grid-columns grid 2)
    (assert (= 5 (grid-rows grid))) (assert (= 5 (grid-columns grid)))
    (select-grid-block grid 0 0 1 1) (clear-grid-selection grid)
    (grid-extra-error (lambda () (append-grid-rows grid 257)))
    (grid-extra-error (lambda () (delete-grid-columns grid 4 2)))
    (delete-grid-rows grid 0 5)
    (assert (null (grid-cursor grid)))
    (delete-grid-columns grid 0 5)
    (assert (zerop (grid-rows grid))) (assert (zerop (grid-columns grid)))
    (assert (null (grid-cursor grid)))
    (assert (not (grid-can-enable-cell-control-p grid)))
    (grid-extra-error (lambda () (grid-cell-text grid 0 0)))
    (append-grid-rows grid 2) (append-grid-columns grid 2)
    (setf (grid-cell-text grid 0 0) "Restored")
    (assert (string= "Restored" (grid-cell-text grid 0 0)))
    (destroy-window frame)))
(format t "GRID EXTRA PASS~%")
