(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(defun expect-dispatch-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (error (condition) (not (typep condition 'wxlambda:native-error))))))

(defun expect-native-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil)
            (wxlambda:native-error () t))))

(let ((mode (or (uiop:getenv "WXLAMBDA_CONTROL_TEST_MODE") "normal"))
      (toggle-calls 0) (click-calls 0) (saved-events nil)
      (observed-error nil) (handled-error nil) (setter-returned nil))
  (handler-case
      (wxlambda:with-application ()
        (let* ((frame (wxlambda:make-frame :title "Labels and checkboxes"))
               (panel (wxlambda:make-panel frame))
               (label (wxlambda:make-label panel :label "&Name λ 日本語 😀"))
               (box (wxlambda:make-checkbox panel :label "Enabled λ"))
               (initially-checked (wxlambda:make-checkbox panel :label "Initially on" :checked t))
               (button (wxlambda:make-button panel :label "Test")))
          (wxlambda:make-column panel)
          (dolist (child (list label box initially-checked button)) (wxlambda:add-child panel child))
          (assert (not (wxlambda:checked-p box)))
          (assert (wxlambda:checked-p initially-checked))
          (let ((original (wxlambda:label-text label))
                (long-label (apply #'concatenate 'string (make-list 256 :initial-element "λ日本語😀"))))
            (assert (string= "&Name λ 日本語 😀" original))
            (setf (wxlambda:label-text label) "")
            (assert (string= "" (wxlambda:label-text label)))
            (setf (wxlambda:label-text label) long-label)
            (assert (string= long-label (wxlambda:label-text label)))
            (assert (string= "&Name λ 日本語 😀" original))
            (setf (wxlambda:label-text label) "Ready λ")
            (wxlambda:layout-window panel))
          (expect-dispatch-error (lambda () (wxlambda:label-text box)))
          (expect-dispatch-error (lambda () (setf (wxlambda:label-text box) "wrong type")))
          (expect-dispatch-error (lambda () (wxlambda:checked-p label)))
          (expect-dispatch-error (lambda () (setf (wxlambda:checked-p label) t)))
          (if (string= mode "normal")
              (progn
                (wxlambda:on-toggle box
                  (lambda (event)
                    (incf toggle-calls)
                    (push event saved-events)
                    (assert (eq :toggle (wxlambda:event-kind event)))
                    (assert (eq box (wxlambda:event-source event)))
                    (assert (null (wxlambda:event-text event)))
                    ;; Change the live state recursively; both snapshots must survive.
                    (when (wxlambda:event-checked-p event)
                      (setf (wxlambda:checked-p box :notify t) nil)
                      (assert (wxlambda:event-checked-p event)))))
                (assert (setf (wxlambda:checked-p box) :true))
                (assert (zerop toggle-calls))
                (assert (wxlambda:checked-p box))
                (assert (not (setf (wxlambda:checked-p box) nil)))
                (assert (setf (wxlambda:checked-p box :notify t) t))
                (assert (= 2 toggle-calls))
                (assert (not (wxlambda:checked-p box)))
                (assert (equal '(nil t) (mapcar #'wxlambda:event-checked-p saved-events)))
                (wxlambda:on-click button
                  (lambda ()
                    (incf click-calls)
                    (assert (= 2 (hash-table-count wxlambda::*handlers*)))
                    ;; Failed registration must keep the existing click handler rooted.
                    (expect-dispatch-error (lambda () (wxlambda:on-toggle button (lambda (event) (declare (ignore event))))))
                    (expect-dispatch-error (lambda () (wxlambda:off-toggle button)))
                    (assert (= 2 (hash-table-count wxlambda::*handlers*)))
                    (dotimes (i 20)
                      (wxlambda:on-toggle box
                        (lambda (event)
                          (incf toggle-calls)
                          (push event saved-events)
                          (wxlambda:off-toggle box)))
                      (assert (= 2 (hash-table-count wxlambda::*handlers*))))
                    (setf (wxlambda:checked-p box :notify t) t)
                    (assert (= 3 toggle-calls))
                    (assert (= 1 (hash-table-count wxlambda::*handlers*)))
                    (wxlambda:off-toggle box)
                    (setf (wxlambda:checked-p box :notify t) nil)
                    (assert (= 3 toggle-calls))
                    (wxlambda:on-toggle box
                      (lambda (event) (incf toggle-calls) (push event saved-events)))
                    ;; An explicit notification also emits for an unchanged value.
                    (setf (wxlambda:checked-p box :notify t) nil)
                    (assert (= 4 toggle-calls))
                    (wxlambda:off-toggle box)
                    (wxlambda:off-click button)
                    (assert (zerop (hash-table-count wxlambda::*handlers*)))
                    (wxlambda:destroy-window frame)))
                (wxlambda:show-window frame)
                (wxlambda:queue-click button)
                (wxlambda:run)
                (assert (= 1 click-calls))
                (assert (equal '(nil t nil t) (mapcar #'wxlambda:event-checked-p saved-events)))
                (expect-native-error (lambda () (wxlambda:checked-p box)))
                (expect-native-error (lambda () (setf (wxlambda:checked-p box) t)))
                (expect-native-error (lambda () (wxlambda:label-text label)))
                (expect-native-error (lambda () (setf (wxlambda:label-text label) "stale")))
                (expect-native-error (lambda () (wxlambda:off-toggle box)))
                (expect-native-error (lambda () (wxlambda:on-toggle box (lambda (event) (declare (ignore event))))))
                (assert (zerop (hash-table-count wxlambda::*handlers*))))
              (progn
                (wxlambda:on-toggle box
                  (lambda (event)
                    (declare (ignore event))
                    (incf toggle-calls)
                    (error "Expected toggle-handler failure")))
                (flet ((trigger ()
                         (setf (wxlambda:checked-p box :notify t) t)
                         (setf setter-returned t)))
                  (if (string= mode "error-before-run")
                      (trigger)
                      (progn
                        (wxlambda:on-click button
                          (if (string= mode "error-handled-in-loop")
                              (lambda ()
                                (incf click-calls)
                                (if (= click-calls 1)
                                    (let ((original-stop (symbol-function 'wxlambda::%stop))
                                          (stop-requests 0))
                                      ;; Later queued events may drain even after a stop
                                      ;; request; check both continuation and no request.
                                      (unwind-protect
                                           (progn
                                             (setf (symbol-function 'wxlambda::%stop)
                                                   (lambda ()
                                                     (incf stop-requests)
                                                     (funcall original-stop)))
                                             (handler-case (trigger)
                                               (error (condition)
                                                 (assert (search "Expected toggle-handler failure"
                                                                 (princ-to-string condition)))
                                                 (setf handled-error t))))
                                        (setf (symbol-function 'wxlambda::%stop) original-stop))
                                      (assert handled-error)
                                      (assert (zerop stop-requests))
                                      (assert (null wxlambda::*callback-error*))
                                      (wxlambda:queue-click button))
                                    (wxlambda:destroy-window frame)))
                              #'trigger))
                        (wxlambda:show-window frame)
                        (wxlambda:queue-click button)
                        (wxlambda:run)
                        (when (string= mode "error-handled-in-loop")
                          (assert handled-error)
                          (assert (= 2 click-calls))))))))))
    (error (condition)
      (unless (and (member mode '("error-before-run" "error-in-loop") :test #'string=)
                   (search "Expected toggle-handler failure" (princ-to-string condition)))
        (error condition))
      (setf observed-error t)))
  (assert (eq observed-error
              (not (null (member mode '("error-before-run" "error-in-loop") :test #'string=)))))
  (unless (string= mode "normal")
    (assert (= 1 toggle-calls))
    (assert (not setter-returned)))
  (assert (not wxlambda::*active*))
  (assert (not wxlambda::*handlers*))
  (format t "PASS: controls ~A, label copies, toggle snapshots, and cleanup~%" mode))
