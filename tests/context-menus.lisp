(load (merge-pathnames "../examples/context-menus.lisp" *load-truename*))
(wxlambda:with-application ()
  (assert (wxlambda-context-menus:exercise))
  (let* ((frame (wxlambda:make-frame)) (bar (wxlambda:make-menu-bar frame))
         (file (wxlambda:make-menu bar :label "File"))
         (submenu (wxlambda:make-menu file :label "Recent"))
         (item (wxlambda:make-menu-item submenu :id 12001 :label "A"))
         (button (wxlambda:make-button frame :label "Test")) (refused nil) (seen nil))
    (unwind-protect
         (progn
           (wxlambda:bind-event frame :menu (lambda (event) (declare (ignore event)) (setf seen t)) :id 12001)
           (wxlambda:activate-menu-item item) (assert seen)
           (assert (handler-case (progn (wxlambda:make-menu-item file :id 12001 :label "Duplicate") nil) (wxlambda:native-error () t)))
           (assert (handler-case (progn (wxlambda:popup-choice frame nil) nil) (error () t)))
           (assert (handler-case (progn (wxlambda:popup-choice frame '("A") :enabled '(t nil)) nil) (error () t)))
           (wxlambda:on-click button (lambda () (setf refused (handler-case (progn (wxlambda:popup-choice frame '("A")) nil) (wxlambda:native-error () t)))))
           (wxlambda:queue-click button) (wxlambda:process-events) (assert refused)
           (wxlambda:destroy-menu-resource file)
           (assert (not (wxlambda:menu-resource-alive-p submenu)))
           (assert (not (wxlambda:menu-resource-alive-p item))))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(format t "Context menu/submenu checks passed.~%")
