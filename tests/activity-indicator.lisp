(load (merge-pathnames "../examples/activity-indicator.lisp" *load-truename*))
(defun activity-error (function &optional (type 'error))
  (assert (handler-case (progn (funcall function) nil) (error (condition) (typep condition type)))))
(defclass custom-activity (wxlambda:activity-indicator) ((tag :initarg :tag :reader activity-tag))
  (:default-initargs :running-p t :tag :default))
(defmethod initialize-instance :after ((object custom-activity) &key)
  (assert (wxlambda:activity-running-p object)))
(defclass mixed-activity (wxlambda:activity-indicator wxlambda:panel) ())
(defclass failing-activity (custom-activity) ())
(defvar *failed-activity* nil)
(defmethod initialize-instance :after ((object failing-activity) &key)
  (setf *failed-activity* object)
  (wxlambda:bind-event object :idle (lambda (event) (declare (ignore event))))
  (error "Expected activity rollback"))
(wxlambda:with-application ()
  (assert (wxlambda-activity-indicator:exercise))
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (indicator (wxlambda:make-activity-indicator panel))
         (custom (wxlambda:make-activity-indicator panel :class 'custom-activity :tag :factory))
         (button (wxlambda:make-button panel)) (delivered nil))
    (assert (not (wxlambda:activity-running-p indicator)))
    (assert (eq :factory (activity-tag custom)))
    (activity-error (lambda () (make-instance 'mixed-activity :parent panel)))
    (activity-error (lambda () (wxlambda:make-activity-indicator panel :class 'wxlambda:panel)))
    (assert (eq :truthy (setf (wxlambda:activity-running-p indicator) :truthy)))
    (setf (wxlambda:activity-running-p indicator) t)
    (assert (wxlambda:activity-running-p indicator))
    (assert (null (setf (wxlambda:activity-running-p indicator) nil)))
    (setf (wxlambda:activity-running-p indicator) nil)
    (assert (not (wxlambda:activity-running-p indicator)))
    (wxlambda:on-click button
      (lambda ()
        (assert (wxlambda:activity-running-p custom))
        (activity-error (lambda () (setf (wxlambda:activity-running-p indicator) t)) 'wxlambda:native-error)
        (activity-error (lambda () (setf (wxlambda:activity-running-p custom) nil)) 'wxlambda:native-error)
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:activity-running-p indicator) t delivered t)) :owner indicator)))
    (wxlambda:queue-click button)
    (loop repeat 30 until delivered do (wxlambda:process-events))
    (assert delivered) (assert (wxlambda:activity-running-p indicator))
    (let ((roots (hash-table-count wxlambda::*event-bindings*)))
      (activity-error (lambda () (make-instance 'failing-activity :parent panel)))
      (assert (= roots (hash-table-count wxlambda::*event-bindings*))))
    (activity-error (lambda () (wxlambda:activity-running-p *failed-activity*)) 'wxlambda:native-error)
    ;; Delete while running: native owner teardown must release animation resources.
    (wxlambda:destroy-window frame) (wxlambda:process-events)
    (activity-error (lambda () (wxlambda:activity-running-p indicator)) 'wxlambda:native-error)
    (activity-error (lambda () (setf (wxlambda:activity-running-p indicator) nil)) 'wxlambda:native-error)))
(format t "PASS: activity state, idempotence, generalized SETF, CLOS rollback, callback deferral and running-owner teardown~%")
