("api/tooltip-text" :names ("tooltip-text" "(setf tooltip-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or replace window-owned tooltip text. NIL removes the tooltip; empty text retains an attached empty tooltip. Native objects/pointers are never exposed or retained by Lisp. Native text normalization and hover presentation vary by port." :position 587019)
("api/transfer-event" :names ("transfer-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it." :position 588916)
("api/tree-control" :names ("tree-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Managed item tokens and canonical views, native selection/veto and bounded structural navigation." :position 590777)
("api/tree-item" :names ("tree-item") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Created by tree creation/traversal/selection APIs; EQ identity stable while native token is live. Retained views/snapshots can become invalid after subtree/owner deletion. Tokens are not raw native IDs." :position 592076)
("api/tree-item-alive-p" :names ("tree-item-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks registry/owner, stronger than native IsOk non-null test. Active session required; stale views never revive on native address reuse." :position 593697)
