(
("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 0)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 1134)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 2010)
("api/bind-event" :names ("bind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors." :position 2929)
("api/binding-active-p" :names ("binding-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract." :position 5272)
("api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :position 6949)
("api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :position 8082)
("api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :position 8920)
("api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the boolean checkbox state." :position 10059)
("api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :position 11286)
("api/command-event-type" :names ("command-event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a supported command tag for comparison with EVENT-NATIVE-TYPE. Active main-thread session required; invalid KIND signals a Lisp error. This does not add numeric-kind binding, custom type registration or arbitrary native event families." :position 12450)
("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window identities are borrowed and reject this operation; use DESTROY-WINDOW." :position 13624)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :position 15251)
("api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :position 16909)
("api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable." :position 18073)
("api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction." :position 19341)
("api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :position 20235)
("api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :position 21645)
("api/event-checked-p" :names ("event-checked-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read toggle state; NIL also applies to non-toggle events." :position 22341)
("api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context." :position 22947)
("api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :position 24683)
("api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :position 26191)
("api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles." :position 26929)
("api/event-id" :names ("event-id") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the copied ID after callback/source destruction; no native session required. This identifies a command ID, not a globally unique event or source handle." :position 29173)
("api/event-kind" :names ("event-kind") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the event kind." :position 30053)
("api/event-native-type" :names ("event-native-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read native event type after callback/source destruction without a session. Values are runtime metadata, not stable serialized type IDs. Compare to COMMAND-EVENT-TYPE in the same process; EVENT-KIND retains its four portable keyword names." :position 30605)
("api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :position 31732)
("api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :position 32244)
("api/event-selection" :names ("event-selection") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read choice selection; NIL means no selection or a non-selection event." :position 33404)
("api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :position 34053)
("api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. Native origin-object lookup is not exposed; use EVENT-ID to distinguish IDs. Saved receiver wrappers may outlive their native object." :position 35915)
("api/event-text" :names ("event-text") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the copied text payload." :position 36948)
("api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :position 37531)
("api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :position 38671)
("api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :position 40083)
("api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :position 41890)
("api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :position 43557)
("api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :position 44976)
("api/handler-alive-p" :names ("handler-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR." :position 45885)
("api/handler-enabled-p" :names ("handler-enabled-p" "(setf handler-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Does not implement arbitrary pushed handlers or mutable event contexts." :position 47586)
("api/label" :names ("label") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxStaticText; label operations specialize on this class." :position 49408)
("api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic syntax. Other control types are not accepted." :position 50584)
("api/layout-window" :names ("layout-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed." :position 51768)
("api/load-native-library" :names ("load-native-library") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF." :position 52740)
("api/main-loop-running-p" :names ("main-loop-running-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate." :position 53519)
("api/make-button" :names ("make-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support." :position 54634)
("api/make-checkbox" :names ("make-checkbox") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state." :position 56008)
("api/make-choice" :names ("make-choice") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection." :position 57388)
("api/make-column" :names ("make-column") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed." :position 58794)
("api/make-event-handler" :names ("make-event-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory. Rejects WINDOW subclasses and non-handler classes before construction; no parent or native-enabled initarg is provided." :position 59745)
("api/make-frame" :names ("make-frame") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults." :position 61089)
("api/make-gauge" :names ("make-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE." :position 62317)
("api/make-label" :names ("make-label") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained." :position 63464)
("api/make-panel" :names ("make-panel") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel." :position 64829)
("api/make-row" :names ("make-row") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned horizontal box sizer. Standalone nested sizer objects are not exposed." :position 66097)
("api/make-text" :names ("make-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control." :position 67043)
("api/native-error" :names ("native-error") :kind :condition :kind-name "Condition" :package "WXLAMBDA" :summary "Signals native bridge failures instead of exposing C++ exceptions or native pointers." :position 68376)
("api/off-click" :names ("off-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 69137)
("api/off-selection" :names ("off-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 70222)
("api/off-text-change" :names ("off-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 71319)
("api/off-toggle" :names ("off-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 72437)
("api/on-click" :names ("on-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 73529)
("api/on-selection" :names ("on-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 75367)
("api/on-text-change" :names ("on-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 77187)
("api/on-toggle" :names ("on-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 79012)
("api/panel" :names ("panel") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a child wxPanel." :position 80805)
("api/pending-events-p" :names ("pending-events-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks." :position 81870)
("api/process-events" :names ("process-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling." :position 82978)
("api/process-pending-events" :names ("process-pending-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards." :position 83864)
("api/pulse-gauge" :names ("pulse-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode." :position 85379)
("api/queue-click" :names ("queue-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement." :position 86666)
("api/queue-event" :names ("queue-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Queue a copied synthetic wxCommandEvent for later native dispatch. Does not change control properties, check state or choice selection. Explicit UTF-8 byte length preserves empty, Unicode and embedded-NUL text. Non-applicable non-default payload options are rejected. IDs fit signed 32-bit excluding -1. Main-thread only, including standalone handlers; no worker dispatch or native-origin override." :position 87641)
("api/resume-event-propagation" :names ("resume-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Restore the native propagation level without changing Skip. Zero is allowed and keeps propagation stopped. Invalid LEVEL signals TYPE-ERROR; expired contexts reject native access." :position 89622)
("api/return-to-application-repl" :names ("return-to-application-repl") :kind :restart :kind-name "Restart" :package "WXLAMBDA" :summary "Abandon the failing REPL evaluation or callback operation using the active debugger restart." :position 90974)
("api/run" :names ("run") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code." :position 91785)
("api/selection" :names ("selection" "(setf selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read selected index; NIL represents native no selection." :position 92576)
("api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :position 93837)
("api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :position 94985)
("api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :position 96242)
("api/stop-event-propagation" :names ("stop-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION." :position 96889)
("api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls." :position 98210)
("api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :position 99517)
("api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns." :position 100695)
("api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :position 102251)
("api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :position 103577)
("api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :position 104973)
("api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :position 105888)
("api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :position 106760)
("api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :position 107544)
