("api/event-wheel-delta" :names ("event-wheel-delta") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native wheel delta threshold; do not assume one event equals one line." :position 281792)
("api/event-wheel-inverted-p" :names ("event-wheel-inverted-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native natural-scroll metadata; macOS already applies configured direction." :position 283067)
