(
("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 0)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 1134)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 2010)
("api/bind-event" :names ("bind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors." :position 2929)
("api/binding-active-p" :names ("binding-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract." :position 5303)
("api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :position 6994)
("api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :position 8127)
("api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :position 8965)
("api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the boolean checkbox state." :position 10104)
("api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :position 11331)
("api/close-window" :names ("close-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction." :position 12495)
("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window identities are borrowed and reject this operation; use DESTROY-WINDOW." :position 14190)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :position 15817)
("api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :position 17475)
("api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable." :position 18639)
("api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation." :position 19907)
("api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :position 21019)
("api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :position 22443)
("api/event-can-veto-p" :names ("event-can-veto-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots return the copied pre-callback flag without a session. Contexts query wxCloseEvent::CanVeto; non-close contexts return NIL. Forced close requests and synthetic :CAN-VETO-P NIL events cannot be vetoed. This predicate does not grant setter access outside the current scope." :position 23139)
("api/event-checked-p" :names ("event-checked-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read toggle state; NIL also applies to non-toggle events." :position 24526)
("api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state." :position 25132)
("api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :position 27120)
("api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :position 28700)
("api/event-family" :names ("event-family") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Classify the supported snapshot kind. The first four kinds are command events; :CLOSE uses wxCloseEvent and is not a wxCommandEvent. No arbitrary native RTTI or class-object lookup is exposed." :position 29438)
("api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles." :position 30372)
("api/event-id" :names ("event-id") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the copied ID after callback/source destruction; no native session required. This identifies a command ID, not a globally unique event or source handle." :position 32616)
("api/event-kind" :names ("event-kind") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the event kind." :position 33496)
("api/event-native-type" :names ("event-native-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read native event type after callback/source destruction without a session. Values are runtime metadata, not stable serialized type IDs. Compare to COMMAND-EVENT-TYPE in the same process; EVENT-KIND retains its portable supported keyword names." :position 34048)
("api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :position 35185)
("api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :position 35697)
("api/event-selection" :names ("event-selection") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read choice selection; NIL means no selection or a non-selection event." :position 36929)
("api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :position 37578)
("api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. Native origin-object lookup is not exposed; use EVENT-ID to distinguish IDs. Saved receiver wrappers may outlive their native object." :position 39512)
("api/event-text" :names ("event-text") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the copied text payload." :position 40545)
("api/event-type" :names ("event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a supported process-local event type. Four command kinds and the non-command close family are supported; numeric type registration and arbitrary event tags remain unbound." :position 41128)
("api/event-vetoed-p" :names ("event-vetoed-p" "(setf event-vetoed-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshot state is captured before this callback and remains immutable. The scoped SETF writer calls Veto(bool), checking actual close-event class and CanVeto first for both setting and clearing. Non-close contexts reject veto-state operations. A vetoing handler should consume the close event (leave Skip false) so native default closing is not run. Veto does not cancel a separate explicit DESTROY-WINDOW request." :position 42179)
("api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :position 44173)
("api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :position 45313)
("api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :position 46725)
("api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :position 48532)
("api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :position 50199)
("api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :position 51618)
("api/handler-alive-p" :names ("handler-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR." :position 52527)
("api/handler-enabled-p" :names ("handler-enabled-p" "(setf handler-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Does not implement arbitrary pushed handlers or mutable event contexts." :position 54228)
("api/label" :names ("label") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxStaticText; label operations specialize on this class." :position 56050)
("api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic syntax. Other control types are not accepted." :position 57226)
("api/layout-window" :names ("layout-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed." :position 58410)
("api/load-native-library" :names ("load-native-library") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF." :position 59382)
("api/main-loop-running-p" :names ("main-loop-running-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate." :position 60161)
("api/make-button" :names ("make-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support." :position 61276)
("api/make-checkbox" :names ("make-checkbox") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state." :position 62650)
("api/make-choice" :names ("make-choice") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection." :position 64030)
("api/make-column" :names ("make-column") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed." :position 65436)
("api/make-event-handler" :names ("make-event-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory. Rejects WINDOW subclasses and non-handler classes before construction; no parent or native-enabled initarg is provided." :position 66387)
("api/make-frame" :names ("make-frame") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults." :position 67731)
("api/make-gauge" :names ("make-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE." :position 68959)
("api/make-label" :names ("make-label") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained." :position 70106)
("api/make-panel" :names ("make-panel") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel." :position 71471)
("api/make-row" :names ("make-row") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned horizontal box sizer. Standalone nested sizer objects are not exposed." :position 72739)
("api/make-text" :names ("make-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control." :position 73685)
("api/native-error" :names ("native-error") :kind :condition :kind-name "Condition" :package "WXLAMBDA" :summary "Signals native bridge failures instead of exposing C++ exceptions or native pointers." :position 75018)
("api/off-click" :names ("off-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 75779)
("api/off-selection" :names ("off-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 76864)
("api/off-text-change" :names ("off-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 77961)
("api/off-toggle" :names ("off-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 79079)
("api/on-click" :names ("on-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 80171)
("api/on-selection" :names ("on-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 82009)
("api/on-text-change" :names ("on-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 83829)
("api/on-toggle" :names ("on-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 85654)
("api/panel" :names ("panel") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a child wxPanel." :position 87447)
("api/pending-events-p" :names ("pending-events-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks." :position 88512)
("api/process-events" :names ("process-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling." :position 89620)
("api/process-pending-events" :names ("process-pending-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards." :position 90506)
("api/pulse-gauge" :names ("pulse-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode." :position 92021)
("api/queue-click" :names ("queue-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement." :position 93308)
("api/queue-event" :names ("queue-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Queue a copied synthetic event: wxCommandEvent for four command kinds, wxCloseEvent for :CLOSE. Ordinary control properties are not changed directly. A queued close on a frame may run its native default closing action; use CLOSE-WINDOW for a synchronous acceptance result. Explicit UTF-8 lengths preserve text. Close events take no command payload, may be vetoable or non-vetoable, and do not normally propagate to parents." :position 94283)
("api/resume-event-propagation" :names ("resume-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Restore the native propagation level without changing Skip. Zero is allowed and keeps propagation stopped. Invalid LEVEL signals TYPE-ERROR; expired contexts reject native access." :position 96436)
("api/return-to-application-repl" :names ("return-to-application-repl") :kind :restart :kind-name "Restart" :package "WXLAMBDA" :summary "Abandon the failing REPL evaluation or callback operation using the active debugger restart." :position 97860)
("api/run" :names ("run") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code." :position 98671)
("api/selection" :names ("selection" "(setf selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read selected index; NIL represents native no selection." :position 99462)
("api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :position 100723)
("api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :position 101871)
("api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :position 103128)
("api/stop-event-propagation" :names ("stop-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION." :position 103775)
("api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls." :position 105168)
("api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :position 106475)
("api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns." :position 107653)
("api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :position 109223)
("api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :position 110549)
("api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :position 111945)
("api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :position 112860)
("api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :position 113732)
("api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :position 114516)
