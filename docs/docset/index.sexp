("api/tooltip-text" :names ("tooltip-text" "(setf tooltip-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or replace window-owned tooltip text. NIL removes the tooltip; empty text retains an attached empty tooltip. Native objects/pointers are never exposed or retained by Lisp. Native text normalization and hover presentation vary by port." :position 698506)
("api/transfer-event" :names ("transfer-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it." :position 700403)
("api/tree-control" :names ("tree-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Managed item tokens and canonical views, native selection/veto and bounded structural navigation. Supports :MULTIPLE-P T at construction (ABI70)." :position 702376)
("api/tree-icons" :names ("tree-icons" "(setf tree-icons)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "SETF stages/copies a native owned image list. Sources can then be disposed. Replacement rejects removal of indices referenced by any normal/selected/expanded item state. Reader copies must be explicitly destroyed. Allocation reads and writes reject callbacks and workers; no raw image-list ownership." :position 703832)
("api/tree-item" :names ("tree-item") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Created by tree creation/traversal/selection APIs; EQ identity stable while native token is live. Retained views/snapshots can become invalid after subtree/owner deletion. Tokens are not raw native IDs." :position 705365)
