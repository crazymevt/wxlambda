("api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :position 81610)
("api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :position 82758)
