("api/current-application-handler" :names ("current-application-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups." :position 88396)
("api/date-picker" :names ("date-picker") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Required date control with native wxDP_DEFAULT|wxDP_SHOWCENTURY formatting/presentation. No raw adoption or uncreated wrapper." :position 89465)
("api/default-font" :names ("default-font") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the OS default GUI font, or a native TELETYPE-family font at13 points. Native font substitution is platform-dependent; inspect fixed-width result." :position 90963)
("api/defer-ui-action" :names ("defer-ui-action") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Queue strongly rooted work without inline execution. One action per safe native idle iteration after callback/native stacks return. Captured borrowed event contexts expire; capture snapshots/values instead." :position 91880)
("api/define-stc-marker" :names ("define-stc-marker") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native MarkerDefine. Arguments use the checked native domains described in the styled-text guide." :position 93385)
