("example/examples/application-handler.lisp" :names ("examples/application-handler.lisp") :kind :example :kind-name "Example" :summary "Borrow the cached application event-handler view, queue a registered command, verify delivery and release the binding without destroying wxApp." :position 575763)
("example/examples/close-events.lisp" :names ("examples/close-events.lisp" "close-events") :kind :example :kind-name "Example" :summary "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup." :position 577511)
("example/examples/command-event-payloads.lisp" :names ("examples/command-event-payloads.lisp" "command-event-payloads") :kind :example :kind-name "Example" :summary "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin." :position 580612)
("example/examples/event-bindings.lisp" :names ("examples/event-bindings.lisp" "event-bindings") :kind :example :kind-name "Example" :summary "Two independent ID-filtered command observers receive queued notifications on a standalone handler. A window button queues notifications; the exercise removes one observer without affecting the other and verifies cleanup." :position 582981)
("example/examples/event-categories.lisp" :names ("examples/event-categories.lisp" "event-categories") :kind :example :kind-name "Example" :summary "Compare current/saved native category for a synthetic registered command and test USER_INPUT membership; no selective pumping or OS events." :position 585783)
