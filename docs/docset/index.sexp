("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Immediately destroy an owned standalone native handler. A second destruction is an error. Window identities are borrowed and reject this operation; use DESTROY-WINDOW, respecting parent ownership. No generic standalone callback registration exists yet." :position 8430)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs." :position 9832)
