("api/styled-text-control" :names ("styled-text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native Scintilla control with UTF-8 codepage, container lexer and no wrap. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and managed failure/root rollback. No file/document model or language-service abstraction." :position 675042)
("api/system-colours" :names ("system-colours") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query current system defaults independently of application window overrides." :position 676982)
("api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls. ABI36 carries explicit UTF-8 lengths and rejects embedded NUL on writes; multiline native values use LF-separated lines. Read-only controls still allow programmatic edits. Native positions are not Lisp string indices. COMBO-BOX is single-line: NUL/CR/LF writes reject. Clears old native selection then ChangeValue; matching-text selection readback remains native. SEARCH-CONTROL query is copied native single-line text with NUL/CR/LF write rejection; hint is separate SEARCH-HINT." :position 677716)
("api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :position 680717)
