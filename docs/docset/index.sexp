("api/clear-items" :names ("clear-items") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Clear all items/selection silently; allowed in list event callbacks. Temporary native event blocker restores managed pushed-handler stack." :position 50427)
("api/clear-stc-document-style" :names ("clear-stc-document-style") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native ClearDocumentStyle. Arguments use the checked native domains described in the styled-text guide." :position 51353)
