("example/examples/handler-client-data.lisp" :names ("examples/handler-client-data.lisp" "handler-client-data") :kind :example :kind-name "Example" :summary "Attach EQ-preserved Lisp state to a managed handler, read it through callback receiver identity and clear it before cleanup without exposing Lisp/native pointers." :position 615234)
