("api/window-event-handler" :names ("window-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer." :position 760451)
("api/window-focus-within-p" :names ("window-focus-within-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query keyboard focus on WINDOW or any native descendant, including native implementation children. Use after a deferred focus-lost event to detect focus leaving an overlay." :position 762054)
("api/window-font" :names ("window-font" "(setf window-font)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/copy native font metadata. NIL resets to current OS GUI font. Invalid names/sizes reject; fonts unavailable on a system can be substituted by the OS. Writes reject native callbacks and use weak subtree references plus InputOperation lifetime guards. Re-layout the application after changes. Does not style STC text or native menus/title bars. Choice/list selections survive recursive font changes without selection notifications, including wxOSX peer recreation." :position 762919)
("api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :position 764805)
("api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :position 766201)
