("api/clear-stc-styles" :names ("clear-stc-styles") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native StyleClearAll. Arguments use the checked native domains described in the styled-text guide." :position 54622)
("api/clipboard-text" :names ("clipboard-text" "(setf clipboard-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Briefly opens the clipboard, reads wxTextDataObject with Unicode/legacy text support, closes and restores PRIMARY preference. Availability can change; a supported-text transfer failure signals rather than returning NIL. Explicit UTF-8 lengths copy native storage. NUL text rejects." :position 55653)
("api/clipboard-text-available-p" :names ("clipboard-text-available-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Advisory query on the standard clipboard; opens/closes and restores native PRIMARY preference. Does not read clipboard contents. A later read can differ." :position 57708)
("api/clock-time" :names ("clock-time" "(setf clock-time)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Time-of-day components only, independent of date and timestamp. Reject NIL, invalid list shape/ranges, fractions and leap second60. Native getter with no valid supported time signals NATIVE-ERROR; writes require native readback match." :position 58899)
("api/clone-event" :names ("clone-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call native Clone for exact wxCommandEvent/wxNotifyEvent/wxCloseEvent/wxIdleEvent with supported tags, clear native origin, preserve supported values and reject borrowed userdata/client pointers. Source and clone are independently mutable/disposable. Capture effective command GetString before clearing origin, so lazy wxEVT_TEXT payload becomes detached value data." :position 60872)
("api/close-window" :names ("close-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction. A callback can explicitly mutate CanVeto through SETF EVENT-CAN-VETO-P; FORCE is not an immutable capability limit." :position 63568)
("api/combo-box" :names ("combo-box") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Editable single-line fixed unsorted choices with generic TEXT/SETF, SELECTION/SETF, ITEM-COUNT and ITEM-TEXT. Native CmpNoCase duplicate/case-only choices reject." :position 65694)
("api/complete-stc-autocomplete" :names ("complete-stc-autocomplete") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native GetReadOnly, AutoCompComplete. Arguments use the checked native domains described in the styled-text guide." :position 67128)
("api/current-application-handler" :names ("current-application-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups." :position 68218)
("api/date-picker" :names ("date-picker") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Required date control with native wxDP_DEFAULT|wxDP_SHOWCENTURY formatting/presentation. No raw adoption or uncreated wrapper." :position 69287)
("api/defer-ui-action" :names ("defer-ui-action") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Queue strongly rooted work without inline execution. One action per safe native idle iteration after callback/native stacks return. Captured borrowed event contexts expire; capture snapshots/values instead." :position 70785)
("api/define-stc-marker" :names ("define-stc-marker") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native MarkerDefine. Arguments use the checked native domains described in the styled-text guide." :position 72290)
("api/delete-all-stc-markers" :names ("delete-all-stc-markers") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native MarkerDeleteAll. Arguments use the checked native domains described in the styled-text guide." :position 73389)
("api/delete-item" :names ("delete-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete silently. Deleting the selected row clears selection; an earlier deletion shifts selected index down one, preserving the same item. No stable IDs or automatic domain-model updates." :position 74472)
