("api/add-notebook-page" :names ("add-notebook-page") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Setup-time AddPage, outside RUN/pumps/callbacks. Reject duplicate membership, wrong parent/type, containing sizer and incomplete page initialization. Pre-root canonical wrapper before publication; callback errors after adoption do not remove a successful page. Direct attached-page destruction is forbidden; destroy notebook/ancestor instead. First-page selection/callback count and native caption processing are port-specific." :position 3890)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 5703)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 6579)
