(
("api/activate-menu-item" :names ("activate-menu-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Programmatically route the native command through its frame. Separators reject. This is not a claim that graphical OS menu selection or accelerators were exercised. Event metadata and resource state remain distinct; see MENUS guide for checked-command behavior. Native check-item activation toggles the resource before callbacks. A normal item can carry native command integer -1, so EVENT-CHECKED-P may be true even for a normal item; use CHECKED-P on a known check resource for actual state." :position 0)
("api/activate-toolbar-tool" :names ("activate-toolbar-tool") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR ID for a realized action tool." :position 1792)
("api/activity-indicator" :names ("activity-indicator") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Window-owned native busy animation with verified initial state. Appearance/cadence and visibility remain port policy; no task is run by the control." :position 2756)
("api/activity-running-p" :names ("activity-running-p" "(setf activity-running-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or set native animation state. Starts are not cumulative and one NIL write stops. Repeated state requests are idempotent; state is not a promise of visible animation while hidden or while the GUI loop is blocked." :position 4250)
("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 5880)
("api/add-notebook-page" :names ("add-notebook-page") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Setup-time AddPage, outside RUN/pumps/callbacks. Reject duplicate membership, wrong parent/type, containing sizer and incomplete page initialization. Pre-root canonical wrapper before publication; callback errors after adoption do not remove a successful page. Direct attached-page destruction is forbidden; destroy notebook/ancestor instead. First-page selection/callback count and native caption processing are port-specific." :position 7014)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 8958)
("api/add-stc-marker" :names ("add-stc-marker") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native MarkerAdd. Arguments use the checked native domains described in the styled-text guide." :position 9834)
("api/add-stc-selection" :names ("add-stc-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native AddSelection. Arguments use the checked native domains described in the styled-text guide." :position 10915)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 12019)
