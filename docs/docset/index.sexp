("api/tree-selections" :names ("tree-selections" "(setf tree-selections)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Get or silently replace the whole selected set. :MULTIPLE-P T at construction enables native range/toggle selection. Multi trees may have no selection. The singular SELECTION accessor returns the first selected item and its setter replaces the set with one item or NIL." :position 719940)
("api/ui-action" :names ("ui-action") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Separate closure roots live in the session queue, not the immutable ticket. No public token accessor or direct resource constructor." :position 721544)
("api/ui-action-p" :names ("ui-action-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "May be used outside a session; does not query native liveness." :position 722947)
("api/ui-action-pending-p" :names ("ui-action-pending-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks native owner liveness including pending ancestor deletion; observed expiry removes queued work and releases the Lisp root." :position 723536)
("api/ui-timer" :names ("ui-timer") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "The session roots its function separately; native weak ownership does not keep widgets alive." :position 724744)
("api/ui-timer-active-p" :names ("ui-timer-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Owner/ancestor expiry removes registration/root. Periodic activity persists through a function until cancel/expiry; escaping errors cancel the offending timer." :position 726017)
("api/ui-timer-p" :names ("ui-timer-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Pure Lisp structure predicate; works outside an application session." :position 727360)
("api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns. Unbinding destroys the native user-data adapter and releases global association roots, but active dispatch frames and saved snapshots can keep the Lisp value alive." :position 727934)
("api/unlink-event-handler" :names ("unlink-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only." :position 729911)
("api/unsplit-window" :names ("unsplit-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Detach/hide selected pane without deletion/reparenting; remaining pane becomes index0. No synthesized UNSPLIT notification." :position 731291)
("api/wake-up-idle" :names ("wake-up-idle") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Wake the native idle system without pumping or invoking callbacks inline. Actual handling occurs at a later native idle opportunity, not a promised immediate time." :position 732502)
("api/web-view" :names ("web-view") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Private wxPanel container owns browser initially at about:blank. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and rollback are supported. Queued immutable command snapshots: :web-message text is JSON (including quoted strings); :web-script-result text is JSON on success or an error description on failure, EVENT-INTEGER is1/0 and EVENT-EXTRA-LONG is the request ticket; :web-loaded text is native URL and :web-error text is native error description. BIND-EVENT supports scoped contexts/Skip/propagation but payload SETF rejects. Async delivery occurs through normal GUI polling/RUN, never directly from an Objective-C completion. Native loaded/error events can reflect prior/subframe navigation; no exact per-navigation correlation or veto API." :position 733383)
("api/web-view-busy-p" :names ("web-view-busy-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native IsBusy state, not a success/failure or script-completion guarantee." :position 736598)
("api/web-view-can-go-back-p" :names ("web-view-can-go-back-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :position 738214)
("api/web-view-can-go-forward-p" :names ("web-view-can-go-forward-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :position 739898)
("api/web-view-go-back" :names ("web-view-go-back") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :position 741591)
("api/web-view-go-forward" :names ("web-view-go-forward") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :position 743290)
("api/web-view-reload" :names ("web-view-reload") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests default cached native reload; no synchronous completion guarantee." :position 745001)
("api/web-view-stop" :names ("web-view-stop") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests native load cancellation; late navigation/events/script completions may still arrive. Does not cancel queued script tickets." :position 746603)
("api/web-view-title" :names ("web-view-title") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads title at call time; may be empty or change asynchronously." :position 748315)
("api/web-view-url" :names ("web-view-url" "(setf web-view-url)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read current native URL or request asynchronous navigation. Request return does not imply load completion; current URL may lag requested URL." :position 749914)
("api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :position 752384)
("api/window-client-size" :names ("window-client-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query native GetClientSize." :position 754337)
("api/window-colours" :names ("window-colours" "(setf window-colours)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read fresh effective native foreground/background RGB lists as two values. SETF copies explicit colors; NIL resets native inherited/default colors. Recursive writes snapshot the current native subtree, including toolkit children. Does not theme non-window drawing such as STC styles or AUI art." :position 755418)
("api/window-content-scale-factor" :names ("window-content-scale-factor") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native GetContentScaleFactor; do not confuse native logical coordinates, DIP and backing pixels." :position 757164)
("api/window-descendants" :names ("window-descendants") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read registered live descendants, excluding WINDOW itself and unregistered native implementation children. Useful for observing input over a window subtree." :position 758411)
