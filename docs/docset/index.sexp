("api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic/accelerator syntax. Menu item reads preserve the raw label, not stripped display text." :position 167871)
