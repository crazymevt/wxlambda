(
("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 0)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 1134)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 2010)
("api/application-handler" :names ("application-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Borrowed native identity with inherited binding, dispatch, liveness and enabled state. Direct construction and subclass construction are rejected; explicit destruction signals NATIVE-ERROR. Session cleanup owns the native wxApp." :position 2929)
("api/bind-event" :names ("bind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors." :position 4454)
("api/binding-active-p" :names ("binding-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract." :position 7169)
("api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :position 8901)
("api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :position 10034)
("api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :position 10872)
("api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the boolean checkbox state." :position 12011)
("api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :position 13238)
("api/clone-event" :names ("clone-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call native Clone for exact wxCommandEvent/wxNotifyEvent/wxCloseEvent with supported tags, clear native origin, preserve supported values and reject borrowed userdata/client pointers. Source and clone are independently mutable/disposable. Capture effective command GetString before clearing origin, so lazy wxEVT_TEXT payload becomes detached value data." :position 14402)
("api/close-window" :names ("close-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction. A callback can explicitly mutate CanVeto through SETF EVENT-CAN-VETO-P; FORCE is not an immutable capability limit." :position 15922)
("api/current-application-handler" :names ("current-application-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups." :position 17921)
("api/destroy-event" :names ("destroy-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Release this independent native event. Copies already queued/processing remain valid; repeated destruction rejects. Session cleanup releases undisposed owned events, even if the Lisp wrapper was collected." :position 18990)
("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window and application identities are borrowed and reject this operation; use DESTROY-WINDOW for windows. Only session cleanup destroys the application." :position 20068)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :position 21955)
("api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :position 23613)
("api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable." :position 24777)
("api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation. Registered names and family/integer data remain available in saved snapshots after session cleanup. Notify snapshots capture pre-callback veto capability/state independently of later Veto/Allow. Timestamp and native IsCommandEvent are copied before each callback; saved reads need no active session." :position 26045)
("api/event-alive-p" :names ("event-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query the independent owned-event registry. Failed/uninitialized wrappers have no native handle and signal NATIVE-ERROR. This is not context activity or native origin liveness." :position 27757)
("api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :position 28806)
("api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :position 30271)
("api/event-can-veto-p" :names ("event-can-veto-p" "(setf event-can-veto-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots read copied capability without a session. Current close contexts use CanVeto; current notify contexts always support Veto/Allow. Plain command contexts return NIL. Scope validation remains required for native access. Context SETF maps native SetCanVeto directly, including false to true. GetVeto hides a stored veto when CanVeto is false and reveals it again if re-enabled. Forced close starts false but explicit metadata mutation can affect native closing results; OS veto acceptance is not guaranteed." :position 30967)
("api/event-category" :names ("event-category") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read virtual GetEventCategory: current supported command/notify-derived classes report USER_INPUT and close-family events report UI. Values are category flags, not event types/IDs/families; synthetic USER_INPUT is not proof of real user input. Snapshot values are captured before the callback." :position 33756)
("api/event-category-mask" :names ("event-category-mask") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the bridge and return its compiled wxEventCategory constant without initializing a GUI session. Combine with LOGIOR/test with LOGTEST. ALL can include implementation category bits and is not restricted to the public five-bit union." :position 35451)
("api/event-checked-p" :names ("event-checked-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read toggle state; NIL also applies to non-toggle events." :position 36722)
("api/event-command-p" :names ("event-command-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current native IsCommandEvent classification. No mutable classification or event replacement. Saved values remain independent of source lifetime." :position 37328)
("api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state." :position 38632)
("api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :position 40701)
("api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :position 42362)
("api/event-family" :names ("event-family") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current supported native classification :COMMAND/:NOTIFY/:CLOSE, including owned event values and saved snapshots after registry cleanup. It is bounded class metadata, not arbitrary native RTTI." :position 43100)
("api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles." :position 44238)
("api/event-id" :names ("event-id" "(setf event-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read a saved pre-callback ID or current native GetId. Context SETF changes event metadata and later native ID matching, not the source window ID or binding filters. Earlier snapshots stay unchanged. No dispatch restart or callback-order guarantee." :position 46592)
("api/event-integer" :names ("event-integer" "(setf event-integer)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetInt or change the native command payload with SETF. Built-in toggle/selection interpretations can reflect this underlying value. Earlier snapshots remain unchanged." :position 48677)
("api/event-kind" :names ("event-kind") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the event kind. The captured kind reflects the actual supported native tag at callback entry, even if an earlier callback changed it; binding registration identity does not change." :position 50091)
("api/event-logging-off-p" :names ("event-logging-off-p" "(setf event-logging-off-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied or current wxCloseEvent logging-off metadata for :QUERY-END-SESSION/:END-SESSION. Context SETF changes native metadata only, not OS policy. Snapshots retain pre-callback state and have no SETF method." :position 51246)
("api/event-native-type" :names ("event-native-type" "(setf event-native-type)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current GetEventType. Saved values remain data after callback/source/session cleanup. Compare to EVENT-TYPE in the same active session; numeric tags are not stable serialized IDs or native cast authority. Context SETF accepts only registered same-family source/target tags and validates actual native command/notify class before SetEventType. Earlier snapshots and registration identities remain unchanged; later snapshots report the current native tag. No dispatch restart or local delivery-order guarantee." :position 53222)
("api/event-origin-id" :names ("event-origin-id") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy/read GetEventObject identity only when it matches a registered application, owned handler or tracked window. This differs from EVENT-SOURCE (binding receiver) and EVENT-ID (routing metadata). Pointer identity is compared without dereferencing the origin; no native pointer or wrapper reconstruction is exposed." :position 56014)
("api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :position 57825)
("api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :position 58337)
("api/event-selection" :names ("event-selection") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read choice-selection metadata. NIL means native selection -1 or a non-selection event. Explicit raw EVENT-INTEGER mutation can produce other signed values; this snapshot is native metadata rather than validation against a live choice item list." :position 59911)
("api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :position 60974)
("api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. EVENT-ORIGIN-ID separately reports a known native origin bridge identity without wrapping arbitrary wxObjects; EVENT-ID remains event routing metadata. Saved receiver wrappers may outlive their native object." :position 63407)
("api/event-text" :names ("event-text" "(setf event-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or copy native command string payload. Context/owned SETF uses explicit UTF-8 byte lengths, preserving embedded NULs. Saved snapshots stay immutable and retain their prior kind-specific payload interpretation." :position 64590)
("api/event-timestamp" :names ("event-timestamp" "(setf event-timestamp)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current native timestamp, not necessarily Unix time. Negative values including -1 are valid. Synthetic events start at zero. Context SETF changes metadata only, not scheduling. Snapshots stay immutable and preserve pre-callback values." :position 66369)
("api/event-type" :names ("event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a process-local native type ID. Seven built-in kinds plus registered command/notify names are supported. Registry names are session-scoped; saved snapshot native IDs remain plain data after cleanup. Borrowed application handler access is supported; arbitrary native event-class binding and OS session delivery remains unverified." :position 68490)
("api/event-vetoed-p" :names ("event-vetoed-p" "(setf event-vetoed-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots retain pre-callback state. Close contexts use GetVeto / checked Veto(bool); notify contexts use NOT IsAllowed, Veto() for true, and Allow() for NIL. A close initialized non-vetoable rejects writes unless its current CanVeto flag was explicitly enabled through SETF EVENT-CAN-VETO-P. Plain command contexts reject live veto-state access. Snapshots stay immutable. Native GetVeto is CanVeto AND the stored veto bit; disabling capability hides the bit without clearing it." :position 69972)
("api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :position 72652)
("api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :position 73792)
("api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :position 75204)
("api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :position 77011)
("api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :position 78678)
("api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :position 80097)
("api/handler-alive-p" :names ("handler-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR." :position 81006)
("api/handler-enabled-p" :names ("handler-enabled-p" "(setf handler-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Scoped contexts support Skip/propagation and checked close/notify veto; arbitrary pushed handlers remain unbound." :position 82817)
("api/label" :names ("label") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxStaticText; label operations specialize on this class." :position 84973)
("api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic syntax. Other control types are not accepted." :position 86149)
("api/layout-window" :names ("layout-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed." :position 87333)
("api/load-native-library" :names ("load-native-library") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF." :position 88305)
("api/main-loop-running-p" :names ("main-loop-running-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate." :position 89084)
("api/make-button" :names ("make-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support." :position 90199)
("api/make-checkbox" :names ("make-checkbox") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state." :position 91573)
("api/make-choice" :names ("make-choice") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection." :position 92953)
("api/make-column" :names ("make-column") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed." :position 94359)
("api/make-event" :names ("make-event") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin class-validating CLOS factory with forwarded subclass initargs. Initial ID -1 remains reserved. Clone construction detaches origin and preserves native source state; factories reject explicit payload overrides while inherited defaults do not replace cloned values." :position 95310)
("api/make-event-handler" :names ("make-event-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory. Rejects WINDOW subclasses and non-handler classes before construction; no parent or native-enabled initarg is provided." :position 96770)
("api/make-frame" :names ("make-frame") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults." :position 98224)
("api/make-gauge" :names ("make-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE." :position 99452)
("api/make-label" :names ("make-label") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained." :position 100599)
("api/make-panel" :names ("make-panel") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel." :position 101964)
("api/make-row" :names ("make-row") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned horizontal box sizer. Standalone nested sizer objects are not exposed." :position 103232)
("api/make-text" :names ("make-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control." :position 104178)
("api/native-error" :names ("native-error") :kind :condition :kind-name "Condition" :package "WXLAMBDA" :summary "Signals native bridge failures instead of exposing C++ exceptions or native pointers." :position 105511)
("api/off-click" :names ("off-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 106272)
("api/off-selection" :names ("off-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 107357)
("api/off-text-change" :names ("off-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 108454)
("api/off-toggle" :names ("off-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :position 109572)
("api/on-click" :names ("on-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 110664)
("api/on-selection" :names ("on-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 112502)
("api/on-text-change" :names ("on-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 114322)
("api/on-toggle" :names ("on-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :position 116147)
("api/owned-event" :names ("owned-event") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native-backed CLOS construction supports subclasses, slot initargs, defaults and AFTER hooks. Native origin is NIL. Mixed ancestry with EVENT-HANDLER/window is invalid. Explicit destruction or session cleanup owns deletion; there is no GC finalizer." :position 117940)
("api/panel" :names ("panel") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a child wxPanel." :position 119708)
("api/pending-events-p" :names ("pending-events-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks." :position 120773)
("api/process-event" :names ("process-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously dispatch a fresh owned synthetic event through ProcessEvent, copy final veto state and then delete the event. Observer callbacks may run while handled-p is NIL because they Skip; native consumption/default handling determines the first result. Final veto is independent of handled-p and may be true from initial VETOED-P even without a matching handler. Close dispatch can run frame defaults. Callback errors re-signal at the nearer Lisp boundary; handled nested errors do not stop RUN. No final values are returned when a condition escapes, and earlier callback mutations are not rolled back. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin." :position 121881)
("api/process-events" :names ("process-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling." :position 125604)
("api/process-pending-events" :names ("process-pending-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards." :position 126490)
("api/pulse-gauge" :names ("pulse-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode." :position 128005)
("api/queue-click" :names ("queue-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement." :position 129292)
("api/queue-event" :names ("queue-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Queue a copied synthetic event: wxCommandEvent for four command kinds, wxCloseEvent for :CLOSE. Ordinary control properties are not changed directly. A queued close on a frame may run its native default closing action; use CLOSE-WINDOW for a synchronous acceptance result. Explicit UTF-8 lengths preserve text. Close events take no command payload, may be vetoable or non-vetoable, and do not normally propagate to parents. Registry types create wxCommandEvent or wxNotifyEvent according to their declared family. Initial veto applies only to custom notify types. Queuing offers no final veto/handled result; use PROCESS-EVENT when a synchronous decision is required. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin." :position 130267)
("api/register-event-type" :names ("register-event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Allocate a process-local native event type and map NAME in the active session. Duplicate names, built-ins and unsupported families are rejected before registration. Names cannot be unregistered or replaced during this session. Registrations are session-wide metadata, not rolled back when an unrelated resource initializer fails. Native type IDs are not stable across processes." :position 134413)
("api/resume-event-propagation" :names ("resume-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Restore the native propagation level without changing Skip. Zero is allowed and keeps propagation stopped. Invalid LEVEL signals TYPE-ERROR; expired contexts reject native access." :position 136155)
("api/return-to-application-repl" :names ("return-to-application-repl") :kind :restart :kind-name "Restart" :package "WXLAMBDA" :summary "Abandon the failing REPL evaluation or callback operation using the active debugger restart." :position 137919)
("api/run" :names ("run") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code." :position 138730)
("api/selection" :names ("selection" "(setf selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read selected index; NIL represents native no selection." :position 139521)
("api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :position 140782)
("api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :position 141930)
("api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :position 143187)
("api/stop-event-propagation" :names ("stop-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION." :position 143834)
("api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls." :position 145567)
("api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :position 146874)
("api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns." :position 148052)
("api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :position 149663)
("api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :position 150989)
("api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :position 152385)
("api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :position 153300)
("api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :position 154172)
("api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :position 154956)
