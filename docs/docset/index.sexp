("api/tree-item-icon" :names ("tree-item-icon" "(setf tree-item-icon)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "SETF sets both normal and selected icons; expanded-state artwork is outside this adapter. Reads are callback-safe; writes defer. Item/parent lifetime and tree operation guards apply." :position 715585)
