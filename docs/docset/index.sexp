("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 0)
