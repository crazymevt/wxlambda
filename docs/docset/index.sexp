("api/tree-root" :names ("tree-root") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read root identity without raw adoption." :position 599332)
("api/ui-action" :names ("ui-action") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Separate closure roots live in the session queue, not the immutable ticket. No public token accessor or direct resource constructor." :position 600222)
("api/ui-action-p" :names ("ui-action-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "May be used outside a session; does not query native liveness." :position 601625)
("api/ui-action-pending-p" :names ("ui-action-pending-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks native owner liveness including pending ancestor deletion; observed expiry removes queued work and releases the Lisp root." :position 602214)
("api/ui-timer" :names ("ui-timer") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "The session roots its function separately; native weak ownership does not keep widgets alive." :position 603422)
("api/ui-timer-active-p" :names ("ui-timer-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Owner/ancestor expiry removes registration/root. Periodic activity persists through a function until cancel/expiry; escaping errors cancel the offending timer." :position 604695)
("api/ui-timer-p" :names ("ui-timer-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Pure Lisp structure predicate; works outside an application session." :position 606038)
("api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns. Unbinding destroys the native user-data adapter and releases global association roots, but active dispatch frames and saved snapshots can keep the Lisp value alive." :position 606612)
("api/unlink-event-handler" :names ("unlink-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only." :position 608589)
("api/unsplit-window" :names ("unsplit-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Detach/hide selected pane without deletion/reparenting; remaining pane becomes index0. No synthesized UNSPLIT notification." :position 609969)
("api/wake-up-idle" :names ("wake-up-idle") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Wake the native idle system without pumping or invoking callbacks inline. Actual handling occurs at a later native idle opportunity, not a promised immediate time." :position 611180)
("api/web-view" :names ("web-view") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Private wxPanel container owns browser initially at about:blank. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and rollback are supported. Queued immutable command snapshots: :web-message text is JSON (including quoted strings); :web-script-result text is JSON on success or an error description on failure, EVENT-INTEGER is1/0 and EVENT-EXTRA-LONG is the request ticket; :web-loaded text is native URL and :web-error text is native error description. BIND-EVENT supports scoped contexts/Skip/propagation but payload SETF rejects. Async delivery occurs through normal GUI polling/RUN, never directly from an Objective-C completion. Native loaded/error events can reflect prior/subframe navigation; no exact per-navigation correlation or veto API." :position 612061)
("api/web-view-busy-p" :names ("web-view-busy-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native IsBusy state, not a success/failure or script-completion guarantee." :position 615164)
("api/web-view-can-go-back-p" :names ("web-view-can-go-back-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :position 616668)
("api/web-view-can-go-forward-p" :names ("web-view-can-go-forward-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :position 618240)
("api/web-view-go-back" :names ("web-view-go-back") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :position 619821)
("api/web-view-go-forward" :names ("web-view-go-forward") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :position 621408)
("api/web-view-reload" :names ("web-view-reload") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests default cached native reload; no synchronous completion guarantee." :position 623007)
("api/web-view-stop" :names ("web-view-stop") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests native load cancellation; late navigation/events/script completions may still arrive. Does not cancel queued script tickets." :position 624497)
("api/web-view-title" :names ("web-view-title") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads title at call time; may be empty or change asynchronously." :position 626097)
("api/web-view-url" :names ("web-view-url" "(setf web-view-url)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read current native URL or request asynchronous navigation. Request return does not imply load completion; current URL may lag requested URL." :position 627584)
("api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :position 629942)
("api/window-event-handler" :names ("window-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer." :position 631783)
("api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :position 633386)
("api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :position 634782)
("api/window-process-idle-p" :names ("window-process-idle-p" "(setf window-process-idle-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write only the window own idle opt-in extra-style bit while preserving unrelated bits. It is not effective delivery eligibility, ancestor visibility, global mode or a command to run idle callbacks." :position 635697)
("api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :position 637181)
("api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :position 638053)
