("api/styled-text-control" :names ("styled-text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native Scintilla control with UTF-8 codepage, container lexer and no wrap. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and managed failure/root rollback. No file/document model or language-service abstraction." :position 565471)
("api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls. ABI36 carries explicit UTF-8 lengths and rejects embedded NUL on writes; multiline native values use LF-separated lines. Read-only controls still allow programmatic edits. Native positions are not Lisp string indices. COMBO-BOX is single-line: NUL/CR/LF writes reject. Clears old native selection then ChangeValue; matching-text selection readback remains native. SEARCH-CONTROL query is copied native single-line text with NUL/CR/LF write rejection; hint is separate SEARCH-HINT." :position 567397)
("api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :position 570398)
("api/text-editable-p" :names ("text-editable-p" "(setf text-editable-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read whether native user editing is enabled. Programmatic text writes remain allowed." :position 571719)
("api/text-entry-dialog" :names ("text-entry-dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Construct a modal-only native text-entry dialog. Dialog value is native stored value, not a promise of live edit-buffer contents. Strings are Unicode without NUL; empty strings are accepted. Defaults/subclass slot initargs and AFTER hooks use the native-backed CLOS protocol. Failed managed initialization destroys newly created resources; it does not reverse arbitrary external mutations." :position 572835)
("api/text-insertion-point" :names ("text-insertion-point" "(setf text-insertion-point)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the native insertion offset." :position 575477)
