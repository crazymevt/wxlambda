("api/event-stc-margin" :names ("event-stc-margin") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native margin index for margin click/right-click." :position 200630)
("api/event-stc-modification-type" :names ("event-stc-modification-type") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED native modification bit mask." :position 202209)
("api/event-stc-modifiers" :names ("event-stc-modifiers") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native modifier bit mask for margin click/right-click." :position 203799)
("api/event-stc-position" :names ("event-stc-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED/STYLENEEDED/margin/dwell/autocomplete/call-tip/NEEDSHOWN native position; sentinel values may occur." :position 205397)
("api/event-stc-update-mask" :names ("event-stc-update-mask") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "UPDATEUI native update bit mask." :position 207102)
("api/event-stc-x" :names ("event-stc-x") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native client pixel X for dwell start/end." :position 208662)
("api/event-stc-y" :names ("event-stc-y") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native client pixel Y for dwell start/end." :position 210212)
("api/event-text" :names ("event-text" "(setf event-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or copy native command string payload. Context/owned SETF uses explicit UTF-8 byte lengths, preserving embedded NULs. Saved snapshots stay immutable and retain their prior kind-specific payload interpretation. ABI38 listbox selection/double-click command events carry cached string/index payloads; snapshots are independent of later item edits. Native list callback guards protect receiver/ancestors and defer modal/clipboard entry while allowing item edits." :position 211762)
("api/event-time" :names ("event-time") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current native wxDateEvent time components independently of current control value; ignore date/milliseconds. Non-time or expired/outer contexts reject. Snapshot survives callback/session. No setter, owned/synthetic events or detached clones." :position 215896)
("api/event-timestamp" :names ("event-timestamp" "(setf event-timestamp)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current native timestamp, not necessarily Unix time. Negative values including -1 are valid. Synthetic events start at zero. Context SETF changes metadata only, not scheduling. Snapshots stay immutable and preserve pre-callback values." :position 217204)
("api/event-tree-item" :names ("event-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshot retains view identity, not live validity or frozen label. Non-tree snapshots return NIL; non-tree contexts reject. No owned-event method/setter; associated item can be invalidated later. Copy text while live if needed." :position 219426)
("api/event-type" :names ("event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a process-local native type ID. Twenty-two built-in kinds plus registered command/notify names are supported. Registry names are session-scoped; saved snapshot native IDs remain plain data after cleanup. Borrowed application handler access is supported; arbitrary native event-class binding and OS session delivery remains unverified." :position 220728)
("api/event-unicode-key" :names ("event-unicode-key") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Integer Unicode key value or NIL for WXK_NONE; not IME composition text." :position 222863)
("api/event-user-data" :names ("event-user-data") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the snapshot-captured or callback-frame-retained binding association. No deep copy: mutable referent contents remain ordinary Lisp state. Snapshot reads survive unbind/receiver/session cleanup. Current frames retain values across self/peer unbind and nested dispatch restores outer context identity." :position 224144)
("api/event-vetoed-p" :names ("event-vetoed-p" "(setf event-vetoed-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots retain pre-callback state. Close contexts use GetVeto / checked Veto(bool); notify contexts use NOT IsAllowed, Veto() for true, and Allow() for NIL. A close initialized non-vetoable rejects writes unless its current CanVeto flag was explicitly enabled through SETF EVENT-CAN-VETO-P. Plain command contexts reject live veto-state access. Snapshots stay immutable. Native GetVeto is CanVeto AND the stored veto bit; disabling capability hides the bit without clearing it." :position 225765)
("api/event-wheel-axis" :names ("event-wheel-axis") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary ":vertical or :horizontal." :position 228451)
("api/event-wheel-columns" :names ("event-wheel-columns") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native columns per horizontal wheel action." :position 229588)
("api/event-wheel-delta" :names ("event-wheel-delta") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native wheel delta threshold; do not assume one event equals one line." :position 230788)
("api/event-wheel-inverted-p" :names ("event-wheel-inverted-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native natural-scroll metadata; macOS already applies configured direction." :position 232063)
("api/event-wheel-lines" :names ("event-wheel-lines") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native lines per wheel action." :position 233368)
("api/event-wheel-page-scroll-p" :names ("event-wheel-page-scroll-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native page-scroll boolean." :position 234523)
("api/event-wheel-rotation" :names ("event-wheel-rotation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Signed native wheel rotation, potentially finer than delta." :position 235693)
("api/file-dialog" :names ("file-dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Construct a generic single-file selection dialog. Directory/path accept strings or pathnames converted through native namestring; supplied directory must exist, empty directory lets native code use cwd. Path must be nonempty; filename is a string. Filters require nonempty description/pattern pairs and valid zero-based filter index. No change-directory flag, multiselect or external controls. Dialog browser actions such as New Directory can change the filesystem; selection does not perform file-content IO. True MUST-EXIST is rejected for :SAVE, and true OVERWRITE-PROMPT for :OPEN. Supplied path directories must exist." :position 236944)
("api/file-dialog-filter-index" :names ("file-dialog-filter-index" "(setf file-dialog-filter-index)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write one of the construction-time wildcard description/pattern pairs. Invalid index rejects. Filters do not prove current path acceptance." :position 239791)
("api/file-dialog-mode" :names ("file-dialog-mode") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read fixed single-file selection mode. Configured native UI validation differs from raw END-MODAL result assignment. Reader reflects the actual restored generic file flags, including the macOS overlap repair, rather than merely echoing a Lisp requested-mode slot." :position 241214)
("api/file-dialog-path" :names ("file-dialog-path" "(setf file-dialog-path)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write current single-file path. This is not acceptance, file existence, overwrite confirmation or successful content IO. A raw END-MODAL :OK bypasses button validation/transfer, must-exist and overwrite enforcement. Native property changes can open internal prompts and use the guarded prompt workflow." :position 242487)
("api/fill-stc-indicator-range" :names ("fill-stc-indicator-range") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native GetLength, IndicatorFillRange. Arguments use the checked native domains described in the styled-text guide." :position 244300)
("api/fit-scroll-content" :names ("fit-scroll-content") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Layout/FitInside/Layout refreshes virtual extent from max(client,sizer minimum), without resizing frame. Requires own sizer and supported content extent; no callback mutation." :position 245452)
("api/flush-clipboard" :names ("flush-clipboard") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Best-effort persistence after exit, on the standard clipboard. Does not set clipboard contents. A false native Flush result is normal; open/session failures signal NATIVE-ERROR." :position 246632)
("api/focus-window" :names ("focus-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request native SetFocus, or SetFocusFromKbd for a keyboard-origin request. Containers can delegate focus to children; keyboard focus can select text according to the native control." :position 247879)
("api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :position 249122)
("api/frame-accelerators" :names ("frame-accelerators" "(setf frame-accelerators)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/replace a copied native frame accelerator table for shared :MENU action IDs. Native menu enable/check and origin/metadata behavior vary by port; use a Lisp action model." :position 250459)
("api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :position 252507)
("api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :position 253919)
("api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :position 255726)
("api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :position 257393)
("api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :position 258812)
("api/grid" :names ("grid") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Fixed-shape native-owned default string table with native keyboard/mouse editing. CLOS subclasses/defaults/native-ready AFTER hooks and managed failure/root rollback. Requires wxUSE_GRID/core." :position 259721)
