("api/replace-stc-range" :names ("replace-stc-range") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace a native byte range; read-only rejects. Native modifications notify under existing guards; no general rollback after native callback errors." :position 427344)
("api/replace-text" :names ("replace-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace half-open native [FROM,TO) with VALUE using native Replace and text-change notification. Equal endpoints insert, empty VALUE removes. Mutation may precede a callback condition rethrow; handled conditions permit recovery. Exact no-op event counts, caret/selection and undo effects are port-specific." :position 428943)
("api/resplit-window" :names ("resplit-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach second pane using current orientation/requested sash geometry. Native geometry can clamp." :position 430396)
