("api/delete-pending-events" :names ("delete-pending-events") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete queued native events without invoking callbacks; bindings and other handler queues remain intact. Synchronize wxApp pending-handler membership after deletion. Transferred input wrappers remain consumed; later queueing/posting still works." :position 77615)
("api/delete-stc-marker" :names ("delete-stc-marker") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native MarkerDelete. Arguments use the checked native domains described in the styled-text guide." :position 79112)
("api/delete-tree-item" :names ("delete-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invalidate/delete whole subtree. Preserve an outside selection, otherwise choose surviving parent/root silently; deleting root leaves empty. Revision-prune invalid cached views." :position 80198)
("api/destroy-event" :names ("destroy-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Release this independent native event. Copies already queued/processing remain valid; repeated destruction rejects. Session cleanup releases undisposed owned events, even if the Lisp wrapper was collected." :position 81399)
("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window and application identities are borrowed and reject this operation; use DESTROY-WINDOW for windows. Only session cleanup destroys the application. Destroying a linked standalone handler during a callback now rejects; outside callbacks native destruction splices reciprocal neighbors. Unlinked callback destruction retains existing deferral. Attached handlers are removed from their managed window before outside-callback deletion; linked/attached callback destruction rejects." :position 82591)
("api/destroy-menu-resource" :names ("destroy-menu-resource") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete a resource through its native owner, invalidating descendants and wrapper handles. Menu/bar deletion removes it from its parent; frame lifetime also cleans remaining descendants. Structural callback/pump/RUN deletion rejects." :position 85238)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :position 86693)
("api/dialog" :names ("dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Shared bounded modal protocol and ordinary managed window lifetime." :position 88649)
("api/dialog-message" :names ("dialog-message") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read immutable message body. Title is separately mutable through DIALOG-TITLE; no message-body writer in this slice." :position 90130)
("api/dialog-modal-p" :names ("dialog-modal-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native modal state. False after END-MODAL is not permission to destroy the dialog/ancestor before SHOW-MODAL returns." :position 91134)
("api/dialog-selection" :names ("dialog-selection" "(setf dialog-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write the single-choice selection index; NIL and out-of-range values reject. No item-list replacement API is added." :position 92093)
("api/dialog-selection-text" :names ("dialog-selection-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the last accepted native selection-string cache, not a string derived from the current selected index. SetSelection changes the index but GetStringSelection can remain empty until an actual OK-button transfer; a previous accepted cache can remain after index changes or raw END-MODAL. No cache synchronization is promised." :position 93310)
("api/dialog-title" :names ("dialog-title" "(setf dialog-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write native dialog title; scalar callback updates are allowed." :position 94726)
("api/dialog-value" :names ("dialog-value" "(setf dialog-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write native text-entry dialog value. Native GetValue is stored dialog data and need not expose live edit-buffer changes. SETF crosses the notifying callback boundary; callback conditions follow the existing Lisp condition protocol." :position 95785)
("api/drawing-canvas" :names ("drawing-canvas") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Retained drawing window for copied geometry, RGB colours, single-line text/font sizes and RGB bitmap values. Native paint/resize handlers render without calling Lisp; Lisp ancestry is WINDOW rather than PANEL." :position 97249)
("api/drop-stc-selection" :names ("drop-stc-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native GetSelections, DropSelectionN. Arguments use the checked native domains described in the styled-text guide." :position 98866)
("api/empty-stc-undo-buffer" :names ("empty-stc-undo-buffer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native EmptyUndoBuffer. Arguments use the checked native domains described in the styled-text guide." :position 99966)
("api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :position 101016)
("api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable. Menu item access reads its native item flag, without an ancestor-window interpretation; separators reject." :position 102180)
("api/end-modal" :names ("end-modal") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call raw native EndModal with the selected result. This is not an OK-button click: it does not invoke button validation or native data transfer. Native IsModal can become false before SHOW-MODAL returns; the active modal lifetime guard remains until that call unwinds. Generic internal prompt cancellation unwinds internal-to-outer sequentially. Raw :OK does not enforce file must-exist/overwrite checks; actual native OK-button behavior handles configured validation. While an internal prompt is active, successful completion of the public outer dialog (:OK/:YES/:NO) rejects; only :CANCEL requests sequential unwind of the entire workflow." :position 103840)
("api/end-stc-undo-action" :names ("end-stc-undo-action") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native EndUndoAction. Arguments use the checked native domains described in the styled-text guide." :position 105983)
("api/ensure-stc-caret-visible" :names ("ensure-stc-caret-visible") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native EnsureCaretVisible. Arguments use the checked native domains described in the styled-text guide." :position 107023)
("api/ensure-stc-line-visible" :names ("ensure-stc-line-visible") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native EnsureVisible. Arguments use the checked native domains described in the styled-text guide." :position 108088)
("api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation. Registered names and family/integer data remain available in saved snapshots after session cleanup. Notify snapshots capture pre-callback veto capability/state independently of later Veto/Allow. Timestamp and native IsCommandEvent are copied before each callback; saved reads need no active session. Snapshot EVENT-USER-DATA captures the per-binding EQ Lisp reference before callback, independently of later unbinding. Mutable referent contents are not copied/frozen." :position 109164)
("api/event-alive-p" :names ("event-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query the independent owned-event registry. Failed/uninitialized wrappers have no native handle and signal NATIVE-ERROR. This is not context activity or native origin liveness. TRANSFER-EVENT consumes the source registry handle; queued copies from POST-EVENT/QUEUE-EVENT do not." :position 111212)
("api/event-aui-page-id" :names ("event-aui-page-id") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Captured numeric bridge target-page identity; CLOSED uses target captured during full native close span, never a shifted current index lookup. No wrapper adoption/resurrection." :position 112480)
("api/event-auto-repeat-p" :names ("event-auto-repeat-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native repeat boolean; availability varies by port." :position 114888)
("api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :position 116112)
("api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :position 117613)
("api/event-can-veto-p" :names ("event-can-veto-p" "(setf event-can-veto-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots read copied capability without a session. Current close contexts use CanVeto; current notify contexts always support Veto/Allow. Plain command contexts return NIL. Scope validation remains required for native access. Context SETF maps native SetCanVeto directly, including false to true. GetVeto hides a stored veto when CanVeto is false and reveals it again if re-enabled. Forced close starts false but explicit metadata mutation can affect native closing results; OS veto acceptance is not guaranteed." :position 118309)
("api/event-category" :names ("event-category") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read virtual GetEventCategory: current supported command/notify-derived classes report USER_INPUT and close/idle-family events report UI. Values are category flags, not event types/IDs/families; synthetic USER_INPUT is not proof of real user input. Snapshot values are captured before the callback." :position 121104)
("api/event-category-mask" :names ("event-category-mask") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the bridge and return its compiled wxEventCategory constant without initializing a GUI session. Combine with LOGIOR/test with LOGTEST. ALL can include implementation category bits and is not restricted to the public five-bit union." :position 122809)
("api/event-checked-p" :names ("event-checked-p" "(setf event-checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the kind-limited checked interpretation of native command integer. Live SETF writes SetInt(0/1) only for :TOGGLE/:MENU without calling a control setter. Raw EVENT-INTEGER can supply other nonzero checked values; earlier snapshots stay unchanged. Later native/user handlers can react to changed metadata; the entire dispatch is not guaranteed to leave controls unchanged. Native normal-menu commands may carry integer -1 and thus read checked true; this raw view does not classify a check item. :TOGGLE-BUTTON-CHANGE exposes read-only semantic checked metadata; raw integer edits remain observational, not control state changes." :position 124080)
("api/event-cmd-down-p" :names ("event-cmd-down-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy wxKeyboardState::CmdDown from native key/mouse input. Distinguishes native Command semantics and physical Control on macOS." :position 126672)
("api/event-command-p" :names ("event-command-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current native IsCommandEvent classification. No mutable classification or event replacement. Saved values remain independent of source lifetime." :position 127578)
("api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state." :position 128887)
("api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :position 130956)
("api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :position 132617)
("api/event-date" :names ("event-date") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured or current native wxDateEvent date payload, independent of current picker value. Non-date contexts reject; snapshots survive callback/session. No writer, synthetic/owned events or detached clones." :position 133355)
("api/event-dragging-p" :names ("event-dragging-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native dragging boolean, not a mouse-capture guarantee." :position 134597)
("api/event-extra-long" :names ("event-extra-long" "(setf event-extra-long)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetExtraLong or set native command/notify extra metadata. It is separate from signed32 EVENT-INTEGER and item indices. Raw EVENT-SELECTION-P reflects whether this field is nonzero. Snapshots preserve pre-callback values." :position 135824)
("api/event-family" :names ("event-family") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current supported native classification :COMMAND/:NOTIFY/:CLOSE/:IDLE, including owned event values and saved snapshots after registry cleanup. It is bounded class metadata, not arbitrary native RTTI." :position 138350)
("api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles. Standalone wrappers are now strongly canonicalized by session identity for EQ chain peer lookup; no new native ownership or finalizer is introduced. Managed window push leaves native ownership/session rooting unchanged; window destruction detaches handlers rather than deleting them." :position 139522)
("api/event-handler-client-data" :names ("event-handler-client-data" "(setf event-handler-client-data)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Store a session-root token in a bridge wxClientData adapter; the Lisp table retains the actual object. No Lisp pointer, serialization or native ownership of the Lisp object. Replacement/clear releases old association through cleanup; an ordinary returned Lisp reference remains valid. No constructor initarg: native-backed subclass AFTER hooks may SETF." :position 142610)
("api/event-id" :names ("event-id" "(setf event-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read a saved pre-callback ID or current native GetId. Context SETF changes event metadata and later native ID matching, not the source window ID or binding filters. Earlier snapshots stay unchanged. No dispatch restart or callback-order guarantee." :position 144927)
("api/event-integer" :names ("event-integer" "(setf event-integer)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetInt or change the native command payload with SETF. Built-in toggle/selection interpretations can reflect this underlying value. Earlier snapshots remain unchanged. Raw values can affect semantic checked/selection views; negative indices other than -1 remain visible through EVENT-SELECTION after raw writes. It does not alter EXTRA-LONG or raw IsSelection." :position 147113)
("api/event-key-code" :names ("event-key-code") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native wx key code; special codes are not Unicode characters." :position 149740)
("api/event-kind" :names ("event-kind") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the event kind. The captured kind reflects the actual supported native tag at callback entry, even if an earlier callback changed it; binding registration identity does not change." :position 150979)
("api/event-logging-off-p" :names ("event-logging-off-p" "(setf event-logging-off-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied or current wxCloseEvent logging-off metadata for :QUERY-END-SESSION/:END-SESSION. Context SETF changes native metadata only, not OS policy. Snapshots retain pre-callback state and have no SETF method." :position 152148)
("api/event-modifiers" :names ("event-modifiers") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native wx modifier bits ALT1 CONTROL2 SHIFT4 META8, RAW_CONTROL16 on macOS (aliases CONTROL elsewhere); CONTROL means Command on macOS." :position 154124)
("api/event-more-requested-p" :names ("event-more-requested-p" "(setf event-more-requested-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read idle request-more metadata or call wxIdleEvent::RequestMore with SETF. Earlier snapshots stay unchanged. Bounded idle work may request another native idle pass; this is not a busy-loop, timer or immediate-delivery guarantee." :position 155588)
("api/event-mouse-button" :names ("event-mouse-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Triggering :left/:middle/:right/:aux1/:aux2 or NIL." :position 157223)
("api/event-mouse-buttons" :names ("event-mouse-buttons") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Fresh list of currently held button keywords." :position 158444)
("api/event-mouse-click-count" :names ("event-mouse-click-count") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native click count, potentially -1 where unsupported." :position 159650)
("api/event-native-type" :names ("event-native-type" "(setf event-native-type)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current GetEventType. Saved values remain data after callback/source/session cleanup. Compare to EVENT-TYPE in the same active session; numeric tags are not stable serialized IDs or native cast authority. Context SETF accepts only registered same-family source/target tags and validates actual native command/notify class before SetEventType. Earlier snapshots and registration identities remain unchanged; later snapshots report the current native tag. No dispatch restart or local delivery-order guarantee." :position 160892)
("api/event-next-key-event-allowed-p" :names ("event-next-key-event-allowed-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copied/current CHAR_HOOK allow-next flag; old snapshots remain unchanged." :position 163684)
("api/event-numeric-value" :names ("event-numeric-value") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Numeric EVENT snapshot or current EVENT-CONTEXT." :position 165007)
("api/event-old-selection" :names ("event-old-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native old-selection metadata for AUI events; kind/event-stage meanings are native policy, not a universal prior-active-page contract. For CLOSE this field can be the private group-local tab index; it is not generally the old global active index." :position 166123)
("api/event-origin-id" :names ("event-origin-id" "(setf event-origin-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy/read GetEventObject identity only when it matches a registered application, owned handler, tracked window or managed menu resource. This differs from EVENT-SOURCE (binding receiver) and EVENT-ID (routing metadata). Pointer identity is compared without dereferencing the origin; no native pointer or wrapper reconstruction is exposed. Clear-only live SETF accepts NIL. Owned events are already detached; non-null current origins can clear only for registered command/notify tags matching actual native class. No origin object is retained or destroyed; EVENT-SOURCE and earlier snapshots stay unchanged." :position 168681)
("api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :position 171695)
("api/event-position" :names ("event-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Fresh (x y) client coordinates for key/mouse, screen coordinates for context-menu, NIL for keyboard context-menu sentinel. Native coordinates, not automatic DIP conversion." :position 172207)
("api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :position 173779)
("api/event-raw-control-down-p" :names ("event-raw-control-down-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy wxKeyboardState::RawControlDown from native key/mouse input. Distinguishes native Command semantics and physical Control on macOS." :position 175353)
("api/event-raw-key-code" :names ("event-raw-key-code") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native platform raw key code or NIL when unsupported." :position 176304)
("api/event-raw-key-flags" :names ("event-raw-key-flags") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native platform raw key flags or NIL when unsupported." :position 177531)
("api/event-related-window-id" :names ("event-related-window-id") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Numeric registered previous/next focus window identity or NIL; no raw pointer, ownership or retained liveness." :position 178764)
("api/event-sash-position" :names ("event-sash-position" "(setf event-sash-position)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "EVENT snapshot or context: sash pixels, NIL for unrelated snapshots. SETF only current CHANGING context: -1 cancels, or 0..536870911." :position 180177)
("api/event-selection" :names ("event-selection" "(setf event-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads choice/listbox wxCommandEvent selection metadata, or derived wxBookCtrlEvent selection for notebook changing/changed. This is event payload, not a fresh control-model query. Notebook CHANGING semantics are port-dependent (Windows may report the old page); old-selection metadata is not exposed. Snapshots survive later item edits unchanged. Radio-box wxCommandEvent selection is read-only semantic metadata; it does not query current control state. :COMBO-SELECTION command metadata is read-only semantic index data; it is not a fresh combo query. TEXT snapshots have NIL selection." :position 181532)
("api/event-selection-p" :names ("event-selection-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read whether command extra LONG is nonzero. This is not a :SELECTION-kind predicate or index-validity test: normal choice metadata can have a valid index while this flag is NIL. Use EVENT-EXTRA-LONG to change the underlying field." :position 185036)
("api/event-size" :names ("event-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Fresh native whole-window (width height), not client extent or a DIP guarantee." :position 186314)
("api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :position 187595)
("api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. EVENT-ORIGIN-ID separately reports a known native origin bridge identity without wrapping arbitrary wxObjects; EVENT-ID remains event routing metadata. Saved receiver wrappers may outlive their native object." :position 190028)
("api/event-stc-fold-level-now" :names ("event-stc-fold-level-now") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED current native fold level." :position 191211)
("api/event-stc-fold-level-previous" :names ("event-stc-fold-level-previous") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED prior native fold level." :position 192786)
("api/event-stc-key" :names ("event-stc-key") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "CHARADDED native character/key code, not arbitrary key-down state." :position 194372)
("api/event-stc-length" :names ("event-stc-length") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED/NEEDSHOWN native byte length." :position 195976)
("api/event-stc-line" :names ("event-stc-line") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "MODIFIED native line metadata." :position 197533)
