("example/examples/binding-user-data.lisp" :names ("examples/binding-user-data.lisp" "binding-user-data") :kind :example :kind-name "Example" :summary "Associate EQ Lisp state per binding, read it through snapshots/current contexts and preserve active data across unbinding without exposing native pointers." :position 1729851)
("example/examples/bitmap-toggles.lisp" :names ("examples/bitmap-toggles.lisp" "bitmap-toggles") :kind :example :kind-name "Example" :summary "Font-independent native borderless bitmap toggle with alpha artwork, native window-colour query, copied ownership, checked events and EXERCISE coverage." :position 1731875)
("example/examples/clipboard.lisp" :names ("examples/clipboard.lisp" "clipboard") :kind :example :kind-name "Example" :summary "Interactive START copies/replaces a whole single-line field through the standard text clipboard with best-effort flush; automatic EXERCISE only queries availability and never reads/replaces system clipboard content." :position 1735330)
("example/examples/close-events.lisp" :names ("examples/close-events.lisp" "close-events") :kind :example :kind-name "Example" :summary "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup." :position 1738583)
("example/examples/combo-boxes.lisp" :names ("examples/combo-boxes.lisp" "combo-boxes") :kind :example :kind-name "Example" :summary "Choose a fixed destination preset or type a custom value. EXERCISE checks silent/explicit selection and text notifications, UTF-8 and NIL clearing; no physical input simulation." :position 1741684)
("example/examples/command-event-payloads.lisp" :names ("examples/command-event-payloads.lisp" "command-event-payloads") :kind :example :kind-name "Example" :summary "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin." :position 1744571)
("example/examples/context-menus.lisp" :names ("examples/context-menus.lisp" "context-menus") :kind :example :kind-name "Example" :summary "Owned recent submenu exercise and native right-click choices. EXERCISE runs ownership checks; START shows an interactive tree." :position 1746940)
("example/examples/date-picker.lisp" :names ("examples/date-picker.lisp") :kind :example :kind-name "Example" :summary "Required due date with leap-day initialization, copied native change snapshots and an owner-bound deferred Reset action. EXERCISE checks explicit-notify label updates and reset without simulating physical date input." :position 1749561)
