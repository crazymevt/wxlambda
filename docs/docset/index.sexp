("api/ui-action" :names ("ui-action") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Separate closure roots live in the session queue, not the immutable ticket. No public token accessor or direct resource constructor." :position 356873)
("api/ui-action-p" :names ("ui-action-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "May be used outside a session; does not query native liveness." :position 358276)
("api/ui-action-pending-p" :names ("ui-action-pending-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks native owner liveness including pending ancestor deletion; observed expiry removes queued work and releases the Lisp root." :position 358865)
