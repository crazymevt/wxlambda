("api/allow-next-key-event" :names ("allow-next-key-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Calls DoAllowNextEvent on current CHAR_HOOK context; keeps hook consumption independent from normal key generation." :position 16304)
("api/append-grid-columns" :names ("append-grid-columns") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Change owned native string-table dimensions. Result axes0..256, product at most16384; constructor remains nonempty. Safe structural phase required; active editor rejects." :position 17576)
