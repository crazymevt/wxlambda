("api/append-item" :names ("append-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Append native text silently, preserving selected index/NIL. Empty strings/duplicates allowed. Native failure signals; no transactional rollback claim. LIST-CONTROL accepts a proper list of NUL-free cell strings matching columns, stored mode only, max100000 rows and1MiB total row text; returns appended zero-based row." :position 19487)
("api/append-tree-item" :names ("append-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Append in native order, preserving selection silently. Native parent owner is inferred and checked; empty/duplicate text valid." :position 20838)
("api/application-handler" :names ("application-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Borrowed native identity with inherited binding, dispatch, liveness and enabled state. Direct construction and subclass construction are rejected; explicit destruction signals NATIVE-ERROR. Session cleanup owns the native wxApp." :position 22012)
("api/aui-notebook" :names ("aui-notebook") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native-backed dynamic panel-page container, native programmatic tab splitting and fixed top/close styles, with at most256 pages. Mouse reordering is available while one group exists; split books use checked programmatic movement. Direct subclasses/default initargs/native-ready AFTER hooks and managed failure/root rollback." :position 23537)
("api/available-fonts" :names ("available-fonts") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Enumerate installed native fonts; optional fixed-width filtering. Main-thread active session; no font handles or installation." :position 26144)
