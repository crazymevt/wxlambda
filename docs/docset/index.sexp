(
("api/activate-menu-item" :names ("activate-menu-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Programmatically route the native command through its frame. Separators reject. This is not a claim that graphical OS menu selection or accelerators were exercised. Event metadata and resource state remain distinct; see MENUS guide for checked-command behavior. Native check-item activation toggles the resource before callbacks. A normal item can carry native command integer -1, so EVENT-CHECKED-P may be true even for a normal item; use CHECKED-P on a known check resource for actual state." :position 0)
("api/activate-toolbar-tool" :names ("activate-toolbar-tool") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR ID for a realized action tool." :position 1792)
("api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :position 2756)
("api/add-notebook-page" :names ("add-notebook-page") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Setup-time AddPage, outside RUN/pumps/callbacks. Reject duplicate membership, wrong parent/type, containing sizer and incomplete page initialization. Pre-root canonical wrapper before publication; callback errors after adoption do not remove a successful page. Direct attached-page destruction is forbidden; destroy notebook/ancestor instead. First-page selection/callback count and native caption processing are port-specific." :position 3890)
("api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :position 5703)
("api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :position 6579)
("api/add-toolbar-separator" :names ("add-toolbar-separator") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR. No action ID or state." :position 7498)
("api/add-toolbar-tool" :names ("add-toolbar-tool") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR ID LABEL; :art (:information default), :kind (:normal default) and :help (empty default)." :position 8356)
("api/add-tree-root" :names ("add-tree-root") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Require empty tree; create/select root silently under native event blockers and publish checked token/view. Empty text valid. Failed Lisp view publication deletes new native item." :position 9586)
("api/append-item" :names ("append-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Append native text silently, preserving selected index/NIL. Empty strings/duplicates allowed. Native failure signals; no transactional rollback claim." :position 10788)
("api/append-tree-item" :names ("append-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Append in native order, preserving selection silently. Native parent owner is inferred and checked; empty/duplicate text valid." :position 11802)
("api/application-handler" :names ("application-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Borrowed native identity with inherited binding, dispatch, liveness and enabled state. Direct construction and subclass construction are rejected; explicit destruction signals NATIVE-ERROR. Session cleanup owns the native wxApp." :position 12928)
("api/bind-event" :names ("bind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors. A native entry-owned wxObject token adapter represents non-NIL user data without a Lisp/native pointer. EVENT-USER-DATA reads the per-binding value in snapshots/current contexts; there is no public mutation API for an existing association. ABI37 adds :NOTEBOOK-PAGE-CHANGING/:NOTEBOOK-PAGE-CHANGED notify-family observers/contexts. Only CHANGING veto affects navigation. Native page callbacks protect the originating book/ancestors and reject same-book recursive selection, modal and clipboard entry. ABI38 listbox selection/double-click command events carry cached string/index payloads; snapshots are independent of later item edits. Native list callback guards protect receiver/ancestors and defer modal/clipboard entry while allowing item edits. ABI39 tree selection changing/changed are native-only wxTreeEvent notify types. EVENT-TREE-ITEM captures canonical view identity, not frozen text/validity; same-tree writes and nested native loops defer until callback return." :position 14453)
("api/binding-active-p" :names ("binding-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract." :position 19654)
("api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :position 21422)
("api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :position 22555)
("api/cancel-ui-action" :names ("cancel-ui-action") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove queued work and release its Lisp closure root. Cannot interrupt active work; owner expiry may already have pruned it." :position 23393)
("api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :position 24546)
("api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read boolean control/resource state. Menu normal/separator items reject." :position 25685)
("api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :position 27142)
("api/clear-items" :names ("clear-items") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Clear all items/selection silently; allowed in list event callbacks. Temporary native event blocker restores managed pushed-handler stack." :position 28306)
("api/clipboard-text" :names ("clipboard-text" "(setf clipboard-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Briefly opens the clipboard, reads wxTextDataObject with Unicode/legacy text support, closes and restores PRIMARY preference. Availability can change; a supported-text transfer failure signals rather than returning NIL. Explicit UTF-8 lengths copy native storage. NUL text rejects." :position 29232)
("api/clipboard-text-available-p" :names ("clipboard-text-available-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Advisory query on the standard clipboard; opens/closes and restores native PRIMARY preference. Does not read clipboard contents. A later read can differ." :position 31287)
("api/clone-event" :names ("clone-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call native Clone for exact wxCommandEvent/wxNotifyEvent/wxCloseEvent/wxIdleEvent with supported tags, clear native origin, preserve supported values and reject borrowed userdata/client pointers. Source and clone are independently mutable/disposable. Capture effective command GetString before clearing origin, so lazy wxEVT_TEXT payload becomes detached value data." :position 32478)
("api/close-window" :names ("close-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction. A callback can explicitly mutate CanVeto through SETF EVENT-CAN-VETO-P; FORCE is not an immutable capability limit." :position 34490)
("api/current-application-handler" :names ("current-application-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups." :position 36616)
("api/defer-ui-action" :names ("defer-ui-action") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Queue strongly rooted work without inline execution. One action per safe native idle iteration after callback/native stacks return. Captured borrowed event contexts expire; capture snapshots/values instead." :position 37685)
("api/delete-item" :names ("delete-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete silently. Deleting the selected row clears selection; an earlier deletion shifts selected index down one, preserving the same item. No stable IDs or automatic domain-model updates." :position 39190)
("api/delete-pending-events" :names ("delete-pending-events") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete queued native events without invoking callbacks; bindings and other handler queues remain intact. Synchronize wxApp pending-handler membership after deletion. Transferred input wrappers remain consumed; later queueing/posting still works." :position 40259)
("api/delete-tree-item" :names ("delete-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invalidate/delete whole subtree. Preserve an outside selection, otherwise choose surviving parent/root silently; deleting root leaves empty. Revision-prune invalid cached views." :position 41756)
("api/destroy-event" :names ("destroy-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Release this independent native event. Copies already queued/processing remain valid; repeated destruction rejects. Session cleanup releases undisposed owned events, even if the Lisp wrapper was collected." :position 42957)
("api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window and application identities are borrowed and reject this operation; use DESTROY-WINDOW for windows. Only session cleanup destroys the application. Destroying a linked standalone handler during a callback now rejects; outside callbacks native destruction splices reciprocal neighbors. Unlinked callback destruction retains existing deferral. Attached handlers are removed from their managed window before outside-callback deletion; linked/attached callback destruction rejects." :position 44149)
("api/destroy-menu-resource" :names ("destroy-menu-resource") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete a resource through its native owner, invalidating descendants and wrapper handles. Menu/bar deletion removes it from its parent; frame lifetime also cleans remaining descendants. Structural callback/pump/RUN deletion rejects." :position 46796)
("api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :position 48251)
("api/dialog" :names ("dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Shared bounded modal protocol and ordinary managed window lifetime." :position 50207)
("api/dialog-message" :names ("dialog-message") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read immutable message body. Title is separately mutable through DIALOG-TITLE; no message-body writer in this slice." :position 51688)
("api/dialog-modal-p" :names ("dialog-modal-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native modal state. False after END-MODAL is not permission to destroy the dialog/ancestor before SHOW-MODAL returns." :position 52692)
("api/dialog-selection" :names ("dialog-selection" "(setf dialog-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write the single-choice selection index; NIL and out-of-range values reject. No item-list replacement API is added." :position 53651)
("api/dialog-selection-text" :names ("dialog-selection-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the last accepted native selection-string cache, not a string derived from the current selected index. SetSelection changes the index but GetStringSelection can remain empty until an actual OK-button transfer; a previous accepted cache can remain after index changes or raw END-MODAL. No cache synchronization is promised." :position 54868)
("api/dialog-title" :names ("dialog-title" "(setf dialog-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write native dialog title; scalar callback updates are allowed." :position 56284)
("api/dialog-value" :names ("dialog-value" "(setf dialog-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write native text-entry dialog value. Native GetValue is stored dialog data and need not expose live edit-buffer changes. SETF crosses the notifying callback boundary; callback conditions follow the existing Lisp condition protocol." :position 57343)
("api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :position 58807)
("api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable. Menu item access reads its native item flag, without an ancestor-window interpretation; separators reject." :position 59971)
("api/end-modal" :names ("end-modal") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call raw native EndModal with the selected result. This is not an OK-button click: it does not invoke button validation or native data transfer. Native IsModal can become false before SHOW-MODAL returns; the active modal lifetime guard remains until that call unwinds. Generic internal prompt cancellation unwinds internal-to-outer sequentially. Raw :OK does not enforce file must-exist/overwrite checks; actual native OK-button behavior handles configured validation. While an internal prompt is active, successful completion of the public outer dialog (:OK/:YES/:NO) rejects; only :CANCEL requests sequential unwind of the entire workflow." :position 61631)
("api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation. Registered names and family/integer data remain available in saved snapshots after session cleanup. Notify snapshots capture pre-callback veto capability/state independently of later Veto/Allow. Timestamp and native IsCommandEvent are copied before each callback; saved reads need no active session. Snapshot EVENT-USER-DATA captures the per-binding EQ Lisp reference before callback, independently of later unbinding. Mutable referent contents are not copied/frozen." :position 63774)
("api/event-alive-p" :names ("event-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query the independent owned-event registry. Failed/uninitialized wrappers have no native handle and signal NATIVE-ERROR. This is not context activity or native origin liveness. TRANSFER-EVENT consumes the source registry handle; queued copies from POST-EVENT/QUEUE-EVENT do not." :position 65822)
("api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :position 67090)
("api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :position 68591)
("api/event-can-veto-p" :names ("event-can-veto-p" "(setf event-can-veto-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots read copied capability without a session. Current close contexts use CanVeto; current notify contexts always support Veto/Allow. Plain command contexts return NIL. Scope validation remains required for native access. Context SETF maps native SetCanVeto directly, including false to true. GetVeto hides a stored veto when CanVeto is false and reveals it again if re-enabled. Forced close starts false but explicit metadata mutation can affect native closing results; OS veto acceptance is not guaranteed." :position 69287)
("api/event-category" :names ("event-category") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read virtual GetEventCategory: current supported command/notify-derived classes report USER_INPUT and close/idle-family events report UI. Values are category flags, not event types/IDs/families; synthetic USER_INPUT is not proof of real user input. Snapshot values are captured before the callback." :position 72082)
("api/event-category-mask" :names ("event-category-mask") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the bridge and return its compiled wxEventCategory constant without initializing a GUI session. Combine with LOGIOR/test with LOGTEST. ALL can include implementation category bits and is not restricted to the public five-bit union." :position 73787)
("api/event-checked-p" :names ("event-checked-p" "(setf event-checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the kind-limited checked interpretation of native command integer. Live SETF writes SetInt(0/1) only for :TOGGLE/:MENU without calling a control setter. Raw EVENT-INTEGER can supply other nonzero checked values; earlier snapshots stay unchanged. Later native/user handlers can react to changed metadata; the entire dispatch is not guaranteed to leave controls unchanged. Native normal-menu commands may carry integer -1 and thus read checked true; this raw view does not classify a check item." :position 75058)
("api/event-command-p" :names ("event-command-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current native IsCommandEvent classification. No mutable classification or event replacement. Saved values remain independent of source lifetime." :position 77262)
("api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state." :position 78571)
("api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :position 80640)
("api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :position 82301)
("api/event-extra-long" :names ("event-extra-long" "(setf event-extra-long)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetExtraLong or set native command/notify extra metadata. It is separate from signed32 EVENT-INTEGER and item indices. Raw EVENT-SELECTION-P reflects whether this field is nonzero. Snapshots preserve pre-callback values." :position 83039)
("api/event-family" :names ("event-family") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current supported native classification :COMMAND/:NOTIFY/:CLOSE/:IDLE, including owned event values and saved snapshots after registry cleanup. It is bounded class metadata, not arbitrary native RTTI." :position 84743)
("api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles. Standalone wrappers are now strongly canonicalized by session identity for EQ chain peer lookup; no new native ownership or finalizer is introduced. Managed window push leaves native ownership/session rooting unchanged; window destruction detaches handlers rather than deleting them." :position 85915)
("api/event-handler-client-data" :names ("event-handler-client-data" "(setf event-handler-client-data)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Store a session-root token in a bridge wxClientData adapter; the Lisp table retains the actual object. No Lisp pointer, serialization or native ownership of the Lisp object. Replacement/clear releases old association through cleanup; an ordinary returned Lisp reference remains valid. No constructor initarg: native-backed subclass AFTER hooks may SETF." :position 89003)
("api/event-id" :names ("event-id" "(setf event-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read a saved pre-callback ID or current native GetId. Context SETF changes event metadata and later native ID matching, not the source window ID or binding filters. Earlier snapshots stay unchanged. No dispatch restart or callback-order guarantee." :position 91320)
("api/event-integer" :names ("event-integer" "(setf event-integer)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetInt or change the native command payload with SETF. Built-in toggle/selection interpretations can reflect this underlying value. Earlier snapshots remain unchanged. Raw values can affect semantic checked/selection views; negative indices other than -1 remain visible through EVENT-SELECTION after raw writes. It does not alter EXTRA-LONG or raw IsSelection." :position 93405)
("api/event-kind" :names ("event-kind") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the event kind. The captured kind reflects the actual supported native tag at callback entry, even if an earlier callback changed it; binding registration identity does not change." :position 95210)
("api/event-logging-off-p" :names ("event-logging-off-p" "(setf event-logging-off-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied or current wxCloseEvent logging-off metadata for :QUERY-END-SESSION/:END-SESSION. Context SETF changes native metadata only, not OS policy. Snapshots retain pre-callback state and have no SETF method." :position 96379)
("api/event-more-requested-p" :names ("event-more-requested-p" "(setf event-more-requested-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read idle request-more metadata or call wxIdleEvent::RequestMore with SETF. Earlier snapshots stay unchanged. Bounded idle work may request another native idle pass; this is not a busy-loop, timer or immediate-delivery guarantee." :position 98355)
("api/event-native-type" :names ("event-native-type" "(setf event-native-type)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current GetEventType. Saved values remain data after callback/source/session cleanup. Compare to EVENT-TYPE in the same active session; numeric tags are not stable serialized IDs or native cast authority. Context SETF accepts only registered same-family source/target tags and validates actual native command/notify class before SetEventType. Earlier snapshots and registration identities remain unchanged; later snapshots report the current native tag. No dispatch restart or local delivery-order guarantee." :position 99990)
("api/event-origin-id" :names ("event-origin-id" "(setf event-origin-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy/read GetEventObject identity only when it matches a registered application, owned handler, tracked window or managed menu resource. This differs from EVENT-SOURCE (binding receiver) and EVENT-ID (routing metadata). Pointer identity is compared without dereferencing the origin; no native pointer or wrapper reconstruction is exposed. Clear-only live SETF accepts NIL. Owned events are already detached; non-null current origins can clear only for registered command/notify tags matching actual native class. No origin object is retained or destroyed; EVENT-SOURCE and earlier snapshots stay unchanged." :position 102782)
("api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :position 105796)
("api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :position 106308)
("api/event-sash-position" :names ("event-sash-position" "(setf event-sash-position)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "EVENT snapshot or context: sash pixels, NIL for unrelated snapshots. SETF only current CHANGING context: -1 cancels, or 0..536870911." :position 107882)
("api/event-selection" :names ("event-selection" "(setf event-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads choice/listbox wxCommandEvent selection metadata, or derived wxBookCtrlEvent selection for notebook changing/changed. This is event payload, not a fresh control-model query. Notebook CHANGING semantics are port-dependent (Windows may report the old page); old-selection metadata is not exposed. Snapshots survive later item edits unchanged." :position 109237)
("api/event-selection-p" :names ("event-selection-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read whether command extra LONG is nonzero. This is not a :SELECTION-kind predicate or index-validity test: normal choice metadata can have a valid index while this flag is NIL. Use EVENT-EXTRA-LONG to change the underlying field." :position 111223)
("api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :position 112501)
("api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. EVENT-ORIGIN-ID separately reports a known native origin bridge identity without wrapping arbitrary wxObjects; EVENT-ID remains event routing metadata. Saved receiver wrappers may outlive their native object." :position 114934)
("api/event-text" :names ("event-text" "(setf event-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or copy native command string payload. Context/owned SETF uses explicit UTF-8 byte lengths, preserving embedded NULs. Saved snapshots stay immutable and retain their prior kind-specific payload interpretation. ABI38 listbox selection/double-click command events carry cached string/index payloads; snapshots are independent of later item edits. Native list callback guards protect receiver/ancestors and defer modal/clipboard entry while allowing item edits." :position 116117)
("api/event-timestamp" :names ("event-timestamp" "(setf event-timestamp)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current native timestamp, not necessarily Unix time. Negative values including -1 are valid. Synthetic events start at zero. Context SETF changes metadata only, not scheduling. Snapshots stay immutable and preserve pre-callback values." :position 118404)
("api/event-tree-item" :names ("event-tree-item") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshot retains view identity, not live validity or frozen label. Non-tree snapshots return NIL; non-tree contexts reject. No owned-event method/setter; associated item can be invalidated later. Copy text while live if needed." :position 120525)
("api/event-type" :names ("event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a process-local native type ID. Fifteen built-in kinds plus registered command/notify names are supported. Registry names are session-scoped; saved snapshot native IDs remain plain data after cleanup. Borrowed application handler access is supported; arbitrary native event-class binding and OS session delivery remains unverified." :position 121827)
("api/event-user-data" :names ("event-user-data") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the snapshot-captured or callback-frame-retained binding association. No deep copy: mutable referent contents remain ordinary Lisp state. Snapshot reads survive unbind/receiver/session cleanup. Current frames retain values across self/peer unbind and nested dispatch restores outer context identity." :position 123461)
("api/event-vetoed-p" :names ("event-vetoed-p" "(setf event-vetoed-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots retain pre-callback state. Close contexts use GetVeto / checked Veto(bool); notify contexts use NOT IsAllowed, Veto() for true, and Allow() for NIL. A close initialized non-vetoable rejects writes unless its current CanVeto flag was explicitly enabled through SETF EVENT-CAN-VETO-P. Plain command contexts reject live veto-state access. Snapshots stay immutable. Native GetVeto is CanVeto AND the stored veto bit; disabling capability hides the bit without clearing it." :position 125082)
("api/file-dialog" :names ("file-dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Construct a generic single-file selection dialog. Directory/path accept strings or pathnames converted through native namestring; supplied directory must exist, empty directory lets native code use cwd. Path must be nonempty; filename is a string. Filters require nonempty description/pattern pairs and valid zero-based filter index. No change-directory flag, multiselect or external controls. Dialog browser actions such as New Directory can change the filesystem; selection does not perform file-content IO. True MUST-EXIST is rejected for :SAVE, and true OVERWRITE-PROMPT for :OPEN. Supplied path directories must exist." :position 127768)
("api/file-dialog-filter-index" :names ("file-dialog-filter-index" "(setf file-dialog-filter-index)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write one of the construction-time wildcard description/pattern pairs. Invalid index rejects. Filters do not prove current path acceptance." :position 130615)
("api/file-dialog-mode" :names ("file-dialog-mode") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read fixed single-file selection mode. Configured native UI validation differs from raw END-MODAL result assignment. Reader reflects the actual restored generic file flags, including the macOS overlap repair, rather than merely echoing a Lisp requested-mode slot." :position 132038)
("api/file-dialog-path" :names ("file-dialog-path" "(setf file-dialog-path)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write current single-file path. This is not acceptance, file existence, overwrite confirmation or successful content IO. A raw END-MODAL :OK bypasses button validation/transfer, must-exist and overwrite enforcement. Native property changes can open internal prompts and use the guarded prompt workflow." :position 133311)
("api/flush-clipboard" :names ("flush-clipboard") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Best-effort persistence after exit, on the standard clipboard. Does not set clipboard contents. A false native Flush result is normal; open/session failures signal NATIVE-ERROR." :position 135124)
("api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :position 136371)
("api/frame-accelerators" :names ("frame-accelerators" "(setf frame-accelerators)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/replace a copied native frame accelerator table for shared :MENU action IDs. Native menu enable/check and origin/metadata behavior vary by port; use a Lisp action model." :position 137708)
("api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :position 139756)
("api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :position 141168)
("api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :position 142975)
("api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :position 144642)
("api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :position 146061)
("api/handler-alive-p" :names ("handler-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR." :position 146970)
("api/handler-enabled-p" :names ("handler-enabled-p" "(setf handler-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Scoped contexts support Skip/propagation and checked close/notify veto; arbitrary pushed handlers remain unbound. In standalone chains this affects only the node itself, not processing by following nodes." :position 148952)
("api/handler-unlinked-p" :names ("handler-unlinked-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native IsUnlinked without changing native ownership or queue membership. An unlinked wrapper remains strongly registered and its native object remains session-owned until explicit destruction or cleanup." :position 151290)
