("example/examples/event-contexts.lisp" :names ("examples/event-contexts.lisp" "event-contexts") :kind :example :kind-name "Example" :summary "A contextual button binding conditionally forwards commands to a parent observer. A checkbox controls Skip; the reusable exercise checks consumption, forwarding, native-type snapshots and expiration after callback return." :position 1786856)
