(:entry "api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stop )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL in the application REPL; T after stopping a native RUN loop.")) ("Description" (:p "Leave RUN or end the application REPL. Stopping the loop does not destroy windows.")) ("Errors and scope" (:p "Outside the application REPL, a running native event loop is required; otherwise NATIVE-ERROR.")) ("wxWidgets" (:p "wxAppConsole::ExitMainLoop"))))
(:entry "api/stop-event-propagation" :names ("stop-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stop-event-propagation event)")) ("Arguments" (:p "CONTEXT is the current event context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Previous nonnegative native propagation level.")) ("Description" (:p "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::StopPropagation (wxWidgets 3.2.12 baseline)."))))
(:entry "api/styled-text-control" :names ("styled-text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native Scintilla control with UTF-8 codepage, container lexer and no wrap. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and managed failure/root rollback. No file/document model or language-service abstraction." :sections (("Syntax" (:code-block "lisp" "wxlambda:styled-text-control")) ("Arguments" (:p "Required :parent WINDOW; :value defaults empty valid UTF-8 string, total<=64MiB; subclass initargs.")) ("Returns" (:p "STYLED-TEXT-CONTROL WINDOW subtype.")) ("Description" (:p "Native Scintilla control with UTF-8 codepage, container lexer and no wrap. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and managed failure/root rollback. No file/document model or language-service abstraction.")) ("Errors and scope" (:p "Active GUI thread/session and checked native STYLED-TEXT-CONTROL lifetime. UTF-8 byte offsets, never Lisp string indices; position arguments must be codepoint boundaries. Initial/replacement UTF-8 text supports embedded NUL and total<=64MiB; font/assist strings are NUL-free<=1MiB. Integer/index domains are bounded by the adapter. Mutations reject callbacks except same-control StartStyling/SetStyling/SetStyleBytes in the exact innermost native STYLENEEDED callback. Native synchronous events and source/ancestor lifetime/native-entry guards apply; use owner-bound deferred actions for other writes. No raw SendMsg, pointer/document adoption, lexer/resource ownership, worker calls or application editor abstractions. Requires wxUSE_STC and stc component. See docs/STYLED-TEXT.md.")) ("wxWidgets" (:p "wxStyledTextCtrl::Create, wxWidgets3.2.12.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:styled-text-control :parent parent :value \"λ\")") (:p "One concrete native widget kind; thin validated factory and managed rollback."))))
(:entry "api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls. ABI36 carries explicit UTF-8 lengths and rejects embedded NUL on writes; multiline native values use LF-separated lines. Read-only controls still allow programmatic edits. Native positions are not Lisp string indices. COMBO-BOX is single-line: NUL/CR/LF writes reject. Clears old native selection then ChangeValue; matching-text selection readback remains native. SEARCH-CONTROL query is copied native single-line text with NUL/CR/LF write rejection; hint is separate SEARCH-HINT." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text control &key notify)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL, COMBO-BOX or SEARCH-CONTROL. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the current UTF-8 text; returned storage survives later native calls. ABI36 carries explicit UTF-8 lengths and rejects embedded NUL on writes; multiline native values use LF-separated lines. Read-only controls still allow programmatic edits. Native positions are not Lisp string indices. COMBO-BOX is single-line: NUL/CR/LF writes reject. Clears old native selection then ChangeValue; matching-text selection readback remains native. SEARCH-CONTROL query is copied native single-line text with NUL/CR/LF write rejection; hint is separate SEARCH-HINT.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTextEntry::GetValue/ChangeValue for wxTextCtrl, wxComboBox and wxSearchCtrl; explicit bridge notification of wxEVT_TEXT (wxWidgets3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text control :notify notify) new-value)") (:p "Text replacement is silent by default. :NOTIFY T emits text-change events synchronously; callback conditions return to the writer caller. Writers are generic functions with VALUE first, followed by the receiver. Values must be strings without NUL; ABI36 validates instead of truncating. Read-only is user typing policy, not a programmatic mutation restriction. COMBO-BOX writes are silent by default; :NOTIFY T emits exactly one :TEXT-CHANGE even unchanged, after commit. Same-combo callback writes reject; callback errors preserve committed text. See docs/COMBO-BOXES.md. SEARCH-CONTROL uses silent ChangeValue by default; notify emits exactly one TEXT event even unchanged. Same-source query/hint writes reject during actual input callbacks; native search/cancel are separate kinds. See docs/SEARCH-CONTROLS.md."))))
(:entry "api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:text-control")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxTextCtrl with text-change handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxTextCtrl (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:text-control :parent parent :value \"\" :multiline nil :editable-p t)") (:p "PARENT required; VALUE defaults empty, MULTILINE defaults NIL, EDITABLE-P defaults T. Multiline style is immutable; user editability has generic SETF. Read-only still permits explicit Lisp edits. Subclass slots/defaults/AFTER hooks and managed rollback apply. NUL text rejects."))))
(:entry "api/text-editable-p" :names ("text-editable-p" "(setf text-editable-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read whether native user editing is enabled. Programmatic text writes remain allowed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text-editable-p control)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL.")) ("Returns" (:p "T/NIL.")) ("Description" (:p "Read whether native user editing is enabled. Programmatic text writes remain allowed.")) ("Errors and scope" (:p "Active main-thread application; TEXT-CONTROL receivers only, including Lisp subclasses. Wrong receiver dispatch, stale/wrong native handles and invalid ranges/types signal. Native offsets are not portable Lisp string indices; no -1 sentinels, GetRange, undo/redo, rich text or native file IO.")) ("wxWidgets" (:p "wxTextEntry::IsEditable/SetEditable (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text-editable-p control) value)") (:p "A generalized boolean changes user editability; returns VALUE. Does not prohibit explicit Lisp text writes."))))
(:entry "api/text-entry-dialog" :names ("text-entry-dialog") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Construct a modal-only native text-entry dialog. Dialog value is native stored value, not a promise of live edit-buffer contents. Strings are Unicode without NUL; empty strings are accepted. Defaults/subclass slot initargs and AFTER hooks use the native-backed CLOS protocol. Failed managed initialization destroys newly created resources; it does not reverse arbitrary external mutations." :sections (("Syntax" (:code-block "lisp" "wxlambda:text-entry-dialog")) ("Arguments" (:p "Optional :PARENT window(default NIL), :MESSAGE(default \"Enter a value:\"), :TITLE(default \"Text entry\"), :VALUE(default empty string).")) ("Returns" (:p "New native-backed dialog.")) ("Description" (:p "Construct a modal-only native text-entry dialog. Dialog value is native stored value, not a promise of live edit-buffer contents. Strings are Unicode without NUL; empty strings are accepted. Defaults/subclass slot initargs and AFTER hooks use the native-backed CLOS protocol. Failed managed initialization destroys newly created resources; it does not reverse arbitrary external mutations.")) ("Errors and scope" (:p "Requires an active main-thread GUI session and a live managed dialog. Invalid native handles/state signal NATIVE-ERROR; invalid Lisp types/receivers signal Lisp conditions. Modal-only text-entry/single-choice scope; no arbitrary native adoption, GC finalizer or native virtual Lisp overrides. Native validity includes the receiver and all native ancestors: bridge pending-destruction markers and the public wxApp scheduled-deletion list reject use even before IsBeingDeleted becomes true. SHOW-MODAL preflight must not enter a loop beneath an ancestor already queued for deletion.")) ("wxWidgets" (:p "wxTextEntryDialog constructor (wxWidgets 3.2.12 baseline).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:text-entry-dialog :parent frame :message \"Name\" :title \"Edit\" :value \"Ada\")") (:p "Direct subclass construction is supported with DEFAULT-INITARGS and inherited native initialization. Native properties exist in subclass AFTER hooks. Standard DESTROY-WINDOW/native parent ownership governs cleanup. Construction is permitted on the GUI thread inside callbacks/RUN/pumps, so menu actions can create dialogs; menu structural-edit guards do not apply to dialog construction. The bridge normalizes the actual native parent to the explicitly requested window or NIL, retaining even a hidden requested parent. NIL means truly parentless rather than native automatic parent selection."))))
(:entry "api/text-insertion-point" :names ("text-insertion-point" "(setf text-insertion-point)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the native insertion offset." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text-insertion-point control)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL.")) ("Returns" (:p "A native integer offset.")) ("Description" (:p "Read the native insertion offset.")) ("Errors and scope" (:p "Active main-thread application; TEXT-CONTROL receivers only, including Lisp subclasses. Wrong receiver dispatch, stale/wrong native handles and invalid ranges/types signal. Native offsets are not portable Lisp string indices; no -1 sentinels, GetRange, undo/redo, rich text or native file IO.")) ("wxWidgets" (:p "wxTextEntry::GetInsertionPoint/SetInsertionPoint (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text-insertion-point control) value)") (:p "VALUE is a nonnegative signed-64-bit integer within native end. Returns VALUE; selection/caret side effects follow wxWidgets."))))
(:entry "api/text-last-position" :names ("text-last-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the native end offset for use with native selection/editing operations." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text-last-position control)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL.")) ("Returns" (:p "A native nonnegative integer offset, not Lisp string length.")) ("Description" (:p "Read the native end offset for use with native selection/editing operations.")) ("Errors and scope" (:p "Active main-thread application; TEXT-CONTROL receivers only, including Lisp subclasses. Wrong receiver dispatch, stale/wrong native handles and invalid ranges/types signal. Native offsets are not portable Lisp string indices; no -1 sentinels, GetRange, undo/redo, rich text or native file IO.")) ("wxWidgets" (:p "wxTextEntry::GetLastPosition (wxWidgets 3.2.12)."))))
(:entry "api/text-multiline-p" :names ("text-multiline-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the multiline style chosen at construction; no SETF." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text-multiline-p control)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL.")) ("Returns" (:p "T for multiline, NIL for single-line.")) ("Description" (:p "Read the multiline style chosen at construction; no SETF.")) ("Errors and scope" (:p "Active main-thread application; TEXT-CONTROL receivers only, including Lisp subclasses. Wrong receiver dispatch, stale/wrong native handles and invalid ranges/types signal. Native offsets are not portable Lisp string indices; no -1 sentinels, GetRange, undo/redo, rich text or native file IO.")) ("wxWidgets" (:p "wxTextCtrl::IsMultiLine (wxWidgets 3.2.12)."))))
(:entry "api/text-selection" :names ("text-selection" "(setf text-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read two native selection offsets for current content." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text-selection control)")) ("Arguments" (:p "CONTROL is a live TEXT-CONTROL.")) ("Returns" (:p "Two integer values FROM and TO.")) ("Description" (:p "Read two native selection offsets for current content.")) ("Errors and scope" (:p "Active main-thread application; TEXT-CONTROL receivers only, including Lisp subclasses. Wrong receiver dispatch, stale/wrong native handles and invalid ranges/types signal. Native offsets are not portable Lisp string indices; no -1 sentinels, GetRange, undo/redo, rich text or native file IO.")) ("wxWidgets" (:p "wxTextEntry::GetSelection/SetSelection (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text-selection control) value)") (:p "VALUE must be a proper two-integer list (FROM TO), ordered and within [0,native end]. Returns the same list. Rejects overflow/negative/sentinel positions; no clamping."))))
(:entry "api/time-picker" :names ("time-picker") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Required wall-clock time control with native wxTP_DEFAULT formatting/presentation. Default midnight, not current clock time. No raw adoption or uncreated wrapper." :sections (("Syntax" (:code-block "lisp" "wxlambda:time-picker")) ("Arguments" (:p "Required :parent WINDOW; optional :time exact (hour minute second) defaults (0 0 0), plus subclass initargs.")) ("Returns" (:p "Native-backed TIME-PICKER WINDOW subtype.")) ("Description" (:p "Required wall-clock time control with native wxTP_DEFAULT formatting/presentation. Default midnight, not current clock time. No raw adoption or uncreated wrapper.")) ("Errors and scope" (:p "Active GUI thread/session and live WINDOW lifetime. Required (hour minute second), hour0..23 and minute/second0..59, whole seconds only. Fixed local2012-01-01 native construction with component roundtrip/readback, no date/timezone/Unix/universal-time/scheduling API. Default native editor style/locale display. Input origin/composite/propagation and early Destroy guards; core/base/adv plus wxUSE_TIMEPICKCTRL/wxUSE_DATETIME required. See docs/TIME-PICKER.md.")) ("wxWidgets" (:p "wxTimePickerCtrl::Create, wxWidgets3.2.12; native component adv.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:time-picker :parent parent :time '(9 30 0))") (:p "Direct subclasses/default initargs, native-ready AFTER hooks and managed failure/root rollback; one concrete native widget kind per ancestry."))))
(:entry "api/to-dip" :names ("to-dip") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native ToDIP(wxPoint); input±1000000 native logical units." :sections (("Syntax" (:code-block "lisp" "(wxlambda:to-dip object x y)")) ("Arguments" (:p "window x y")) ("Returns" (:p "Two-element converted coordinate list.")) ("Description" (:p "Invoke native ToDIP(wxPoint); input±1000000 native logical units.")) ("Errors and scope" (:p "Active GUI/main-thread session and checked native lifetime. Image/bitmap values are session-owned and explicitly disposable; no raw pointers/finalizers. Native reads are callback-safe; writes, file IO, allocation/conversion, disposal and BITMAP-VALUE copying reject callback execution. Copied channels,256 resources/64Mi pixel aggregate,1..4096 pixel axes; PNG24 bytes..64MiB encoded. Native bitmap alpha/DPI conversion can change pixels. Invalid bounds/types/stale handles and native failures signal errors. See docs/IMAGES-DISPLAYS.md.")) ("wxWidgets" (:p "wxImage/wxBitmap/wxStaticBitmap/wxDisplay/wxWindow, selected native methods in wxWidgets3.2.12."))))
(:entry "api/toggle-button" :names ("toggle-button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Persistent independent two-state push button. Generic CHECKED-P/SETF and LABEL-TEXT/SETF properties; BIND-EVENT :TOGGLE-BUTTON-CHANGE." :sections (("Syntax" (:code-block "lisp" "wxlambda:toggle-button")) ("Arguments" (:p "PARENT (or :parent for MAKE-INSTANCE), :label NUL-free string default empty, :checked generalized boolean default NIL; :class and subclass initargs for factory.")) ("Returns" (:p "New native-backed TOGGLE-BUTTON or validated subclass.")) ("Description" (:p "Persistent independent two-state push button. Generic CHECKED-P/SETF and LABEL-TEXT/SETF properties; BIND-EVENT :TOGGLE-BUTTON-CHANGE.")) ("Errors and scope" (:p "Active main-thread GUI session, native handle/type/lifetime guards. No bitmap toggle, grouping, arbitrary styles or full class parity. Same-source value/label callback writes reject; silent other-source updates allowed. See docs/TOGGLE-BUTTONS.md.")) ("wxWidgets" (:p "wxToggleButton::Create/GetValue/SetValue, inherited wxControl::GetLabel/SetLabel; wxWidgets3.2.12.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:toggle-button :parent panel :label \"Preview\" :checked t)") (:p "Direct subclass slots/default initargs, native-ready AFTER hooks and managed rollback supported."))))
(:entry "api/toggle-stc-fold" :names ("toggle-stc-fold") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native ToggleFold. Arguments use the checked native domains described in the styled-text guide." :sections (("Syntax" (:code-block "lisp" "(wxlambda:toggle-stc-fold control line)")) ("Arguments" (:p "STYLED-TEXT-CONTROL; LINE native line.")) ("Returns" (:p "The control.")) ("Description" (:p "Invoke native ToggleFold. Arguments use the checked native domains described in the styled-text guide.")) ("Errors and scope" (:p "See docs/STYLED-TEXT.md. Checked UTF-8 byte positions/native indices and GUI-thread lifetime. Native synchronous notifications protected. Read-only coordinate/marker queries are callback-safe. Mutations reject event callbacks except same-control StartStyling/SetStyling/SetStyleBytes in the current innermost STYLENEEDED callback; use owner-bound deferred actions otherwise. No editor policy or custom native object adoption.")) ("wxWidgets" (:p "wxStyledTextCtrl, wxWidgets3.2.12."))))
(:entry "api/tool-checked-p" :names ("tool-checked-p" "(setf tool-checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR ID for a known check tool." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tool-checked-p toolbar id)")) ("Arguments" (:p "TOOLBAR ID for a known check tool.")) ("Returns" (:p "Boolean checked state.")) ("Description" (:p "TOOLBAR ID for a known check tool.")) ("Errors and scope" (:p "SETF writes silently, returning supplied value; normal tools and separators reject. Same-toolbar action writes defer. Native errors signal NATIVE-ERROR; Lisp type/range errors remain Lisp conditions. See docs/FRAME-ACTIONS.md for backend, ownership and complete supported scope.")) ("wxWidgets" (:p "wxToolBar::GetToolState / ToggleTool (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tool-checked-p toolbar id) value)") (:p "SETF writes silently, returning supplied value; normal tools and separators reject. Same-toolbar action writes defer."))))
(:entry "api/tool-enabled-p" :names ("tool-enabled-p" "(setf tool-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR ID for a known action tool." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tool-enabled-p toolbar id)")) ("Arguments" (:p "TOOLBAR ID for a known action tool.")) ("Returns" (:p "Boolean enabled state.")) ("Description" (:p "TOOLBAR ID for a known action tool.")) ("Errors and scope" (:p "SETF writes silently, returning supplied value; same-toolbar action writes defer. Native errors signal NATIVE-ERROR; Lisp type/range errors remain Lisp conditions. See docs/FRAME-ACTIONS.md for backend, ownership and complete supported scope.")) ("wxWidgets" (:p "wxToolBar::GetToolEnabled / EnableTool (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tool-enabled-p toolbar id) value)") (:p "SETF writes silently, returning supplied value; same-toolbar action writes defer."))))
(:entry "api/toolbar" :names ("toolbar") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete horizontal frame-owned toolbar window." :sections (("Syntax" (:code-block "lisp" "wxlambda:toolbar")) ("Arguments" (:p "Concrete horizontal frame-owned toolbar window.")) ("Returns" (:p "A managed toolbar, initially without tools.")) ("Description" (:p "Concrete horizontal frame-owned toolbar window.")) ("Errors and scope" (:p "Use :parent frame. Fixed collection after Realize; see backend policy. Native errors signal NATIVE-ERROR; Lisp type/range errors remain Lisp conditions. See docs/FRAME-ACTIONS.md for backend, ownership and complete supported scope.")) ("wxWidgets" (:p "wxToolBar (wxWidgets 3.2.12).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:toolbar :parent frame)") (:p "Concrete native-backed construction supports subclass slots/default initargs/AFTER hooks and managed rollback."))))
(:entry "api/toolbar-tool-count" :names ("toolbar-tool-count") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "TOOLBAR." :sections (("Syntax" (:code-block "lisp" "(wxlambda:toolbar-tool-count toolbar)")) ("Arguments" (:p "TOOLBAR.")) ("Returns" (:p "Integer count including separators.")) ("Description" (:p "TOOLBAR.")) ("Errors and scope" (:p "Active live toolbar. Native errors signal NATIVE-ERROR; Lisp type/range errors remain Lisp conditions. See docs/FRAME-ACTIONS.md for backend, ownership and complete supported scope.")) ("wxWidgets" (:p "wxToolBar::GetToolsCount (wxWidgets 3.2.12)."))))
(:entry "api/tooltip-text" :names ("tooltip-text" "(setf tooltip-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or replace window-owned tooltip text. NIL removes the tooltip; empty text retains an attached empty tooltip. Native objects/pointers are never exposed or retained by Lisp. Native text normalization and hover presentation vary by port." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tooltip-text window)")) ("Arguments" (:p "Live WINDOW receiver; SETF value is NIL or a NUL-free string of0..4096 UTF-8 bytes.")) ("Returns" (:p "NIL for no attached tooltip, otherwise a fresh native tooltip text string (including empty). SETF returns the supplied value.")) ("Description" (:p "Read or replace window-owned tooltip text. NIL removes the tooltip; empty text retains an attached empty tooltip. Native objects/pointers are never exposed or retained by Lisp. Native text normalization and hover presentation vary by port.")) ("Errors and scope" (:p "Active main-thread GUI session, valid window lifetime. Reads may occur in callbacks; mutations reject callbacks and must be deferred via owner-bound UI actions. Synchronous setter protects receiver/ancestors and gates nested GUI/modal/clipboard entry through InputOperation. No tooltip initarg, global delay/enable policy, rich tips or per-item bindings. Requires wxUSE_TOOLTIPS=1. See docs/TOOLTIPS.md.")) ("wxWidgets" (:p "wxWindow::GetToolTip/GetToolTipText/SetToolTip(const wxString&)/UnsetToolTip; wxWidgets3.2.12.")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tooltip-text window) \"Enter your name\")") (:p "NIL calls UnsetToolTip; strings including empty call SetToolTip. Copies the input; rejects NUL and >4096 UTF-8 bytes before mutation. No notify option or synthetic event. Native-ready subclass AFTER hooks can set the property with ordinary construction rollback."))))
(:entry "api/transfer-event" :names ("transfer-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it." :sections (("Syntax" (:code-block "lisp" "(wxlambda:transfer-event handler event)")) ("Arguments" (:p "HANDLER is a live EVENT-HANDLER/window; EVENT is a live OWNED-EVENT to consume. No payload overrides.")) ("Returns" (:p "HANDLER after native handoff.")) ("Description" (:p "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it.")) ("Errors and scope" (:p "Active main-thread GUI session required. Preflight failures leave the owned input live; no rollback or delivery guarantee after handoff, including a post-handoff error. Existing session/text-entry receiver restrictions apply before consumption. No raw pointer or arbitrary native class transfer. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxQueueEvent / wxEvtHandler::QueueEvent native ownership handoff for supported owned events (wxWidgets 3.2.12 baseline)."))))
(:entry "api/tree-control" :names ("tree-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Managed item tokens and canonical views, native selection/veto and bounded structural navigation." :sections (("Syntax" (:code-block "lisp" "wxlambda:tree-control")) ("Arguments" (:p "Concrete WINDOW subclass with visible-root single-selection wxTreeCtrl.")) ("Returns" (:p "Native-backed tree window.")) ("Description" (:p "Managed item tokens and canonical views, native selection/veto and bounded structural navigation.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl (wxWidgets 3.2.12).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:tree-control :parent parent)") (:p "PARENT required. Fixed single-selection/root-line/button styles, other native constructor defaults. Subclass slots/defaults/AFTER hooks and managed initialization rollback apply."))))
(:entry "api/tree-item" :names ("tree-item") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Created by tree creation/traversal/selection APIs; EQ identity stable while native token is live. Retained views/snapshots can become invalid after subtree/owner deletion. Tokens are not raw native IDs." :sections (("Syntax" (:code-block "lisp" "wxlambda:tree-item")) ("Arguments" (:p "Borrowed canonical resource view, not a WINDOW.")) ("Returns" (:p "View of a checked native tree item.")) ("Description" (:p "Created by tree creation/traversal/selection APIs; EQ identity stable while native token is live. Retained views/snapshots can become invalid after subtree/owner deletion. Tokens are not raw native IDs.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "Checked wxTreeItemId adapter (wxWidgets 3.2.12); no raw pointer constructor.")) ("Construction" (:code-block "lisp" "Obtain through ADD-TREE-ROOT, APPEND-TREE-ITEM, TREE-ROOT, traversal or selection.") (:p "Direct MAKE-INSTANCE/subclass construction rejects; no native handle adoption. Internal allocation publishes a canonical base view, not a new native item. Use TREE-ITEM-ALIVE-P within the active session before dereferencing retained views."))))
(:entry "api/tree-item-alive-p" :names ("tree-item-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks registry/owner, stronger than native IsOk non-null test. Active session required; stale views never revive on native address reuse." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-alive-p item)")) ("Arguments" (:p "ITEM TREE-ITEM view.")) ("Returns" (:p "T if token and owner live, NIL for deleted/deleting owner.")) ("Description" (:p "Checks registry/owner, stronger than native IsOk non-null test. Active session required; stale views never revive on native address reuse.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "Checked wxTreeItemId/owner registry (wxWidgets 3.2.12)."))))
(:entry "api/tree-item-background" :names ("tree-item-background" "(setf tree-item-background)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native packed0xRRGGBB or NIL; SETF NIL clears explicit colour, port may report effective default." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-background item)")) ("Arguments" (:p "(item); SETF(value item)")) ("Returns" (:p "Native property/copied value or documented receiver/value.")) ("Description" (:p "Read native packed0xRRGGBB or NIL; SETF NIL clears explicit colour, port may report effective default.")) ("Errors and scope" (:p "Main-thread active session; checked live native receivers. Invalid state signals NATIVE-ERROR; Lisp argument/type errors remain conditions. See REPORT-TREE-VIEWS guide for bounds and callback rules.")) ("wxWidgets" (:p "wxTreeCtrl::GetItemBackgroundColour / SetItemBackgroundColour")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-background item) value)") (:p "Use generic SETF with validated arguments; report/tree mutations reject active providers/callbacks and native lifetime violations. ITEM-COUNT SETF is virtual LIST-CONTROL only."))))
(:entry "api/tree-item-bold-p" :names ("tree-item-bold-p" "(setf tree-item-bold-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native bold or set generalized boolean. Checked same-owner item; callback writes defer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-bold-p item)")) ("Arguments" (:p "(item); SETF(value item)")) ("Returns" (:p "Native property/copied value or documented receiver/value.")) ("Description" (:p "Read native bold or set generalized boolean. Checked same-owner item; callback writes defer.")) ("Errors and scope" (:p "Main-thread active session; checked live native receivers. Invalid state signals NATIVE-ERROR; Lisp argument/type errors remain conditions. See REPORT-TREE-VIEWS guide for bounds and callback rules.")) ("wxWidgets" (:p "wxTreeCtrl::IsBold / SetItemBold")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-bold-p item) value)") (:p "Use generic SETF with validated arguments; report/tree mutations reject active providers/callbacks and native lifetime violations. ITEM-COUNT SETF is virtual LIST-CONTROL only."))))
(:entry "api/tree-item-children" :names ("tree-item-children") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Iterate native first-child/next-sibling without exposing cookies or raw IDs." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-children item)")) ("Arguments" (:p "ITEM live TREE-ITEM.")) ("Returns" (:p "Fresh ordered list of canonical child views.")) ("Description" (:p "Iterate native first-child/next-sibling without exposing cookies or raw IDs.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl::GetFirstChild/GetNextSibling (wxWidgets 3.2.12)."))))
(:entry "api/tree-item-expanded-p" :names ("tree-item-expanded-p" "(setf tree-item-expanded-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read actual expansion; an expansion request may have no effect for leaves." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-expanded-p item)")) ("Arguments" (:p "ITEM live TREE-ITEM.")) ("Returns" (:p "Native expansion T/NIL.")) ("Description" (:p "Read actual expansion; an expansion request may have no effect for leaves.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl::IsExpanded/Expand/Collapse (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-expanded-p item) value)") (:p "Generalized boolean request; returns VALUE. Collapse promotes selected descendant to collapsed ancestor. Expansion otherwise preserves selection. Supported selection events blocked and normalized before idle; query actual expansion, especially for leaves."))))
(:entry "api/tree-item-foreground" :names ("tree-item-foreground" "(setf tree-item-foreground)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native packed0xRRGGBB or NIL for invalid colour. SETF NIL resets native colour; port may report effective default RGB afterward." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-foreground item)")) ("Arguments" (:p "(item); SETF(value item)")) ("Returns" (:p "Native property/copied value or documented receiver/value.")) ("Description" (:p "Read native packed0xRRGGBB or NIL for invalid colour. SETF NIL resets native colour; port may report effective default RGB afterward.")) ("Errors and scope" (:p "Main-thread active session; checked live native receivers. Invalid state signals NATIVE-ERROR; Lisp argument/type errors remain conditions. See REPORT-TREE-VIEWS guide for bounds and callback rules.")) ("wxWidgets" (:p "wxTreeCtrl::GetItemTextColour / SetItemTextColour")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-foreground item) value)") (:p "Use generic SETF with validated arguments; report/tree mutations reject active providers/callbacks and native lifetime violations. ITEM-COUNT SETF is virtual LIST-CONTROL only."))))
(:entry "api/tree-item-has-children-p" :names ("tree-item-has-children-p" "(setf tree-item-has-children-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/set native potential-children hint, not child count; no children inserted/deleted. Supports deferred lazy-loading with existing expansion veto." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-has-children-p item)")) ("Arguments" (:p "(item); SETF(value item)")) ("Returns" (:p "Native property/copied value or documented receiver/value.")) ("Description" (:p "Read/set native potential-children hint, not child count; no children inserted/deleted. Supports deferred lazy-loading with existing expansion veto.")) ("Errors and scope" (:p "Main-thread active session; checked live native receivers. Invalid state signals NATIVE-ERROR; Lisp argument/type errors remain conditions. See REPORT-TREE-VIEWS guide for bounds and callback rules.")) ("wxWidgets" (:p "wxTreeCtrl::ItemHasChildren / SetItemHasChildren")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-has-children-p item) value)") (:p "Use generic SETF with validated arguments; report/tree mutations reject active providers/callbacks and native lifetime violations. ITEM-COUNT SETF is virtual LIST-CONTROL only."))))
(:entry "api/tree-item-parent" :names ("tree-item-parent") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native parent identity." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-parent item)")) ("Arguments" (:p "ITEM live TREE-ITEM.")) ("Returns" (:p "Canonical parent view or NIL for root.")) ("Description" (:p "Read native parent identity.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl::GetItemParent (wxWidgets 3.2.12)."))))
(:entry "api/tree-item-text" :names ("tree-item-text" "(setf tree-item-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read current native label, not historical snapshot contents." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-item-text item)")) ("Arguments" (:p "ITEM live TREE-ITEM.")) ("Returns" (:p "Independent UTF-8 Lisp string.")) ("Description" (:p "Read current native label, not historical snapshot contents.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl::GetItemText/SetItemText (wxWidgets 3.2.12).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:tree-item-text item) value)") (:p "String without NUL, empty allowed. Silent native label mutation; returns supplied VALUE. Rejects during same-tree callbacks."))))
(:entry "api/tree-root" :names ("tree-root") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read root identity without raw adoption." :sections (("Syntax" (:code-block "lisp" "(wxlambda:tree-root tree)")) ("Arguments" (:p "TREE control.")) ("Returns" (:p "Canonical root view or NIL if empty.")) ("Description" (:p "Read root identity without raw adoption.")) ("Errors and scope" (:p "Active main-thread session; managed tree-control/items only. Native tokens validate owner/lifetime; no raw IDs/adoption, multiselect, item data, icons, label editing, sorting, drag/drop, virtual models or arbitrary styles. Same-tree writes and nested native loops defer during tree callbacks. wxQt tree construction is explicitly unavailable pending generation-safe asynchronous event translation.")) ("wxWidgets" (:p "wxTreeCtrl::GetRootItem (wxWidgets 3.2.12)."))))
(:entry "api/ui-action" :names ("ui-action") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Separate closure roots live in the session queue, not the immutable ticket. No public token accessor or direct resource constructor." :sections (("Syntax" (:code-block "lisp" "wxlambda:ui-action")) ("Arguments" (:p "Immutable deferred UI action identity returned by DEFER-UI-ACTION.")) ("Returns" (:p "An opaque session-owned ticket; it does not keep its owner native widget alive.")) ("Description" (:p "Separate closure roots live in the session queue, not the immutable ticket. No public token accessor or direct resource constructor.")) ("Errors and scope" (:p "Main-thread active session. FIFO safe idle delivery via RUN/full event polling only; no recursive action delivery during modal loops; nested RUN/pumps reject. Optional weak owner drops stale/pending-destruction work. Errors pause retained following work and re-signal at outer RUN/poll. At most1024 pending actions. See docs/DEFERRED-UI-ACTIONS.md for safe structural exception, cancellation, root release and supported scope.")) ("wxWidgets" (:p "Bridge-specific identity, wxWidgets3.2.12 idle scheduling.")) ("Construction" (:code-block "lisp" "(wxlambda:defer-ui-action function :owner window)") (:p "Obtain only through DEFER-UI-ACTION. No supported direct MAKE-INSTANCE/MAKE-UI-ACTION or subclass resource construction."))))
(:entry "api/ui-action-p" :names ("ui-action-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "May be used outside a session; does not query native liveness." :sections (("Syntax" (:code-block "lisp" "(wxlambda:ui-action-p object)")) ("Arguments" (:p "Any OBJECT.")) ("Returns" (:p "Boolean ticket type predicate, independent of pending/completed state.")) ("Description" (:p "May be used outside a session; does not query native liveness.")) ("Errors and scope" (:p "Immutable structure predicate. No session required.")) ("wxWidgets" (:p "Lisp-only predicate."))))
(:entry "api/ui-action-pending-p" :names ("ui-action-pending-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Checks native owner liveness including pending ancestor deletion; observed expiry removes queued work and releases the Lisp root." :sections (("Syntax" (:code-block "lisp" "(wxlambda:ui-action-pending-p action)")) ("Arguments" (:p "UI-ACTION ticket.")) ("Returns" (:p "T while queued with a live owner, NIL during execution or after delivery/cancel/owner expiry.")) ("Description" (:p "Checks native owner liveness including pending ancestor deletion; observed expiry removes queued work and releases the Lisp root.")) ("Errors and scope" (:p "Main-thread active session. FIFO safe idle delivery via RUN/full event polling only; no recursive action delivery during modal loops; nested RUN/pumps reject. Optional weak owner drops stale/pending-destruction work. Errors pause retained following work and re-signal at outer RUN/poll. At most1024 pending actions. See docs/DEFERRED-UI-ACTIONS.md for safe structural exception, cancellation, root release and supported scope.")) ("wxWidgets" (:p "Bridge queue / wxWeakRef / pending native destruction checks."))))
(:entry "api/ui-timer" :names ("ui-timer") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "The session roots its function separately; native weak ownership does not keep widgets alive." :sections (("Syntax" (:code-block "lisp" "wxlambda:ui-timer")) ("Arguments" (:p "Opaque immutable scheduler timer identity.")) ("Returns" (:p "A ticket, not a native event-handler/wxTimer resource wrapper.")) ("Description" (:p "The session roots its function separately; native weak ownership does not keep widgets alive.")) ("Errors and scope" (:p "Active main-thread session. Interval1..86400000ms, at most256 logical registrations; periodic default/optional one-shot, weak window owner or session lifetime. Coalesced safe-idle delivery under RUN/full polling, excluded from nested modal/native/callback/other safe work. wxUSE_TIMER required; OSX start currently verified only for wxWidgets3.2.12. See docs/UI-TIMERS.md.")) ("wxWidgets" (:p "Private wxTimer adapter plus safe idle scheduler (wxWidgets3.2.12).")) ("Construction" (:code-block "lisp" "(wxlambda:start-ui-timer function milliseconds :owner window :one-shot nil)") (:p "Obtain only through START-UI-TIMER. No public direct ticket/resource constructor, native handle adoption or public Notify override."))))
(:entry "api/ui-timer-active-p" :names ("ui-timer-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Owner/ancestor expiry removes registration/root. Periodic activity persists through a function until cancel/expiry; escaping errors cancel the offending timer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:ui-timer-active-p timer)")) ("Arguments" (:p "UI-TIMER ticket.")) ("Returns" (:p "Boolean logical activity; includes a stopped one-shot awaiting delivery. A one-shot becomes inactive immediately before its function executes; a periodic timer remains active until canceled/expired.")) ("Description" (:p "Owner/ancestor expiry removes registration/root. Periodic activity persists through a function until cancel/expiry; escaping errors cancel the offending timer.")) ("Errors and scope" (:p "Active main-thread session. Interval1..86400000ms, at most256 logical registrations; periodic default/optional one-shot, weak window owner or session lifetime. Coalesced safe-idle delivery under RUN/full polling, excluded from nested modal/native/callback/other safe work. wxUSE_TIMER required; OSX start currently verified only for wxWidgets3.2.12. See docs/UI-TIMERS.md.")) ("wxWidgets" (:p "Bridge registry / wxWeakRef / native pending destruction checks; not a direct IsRunning view."))))
(:entry "api/ui-timer-p" :names ("ui-timer-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Pure Lisp structure predicate; works outside an application session." :sections (("Syntax" (:code-block "lisp" "(wxlambda:ui-timer-p object)")) ("Arguments" (:p "Any OBJECT.")) ("Returns" (:p "Boolean ticket type predicate, independent of active/retired state.")) ("Description" (:p "Pure Lisp structure predicate; works outside an application session.")) ("Errors and scope" (:p "No native/session requirement.")) ("wxWidgets" (:p "Lisp-only predicate."))))
(:entry "api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns. Unbinding destroys the native user-data adapter and releases global association roots, but active dispatch frames and saved snapshots can keep the Lisp value alive." :sections (("Syntax" (:code-block "lisp" "(wxlambda:unbind-event binding)")) ("Arguments" (:p "BINDING is an EVENT-BINDING.")) ("Returns" (:p "T if this active registration was removed; NIL if already unbound or receiver expired.")) ("Description" (:p "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns. Unbinding destroys the native user-data adapter and releases global association roots, but active dispatch frames and saved snapshots can keep the Lisp value alive.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, arbitrary native userData pointers, external handler adoption and worker-thread dispatch remain unbound.")) ("wxWidgets" (:p "wxEvtHandler::Unbind member-method overload, exact receiver/type/ID-range/native binding identity (wxWidgets 3.2.12 baseline)."))))
(:entry "api/unlink-event-handler" :names ("unlink-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only." :sections (("Syntax" (:code-block "lisp" "(wxlambda:unlink-event-handler handler)")) ("Arguments" (:p "HANDLER is a live owned standalone EVENT-HANDLER/subclass.")) ("Returns" (:p "HANDLER, detached and still alive.")) ("Description" (:p "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only.")) ("Errors and scope" (:p "Active main-thread non-dispatch boundary required. RUN/pump/callback use and borrowed window/application sources reject before mutation. Linked callback-time destruction also rejects; outside callbacks native destruction can unlink/splice normally. Attached nodes reject: use POP-EVENT-HANDLER or REMOVE-EVENT-HANDLER to detach from a window first.")) ("wxWidgets" (:p "wxEvtHandler::Unlink for managed standalone chains (wxWidgets 3.2.12 baseline)."))))
(:entry "api/unsplit-window" :names ("unsplit-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Detach/hide selected pane without deletion/reparenting; remaining pane becomes index0. No synthesized UNSPLIT notification." :sections (("Syntax" (:code-block "lisp" "(wxlambda:unsplit-window splitter &key (remove 1))")) ("Arguments" (:p "Two-pane splitter; REMOVE index0/1.")) ("Returns" (:p "Removed hidden live PANEL.")) ("Description" (:p "Detach/hide selected pane without deletion/reparenting; remaining pane becomes index0. No synthesized UNSPLIT notification.")) ("Errors and scope" (:p "Active main-thread GUI session and quiescent structural boundary or safe owner-bound deferred action; callback use rejects. Native-backed SPLITTER-WINDOW and fully initialized direct unsizered PANEL children. Canonical roots precede native sizing/focus work; old/new/attached pane and ancestor lifetime guards apply. Retained hidden panels remain native children and die with parent. No raw adoption, dynamic event/virtual hooks or editor layout abstraction. See docs/AUI-NOTEBOOK.md and docs/SPLITTER.md.")) ("wxWidgets" (:p "wxSplitterWindow::Unsplit, wxWidgets3.2.12."))))
(:entry "api/wake-up-idle" :names ("wake-up-idle") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Wake the native idle system without pumping or invoking callbacks inline. Actual handling occurs at a later native idle opportunity, not a promised immediate time." :sections (("Syntax" (:code-block "lisp" "(wxlambda:wake-up-idle )")) ("Arguments" (:p "None.")) ("Returns" (:p "T after scheduling the native idle wake.")) ("Description" (:p "Wake the native idle system without pumping or invoking callbacks inline. Actual handling occurs at a later native idle opportunity, not a promised immediate time.")) ("Errors and scope" (:p "Active main-thread GUI session required. No worker wake/posting facility, timer, implicit RUN or direct pending/idle pump is added.")) ("wxWidgets" (:p "wxWakeUpIdle, managed GUI-thread mapping (wxWidgets 3.2.12 baseline)."))))
(:entry "api/web-view" :names ("web-view") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Private wxPanel container owns browser initially at about:blank. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and rollback are supported. Queued immutable command snapshots: :web-message text is JSON (including quoted strings); :web-script-result text is JSON on success or an error description on failure, EVENT-INTEGER is1/0 and EVENT-EXTRA-LONG is the request ticket; :web-loaded text is native URL and :web-error text is native error description. BIND-EVENT supports scoped contexts/Skip/propagation but payload SETF rejects. Async delivery occurs through normal GUI polling/RUN, never directly from an Objective-C completion. Native loaded/error events can reflect prior/subframe navigation; no exact per-navigation correlation or veto API." :sections (("Syntax" (:code-block "lisp" "wxlambda:web-view")) ("Arguments" (:p "Required :parent WINDOW; subclass initargs; no initial URL initarg.")) ("Returns" (:p "Native-backed WEB-VIEW WINDOW subtype.")) ("Description" (:p "Private wxPanel container owns browser initially at about:blank. Direct CLOS subclasses/default initargs/native-ready AFTER hooks and rollback are supported. Queued immutable command snapshots: :web-message text is JSON (including quoted strings); :web-script-result text is JSON on success or an error description on failure, EVENT-INTEGER is1/0 and EVENT-EXTRA-LONG is the request ticket; :web-loaded text is native URL and :web-error text is native error description. BIND-EVENT supports scoped contexts/Skip/propagation but payload SETF rejects. Async delivery occurs through normal GUI polling/RUN, never directly from an Objective-C completion. Native loaded/error events can reflect prior/subframe navigation; no exact per-navigation correlation or veto API.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:web-view :parent parent)") (:p "Creates about:blank before exposing user HTML/URL operations. Native child is owned privately."))))
(:entry "api/web-view-busy-p" :names ("web-view-busy-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Native IsBusy state, not a success/failure or script-completion guarantee." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-busy-p view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "Native loading T/NIL.")) ("Description" (:p "Native IsBusy state, not a success/failure or script-completion guarantee.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-can-go-back-p" :names ("web-view-can-go-back-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-can-go-back-p view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "Native history availability T/NIL.")) ("Description" (:p "Reads current native backward/forward history availability; history changes asynchronously.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-can-go-forward-p" :names ("web-view-can-go-forward-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads current native backward/forward history availability; history changes asynchronously." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-can-go-forward-p view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "Native history availability T/NIL.")) ("Description" (:p "Reads current native backward/forward history availability; history changes asynchronously.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-go-back" :names ("web-view-go-back") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-go-back view)")) ("Arguments" (:p "WEB-VIEW with available back history.")) ("Returns" (:p "VIEW.")) ("Description" (:p "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-go-forward" :names ("web-view-go-forward") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-go-forward view)")) ("Arguments" (:p "WEB-VIEW with available forward history.")) ("Returns" (:p "VIEW.")) ("Description" (:p "Requests asynchronous native history navigation. Missing history signals NATIVE-ERROR; callbacks must defer.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-reload" :names ("web-view-reload") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests default cached native reload; no synchronous completion guarantee." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-reload view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "VIEW.")) ("Description" (:p "Requests default cached native reload; no synchronous completion guarantee.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-stop" :names ("web-view-stop") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Requests native load cancellation; late navigation/events/script completions may still arrive. Does not cancel queued script tickets." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-stop view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "VIEW.")) ("Description" (:p "Requests native load cancellation; late navigation/events/script completions may still arrive. Does not cancel queued script tickets.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-title" :names ("web-view-title") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Reads title at call time; may be empty or change asynchronously." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-title view)")) ("Arguments" (:p "WEB-VIEW.")) ("Returns" (:p "Copied native title string.")) ("Description" (:p "Reads title at call time; may be empty or change asynchronously.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime."))))
(:entry "api/web-view-url" :names ("web-view-url" "(setf web-view-url)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read current native URL or request asynchronous navigation. Request return does not imply load completion; current URL may lag requested URL." :sections (("Syntax" (:code-block "lisp" "(wxlambda:web-view-url view)")) ("Arguments" (:p "WEB-VIEW; SETF nonempty NUL-free string, at most8192 UTF-8 bytes. Explicit requests require about:blank or an absolute http/https/file URL.")) ("Returns" (:p "Current native URL string; writer returns supplied string.")) ("Description" (:p "Read current native URL or request asynchronous navigation. Request return does not imply load completion; current URL may lag requested URL.")) ("Errors and scope" (:p "Verified macOS wxWidgets3.2.12 WKWebView backend only. Active GUI thread/session and live WEB-VIEW WINDOW container; private browser child has no public handle. JavaScript enabled for trusted development content, not a security sandbox. Known wx native dialogs/upload/popups/printing suppressed, known permission requests denied; no complete OS WebKit security/permission policy claim. Mutations/scripts reject callbacks and protect receiver/ancestors/native reentry; use deferred actions. No managed handler stacks, native backend adoption, owned/synthetic/cloned web events. See docs/WEB-VIEW.md. Explicit URL/base input accepts absolute http/https with host, absolute file paths, or exact about:blank; whitespace/control characters and malformed percent escapes reject. This input policy is not a universal page navigation/network sandbox. Explicit URL navigation/base-URL inputs support about:blank or absolute http/https/file URLs only; native links, redirects and subresource loads are not a complete navigation sandbox. JSON script messages can originate from all frames and origins; receipt does not authenticate the sender or authorize an action. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWebView/WKWebView bounded adapter, wxWidgets3.2.12; system WebKit runtime.")) ("SETF" (:code-block "lisp" "(setf (wxlambda:web-view-url view) \"https://example.com/\")") (:p "Requests navigation after input validation; callbacks must defer. No synchronous page-completion promise. The initial request scheme check does not police native links, redirects or subresources."))))
(:entry "api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :sections (("Syntax" (:code-block "lisp" "wxlambda:window")) ("Arguments" (:p "Superclass: WXLAMBDA:EVENT-HANDLER. WINDOW is abstract.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks. GRID and WEB-VIEW are concrete WINDOW receivers for the implemented generic layout, geometry, visibility, enabled state and lifetime operations. Their private composite scroll/browser event handling forbids managed handler-stack access/edits; their own mutation and callback guards remain in force. STYLED-TEXT-CONTROL and AUI-NOTEBOOK are concrete WINDOW receivers for implemented generic state/geometry/lifetime protocols. AUI retains private manager handlers and page layout; managed stack protocols reject AUI. LIST-CONTROL inherits supported WINDOW operations; owner/ancestor writes defer during native virtual providers.")) ("wxWidgets" (:p "wxWindow (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:frame)") (:p "WINDOW is abstract. Instantiate a concrete class or its subclass; mixins are allowed, but a class must represent exactly one native widget kind."))))
(:entry "api/window-client-size" :names ("window-client-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query native GetClientSize." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-client-size object)")) ("Arguments" (:p "window")) ("Returns" (:p "(width height) in native logical units.")) ("Description" (:p "Query native GetClientSize.")) ("Errors and scope" (:p "Active GUI/main-thread session and checked native lifetime. Image/bitmap values are session-owned and explicitly disposable; no raw pointers/finalizers. Native reads are callback-safe; writes, file IO, allocation/conversion, disposal and BITMAP-VALUE copying reject callback execution. Copied channels,256 resources/64Mi pixel aggregate,1..4096 pixel axes; PNG24 bytes..64MiB encoded. Native bitmap alpha/DPI conversion can change pixels. Invalid bounds/types/stale handles and native failures signal errors. See docs/IMAGES-DISPLAYS.md.")) ("wxWidgets" (:p "wxImage/wxBitmap/wxStaticBitmap/wxDisplay/wxWindow, selected native methods in wxWidgets3.2.12."))))
(:entry "api/window-content-scale-factor" :names ("window-content-scale-factor") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Invoke native GetContentScaleFactor; do not confuse native logical coordinates, DIP and backing pixels." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-content-scale-factor object)")) ("Arguments" (:p "window")) ("Returns" (:p "Native double-float scale.")) ("Description" (:p "Invoke native GetContentScaleFactor; do not confuse native logical coordinates, DIP and backing pixels.")) ("Errors and scope" (:p "Active GUI/main-thread session and checked native lifetime. Image/bitmap values are session-owned and explicitly disposable; no raw pointers/finalizers. Native reads are callback-safe; writes, file IO, allocation/conversion, disposal and BITMAP-VALUE copying reject callback execution. Copied channels,256 resources/64Mi pixel aggregate,1..4096 pixel axes; PNG24 bytes..64MiB encoded. Native bitmap alpha/DPI conversion can change pixels. Invalid bounds/types/stale handles and native failures signal errors. See docs/IMAGES-DISPLAYS.md.")) ("wxWidgets" (:p "wxImage/wxBitmap/wxStaticBitmap/wxDisplay/wxWindow, selected native methods in wxWidgets3.2.12."))))
(:entry "api/window-display-index" :names ("window-display-index") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query native GetFromWindow; NIL when native lookup finds no display." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-display-index object)")) ("Arguments" (:p "window")) ("Returns" (:p "A zero-based display index or NIL.")) ("Description" (:p "Query native GetFromWindow; NIL when native lookup finds no display.")) ("Errors and scope" (:p "Active GUI/main-thread session and checked native lifetime. Image/bitmap values are session-owned and explicitly disposable; no raw pointers/finalizers. Native reads are callback-safe; writes, file IO, allocation/conversion, disposal and BITMAP-VALUE copying reject callback execution. Copied channels,256 resources/64Mi pixel aggregate,1..4096 pixel axes; PNG24 bytes..64MiB encoded. Native bitmap alpha/DPI conversion can change pixels. Invalid bounds/types/stale handles and native failures signal errors. See docs/IMAGES-DISPLAYS.md.")) ("wxWidgets" (:p "wxImage/wxBitmap/wxStaticBitmap/wxDisplay/wxWindow, selected native methods in wxWidgets3.2.12."))))
(:entry "api/window-event-handler" :names ("window-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-event-handler window)")) ("Arguments" (:p "WINDOW is a valid bridge-managed window/subclass.")) ("Returns" (:p "Canonical top pushed handler wrapper, or the identical WINDOW when no managed handler is pushed.")) ("Description" (:p "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer.")) ("Errors and scope" (:p "Active main-thread session; reads allowed in callbacks while window is valid/non-deleting. No arbitrary SetEventHandler, external native stack adoption or raw pointer access. SCROLLED-PANEL rejects because wxWidgets owns a private scroll-helper handler; no helper adoption/removal. Ordinary bindings still work. See docs/SCROLLING-PANELS.md. GRID and WEB-VIEW also reject this managed stack-aware protocol because their native composite scroll/browser handlers remain private. Ordinary event bindings and generic receiver processing retain their documented scope. See docs/GRID.md and docs/WEB-VIEW.md. AUI-NOTEBOOK also rejects this managed stack-aware protocol because native AUI manager/tab handlers remain private.")) ("wxWidgets" (:p "wxWindow::GetEventHandler, managed stack only (wxWidgets 3.2.12 baseline)."))))
(:entry "api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-name window)")) ("Arguments" (:p "WINDOW is any live bound window or control.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetName (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:window-name window) new-value)") (:p "Copy the logical name, preserving Unicode, empty strings and embedded NULs. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-position window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: X and Y.")) ("Description" (:p "Query position relative to parent; frame coordinates are screen-relative.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetPosition"))))
(:entry "api/window-process-idle-p" :names ("window-process-idle-p" "(setf window-process-idle-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read/write only the window own idle opt-in extra-style bit while preserving unrelated bits. It is not effective delivery eligibility, ancestor visibility, global mode or a command to run idle callbacks." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-process-idle-p window)")) ("Arguments" (:p "WINDOW is a live managed window. SETF VALUE is a generalized boolean.")) ("Returns" (:p "Own wxWS_EX_PROCESS_IDLE bit as T/NIL; SETF returns VALUE.")) ("Description" (:p "Read/write only the window own idle opt-in extra-style bit while preserving unrelated bits. It is not effective delivery eligibility, ancestor visibility, global mode or a command to run idle callbacks.")) ("Errors and scope" (:p "Active main-thread GUI session and valid non-deleting window required. :SPECIFIED uses this bit for native opt-in; :ALL/visibility/native rules also affect delivery. No raw arbitrary extra-style setter or synthetic delivery filter.")) ("wxWidgets" (:p "wxWindow::GetExtraStyle / SetExtraStyle for wxWS_EX_PROCESS_IDLE only (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:window-process-idle-p window) value)") (:p "Toggle only the own idle extra-style bit, preserve other bits and return VALUE. Does not pump, change global idle mode or guarantee delivery."))))
(:entry "api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-size window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: WIDTH and HEIGHT.")) ("Description" (:p "Query outer window dimensions in wxWidgets coordinates.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetSize"))))
(:entry "api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-application () &body body)")) ("Arguments" (:p "Empty options list, followed by BODY forms.")) ("Returns" (:p "The values of the last BODY form.")) ("Description" (:p "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process.")) ("wxWidgets" (:p "wxEntryStart / wxEntryCleanup"))))
(:entry "api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-repl-application (&key (input '*standard-input*)
                                     (output '*standard-output*)
                                     (on-error :debug)) &body body)")) ("Arguments" (:p "Options INPUT, OUTPUT and ON-ERROR (:DEBUG or :REPORT), then BODY setup forms.")) ("Returns" (:p "NIL when the cooperative REPL exits.")) ("Description" (:p "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events.")) ("Errors and scope" (:p "Main-thread, one-session contract. Setup conditions propagate. :DEBUG preserves restarts; :REPORT prints recovery diagnostics.")) ("wxWidgets" (:p "wxApp event polling; SBCL/CCL terminal integration."))))
(:entry "guide/README.md" :names ("README.md" "README") :kind :guide :kind-name "Guide" :summary "README.md" :sections (("Guide" (:heading 1 "wxlambda") (:p "Common Lisp bindings for wxWidgets, using CFFI and a small C++ bridge with a versioned C ABI. The goal is broad GUI coverage with selective depth: common desktop workflows, reliable lifetime/event contracts and Lisp-friendly APIs. The current implementation is still an early GUI binding; exhaustive native wxWidgets parity is not the delivery objective.") (:p "The automated local macOS MVP covers persistent form/editor, searchable record manager and timer-driven drawing/monitoring workflows. See the finite " (:ref "guide/docs/MVP-ACCEPTANCE.md" "acceptance scope and evidence") ". Further widgets and platform validation are application-driven extensions.") (:p "The GUI surface includes everyday input controls, notebook/list/tree navigation, menus/toolbars/status bars, keyboard actions, guarded dialogs, clipboard text, deferred actions, timers, scrolling, retained drawing and activity feedback. The event foundation includes immutable snapshots, scoped contexts, owned events, pending delivery, managed handler chains/window stacks and rooted Lisp data. Native OS alerts/panels remain unbound.") (:p "The requested " (:ref "guide/docs/GRID.md" "grid") " extension adds editable string cells and labels. The " (:ref "guide/docs/WEB-VIEW.md" "interactive WebView") " extension adds a macOS WKWebView preview, asynchronous JavaScript and JSON messaging for editor-driven development. The " (:ref "guide/docs/THREAD-EVENTS.md" "thread event") " extension copies worker results to existing GUI receivers without running their callbacks on worker threads.") (:p "Native pointers never escape the bridge. Construction, callbacks and lifetime checks remain on the main GUI thread. " (:code "queue-thread-event") " is the explicit worker-safe posting exception. There is one GUI session per process; restart Lisp for a new native session. Control-specific ON-* registrations should be unbound before window destruction; generic binding cleanup follows native lifetime/weak invalidation rules.") (:p "The " (:ref "guide/docs/CLOS-API.md" "CLOS API") " provides subclass initargs/defaults/AFTER hooks, thin :CLASS-validating factories and canonical generic SETF. The current public API has 527 exports, 435 named generic operations and 122 generic property writers. The package nickname " (:code "WX") " lets programs use " (:code "wx:make-frame") " and other " (:code "wx:") " names; Quicklisp/ASDF still loads the system as " (:code "\"wxlambda\"") ". Styled text, native input, dynamic AUI tabs and splitter operations are documented in the " (:ref "guide/docs/KRYPTONEDIT-COVERAGE.md" "KryptonEdit coverage survey") ". Native virtual callbacks are limited to the audited virtual-list text provider; Lisp subclassing otherwise does not create native C++ virtual overrides. These counts describe public interfaces, not full native class coverage or completed platform validation.") (:p "Progress controls support range/value properties, orientation and indeterminate pulsing; see " (:ref "guide/docs/GAUGE.md" "the gauge guide") " and runnable " (:ref "example/examples/gauge.lisp" "example") ".") (:p "The " (:ref "guide/docs/APPLICATION-EVENTS.md" "application event guide") " explains native main-loop and pending-event queries, explicit queued-event dispatch and the callback reentrancy boundary.") (:p "The " (:ref "guide/docs/EVENT-HANDLERS.md" "event-handler foundation") " adds session-owned standalone handlers, borrowed window identities, liveness checks and a generic event-processing flag. Independent multi-event/ID observer bindings now cover the four current command kinds; see " (:ref "guide/docs/EVENT-BINDINGS.md" "binding and queue scope") ". Optional " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") " now control native Skip and propagation while snapshots stay immutable. The " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") " adds scoped veto, immutable close flags and frame close requests. " (:code "event-type") " replaces the command-only lookup name. Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "command/notify types") " now support copied payloads and synchronous validation before applying a change. The borrowed application-handler view supports session bindings; real OS session delivery remains unverified. See " (:ref "guide/docs/IDLE-EVENTS.md" "idle events") " for bounded background work. Native notify subclasses remain an inventory gap.") (:heading 2 "Documentation and examples") (:p "The " (:ref "guide/docs/DOCSET.md" "Cadre docset") " includes the public API reference, project guides and example sources in one searchable artifact under " (:code "docs/docset/") ". Use " (:code "python3 tools/docset.py build") ", " (:code "check") ", or " (:code "install") "; the docset library checkout is a build-tool dependency, separate from the GUI runtime. Read " (:ref "guide/docs/WINDOW-STATE.md" "window state") " for the first coverage implementation slice: " (:code "show-window") " now accepts an optional boolean for showing/hiding, while " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " query/control visibility and input. The runnable " (:ref "example/examples/window-state.lisp" "window-state example") " demonstrates these operations through button callbacks. " (:ref "guide/docs/WINDOW-METADATA.md" "Window names and frame titles") " use " (:code "window-name") " and " (:code "frame-title") " with their generic " (:code "setf") " writers, with a " (:ref "example/examples/window-metadata.lisp" "metadata callback example") " and copied Unicode string results.") (:heading 2 "Build") (:p "Requirements: a C++17 compiler, CMake 3.16+, wxWidgets 3.2+, Common Lisp, ASDF, and CFFI. Install CFFI using your preferred dependency manager, for example " (:code "(ql:quickload :cffi)") " with Quicklisp.") (:p "On macOS with Homebrew:") (:code-block "sh" "brew install cmake wxwidgets@3.2
cmake -S . -B build \\
  -DwxWidgets_CONFIG_EXECUTABLE=\"$(brew --prefix wxwidgets@3.2)/bin/wx-config-3.2\"
cmake --build build") (:p "On Linux with wxWidgets development packages and " (:code "wx-config") " on PATH:") (:code-block "sh" "cmake -S . -B build
cmake --build build") (:p "Windows uses the same CMake project. Supply a wxWidgets installation compatible with your compiler using CMake's FindwxWidgets settings. Multi-configuration builds may put " (:code "wxlambda.dll") " under " (:code "build/Release/") "; load it explicitly before starting the application with " (:code "(wxlambda:load-native-library #P\"C:/path/to/wxlambda.dll\")") ". Dependent wxWidgets DLLs must also be discoverable by the OS loader.") (:p "The bridge normally loads from " (:code "build/") ", then falls back to the system library search path. The Lisp/native ABI version (currently 34) is checked on load; rebuild the bridge after updating the bindings. Installing the bridge with CMake does not install the ASDF system.") (:heading 2 "Run") (:p "From this directory, assuming Quicklisp is installed in " (:code "~/quicklisp") ":") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Or with Clozure CL:") (:code-block "sh" "ccl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Click the button to update the text; close the window to return to Lisp. Run each example in a fresh process: this prototype supports one application session per process.") (:p "For an existing image, load " (:code "wxlambda.asd") ", then " (:code "(asdf:load-system \"wxlambda\")") ". The basic API is:") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Hello\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hello, λ\"))
         (button (wxlambda:make-button panel :label \"Click\")))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda () (setf (wxlambda:text text) \"Hello from Lisp!\")))
    (wxlambda:show-window frame)
    (wxlambda:run)))") (:heading 2 "Labels and checkboxes") (:p (:code "make-label") " creates non-editable static text. " (:code "label-text") " returns an independent Lisp string and " (:code "(setf label-text)") " updates it. These accessors take a label created by " (:code "make-label") "; raw strings use wxWidgets' label/mnemonic syntax. After changing a label's preferred size, call " (:code "layout-window") " on its parent to reflow the layout.") (:p (:code "make-checkbox") " creates a two-state checkbox, unchecked by default. " (:code "checked-p") " returns " (:code "t") " or " (:code "nil") ". The " (:code ":checked") " constructor keyword and " (:code "(setf checked-p)") " accept generalized booleans: " (:code "nil") " means unchecked, any other value means checked. " (:code "(setf checked-p)") " returns the supplied value; the predicate reads it normalized to " (:code "t") " or " (:code "nil") "; a handler may change the live state again before the setter returns.") (:code-block "lisp" "(let ((caption (wxlambda:make-label panel :label \"Preferences\"))
      (box (wxlambda:make-checkbox panel :label \"Include a greeting\" :checked t)))
  (wxlambda:add-child panel caption)
  (wxlambda:add-child panel box :expand nil)
  (wxlambda:on-toggle box
    (lambda (event)
      (setf (wxlambda:label-text caption) (if (wxlambda:event-checked-p event) \"Greeting enabled\" \"Greeting disabled\"))
      (wxlambda:layout-window panel)))
  (setf (wxlambda:checked-p box) nil)            ; silent
  (setf (wxlambda:checked-p box :notify t) t)    ; synchronous toggle event
  (wxlambda:off-toggle box))") (:p (:code "on-toggle") " takes a function accepting one event, with kind " (:code ":toggle") ", the original checkbox as its source, and a boolean " (:code "event-checked-p") " snapshot. Native user interaction emits events. " (:code "(setf checked-p)") " is silent by default; " (:code ":notify t") " emits one synchronous event, including when the value is unchanged. The snapshot survives nested changes to the control and later window destruction. Replacing a handler releases its registered closure; " (:code "off-toggle") " releases it and is idempotent for a live checkbox, including from inside the handler. Setter errors follow the same recoverable boundary as text-change handlers.") (:p "Run " (:ref "example/examples/form.lisp" "examples/form.lisp") " for a form using labels, text input, a checkbox, a greeting-style dropdown, row/column layouts, and submit/reopen buttons:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp") (:p "The reusable application lives in " (:code "examples/form-app.lisp") ". For live development, load that file and evaluate " (:code "(wxlambda-form:start-live)") " from a terminal REPL:") (:code-block "lisp" "(load \"examples/form-app.lisp\")
(wxlambda-form:start-live)
;; Evaluate these inside the application REPL:
(setf (wxlambda:text wxlambda-form:*name* :notify t) \"Ada λ\")
(setf (wxlambda:selection wxlambda-form:*style* :notify t) 1)
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action
  (lambda () (setf (wxlambda:label-text wxlambda-form:*status*) \"Custom submit\")))
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action) ; restore the named SUBMIT-FORM action
(wxlambda-form:close-window)      ; unbind every handler before destruction
(wxlambda-form:open-window)       ; recreate with retained input values
(wxlambda:stop)") (:p "The “Reopen form” button performs the same explicit unbinding and recreation within a GUI callback. The default submit action resolves " (:code "submit-form") " by name, so redefining that function also takes effect live. The application uses public bindings throughout; no new native operations were needed. It retains the one-session-per-process limit. If the user closes the native frame before explicit unbinding, its stale handles cannot release the registered closures; those remain rooted until session cleanup. Normal startup exits with the last window; the application REPL remains available after closing it.") (:heading 2 "Layout") (:p "Use " (:code "make-column") " for vertical layout and " (:code "make-row") " for horizontal layout. A window has one sizer. To nest orientations, create a child panel, give it its own row or column, then add that panel to its parent's layout. " (:code "add-child") " requires the child's native parent to be the layout's window.") (:code-block "lisp" "(wxlambda:make-row panel)
(wxlambda:add-child panel text :proportion 1 :border 0)
(wxlambda:add-spacer panel 12)
(wxlambda:add-child panel button :border 0 :expand nil :align :center)") (:p (:code "add-child") " accepts these layout options:") (:table :header (("Keyword") ("Default") ("Meaning")) :rows ((((:code ":proportion")) ((:code "0")) ("Nonnegative weight along the layout axis; zero keeps the item's preferred extent")) (((:code ":border")) ((:code "8")) ("Nonnegative spacing on each of the four sides")) (((:code ":expand")) ((:code "t")) ("Fill the available space across the layout axis")) (((:code ":align")) ((:code ":start")) ("With " (:code ":expand nil") ", place at " (:code ":start") ", " (:code ":center") ", or " (:code ":end") " across the axis")))) (:p "In a row, alignment controls vertical placement; in a column, it controls horizontal placement. " (:code ":expand t") " with " (:code ":align :center") " or " (:code ":end") " is rejected. Proportions and stretch allocation remain subject to native minimum sizes. The defaults preserve the original " (:code "add-child") " behavior.") (:p (:code "(add-spacer panel size)") " inserts fixed space along the layout axis. " (:code "(add-stretch panel :proportion 1)") " inserts flexible space with a positive weight, sharing available room with other proportional items. Both return the panel. Invalid sizes, proportions, parent relationships, and duplicate insertions signal errors before the sizer is modified.") (:p (:code "layout-window") " recomputes a window's layout. " (:code "add-child") ", " (:code "add-spacer") ", and " (:code "add-stretch") " also lay out their parent immediately. Layouts participate in wxWidgets' normal resize handling. " (:code "window-position") " returns X and Y as two values, relative to the parent's client area (screen coordinates for top-level frames). " (:code "window-size") " returns outer width and height as two values. Dimensions and spacing use wxWidgets window coordinates, not framebuffer pixel counts; native minimum sizes and display scaling remain wxWidgets' responsibility.") (:p "Run " (:ref "example/examples/layout.lisp" "examples/layout.lisp") " to try nested rows and columns, a text field that takes the available width, and a footer with flexible spacing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp") (:heading 2 "Events") (:p "Existing " (:code "(on-click button (lambda () ...))") " handlers still take no arguments. Opt into an event argument with " (:code ":with-event t") ":") (:code-block "lisp" "(wxlambda:on-click button
  (lambda (event)
    (format t \"Clicked ~S~%\" (wxlambda:event-source event)))
  :with-event t)

(wxlambda:on-text-change text
  (lambda (event)
    (format t \"New text: ~A~%\" (wxlambda:event-text event))))

(setf (wxlambda:text text) \"Silent update\")
(setf (wxlambda:text text :notify t) \"Notify the handler\")
(wxlambda:off-text-change text)") (:p (:code "event-p") " recognizes event snapshots. Their read-only slots are exposed through:") (:table :header (("Accessor") ("Click event") ("Text-change event") ("Toggle event")) :rows ((((:code "event-kind")) ((:code ":click")) ((:code ":text-change")) ((:code ":toggle"))) (((:code "event-source")) ("Original button") ("Original text control") ("Original checkbox")) (((:code "event-text")) ((:code "nil")) ("Copied string, including " (:code "\"\"") " for empty text") ((:code "nil"))) (((:code "event-checked-p")) ((:code "nil")) ((:code "nil")) ("Copied " (:code "t") " or " (:code "nil") " state")))) (:p "Text-change handlers always take one event argument. Typing into the native text field emits events. " (:code "(setf text)") " stays silent by default to avoid update loops; " (:code ":notify t") " uses wxWidgets' notifying setter and may call the handler immediately, before the setter returns. Handlers can therefore run before " (:code "run") " starts.") (:p "The text payload describes that event, rather than a later read of the control. It remains valid across nested updates, handler unbinding, and window destruction. Event text is an independent Lisp string; callers can retain or modify their copy. The source wrapper remains available, but native operations on it fail after its window is destroyed. Event slots do not expose any borrowed native pointers.") (:p "Use " (:code "off-click") ", " (:code "off-text-change") ", or " (:code "off-toggle") " to release a handler. Registering again replaces and releases the previous closure. Both removals are idempotent for a live control of the correct type and may be called inside the handler itself.") (:heading 2 "Dropdown choices") (:code-block "lisp" "(let ((choice (wxlambda:make-choice panel
                :items '(\"Small\" \"Medium\" \"Large λ\") :selection 1)))
  (wxlambda:on-selection choice
    (lambda (event)
      (format t \"Selected index: ~S~%\" (wxlambda:event-selection event))))
  (setf (wxlambda:selection choice) 2)           ; silent
  (setf (wxlambda:selection choice :notify t) 0) ; synchronous notification
  (wxlambda:selection choice))               ; => 0") (:p (:code "make-choice") " copies a list of strings in the supplied order. Items are fixed for the life of the control. Selection indices are zero-based; " (:code "nil") " means no selection and is the default, including for a nonempty list. Empty lists are supported. An out-of-range index signals an error without changing the selection. The dropdown participates in layouts and parent ownership like other controls.") (:p "User selection and " (:code "(setf selection)") " with " (:code ":notify t") " deliver one " (:code ":selection") " event. " (:code "event-selection") " is an immutable index snapshot (or " (:code "nil") "), independent of later selection changes. Other event kinds have a " (:code "nil") " selection slot. " (:code "(setf selection)") " returns the requested index even if a handler changes it again; explicit notification also fires for an unchanged index. Handler errors are re-signaled at the setter boundary. " (:code "on-selection") " replaces the previous handler; " (:code "off-selection") " releases it and is idempotent for a live choice, including inside its callback. As with other strings, embedded NUL characters are unsupported.") (:heading 2 "Lifecycle contract") (:list (:item (:p (:code "with-application") " initializes the toolkit and cleans up on normal return or a"))) (:p "Lisp error. Call " (:code "run") " explicitly to enter the blocking GUI loop.") (:list (:item (:p "GUI calls must run on the main thread. On macOS, the SBCL command-line main"))) (:p "thread works directly. CCL uses a small implementation adapter to execute the application body on its initial process, synchronously. Caller thread dynamic bindings are not transferred by that adapter; establish needed bindings inside the application body. Starting from an SBCL worker/SLIME thread is rejected.") (:list (:item (:p "Native GUI code assumes masked floating-point traps. The SBCL adapter masks"))) (:p "them for the application session and restores the caller's state afterward.") (:list (:item (:p "Parents own their children. Closing/destroying a parent invalidates child"))) (:p "handles. Lisp wrapper objects may survive, but subsequent operations signal " (:code "native-error") ". Destruction can be deferred by wxWidgets until event processing.") (:list (:item (:p "Click handlers take zero arguments by default, or one event with"))) (:p (:code ":with-event t") ". Text-change and toggle handlers take one event. Handler replacement or explicit unbinding releases the registered closure. Queued clicks use the handler present when they are dispatched, so unbinding suppresses queued clicks and rebinding redirects them to the new handler. Closures for destroyed controls remain rooted until session cleanup unless explicitly unbound before destruction. There are no GC-driven native destructors.") (:list (:item (:p "Errors in synchronous text-change or toggle callbacks are saved until the notifying"))) (:p "setter returns to Lisp, then re-signaled so its caller can handle them without stopping the loop. Errors escaping the outer event callback request a loop stop and are re-signaled after the event loop returns. This also covers notifying setters called before the event loop starts. Errors escaping the application body trigger cleanup. Do not use " (:code "throw") ", " (:code "return-from") ", or other nonlocal exits across a callback's foreign boundary. Handle expected conditions inside the handler or around the notifying setter.") (:list (:item (:p (:code "text") " returns an independent Lisp string containing the current text;"))) (:p (:code "(setf text)") " updates it. Both use UTF-8. The native " (:code "wxl_get_text") " buffer is borrowed until the next getter call on that thread and is copied immediately by Lisp. A null pointer reports failure; an empty string is a successful empty value. Strings containing embedded NUL characters are not supported by this interface.") (:list (:item (:p "One GUI session per process; no application restart, background-thread GUI"))) (:p "scheduling, or virtual-method overrides yet.") (:heading 2 "REPL development") (:p "From a main-thread terminal Lisp REPL, initialize an application and enter its cooperative REPL (do not call " (:code "run") " in the setup body):") (:code-block "lisp" "(defvar *frame*)
(defvar *text*)
(wxlambda:with-repl-application ()
  (setf *frame* (wxlambda:make-frame :title \"Live development\")
        *text* (wxlambda:make-text *frame* :value \"Edit me\"))
  (wxlambda:show-window *frame*))") (:p "Then evaluate " (:code "(setf (wxlambda:text *text*) \"Updated live\")") ", redefine functions used by callbacks, or replace handlers without closing the application. Evaluate " (:code "(wxlambda:stop)") " or send EOF to leave and clean up. Closing the last window keeps this REPL available so you can create another frame in the same session. " (:code "run") " signals an error inside this REPL because events are already being processed. Errors enter the host Lisp debugger by default (" (:code ":on-error :debug") "). Evaluation conditions reach it before unwinding, preserving their local restarts. Choose " (:code "wxlambda:return-to-application-repl") " to abandon the current operation and keep the session, or use an available evaluation restart to resume the form. Debugger I/O uses the host's " (:code "*debug-io*") "; " (:code ":input") " and " (:code ":output") " configure only application REPL I/O. Setup-body errors propagate to the caller and clean up the session.") (:p "For scripts or a host with debugging disabled, use " (:code "(wxlambda:with-repl-application (:on-error :report) ...)") ". This prints the condition type/message and up to 20 backtrace frames on SBCL/CCL before abandoning the operation and continuing. Other Lisps report that a backtrace is unavailable; they are not validated platforms. The debugger policy respects the host's debugger hooks and batch-mode restrictions; it does not override them.") (:p "Callback errors are delivered to this policy only after returning safely from the native callback. Their original condition is preserved, but callback-local restarts and callback stack frames have already unwound. Debugger backtraces for these errors show their Lisp delivery boundary. This small REPL prints all returned values; it does not provide the host REPL's history variables or editor integration. Optional " (:code ":input") " and " (:code ":output") " streams default to standard I/O.") (:p "Events are pumped while waiting for input. Incomplete forms, long evaluations, and debugger stops pause GUI processing. " (:code "process-events") " is rejected while the application REPL's debugger is active; queued events resume after recovery. During long evaluations outside the debugger, call " (:code "process-events") " explicitly when useful. The main-thread requirements above still apply. Editor REPLs such as SLIME and SLY are unsupported by this helper; use a terminal Lisp REPL. In particular, SBCL worker-thread startup is rejected. After leaving, start a fresh Lisp process for another session.") (:p "For a complete live-development example, load " (:code "examples/live.lisp") " and call " (:code "(wxlambda-live:start)") " from a terminal REPL. While it runs, try:") (:code-block "lisp" "(setf (wxlambda:text wxlambda-live:*text*) \"Changed live\")
(defun wxlambda-live:clicked ()
  (setf (wxlambda:text wxlambda-live:*text*) \"New callback implementation\"))
(wxlambda:queue-click wxlambda-live:*button*)
(wxlambda-live:close-window) ; explicitly unbinds before destroying the frame
(wxlambda-live:open-window)  ; another frame, within the same session
(wxlambda:stop)") (:p "The registered callback resolves " (:code "clicked") " on each invocation, so redefining it takes effect without replacing the handler. " (:code "close-window") " releases the handler before destroying its controls. If the user has already closed the native window, its handles are stale and that handler remains rooted until session cleanup. Prefer " (:code "close-window") " during repeated development cycles.") (:p "Editor integration is explicitly deferred for the first release. Local Swank 2.32 wire probes on Apple Silicon macOS found:") (:table :header (("Probe") ("Observed execution")) :rows ((("SBCL 2.6.9, " (:code "nil") " / " (:code ":fd-handler") " styles") ("Evaluation, application body, and callback on the launch thread")) (("SBCL 2.6.9, " (:code ":spawn") " control") ("Worker GUI startup rejected by the native main-thread check")) (("CCL 1.13, " (:code ":spawn")) ("Caller on worker; application body and callback on initial process; caller dynamic binding absent")))) (:p "These probes execute one RPC containing a complete GUI session. They do not demonstrate an editor workflow with a persistent session, GUI responsiveness between requests, evaluation interruption, or debugger transport. The terminal application REPL is the first-release workflow. No editor adapter or background scheduler is selected; their ordering, values, conditions, shutdown, and reentrancy contracts must be established before future implementation.") (:p "To reproduce these optional experiments with an existing Quicklisp installation containing Swank, run:") (:code-block "sh" "python3 tests/editor-probe.py nil sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :fd-handler sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "These are optional local experiments using Swank internals and loopback sockets, separate from pinned CI dependencies. " (:code ":spawn") " probes use a persistent listener to keep Swank's accept loop off the launching thread. Their process and listener are shut down after the request. They are not supported editor configurations.") (:p "The bridge catches native exceptions at exported operation boundaries and exposes error text through " (:code "wxl_last_error") ". Its text is borrowed until the next bridge operation on the same thread. See " (:code "native/wxlambda.h") " for the C interface.") (:heading 2 "Standalone application (macOS SBCL)") (:p "The form has a standalone packaging recipe, locally verified on Apple Silicon macOS with SBCL 2.6.9. It uses " (:link "https://www.sbcl.org/manual/index.html#Saving-a-Core-Image" "SBCL's saved-core support") " and ships its own runtime. Python, Quicklisp, Lisp sources, and a system SBCL installation are not needed to run the result.") (:p "Build the native bridge first using the instructions above. Packaging also requires Python 3 and the macOS command-line developer tools (" (:code "otool") ", " (:code "lipo") ", " (:code "install_name_tool") ", and " (:code "codesign") "):") (:code-block "sh" "python3 ci/fetch-deps.py
python3 packaging/build-form.py
python3 tests/package.py --report evidence/packaging/my-run
./dist/wxlambda-form/wxlambda-form") (:p "The builder refuses to overwrite an existing output directory. Use " (:code "--output /absolute/path/to/a/new-package") " for another build; the verifier takes that directory as its positional argument. Its " (:code "--report") " directory must also be new. " (:code "--sbcl /path/to/sbcl") " and " (:code "--bridge /path/to/libwxlambda.dylib") " select build inputs explicitly. The recipe is repeatable, not a promise of byte-identical cores or locked native package versions. " (:code "manifest.json") " records SBCL's version and source/staged native-file hashes to identify the inputs and results.") (:p "Copy the entire output directory to another location and run its " (:code "wxlambda-form") " launcher from any working directory. " (:code "--repl") " selects the terminal application REPL; " (:code "--self-test") " exercises queued callbacks, Unicode values, window recreation, and clean exit automatically. Each launch is a fresh process and one GUI session. The package contains:") (:code-block "text" "wxlambda-form        shell launcher
runtime/sbcl        copied SBCL runtime
app.core            saved application and Lisp dependencies
lib/*.dylib         bridge and recursive non-system native dependencies
manifest.json       versions, origins, and hashes
licenses/           available installed native/runtime notices") (:p "No wxWidgets application or native bridge is initialized before saving. The delivered image has no Quicklisp package or registered wxlambda ASDF system. At startup it loads the bridge relative to the running packaged runtime using the public explicit-path loader, which no longer consults ASDF for that path. The staged native load commands use " (:code "@loader_path") "; this includes SBCL's own dependencies, such as zstd, and wxWidgets' image-library dependencies. System frameworks remain provided by macOS. Modified native files receive ad-hoc signatures. This is a command-line package, not a notarized Finder " (:code ".app") ".") (:p (:code "tests/package.py") " copies the package to a temporary path containing spaces, uses a different working directory and empty HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads with " (:code "sandbox-exec") ". A denied-read control verifies that isolation is active. Both the GUI self-test and packaged REPL pass there; removing either the staged bridge or wxWidgets core must report the expected load failure instead of falling back to development libraries. The test retains its manifest, sandbox profile, logs, and summary. Local evidence is in " (:code "evidence/packaging/macos-sbcl-isolated/") ".") (:p "The recipe requires matching macOS architectures and was tested only on this Apple Silicon host. Linux/Windows packaging is not implemented; Intel macOS, other macOS versions, and distribution/signing behavior on another machine are not validated. These local packaging results do not close Phase 3's hosted platform checks. Release preparation remains open.") (:heading 2 "Verification") (:p "These tests briefly open real windows, queue a button event, then exit. They need an interactive graphical session (or a suitable display server on Linux). The 26 scenarios each run in a fresh process with a 30-second timeout: The window-state scenario exercises the documented example, native changed-state results, ancestor semantics and stale/inactive handles. The window-metadata scenario exercises its callback example, Unicode/empty/NUL names, copied-string lifetime, title receiver checks and invalid/stale/inactive use. The CLOS scenario checks public classes, generic dispatch, method combination and callback identity across Lisp subclass changes.") (:code-block "sh" "python3 tests/run.py
python3 tests/run.py ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "A separate preflight loads the native bridge, checks its ABI, and prints actual Lisp/OS/architecture and CFFI source metadata before any GUI scenario. To retain evidence, set " (:code "WXLAMBDA_TEST_REPORT") " to a new directory before running the suite:") (:code-block "sh" "WXLAMBDA_TEST_REPORT=test-results python3 tests/run.py sbcl --noinform \\
  --no-sysinit --no-userinit --non-interactive --load ci/setup.lisp") (:p "The runner records per-process logs and " (:code "summary.json") " with the source commit, working-tree status, command, platform, scenario results, durations, and exit codes. It preserves partial timeout output, stops at the first failure, and returns a failing exit code. Preflight is separate from the 26 GUI scenarios; a load failure cannot count as GUI coverage. An existing report directory is rejected to avoid mixing old and new evidence. Reporter checks can be run with " (:code "python3 -m unittest discover -s tests -p test_runner.py") ".") (:p "Retained local Phase 3 reports live in " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") ". The ignored " (:code "evidence/") " directory is separate from the disposable " (:code ".ci-deps/") " cache; keep evidence there when retaining local runs across dependency-cache cleanup. The newer 23-scenario Phase 4 runs are retained in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") "; the Phase 3 records retain their original 21-scenario count.") (:p "Choice tests cover selection bounds, empty/Unicode item lists, nested selection snapshots, handler replacement/removal, callback errors, and stale handles.") (:p "Coverage: callback dispatch and replacement, empty/long/Unicode text round trips, independent text copies, explicit closure release, queued click suppression, rebinding and self-unbinding, parent/child invalidation, wrong-type handles, duplicate sizer insertion, cleanup on setup and callback errors, and rejection of a second session. Event tests cover source/kind metadata, copied Unicode and empty text payloads, nested updates, silent versus notifying setters, self-unbinding, and text-handler errors before and during the loop, including caught errors that must leave the loop running. Layout tests verify actual child geometry for rows, columns, proportional allocation, fixed/flexible spacing, borders, and alignment, plus invalid options and stale handles. Control tests cover label text copies, checked-state access, nested toggle snapshots, handler replacement/unbinding, and caught/uncaught toggle errors. A timed Gray input stream tests delayed whitespace/CRLF, GUI callback dispatch while input is unavailable, separate evaluation/callback error recovery, and delayed EOF cleanup on SBCL and CCL. This simulates delayed terminal input; it does not validate an actual terminal or editor transport. Debugger tests verify original condition identity, live evaluation restarts, abandon-form recovery, safe delivery of callback errors, and paused GUI dispatch. They install automated debugger hooks on the GUI thread. A separate SBCL pseudo-terminal check entered the debugger, selected the application REPL restart, evaluated another form, and stopped cleanly. CCL terminal debugger I/O has not been verified. Unicode rendering, manual mouse/keyboard input, and user-generated toggle events have not been visually verified; automated text and toggle events use notifying setters.") (:p "The live-development example test exercises text updates, callback function redefinition, 50 explicit bind/unbind cycles with registry-release checks, unbinding before destruction, stale handles, and frame recreation in one session. Two representative-form scenarios exercise ordinary blocking startup and the application REPL, including Unicode input, checkbox/dropdown state, queued handler replacement, named action redefinition, unbinding all event kinds, and state-preserving window recreation from Lisp and a GUI callback. These use queued/notifying events; manual input and visual layout have not been checked.") (:p "Locally tested and intended combinations are distinct:") (:table :header (("Platform") ("Lisp") ("Validation")) :rows ((("Apple Silicon macOS, wxWidgets 3.2.12") ("SBCL 2.6.9, CCL 1.13") ("Local preflight/GUI evidence recorded per batch in IMPLEMENTATION.md; dependency cache switching verified separately")) (("Linux") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("macOS hosted runner") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("Windows x64") ("SBCL 2.6.9 intended, not validated") ("Native build, preflight, and GUI suite configured; no runtime results")))) (:heading 2 "Continuous integration") (:p (:code ".github/workflows/ci.yml") " runs on pushes, pull requests, and manual dispatch. The configured jobs are:") (:table :header (("Runner") ("Native build") ("Lisp GUI tests")) :rows ((("Ubuntu 24.04") ("Distribution wxWidgets 3.2, GCC") ("SBCL, 26 scenarios under Xvfb")) (("macOS 15") ("Homebrew wxWidgets 3.2, Clang") ("SBCL, 26 scenarios")) (("Windows Server 2022 x64") ("wxWidgets 3.2.12 from source, MSVC") ("Pinned SBCL 2.6.9, preflight and 26 scenarios; unexecuted")))) (:p "These are configured checks, not a claim that hosted jobs have passed. No hosted results have been recorded. This checkout currently has no Git remote, so a GitHub repository association is needed to dispatch or inspect the relevant runs. CCL remains locally tested on macOS, outside this CI matrix.") (:p "All jobs run reporting checks, native loading/ABI preflight, and the GUI suite (including Unicode copies, callbacks, controls, cleanup, and REPL recovery). An " (:code "always()") " upload step retains generated " (:code "test-results/") " logs and JSON reports for 30 days, even after test failures. A job that fails before tests start may have no test report; inspect its Actions logs as well as its conclusion. Hosted Windows, Linux, and macOS execution remains required before claiming validation.") (:p "The Windows build follows the upstream " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/docs/msw/install.md" "MSVC makefile instructions") ". It builds wxWidgets release DLLs from a pinned commit, then passes explicit " (:code "wxWidgets_ROOT_DIR") ", " (:code "wxWidgets_LIB_DIR") ", and " (:code "wxWidgets_CONFIGURATION=mswu") " settings to CMake. System package versions on Linux/macOS follow their package repositories; these native dependencies are not locked to an exact patch release.") (:p (:code "ci/install-sbcl.ps1") " downloads the official " (:link "https://sourceforge.net/projects/sbcl/files/sbcl/2.6.9/" "SBCL 2.6.9 Windows x64 MSI") ", verifies its pinned SHA256, and extracts it into the job's temporary directory. The bridge is emitted as " (:code "build/wxlambda.dll") ", where the Lisp loader expects it; the wxWidgets DLL directory is added to the test process's " (:code "PATH") ". Python runs in UTF-8 mode. This Windows setup has been statically reviewed, not executed on this macOS host; neither MSI execution nor PowerShell runtime behavior is locally verified. The full Windows job must pass to establish DLL loading and GUI behavior.") (:p "CI uses the exact CFFI, Babel, Alexandria, and trivial-features commits in " (:code "ci/lisp-dependencies.json") ", fetched over HTTPS into ignored " (:code ".ci-deps/") " checkouts. " (:code "ci/setup.lisp") " isolates ASDF's source registry from user installations and stores compiled output in " (:code ".ci-deps/fasl/") ", separated by Lisp implementation. This keeps pinned CFFI callbacks separate from Quicklisp's compiled-file cache. This path requires Git and Python 3, and does not install or modify Quicklisp. To reproduce the CI Lisp environment locally after building the bridge:") (:code-block "sh" "python3 ci/fetch-deps.py
python3 tests/run.py sbcl --noinform --no-sysinit --no-userinit \\
  --non-interactive --load ci/setup.lisp") (:p "On Linux, prefix the test command with " (:code "xvfb-run -a") " if no display is available. CCL can use the same dependencies with:") (:code-block "sh" "python3 tests/run.py ccl --no-init --batch --load ci/setup.lisp") (:p "For the separate dependency-cache regression, run:") (:code-block "sh" "python3 tests/cache-switch.py
python3 tests/cache-switch.py ccl --no-init --batch") (:p "Each command runs the callback/handler API scenario with pinned dependencies, then Quicklisp, then pinned dependencies again in fresh processes. It checks CFFI source locations and the compiled output destination as well as actual native callback dispatch. Quicklisp must already be installed; set " (:code "QUICKLISP_SETUP") " if its setup file is not " (:code "~/quicklisp/setup.lisp") ". These three-process regressions are separate from the 26-scenario GUI suite and are local checks, not configured hosted jobs.") (:p "The fetcher verifies existing checkouts and refuses modified or mismatched ones. After deliberately changing a locked revision, remove the corresponding generated " (:code ".ci-deps/<name>/") " directory before fetching again. Fresh compilation of the pinned Babel revision emits a warning about " (:code "HANDLE-ERROR") " in its Korean codec; the UTF-8 paths exercised by these tests pass on both local Lisps.") (:p "The " (:ref "guide/IMPLEMENTATION.md" "implementation roadmap") " now includes the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "native inventory and GUI feature roadmap") " as Phase 6; release preparation moves to Phase 7. The coverage plan checks off existing operations and groups native declarations into inventory categories C1–C7, not a required delivery sequence. Pending native entries do not automatically block a release; feature priorities and representative-app acceptance are documented separately. Hosted platform validation (including the configured Windows Lisp/GUI tests), packaging on additional platforms, and richer interactive development support remain open as described in the roadmap.") (:p "The " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application handler") " supports application-level registered messages without transferring ownership of wxApp.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session-event support") " includes logging-off metadata and isolated synthetic policy probes; real OS delivery remains unverified.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " adds native timestamps, command classification and scoped CanVeto SETF while preserving immutable snapshots.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event-ID routing") " supports context SETF and later native ID matching.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type access") " provides current type reads and bounded opaque origin identities.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event-category metadata") " provides saved/current flags and compiled mask lookup.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " checks native class compatibility before scoped SETF.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned native events") " add reusable CLOS resources, detached clones, payload SETF and copied dispatch without transferring source ownership.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event delivery") " adds GUI posting, native ownership transfer, local processing and target-only queue deletion with explicit semantics.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " add canonical peers, guarded reciprocal linking and unlinking while native ownership stays with the session.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " add guarded Push/Pop/Remove and explicit stack-aware synchronous event processing.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command event payloads") " add extra LONG/action metadata, semantic checked/selection SETF and bounded origin clearing.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " retains EQ state through managed typed native adapters while rejecting foreign storage safely.") (:p (:ref "guide/docs/BINDING-USER-DATA.md" "Binding Lisp user data") " adds per-registration EQ association reads with safe current-context and saved-snapshot lifetimes.") (:p (:ref "guide/docs/IDLE-EVENTS.md" "Idle events") " support bounded work, RequestMore, native policy and own-window opt-in. Frame menus/actions are available; bounded text/single-choice dialogs extend that breadth.") (:p (:ref "guide/docs/MENUS.md" "Frame menus and actions") " provide native-owned menu bars, menus and normal/check/separator items, CLOS construction, ID-routed :MENU callbacks and guarded scalar/lifetime operations. " (:ref "guide/docs/STANDARD-DIALOGS.md" "Modal text/single-choice dialogs") " extend this GUI slice; generic message/file workflows are available while native OS backends remain open. This batch does not claim OS menu selection/accelerator coverage.") (:p (:ref "guide/docs/STANDARD-DIALOGS.md" "Standard dialog scope") " covers modal text entry and single choice, stored values/selection, callback context suspension and protected modal cleanup. Generic message/file workflows are described separately; native OS backends, modeless and custom validation interfaces remain open.") (:p (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "Generic message/file dialogs") " add offered message results and single-file current paths/filters with guarded internal prompts. Raw END-MODAL does not validate a file choice; native browser actions can change the filesystem. The persistent document form composes the open/save workflow.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " combines File menu actions, save/discard/cancel prompts, safe modal cancellation and Lisp-native UTF-8 form files. Run its interactive START or bounded EXERCISE as documented there.") (:p (:ref "guide/docs/CLIPBOARD.md" "Text clipboard") " supports Unicode reads, generic SETF writes and best-effort persistence. The persistent form demonstrates Edit Copy/Paste name; automatic examples leave existing clipboard content untouched.") (:p (:ref "guide/docs/TEXT-EDITING.md" "Multiline text editing") " adds multiline construction, user editability and native selection/caret/range replacement. The text-editor example shows Unicode multiline edits; the persistent form stays a single-line form.") (:p (:ref "guide/docs/NOTEBOOK.md" "Notebook navigation") " adds fixed editor/settings panel pages, native selection/veto events and guarded ownership. Run the notebook example START for interactive tabs or EXERCISE for bounded navigation checks.") (:p (:ref "guide/docs/LIST-BOX.md" "Single-selection list boxes") " add mutable text items, selection and activation events. The list-manager example wires append/rename/delete/clear actions; stable domain IDs remain Lisp application data.") (:p (:ref "guide/docs/TREE-NAVIGATION.md" "Tree navigation and ownership") " add checked canonical item views, subtree invalidation, expansion and native selection/veto. The tree example demonstrates appends/deletes outside guarded selection callbacks.") (:p "The " (:ref "guide/docs/FRAME-ACTIONS.md" "toolbar/status-bar slice") " adds shared menu/tool action IDs, stock-art normal/check tools, enabled/checked state and application-owned status fields. Run " (:ref "example/examples/frame-actions.lisp" "frame-actions.lisp") " for an in-memory example. macOS uses the explicit safe in-window toolbar backend; native Cocoa toolbar chrome and dynamic tools remain outside this bounded scope.") (:p (:ref "guide/docs/KEYBOARD-ACCELERATORS.md" "Frame keyboard accelerators") " route copied shortcut tables to shared Lisp actions; see " (:ref "example/examples/keyboard-actions.lisp" "keyboard-actions.lisp") ". CMake requires wxWidgets wxUSE_ACCEL=1. Physical keyboard input and hosted OS translation remain unverified; conservative menu callback guards require modal/ clipboard/destructive actions to run after callback return.") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " allow shared menu/tool/keyboard callbacks to request modal, clipboard and destructive work after native stacks return. " (:ref "example/examples/deferred-actions.lisp" "deferred-actions.lisp") " demonstrates file selection, text copying and confirmed close, with owner-bound cancellation tickets. RUN/full polling drives the FIFO idle queue; pending-only dispatch does not.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now integrates owner-bound deferred Open/Save/Save As/Copy/Paste/close requests across menus, toolbar and configured keyboard shortcuts, with status feedback and save/discard/cancel close replay. Requests coalesce while pending/active; state is read at delivery. This is application composition using ABI43, with no new native bindings.") (:p (:ref "guide/docs/UI-TIMERS.md" "Bounded UI timers") " provide periodic/one-shot safe-idle updates with owner/session lifetime and cancellation; see " (:ref "example/examples/periodic-status.lisp" "periodic-status.lisp") ". CMake requires wxUSE_TIMER=1. macOS timers currently accept only verified wxWidgets3.2.12; newer version numbers do not establish safe queued-native cancellation. Hosted OS timing remains unverified.") (:p (:ref "guide/docs/NUMERIC-INPUT.md" "Bounded numeric inputs") " add signed sliders/integer spin controls, generic value/range writes and immutable update snapshots. Run " (:ref "example/examples/numeric-input.lisp" "numeric-input.lisp") " for silent cross-control synchronization. Physical and hosted OS input checks remain separate.") (:p (:ref "guide/docs/RADIO-GROUPS.md" "Bounded radio groups") " provide fixed exclusive choices; run " (:code "examples/radio-groups.lisp") " for export-format selection.") (:p (:ref "guide/docs/TOGGLE-BUTTONS.md" "Toggle buttons") " provide persistent on/off options; run " (:code "examples/toggle-buttons.lisp") " for preview feedback.") (:p (:ref "guide/docs/COMBO-BOXES.md" "Combo boxes") " combine fixed presets and custom single-line text; run " (:code "examples/combo-boxes.lisp") ".") (:p (:ref "guide/docs/SCROLLING-PANELS.md" "Scrolling panels") " provide larger forms with bounded unit-based scrolling; run " (:code "examples/scrolling-panels.lisp") ".") (:p (:ref "guide/docs/FOCUS-NAVIGATION.md" "Focus navigation") " adds guarded focus requests and forward/backward form traversal; run " (:code "examples/focus-navigation.lisp") ".") (:p (:ref "guide/docs/TOOLTIPS.md" "Window tooltips") " add copied contextual form guidance with explicit removal; run " (:code "examples/tooltips.lisp") ".") (:p (:ref "guide/docs/DATE-PICKER.md" "Date pickers") " add required calendar dates with copied Gregorian tuples; run " (:code "examples/date-picker.lisp") ". CMake links wxWidgets adv and requires wxUSE_DATEPICKCTRL/wxUSE_DATETIME.") (:p (:ref "guide/docs/TIME-PICKER.md" "Time pickers") " add copied hour/minute/second form values; run " (:code "examples/time-picker.lisp") ". CMake requires wxUSE_TIMEPICKCTRL/wxUSE_DATETIME with wxWidgets adv.") (:p (:ref "guide/docs/SEARCH-CONTROLS.md" "Search controls") " add query/hint fields and native search/cancel gestures with a deferred Lisp list-filter example; run " (:code "examples/search-controls.lisp") ". CMake requires wxUSE_SEARCHCTRL/wxUSE_TEXTCTRL."))))
(:entry "guide/IMPLEMENTATION.md" :names ("IMPLEMENTATION.md" "IMPLEMENTATION") :kind :guide :kind-name "Guide" :summary "IMPLEMENTATION.md" :sections (("Guide" (:heading 1 "Implementation plan") (:p "The goal is broad GUI coverage with selective depth: useful desktop workflows, reliable lifetime/event contracts and Lisp-friendly interfaces. Exhaustive native wxWidgets parity is no longer the delivery objective. C1–C7 inventories remain factual discovery records, not a required sequence or release gate.") (:heading 2 "Session handoff: broad GUI coverage") (:p "The user has explicitly requested the general-purpose native capabilities in " (:ref "guide/docs/KRYPTONEDIT-COVERAGE.md" "the KryptonEdit survey") ", superseding the prior “no next batch” handoff for that application-driven scope. Preserve ABI56 grid/ WebView and the completed MVP checkpoint. Prioritize STC, native input and dynamic tabs/splits before secondary views/tables/images/background delivery. Do not add editor models, parsing/language behavior or terminal emulation to wxLambda. ABI57–ABI61 complete the selected bounded KryptonEdit binding goal: styled text, native input, dynamic tabs/splits, safe worker delivery, scalable report/tree views, image/display resources and native grid editing/validation/dynamic dimensions. Final local acceptance is recorded in the ABI61 and completion checkpoints below. Next work is KryptonEdit application integration and any concrete gaps it reveals; there is no required next broad native-binding batch. Docking/HTML/navigation surveys and explicit platform/physical-input limits are not full-parity blockers. Earlier checkpoints preserve their original sequencing and verification context.") (:p "ABI56 adds the user's requested wxGrid and interactive JavaScript WebView extension after MVP acceptance. Both are implemented in bounded documented scope; WebView construction remains gated to verified macOS wxWidgets3.2.12 WKWebView. The current ABI56 evidence and review findings are recorded at the end of this handoff. No new required feature batch follows this explicitly requested extension.") (:p "The ABI55 coordinated batch closes the finite automated local macOS MVP: retained drawing/monitoring, activity feedback and cohesive tree/list record management complement the persistent form/editor workflow. Current acceptance and remaining manual/platform boundaries are in " (:ref "guide/docs/MVP-ACCEPTANCE.md" "MVP acceptance") ". Final verification evidence is recorded in the ABI55 checkpoint below. Further widget work is optional and should follow an application need or explicit request; there is no mandatory next binding slice after this acceptance checkpoint.") (:p "The user has superseded the earlier complete-wxWidgets objective. Follow the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "feature policy and acceptance roadmap") ": core, planned, on-demand, Lisp-native and deferred. Native pending/partial entries remain visible but are not automatic blockers. Expand everyday GUI breadth across categories, implementing actual prerequisites rather than exhausting C1 before other features.") (:p "Historical roadmap/checkpoints below preserve their original goal and evidence. Where they call every pending API required or insist on complete C1 before C2, that scope is explicitly superseded here. Do not rewrite historical verification as if later features or platform checks already passed.") (:heading 3 "Completed implementation checkpoints") (:list (:item (:p (:code "6f6312e") ": progress gauges, generic SETF properties, subclass example and"))) (:p "pulse-to-determinate regression; independent review finding resolved.") (:list (:item (:p (:code "ed3ca87") ": C1 application state and pending-event dispatch, callback/pump/"))) (:p "cleanup reentrancy guards and fresh-load inactive-session regression; independent review finding resolved.") (:list (:item (:p "Event-handler ownership milestone: native-backed standalone handlers, borrowed"))) (:p "window base identities, liveness and handler-enabled SETF state, plus weak native window invalidation. See the latest commit and the C1 handler section below.") (:list (:item (:p "Command-observer binding milestone: independent registrations, ID/range filters,"))) (:p "copied standalone queues, self/peer unbinding and deferred callback-time disposal. Four command kinds only; see the latest commit and the binding section below.") (:list (:item (:p "Scoped-event milestone: optional current-callback contexts control native Skip"))) (:p "and propagation, with nested-callback isolation and copied native type IDs. Four command kinds only; veto-capable classes and broader families remain open.") (:list (:item (:p "Close-family milestone: :close snapshots/contexts, CanVeto-guarded SETF veto,"))) (:p "synthetic close queues and frame close requests; acceptance is not destruction. " (:code "event-type") " replaces the command-only lookup without an alias.") (:list (:item (:p "Registered-notify milestone: session keyword declarations for custom command/"))) (:p "notify types, copied text/integer payloads, scoped Veto/Allow and synchronous dispatch with native handled/final-veto results. Session routing remains open.") (:list (:item (:p "Borrowed application milestone: cached application-handler view with inherited"))) (:p "bindings, dispatch and enabled state; no native ownership transfer or construction.") (:list (:item (:p "Session-event milestone: query/end-session tags and scoped logging-off metadata,"))) (:p "native application bindings and isolated owned-handler synthetic probes. Real OS session delivery remains unverified.") (:list (:item (:p "Metadata milestone: copied/current native timestamps and command classification,"))) (:p "timestamp SETF with native LONG bounds and close-family CanVeto SETF.") (:list (:item (:p "Routing milestone: current event-ID reads/SETF, signed32 including native -1,"))) (:p "and parent exact/range/wildcard matching after mutation.") (:list (:item (:p "Origin/type milestone: current native type reads and captured/current opaque"))) (:p "origin IDs for registered bridge objects; no unchecked pointer/class access.") (:list (:item (:p "Category milestone: saved/current virtual category flags and compiled native"))) (:p "keyword mask lookup; selective YieldFor remains open.") (:list (:item (:p "Tag-mutation milestone: registered same-family native type SETF with actual"))) (:p "native class checks; built-in/session tags remain excluded.") (:list (:item (:p "Owned-event batch: detached native-backed event construction, independent clone/"))) (:p "disposal/liveness, mutable command payloads and copy-based queue/process dispatch. Final batch verification and independent review pass; exact classes and detached origins only.") (:list (:item (:p "Pending-delivery batch: GUI posting copies, consuming native transfer, local"))) (:p "synchronous copies and non-application target queue deletion. Final verification and independent review pass.") (:list (:item (:p "Standalone-chain batch: canonical next/previous peers, reciprocal guarded SETF,"))) (:p "unlinked-state query and splice/unlink with unchanged session native ownership. Final verification and independent review pass.") (:list (:item (:p "Window-stack batch: managed Get/Push/Pop/Remove, preserving session-owned"))) (:p "handler lifetime, and explicit stack-aware synchronous copy processing. Final verification and independent review pass.") (:list (:item (:p "Command-payload batch: native extra LONG/raw selection-action metadata, uniform"))) (:p "kind-specific checked/selection SETF and bounded clear-only origin detachment. Independent runtime and documentation review pass; final verification is recorded below.") (:list (:item (:p "Handler-client-data batch: EQ Lisp state via native typed token adapters,"))) (:p "managed foreign-mode protection and session-root cleanup. Independent review and final verification pass.") (:list (:item (:p "Binding-user-data batch: per-registration EQ Lisp values, immutable captured"))) (:p "associations and context-frame lifetime through self-unbind. Independent review and final verification pass.") (:list (:item (:p "Idle batch: :IDLE family/resources, bounded RequestMore, session-restored"))) (:p "automatic mode, own-window opt-in and native wake scheduling. Independent review and final verification pass.") (:list (:item (:p "Current bridge ABI:49. Public API:256 exports,26 window wrapper classes"))) (:p "(24 concrete plus WINDOW/DIALOG abstract),183 named generics and56 generic SETF writers. Borrowed TREE-ITEM and UI-ACTION/UI-TIMER identities remain separate from window construction. Latest scrolling-panel details/evidence are recorded in the final session handoff below.") (:list (:item (:p "Latest implementation verification: all74 GUI scenarios plus native preflight"))) (:p "pass on local Apple Silicon macOS SBCL2.6.9 and CCL1.13, reports " (:code "evidence/scrolling-panels/{sbcl,ccl}-20261028-final/") ". The earlier toggle-batch CCL tree-process exception and successful reruns remain recorded in its handoff. Native probes report zero assertions. Hosted Linux/Windows GUI and graphical Cadre remain unverified; wxQt tree construction retains its documented rejection gate.") (:heading 3 "Feature priorities and working order") (:list (:item (:p "Preserve core ownership/invalidation, callbacks/main-thread rules, CLOS APIs"))) (:p "and required documentation/examples/docset/testing for every delivered feature.") (:list (:item (:p "Preserve the working form/editor slice: Lisp-native open/save, menus/dialogs,"))) (:p "multiline text, clipboard and notebooks. List boxes and checked tree items extend the manager slice. Splitters, toolbars/status, accelerators, safe deferred actions, timers, numeric inputs and radio groups are delivered. Retain native OS dialogs as unbound. Add only necessary timer/value/ lifetime prerequisites; do not drain native ownership/utilities.") (:list (:item (:p "Expand controls/layout, navigation/notebooks, list/tree, clipboard and drawing"))) (:p "against form/editor, tree/list manager and drawing/monitoring acceptance. Existing examples verify bounded behavior, not those whole applications.") (:list (:item (:p "Add specialized depth on demand. Prefer Lisp-native utility/model abstractions"))) (:p "where literal native strings/containers/files/network wrappers add little value.") (:list (:item (:p "Keep native checkboxes factual and platform claims tied to reports. Retained"))) (:p "origins, external native adoption and unsupported derived classes stay gaps, but need not precede unrelated menus/controls/dialogs. C1–C7 are inventory categories, not a delivery sequence. Preserve isolated session rules; never synthesize process-exiting live application END_SESSION in ordinary tests.") (:heading 3 "Resume and verification checklist") (:list (:item (:p "Inspect " (:code "git status") " and the latest log first; preserve unrelated changes."))) (:p "Read " (:code "AGENTS.md") ", this handoff and the relevant coverage declarations.") (:list (:item (:p "Use the required quiet-command wrapper for builds, tests and batch commands."))) (:list (:item (:p "Treat " (:code "docs/coverage/status.json") " as the source of status truth. Update exact"))) (:p "header/line/signature mappings and scopes, then regenerate all checklists, the class index and backlog. Never hand-edit generated marks or totals.") (:list (:item (:p "Obtain the pinned upstream " (:code "interface/") " tree if the previous temporary cache"))) (:p "is gone; verify its header hashes against " (:code "docs/coverage/manifest.json") ". " (:code "../docset") " (or " (:code "WXLAMBDA_DOCSET_SOURCE") ") supplies the shared docset reader; " (:code ".ci-deps/") " contains the pinned test dependencies, fetched through the CI tool.") (:list (:item (:p "Reproduction examples (replace the source placeholder):"))) (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 -m unittest discover -s tests -p 'test_*.py'
python3 tools/docset.py build
python3 tools/docset.py check") (:list (:item (:p "Every implementation slice needs matching reference/guides, runnable example"))) (:p "sources, docset updates and relevant behavior/error/lifetime tests. Run affected examples; verify actual-package export and SETF coverage with " (:code "tests/docset.lisp") " on both Lisps, plus shared-reader discovery and guide/example access. The generated coverage summary is also included in the docset.") (:list (:item (:p "Follow the established workflow: finish a bounded dependency-building slice,"))) (:p "obtain independent review, resolve findings, rerun affected checks, regenerate docs, commit, and record the result and next dependency here. Keep evidence directories fresh; the GUI runner rejects reused report directories.") (:list (:item (:p "Distinguish local checks from hosted platform and graphical-viewer validation."))) (:p "For documentation-only changes, verify regeneration/links/docset; do not claim GUI suites were rerun. Close a selected feature scope only after its agreed implementation and verification are complete; category-wide parity is not required.") (:list (:item (:p "For isolated docset installation checks, use a dedicated discovery parent such"))) (:p "as " (:code "/path/to/isolated-docsets/wxlambda") ", with only one copy of this docset ID. The reader deduplicates IDs across siblings; old test copies under a shared temporary parent can otherwise select a previous artifact. A shared-parent install check exposed that collision during the coverage-summary update; repeat with a dedicated root rather than weakening content comparisons.") (:heading 2 "Implementation rule: documentation, examples, and docset") (:p "Every implementation change must include matching documentation, examples, and docset updates, as required by " (:code "AGENTS.md (AGENTS.md)") ". The docset is the primary documentation deliverable: use Cadre's " (:code "docset") " library format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). Standard content means the indexed reference for every implemented public wxlambda export; include project guides and explained, runnable example sources in the same docset. Verify these deliverables alongside implementation; examples are required rather than optional. The initial docset build and artifact are implemented in Phase 7 below; release-wide platform and graphical-viewer verification remain open.") (:heading 2 "Phase 1: Establish the release baseline") (:list (:item (:p "[x] Correct README coverage and CI counts to match the GUI runner."))) (:list (:item (:p "[x] Record tested and intended OS/Lisp combinations separately."))) (:list (:item (:p "[x] Run the pinned-dependency suite and cache-switch regression checks."))) (:p "Verified locally on 2026-10-28 on Apple Silicon macOS with wxWidgets 3.2.12, SBCL 2.6.9, and CCL 1.13. The dependency fetcher verified all four pinned checkouts. Both Lisps passed all 19 GUI scenarios and the separate three-process pinned → Quicklisp → pinned callback regression. The runner previously had 18 scenarios; the delayed-input test below adds the nineteenth. Cache-switch checks are not included in that count. Reproduction commands are in README.md. Hosted-platform validation remains Phase 3 work.") (:p (:b "Acceptance:") " Documented commands reproduce the baseline without unexplained failures.") (:heading 2 "Phase 2: Finish REPL-driven development") (:list (:item (:p "[x] Add delayed-input tests for whitespace, CRLF, EOF, error recovery, and GUI"))) (:p "responsiveness.") (:p (:code "tests/repl-delayed.lisp") " uses a timed Gray stream on SBCL/CCL. It verifies callback dispatch while input is unavailable, separate evaluation/callback error recovery under the explicit " (:code ":on-error :report") " policy, and EOF cleanup. It rejects blocking reads during whitespace-only waits. Actual terminal/editor transport still needs broader validation.") (:list (:item (:p "[x] Replace message-only error handling for interactive use with a debugger"))) (:p "policy. Preserve the original condition and its available restarts; provide a restart that abandons the current form and returns to the application REPL. Investigate a backtrace fallback where debugger integration is unavailable.") (:list (:item (:p "[x] Define GUI processing as paused while the debugger is active, resuming"))) (:p "after recovery. Never unwind through a foreign callback.") (:list (:item (:p "[x] Test recovery from evaluation errors and callback errors separately."))) (:p "Verified locally on 2026-10-28: both pinned-dependency SBCL/CCL suites pass all 20 scenarios. " (:code "tests/repl-debugger.lisp") " checks original condition identity, live evaluation restarts, abandonment without losing the session, callback delivery after returning through the foreign boundary, and paused/resumed GUI dispatch. Callback-local restarts cannot survive that safe boundary; this is documented. The " (:code ":report") " fallback prints bounded SBCL/CCL backtraces before unwinding; tests confirm real stack output. A live SBCL pseudo-terminal check entered the debugger, selected " (:code "RETURN-TO-APPLICATION-REPL") ", evaluated another form, and stopped cleanly. CCL terminal debugger I/O remains unverified; its tests install hooks on the initial process because the adapter does not transfer dynamic bindings. Editor integration is explicitly deferred as recorded below.") (:list (:item (:p "[x] Prototype SBCL Swank with " (:code ":communication-style nil") " and " (:code ":fd-handler") ","))) (:p "checking where forms actually execute. These are candidates requiring verification, not supported configurations yet.") (:list (:item (:p "[x] Prototype CCL integration using its initial-process adapter."))) (:list (:item (:p "[x] Review the prototypes and select a demonstrated editor workflow or"))) (:p "explicitly defer editor support. If none works reliably, use the documented terminal REPL workflow as the release criterion and keep editor REPLs unsupported.") (:list (:item (:p "[x] If scheduling is needed, define execution order, returned values, condition"))) (:p "delivery, shutdown, and GUI-thread reentrancy before implementing it.") (:p "Not applicable to the selected terminal workflow: editor scheduling is deferred with editor support. These contracts remain prerequisites for future work; no scheduler has been implemented or advertised.") (:list (:item (:p "[x] Implement and verify the selected editor adapter if a prototype succeeds."))) (:p "Not applicable after explicit deferral: no editor workflow or adapter was selected. The thread probes below are not successful end-to-end editor prototypes and do not establish editor support.") (:list (:item (:p "[x] Retain and prominently document one GUI session per process for the first"))) (:p "release.") (:list (:item (:p "[x] Retain and prominently document the current rule that handlers for"))) (:p "destroyed controls remain rooted until unbound or session cleanup.") (:list (:item (:p "[x] Demonstrate explicit unbinding before destruction and verify that repeated"))) (:p "bind/unbind cycles release registered closures.") (:list (:item (:p "[x] Add a live-development example that updates controls and redefines callback"))) (:p "functions within one session.") (:p "Verified locally on 2026-10-28: both pinned SBCL/CCL suites pass 21 scenarios. The new " (:code "examples/live.lisp") " is exercised by " (:code "tests/live.lisp") ": text updates, callback redefinition, 50 bind/unbind cycles with registry-release checks, explicit unbinding before destruction, and frame recreation within one session. The smoke test also verifies handler retention after native destruction and release at session cleanup, plus rejection of a second application session.") (:p "Optional Swank (SLIME 2.32) loopback RPC probes passed for SBCL " (:code "nil") ", " (:code ":fd-handler") ", and a " (:code ":spawn") " rejection control, plus CCL " (:code ":spawn") ". SBCL's first two styles execute evaluation/body/callback on the launch thread. Its worker control rejects GUI startup. CCL evaluates on a worker and runs the application body/callback on the initial process without transferring caller dynamic bindings. Reproduction commands and limits are in README.md. These experiments cover one request containing one complete session, not persistent editing, interruption, or editor debugger transport. SLIME/SLY support is explicitly deferred; the terminal application REPL meets the first-release workflow gate.") (:p (:b "Acceptance:") " The terminal workflow supports live updates, useful error diagnosis, and recovery without losing the session. Debugger behavior and lifecycle limits are documented and tested. Editor support is either demonstrated or explicitly deferred.") (:heading 2 "Phase 3: Validate supported platforms") (:list (:item (:p "[ ] Execute macOS, Linux, and Windows hosted jobs and preserve results."))) (:list (:item (:p "[ ] Extend Windows checks to Lisp loading, callbacks, controls, and cleanup;"))) (:p "mark complete only after the configured hosted Windows job passes.") (:list (:item (:p "[ ] Check Unicode and REPL behavior on advertised combinations."))) (:p "Windows CI now stages SHA256-pinned SBCL 2.6.9, places the bridge where the Lisp loader expects it, exposes dependent wxWidgets DLLs, and runs native loading/ABI preflight plus the full GUI suite. All hosted jobs retain per-process logs and JSON summaries for 30 days with an " (:code "always()") " artifact upload. Configuration is not runtime evidence: the Windows setup and PowerShell installer are unexecuted on this macOS host.") (:p "Local evidence recorded on 2026-10-28: both SBCL 2.6.9 and CCL 1.13 pass preflight and 21 GUI scenarios, including Unicode and REPL tests. Logs and JSON summaries are retained in dedicated ignored " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") " directories, separate from the disposable dependency cache. The reports identify the source commit and mark the working tree dirty because they verify the uncommitted Phase 3 changes. Workflow lint and reporter checks also pass. The downloaded Windows MSI's SHA256 matches the configured pin; it was not executed locally.") (:p (:b "External dependencies:") " this checkout has no Git remote. GitHub authentication is available, but no repository association or hosted run URL has been provided. There is no local Windows runtime, PowerShell, Linux display server, or container runner. Hosted macOS/Linux/Windows execution and Unicode/REPL evidence on those runners remain pending; Phase 3 is not complete. Commands and the distinction between configured and validated platforms are documented in README.md.") (:p (:b "Acceptance:") " Runtime evidence supports every advertised platform. Missing repository access or runners remain explicit external dependencies.") (:heading 2 "Phase 4: Complete a representative application") (:list (:item (:p "[x] Extend an example using the existing controls and layouts."))) (:list (:item (:p "[x] Include handler replacement, explicit unbinding, and window recreation"))) (:p "within the same session.") (:list (:item (:p "[x] Identify concrete gaps exposed by the example and add controls or"))) (:p "operations only where needed.") (:p (:code "examples/form.lisp") " retains its ordinary load-and-run entry point. Its reusable " (:code "examples/form-app.lisp") " application combines labels, Unicode text input, a checkbox, a style dropdown, and row/column layouts. " (:code "start-live") " enters the terminal application REPL; submit actions can be replaced or redefined by name. Explicit close/reopen functions and a GUI reopen button unbind handlers before destruction and recreate the window with retained input values. Both entry points use only public bindings. The application exposed a need for reusable example lifecycle functions, not new native controls or operations; the binding API and ABI remain unchanged.") (:p "Verified locally on 2026-10-28 with pinned dependencies: SBCL 2.6.9 and CCL 1.13 each pass native preflight and all 23 GUI scenarios. " (:code "tests/form.lisp") " adds normal and live modes covering startup, controls, Unicode values, queued handler replacement, named function redefinition, explicit unbinding, stale handles, state retention, callback-driven recreation, and cleanup. An initial assertion incorrectly expected deferred destruction to finish inside the recreation callback; it was corrected to check after the appropriate event/cleanup boundary and both modes pass. The six reporter tests also pass. Reports and logs are retained separately from dependencies in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") ".") (:p "Accepted lifecycle limits remain visible in the README: one session per process, and closures for user-destroyed windows remain rooted until session cleanup if they were not explicitly unbound first. Manual input and visual layout have not been verified. Phase 3's hosted-platform checks remain pending; these local application results do not complete platform validation.") (:p (:b "Acceptance:") " Ordinary startup and live development work through public APIs, with the accepted lifecycle limits visible.") (:heading 2 "Phase 5: Implement standalone packaging") (:list (:item (:p "[x] Create a reproducible SBCL packaging example."))) (:list (:item (:p "[x] Resolve native libraries relative to the packaged application."))) (:list (:item (:p "[x] Stage required runtime libraries."))) (:list (:item (:p "[x] Test outside the checkout, from another working directory and without a"))) (:p "development Quicklisp installation.") (:p "The completed example is scoped to macOS SBCL, locally verified on Apple Silicon with SBCL 2.6.9. " (:code "packaging/build-form.py") " saves the form and pinned Lisp dependencies without initializing wxWidgets, copies the SBCL runtime, and stages the bridge plus recursive non-system dylibs. It rewrites native paths relative to each image, audits their resolution, and ad-hoc signs the copied images. This host's package contains 10 native objects, including the runtime, wxWidgets, its image dependencies, and zstd. Native inputs/hashes are recorded in a manifest; the recipe is repeatable, not a byte-identical or fully native-version-locked build. Linux/Windows packaging is not implemented, and Intel macOS is unvalidated.") (:p "The public explicit-path native loader no longer consults ASDF. The delivered core deliberately has no registered wxlambda ASDF system or Quicklisp package, and resolves its bridge beside the packaged runtime. A launcher supports normal startup, " (:code "--repl") ", and " (:code "--self-test") ". Interactive mode restores SBCL's debugger after the non-interactive image build.") (:p "Verified locally on 2026-10-28: build and five packaging checks pass. The verifier copies the package outside the checkout to a path with spaces, uses an unrelated working directory and empty HOME/SBCL_HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads. A denied-read control proves the sandbox is active. Packaged Unicode callbacks, window recreation, cleanup, and REPL startup/recreation/exit pass. Withholding the staged bridge or wxWidgets core produces the expected explicit load error and exit 1; those expected failures are not application passes or unexpected failed checks. Evidence is retained in " (:code "evidence/packaging/macos-sbcl-isolated/") ". Both regular pinned SBCL/CCL suites also pass preflight and 23 GUI scenarios after the loader change, with reports in " (:code "evidence/phase5/{sbcl,ccl}-20261028/") ".") (:p "The result is a command-line directory package, not a notarized Finder " (:code ".app") ". Other machines/OS versions and manual UI input remain unvalidated. Phase 3's hosted checks and Phase 7's release preparation remain open; this local sample does not establish release-wide platform support.") (:p (:b "Acceptance:") " The sample launches, processes events, and exits without relying on development paths or Quicklisp.") (:heading 2 "Phase 6: Maintain the native inventory and GUI feature roadmap") (:list (:item (:p "[x] Inventory the pinned wxWidgets API, including widgets, functions, overloads,"))) (:p "events, styles, optional components and platform-specific declarations.") (:list (:item (:p "[x] Mark implemented and partial operations in the detailed lists and class"))) (:p "index, preserving their scopes and Lisp/native mappings across regeneration.") (:list (:item (:p "[x] Group the native inventory into source-linked categories and separate"))) (:p "feature priorities, verification requirements and scoped acceptance.") (:list (:item (:p "[x] Preserve release preparation as Phase 7 and link the new coverage plan."))) (:p "The " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "wxWidgets coverage plan") " records the implemented baseline and inventory categories C1–C7. Its class index and per-header declaration checklists cover all 398 wxWidgets 3.2.12 interface headers, with source links and a hash manifest. A persistent status ledger retains checked/partial entries; compiler scaffolding is context rather than binding tasks. These are source-inventory entries, not a count of distinct functions or a claim of full binding coverage. Final source/documentation and inherited-API reconciliation is an explicit remaining coverage task.") (:p (:b "Acceptance:") " Every pinned interface header has categorized, source-linked entries; existing support is distinguished from complete class/API coverage. The inventory-plan deliverable is complete. C1/C2 implementation is underway; remaining pending/partial scope stays visible for GUI feature selection. The original exhaustive-parity acceptance objective is superseded.") (:heading 2 "Phase 7: Prepare the release") (:p "The docset build prerequisite was established before the first coverage slice. Continue using it for subsequent implementation work, including Phase 3 fixes and C1–C7 bindings, so required docset updates can be built and verified.") (:list (:item (:p "[x] Establish a reproducible Cadre-format docset build and update workflow for"))) (:p "implementation changes, with documented build/check/install commands. Generate format version 1 in " (:code "docs/docset/") " with " (:code "manifest.sexp") ", " (:code "index.sexp") " and " (:code "entries.sexp") ", docset ID " (:code "wxlambda") ", and package " (:code "WXLAMBDA") ".") (:list (:item (:p "[ ] Review exports, documentation, examples, ABI compatibility, and limitations."))) (:list (:item (:p "[ ] Run supported-platform and packaged-application checks."))) (:list (:item (:p "[ ] Align ASDF and CMake release versions."))) (:list (:item (:p "[ ] Prepare release notes and installation, development, debugging, and"))) (:p "packaging instructions.") (:list (:item (:p "[x] Produce the docset containing an indexed reference for every implemented"))) (:p "public wxlambda export, project guides/limitations, and example sources with explanations and run commands, all accessible through its index and contents.") (:list (:item (:p "[ ] Require zero problems from " (:code "docset:check-docset") "; verify public-export"))) (:p "coverage and links, run the included examples, and verify Cadre discovery, symbol lookup and navigation to guides/examples using documented installation.") (:p (:b "Acceptance:") " A new user can follow the documented installation-to-packaging workflow. Documentation and runnable examples match the implemented interfaces; the built docset uses Cadre's format version 1 and includes the public wxlambda reference, project guides and example sources together. All three files are present; " (:code "docset:check-docset") " reports zero problems; export coverage, links, example execution and Cadre discovery/lookup/navigation checks pass.") (:heading 2 "Historical implementation checkpoints (earlier goal superseded)") (:p "These dated checkpoints retain original scope/evidence. Complete-parity or strict C1-before-C2 instructions below describe the former goal; the current handoff and feature policy supersede them without changing recorded implementation facts.") (:heading 2 "Coverage implementation: first slice") (:list (:item (:p "[x] Establish and verify the Cadre-format docset build before expanding bindings."))) (:list (:item (:p "[x] Complete " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()")))) (:p "through the native bridge, FFI and public Lisp exports, preserving setter results and recording the equivalent " (:code "Hide()") "/" (:code "Disable()") " mappings.") (:list (:item (:p "[x] Add runnable window-state callbacks, focused tests and documentation, and"))) (:p "update the persistent coverage ledger.") (:p "This bounded C2 slice builds on existing window handles; the C1 foundation inventory and the rest of C2–C7 remain open. " (:code "show-window") " retains its window primary value and adds an optional show/hide argument and changed-state second value. " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " expose own visibility and effective input state. Native ABI 8 distinguishes false from native errors.") (:p "The initial " (:ref "guide/docs/DOCSET.md" "docset workflow") " delivered three committed files containing the then-current 53 public exports, project guides and six example sources with usage notes. Later slices extend that artifact. It requires Python 3, SBCL and the shared " (:code "docset") " library; no GUI is needed to build/read the docs. Its checker, shared-reader discovery/search/lookup and indexed guide/example reading pass, including an isolated installation. The graphical Cadre viewer has not been manually exercised.") (:p "The " (:code "window-state test (tests/window-state.lisp)") " runs the actual example callbacks, checks repeated setters, returned state-change flags, ancestor behavior and invalid/stale session use. Both local Apple Silicon macOS suites pass native preflight and all 24 GUI scenarios with wxWidgets 3.2.12, SBCL 2.6.9 and CCL 1.13; reports are retained in " (:code "evidence/coverage-first/{sbcl,ccl}-20261028/") ". Reproduction commands are in " (:ref "guide/docs/WINDOW-STATE.md" "the window-state guide") ". This does not close Phase 3 hosted checks or Phase 7 release-wide acceptance.") (:heading 2 "Coverage implementation: window metadata and CLOS API") (:list (:item (:p "[x] Add " (:code "window-name") ", " (:code "(setf window-name)") ", " (:code "frame-title") " and " (:code "(setf frame-title)")))) (:p "with native/FFI mappings and length-aware UTF-8 string ownership.") (:list (:item (:p "[x] Add a runnable callback example, a user guide and public API reference"))) (:p "records; track full name support and frame-only title support in the ledger.") (:list (:item (:p "[x] Fix multiline preprocessor handling in the inventory generator so following"))) (:p "classes and methods remain individually visible, with a regression check.") (:list (:item (:p "[x] Establish 40 widget-facing CLOS generic functions and export all eight"))) (:p "existing wrapper classes, preserving valid-call signatures and results.") (:list (:item (:p "[x] Add portable CLOS tests and an example of wrapper subclassing/method hooks;"))) (:p "record the CLOS implementation rule and update the reference generator.") (:p "This C2 slice supports logical names on all seven bound widget types, including empty/Unicode/embedded-NUL names. Frame titles are exposed only for " (:code "wxFrame") "; other " (:code "wxTopLevelWindow") " receivers and the broader C1/C2 inventories stay open. Getter strings remain valid after later queries and destruction; setters copy inputs. Native ABI 9 adds explicit byte lengths without changing earlier bridge string-buffer contracts.") (:p "The " (:ref "guide/docs/WINDOW-METADATA.md" "metadata guide") " documents usage and focused checks. At that checkpoint the docset covered 65 public exports, including eight wrapper classes and 40 named generic functions, plus guides and seven example sources. The user explicitly requested establishing CLOS before further widget-family expansion; keyword-only factories, lifecycle functions, immutable event snapshots and the FFI retain their existing roles. Native virtual overrides remain future work. Both local macOS SBCL/CCL suites pass native preflight and all 26 GUI scenarios, including the CLOS and metadata scenarios. Reports are retained in " (:code "evidence/coverage-clos/{sbcl,ccl}-20261028/") ". The earlier 25-scenario metadata reports in " (:code "evidence/coverage-metadata/") " predate the CLOS migration.") (:p "The macOS SBCL standalone form was rebuilt as " (:code "dist/wxlambda-form-clos") " and passes all five isolation/relocation/REPL/missing-library checks, with evidence in " (:code "evidence/packaging/coverage-clos-20261028/") ". The docset checker reports zero problems; actual-package export coverage passes on both Lisps. Python and inventory regressions cover method-signature rendering, stale-docset detection, agent-content exclusion and multiline macro parsing. Graphical Cadre and hosted platform verification remain release work; shared-reader checks are separate from graphical-viewer testing.") (:heading 2 "CLOS construction and properties: revision 3") (:list (:item (:p "[x] Make " (:code "make-instance") " construct every concrete native widget from initargs,"))) (:p "with ordinary subclass defaults/slots and native-backed AFTER initialization.") (:list (:item (:p "[x] Make factories thin MAKE-INSTANCE wrappers with validated " (:code ":class") " and"))) (:p "forwarded subclass initargs, and reject abstract/invalid construction clearly.") (:list (:item (:p "[x] Roll back native allocations and callback roots on managed initializer"))) (:p "failure, preserving the original condition or nonlocal exit.") (:list (:item (:p "[x] Establish eight canonical generic SETF writers and migrate examples,"))) (:p "tests, REPL scripts, packaging and documentation to them.") (:p "The user's later ground-up direction explicitly removes backward compatibility as a requirement. It supersedes the earlier factory/CHANGE-CLASS construction convention and the review's request to retain setter aliases. Six separate setter aliases and receiver-compatibility fallback methods were removed; unsupported receiver types now use CLOS dispatch errors. The native ABI remains 9; native handle/type and callback/lifetime checks are retained.") (:p "The public API has 59 exported symbols, including eight classes, 34 named widget generic functions and eight generic SETF functions using the getter symbols. Class docset pages include Construction sections; mutable-property pages include SETF syntax and indexed compound writer names. The current docset has 73 entries covering the API, guides and seven executable example sources.") (:p "Locally verified on Apple Silicon macOS with SBCL 2.6.9 and CCL 1.13: native preflight and all 26 GUI scenarios pass, including direct construction of all seven native kinds, subclass defaults/slots, factory class validation, initializer rollback, property writers, notification recovery and method combination. The initial SBCL run caught an obsolete native-error expectation for a wrong receiver in the events test; the expectation now checks CLOS dispatch failure, and the full rerun passes. Both reports are retained under " (:code "evidence/clos-construction/") " (" (:code "sbcl-rerun-20261028") ", " (:code "ccl-20261028") "); the original failed " (:code "sbcl-20261028") " report remains intact.") (:p "The rebuilt macOS SBCL form in " (:code "dist/wxlambda-form-native-clos") " passes all five packaging checks, recorded in " (:code "evidence/packaging/native-clos-construction-20261028/") ". Docset validation on both Lisps verifies all 59 exports and the construction and SETF sections; Python/inventory regressions pass. Hosted-platform checks and the Cadre graphical viewer remain unvalidated.") (:heading 2 "Property accessor names: revision 4") (:list (:item (:p "[x] Rename the text readers and generic SETF writers to " (:code "text") " and"))) (:p (:code "label-text") ", with no aliases for the former reader names.") (:list (:item (:p "[x] Update callers, embedded REPL/package scripts, examples, API reference"))) (:p "records, docset indexes and persistent coverage mappings.") (:list (:item (:p "[x] Record property-style naming in the project rules and add regression"))) (:p "assertions that obsolete readers/writers are absent.") (:p "The CLOS construction and SETF protocol is unchanged. Public export count remains 59 and the docset remains 73 entries; the property names and index IDs now use natural accessor names. The private CFFI/native getter names remain internal implementation details, so no native ABI change is needed.") (:p "Both local macOS SBCL/CCL suites pass preflight and all 26 scenarios, with reports in " (:code "evidence/property-names/{sbcl,ccl}-20261028/") ". The rebuilt standalone form passes five packaging checks in " (:code "evidence/packaging/property-names-20261028/") ". The Python/inventory checks and both actual-package docset checks pass, including indexed SETF forms under the new names. Hosted platforms and the graphical Cadre viewer remain unvalidated.") (:heading 2 "Coverage implementation: progress gauges") (:list (:item (:p "[x] Add native-backed " (:code "gauge") " construction and the thin " (:code "make-gauge") " factory,"))) (:p "including subclass defaults, slot initargs and native access in AFTER hooks.") (:list (:item (:p "[x] Add generic " (:code "gauge-value") "/" (:code "gauge-range") " readers and SETF writers,"))) (:p (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ", with checked native handles and arguments.") (:list (:item (:p "[x] Add a runnable subclass/callback example, focused GUI scenario, guide,"))) (:p "reference entries and persistent declaration/class/style coverage mappings.") (:list (:item (:p "[x] Prevent guide/example stem aliases from shadowing public symbols in Cadre"))) (:p "lookup, with a regression test and stricter build/check lookup assertions.") (:p "This bounded C2 slice exposes " (:code "wxGauge") " progress, positive ranges, horizontal or vertical construction and indeterminate pulsing. Range assignment clamps the current native value and restores determinate mode. Pulse animation/value readings remain platform-dependent. Custom constructor IDs, geometry, validators, names and additional styles, two-step creation and the remaining inherited API stay open. Native ABI 10 requires rebuilding the bridge with these bindings. The API now has 65 exports, nine wrapper classes, 39 named generic functions and ten generic SETF writers. The docset contains 81 entries across API, guides and eight example sources; installation instructions remain in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ".") (:p "Local Apple Silicon macOS verification passes native preflight and all 27 GUI scenarios on SBCL 2.6.9 and CCL 1.13. Evidence is retained in " (:code "evidence/gauge/sbcl-20261028.log") " and " (:code "evidence/gauge/ccl-20261028/") "; a focused rerun on both Lisps also passes after the final helper refactor. The sandboxed initial SBCL gauge process stalled on macOS window-service access and was terminated; GUI verification passed with window-service access outside the agent sandbox. Reporter/inventory tests initially caught obsolete scenario and class counts, which were updated and pass on rerun. Actual-package docset validation caught colliding guide/example aliases for GAUGE; the alias fix and regression now pass, with zero " (:code "docset:check-docset") " problems, complete export and SETF lookup coverage, links, discovery and indexed guide/example access on both Lisps. An isolated install under a temporary docset root passes discovery and indexed reading. Python and pinned-upstream inventory regressions pass.") (:p "The rebuilt " (:code "dist/wxlambda-form-gauge") " passes all five packaging isolation, relocation, REPL and missing-library checks, with reports in " (:code "evidence/packaging/gauge-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. This slice does not complete C1 or C2. Independent static review found that the example resumed determinate progress from platform-dependent pulse readings. The example now stores completed work in Lisp and tests pulse-to-advance directly; the revised focused scenario passes on both Lisps. The reviewer verified the fix and reported no remaining actionable findings. The user has directed that unfinished C1 foundations take priority before further C2 widget expansion; finish and review this gauge slice, then return to C1.") (:heading 2 "C1 foundation: application event dispatch") (:list (:item (:p "[x] Expose " (:code "main-loop-running-p") ", " (:code "pending-events-p") " and"))) (:p (:code "process-pending-events") " for the active bridge application, distinguishing wx pending events from GUI/OS polling and idle processing.") (:list (:item (:p "[x] Guard RUN, both event pumps and native cleanup against callback/pump"))) (:p "reentrancy, including synchronous notifying setters before RUN starts.") (:list (:item (:p "[x] Add the runnable application-events example, focused regression scenario,"))) (:p "guide, API reference and pinned C1 declaration mappings.") (:p "This is an application-dispatch prerequisite within C1, not completion of the application or event-handler inventory. The next dependency is event-handler ownership and generic binding, followed by timer/idle/propagation and worker-to-GUI dispatch, with required value/ownership contracts before consumers. All new APIs require an active main-thread session. Queries return T/NIL; pending-only dispatch returns NIL and re-signals contained callback conditions after returning from native code. Existing synchronous notifications and the cooperative application REPL remain supported. Native ABI 11 adds these entry points and the dispatch boundary; rebuild the bridge alongside the bindings.") (:p "Local Apple Silicon macOS verification passes native preflight and all 28 GUI scenarios on SBCL 2.6.9 and CCL 1.13, including the example, loop/queue queries, pending dispatch, raw/native callback guards, notifying-setter boundaries, debugger pauses, inactive sessions and recovery after callback failure. The initial focused test used an incorrect zero-argument text callback; it was corrected to accept the event snapshot and both Lisp reruns pass. Full reports are retained in " (:code "evidence/application-events/{sbcl,ccl}-20261028/") ". Independent review found that fresh-ASDF-load calls initially raised an FFI lookup error instead of NATIVE-ERROR before bridge loading. All three new public functions now check the active session before calling the FFI. The fresh-load regression verifies NATIVE-ERROR without loading the bridge, then checks raw native pre-session errors. The reviewer independently verified this fix and reported no remaining actionable findings. Both full 28-scenario suites pass after the fix; final reports are under " (:code "evidence/application-events/{sbcl,ccl}-review-fix-20261028/") ".") (:p "Python reporter/docset regressions and all pinned-upstream inventory checks pass. The docset contains 86 entries and covers all 68 public exports, guides and nine example sources. Build/check and actual-package export/SETF lookup verification pass on both Lisps with zero " (:code "docset:check-docset") " problems; indexed reading, links, shared-reader discovery and an isolated temporary installation are verified. Installation instructions are in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ". The rebuilt " (:code "dist/wxlambda-form-application-events-reviewed") " passes all five packaging isolation, relocation, REPL and missing-library checks; evidence is in " (:code "evidence/packaging/application-events-reviewed-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. The C1 inventory remains open, and no further C2 widget families were added.") (:heading 2 "C1 foundation: event-handler ownership and state") (:list (:item (:p "[x] Add native-backed " (:code "event-handler") " construction, thin validated standalone"))) (:p "factory, explicit standalone destruction, liveness and generic enabled state.") (:list (:item (:p "[x] Make " (:code "window") " inherit the event-handler interface while borrowing its existing"))) (:p "native widget identity; retain a single allocation per window and managed CLOS subclass/default/initarg/AFTER semantics.") (:list (:item (:p "[x] Generalize initializer rollback across standalone handlers, nested windows"))) (:p "and callback roots; session cleanup frees remaining standalone handlers.") (:list (:item (:p "[x] Track windows weakly so disabling handler event processing cannot leave"))) (:p "dereferenceable dead pointers when destroy-event delivery is suppressed.") (:list (:item (:p "[x] Add standalone/subclass and window callback examples, focused ownership/"))) (:p "state/lifetime tests, API/guide/docset content and persistent C1 coverage.") (:p "Native ABI 12 adds standalone handlers and own event-processing state. " (:code "handler-enabled-p") " is distinct from window input " (:code "enabled-p") "; native routing and parent propagation rules still apply. Native lifetime observation returns NIL for stale identities only within an active session. Borrowed window handlers reject standalone destruction. Dead weak registry entries can remain until session cleanup; they do not retain or dereference destroyed native windows. Legacy control callback roots still require explicit unbinding before window destruction or remain rooted until session cleanup. No generic binding, standalone event queues, pushed-handler ownership or native virtual overrides are implemented.") (:p "Local Apple Silicon macOS native preflight and all 29 GUI scenarios pass on SBCL 2.6.9 and CCL 1.13, with evidence in " (:code "evidence/event-handlers/{sbcl,ccl}-20261028/") ". Tests include the actual example callbacks, disabled-window/child destruction, owned/borrowed misuse, direct/factory class-object construction, native AFTER access, mixed-resource/callback-root rollback, invalid construction, stale identities and inactive sessions. The initial focused test mistakenly expected REINITIALIZE-INSTANCE to re-run native construction; it was corrected to test repeated INITIALIZE-INSTANCE, matching the existing construction contract. Both focused reruns and complete suites pass.") (:p "Independent static review found no actionable correctness issues. Its wording nit about dead weak entries was corrected to state that entries can remain until session cleanup. Python and pinned-upstream inventory regressions pass. The generated docset contains 94 entries covering all 73 public exports, guides and ten example sources. Build/check reports zero problems and verifies links, shared-reader discovery and indexed guide/example access. Actual-package and isolated-install checks accompany this slice; graphical Cadre and hosted Linux/Windows GUI validation remain open.") (:p "The rebuilt " (:code "dist/wxlambda-form-event-handlers") " passes all five packaging isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-handlers-20261028/") ". The next C1 slice is generic multi-event/ID binding and safe unbinding, using the ownership base established here. Full event-handler and C1 coverage remain open.") (:heading 2 "C1 foundation: independent command-event bindings") (:list (:item (:p "[x] Add immutable " (:code "event-binding") " identities with " (:code "bind-event") ", " (:code "unbind-event")))) (:p "and " (:code "binding-active-p") ", using native Bind/Unbind with exact registration identity.") (:list (:item (:p "[x] Support independent observers for four existing command-event kinds on"))) (:p "standalone/window handlers, including signed command IDs and inclusive ranges.") (:list (:item (:p "[x] Add copied synthetic " (:code "queue-event") " payloads, immutable " (:code "event-id") " snapshots"))) (:p "and explicit UTF-8 payload lengths preserving embedded NUL text.") (:list (:item (:p "[x] Keep active native callbacks alive across self/peer unbinding; defer"))) (:p "callback-time receiver deletion through application CallAfter, with immediate target invalidation and root pruning at Lisp boundaries.") (:list (:item (:p "[x] Make control-specific hooks observers too, preserving ordinary command"))) (:p "routing to parent observers; add examples, API/guide and coverage/docset updates.") (:p "Native ABI 13 extends snapshots with command IDs and text byte lengths. Snapshot " (:code "event-source") " is the binding receiver, not necessarily the native originating child; origin-object lookup remains unbound. All command callbacks automatically Skip; mutable Skip/veto/propagation contexts, arbitrary native event types and userData, pushed chains and worker dispatch remain open. Generic roots can remain until a Lisp boundary during a blocking RUN; the control-specific explicit-unbind root contract remains unchanged. Initializer rollback removes generic registrations across nested resources. Owned/borrowed lifetime restrictions remain in force.") (:p "Initial full suites pass native preflight and all 30 scenarios on local macOS SBCL 2.6.9 and CCL 1.13, in " (:code "evidence/event-bindings/{sbcl,ccl}-20261028/") ". Independent review confirmed a propagation issue: dormant control-specific hooks consumed commands before parent generic observers. All four hooks now Skip, including after convenience callback delivery. Final full reruns pass all 30 scenarios in " (:code "evidence/event-bindings/{sbcl,ccl}-observers-20261028/") ", including parent/child receiver/ID checks and self-disposal in synchronous notifying text, checkbox and choice setters. Additional focused checks cover disabled-receiver expiration and active-registration state while event processing is disabled.") (:p "Review verified exact binding lifetime, self/peer unbinding, deferred receiver disposal, snapshot copying, rollback and the final documentation; no actionable findings remain. An initial Lisp compile caught an extra parenthesis, which was corrected; the first pre-session test incorrectly supplied a symbol to ALLOCATE-INSTANCE instead of a class object, also corrected before passing reruns. Python and pinned-upstream inventory regressions pass. The docset has 103 entries covering all 80 exports, project guides and eleven example sources, with zero checker problems. Actual-package/SETF lookup and isolated install checks verify shared-reader discovery and guide/example access. Graphical Cadre and hosted Linux/Windows GUI behavior remain unverified.") (:p "The final " (:code "dist/wxlambda-form-event-bindings-reviewed") " passes all five package isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-bindings-reviewed-20261028/") ". Next establish native event class/type representation and separate scoped mutable event contexts before dependent event families. This does not complete wxEvtHandler or C1 coverage.") (:heading 2 "C1 foundation: scoped native event contexts") (:list (:item (:p "[x] Add " (:code "event-context") " values for " (:code "bind-event :with-context t") "; contextual"))) (:p "callbacks receive " (:code "(snapshot context)") " and explicitly control native Skip.") (:list (:item (:p "[x] Add generic " (:code "event-skipped-p") " with canonical SETF, " (:code "event-propagates-p") ","))) (:p "stop/resume propagation actions and " (:code "event-context-active-p") ".") (:list (:item (:p "[x] Guard native event borrowing with monotonically allocated tokens, native"))) (:p "callback depth and an RAII scope stack. Nested contextual, observer and control-specific callbacks cannot use a suspended outer context; it becomes usable again when they return. Expired readers/writers reject native access.") (:list (:item (:p "[x] Copy native event type integers into immutable snapshots, with lookup for"))) (:p "four existing command tags; add guides, runnable example and C1 coverage.") (:p "Native ABI 14 extends snapshot metadata and the binding mode. Observer mode keeps automatic Skip; contextual mode starts unskipped and consumes unless the callback sets Skip true. Propagation level is separate from Skip. Unbinding or deferred disposal does not invalidate a context before its current callback returns; errors expire it on return without rolling back native mutations. Snapshot and context tokens remain immutable. Native type IDs are process-local metadata, not stable serialized identifiers or arbitrary type registration.") (:p "Local Apple Silicon macOS native preflight and all 31 GUI scenarios pass on SBCL 2.6.9 and CCL 1.13, with reports in " (:code "evidence/event-contexts/{sbcl,ccl}-20261028/") ". Focused checks also pass on both Lisps for native type copying in all four control-specific callback modes and outer-context restoration after a handled nested contextual error. Tests cover consumption/forwarding, propagation stop/restore/zero, nested suspension, stale readers/writers, callback conditions, self-unbinding and deferred receiver disposal. The first compile caught an extra closing parenthesis in the extended native binding call; it was corrected before the passing focused and full-suite runs.") (:p "Independent runtime and documentation review found no actionable correctness issues. A docstring was clarified to distinguish contextual consumption from observer mode. Python and pinned-upstream inventory regressions pass. The docset contains 114 entries covering all 89 exports, guides and twelve example sources, with zero checker problems. Actual-package/SETF lookup, links, shared-reader discovery and isolated-install guide/example checks accompany this slice. Hosted Linux/Windows GUI and the graphical Cadre viewer remain unverified.") (:p "The rebuilt " (:code "dist/wxlambda-form-event-contexts") " passes all five packaging isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-contexts-20261028/") ". Full wxEvent/C1 coverage remains open: veto-capable classes, arbitrary event-family/type registration, native event construction/cloning, origin/ID/type mutation, userData, linked/pushed handlers, timer/idle and worker dispatch remain future work. The next dependency is broader event-family representation and veto-capable event classes with checked borrowed lifetimes, before dependent event families.") (:heading 2 "C1 foundation: close-event family and checked veto") (:list (:item (:p "[x] Generalize native binding dispatch to the wxEvent base with checked family"))) (:p "payload extraction; add " (:code ":close") " / " (:code "wxEVT_CLOSE_WINDOW") " / " (:code "wxCloseEvent") ".") (:list (:item (:p "[x] Add immutable " (:code "event-family") " and close-flag snapshot reads, plus current"))) (:p "context " (:code "event-can-veto-p") " and generic SETF " (:code "event-vetoed-p") ", guarding actual class and native CanVeto before setting or clearing veto.") (:list (:item (:p "[x] Add copied synthetic close events with an initial " (:code ":can-veto-p") " option and"))) (:p "a frame-only synchronous " (:code "close-window") " request preserving native acceptance.") (:list (:item (:p "[x] Rename the command-only type lookup to " (:code "event-type") ", without an alias,"))) (:p "and migrate examples, tests, references and persistent coverage mappings.") (:list (:item (:p "[x] Add the veto-policy example and close-family tests, guides and docset."))) (:p "Native ABI 15 extends snapshots with close flags. Snapshot values are copied before each callback and stay immutable; live veto access is limited to the current close context. Non-close contexts and non-vetoable close requests reject veto writes before wx assertions. Force disallows veto but does not bypass a consuming contextual handler. Acceptance is not a destruction guarantee. A veto handler should consume the event rather than delegate to default closing. Queued close events on frames can invoke native default closing. Observer errors do not implicitly veto; their automatic Skip can still allow default closing.") (:p "Native preflight and all 32 local Apple Silicon macOS GUI scenarios pass on SBCL 2.6.9 and CCL 1.13. Reports are in " (:code "evidence/close-events/{sbcl,ccl}-20261028/") ". Focused checks also pass on both Lisps for immutable snapshot SETF rejection and observer-error/default-close behavior. Tests distinguish real veto, consumption, force and default deletion; cover synthetic CanVeto flags, wrong-family/expired access and handled nested close errors while RUN continues. A snapshot-extension compile warning exposed a leftover variable in the edited constructor call; it was corrected to explicit boolean conversions before passing verification.") (:p "Independent runtime/documentation review found no actionable correctness issues. The queue docstring and a stale four-keyword sentence were corrected for the new family. Python and pinned-upstream inventory regressions pass. The docset has 120 entries for all 93 public exports, guides and thirteen example sources, with zero checker problems; actual-package/SETF lookup, links, shared-reader discovery and isolated-install navigation checks accompany this slice. The rebuilt " (:code "dist/wxlambda-form-close-events") " passes all five package checks, with evidence in " (:code "evidence/packaging/close-events-20261028/") ".") (:p "Full wxCloseEvent/C1 support remains open: wxNotifyEvent, query/end-session tags, logging-off state, arbitrary event tags/registration, persistent event cloning, context capability mutation, userData, pushed handlers, timer/idle and worker dispatch remain required work. " (:code "wxWindow::Close") " is mapped only for wxFrame; other receiver types are not complete. Hosted Linux/Windows GUI and graphical Cadre validation remain unverified. Continue C1 notify/session/event registration and ownership prerequisites before dependent event families or new widgets.") (:heading 2 "Registered command/notify types and synchronous dispatch (2026-10-28)") (:p "Bridge ABI 16 adds session-scoped REGISTER-EVENT-TYPE declarations, copied command/notify text and integer snapshots, current-context notify Veto/Allow, and PROCESS-EVENT. Synchronous dispatch returns native handled-p and final vetoed-p independently: skipped observers can run while handled-p is NIL. Synthetic events remain owned through callbacks and deferred receiver disposal. Registration metadata expires with the session; saved snapshots remain readable. There is no unregister or rollback of a declaration after failed initialization.") (:p "Both local SBCL and CCL pass native preflight and all 33 GUI scenarios, including the runnable notify example. Python and pinned inventory regressions pass. The docset contains 125 entries covering all 96 exports, guides and fourteen examples. Five relocated-package checks pass; evidence paths are in the handoff. Independent runtime and documentation review found no runtime issues; stale snapshot/type/veto reference descriptions identified in review were corrected.") (:p "Native session routing is deliberately deferred: it requires a borrowed wxApp handler view with defined lifetime, and default END_SESSION handling can exit the process. Complete that prerequisite before query/end-session and logging-off support. Derived notify classes, broader event ownership and all remaining C1–C7 backlog items remain open. Hosted Windows/Linux GUI and graphical Cadre checks remain unverified.") (:heading 2 "Borrowed application handler prerequisite (2026-10-28)") (:p "Bridge ABI 17 adds APPLICATION-HANDLER and CURRENT-APPLICATION-HANDLER as a cached, borrowed view of the bridge-managed wxApp. It reuses inherited event binding, queueing, synchronous processing, liveness and enabled-state generics. Direct construction (including subclasses/factories) and explicit destruction are rejected. Bindings are removed before native wxApp cleanup; saved snapshots remain readable while saved views reject native operations outside the session. Every lookup validates the native main-thread/session boundary, even when cached.") (:p "Actual-package docset validation caught a missing Construction section for the borrowed class; review independently identified it, and the section was added before repeating the checks. Independent static review found no runtime issue. Its documentation note was applied: disabling the real application handler can delay application-queued work, including deferred disposal, until restoration or cleanup. The example and regression test cover identity, delivery, notify veto, enable/restore, rejected construction/disposal, session cleanup and saved snapshots.") (:p "Local SBCL and CCL pass all 34 GUI scenarios plus native preflight. The Python and pinned inventory tests pass; five relocated package checks pass. The docset has 129 entries for all 98 exports, guides and fifteen examples; checker, actual-package export/SETF coverage, isolated-install discovery and guide/example navigation checks pass. Evidence paths are in the handoff. Hosted Linux/Windows GUI and graphical Cadre validation remain unverified.") (:p "Continue C1 with session-family metadata and synthetic owned-handler tests before validating OS application routing. Default END_SESSION may exit the process; never emit it on the managed application as an ordinary regression test. All required missing/partial C1–C7 APIs remain open in the coverage inventory.") (:heading 2 "Query/end-session and logging-off metadata (2026-10-28)") (:p "ABI 18 adds :QUERY-END-SESSION and :END-SESSION to the close family, with immutable logging-off snapshots and generic EVENT-LOGGING-OFF-P context SETF. Native bindings accept the borrowed application view and owned standalone handlers; window bindings reject. Synthetic queue/process accepts only owned handlers. Internal StandaloneHandler::TryAfter blocks wxApp fallback for session tags, including unmatched, skipped and disabled dispatch. Upstream source inspection showed that plain wxEvtHandler otherwise forwards unhandled events to wxApp; native default END_SESSION can exit the process. Other kinds retain normal dispatch. Native application bindings are tested without emitting events.") (:p "Focused example/regressions and all 35 GUI scenarios plus preflight pass on local SBCL and CCL. Python and pinned inventory regressions pass. Five relocated package checks pass; evidence paths are in the handoff. The 132-entry docset covers all 99 exports, guides and sixteen examples, with zero checker problems and actual-package export/SETF coverage, discovery, isolated installation and API/guide/example lookup checks on both Lisps.") (:p "Independent review identified missing reserved-kind snapshot decoding while the slice was being assembled; the decoder was corrected before verification. Review then found no actionable runtime issue. Documentation distinguishes synthetic CanVeto defaults from native flags; changing logging-off metadata does not change OS intent. Real OS session delivery/policy, hosted Windows/Linux GUI and graphical Cadre validation remain unverified. All native session-event coverage remains partial. Next complete scoped CanVeto mutation and remaining native snapshot metadata, then event ownership/family prerequisites in C1.") (:heading 2 "Scoped CanVeto and native event metadata (2026-10-28)") (:p "ABI 19 adds EVENT-TIMESTAMP and EVENT-COMMAND-P for saved snapshots and current contexts. Timestamp SETF accepts the signed native C LONG range, with Lisp and native checks before narrowing the fixed int64 transport. Native status/output separation preserves negative timestamps, including -1. Synthetic timestamps start at zero; no timestamp-construction option or scheduling behavior is added. Command classification copies native IsCommandEvent, including notify=true.") (:p "SETF EVENT-CAN-VETO-P maps current wxCloseEvent::SetCanVeto directly. False can be re-enabled; native GetVeto hides a stored veto while CanVeto is false and reveals it if re-enabled. Every veto write checks the current flag. Notify capability remains intrinsic/read-only, and snapshots have no property writers. Explicit CanVeto mutation can affect forced native close results, but cannot guarantee OS veto acceptance. Updated guides remove the prior permanent-false forced-close assumption. Native context lifetime/isolation remains enforced.") (:p "Independent runtime review found no actionable issue. The runnable example and focused regression pass both Lisps; all 36 local GUI scenarios and preflight pass on SBCL and CCL. Python and pinned inventory regressions pass. Five rebuilt relocated-package checks pass, with evidence paths in the handoff. The docset has 136 entries for all 101 exports, guides and seventeen examples; checker, actual export/SETF coverage, isolated-install discovery and API/guide/example access checks pass on both Lisps. No implementation test failures were observed. Hosted Windows/Linux GUI, actual OS session routing and graphical Cadre remain unverified; do not claim full native event class coverage. Continue C1 with scoped ID mutation/routing semantics, then native type/origin and ownership prerequisites.") (:heading 2 "Scoped event-ID mutation and routing (2026-10-28)") (:p "ABI 20 extends EVENT-ID to a generic saved/current reader and context-only SETF. Signed32 bounds apply; native SetId permits -1 as literal metadata, while binding filters and synthetic initial IDs keep their existing -1 restriction. Status/output separation preserves negative IDs. Snapshot construction uses a private identifier slot; no mutable snapshot accessor is introduced.") (:p "Native ID changes affect later exact/range matching without changing windows, filters or earlier snapshots, restarting dispatch or promising local callback order. Parent-routing tests establish order structurally and verify matching, Skip/consumption, wildcard behavior, queued delivery, signed bounds and current/ nested/expired context isolation. The standalone example verifies original and forwarded snapshots and releases its resources.") (:p "Independent review found no remaining actionable issues. Focused example/tests and all 37 GUI scenarios plus preflight pass locally on SBCL/CCL. Python and pinned inventory regressions and five rebuilt relocated-package checks pass. The 138-entry docset covers all 101 exports, guides and eighteen examples, with zero checker problems and actual export/SETF lookup, isolated-install discovery and guide/example navigation checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next define native type/origin contracts without permitting tag mutation to authorize unsafe native casts; broader ownership remains C1 work.") (:heading 2 "Read-only native event type and origin identity (2026-10-28)") (:p "ABI 21 adds generic EVENT-ORIGIN-ID and current-context EVENT-NATIVE-TYPE reads. Origin is an opaque registered bridge identity, not a native pointer or public receiver. Null/untracked origins map to NIL. Native lookup compares identities without dereferencing the origin, captures at each callback and grants no ownership, liveness or historical pointer-lifetime guarantee. Saved snapshots remain readable after cleanup; context readers preserve nested/expired isolation. Null/untracked native-origin branches are not exercised by the public synthetic API, which always supplies a known receiver; that validation gap remains open. Type/origin writers remain open because unchecked tags can authorize invalid native casts, and arbitrary origin pointers need retention/lifetime contracts.") (:p "The runnable example distinguishes native child origin from parent binding receiver. Tests cover all supported kinds, standalone/application identity, nested contexts, cleanup and absence of public writers. Independent review found no remaining actionable issues. Focused example/tests and all 38 GUI scenarios plus preflight pass locally on SBCL/CCL. Python and pinned inventory regressions and five rebuilt relocated-package checks pass. The 141-entry docset covers all 102 exports, guides and nineteen examples, with zero checker problems, actual export/SETF lookup, isolated-install discovery and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next implement event-category metadata before typed mutation and native ownership prerequisites.") (:heading 2 "Native event-category metadata (2026-10-28)") (:p "ABI 22 adds EVENT-CATEGORY for snapshots/current contexts and EVENT-CATEGORY-MASK for compiled :UI/:USER-INPUT/:SOCKET/:TIMER/:THREAD/:ALL values. Mask lookup loads the native library without starting a GUI session. Category reads are immutable or innermost-context scoped; no virtual override/setter/selective pump is added.") (:p "Verification exposed two gaps between pinned interface docs and implementation: ALL31 assertion failed because installed3.2.12 includes internal32/64 bits and returns127. The mapping now queries compiled constants, preserving ALL exactly. A focused test also corrected the assumption that command/notify inherit UI: native wxCommandEvent overrides to USER_INPUT, omitted in interface docs. Close family remains UI. Retain these for C7 reconciliation without exporting internal category names. Public bits do not imply socket/timer/thread event bindings. The generator rejected initial per-enumerator status records because it groups this enum body in one source entry; mappings were corrected to its exact pinned entries.") (:p "Independent review found no remaining actionable issue; its stale assertion-message note was corrected. Focused example/regressions and all 39 GUI scenarios plus preflight pass locally on SBCL/CCL. Python/inventory regressions and five rebuilt relocated package checks pass. The 145-entry docset covers all 104 exports, guides and twenty examples with zero checker problems, actual export/SETF lookup, isolated installation/discovery and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next implement bounded registered-tag mutation using actual native class checks; preserve session fallback isolation and reject incompatible tags before broader native ownership/origin-retention contracts.") (:heading 2 "Bounded registered native tag mutation (2026-10-28)") (:p "ABI 23 adds context SETF EVENT-NATIVE-TYPE: registered source+target, same family, actual wxCommandEvent without wxNotifyEvent for command tags or wxNotifyEvent for notify tags. Built-in/session/unknown/incompatible tags reject before mutation. Snapshots report actual current tags; binding identities retain registration tags. The writer never changes native class/storage, restarts dispatch or guarantees local callback delivery/order. Native origin and arbitrary tag writers stay open.") (:p "An initial focused test incorrectly required an old-tag local observer after mutation; the backend rematched the changed tag and skipped it. That ordering assumption was removed. Parent routing verifies changed tags with structural order for synchronous/queued delivery. Command/notify checks also cover rejected targets, unchanged state after failure, veto after change and nested/expired contexts. Public APIs cannot create a mismatched native object with a registered tag; actual-class rejection is statically reviewed, not directly exercised.") (:p "Independent runtime/documentation review found no remaining actionable issue. All 40 GUI scenarios plus preflight pass locally on SBCL/CCL, as do focused example/regressions, Python/inventory tests and five relocated-package checks. The 147-entry docset covers all 104 exports, guides and twenty-one examples, with zero checker problems, actual export/SETF lookup, isolated discovery/install and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, actual OS session delivery and graphical Cadre remain unverified. Next define origin retention and persistent native event ownership contracts; preserve actual-class checks and isolated session fallback.") (:heading 2 "Larger owned-event construction, cloning and dispatch batch (2026-10-28)") (:p "ABI 24 adds OWNED-EVENT, MAKE-EVENT, CLONE-EVENT, DESTROY-EVENT and EVENT-ALIVE-P. Native-backed CLOS initialization supports subclass slots/defaults/AFTER hooks and mixed-resource rollback. Clone construction preserves source state over inherited payload defaults; factory calls reject explicit payload overrides. Direct MAKE-INSTANCE :CLONE-FROM uses source state over all payload initargs. Owned objects remain session-registered until explicit destruction or cleanup; there is no GC finalizer. An independent clone, queue copy or processing copy survives disposal of its source. Snapshots remain immutable; contexts remain innermost-callback scoped. EVENT-KIND/FAMILY/TEXT/INTEGER are generic and native command text/integer SETF now accepts owned values and current contexts.") (:p "Only exact wxCommandEvent/wxNotifyEvent/wxCloseEvent classes clone. Borrowed userdata/client pointers reject, native origin is detached, and effective string payload is captured before origin removal. Copy dispatch attaches its receiver as native origin; no source ownership is transferred. Native session event copies still require isolated standalone receivers. Arbitrary origin writes/retention, native derived classes, generic wxObject wrappers and direct transfer remain gaps.") (:p "Implementation verification caught a renamed BOA snapshot field mismatch, an overstrict clone-payload check that rejected inherited default KIND, and a rollback test that needed to pump asynchronous wxFrame destruction. Independent review found mixed OWNED-EVENT/EVENT-HANDLER ancestry could overwrite handles; both construction paths now reject it before allocation. Review also found lazy wxEVT_TEXT GetString can read a text-entry origin instead of stored payload: context text SETF rejects tracked text-entry/unknown origin cases, detached clones freeze effective text, and owned text-change copies reject text-entry receivers before emission. Existing keyword synthetic behavior is unchanged.") (:p "Docset generation initially caught a missing class syntax field; it was added before rebuilding.") (:p "Final batch inventory: 109 exports, 69 named generics, 20 generic SETF writers, 41 GUI scenarios, 154 docset entries and twenty-two example sources. Independent runtime and documentation reviews pass after resolving the findings above. All 41 local GUI scenarios and native preflight pass on SBCL and CCL. The five rebuilt relocated-package checks pass. Python/inventory regressions and actual export/SETF lookup checks pass; docset checker reports zero problems, with isolated installation, discovery and API/guide/example access verified on both Lisps. Evidence is in " (:code "evidence/owned-events/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/owned-events-20261028/") ". Two user-authorized subagents handled documentation/coverage and expanded tests in parallel; independent review remained separate. One test-only STRING= arity error was corrected before passing checks. Hosted Windows/Linux GUI, real OS-session delivery and graphical Cadre remain unverified, as do safe-public-API-inaccessible null/untracked origins and incompatible actual-class rejection branches. Next define explicit origin retention/ownership or another prerequisite C1 slice before widening pointer-bearing native events; retain no unchecked native pointer.") (:heading 2 "Pending posting, consuming transfer, local copies and cancellation (2026-10-28)") (:p "ABI 25 adds POST-EVENT (GUI wxPostEvent/AddPendingEvent copy), TRANSFER-EVENT (genuine wxQueueEvent handoff), PROCESS-EVENT-LOCALLY (independent local copy) and DELETE-PENDING-EVENTS (one non-application receiver, no callbacks). Post and local processing preserve the source; transfer validates before consuming it, then removes bridge ownership before native handoff. No rollback or delivery guarantee exists after handoff. Session-isolated receivers, exact supported classes and lazy wxEVT_TEXT/text-entry receiver restrictions remain in force.") (:p "Local processing avoids normal outer global-filter/parent/application fallback, retaining native local pre-processing/chain behavior. Target deletion rejects the borrowed application handler and callback/pump/RUN use, removes pending events without bindings/callbacks, then synchronizes wxApp's pending-handler membership. Native DeletePendingEvents alone leaves that list entry, so the wrapper uses RemovePendingEventHandler from the implementation header. It is not present in the pinned documentation interface and must remain a C7 reconciliation dependency, not an asserted public binding. wxAppConsole::DeletePendingEvents and per-handler ProcessPendingEvents remain unbound; the latter requires a nonempty target queue without a safe public per-handler pending query. Existing app-wide processing is unchanged.") (:p "Final batch counts: 113 exports, 73 named generics, 20 generic SETF writers, 42 GUI scenarios, 160 docset entries and twenty-three examples. Independent runtime and documentation review pass. Local native static/default handlers can still execute under local processing, as clarified in the guide/reference. All 42 GUI scenarios plus native preflight pass locally on SBCL and CCL. Five rebuilt relocated-package checks pass. Python/inventory regressions, actual export/SETF lookup, isolated docset installation/discovery and API/guide/example navigation pass; the docset checker reports zero problems. Evidence is in " (:code "evidence/pending-events/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/pending-events-20261028/") "; package: " (:code "dist/wxlambda-form-pending-events") ".") (:p "An initial script reused the package text buffer while appending API methods, temporarily replacing lisp/api.lisp and causing CLASS-NOT-FOUND on example load. The committed source was restored and only the intended 28 new lines reapplied; the example and all subsequent checks pass. Expanded regression tests passed on both Lisps on their first run. Two user-authorized subagents handled docs/coverage and regressions in parallel, with independent review separate. Hosted Windows/Linux GUI, actual OS-session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Next continue C1 origin retention/ownership or handler-chain prerequisites; worker posting, arbitrary native pointers and global queue cancellation remain gaps.") (:heading 2 "Managed standalone handler chains (2026-10-28)") (:p "ABI 26 adds NEXT-HANDLER/PREVIOUS-HANDLER generic readers and SETF, plus HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER. Sources/peers are owned standalone handlers only; borrowed window/app inputs reject before mutation. Reciprocal vacant endpoints can join whole segments, existing links are idempotent, and self/cycle/occupied-endpoint attempts reject unchanged. SETF NIL splits one edge; UNLINK splices neighbors and leaves the node alive. Native ownership remains session-owned. A session map strongly roots canonical wrappers until explicit destruction, rollback or cleanup so peer lookups return EQ original subclasses.") (:p "Reads are callback-safe under lifetime guards. All structural writes reject RUN/pump/callback use. Linked callback-time destruction rejects; outside callbacks native destruction unlinks/splices normally, while unlinked callback disposal retains existing deferral. Normal/local/pending dispatch traverses native chains; disabled nodes do not disable followers. Chain-node traversal follows next links; callback order within one node is still native behavior. Queues belong to target nodes, not all future chain observers. Native session tags remain isolated from app fallback. Constructor rollback cleans created resources/canonical roots, not arbitrary edits to external graph state: native Unlink can leave surviving prefix/suffix segments joined after the failed node is removed.") (:p "The pinned setter prose forbids NULL, while implementation setters and native Unlink permit paired pointer clearing. NIL is a bounded reciprocal detach mapping, not a one-sided raw setter; retain the discrepancy for C7 reconciliation. Native Push/Pop/Remove, borrowed chains, external adoption and arbitrary origin retention remain open.") (:p "Final counts: 117 exports, 77 named generics, 22 generic SETF writers, 43 GUI scenarios, 166 docset entries and twenty-four examples. Independent runtime and documentation review pass with no actionable findings. The example and expanded focused regressions pass on SBCL and CCL without implementation/test corrections. All 43 local GUI scenarios plus native preflight and five rebuilt relocated-package checks pass. Python/inventory regressions and actual export/SETF lookup pass; docset checker reports zero problems, including isolated install, discovery and API/guide/example navigation on both Lisps. Evidence: " (:code "evidence/handler-chains/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/handler-chains-20261028/") "; package: " (:code "dist/wxlambda-form-handler-chains") ". Two user-authorized subagents handled regressions and docs/coverage in parallel, with separate independent review. Hosted Windows/Linux GUI, actual OS-session delivery, graphical Cadre and previous inaccessible pointer/class-mismatch branches remain unverified. Next define borrowed window handler-stack ownership before widening chain peers or adding Push/Pop; preserve reciprocal identity, session lifetime and dispatch mutation restrictions.") (:heading 2 "Managed window handler stacks and explicit routing (2026-10-28)") (:p "ABI 27 adds WINDOW-EVENT-HANDLER, PUSH/POP/REMOVE-EVENT-HANDLER and copied PROCESS-WINDOW-EVENT/LOCALLY. Push requires unlinked unattached owned standalone handlers and preserves bridge native ownership/canonical roots. Default pop and remove detach alive; deleting pop releases registry ownership before native Pop(true) deletion and clears roots/bindings. Empty pop rejects; valid detached or other-window remove probes return NIL without native assertion. Getter returns canonical pushed handler or the identical window when empty, never an adopted external native pointer.") (:p "All structural stack operations reject RUN/pump/callback use. Attached nodes reject general next/previous reads/SETF and Unlink, avoiding exposure of borrowed window tails; IsUnlinked returns false. Attached handler destruction removes it before outside-callback deletion; linked/attached callback deletion rejects. All eight concrete native widget types use internal managed destructors that Pop(false) before wxWindowBase teardown, so handlers survive actual window or ancestor destruction independent of destroy-event Skip/enabled flags. A destroy request is not completed detachment; asynchronous native deletion still applies. Session finish detaches stacks before window cleanup. Native window teardown requires stack removal and does not take deleting ownership of these handlers. Constructor rollback cleans resources, not arbitrary restoration of external edits.") (:p "Explicit window processing enters managed pushed stacks; generic/local/queued window APIs retain wxEvtHandler stack bypass. Copy origin is the window and snapshot receiver can be a pushed handler. Session binding/delivery on attached handlers rejects; push also rejects active session bindings or queued session events, tracked until native processing/deletion. No real OS session event, worker facility, arbitrary SetEventHandler or native virtual Lisp hook is added.") (:p "An initial C++ variable-shadow build error was corrected before example checks. Coverage validation rejected approximate ProcessWindowEvent source lines; exact pinned declarations at lines 2669/2682 were used before regeneration. Broad focused regression/example passes both Lisps (quiet-run.kZR9FBII), covering all eight widget destructors/parent cascade with disabled event processing, session guards, pending delivery after detachment and rollback directions. Public wxEVT_DESTROY binding is absent: consuming a real destroy notification remains untested, while ManagedWindow destructor cleanup is structurally independent of observer Skip.") (:p "Final counts: 123 exports, 83 named generics, 22 generic SETF writers, 44 GUI scenarios, 174 docset entries and twenty-five examples. Independent runtime and documentation reviews pass with no remaining actionable findings. All 44 local GUI scenarios plus native preflight pass on SBCL and CCL. The five rebuilt relocated-package checks pass. Python/inventory regressions, actual export/SETF lookup, isolated docset install/discovery and API/guide/example reading pass; checker reports zero problems. Evidence: " (:code "evidence/window-handler-stacks/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/window-handler-stacks-20261028/") "; package: " (:code "dist/wxlambda-form-window-handler-stacks") ". Two user-authorized subagents handled tests and docs/coverage in parallel; independent review remained separate. Hosted Windows/Linux GUI, native OS-session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 external stack adoption/retained origin or other lifetime prerequisites before exposing arbitrary borrowed native chains.") (:heading 2 "Command payload views and bounded origin clearing (2026-10-28)") (:p "ABI 28 adds EVENT-EXTRA-LONG and raw EVENT-SELECTION-P saved/current/owned readers; extra LONG SETF uses signed native LONG bounds, is independent of signed32 integer and drives raw IsSelection (nonzero extra flag). It is not a kind/index-validity predicate: a native choice event can have extra0 and flagfalse. Owned construction accepts command/notify-only :EXTRA-LONG; keyword synthetic dispatch does not. Clone source state wins defaults and factories reject explicit clone extra overrides.") (:p "EVENT-CHECKED-P/EVENT-SELECTION become uniform kind-specific generic views while preserving snapshot meanings. Live checked SETF is :TOGGLE-only, generalized bool stored as 0/1; selection SETF is :SELECTION-only, NIL as -1 or nonnegative signed32 index. Raw integer writes can expose other negatives; only -1 maps to NIL. Direct setters change event fields, not control setters/item lists; later handlers can react, so whole-dispatch control state is not guaranteed unchanged.") (:p "Clear-only EVENT-ORIGIN-ID SETF accepts NIL. Owned/actual-null origins are idempotent; non-null current origins require registered compatible command/notify native class. Built-in/nonregistered non-null origins reject, even if the bounded reader returns NIL for untracked state. No object is dereferenced, retained or destroyed; source receiver and old snapshots stay unchanged, later snapshots can capture NIL. Arbitrary new origins, retained objects and user/client-data ownership remain gaps.") (:p "Verified counts: 125 exports, 87 named generics, 26 generic SETF writers, 45 GUI scenarios, 178 docset entries and twenty-six examples. Independent runtime, documentation and final test-adjustment reviews found no actionable issues. Both local Lisp GUI suites and native preflights pass, as do five relocated package checks, sixteen Python tests, twelve coverage-inventory tests, and the focused example/regressions on both Lisps. Docset checking reports zero problems; actual public exports/SETF coverage, isolated installation, discovery, symbol lookup and guide/example access pass. Reports: evidence/command-event-payloads/{sbcl,ccl}-20261028-final/ and evidence/packaging/command-event-payloads-20261028/; package: dist/wxlambda-form-command-event-payloads.") (:p "The initial full-suite run caught an obsolete origin test asserting no writer exists. Updated it to require the new live writer and verify saved snapshots remain immutable; independent review passed and both full suites were rerun. Hosted Windows/Linux GUI, actual OS session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 retained origin/client/userData lifetime or broader native class prerequisites; do not equate raw flags with full derived payload semantics.") (:heading 2 "Managed handler Lisp client-data roots (2026-10-28)") (:p "ABI 29 adds EVENT-HANDLER-CLIENT-DATA/SETF for standalone handlers, windows and the managed application. A native wxClientData subclass owns only a numeric root token; the Lisp session table retains the actual object by EQ. NIL clears, replacement/clear releases prior roots, and failed candidate assignments remove their root. No constructor initarg, Lisp/native pointer exposure, event payload, per-item client data, generic wxClientData wrapper or untyped binding is added.") (:p "Foreign non-null typed objects and all untyped/Void storage modes (even NULL raw pointer) reject untouched. Fresh None/typedNULL read NIL. Private native interfaces on managed App/StandaloneHandler/ManagedWindow expose protected m_clientDataType before GetClientObject because wxEvtHandler has no public mode getter. Retain that implementation-header dependency for C7; do not export the protected field. Native asynchronous destruction can retain Lisp roots until actual deletion and next client/generic cleanup, rollback or session end; the session table clears after finish. Detached pushed handlers keep their own datum; deleting handlers or windows releases their separate association. Returned ordinary Lisp references remain valid. Immutable snapshots do not capture handler client data.") (:p "Verified counts: 126 exports, 88 named generics, 27 generic SETF writers, 46 GUI scenarios, 181 docset entries and twenty-seven examples. Independent runtime/harness and documentation reviews pass. Both local full GUI suites and native preflights, the example/focused regressions on SBCL and CCL, five relocated package checks, sixteen Python tests and twelve coverage-inventory tests pass. The native foreign typed/untyped/voidNULL regression passes with zero captured wx assertions (quiet-run.xAmVX0T2). Build the optional WXLAMBDA_BUILD_NATIVE_TESTS target wxlambda-client-data-native from tests/client-data-native.cpp; commands are in docs/HANDLER-CLIENT-DATA.md. The local separate build used /private/tmp/wxlambda-client-data-native-build and the pinned /opt/homebrew/opt/wxwidgets@3.2/bin/wx-config-3.2.") (:p "Docset checking reports zero problems, with actual public-export/SETF coverage, isolated installation, discovery, symbol lookup and guide/example access verified. Reports: evidence/handler-client-data/{sbcl,ccl}-20261028/ and evidence/packaging/handler-client-data-20261028-final/; final package: dist/wxlambda-form-handler-client-data-final. An early Python run preceded the API reference update and failed its export-reference consistency checks; the final run passed after documentation generation. No runtime test failures occurred. Hosted Windows/Linux GUI, actual OS session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 event/userData, retained-origin or broader client-data ownership contracts explicitly; this handler slot does not complete generic client containers or derived control item data.") (:heading 2 "Per-binding Lisp user-data associations (2026-10-28)") (:p "ABI 30 adds BIND-EVENT :USER-DATA and read-only EVENT-USER-DATA for snapshots, current contexts and safe owned-event NIL reads. Non-NIL values are retained by EQ in callback association roots; native entry-owned wxObject adapters contain only numeric binding tokens. Native scope captures the token before callback and Lisp dispatch frames retain the value, so self/peer unbind and GC do not invalidate active context data. Nested contexts suspend/restore outer lifetime as before. Snapshots preserve the reference after unbind/session end, not a deep immutable copy of mutable contents. No callback arity change or SETF association API exists.") (:p "Handler client data and native command/client/item payloads remain separate. Owned events cannot adopt borrowed binding pointers and current borrowed clones still reject even after self-unbind without dereferencing the freed adapter. NIL-data bindings keep prior clone behavior. Rebind to change associations. For generalized GETF places, bind EVENT-USER-DATA result locally before mutation; initial example direct INCF(GETF(reader)) required nonexistent SETF and was fixed. An initial native harness compile used nonexistent SetEventUserData; test-only internal injection replaced it without widening public APIs. Runtime native/Lisp behavior had no issue from those test/example corrections. Extended optional wxlambda-client-data-native regression checks captured context/self-unbind, expiration and owned borrowed-pointer guards; require zero native assertions.") (:p "Verified counts: 127 exports, 89 named generics, 27 generic SETF writers, 47 GUI scenarios, 184 docset entries and twenty-eight examples. Independent runtime/harness review passes. Documentation review caught stale no-userData scope wording; the old Bind/Unbind and accumulated class scopes were rewritten, regenerated and independently re-reviewed with no remaining findings.") (:p "Both local full GUI suites and native preflights pass, including the final application/custom-command, registered-notify and isolated close/session-family matrix with Lisp zero and list data. No application session events were synthesized. Focused regressions/example pass on both Lisps, as do five relocated package checks, sixteen Python tests and twelve coverage-inventory tests. The extended optional native regression passes with zero wx assertions (quiet-run.dGuk7Wpl), covering captured context tokens after self-unbind, expiry and borrowed-pointer owned/clone rejection. Docset checking reports zero problems; actual public-export and SETF coverage, isolated installation, discovery, symbol lookup and guide/example access pass. Reports: evidence/binding-user-data/{sbcl,ccl}-20261028-final/ and evidence/packaging/binding-user-data-20261028/; package: dist/wxlambda-form-binding-user-data. Hosted Windows/Linux GUI, native OS-session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 retained-origin/native client-item ownership or broader lifetime prerequisites without exposing arbitrary native pointers.") (:heading 2 "Broad GUI selective-depth scope and bounded idle (2026-10-28)") (:p "The user explicitly replaced exhaustive wxWidgets parity with broad GUI coverage and selective depth. Current AGENTS/README/roadmap/generator text now separates native factual status from core/planned/on-demand/Lisp-native/deferred feature priorities. C1–C7 are inventory categories, not delivery order; pending native APIs are not automatic release blockers. Dated ledgers preserve earlier goal language as superseded history. Representative form/editor, tree/list manager and drawing/ monitoring applications define acceptance; selected platform claims require reports. The immediate post-idle vertical slice is menus/actions plus standard dialogs, not additional ownership/utilities unless that GUI feature actually needs them.") (:p "ABI 31 adds native :IDLE/family :IDLE snapshots/current/owned resources, idle-only RequestMore SETF, zero-argument global IDLE-MODE/SETF restored at finish, own-window wxWS_EX_PROCESS_IDLE property preserving other bits, and GUI-thread WAKE-UP-IDLE without inline pumping. Native mode/visibility/app rules control automatic idle; explicit synthetic delivery bypasses that policy. ProcessPendingEvents does not generate idle, while ProcessEvents can Yield/ProcessIdle. Bound work and stop RequestMore when finished; no timer/busy-loop/count guarantee. CanSend is absent from the pinned interface and is not mapped. Owned MORE-REQUESTED-P initargs are idle-only, source state wins clone defaults and keyword synthetic dispatch adds no new payload option.") (:p "The inventory regression initially retained an assertion for the superseded full-parity requirement; it was replaced with feature-priority/status-separation checks before final validation.") (:p "Verified counts: 131 exports, 92 named generics, 30 generic SETF writers, 48 GUI scenarios, 190 docset entries and twenty-nine examples. Independent runtime/native-harness and roadmap/idle-documentation reviews pass. Documentation review found an omitted wxIdleEvent constructor attribution on OWNED-EVENT; fixed and rechecked. No runtime regression failures occurred.") (:p "Both local full GUI suites and native preflights pass, including the final idle window-stack/user-data integration tests. Focused regressions/example pass on SBCL and CCL; native regression passes with zero wx assertions (quiet-run.e4oXnAfe). Mode restoration on ordinary finish is runtime-tested; exception-path restoration is statically reviewed rather than fault-injected. Thirteen inventory tests and sixteen Python tests pass. Five relocated package checks pass. Docset checking reports zero problems, with actual public-export and SETF coverage, isolated installation, discovery, symbol lookup and guide/example access verified. Reports: evidence/idle-events/{sbcl,ccl}-20261028-final/ and evidence/packaging/idle-events-20261028/; package: dist/wxlambda-form-idle-events.") (:p "Hosted Windows/Linux GUI, real OS-session delivery, graphical Cadre and previous inaccessible pointer/class-mismatch branches remain unverified. Native omissions remain factual inventory entries, not automatic blockers for unrelated GUI work. " (:b "Next batch: menus/actions plus standard dialogs for the form/editor workflow,") " with only the value/lifetime prerequisites that feature needs. The earlier saved native-only idle checkpoint is now integrated; do not reapply its patch.") (:heading 2 "Frame menus and actions (2026-10-28, verified)") (:p "ABI 32 adds the menu portion of the selected everyday-GUI vertical slice. MENU-RESOURCE is abstract; native frame-owned MENU-BAR/MENU/MENU-ITEM resources use native-backed CLOS and generic factories with :PARENT, subclass hooks and rollback. Menu/tab labels, normal/check/separator items, per-bar unique positive IDs, counts/kind/identity, scalar label/enabled/check updates and explicit destruction are bounded managed interfaces. The native owner tree invalidates descendants independently of Lisp GC. Structural edits reject callbacks/pumps/RUN; scalar edits remain available during callbacks. No adoption, reparenting, popup, submenu/radio group or generic native ownership interface is added.") (:p "Built-in :MENU command callbacks use the existing frame ID/range/user-data/context protocol. EVENT-CHECKED-P reads/writes :MENU/:TOGGLE raw command metadata without looking up or synchronizing resource state. ACTIVATE-MENU-ITEM uses native frame ProcessCommand; check resources toggle before callbacks, disabled items return NIL, separators reject. Normal native commands can carry integer -1, so raw EVENT-CHECKED-P can be true on a normal item; resource CHECKED-P is check-only. OS menu selection and accelerators remain separate verification. Normal/check label/help validation and separator option restrictions are documented in docs/MENUS.md.") (:p "Independent native review identified a P2 ABI-boundary issue: menu-label string reads needed the common metadata_string catch-all and stale-error clearing, rather than the narrower manual exception path. The implementation now uses the shared boundary; the native regression passes with zero wx assertions (quiet-run.A3Ze5r3X). Documentation review corrected built-in type enumeration, managed-menu origin identities, stale menu liveness scope and obsolete app idle/ propagation gaps. Initial docset construction caught missing MENU-RESOURCE syntax; that signature was completed. The actual-package export/class check then caught the abstract MENU-RESOURCE entry missing its required Construction section (quiet-run.8UQaBuEp); an explicit abstract construction/error contract was added, and all four menu class records now include Construction sections. Standard static docset checks alone did not catch this actual-class requirement. An initial test accumulator DEFVAR missing NIL was corrected in the tests; no runtime failure was attributed to that test setup.") (:p "Verified counts: 146 exports, 103 named generics, 31 SETF generics, 49 GUI scenarios, 30 examples and 207 docset entries. Independent runtime/native and documentation reviews pass after the corrections above. Both local full GUI suites and native preflights pass on SBCL and CCL, including menus and the final label boundary fix. Focused tests and the example pass on both Lisps; the native regression reports zero wx assertions (quiet-run.A3Ze5r3X). Thirteen inventory tests, sixteen Python tests and five relocated package checks pass. Actual-package export/class/SETF checks and isolated docset installation, discovery, symbol lookup and guide/example access pass; the docset reports zero problems.") (:p "Evidence: evidence/menus/{sbcl,ccl}-20261028-final/ and evidence/packaging/menus-20261028/; package: dist/wxlambda-form-menus. Manual OS menu selection/accelerator input, hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Standard dialogs are the next selected GUI slice; menu radio/submenu/popup depth remains on-demand rather than an automatic blocker for that next feature.") (:heading 2 "Modal text-entry and single-choice dialogs (2026-10-28, verified)") (:p "ABI 33 adds abstract DIALOG(window), native-backed TEXT-ENTRY-DIALOG and SINGLE-CHOICE-DIALOG, keyword-only factories, modal show/end/state and generic title/text value/choice selection accessors. Parent is optional; strings are Unicode without NUL, choice items nonempty with valid index(default0). Native styles/position are fixed. Direct subclass construction, defaults/AFTER hooks, initialization rollback and managed window invalidation follow existing contracts. Construction sections are required for all three class docset records.") (:p "SHOW-MODAL permits entry from menus/RUN/pumps/callbacks but rejects nested modal loops and already shown dialogs. Outer contexts suspend during native modal processing; inner callbacks retain scoped lifetime. Unhandled callback errors cancel then re-signal after unwind; locally caught nested notifier errors can recover. Active dialog/ancestor destruction rejects until SHOW-MODAL returns, even after END-MODAL makes native IsModal false. Explicit manual pumping/lifecycle and structural menu edits remain guarded. These dialogs are modal-only; generic SHOW-WINDOW/SHOWN-P writers reject. END-MODAL is raw result assignment, not button validation/transfer. Native GetValue/GetStringSelection stored/cache timing must not be mistaken for live edit/index synchronization. See STANDARD-DIALOGS.md.") (:p "A macOS exploratory wxMessageDialog/FileDialog cancellation probe hung past the five-second watchdog even with IsModal false; these families are deferred until a safe native cancellation bridge exists. Text/choice cancellation completed promptly in the bounded probe. This is evidence about that local probe only. No message/file public API, graphical acceptance or cross-platform claim is made.") (:p "The final native modal close guard consumes current-dialog close and cancels it; ancestor close is consumed, while public CLOSE-WINDOW on a protected ancestor rejects. This supplements direct destruction guards against queued/native close. An initial example used a two-argument observer without :WITH-CONTEXT; the primary arity error correctly cancelled/unwound the modal loop without a hang, and the example callback was corrected to the one-argument observer contract.") (:p "Verified counts: 158 exports,110 named generics,34 SETF generics, 50 GUI scenarios,31 examples and221 docset entries. Independent runtime/native harness and documentation reviews pass. Documentation review clarified explicit parent normalization (hidden requested parent retained; NIL truly parentless) and outer-context suspension throughout the modal boundary. Native data-transfer semantics were verified with actual OK-button handler dispatch separately from raw END-MODAL. The initial test wrong-parent fixture used an incorrect MAKE-EVENT call and was corrected so it exercises the intended receiver rejection.") (:p "Pre-repair checks, retained as historical evidence: focused regressions and the bounded example pass on SBCL and CCL (quiet-run.0emq63UB / quiet-run.JjAYhbfH). Both full 50-scenario GUI suites and native preflights pass (quiet-run.AOqbKVam); the watchdog-bounded native harness passes with zero wx assertions (quiet-run.16uKkU8j). Thirteen inventory tests, sixteen Python tests and five relocated package checks pass. Actual-package export/class/SETF checks and isolated docset installation, discovery, symbol lookup and guide/example access pass; docset checking reports zero problems. Evidence: evidence/standard-dialogs/{sbcl,ccl}-20261028/ and evidence/packaging/standard-dialogs-20261028/; package: dist/wxlambda-form-standard-dialogs.") (:p "The interactive START prompt/physical input, hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified; EXERCISE and native modal accept/cancel paths were automated. Native message/file panels are not delivered: complete a tested cancellation approach (platform bridge or documented generic implementation) next, preserving callback/lifetime guarantees. Continue selected GUI breadth without exhausting unrelated event/native utility declarations.") (:heading 3 "Late scheduled-deletion review finding (repaired and verified)") (:p "After the first green 50-scenario runs, a direct native probe found that an ordinary wxFrame::Destroy request can enter wxApp's scheduled-deletion list while IsBeingDeleted still returns false. A child SHOW-MODAL incorrectly entered its loop under that queued-for-deletion ancestor and hit the five-second watchdog (quiet-run.g92SgChO). Prior green reports did not cover this branch and do not establish the repair.") (:p "The repair combines bridge pending markers with the public wxApp::IsScheduledForDestruction query and validates the complete native ancestor chain for window/resource availability and modal preflight. Handler/menu liveness also follows the owning native hierarchy. A regression queues parent deletion before SHOW-MODAL and requires rejection before modal entry. This helper is a public wxWidgets interface dependency, not a private C7 implementation-header dependency and not a new exported general deletion-list query. Native rebuild and zero-assert harness now pass (quiet-run.isHjwh64 and quiet-run.ybnY3Eko). The harness proves both public Destroy and direct native ScheduleForDestruction on a parent reject child SHOW-MODAL before loop entry, leave output unchanged/no active modal and make parent/child/menu liveness false. The bridge deferred-destroy marker survives through native Destroy via RAII cleanup. Independent review clears the repair. Final expanded focused regressions pass on SBCL and CCL (quiet-run.RA2WbLD1), including immediate and callback-deferred parent Destroy before modal entry. Both full 50-scenario suites and native preflights pass after the repair (quiet-run.QKI5KW29). Thirteen inventory tests, sixteen Python tests, five relocated package checks and actual-export/class/SETF checks pass. The 221-entry docset reports zero problems; dedicated installation, discovery, symbol lookup and guide/example access pass. Final reports: evidence/standard-dialogs/{sbcl,ccl}-20261028-final/ and evidence/packaging/standard-dialogs-20261028-final/; final package: dist/wxlambda-form-standard-dialogs-final. Earlier pre-repair artifacts/reports are retained for diagnosis, not as proof of the corrected lifetime behavior.") (:heading 2 "Generic message/file workflows (2026-10-28, verified)") (:p "ABI34 adds MESSAGE-DIALOG and FILE-DIALOG via explicit wxGenericMessageDialog/ wxGenericFileDialog backend, with no :BACKEND selector. Native OS NSAlert/NSPanel remain unbound; prior watchdog probe evidence is retained, not erased by generic support. Both native-backed DIALOG/WINDOW families preserve direct CLOS/defaults/ AFTER/rollback, hidden/parentless requested-parent normalization and scheduled receiver/ancestor deletion guards. Both new class entries have Construction sections. Generic message body/buttons and file mode are immutable; path/filter index use generic SETF. File path/directory pathnames convert via native namestring; path getter is current native state, not accepted-result or content-IO proof.") (:p "Message results extend SHOW/END-MODAL with offered YES/NO; CANCEL is always a safe unwind. File selection is single-only with validated description/pattern filters, mode-appropriate must-exist/overwrite flags and directory preflight. Raw END-MODAL still bypasses UI validation/transfer and existence/overwrite enforcement. Browser New Directory may create directories immediately: no zero-filesystem-effect claim.") (:p "Internal native prompts are redirected to generic message dialogs through a workflow modal hook. Depth scopes suspend borrowed contexts; errors/public cancellation unwind inner prompts before outer dialogs sequentially. A native probe ending all nested loops at once hung; the supported bridge instead waits for each inner unwind before ending the outer loop. Inner user Cancel returns to the outer workflow normally. Handled notifying errors at the same depth may recover; errors across a new modal boundary cancel the workflow. Cancellation requested before native loop entry is remembered. Public nested SHOW-MODAL remains forbidden. Native property calls that open internal prompts use the same safety boundary.") (:p "Implementation dependencies: generic implementation headers/protected eager message control creation (for AFTER-hook native properties), native modal-hook overrides, generic HasFdFlag and restoring file SAVE/OVERWRITE bits that overlap Cocoa wxDialog button styles. Public inventory equivalents remain partial; generic classes absent from the pinned documentation interface are not invented as full public declarations. See MESSAGE-FILE-DIALOGS.md for supported scope.") (:p "Independent documentation review corrected inherited dialog class scopes to distinguish deferred platform-native backends from supported generic message/file workflows. The END-MODAL contract explicitly rejects successful outer completion while an internal prompt is active; only CANCEL requests whole-workflow unwind. Example checks pass both local Lisps (quiet-run.9i9bojKS). A focused CCL fixture thread-scope issue is test setup, not a runtime finding; final regressions pass on both Lisps. The private native-depth helper now checks active application before FFI access, preserving out-of-session notifier errors without unloaded symbol lookup.") (:p "A late private error-handoff review hardened the interval after a synchronous notifier captures a condition but before Lisp receives it: native code could otherwise open another prompt while callback dispatch was suppressed. Every CFFI callback error now sets a private native latch; CHECK-CALLBACK-ERROR clears it before rethrow. The modal hook skips new native/generic prompts while pending, and SHOW/constructor helpers drain the primary condition before UI/allocation. No public exports/counts or general native error-state API are added. Native rebuild (quiet-run.6HQUrMhC) and zero-assert harness (quiet-run.boeZUNDg) prove latched native/generic prompt suppression and re-enabled prompting after clear. Final post-handshake suites pass all 51 scenarios on both SBCL and CCL (evidence/message-file-dialogs/{sbcl,ccl}-20261028-final/). Focused handoff and recovery regressions also pass both (quiet-run.gvmBf8Al). Independent runtime review found no outstanding actionable findings. Five package checks pass (evidence/packaging/message-file-dialogs-20261028/); package: dist/wxlambda-form-message-file-dialogs. No native IO-race/allocation-failure injection coverage is claimed.") (:p "Verified counts: 167 exports, 115 named generics, 36 SETF generics, 51 GUI scenarios, 32 examples and 232 docset entries. Actual-export/class/SETF checks, zero-problem docset validation, isolated install/discovery/lookup and 16 Python tests pass. Physical interactive START, hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next compose form/editor menu open/save workflows with Lisp-native document models/content IO; exhaustive native event depth is not a prerequisite.") (:heading 2 "Decisions") (:list (:item (:p "D1 (superseded) The former complete-wxWidgets objective treated bounded releases"))) (:p "as intermediate and every native gap as required; retained as historical context.") (:list (:item (:p "D11 Current goal is broad GUI coverage with selective depth. Feature policy and"))) (:p "representative-app acceptance govern delivery; C1–C7 are inventory categories and native pending entries are not automatic release blockers.") (:list (:item (:p "D2 Gate editor support on prototype evidence because main-thread integration"))) (:p "remains unproven; rejected: making release completion depend indefinitely on SLIME/SLY.") (:list (:item (:p "D3 Accept both existing lifecycle limits for the first release because restart"))) (:p "support and destruction notifications require separate lifecycle designs; rejected: silently expanding their scope.") (:list (:item (:p "D4 Pause GUI processing during debugging because nested event dispatch adds"))) (:p "reentrancy risks; rejected: implicitly pumping events inside the debugger.") (:list (:item (:p "D5 Default the application REPL to the host debugger and require explicit"))) (:p (:code ":on-error :report") " for automatic recovery because interactive diagnosis needs live evaluation restarts; rejected: silently discarding restarts by default.") (:list (:item (:p "D6 Defer editor integration and scheduling for the first release because thread"))) (:p "probes do not establish a persistent editor/debugger workflow; rejected: advertising SLIME/SLY support from single-request thread checks.") (:list (:item (:p "D7 Ship the packaging example as a separate SBCL runtime/core with sibling"))) (:p "native libraries because relocation can patch/sign the runtime without modifying an appended Lisp core; rejected: a single Mach-O/core executable for this first packaging example.") (:list (:item (:p "D8 Use public CLOS wrapper classes and generic widget operations because the"))) (:p "user requested Lisp dispatch and specialization before further expansion; rejected: continuing ordinary functions with native-only type dispatch.") (:list (:item (:p "D9 Use native-backed INITIALIZE-INSTANCE construction and canonical SETF"))) (:p "properties because the user requested a ground-up CLOS API without backward compatibility; rejected: factory-then-CHANGE-CLASS construction and legacy setter/receiver compatibility scaffolding.") (:list (:item (:p "D10 Name the mutable properties " (:code "text") " and " (:code "label-text") " because the same"))) (:p "names read naturally for reads and SETF writes; rejected: get-prefixed readers and compatibility aliases during ground-up API development.") (:p "Implement these as separate reviewable changes, beginning with baseline corrections and REPL regression tests. Platform work can proceed alongside local development when runners become available.") (:heading 2 "Persistent document form (2026-10-28, verified)") (:p "examples/document-form.lisp composes the existing controls/menus/generic dialogs into a persistent form. No native binding or public library export changes; ABI34, 167 exports, 115 named generics and 36 SETF generics remain. The new guide and example bring the docset to 234 entries and 33 examples; full GUI runner now has 52 scenarios. The UTF-8 four-line format is parsed without the Lisp reader. Complete reads precede UI installation; writes stage a unique sibling before replacement. Dirty state compares fields to their loaded/saved baseline. Open/vetoable Close offer Save, Discard or Cancel; failed/canceled Save blocks replacement/close. Busy guards reject reentrant commands; forced closing follows native defaults without prompts. No durability, metadata preservation, external-change detection, undo/autosave or cross-platform atomic replacement is claimed. This is a form, not a multiline editor.") (:p "Independent review found native chooser strings parsed as Lisp pathname syntax, which could reinterpret literal backslashes/wildcards and select a different file. Fixed with UIOP:PARSE-NATIVE-NAMESTRING and native basename formatting/preselection; literal native filename tests cover the original risk. Re-review has no outstanding actionable findings. Focused both-Lisp checks pass (quiet-run.GDQdEPGc), including real idle-canceled save, unsaved-close and error dialogs, resumed outer close veto, scripted save-before-open, failed IO/state preservation and temporary cleanup. One initial menu test exposed observer Skip semantics; example menu bindings now consume their routed commands contextually. A CCL test-only nonstandard character name was replaced by CODE-CHAR. Runner unit result count was corrected for the new scenario plus native preflight. Final review also aligned reader CR/LF rejection with writer validation; the malformed-name regression preserves controls/path. Re-review is clear. All 52 GUI scenarios plus native preflight pass both Lisps (evidence/document-form/{sbcl,ccl}-20261028-final/, quiet-run.Nt0AVng9). The final CR/LF fix landed during that suite; a separate post-fix focused run passes both (quiet-run.ex5y1flw), including example EXERCISE and actual dialog adapter loops. Five package checks pass (evidence/packaging/document-form-20261028/, quiet-run.icnlYsqk); package: dist/wxlambda-form-document-workflow. This packages the existing form executable, not the new standalone example/docs. Docset build, zero-problem check, isolated install/discovery/lookup and actual 167-export/class/ SETF coverage pass with 234 entries on both Lisps; 16 Python unit checks pass (quiet-run.j9tqt7YB). Generated docset rebuilt after final source/note edits.") (:p "Native inventory statuses stay unchanged: this Lisp composition does not bind wxDocument/wxDocManager or native streams. Hosted Windows/Linux, physical interactive input, graphical Cadre, allocation/IO-race injection and real OS session delivery remain unverified. Next selected slice: bounded text clipboard support, preserving Lisp-native document/model semantics rather than draining native document APIs.") (:heading 2 "Text clipboard and form Copy/Paste (2026-10-28, verified)") (:p "ABI35 adds CLIPBOARD-TEXT (zero-argument generic reader and generic STRING SETF), CLIPBOARD-TEXT-AVAILABLE-P and FLUSH-CLIPBOARD. Counts: 170 public exports, 116 named generics, 37 SETF generics, 53 GUI scenarios, 34 examples and 239 docset entries. The standard clipboard is selected internally, with primary preference restored; no PRIMARY API, raw Open/Close, Clear, clipboard class or data-object ownership is exposed. Each successful open closes on success/failure; already-open and reentrant access reject. Native event-context borrowing is suspended during transfer; callback conditions rethrow only after cleanup and take precedence over native errors. Read distinguishes NIL/no supported text from available empty text, copies explicit UTF-8 lengths and rejects NUL. Writes replace all formats and do not auto-flush; Flush returns false for unsupported/unsuccessful persistence. No rollback of prior clipboard side effects or cross-platform exit persistence is claimed.") (:p "Native harness substitutes an in-memory clipboard only in the regression executable; production has no injection export or compiled test override. It covers Unicode, empty/no-text/large data, legacy fallback, Open/GetData/SetData failures, foreign locks, PRIMARY restoration, nesting, malformed arguments, worker rejection and flush results. Ownership paths are separately exercised: pinned MSW/OLE failure leaves caller ownership; reviewed GTK/macOS ownership differs. Native test passes zero wx assertions (quiet-run.j3pnPBPK); main bridge build passes (quiet-run.aY6xRyn0).") (:p "Lisp focused tests pass both runtimes (quiet-run.vFvOcvJ6): copied data, generic writer return/type/NUL behavior, error text preserved across rooted-binding cleanup, callback-condition precedence and form Copy/Paste dirty/multiline/empty handling. Automatic tests never read or replace system clipboard content: only the live availability query runs; all transfers use native/Lisp doubles. START is interactive; EXERCISE is availability-only and runs in the focused scenario. The persistent form adds Edit Copy/Paste name through the existing busy/error handling, without native selection/Cut or keyboard editing guarantees.") (:p "Independent review is clear after fixing accidental script-buffer API-file truncation (before Lisp testing), error-text loss across callback cleanup, MSW/OLE failure ownership, generic SETF protocol and platform-specific mock ownership defaults. Test fixture parentheses and inventory class expectations were corrected during verification. Regenerated inventory +13 checks and 239-entry zero-problem docset pass (quiet-run.f8mcDrYL). All 53 GUI scenarios plus native preflight pass both Lisps (evidence/clipboard/{sbcl,ccl}-20261028-final/). Five package checks pass (evidence/packaging/clipboard-20261028/, quiet-run.gUAcIsCn); package: dist/wxlambda-form-clipboard. This packages the existing form executable; new standalone example/docs remain repository/docset deliverables. Actual 170-export, class/SETF reference coverage, 239-entry zero-problem checker, isolated install/ discovery/lookup and 16 Python unit tests pass (quiet-run.Kn00BV6A). Native harness retains a preexisting typeid/side-effect compiler warning unrelated to this change; zero runtime wx assertions are required and pass. Docset rebuilt after final notes.") (:p "Live system clipboard writes, external-app interoperability/exit persistence, physical interactive START/menu input, hosted Windows/Linux GUI, graphical Cadre and allocation/IO-race injection remain unverified. The isolated tests do not imply those passed. Next selected slice: bounded multiline text-control construction and basic editing semantics for the editor, not native document/stream parity.") (:heading 2 "Multiline text and basic editing (2026-10-28, verified)") (:p "ABI36 extends TEXT-CONTROL construction with :MULTILINE (NIL default) and :EDITABLE-P (T default), preserving native-backed CLOS defaults/subclass AFTER hooks/rollback and thin :CLASS factories. Six new generic names expose immutable TEXT-MULTILINE-P, mutable TEXT-EDITABLE-P, TEXT-SELECTION and TEXT-INSERTION-POINT, TEXT-LAST-POSITION and notifying REPLACE-TEXT. Counts: 176 exports, 122 named generics, 40 SETF generics, 54 GUI scenarios, 35 examples, 247 docset entries.") (:p "The existing text constructor/getter/setter ABI now carries explicit UTF-8 lengths; constructor/SETF/replacement reject NUL rather than truncating. Whole-value SETF stays silent by default; :NOTIFY T and native Replace deliver text-change events. Read-only disables native user typing, not explicit Lisp mutations. Text offsets are native positions (Unicode units/CRLF bookkeeping), never Lisp string indices. Selection SETF accepts exactly two ordered nonnegative in-bounds integers; caret SETF requires an in-bounds integer. Signed-64-bit Lisp bounds prevent CFFI wrapping; native last-position checks protect narrowing to long. No -1 sentinels, GetRange, selection clipboard/Cut, undo/redo, rich text or arbitrary styles are exposed.") (:p "examples/text-editor.lisp demonstrates multiline text, append-at-native-end, replace-selection, user-editability toggle and bounded EXERCISE. The existing form stays single-line; its document file format is not a multiline editor format. Native raw-argument/UTF8/flags/pointer/range/type/stale-handle tests pass with zero wx assertions; focused SBCL+CCL CLOS/editor tests also pass (quiet-run.zLjI2XS3). Additional both-Lisp checks pass empty replacement/deletion/no-op, multiline notifying SETF, nested borrowed-context suspension/resumption and callback-time control disposal (quiet-run.fuWLIe4U). Callback errors preserve completed mutations and allow later recovery. Failed initializer cleanup was tested via saved native ID: querying an incomplete wrapper's removed handle correctly signals instead.") (:p "Independent runtime/source/docs review found no runtime issues; one stale native class-scope description was corrected. Pinned inventory+13 checks and zero-problem 247-entry docset pass (quiet-run.3zboBIhT). Final regenerated inventory+13 checks, 247-entry zero-problem check, isolated install/discovery/lookup, actual 176-export/ class/SETF coverage on both Lisps and 16 Python unit tests pass (quiet-run.Xq6VYoW3). All 54 GUI scenarios plus native preflight pass both Lisps: evidence/text-editing/{sbcl,ccl}-20261028-final/. Five package checks pass: evidence/packaging/text-editing-20261028/ (quiet-run.Y76XoIUJ); package: dist/wxlambda-form-text-editing. The package is the existing form executable; the new multiline example/docs remain repository/docset deliverables. Final header comments document the stricter 0/1 notification flag and native query fields. Docset rebuilt after final session-note edits.") (:p "Physical typing/selection, IME/grapheme behavior, hosted Windows/Linux GUI, graphical Cadre, a full multiline document application and live clipboard interop remain unverified. Next selected slice: bounded notebook navigation for broader everyday GUI coverage; deeper text/selection/undo APIs remain demand-driven.") (:heading 2 "Notebook navigation (2026-10-28, verified)") (:p "ABI37 adds native-backed NOTEBOOK and thin MAKE-NOTEBOOK construction, setup-time ADD-NOTEBOOK-PAGE for fully initialized direct PANEL children, canonical NOTEBOOK-PAGE, page count and generic SETF page labels. Existing SELECTION specializes on notebooks: silent ChangeSelection by default, native vetoable SetSelection with :NOTIFY T. Requested assignment is returned even when vetoed; query actual selection. Counts: 182 exports, 127 named generics, 41 SETF generics, 15 window wrapper classes (13 concrete + WINDOW/DIALOG abstract bases), 55 GUI scenarios, 36 examples, 255 entries.") (:p "Native ownership protects attached page panels from direct destruction; notebook/ ancestor teardown invalidates descendants. Page additions require quiescence outside RUN/pump/callback/modal contexts; no removal/reorder/reparent/icons or arbitrary styles. Page self-attachment during its initializer rejects to preserve rollback. Wrappers are rooted before native publication so synchronous AddPage callbacks can resolve canonical pages; successful adoption survives a contained callback condition. Native caption mnemonic/length behavior is port-dependent, not exact arbitrary echo.") (:p "Two built-in notify event kinds :NOTEBOOK-PAGE-CHANGING/:NOTEBOOK-PAGE-CHANGED preserve snapshots/context/user-data/propagation contracts. EVENT-SELECTION reads actual wxBookCtrlEvent metadata (not inherited GetInt); CHANGING semantics are port-dependent, with pinned Windows old-page caveat. Only CHANGING veto affects navigation. No old selection accessor, metadata selection writing, owned/synthetic/clone support yet. There are eleven bindable built-ins but only nine constructible built-ins. Dynamic registered-kind numbering now begins after both notebook kinds; ABI check protects mismatched libraries. No native event record field or Lisp snapshot slot was added.") (:p "Bridge selection/AddPage and native/propagated notebook callback guards protect same-book reentry and ancestor destruction/close; synchronous modal/clipboard entry rejects until return. Native modal hook also suppresses internal prompt entry during navigation; deleting-origin page callbacks are suppressed. Independent review caught the initial setter-only guard gap: actual user page events now get origin-based guards in generic binding dispatch. Native regression dispatches actual derived wxBookCtrlEvent outside a setter and through frame propagation, proving those checks.") (:p "Native harness and both focused Lisp suites pass (quiet-run.9BgHkFBL) with zero wx assertions. It checks page identity/publication, native events/veto, invalid indices/ ownership/labels, modal/clipboard/reentry guards, synthetic/clone rejection, callback error recovery and constructor rollback. Test-body parentheses and Boolean Unbind expectations were corrected; inventory owner parsing was narrowed to avoid assigning wxBookCtrlEvent methods to wxBookCtrlBase. Independent final docs review corrected eleven-built-in wording and qualified unchanged-notification behavior as CHOICE-only. Regenerated inventory+13 checks and 255-entry zero-problem docset pass (quiet-run.9QbVfXJN). Final 55-scenario suites plus native preflight pass both Lisps: evidence/notebook/{sbcl,ccl}-20261028-final/. Final regenerated inventory+13 checks, 255-entry zero-problem checker, isolated install/discovery/lookup, actual 182-export/ class/SETF coverage on both Lisps and 16 Python unit tests pass (quiet-run.BJXkcP6u). Five package checks pass (evidence/packaging/notebook-20261028/, quiet-run.dApyEmEn); package: dist/wxlambda-form-notebook. This packages the existing form executable; the new notebook example/docs remain repository/docset deliverables. Docset rebuilt after final session-note edits.") (:p "Physical tab/keyboard input, caption/native CHANGING behavior on hosted Windows/Linux, graphical Cadre, a full multi-document editor and external clipboard interoperability remain unverified. Next selected slice: single-selection list boxes, broadening the tree/list-manager workflow without native container/document parity prerequisites.") (:heading 2 "Single-selection list boxes (2026-10-28, verified)") (:p "ABI38 adds LIST-BOX, thin MAKE-LIST-BOX, ITEM-COUNT, generic ITEM-TEXT/SETF, APPEND-ITEM, DELETE-ITEM and CLEAR-ITEMS. Existing SELECTION and ON/OFF-SELECTION specialize on lists. Unsorted single selection only; initial finite proper string list/index or NIL, direct/subclass CLOS/defaults/AFTER hooks and managed rollback. Explicit UTF-8 byte lengths validate NUL and native arrays. Empty/duplicate labels are valid. Counts: 189 exports, 133 named generics, 42 SETF generics, 16 window wrapper classes (14 concrete+2 abstract), 56 GUI scenarios, 37 examples, 264 entries.") (:p "Append/rename preserve selection. Deleting the selected row clears it; deleting an earlier row shifts the selected index down one. Clear resets all. Item mutations are silent via temporary wxEventBlocker and restore managed handler-stack identity. :NOTIFY T selection emits one synthetic native list-selection event after state change, including unchanged/NIL assignments. Default writes are silent. No sorting, multiselect, item client data, arbitrary styles/virtual models or stable native IDs. Lisp domain models remain responsible for stable identity across item/index edits.") (:p "Two command kinds :LISTBOX-SELECTION/:LISTBOX-DOUBLE-CLICK carry cached string/index payloads and raw action metadata. They support snapshots/contexts, contextual and owned cloning, synthetic/owned dispatch including non-list handlers. Payload writes do not change native items/selection. There are thirteen bindable built-ins, eleven constructible built-ins and seven command kinds. Registered numbering starts after both list types; ABI version protects mismatched libraries. No event record field or immutable Lisp snapshot slot was added.") (:p "Independent review found a GTK activation post-callback native-widget dereference: list-origin generic/propagated/convenience callbacks now protect list/ancestors from destruction/close and reject modal/clipboard/native-loop entry until callback return. Deleting-origin events suppress; non-list synthetic targets remain allowed. Item edits and nested selection remain allowed. The native probe dispatches actual list commands outside setters across all three callback paths, including callback append/delete/clear and cloning. It passes with zero wx assertions, alongside both focused Lisp suites (quiet-run.3HU3EgDp). Initial selection now also blocks native selection events before publication. Additional standalone synthetic receiver and handler-stack tests distinguish metadata behavior from control model changes.") (:p "examples/list-manager.lisp wires Append/Rename/Delete/Clear and selection/activation feedback; bounded EXERCISE runs real native list operations. Context snapshots stay unchanged after callback item edits, and handled callback errors preserve completed selection while allowing recovery. Independent API review corrected choice-only receiver/payload descriptions; shared ctrlsub inventory mappings were merged with existing CHOICE selection mappings instead of duplicated. Inventory+13 checks and 264-entry zero-problem docset pass (quiet-run.Cr9JSlAg). Final native rebuild/harness and all 56 GUI scenarios plus preflight pass both Lisps (quiet-run.CDYTWOPL): evidence/list-box/{sbcl,ccl}-20261028-final/. Final inventory+13 checks, 264-entry zero-problem checker, isolated install/discovery/lookup, actual 189-export/class/ SETF coverage on both Lisps and 16 Python unit checks pass (quiet-run.NmqyAM64). Five package checks pass (evidence/packaging/list-box-20261028/, quiet-run.FoJpsHAo); package: dist/wxlambda-form-list-box. This packages the existing form executable; the new list-manager example/docs remain repository/docset content. Final reference-field cleanup lists all thirteen native event types and broadened selection receiver classes; docset rebuilt after those/session-note edits.") (:p "Physical mouse/keyboard activation, scrolling/accessibility, hosted Windows/Linux, graphical Cadre, full tree/list-manager workflows and external clipboard interop remain unverified. Next selected slice: bounded tree navigation and managed item ownership; deeper list/data-view/virtual models stay demand-driven.") (:heading 2 "Tree navigation and managed item views (2026-10-28, verified bounded scope)") (:p "ABI39 adds TREE-CONTROL, borrowed TREE-ITEM views, MAKE-TREE-CONTROL, root/child creation, canonical root/parent/ordered child traversal, item text/expansion SETF, item liveness, subtree deletion and EVENT-TREE-ITEM. Native-backed widget CLOS construction/defaults/AFTER hooks/rollback remain; borrowed item construction rejects. Counts: 202 exports, 144 named generics, 44 SETF generics, 17 window wrapper classes (15 concrete+2 abstract) plus borrowed TREE-ITEM, 57 GUI scenarios, 38 examples, 279 docset entries. Event snapshots/FFI records append one checked tree-item token; matching ABI39 library/FFI required. Native item pointers are never adopted/exposed.") (:p "Native registries track owner/parent/children with monotonic checked tokens; explicit subtree invalidation, native delete hooks and early ManagedWindow destructor cleanup invalidate IDs before reuse. A live-owner registry suppresses native-base teardown callbacks. Lisp canonical views are session-rooted and revision-pruned after deletion/ normal boundaries/rollback, then cleared on cleanup. Failed Lisp publication deletes the newly created node. Snapshot identity may outlive item validity/text: retain/copy labels while live, and query liveness only within an active session.") (:p "Visible-root single selection only. AddRoot silently selects root; append preserves selection. Nonempty selection writes require a same-tree item; NIL is empty no-op only. Native notifying SelectItem is vetoable; silent default uses blockers. Collapse promotes a selected descendant to the collapsed node. Delete preserves outside selection or picks surviving parent/root; root deletion empties. No native clear/ hidden-root/multiselect, images/item data, label editing/drag/drop, virtual model or all-tree-event depth. Item mutations from separate button callbacks are supported; same-tree writes and modal/clipboard/pump entry defer during selection callbacks.") (:p "Independent review found missing session cache binding (fixed before item tests), and generic tree UnselectAll/current/deferred-idle selection differences. The bounded nonempty selection contract and synchronous valid fallback normalization eliminate wrapper-induced delayed idle notifications. Tests check collapse/deletion after PROCESS-EVENTS. The actual native wxTreeEvent + propagated parent probe checks item metadata, protected lifetime/mutation/native-loop gates and clone/synthetic rejection. Native raw arguments, cross-tree checks, native delete invalidation, non-reused bridge tokens and raw native-base teardown pass with zero wx assertions (quiet-run.cIMIOvYM). Focused SBCL+CCL tree/veto/ownership/idle/rollback tests pass (quiet-run.fLHGjdo3). An initial direct ASDF load command lacked system registration; normal example/test loading registers the local ASD before load. Final tests include immediate rollback cache pruning and the example's item-text edit.") (:p "Two native notify kinds :TREE-SELECTION-CHANGING/:TREE-SELECTION-CHANGED carry managed view metadata. Only CHANGING veto affects navigation. EVENT-SELECTION remains NIL for tree kinds; old item/label events and owned/synthetic/clone support are unbound. There are 15 bindable built-ins, 11 constructible built-ins and seven command kinds; registered numbering starts after tree kinds. Inventory+13 checks and 279-entry zero-problem docset pass (quiet-run.bKdLJbq8). All 57 GUI scenarios plus native preflight pass both Lisps (quiet-run.bbsKvOUd): evidence/tree-navigation/{sbcl,ccl}-20261028-final/. Inventory+13 checks, 279-entry zero-problem checker, isolated install/discovery/lookup, actual 202-export/ class/SETF coverage on both Lisps and 16 Python unit checks pass (quiet-run.zn1Gf46J). The final port gate below was added afterward; host implementation behavior is unchanged and post-gate focused/native/package checks pass separately. No whole file-manager or virtual/deep-tree completeness claim is made.") (:p "Physical tree mouse/keyboard/accessibility, large/deep/virtual trees, hosted Windows/ Linux GUI, graphical Cadre, allocation/IO-race injection and clipboard interoperability remain unverified. Next selected slice: splitter windows for a two-pane tree/list manager, rather than exhaustive tree event/data/native pointer depth.") (:p "Late port review found wxQt posts selection events asynchronously with raw item IDs. The reviewed synchronous token/event translation cannot safely cover delayed stale or recycled IDs, so wxQt TREE-CONTROL construction now rejects before allocation until generation-safe async translation is implemented. Native Qt test branch checks that explicit error when built there; Qt-hosted execution remains unrun. Current macOS/generic/GTK/MSW implementation paths retain scope; hosted GTK/MSW still need runtime verification. Post-gate main bridge/native harness, zero wx assertions, focused tree tests on both Lisps and five package checks pass (quiet-run.aoqjFBv1). Final package: dist/wxlambda-form-tree-navigation-final; evidence: evidence/packaging/tree-navigation-20261028-final/. This packages the existing form executable; new tree example/docs remain repository/docset deliverables. Final inventory+13 checks and docset checker pass (quiet-run.jKBReUdM), and the docset is rebuilt/installed after final session notes. Qt-hosted rejection is not claimed run.") (:heading 2 "Fixed splitter panes (2026-10-28)") (:p "ABI40 adds native-backed SPLITTER-WINDOW and once-only attachment of two canonical PANEL children, fixed orientation, bounded sash/minimum properties, gravity and native sash notifications. See docs/SPLITTER.md and examples/splitter-manager.lisp. Counts: 212 exports, 153 named generics, 48 SETF generics, 18 window wrapper classes (16 concrete+2 abstract), borrowed TREE-ITEM, 58 GUI scenarios, 39 examples and 291 docset entries. Attachment is quiescent (outside RUN/pumps/callbacks); no Unsplit/Replace/Initialize or broad splitter parity. Positive minimum and disabled double-click keep panes attached. Candidate panes and native/propagated sash callbacks protect lifetime, same-splitter properties and nested native loop entry.") (:p "Independent code/test review found no remaining actionable bugs after quiescent attachment was enforced. Documentation review corrected factory generic metadata and precise guard scope. Pinned generic native source confirms CHANGING edits/veto require handling; CHANGED occurs after commit and cannot undo it. Native probe exercises actual and propagated changes, -1/veto cancellation, observational CHANGED, invalid ranges, double-click and teardown with zero wx assertions. Focused native and SBCL/CCL tests/example pass (quiet-run.aQqhG6zS). Inventory and 13 coverage checks pass (quiet-run.gHUfcUdl). Five isolated package checks pass (quiet-run.a7fsFAuc): dist/wxlambda-form-splitter, evidence/packaging/splitter-20261028/. The packaged executable remains the form; splitter example/docs are separate repository/docset deliverables. Cadre installation follows docs/DOCSET.md.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: toolbar/status-bar actions for practical application shells. Do not exhaust native splitter methods before proceeding. Physical sash dragging, keyboard/accessibility, hosted Windows/Linux GUI and graphical Cadre remain unverified. The tree-based demo retains the existing wxQt tree gate.") (:p "Final splitter verification: all 58 GUI scenarios pass on SBCL and CCL; evidence at evidence/splitter/{sbcl,ccl}-20261028-final/. All 16 Python checks and actual 212-export/class/SETF docset coverage pass on both Lisps (quiet-run.PS1p1jl4); 291-entry checker, isolated installation, discovery, symbol lookup and guide/example access pass after reviewed documentation fixes (quiet-run.yjJ6MnFp). The initial Python run caught a stale expected result count; corrected to 59 including preflight.") (:heading 2 "Frame toolbar/status actions (2026-10-28, bounded scope)") (:p "ABI41 adds TOOLBAR and STATUS-BAR window subclasses, thin generic factories, fixed normal/check/separator toolbar tools addressed by toolbar-scoped positive IDs, seven stock art choices, explicit once-only REALIZE-TOOLBAR, count and silent generic SETF enabled/checked state, native accepted activation, fixed status field count and generic SETF text. See docs/FRAME-ACTIONS.md and examples/frame-actions.lisp. Counts: 225 exports, 164 named generics, 51 SETF generics, 20 window wrapper classes (18 concrete+2 abstract) plus borrowed TREE-ITEM, 59 GUI scenarios, 40 examples, 306 docset entries. Frame chrome has no user sizers; direct bar deletion is synchronous and quiescent. Frame ownership invalidates bars and failed CLOS initialization cleans up native association/callback roots.") (:p "wxEVT_TOOL aliases wxEVT_MENU; reuse :MENU and action IDs. Native check state toggles before action callbacks; programmatic activation returns accepted T, not native handled status. Actual/native propagated toolbar-origin guards block protected destruction/close, same-toolbar tool-state writes/activation, modal, clipboard and nested dispatch/pump entry. Status feedback remains writable. Status fields are application-owned: frame automatic help updates are disabled. Example consumes toolbar events in a contextual handler and shares action logic with menu events without duplicate propagation or implicit state synchronization.") (:p "Independent review found deferred native bar destruction and teardown callback suppression issues; fixed with synchronous quiescent deletion and early owner registry/pending-destruction guards. A native crash report showed Cocoa restoring old raw tool-pointer placeholders in MacInstallNativeToolbar during toolbar replacement at a reused C++ address. This was not treated as a passing retry. OSX construction now explicitly selects wx's ordinary in-window toolbar backend, restores the previous effective option string and rejects builds lacking system options. Native Cocoa chrome remains unbound. wxSystemOptions cannot publicly remove entries; absent-value restoration as empty can shadow future environment changes, documented in the guide. Native probes test 24 realized/unrealized replacements with prior empty/0/1 values, effective HasOption semantics and actual OnLeftClick propagation outside bridge activation guards. Zero wx assertions, focused tests and example pass on SBCL+CCL (quiet-run.eP4hjhBC). Review also fixed the conditional native-feature probe and documentation SETF/guard/DPI wording.") (:p "Session handoff: continue broad GUI coverage with selective depth. Next selected slice is keyboard accelerators for shared application actions. No dynamic tool removal/reordering, radio/dropdown tools, custom images, status widths/stacks or native Cocoa toolbar customization. Physical clicks/keyboard/accessibility, DPI rendering, hosted Windows/Linux GUI and graphical Cadre remain unverified.") (:p "Final frame-actions verification: main/native builds, zero-assertion native probes and all 59 GUI scenarios pass on both SBCL and CCL (quiet-run.OX3Jjd32); fresh evidence: evidence/frame-actions/{sbcl,ccl}-20261028-final/. Regenerated inventory and 13 coverage checks, 16 Python checks and 306-entry zero-problem docset pass (quiet-run.bCtnmaJC). Actual 225-export/class/SETF lookup checks pass on both Lisps, as do isolated install/discovery/symbol/guide/example access checks (quiet-run.buyztgGM). Runtime counts match the handoff (quiet-run.tMekyyz3). Five isolated package checks pass (quiet-run.OGWexn2d), package dist/wxlambda-form-frame-actions, evidence/packaging/frame-actions-20261028/. The package remains the existing form executable; the new frame-actions example and guides are repository/docset deliverables, not bundled example launchers. Documentation is rebuilt and checked after final evidence notes. Follow docs/DOCSET.md to install for Cadre; graphical Cadre execution remains unrun.") (:heading 2 "Keyboard accelerators for shared actions (2026-10-28, bounded scope)") (:p "ABI42 adds FRAME-ACCELERATORS and generic SETF with copied proper finite lists of (KEY ID &rest MODIFIERS), plus FRAME :ACCELERATORS initarg. Keys: ASCII letters/ digits normalized uppercase, F1..F12; modifiers logical Control, Shift, Alt and raw Control. Ordinary text keys require Control/Alt/raw-Control. Portable IDs 1..32767 avoid Windows WORD/signed-short command truncation. Max256 entries; effective native duplicate chords reject (raw/control alias off OSX). Getter returns fresh nested native-registry data and validates stale/empty frames. No native entry wrappers, borrowed menu pointers, parsers or arbitrary key codes. CMake explicitly requires wxUSE_ACCEL=1. Native entry/table construction and quiescent whole-table replacement prepare data before publication. NIL clears wxNullAcceleratorTable; failed CLOS initialization removes native tables/roots. Counts: 226 exports, 165 named generics, 52 SETF generics, 20 window wrapper classes (18 concrete+2 abstract) plus borrowed TREE-ITEM, 60 GUI scenarios, 41 examples and 309 docset entries.") (:p "Pinned-source review identified platform dispatch differences: OSX/GTK send direct MENU commands with unset origin/default metadata, without menu enabled/check semantics; MSW may resolve matching menu items, honor disabled state and toggle. The new examples/keyboard-actions.lisp uses a shared Lisp model for menu/tool/key actions, gates disabled actions and ignores native checked metadata. Contextual handlers consume commands to avoid button fallback/duplicate action propagation. It does not edit menu labels or own menu/system shortcuts.") (:p "Because no portable native accelerator origin marker exists, all managed MENU callbacks conservatively protect all frames with nonempty explicit tables and their descendants, including callbacks on app/pushed/unrelated handlers and synthetic commands. Modal/clipboard/nested dispatch entry and protected subtree destruction/close reject; status/model feedback remains writable. Clear removes this extra policy; existing toolbar/navigation restrictions persist. Modal Open/Save shortcuts are not complete: defer guarded work until callback return. See docs/KEYBOARD-ACCELERATORS.md for exact scope and Cadre installation link.") (:p "Independent implementation/tests/documentation review found no remaining actionable issues. Its source audit confirmed safe native table copying with null menu pointers, OSX/GTK/MSW command differences and effective modifiers. Focused example/table/rollback/guard tests pass on SBCL+CCL (quiet-run.rJy1SZav). Native key tests enter child OSXHandleKeyEvent CHAR_HOOK directly (not just synthetic MENU dispatch), traverse pushed handlers and frame tables, exercise Control+A, F12 and Alt+0, and verify disabled/check-menu differences, clear/ modal/clipboard restoration, invalid atomic replacement and registry teardown with zero wx assertions (quiet-run.t6ocsNyt). The first coverage validation caught missing wxWindow accelerator-table records due class-owner parsing; exact pinned Get/Set mappings were added and reviewed.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: deferred UI actions after native callbacks, enabling safe modal/clipboard/destructive menu/tool/accelerator workflows before claiming complete Open/Save shortcuts. No global hotkeys, key-event/text-input API, arbitrary key/modifier/string parsing, menu shortcut ownership or deep native accelerator parity. Physical typing/focus, accessibility/layout/input methods, reserved-key conflicts, hosted Windows/Linux key translation and graphical Cadre remain unverified. Synthetic example exercises check action logic only; native CHAR_HOOK tests validate macOS dispatch, not physical keyboard input.") (:p "Final accelerator verification: all 60 GUI scenarios pass on SBCL and CCL (quiet-run.ocLeRhGx), evidence/accelerators/{sbcl,ccl}-20261028-final/. Regenerated inventory+13 coverage checks, all16 Python checks and309-entry zero-problem docset pass; isolated install/discovery/symbol/guide/example access and actual226-export/class/SETF coverage pass on both Lisps (quiet-run.zgRvsN6b). Runtime counts verified (quiet-run.AsCvgs6k). Five isolated package checks pass (quiet-run.2YUAvmvb), package dist/wxlambda-form-accelerators, evidence/packaging/accelerators-20261028/. This packages the existing form executable; the keyboard-actions example and new guide remain repository/docset deliverables. Docset is rebuilt/checked and installed to an isolated destination after these final evidence notes; see docs/DOCSET.md for the standard Cadre installation path. Graphical Cadre unrun.") (:heading 2 "Deferred UI actions (2026-10-28, bounded safe scheduling)") (:p "ABI43 adds opaque immutable UI-ACTION tickets/predicate, DEFER-UI-ACTION, generic CANCEL-UI-ACTION and UI-ACTION-PENDING-P. Session roots retain zero-argument Lisp functions; native FIFO entries contain only numeric tokens and optional checked weak window owners. Max1024 pending entries. Scheduling never calls inline; cancel removes queued work once, execution removes identity before invocation, and active work cannot cancel/interrupt itself. Dead/pending owner or ancestor suppresses delivery; roots retire when expiry is queried/reaped/delivered, not synchronously in a native destructor. Session finish clears native work before window/toolkit teardown and clears Lisp roots on exit.") (:p "Managed App::ProcessIdle calls the toolkit base first, then delivers at most one action per safe idle iteration. RUN/full polling drive work; pending-only event processing does not. Multiple iterations/actions can occur in one full poll. Native-entry depth (thread-local), driver baseline, idle recursion, borrowed context/callback, modal/dialog/clipboard, navigation/tool/accelerator, active action, error and shutdown gates prevent early/reentrant delivery. wxWakeUpIdle requests progress without busy requeueing during blocked modal loops. The ProcessIdle override is present in native headers but omitted from pinned interface declarations; wxApp and wxWakeUpIdle partial scope maps record the internal prerequisite without inventing an inventory entry. No CallAfter/worker/ timer/public native virtual-hook parity is claimed.") (:p "A narrow action-phase exception permits structural operations inside RUN/poll: menus, frame bars, table replacement, notebook/splitter attachment and managed handler structures/pending-event removal. Normal nested event callback guards remain; recursive RUN/pumps/finish reject. Modal/clipboard/destructive work is safe in the outer action; current modal callbacks still use END-MODAL directly since deferred actions wait until a modal exits. Action errors preserve the original condition, pause later queued work and rethrow at outer RUN/poll. Following work remains pending for recovery within the session. Nonlocal exits are converted to contained errors before crossing the FFI boundary.") (:p "Example: examples/deferred-actions.lisp queues shared menu/tool/keyboard file selection, text copy and confirmed close. It reports a selected path without file IO; automatic EXERCISE injects chooser/clipboard/confirmation functions. Separate tests use actual generic message/file dialogs with cancellation, test sequential modal non-reentrancy, safe structural operations under RUN and polling, FIFO, cancellation, owner/root expiry, stale contexts, error-pump/error-RUN, nonlocal exit and shutdown. Native tests force idle in callbacks/synchronous operations/modal loops, verify queue capacity, pending-error pause and cleanup, and transfer UTF-8 through an isolated MemoryClipboard fixture. System clipboard text remains untouched by automatic tests; live queries are availability only.") (:p "Independent implementation/documentation review found one threading defect: central status() incremented a global native-entry counter before rejecting wrong-thread calls. It is now thread-local; concurrent rejected worker probes verify GUI counter isolation. DEFER validates native main-thread entry before mutating Lisp roots. Enqueue wakes before publishing its record, so failed wake/ allocation cannot leave orphan work. Review wording fixes clarify modal actions are allowed, owner pruning is observed, and structural SETF sections name the safe-phase exception. No remaining actionable findings.") (:p "Counts: 231 exports, 167 named generics, 52 SETF generics, 20 window wrappers (18 concrete+2 abstract), borrowed TREE-ITEM and immutable UI-ACTION ticket, 64 GUI scenarios (four deferred-action modes), 42 examples, 316 docset entries. Focused normal both-Lisp tests pass (quiet-run.vVzXbIrn); initial native probes and both-Lisp error-pump/error-RUN/nonlocal modes pass (quiet-run.5mzzVu9q). Main/native rebuild, reviewed TLS/worker/isolated clipboard native probes, regenerated inventory+14 coverage checks, 16 Python checks and zero-problem 316-entry docset pass (quiet-run.Tv4bdjcR).") (:p "Session handoff: broad GUI coverage with selective depth remains the goal. Next selected slice: compose deferred Open/Save/Copy/Paste/close requests into the persistent document form with toolbar and keyboard action entry points. No background workers, timers/deadlines, promise/future or transactional rollback API. Physical input, hosted Windows/Linux GUI/clipboard interoperability, arbitrary allocation/IO-race injection and graphical Cadre remain unverified.") (:p "Final reviewed native build/probes and all64 GUI scenarios pass on SBCL+CCL (quiet-run.zf8ajJSU); fresh evidence: evidence/deferred-actions/{sbcl,ccl}-20261028-reviewed/. Both-Lisp actual231-export/ class/SETF coverage, runtime counts, 316-entry zero-problem docset, isolated install/discovery/symbol lookup and guide/example access pass after documentation review fixes (quiet-run.iqV75sWj). Five isolated package checks pass (quiet-run.rEEbiJ7F); package dist/wxlambda-form-deferred-actions, evidence evidence/packaging/deferred-actions-20261028/. This remains the existing packaged form executable; the new deferred-action example/guide are separate repository/ docset deliverables. Rebuild/check/install docset after final evidence notes; standard Cadre install instructions remain docs/DOCSET.md. Manual/hosted checks listed above were not run and no physical clipboard/interoperability claim is made.") (:heading 2 "Deferred document-form shell integration (2026-10-28)") (:p "The persistent form now composes existing ABI43 APIs for shared deferred Open, Save, Save As, whole-name Copy/Paste and close actions across menus, a six-action toolbar and configured keyboard shortcuts, with application-owned status-bar feedback. IDs12101..12106 fit the portable accelerator limit; logical Control shortcuts are O, S, Shift+S, W, Shift+C and Shift+V. Normal native text-selection Copy/Paste shortcuts are not replaced. No public binding, native ABI or native inventory status changes: 231 exports, 167 named generics, 52 SETF generics, 20 window wrappers plus borrowed TREE-ITEM/UI-ACTION ticket; 42 examples and 316 docset entries. GUI runner grows to65 scenarios plus preflight.") (:p "UI requests share one owner-bound pending ticket and a separate action-active latch; existing busy protects synchronous command execution. First request wins while queued or active, even across different commands. Views disable only during the safe action body (same-toolbar callback writers remain guarded), then restore if the frame survives. Document values/clipboard/dirty state are read at delivery, not at click time. Canceled tickets recover without a stuck latch; disposal and forced/non-vetoable close cancel queued work. Real document IO/validation and clipboard persistence semantics are unchanged.") (:p "Vetoable native close is immediately vetoed and enqueues its decision. Cancel/ canceled save/failure leaves the form alive. Approval retries native close with a scoped flag, consumed in the close handler and cleared in unwind cleanup. A new integration test exposed a preceding handler's Veto+Skip reaching native default destruction on replay; the form now consumes an already-observed veto before the approved branch. The test proves blocked replay does not cache authorization for a later dirty close. This does not promise arbitrary handler ordering or that native close acceptance guarantees destruction. Initial CLOSE-WINDOW returns NIL even for a form later closed by deferred replay.") (:p "Existing file/clipboard workflows pass on both Lisps after adaptation (quiet-run.5aMwpD3U). New tests/document-form-actions.lisp verifies deferred menu/tool/configured-shortcut command paths, exactly-one pending request, coalescing, delivery-time values, cancel recovery, active-command rejection/ disabled views, read/write state, nil/empty/invalid clipboard input, reporter-error cleanup, propagated veto/one-use close approval, forced/disposal cancellation and delivery under RUN (quiet-run.ZD7F9ZM9). Clipboard fixtures do not access system text; actual native default file/message adapters are canceled from idle in tests/document-form.lisp. The example EXERCISE now requests toolbar Save and pumps a scripted cancellation. Native key translation remains separately tested by the accelerator library probes; synthetic form commands are not physical typing.") (:p "Independent implementation/tests/documentation review has no remaining findings. All65 GUI scenarios pass on SBCL and CCL (quiet-run.ytZiIxlo), fresh evidence evidence/document-form-actions/{sbcl,ccl}-20261028-final/. Regenerated unchanged native inventory+14 checks, 16 Python checks and 316-entry zero-problem docset pass (quiet-run.3c6G4u3H). This application composition does not implement or check off native wxDocument/wxDocManager/stream or platform-native dialog APIs.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded UI timers for periodic updates with owner/session lifetime and cancellation, broadening monitoring apps rather than deepening native document/editor parity. Physical menu/tool/keyboard/chooser interaction, hosted Windows/Linux GUI/clipboard interoperability, graphical Cadre and arbitrary allocation/IO-race injection remain unverified. The existing packaged form stays the simple form app; integrated document-form sources/guides are repository/ docset deliverables, not a new binary launcher.") (:p "Final both-Lisp actual231-export/class/SETF coverage and316-entry zero-problem docset, isolated install/discovery/symbol lookup/guide/example access pass (quiet-run.UVOBKfYV). Five existing package isolation checks pass (quiet-run.nHsjeRvG), package dist/wxlambda-form-document-actions, evidence evidence/packaging/document-form-actions-20261028/. The package remains the simple form executable as noted above. Rebuild/check/install docset after final evidence notes; standard Cadre installation is documented in docs/DOCSET.md. No native code changed, so native invariant probes from ABI43 were not repeated for this application-only batch. Physical/hosted/manual checks listed above remain unrun.") (:heading 2 "Bounded UI timers (2026-10-28, verified bounded scope)") (:p "ABI44 adds opaque immutable UI-TIMER tickets/predicate, START-UI-TIMER and generic CANCEL-UI-TIMER/UI-TIMER-ACTIVE-P. Functions take no arguments. Supported interval 1..86400000ms, max256 live registrations; optional weak window owner or session lifetime, periodic default/one-shot mode. No public native timer receiver, raw adoption, restart/interval SETF or Notify override. Counts:236 exports,169 named generics,52 SETF generics,20 window wrappers plus TREE-ITEM/UI-ACTION/UI-TIMER identities,43 examples,69 GUI scenarios (four timer modes),323 docset entries.") (:p "Private wxTimer::Notify only marks one coalesced due tick/wakes idle; it never calls Lisp or erases itself. Repeated native expirations do not create catch-up counts. A shared sequence merges first-due timers with deferred action enqueue order, one work item per safe idle iteration, separate from action queue capacity. Existing native-entry/driver/idle/callback/modal/clipboard/operation/error/shutdown gates remain, with an explicit Notify depth guard. Timer functions inherit the safe structural phase, cannot recursively RUN/pump/finish and do not run while modal/other safe work is active. Periodic functions can cancel themselves or others without retaining a native pointer/iterator across Lisp. One-shot active identity includes due-but-stopped native work, then retires before invocation.") (:p "Native timers run continuously; bridge one-shots stop at their first valid due notification. An initial steady-clock lower bound ignores stale early native notifications assigned to reused timer IDs (MSW), avoiding premature new one-shot retirement without rearming inside Notify. No precision/cadence/deadline claim. Observed owner/ancestor expiry stops/retires without user delivery, with native object/root cleanup at query/reap/idle. Session finish clears timers before window/toolkit teardown. Failed enqueue/start and managed owner initialization rollback release roots. Escaping periodic function errors cancel that registration, pause remaining work and retain original conditions at outer RUN/poll; one-shots were already retired. Nonlocal exits remain contained by shared safe-work boundary.") (:p "Independent source review found that simple '3.2.12 or newer' OSX gating was unsafe: audited official3.3.0/3.3.1 lack the queued-CF-timer validity check present in the3.2.12 cancellation path. OSX timer creation now accepts exact verified wxWidgets3.2.12 only; unverified versions reject before allocation. CMake requires wxUSE_TIMER. Other backends are source-reviewed but hosted GUI unrun. Review confirmed continuous-native/logical-one-shot policy, source lifetime, activity semantics, coalescing/fair ordering and no native pointer across Lisp dispatch. Documentation review has no remaining findings; activity wording explicitly distinguishes periodic functions from one-shot retirement. Re-audit before widening the macOS gate; do not infer safety from version numbers.") (:p "Example examples/periodic-status.lisp updates label/status text and Pause/Resume cancels/creates registrations; EXERCISE uses real native timers, self-stopping after two updates. Focused real periodic/one-shot/modal/self-cancel/RUN/owner/ rollback tests pass on SBCL+CCL (quiet-run.cognRp64). Native probes and error-pump/ error-RUN/nonlocal modes pass (quiet-run.1Rw64sLy). Final main/native builds, zero-assertion native tests and all69 GUI scenarios pass on both Lisps (quiet-run.S28GJs56), evidence/ui-timers/{sbcl,ccl}-20261028-final/. Native probes independently force coalescing, fair action ordering, stale early first ticks, due one-shot state, owner Notify retirement/cleanup, count bounds, worker rejection and shutdown. Automatic tests do not read/replace system clipboard text. Regenerated inventory+14 checks,16 Python checks and323-entry zero-problem docset pass (quiet-run.sKED4wWk).") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded numeric input controls (slider/spin) for everyday forms, rather than exhaustive timer/event/clock parity. Physical input, timer precision/deadline metrics, hosted Windows/Linux GUI, OS clipboard interoperability, allocation-race injection and graphical Cadre remain unverified.") (:p "Final both-Lisp actual236-export/class/SETF coverage and runtime counts,323-entry zero-problem docset, isolated install/discovery/symbol lookup and guide/example access pass after reviewed docs (quiet-run.JkFx8ffz). Five package isolation checks pass (quiet-run.VBklIE0Q), package dist/wxlambda-form-ui-timers, evidence evidence/packaging/ui-timers-20261028/. This remains the existing form binary; periodic-status example and guide are repository/docset deliverables. Rebuild/ check/install docset after final evidence notes; standard Cadre installation remains docs/DOCSET.md. No manual/hosted/timing-precision claims beyond the explicit verification above.") (:heading 2 "Bounded numeric input: sliders and spin controls (2026-10-28)") (:p "Completed ABI45 native-backed SLIDER/SPIN-CONTROL construction, thin generic MAKE-SLIDER/MAKE-SPIN-CONTROL factories, NUMERIC-VALUE/NUMERIC-RANGE generic SETF properties, immutable slider orientation and copied/current EVENT-NUMERIC-VALUE. Strict integer endpoints -1000000..1000000, minimum<maximum and in-range initial/ explicit values bound native arithmetic. Range changes silently clamp; value writes are silent unless :NOTIFY T requests exactly one native-class update. Spin scope is decimal integer/unit arrows without wrap, doubles or raw text APIs. Invalid transient spin edits reject before unsafe native integer conversion.") (:p "Native numeric events remain observation/context only: no owned construction, clone or synthetic dispatch. Spin veto metadata does not undo committed values. Operation guards cover numeric and spin-forwarded TEXT callbacks, same-control writes, owner/ancestor teardown and unsafe nested GUI entry. Silent cross-control writes support synchronized forms. Creation/failure/teardown suppress callback delivery; direct source identity is matched before composite-child traversal. Independent review resolved numeric clone refusal and required wxUSE_SLIDER/ SPINCTRL/SPINBTN configuration checks; no remaining code findings. Documentation review corrected snapshot persistence versus borrowed-context lifetime and event metadata bounds; no remaining findings.") (:p "Example examples/numeric-input.lisp synchronizes signed slider/spin values and narrows both ranges. Native probes use actual slider/spin/text event classes, parent propagation, callback guards, invalid edit injection, teardown and clone refusal. Final main/native builds, zero-assertion native harness and focused both-Lisp example/tests pass (quiet-run.NpKIwS3a). All70 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.f88mbz2I), reports evidence/numeric-input/{sbcl,ccl}-20261028-final/. Runtime macOS wxWidgets3.2.12; GTK/MSW numeric paths source-reviewed, hosted GUI unrun. Physical dragging, arrow clicks, typed edits/IME and graphical Cadre remain unverified.") (:p "Regenerated native inventory/14 checks and16 Python checks pass (quiet-run.7nq9pOZC). Both-Lisp actual public-export/class/SETF checks and counts: 244 exports,175 named generics,54 SETF generics,22 window wrappers (20 concrete+2 abstract),44 examples,333 docset entries. Zero docset problems; isolated install/discovery/symbol lookup and guide/example access pass (quiet-run.6OmJ68Rm), installation docs/DOCSET.md. Five package isolation checks pass in evidence/packaging/numeric-input-20261028/, packaged dist/wxlambda-form-numeric-input. Package remains the established form binary; the numeric example is a separate repository/docset deliverable. Rebuild/check/ install docset after final notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded radio-button groups for mutually exclusive form choices. Continue concrete workflow breadth, independent review and aligned docs/examples/docset/coverage; do not infer full wxWidgets parity or hosted platform validation from inventory partial entries.") (:heading 2 "Bounded mutually exclusive choice groups (2026-10-28)") (:p "ABI46 adds native-backed RADIO-BOX and generic MAKE-RADIO-BOX. A composite wxRadioBox owns fixed2..64 NUL-free string choices, group caption, initial valid zero-based selection and one-column/one-row orientation. Generic SELECTION/SETF, ITEM-COUNT/ITEM-TEXT extend existing APIs; no NIL selection or item mutation. Native mnemonic normalization can change item/event text from supplied labels. Writes are silent by default; explicit :NOTIFY T commits then emits one native command event even unchanged. Physical repeated-selection behavior is port-specific.") (:p ":RADIO-SELECTION exposes copied/current index/native label through existing EVENT-SELECTION/EVENT-TEXT; snapshots survive cleanup, contexts expire on return. Semantic event-selection writes, owned/synthetic events and clones reject. Shared composite input guards (renamed from numeric internals) protect native-origin and propagated callback source/ancestor lifetime, same-group writes and unsafe nested GUI/modal/clipboard entry; silent other-group updates remain supported. Creation/failure/base teardown suppress relevant callbacks. No individual wxRadioButton creation-order grouping, per-item state, raw adoption or full parity.") (:p "Independent review resolved header extern-C placement, copied label inclusion, wxUSE_RADIOBOX/RADIOBTN/STATBOX prerequisites, UTF8 temporary lifetime, shared API reference receiver/snapshot scopes and stale built-in event count. No remaining actionable code/documentation findings. OSX/GTK/MSW/Qt source audit confirms silent SetSelection and native event shape; runtime testing is macOS wxWidgets3.2.12. Physical mouse/keyboard/accessibility, hosted platform GUI and graphical Cadre remain unverified. No automatic system clipboard content reads/writes.") (:p "Example examples/radio-groups.lisp selects export format and displays feedback. Focused SBCL/CCL example/tests, main/native builds and native direct event probes with parent propagation pass (quiet-run.0tCZWYYW), zero native assertions. All71 GUI scenarios plus preflight pass on both Lisps (quiet-run.o2CvK2Iu), reports evidence/radio-groups/{sbcl,ccl}-20261028-final/. Direct native probes independently cover callback guards outside setter operations, cross-group writes, unchanged explicit notification, raw argument errors and teardown/clone refusal.") (:p "Current counts:246 exports,176 named generics,54 SETF generics,23 window wrappers (21 concrete+2 abstract),45 examples and337 docset entries. Regenerated pinned inventory,14 inventory/16 Python checks, zero-problem docset build/check/install, both-Lisp actual export/class/SETF coverage and counts, discovery/symbol/guide/ example reading and five package isolation checks pass (quiet-run.077879Q0). Package evidence: evidence/packaging/radio-groups-20261028/. Final docset regeneration/check/install follows the final handoff notes. Install under dedicated /private/tmp/wxlambda-radio-docsets/wxlambda for isolated discovery/symbol/guide/example checks; normal Cadre install remains docs/DOCSET.md. Package dist/wxlambda-form-radio-groups is still the established form application; the radio example is delivered separately in repository/docset.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded toggle buttons for persistent on/off form/tool options. Older sequential 'next' statements are historical; use this handoff and current feature roadmap rather than exhausting C1-C7 declaration parity.") (:heading 2 "Persistent toggle buttons (2026-10-28)") (:p "ABI47 adds native-backed TOGGLE-BUTTON and generic MAKE-TOGGLE-BUTTON with :parent/:label/:checked, subclass slots/default initargs, native-ready AFTER hooks and managed rollback. Generic CHECKED-P/SETF uses generalized booleans (normalized T/NIL reader, supplied-value writer). LABEL-TEXT/SETF supports NUL-free native labels. Default writes are silent; :NOTIFY T commits and sends exactly one native command update even unchanged. Escaping callback conditions preserve original identity and committed state. No bitmap toggles, grouping, three-state or styles.") (:p "Distinct :TOGGLE-BUTTON-CHANGE kind exposes copied/current EVENT-CHECKED-P and raw integer/native text (normally empty, explicit notify also empty; no inferred label). Snapshots survive session cleanup; contexts require innermost callback. Semantic checked SETF, owned/synthetic events and detached clones reject. Shared Input guards protect actual/propagated source callbacks, same-button state/label writes, ancestor lifetime and modal/clipboard/RUN/pump/safe-idle reentry. Silent other-button updates remain supported. Native create/base teardown suppress relevant callbacks. wxUSE_TOGGLEBTN is required; existing checkbox convenience methods retain their receiver scope without fallbacks.") (:p "Independent code/docs review found no remaining actionable findings. Audited OSX/GTK/MSW/Qt setters are silent, native events carry checked integer and empty text. Rewritten inherited coverage scopes accurately include static-text/toggle label receivers and checkbox/menu/toggle checked reads, preserving restricted semantic writers. Exact tglbtn declarations/class remain partial; bitmap sibling methods are deliberately unbound.") (:p "Example examples/toggle-buttons.lisp demonstrates a persistent preview option and feedback. Focused SBCL/CCL tests/example, final main/native builds and zero- assertion native harness pass (quiet-run.82UxVWWG). Native direct wxEVT_TOGGLEBUTTON probes run outside setter guards, include parent propagation, both checked states, source/ancestor/write/transfer protection, cross-button sync and clone refusal. Lisp tests add Unicode labels, constructor rollback, callback condition identity/ committed state, context expiry and post-session snapshots. Physical input and accessibility, hosted Windows/Linux/Qt GUI and graphical Cadre remain unverified. No automatic system clipboard contents are read/replaced.") (:p "SBCL full72 GUI scenarios plus preflight pass; initial CCL run passed toggle tests and41 scenarios, then tree-navigation printed PASS before exit255 with 'Mach exception / nested deep-stack exception frame: scratch buffer in use'. Preserve evidence/toggle-buttons/ccl-20261028-final/ and quiet-run.MjgkJykD; no cause is established, and no toggle construction occurs in that isolated tree process. All three standalone tree reruns and a fresh full72-scenario CCL suite pass (quiet-run.tqwfiSFd), evidence/toggle-buttons/ccl-20261028-recheck/. Cause of the initial exit remains unknown; do not erase its evidence or attribute it to a particular runtime/native defect without reproduction. SBCL evidence is evidence/toggle-buttons/sbcl-20261028-final/.") (:p "Current counts:248 exports,177 named generics,54 SETF generics,24 window wrappers (22 concrete+2 abstract),46 examples and341 docset entries. Pinned inventory plus 14 checks,16 Python checks and zero-problem docset pass (quiet-run.HPh3GSQP). Both-Lisp actual export/class/SETF checks, counts,341-entry isolated install/ discovery/symbol/guide/example checks and five package isolation checks pass (quiet-run.089XpkBV); install root /private/tmp/wxlambda-toggle-docsets/wxlambda, standard Cadre instructions docs/DOCSET.md. Package dist/wxlambda-form-toggle-buttons is the established form binary; toggle example is separate repository/docset content. Package evidence evidence/packaging/toggle-buttons-20261028/. Regenerate/ check/install docset after final handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded combo boxes for editable/selectable form choices; keep CLOS, callback/lifetime and explicit native-text/value semantics. No native category-wide parity requirement follows from pending C1-C7 inventory entries.") (:heading 2 "Editable combo boxes with fixed choices (2026-10-28)") (:p "ABI48 adds native-backed COMBO-BOX and generic MAKE-COMBO-BOX. Fixed0..256 unsorted nonempty choices must be unique under native CmpNoCase, avoiding known MSW duplicate/case-only ambiguity (not Unicode normalization). Text/value/items reject NUL/CR/LF. Required parent; optional :value or valid :selection index, nonempty initial value+index rejects. Native-backed subclasses/default initargs/ AFTER and managed failure rollback retain the construction contract. No readonly/ sort/style, mutable items, raw adoption or full wxTextEntry/wxComboBox parity.") (:p "Existing generic TEXT/SETF, SELECTION/SETF, ITEM-COUNT/ITEM-TEXT specialize on COMBO-BOX. Text write clears old native selection then silent ChangeValue; native matching/selection readback remains port-specific. Selection index writes set matching text before SetSelection (Cocoa peer doesn't itself promise editor text); NIL clears both text/index. GetSelection is native committed, not open-popup highlighted state. Default writes silent; explicit notify emits exactly1 requested kind even unchanged: :text-change for text, :combo-selection for selection, no additional bridge text update on selection. Original callback conditions re-signal without rolling committed state back. Fixed item getters only, no position/edit or convenience ON-SELECTION/ON-TEXT-CHANGE methods for this receiver.") (:p "New :COMBO-SELECTION exposes copied/current read-only semantic index/native text; owned/synthetic/clones reject for this kind. Existing shared TEXT generic command resources retain their scope. Physical selection can send COMBO then TEXT, with native order/count; no exact notification count is promised for physical input. Shared Input guards cover both actual origins/composite children and propagated callbacks, same-combo mutations, ancestor lifetime, modal/clipboard/GUI/safe-idle entry. Silent other-combo synchronization allowed; constructor/teardown silence and current-context vs copied-snapshot lifetime retained. wxUSE_COMBOBOX required.") (:p "Independent source/code/test/docs review: no remaining actionable findings. Review corrected shared API/inherited receiver scopes and documented lazy source-bound TEXT text-write rejection versus COMBO event metadata writes. Additional native probes for both pass (quiet-run.3tG8pSHt). Source audits OSX/GTK/MSW/Qt confirmed native differences; runtime macOS wxWidgets3.2.12. Physical popup/mouse/typing/IME/key/accessibility and hosted GUI remain unverified, as do graphical Cadre and arbitrary allocation failures. No automatic system clipboard content reads/writes. Example examples/combo-boxes.lisp selects preset destinations or accepts custom text, with separate command/text feedback.") (:p "Focused both-Lisp tests/example, main/native builds and zero-assertion native harness pass (quiet-run.8Sm9bbXW). Direct native COMBO then TEXT probes outside setter operations verify constructor silence, propagated callbacks, guards, NIL clearing and cross-control updates. Lisp tests include fixed item/error validation, matched text without inferred selection claims, CLOS rollback, original callback condition/committed state and post-session snapshots. Full73 GUI scenarios plus preflight pass on SBCL2.6.9/CCL1.13 (quiet-run.BUAAgnTO), fresh reports evidence/combo-boxes/{sbcl,ccl}-20261028-final/. Preserve earlier CCL failure evidence under toggle-buttons; this batch does not establish its cause.") (:p "Current counts:250 exports,178 named generics,54 SETF generics,25 window wrappers (23 concrete+2 abstract),47 examples and345 docset entries. Regenerated pinned coverage inventory/14 checks,16 Python checks, zero-problem docset, both-Lisp actual public export/class/SETF coverage and counts, isolated install/discovery/symbol/ guide/example access and five package isolation checks pass (quiet-run.2oc19wTv). Isolated install root /private/tmp/wxlambda-combo-docsets/wxlambda; normal Cadre install docs/DOCSET.md. Package dist/wxlambda-form-combo-boxes remains the established form binary; combo example is separate repository/docset content. Package evidence evidence/packaging/combo-boxes-20261028/. Final docset build/check/install follows these handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded scrolling panels for larger forms. Continue workflow breadth with explicit native state/lifetime semantics, examples/docs/docset, independent review and recorded limitations rather than exhaustive C1-C7 parity.") (:heading 2 "Scrolling panels for larger forms (2026-10-28)") (:p "ABI49 adds native-backed SCROLLED-PANEL and generic MAKE-SCROLLED-PANEL with :parent/:scroll-rate, direct subclass/default initargs/native-ready AFTER hooks and managed rollback. Native is wxScrolled<wxPanel> alias wxScrolledWindow; Lisp base is WINDOW to retain exactly one native kind. Notebook/splitter PANEL pages can contain a scrolling viewport rather than treating it as another native kind.") (:p "Generic SCROLL-RATE/SETF is a copied exact pair0..256 pixels/unit; zero disables an axis including both zero. SCROLL-POSITION/SETF is native view-start units, requested0..1000000 with native clamping/disabled axes; writer returns supplied list, not accepted position. SCROLL-EXTENT reads fresh virtual pixel pair. Generic FIT-SCROLL-CONTENT requires own sizer, runs Layout/FitInside/Layout and refreshes max(client,sizer minimum) without resizing frame. Existing row/column child layout works; outer viewport uses proportion1/expand. Native focus/resize can move view without bridge writes; rate changes need not preserve pixel origin.") (:p "Explicit mutations check supported current virtual/client/sizer-min dimensions <=1000000 pixels/axis. Existing inherited/native auto-layout is not globally policed; applications must remain within supported content size. No arbitrary huge sizer arithmetic claim. Mutations reject event callbacks; owner-bound deferred UI actions are the supported callback navigation path. InputOperation protects synchronous Scroll/Update/paint work against source/ancestor teardown, modal/clipboard/GUI/safe-idle reentry. Painting remains allowed. No new scroll events, drawing/DC/target/conversion/focus overrides or native pointer adoption. wxUSE_SCROLLBAR required; no fictional wxUSE_SCROLLWIN option.") (:p "Independent review found the private native pushed scroll helper integration limit: managed window-event-handler/Push/Pop/Remove and stack-aware process APIs now explicitly reject for SCROLLED-PANEL, keeping native helper ownership intact. All six rejections are tested; ordinary bindings/child command propagation work. Final code/test/docs review has no remaining actionable findings. Source audit covered generic scrolling/GTK/common window behavior; runtime macOS3.2.12 only. Physical wheel/trackpad/keyboard/focus/accessibility, painting fidelity and DPI/ resize combinations, hosted GUI and graphical Cadre remain unverified. No automatic system clipboard contents are read/replaced.") (:p "Example examples/scrolling-panels.lisp displays24 fields and deferred Back to top. Focused both-Lisp example/tests pass (quiet-run.lmxSNT0a, then stack regression checks in quiet-run.knzGavex before its test-harness compile typo). Corrected final native harness passes with zero assertions (quiet-run.tYu5JzIv). A test-only ScrollWindow override injects a supported callback during actual bridge scrolling to verify operation lifetime/reentry independent of normal callback rejection. Other checks cover copied/validated pairs, clamp/disable, fit/frame size, deferred child callbacks through helper, oversized content, rollback and stale handles. Full74 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.yYb6SRYN), evidence/scrolling-panels/{sbcl,ccl}-20261028-final/.") (:p "Regenerated pinned inventory/14 checks,16 Python checks and zero-problem docset pass (quiet-run.OH87iaVT). Counts:256 exports,183 named generics,56 SETF generics, 26 window wrappers (24 concrete+2 abstract),48 examples and353 docset entries. Both-Lisp actual export/class/SETF coverage and counts, zero-problem isolated install/discovery/symbol/guide/example access and five package isolation checks pass (quiet-run.6q5hFcay). Install root /private/tmp/wxlambda-scroll-docsets/wxlambda; normal Cadre install docs/DOCSET.md. Package dist/wxlambda-form-scrolling-panels remains established form binary; new scrolling example is separate repository/ docset content. Package evidence evidence/packaging/scrolling-panels-20261028/. Final docset build/check/install follows these final handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded focus navigation for keyboard-driven forms. Preserve native operation/lifetime protection, explicit supported scope, independent review and aligned examples/docs/docset/coverage rather than exhausting C1-C7 parity.") (:heading 2 "Focus navigation for keyboard-driven forms (2026-10-29)") (:p "ABI50 adds generic FOCUS-WINDOW (:from-keyboard generalized boolean) and NAVIGATE-FOCUS (:forward generalized boolean, default T) on WINDOW. Native SetFocus/SetFocusFromKbd requests return the receiver; Navigate returns native T/NIL. Shown-on-screen/enabled live receivers are required, including ancestor state. No OS activation or specific focused-child guarantee; native container focus delegation, text selection, traversal eligibility/order/wrapping vary. No focus event resources, global raw focused-window pointer, tab-order edits, NavigateIn/WinChange or native virtual override support is added.") (:p "Callbacks reject direct focus/navigation requests; owner-bound deferred actions provide the supported path. Synchronous native dispatch shares Input operation native-entry gates and additionally protects all session windows against bridge destroy/close, covering previous focus and traversal siblings. Recursive focus operations reject even outside Lisp callbacks. Constructor failure unwinds operation guards. Lisp notifier boundaries preserve original callback conditions without claiming native state rollback. See docs/FOCUS-NAVIGATION.md and example examples/focus-navigation.lisp (Return to name form action).") (:p "Independent code/test/docs review found no actionable findings. Native probes verify virtual ordinary/keyboard dispatch, consumed forward/backward navigation event direction/results, sibling/source/ancestor lifetime protection, recursive navigation and RUN/pump/finish/clipboard rejection, invalid raw flags and guard rollback. Full native harness passes with zero wx assertions (quiet-run.102vhgIe); main/native builds pass (quiet-run.yzHj9xFF/qLQipTbm). Focused SBCL/CCL example/tests pass (quiet-run.ekXsCxyN/6CmvCzkv). Full75 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.KiSBkfJ9/y1oTCuyF), evidence/focus-navigation/{sbcl,ccl}-20261029/. Physical Tab/Shift-Tab, OS focus receipt/activation, accessibility, hosted ports and graphical Cadre remain unverified. No automatic system clipboard contents are read/replaced. Initial sandbox GUI attempt could not connect to macOS GUI services; terminated and reran with GUI access. ASDF cache redirected to /tmp.") (:p "Pinned coverage regeneration and14 checks pass (quiet-run.Fm3ExoIz); its later Python stage initially exposed stale scenario-count expectations. Corrected to75 GUI+1 preflight; all16 Python checks and zero-problem docset check now pass (quiet-run.XeeJJu2g). Counts:258 exports,185 named generics,56 SETF generics, 26 window wrappers (24 concrete+2 abstract),49 examples and357 docset entries. Both-Lisp actual export/class/SETF coverage, isolated install/discovery/symbol/ guide/example checks pass (quiet-run.RuhQ7glk). Isolated install root /private/tmp/wxlambda-focus-docsets/wxlambda; normal Cadre installation under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/) is in docs/DOCSET.md. Package dist/wxlambda-form-focus-navigation remains the established form binary; focus example is repository/docset content. All five package isolation checks pass (quiet-run.BxtIrqFU), with reports under evidence/packaging/focus-navigation-20261029/. Final docset build/check/install follows these handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded tooltips for contextual form guidance. Preserve native ownership/string semantics, callback/lifetime protection and independent review with aligned examples/docs/docset/coverage; no exhaustive C1-C7 parity.") (:heading 2 "Window tooltips for contextual form guidance (2026-10-29)") (:p "ABI51 adds generic TOOLTIP-TEXT/SETF on public WINDOW wrappers. Reads return NIL for no native tooltip and a fresh native text string otherwise, including empty. SETF string attaches/updates copied native text; NIL calls UnsetToolTip and removes the window-owned resource. Inputs accept0..4096 UTF-8 bytes and reject NUL before mutation; byte limits are not Lisp character counts. Native text normalization, hover eligibility/timing/wrapping/composite behavior vary by port. No raw tooltip pointer/class/adoption, global timing/enable/width policy, rich or per-item tooltip API, notification event or common constructor initarg. Native-ready subclass AFTER hooks can use SETF and retain managed rollback.") (:p "Reads are callback-safe; writes/removal reject callbacks and use owner-bound safe-idle actions. Synchronous InputOperation protects receiver/ancestors and blocks recursive tooltip writes, same-window operations using that guard, GUI/ RUN/pumps/finish, modal/clipboard entry and safe-idle delivery. Existing older property setters are not all InputOperation users; no broader mutation claim. CMake requires wxUSE_TOOLTIPS=1, avoiding native disabled-feature no-op behavior. A negative configuration gate probe passes (quiet-run.r6IozjET); an actual separately compiled no-tooltip wxWidgets library was not built. Source review covered common ownership/text and GTK/MSW native behavior; runtime OSX3.2.12.") (:p "Independent code/test/docs review has no remaining actionable findings; narrowed an overbroad shared-guard claim in the guide. Initial focused both-Lisp/native tests caught invalid UTF-8 from ToUTF8 on a temporary wxString: retain the source wxString until copying the buffer. This fixes a real borrowed-buffer lifetime bug, not a runtime encoding setting. Preserve initial failure logs under evidence/tooltips/initial-utf8-failure/. Corrected focused SBCL/CCL example/tests pass (quiet-run.n3e9uJqd/wSIfEzgr), main/native builds pass (quiet-run.Ui9OgzUX), native harness passes with zero wx assertions (quiet-run.JR2jO7Us). Native probes cover virtual text/pointer update/removal, actual supported propagated callbacks, synchronous lifetime/reentry protection, raw validation, empty/absent distinction and exact native tooltip deletion counts on removal/window teardown. Lisp tests add Unicode byte boundaries, copied input/output strings, callback deferral, native-ready subclass defaults, managed failure/root rollback and stale handles.") (:p "Full76 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.vvTIp5rQ/OuIroKhw), evidence/tooltips/{sbcl,ccl}-20261029/. Example examples/tooltips.lisp has an owner-bound deferred Toggle guidance form action. Physical hover, native popup presentation/timing, accessibility, hosted Windows/Linux/Qt and graphical Cadre remain unverified. No automatic system clipboard contents are read/replaced. ASDF cache uses /private/tmp.") (:p "Regenerated pinned coverage inventory/14 checks,16 Python checks and zero-problem docset pass (quiet-run.sDE3DjoX). Counts:259 exports,186 named generics,57 SETF generics,26 window wrappers (24 concrete+2 abstract),50 examples and360 docset entries. Both-Lisp actual public-export/class/SETF coverage plus isolated install/discovery/symbol/guide/example checks pass (quiet-run.z9aYtyiZ). Install root /private/tmp/wxlambda-tooltip-docsets/wxlambda; normal Cadre installation under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/) is documented in docs/DOCSET.md. Package dist/wxlambda-form-tooltips remains established form binary; new example is separate repository/docset content. All five package isolation checks pass (quiet-run.y8Ihrbft), evidence/packaging/tooltips-20261029/. Final docset build/check/install follows these handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded date-picker controls for dated form fields, including native feature/component selection and a copied Gregorian date adapter as needed prerequisites. Preserve explicit date/value semantics, CLOS/SETF and callback/ lifetime protections, independent review and aligned examples/docs/docset/coverage.") (:heading 2 "Required calendar date pickers (2026-10-29)") (:p "ABI52 adds native-backed DATE-PICKER, generic MAKE-DATE-PICKER, CALENDAR-DATE/SETF and read-only EVENT-DATE. Exact copied (year month day) lists support Gregorian dates1900..2100, required valid days, default2000-01-01 (not today's clock). CLOS :parent/:date construction supports subclasses/defaults/native-ready AFTER hooks, one native kind per ancestry, validated :class factories and managed failure/root rollback. Native style wxDP_DEFAULT|wxDP_SHOWCENTURY and fixed inclusive1900-01-01..2100-12-31 range; construction checks native range/value readback before publication. No nullable/style/editor-text/mutable range/time/ timezone/standalone wxDateTime resource API. Native local-date construction must roundtrip the requested date, including historical timezone anomalies; no UTC/ Unix/universal-time contract. Process timezone changes during sessions unsupported.") (:p "Default SETF is silent under a native blocker; :notify emits exactly1 native wxDateEvent after committed readback, even unchanged. :DATE-CHANGE is command family/no veto, event date independent of control value and raw integer/text. Appended immutable packed native/Lisp snapshot metadata returns fresh tuples; invalid/out-of-scope native date payloads map NIL. Snapshot date survives session; current innermost contexts retain expiry/isolation. No EVENT-DATE SETF, native owned/synthetic/date clones, time-change/calendar event families. Actual source, propagated and composite-child TEXT paths retain Input guards, ancestor lifetime, modal/clipboard/GUI/safe-idle exclusion and silent cross-picker synchronization. Original callback conditions re-signal at the Lisp boundary with committed date.") (:p "Independent review identified generic picker Destroy deleting its combo before its base marks deletion. Added date-specific ManagedWindow::Destroy early input suppression, with weak-ref guard restoration on native refusal/exception; native base/destructor paths retain existing suppression. Constructor range readback and non-date context probes were also added. Final code/test/docs review has no remaining actionable findings; corrected error-boundary wording in the guide. Source audits: pinned OSX/Cocoa date/time picker, MSW date and generic date control sources in /private/tmp/wxl-date-source. Generic GTK/Qt controls use native generic logic, but runtime host remains macOS wxWidgets3.2.12 only; Qt-specific date source/header paths do not exist in this pinned release. Existing wxQt tree gate remains unchanged. adv component is now selected explicitly, despite interface header's core library label; requires wxUSE_DATEPICKCTRL and wxUSE_DATETIME. Negative CMake gate probe passes (quiet-run.fxpiP7ZS); actual disabled-feature wxWidgets build was not produced.") (:p "Main/native builds pass (quiet-run.nmyEhX5i/P2Fyt9PN), focused SBCL/CCL example/ tests pass (quiet-run.GwpquW1J/RZKUxDTS). Final native harness has zero assertions (quiet-run.xl10gReB), including native-origin events outside setter guards, propagation, composite-child TEXT, invalid/out-of-scope event dates, non-date/ expired/read-only context, native range endpoints, same-date explicit notify, silence, raw validation, early Destroy refusal restoration and suppressed early teardown events. Lisp tests cover leap years/centuries/endpoints, copied tuples, class/default/factory/rollback, context expiry/post-session snapshot, callback condition identity/committed state. examples/date-picker.lisp is a due-date form with native change feedback and an owner-bound deferred Reset action.") (:p "Full77 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.RidHE5Vr/SnMcfEO9), evidence/date-picker/{sbcl,ccl}-20261029/. Physical date editing/calendar/spin input, locale display, accessibility, historical timezone combinations, hosted Windows/Linux/Qt and graphical Cadre remain unverified. Generic early teardown is injected on macOS rather than a hosted generic GUI proof. No automatic system clipboard content reads/writes. ASDF cache uses /private/tmp.") (:p "Pinned coverage regeneration/14 checks,16 Python checks and zero-problem docset pass (quiet-run.juLHkDvK). Initial coverage checks exposed a class/declaration metadata mismatch plus the stale reviewed-class fixture; both corrected before final regeneration/checks. wxDatePickerCtrl/wxDateEvent and wxDateTime tuple adapter remain partial, not native parity. Counts:263 exports,189 named generics, 58 SETF generics,27 window wrappers (25 concrete+2 abstract),51 examples and366 docset entries. Both-Lisp actual public-export/class/SETF coverage and isolated install/discovery/symbol/guide/example access pass (quiet-run.hwUMGKGW). Install root /private/tmp/wxlambda-date-docsets/wxlambda; normal Cadre installation under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/) is documented in docs/DOCSET.md. Package dist/wxlambda-form-date-picker remains the established form binary, with transitive dependencies bundled; date example is separate repository/docset content. All five package isolation checks pass (quiet-run.j5EMHRiq), evidence/packaging/date-picker-20261029/. Final docset build/check/install follows these handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded time-picker controls for time-of-day form fields, reusing the native feature/component and Input foundation with an explicit copied hour/minute/second adapter. Preserve local-time/value semantics, CLOS/SETF and callback/lifetime protections, independent review and aligned examples/docs/ docset/coverage; do not drain unrelated wxDateTime APIs.") (:heading 2 "Required time-of-day pickers (2026-10-29)") (:p "ABI53 adds native-backed TIME-PICKER, generic MAKE-TIME-PICKER, CLOCK-TIME/SETF and read-only EVENT-TIME. Exact copied (hour minute second) lists use hour0..23, minute/second0..59, default midnight(0 0 0), not current clock time. Reject NIL, invalid shapes/types/bounds, 24:00, fractional and leap seconds before native mutation. CLOS :parent/:time construction retains subclasses/defaults/native-ready AFTER hooks, one native kind, thin validated :class factory and managed failure/ root rollback. Native wxTP_DEFAULT editor formatting/AM-PM/seconds presentation remains port/locale policy; tuple protocol is always24-hour whole seconds.") (:p "Native input construction uses fixed local2012-01-01, matching wxTimePickerCtrl SetTime and avoiding today's possible DST gap. Component roundtrip and native value readback must match. Native date portion/milliseconds are discarded; there is no date/timezone/offset/UTC/Unix/universal-time/scheduling API. No process timezone changes during GUI sessions; all historical/timezone combinations are not claimed. Default SETF silent; :notify emits exactly1 native wxDateEvent of wxEVT_TIME_CHANGED after native readback, including unchanged times. Raw command metadata/timestamps are not time encodings. Snapshot time is immutable packed 1+seconds-from-midnight (zero means absent/invalid), exposed only as fresh tuple; midnight remains present. It is independent of control/date metadata and survives session. EVENT-TIME on non-time snapshots yields NIL; invalid native time yields NIL; non-time/expired/outer contexts reject. No semantic time writer, native owned/synthetic time event or detached clone. EVENT-DATE scope remains separate.") (:p "Shared InputCallbackOperation now covers actual TIME origins and composite-child TEXT plus propagation. Same-picker writes/source/ancestor destroy/close and modal/ clipboard/GUI/safe-idle reentry reject; silent cross-picker sync allowed. Existing early managed Destroy guard extends from date to time picker with weak-ref refusal/exception restoration, constructor/base teardown suppression retained. Independent code/test/docs/coverage review found no remaining actionable findings; widened wxDateEvent and wxDateTime shared coverage/reference scopes accurately. Both classes remain bounded partial mappings, not native API parity.") (:p "Source audit: pinned generic/MSW/OSX time control and shared Cocoa date/time peer sources in /private/tmp/wxl-time-source; native SetTime fixed-anchor helper is in installed wx/timectrl.h. Generic control retains its own text/spin implementation; runtime verified only macOS wxWidgets3.2.12. CMake requires wxUSE_TIMEPICKCTRL=1 and wxUSE_DATETIME=1 with existing core/base/adv selection. Negative configuration gate probe passes (quiet-run.hD9nL2c5); an actual disabled-feature wxWidgets build was not produced. Existing Qt tree gate remains unchanged.") (:p "Main/native builds pass (quiet-run.W9WYXLvR/FGFEC6N4), focused SBCL/CCL example/ tests pass (quiet-run.wzBvB7yr/N1WpFAC2), native harness has zero wx assertions (quiet-run.rTH3T4m3). Native probes cover midnight/last second and fixed anchor, actual native time events outside setter guards with date1800 (no calendar-date bound interpretation), propagation, invalid payloads, composite-child TEXT, read-only/non-time/expired contexts, clone rejection, silent/unchanged notify, source/ancestor/native-entry guards and early Destroy refusal/suppression. Lisp tests cover copied values/snapshot tuple mutation isolation, malformed inputs, CLOS/default/factory/rollback, context/date separation, condition identity and committed state, post-session snapshots. examples/time-picker.lisp is a start-time form with native change feedback and owner-bound deferred Reset action; no timer or scheduling interpretation.") (:p "Full78 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.Sk2lWKdn/7Stn3vJS), evidence/time-picker/{sbcl,ccl}-20261029/. Physical editor/spin input, locale/AM-PM display, accessibility, historical/DST and timezone combinations, hosted Windows/Linux/Qt and graphical Cadre remain unverified. Early composite teardown is injected on macOS, not hosted generic GUI proof. No automatic system clipboard content reads/writes. ASDF cache uses /tmp.") (:p "Pinned coverage regeneration/14 checks,16 Python checks and zero-problem docset pass (quiet-run.wHDOSPcS). Counts:267 exports,192 named generics,59 SETF generics, 28 window wrappers (26 concrete+2 abstract),52 examples and372 docset entries. Both-Lisp actual public-export/class/SETF coverage and isolated install/discovery/ symbol/guide/example access pass (quiet-run.XdN30OGg). Install root /private/tmp/wxlambda-time-docsets/wxlambda; normal Cadre installation under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/) is in docs/DOCSET.md. Package dist/wxlambda-form-time-picker remains the established form binary with transitive dependencies bundled; time example is separate repository/docset content. All five package isolation checks pass (quiet-run.yMhJm2wd), evidence/packaging/time-picker-20261029/. Final docset build/check/install follows these handoff notes.") (:p "Session handoff: broad GUI coverage with selective depth remains the objective. Next selected slice: bounded search controls for list/tree filtering workflows, reusing copied UTF-8 text and command/Input lifetime foundations. Preserve explicit native text/event semantics, CLOS/SETF, independent review and aligned examples/ docs/docset/coverage rather than exhausting a native inventory category.") (:heading 2 "Search inputs and Lisp-native filtering (2026-10-29)") (:p "ABI54 adds native-backed SEARCH-CONTROL, generic MAKE-SEARCH-CONTROL, SEARCH-HINT/ SETF and TEXT/SETF methods. Required :parent; query:value defaults empty and :hint literal Search. Copied explicit-length UTF-8 query/hint reject NUL/CR/LF; empty strings valid. Native-backed subclasses/defaults/native-ready AFTER hooks, validated :class forwarding and managed failure/root rollback retain construction contract. Lisp base WINDOW, not TEXT-CONTROL: native wxSearchCtrl ancestry differs by port. Existing editing/selection/insertion/convenience ON-TEXT-CHANGE receiver scopes do not widen. No style/menu/icon-visibility/raw-adoption API. Construction requests PROCESS_ENTER and both icons; actual icon visibility/native gestures remain port-specific, notably inactive GTK SearchEntry search icon and automatic cancel display. Generic/GTK Enter commonly suppresses empty queries; Cocoa empty actions may cancel. Native cancel can clear before/during dispatch, with native TEXT ordering/count and payloads. No normalized native cancel side effect.") (:p "TEXT writes use composite-aware ChangeValue silently; :notify emits exactly1 native TEXT event even unchanged. Hint writes silent, no notify option. New :SEARCH/:SEARCH-CANCEL native-only command kinds capture GetString including empty, without inferring current query. Current command string SETF is metadata only, not control mutation; snapshots remain immutable. New kinds reject owned/ synthetic/cloning; existing generic TEXT construction/cloning retains its scope. Shared Input callbacks protect actual source/propagated/composite-child TEXT, same-source query/hint writes and ancestor destruction/close, native GUI/modal/ clipboard/safe-idle entry. Silent cross-search writes allowed. Early managed Destroy and creation/native-base teardown suppress relevant callbacks; weak-ref refusal/exception guard restoration retained. Notifier error boundary preserves original conditions and committed text.") (:p "Independent code/test/docs/coverage review found no remaining actionable findings. Final source audit found generic search can have WXGetTextEntry()==nullptr, so the existing lazy-text hook guard alone did not enforce the intended portable new-receiver rule. Added explicit search-origin TEXT string SETF rejection before the unchanged prior text-entry guard. NonEntrySearchProbe emulates the missing hook, proves rejection and preserves detached TEXT clone contents. Independently re-reviewed with no findings. Source audits pinned generic/GTK/OSX/Cocoa search implementations and headers in /private/tmp/wxl-search-source. Runtime local macOS wxWidgets3.2.12 only; no hosted GUI claim. CMake requires wxUSE_SEARCHCTRL and wxUSE_TEXTCTRL with existing core/base/adv linkage. Negative configuration gate probe passes (quiet-run.F1aNNb6A); no actual disabled-feature wxWidgets build. Existing wxQt tree construction gate remains unchanged.") (:p "Main/final native builds pass (quiet-run.sqKtPHft/TpaKXv5K), focused SBCL/CCL example/tests pass (quiet-run.mijwNj7O/cTwr1Yet); final full suites rerun after the portable metadata guard. Native harness has zero wx assertions (quiet-run.rLYjtKnn), covering direct SEARCH/CANCEL/TEXT outside setter guards, native copied payloads/empty cancel independent of query, propagation, metadata vs control writes, lazy/missing-hook TEXT rejection and clones, child TEXT, silence/unchanged explicit notify, raw validation, source/ancestor/native-entry protection, early Destroy refusal and suppression, stale handles. Lisp tests add Unicode field copying, CLOS/default/factory/rollback, condition identity/committed text, context expiry and post-session snapshots. A fabricated CFFI callback-copy probe verifies new keyword/payload decoding and string independence on both Lisps; it is not native search gesture simulation.") (:p "Example examples/search-controls.lisp filters a Lisp list into LIST-BOX using CHAR-EQUAL substring matching (not native/Unicode collation). TEXT/search defer filtering and read query at delivery time; cancel and Clear filter explicitly defer clear+filter. Owner removal cancels actions; filtering is application code, not native widget behavior. EXERCISE uses explicit TEXT notify plus Clear command. Full79 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 after final guard (quiet-run.tiwnvxrd/Q8oJPqq5), fresh reports evidence/search-controls/{sbcl,ccl}-20261029-final/. Initial pre-guard full suites also passed and remain under the corresponding unsuffixed report directories. Physical typing/IME/Enter/search/cancel, locale/Unicode collation, icon display, accessibility, hosted Windows/Linux/Qt and graphical Cadre remain unverified. Native early teardown/missing-hook probes emulate generic phases on macOS, not hosted generic behavior. No automatic system clipboard content reads/writes. ASDF cache uses /private/tmp.") (:p "Pinned coverage inventory/14 checks and16 Python checks pass (quiet-run.nQeOdzyq); exact Create line was initially111 and rejected by generator, corrected against pinned line112 before regeneration. Final metadata describes the portable guard and all inherited receiver scopes; final14-check inventory verification passes (quiet-run.q4b2HglR). Counts:270 exports,194 named generics,60 SETF generics,29 window wrappers (27 concrete+2 abstract),53 examples and377 docset entries. Both-Lisp actual public-export/class/SETF coverage and isolated install/discovery/symbol/guide/ example checks pass after final guard (quiet-run.KoOHVowx). Install root /private/tmp/wxlambda-search-docsets/wxlambda; normal Cadre installation under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/) is in docs/DOCSET.md. Final package dist/wxlambda-form-search-controls-final remains the established form binary; new example is separate repository/docset content. All five final package isolation checks pass (quiet-run.082JN4Ug), evidence/packaging/search-controls-20261029-final/. Preliminary pre-guard package/ reports remain separate. Final docset build/check/install follows these notes.") (:p "Historical ABI54 handoff (superseded by ABI55 acceptance below): broad GUI coverage with selective depth remained the objective. The selected next slice was bounded activity indicators for busy/deferred workflows. Preserve native animation/lifetime and main-thread rules, explicit supported scope, independent review and aligned examples/docs/docset/coverage; no exhaustive native inventory-category parity requirement.") (:heading 2 "ABI55: finite local MVP acceptance — 2026-10-29") (:p "This larger batch adds two bounded native-backed window kinds and one composed application workflow. DRAWING-CANVAS retains copied geometry, text/font, RGB colour/bitmap data with native paint/resize handling and private PNG output. Screen coordinates are DIP; export extents are pixels without implicit fit. Lisp scene compilation and native staging validate limits before commit; committed Lisp data stays synchronized across callback errors. Input operation guards, callback write/export rejection, native-only rendering and checked lifetimes prevent raw DC/resource or callback pointer exposure. PNG encoding precedes open; write/flush/close are checked after detached FILE ownership, avoiding pinned wxFFile double-close on close failure. Export overwrite is non-atomic.") (:p "ACTIVITY-INDICATOR adds idempotent generalized-boolean running state with native readback, inherited construction rollback and operation/parent lifetime guards. CMake requires IMAGE/LIBPNG/GRAPHICS_CONTEXT/ACTIVITYINDICATOR/STREAMS/FFILE in addition to existing TIMER and core/base/adv. Negative cached-feature configure probe rejects clearly (quiet-run.Fw8Xh3FA); no actual feature-disabled wx build. The existing wxQt tree construction gate is retained.") (:p "The record manager composes stable IDs, tree categories, search filtering, list/notebook details and deferred menu/tool/key CRUD/copy workflows. Deterministic prompt/confirm/clipboard adapters test cancellation, errors, queued stale targets, selection preservation and disposal without automatic system clipboard transfers. The drawing monitor composes a real owner-bound timer, activity state, copied RGB badge, Unicode text and deferred Pause/Resume. All three new examples run.") (:p "Two independent subagents implemented/reviewed activity and manager workflows; canvas source, tests, guides and packaged integration received independent review. Actionable review findings fixed native CR/LF validation, paint exception scope, font/image/bitmap validation, native log suppression, checked close ownership, DIP roundtrip tolerance and manager queued selection semantics. Final reviews found no remaining actionable findings.") (:p "Main/native builds pass (quiet-run.51d4fRNq). Native combined harness passes with zero wx assertions, including exact PNG pixel checks, copied source buffers, resize, callback/native-entry guards, thread/raw validation, activity state and teardown (quiet-run.hDxZV5Dn). Final full82 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.ZeZLFmJK/89VRCUnf), reports " (:code "evidence/mvp/{sbcl,ccl}-20261029/") ". Final monitoring PNG visually inspected after matching scene/export extent (quiet-run.p4ZsUGwp). Packaged self-test now actually exercises canvas PNG and activity as well as existing form lifecycle. Build and all five relocated/isolated package checks pass (quiet-run.3sDyUEjf/tYx5iZ0g), " (:code "dist/wxlambda-mvp") ", report " (:code "evidence/packaging/mvp-20261029/") ".") (:p "Pinned coverage regeneration and all14 consistency tests pass (quiet-run.BY4cUhyv/yMEP7cuM). All16 Python checks and rebuilt392-entry docset pass (quiet-run.VLWKGcJX), with zero checker/link/discovery/lookup/guide/example problems. Both-Lisp actual278-export/class/SETF coverage and isolated installation pass (quiet-run.6KS7vQ0h). Final docs are rebuilt/rechecked/reinstalled after these notes. Counts:278 exports,200 named generic operations,62 SETF generics,31 WINDOW wrappers (29 concrete+2 abstract),56 examples and392 docset entries. Normal Cadre install is $XDG_DATA_HOME/docsets/wxlambda, default ~/.local/share/docsets/wxlambda/; verified isolated root /private/tmp/wxlambda-mvp-docsets/wxlambda. See docs/DOCSET.md.") (:p "All finite acceptance gates have passed: " (:b "primary automated local macOS MVP goal reached") ". Session handoff: no next required native binding batch. Future work requires an application need or explicitly selected extension/validation target. No physical-input/IME/accessibility, hosted Windows/Linux/Qt, exhaustive font/ locale/DPI, external clipboard or graphical Cadre verification is claimed. Primary automated local macOS MVP completion ends the mandatory expansion loop.") (:heading 2 "ABI56: requested grid and interactive WebView — 2026-10-29") (:p "The user requested wxGrid/wxWebView for the next project and clarified interactive JavaScript testing from an editor. This extends the accepted ABI55 local MVP; it does not reopen exhaustive native parity. GRID has fixed native string-table dimensions, copied cell/row/column strings and generalized whole-grid editing policy. Default10x5, axes1..256 and total<=16384 cells, NUL-free programmatic text <=65536 UTF-8 bytes. Preserve active-editor refusal: native SetCellValue and EnableEditing can implicitly alter/commit editor state. Reads report committed table values; pending editor text is separate. Native table/editor ownership, structural changes, cursor/selection and grid event families are not exposed.") (:p "WEB-VIEW is a WINDOW container with a private wxWebView child, copied URL/title/ load state, HTML and history/stop/reload, asynchronous JavaScript request tickets and JSON page messaging. JavaScript is enabled. WK completion blocks retain only numeric owner/ticket IDs; copied wx events deliver through ordinary guarded Lisp callbacks.64 requests per view,256 queued messages,1MiB script/message/result, 2MiB HTML and8192-byte URL/base bounds apply. Results retire request identity before Lisp entry; owner/session teardown removes handlers and drops late work. Native LOADED can precede title/application readiness. Tests use a ready message plus title predicate. Full polling was separately verified (quiet-run.mO9O6TYg); RUN/timer-driven tests also pass. No blocking RunScript bridge or awaited Promises.") (:p "The macOS Objective-C++ adapter suppresses known unguarded wx JS dialogs/uploads/ popups/printing, denies SDK-supported media/geolocation requests and removes wx fullscreen injected callbacks. Direct WK loading validates absolute URL/base inputs under Objective-C exception containment. Initial URL schemes are about: blank/http/https/file; page links/redirects/subresources are not sandboxed. All frames/origins can post JSON; receipt authenticates nobody. Trusted editor preview only, no full browser automation/DevTools/security policy claim. WebView construction is gated to macOS wxWidgets3.2.12 WKWebView pending other backend lifetime/UI audits. CMake requires GRID/WEBVIEW plus the webview component; macOS links system WebKit. Negative cached feature configure probe passes (quiet-run.IrEHht7V); no actual disabled-feature wx build was tested.") (:p "Independent subagents implemented grid and the Cocoa shim, then cross-reviewed root integration, lifetime/event/queue logic, metadata, guides/examples/tests and package integration. Findings resolved: malformed URLs could raise Objective-C exceptions; added checked Cocoa load boundary and offline URL probes. Rejected same-view script reentry leaked request slots; moved InputOperation before ticket allocation and added unchanged-slot-count regression. Oversized-result fallback length now uses strlen. Native title/load ordering is handled explicitly in tests. Final independent reviews report no remaining actionable findings.") (:p "Main/native builds pass (quiet-run.2W8WkW0a). Grid focused SBCL/CCL pass (quiet-run.KRYQQC6V/14W93U4h). Real WebKit interactive JS/JSON/dialog suppression, callback metadata/propagation, constructor rollback and pending teardown pass on SBCL/CCL (quiet-run.Av0D4G9n/QuLDKz6t). Final native combined harness reports zero wx assertions (quiet-run.HmS5tXWK), including real grid editing, child TEXT/BUTTON, early Destroy refusal, raw/thread/operation checks, WebView bounded queue, completion dedupe, rejected request rollback and stale callbacks. Final84 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.EtMFhP57/uieXl4z6), reports " (:code "evidence/web-grid/{sbcl,ccl}-20261029/") ". Both new examples run automatically.") (:p "All16 Python checks and418-entry docset build/check pass (quiet-run.S8ti09Hv). Pinned coverage regenerated with factual partial wxGrid/wxWebView adapters and inherited WINDOW receiver scope; all14 inventory tests pass (quiet-run.X8G1E4xv/SllWNss0). RunScriptAsync remains natively pending: this bridge uses WK evaluateJavaScript with independent lifetime-safe completion instead. Both-Lisp actual300-export/class/SETF docset coverage, isolated install/discovery/ lookup/guide/example access pass (quiet-run.u1I1CFAe). Counts:300 exports,220 named generics,67 SETF generics,33 WINDOW wrappers (31 concrete+2 abstract),58 examples, 60 guides and418 total entries. Final docset rebuild/check/install follows these handoff notes. Normal install is $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/); verified isolated root /private/tmp/wxlambda-webgrid-docsets/wxlambda. See docs/DOCSET.md.") (:p "Final package dist/wxlambda-web-grid includes recursive webview dylib relocation. Its self-test now creates a grid, reads Unicode cells, loads offline HTML, receives real page JSON, evaluates6*7 asynchronously and verifies result42 outside the checkout. Package build and all five isolation checks pass (quiet-run.EnftFjZY/9PhqBcBT), report " (:code "evidence/packaging/web-grid-20261029/") ". No automatic system clipboard transfer. Native browser keyboard/clipboard paths remain native and physically untested. Hosted platforms/other wx versions, physical input/IME/accessibility, every OS permission/auth/certificate/upload path, external network flows, DevTools and graphical Cadre remain unverified. No next required batch; further work follows an explicit application need.") (:heading 2 "ABI57: KryptonEdit priority native bindings (2026-10-29)") (:p "Preserved the clean ABI56 baseline371edbe and added general-purpose STYLED-TEXT-CONTROL, raw native input, AUI-NOTEBOOK and dynamic splitter APIs. See docs/KRYPTONEDIT-COVERAGE.md for baseline inventory, dependencies, remaining capabilities, AuiManager/HtmlWindow surveys and terminal integration boundary. No application editor/document/language-service abstractions were added.") (:p "STC fixes UTF-8 codepage/container styling and explicit-length NUL text. Native positions/selection/modification ranges are bytes, validated at codepoint boundaries. Supports undo groups/save points/read-only, multiple/rectangular selections, styles/indicators/margins/markers/folding, coordinate/scroll/assist operations and copied kind-checked native events. Only the innermost same-control STYLENEEDED callback permits synchronous styling. Independent review found shadow styling state unsafe after document edits; both SetStyling/SetStyleBytes now bound against native GetEndStyled, with regression coverage.") (:p "Input preserves observer Skip and scoped consumption/propagation, CHAR_HOOK AllowNextKeyEvent and native CmdDown/RawControlDown distinction. No synthesized IME text. Universal managed retirement suppresses raw callbacks before native Destroy/base teardown; weak states survive DESTROY notification and prune safely, including deterministic address reuse, failed Destroy and unrelated future focus. AUI audits private local/global page indices, private-ID exhaustion, native close and PAGE_CLOSED stale indices. Managed pages retain canonical roots, RemovePage leaves hidden live children, DeletePage destroys. Programmatic splitting is bound; physical splitting/external transfer disabled, multi-group physical movement restricted. Splitter Initialize/Unsplit/Replace/Resplit and orientation SETF preserve explicit hidden retained pane ownership and safe structural phases.") (:p "Independent native/source reviews resolved actionable lifetime, ID/teardown, AUI cache and STC styling findings. Full87 GUI scenarios plus preflight pass on SBCL2.6.9 and CCL1.13 (quiet-run.eKkVjtAX), reports evidence/krypton-priority/{sbcl,ccl}-final-20261029/. Latest styling fix and example pass both Lisps plus native fixture (quiet-run.UBUcmovt); native zero assertions include early Destroy/base teardown, stale callbacks/address reuse, AUI close/veto and split groups. Missing STC/AUI feature gate rejects as intended (quiet-run.B4JGnfef). All14 pinned inventory tests pass (quiet-run.btyBSSHk).") (:p "Final package dist/wxlambda-krypton-priority-final includes recursively relocated STC/AUI libraries; build and all5 isolation checks pass (quiet-run.nXUnlIuE/s9QC8ufv), evidence/packaging/krypton-priority-final-20261029/. The styling frontier fix is included in refreshed package dist/wxlambda-krypton-priority-frontier; all5 checks pass (quiet-run.fgZuLTwc), report evidence/packaging/krypton-priority-frontier-20261029/. Docset572 entries:447 public exports,365 named generics, 106 SETF generics,35 WINDOW wrapper classes,61 examples and64 guides. Both-Lisp actual-export/class/SETF coverage and zero-problem format1 checks passed (quiet-run.btyBSSHk); final handoff regeneration/install passed (quiet-run.LMEsogql), including all16 Python checks. Final source/docset alignment follows this record. Install under $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/), see docs/DOCSET.md. Isolated discovery/lookup/ guide/example access verifies Cadre format, not graphical Cadre operation.") (:p "Local macOS wxWidgets3.2.12 evidence does not verify physical IME/keyboard/mouse/ drag/accessibility or hosted platforms. Existing WebView remains macOS-gated. No system clipboard transfer in automatic tests. Primary KryptonEdit scope is not complete: next integrate staged worker delivery, then scalable views/tree/grid depth and public graphics/image facilities, keeping focused reviewed commits.") (:heading 2 "ABI58: copied worker-to-GUI thread events (2026-10-29)") (:p "QUEUE-THREAD-EVENT is the only worker-safe native operation. It targets an existing EVENT-HANDLER whose :THREAD binding established an internal endpoint on the GUI thread; no new public thread/endpoint/job/editor abstraction is exposed. The native wxThreadEvent packet owns copied valid UTF-8 bytes (including NUL), at most1MiB, with256 live packets per receiver and4096 per session. GUI dispatch copies EVENT-TEXT into the usual base-family snapshot/current context. No Lisp worker closure, native pointer adoption or owned/synthetic/cloned thread event.") (:p "An independent endpoint mutex serializes worker posts with target lifetime and shutdown; posting never calls ready() or reads ordinary GUI/session registries. Generic ManagedWindow Destroy retires posting before native work, restoring only on refusal/exception while its weak source survives. Earliest managed window/ standalone destruction invalidates endpoints, and finish closes ingress before native cleanup. DeletePendingEvents plus wxApp pending-handler removal is one posting-critical section. Atomic packet counters avoid lock inversion on native discard/destruction. Pinned appbase.cpp/event.cpp release both native pending locks before GUI callbacks; proof/limits are in docs/THREAD-EVENTS.md. Native wxUSE_THREADS=1 is required. Root independent source review found no actionable lifetime/locking/payload findings.") (:p "Main/native builds pass (quiet-run.s5Esv2uy/Kq8M6Dpr). Focused actual SBCL/CCL worker tests pass (ulv1QgPF/f6vs36E9); final native combined harness passes with zero wx assertions (CaSWRlVi), including copied Unicode/NUL, GUI callback thread, readonly contexts, count/byte bounds, refused/throwing Destroy restoration, delete/post, destroy/post, shutdown/post races and posts after wxEntryCleanup. Full88 GUI scenarios plus preflight pass on SBCL and CCL (yfXee5wK/srcCpMvj), reports evidence/thread-delivery/{sbcl,ccl}-final-20261029/. All14 pinned inventory tests pass (SnnYCtRQ), runner tests pass (VWFDIe8X), and docset-tool tests pass (WXxeM1lN). Actual448 public exports and class/SETF coverage pass on both Lisps (HjnZAExY/kZUSPp7y). The575-entry format1 docset builds/checks with zero problems (sI6MHFTG/b45H9KkV), including discovery, symbol lookup and guide/example access; final handoff regeneration follows this record.") (:p "Independent follow-up review required actual native string payload semantics. Packets now SetString from a uniquified native wxString, with all worker-side temporary aliases destroyed before QueueEvent publication. GetString and inherited native Clone preserve Unicode/NUL; clones return base events without duplicating queue reservations. Focused both-Lisp tests and final native GetString/Clone/race fixtures pass (PC3GsGSE/BgHAG60D/ReRUZJHN). The final relocated package dist/wxlambda-thread-native-string and all5 checks pass (FdTr6Xur), report evidence/packaging/thread-native-string-20261029/, including actual packaged SBCL worker Unicode/NUL delivery on the GUI thread. Isolated docset install/discovery/lookup/guide/example access passes (quiet-run.SHibPWoP), /private/tmp/wxlambda-thread-docsets/wxlambda. The default user docset location was not modified; installation is documented in docs/DOCSET.md. Final handoff/native-string documentation regeneration, checking and isolated installation follow this record. No system clipboard transfers in automatic worker tests. Physical input/IME, graphical Cadre and hosted platforms remain unverified. The broader KryptonEdit request still needs selected scalable views/grid depth and public graphics/image work. Next bounded grid work is staged outside the repository pending a separate native editor/commit/cancel audit.") (:heading 2 "ABI59 report/virtual list views and tree interaction (2026-10-29)") (:p "Native-backed LIST-CONTROL supplies fixed REPORT/SINGLE_SEL stored rows and native LC_VIRTUAL text through actual OnGetItemText (CLOS generic/function adapter). Columns/cells/count/selection, native activation/context/cache hints and checked tree activation/menu/expansion/collapse, bold/colours/potential-children hints are implemented. See docs/REPORT-TREE-VIEWS.md and examples/report-views.lisp. This is 19 new exports, not wxListCtrl/DataView parity; images/attributes/sorting/editing, arbitrary item data and virtual mutation callbacks remain unbound.") (:p "Virtual providers are synchronous copied pure text queries. Checked registered frame/panel/scroll/drawing/web/notebook/AUI/splitter ancestry bounds the audited inherited mutator surface. Source/ancestor layout/show/enable/name/title/sizer, notebook captions/selection, splitter/scroll and construction reject during the provider; native loops/modal/clipboard/destruction retain Input/lifetime guards. Replies are single-use current-depth tickets and copied UTF8, with original Lisp conditions/nonlocal exits contained, constructor rollback/session root cleanup and early native teardown suppression. wxQt tree gate remains.") (:p "Independent root review found two missing explicit GUI-thread guards in private provider-active/reply entries; ready() now precedes registry/request-stack reads, and native foreign-thread regressions cover token0/live token/reply. No further actionable review findings. Focused actual CFFI GUI tests pass SBCL605pgxXk and CCLfxKZPIwt; expanded integrated native harness fWswVuMR passes zero assertions (actual selection, native expansion veto, nested supported containers, readonly contexts, provider exception/retirement and inherited ancestor mutation guards). Pinned regeneration VwUeRuD1 and14 inventory tests vf9EYSv7 pass. Initial docset build/check dZLndLHl/csXNyENL and actual SBCL export/SETF/class checks xFf5ucKZ pass; final full suites and refreshed handoff/docset checks follow this record. Physical input/IME and hosted platform GUI remain unverified. Primary remaining selected work: staged public image/bitmap/canvas resources and audited grid depth.") (:p "Final ABI59 acceptance: all89 GUI scenarios plus platform preflight pass on both SBCL and CCL (quiet-run.msUjZdUb/I5HsENav), with fresh reports in evidence/report-views/{sbcl,ccl}-20261029/. Native full harness with added actual selection/expansion and nested-provider ancestry checks passes zero assertions (quiet-run.fWswVuMR). Both actual loaded packages expose467 public symbols with exactly one API record plus class construction and generic SETF sections (quiet-run.xFf5ucKZ/cSkHyD9A). All10 Python docset tests pass jrNzxPJA; pinned inventory14 tests pass vf9EYSv7. Final docset rebuild below includes this handoff; isolated package creation/install/discovery checks are delegated to the root acceptance pass. No commit performed by the views worker.") (:p "Final pinned inventory rerun after metadata review passes all14 tests (quiet-run.aHHGvi0p); generated summaries/checklists match gcAvGCOt. Independent review of packaging CHECK-REPORT-VIEWS found no actionable issue: the relocated saved image uses an actual pure native OnGetItemText CFFI callback at row999999, checks copied Unicode output, then disposes its owner before other package checks. Isolated package build and all5 package tests pass STwP6WnK; output " (:code "dist/wxlambda-report-views") ", report " (:code "evidence/packaging/report-views-20261029/") ". Root final isolated docset install and regeneration follow these notes. Views slice is ready for root commit.") (:heading 2 "ABI60 images, static bitmaps, displays and RGBA scenes (2026-10-29)") (:p "IMAGE/BITMAP are native-backed session resources with copied RGB/alpha/pixels, PNG-only stream load/save, scaling, conversion, explicit disposal and CLOS nested rollback. STATIC-BITMAP is a WINDOW with managed native bitmap copies; BITMAP-VALUE reads allocate independently disposable values. Native backing pixel size, logical size, DIP size and scale remain separate; Cocoa native display readback may resample. Read-only display/coordinate/window-scale queries expose existing native methods.34 new exports; no raw buffers/pointers, finalizers, arbitrary formats, image handler registration, display mode mutation or screenshot APIs.") (:p "The retained renderer additionally accepts copied :RGBA-BITMAP scene bytes with native alpha composition, existing1..256 extents/2MiB aggregate cap and screen DIP versus export pixel coordinates. The monitor example uses a transparent badge; image-viewer demonstrates general image resources and native display/mouse reads. See docs/IMAGES-DISPLAYS.md and docs/DRAWING-CANVAS.md. wxUSE_STATBMP/DISPLAY plus existing IMAGE/LIBPNG/STREAMS/FFILE are required. Resources clear after native windows are destroyed and before wx cleanup; ABI59 provider/construction guards remain in force.") (:p "Independent review found RGBA kind6 initially bypassed native extent validation, and some InitAlpha paths did not check allocation before pointer use. All are fixed with native regression0/-1/257 rejection, transparent/opaque composition, source-copy tests and explicit alpha pointer checks. Integrated native harness EmKDKwkZ passes zero wx assertions and verifies image/bitmap maps empty after finish. Focused separate-process GUI image+changed canvas/example tests pass SBCLnGGnW8fN and CCLXSMBasWi. Full90 GUI scenarios plus preflight are running on both Lisps; final inventory/docset/export and root integration review gates follow. Pinned native records remain factual partial mappings: explicit PNG methods map wxPNGHandler LoadFile/SaveFile, no generic wxImage loading or DC bitmap constructor claims. Native bitmap sizing methods have separate readonly mappings. Remaining selected primary work is audited grid editing/validation/dynamic shape depth.") (:p "ABI60 final worker gates: all90 GUI scenarios plus platform preflight pass on both SBCL and CCL (quiet-run.9AucCgbr/kWZjrlsG), fresh evidence/images/{sbcl,ccl}-20261029/. Both actual loaded packages verify501 public exports and class construction/generic SETF sections (wMeZ6GdQ); docset has632 entries. All10 Python docset tests pass IpdzyEDD; final14 pinned inventory tests pass wne03WF9 after effective class and class-declaration annotation alignment. Native EmKDKwkZ remains zero assertions. A test-only PNG path split prevents SBCL/CCL parallel-suite collisions; focused both-Lisp rerun Ns4J55VI passes. Root independent integration review found no additional actionable source issues; guide wording now distinguishes authoritative IMAGE channels from native PNG decoding/scaling semantics. Final package/discovery checks are handled by root; no commit made by this worker.") (:p "Final build review found that extending an already cached drawing feature probe could bypass newly added prerequisites. A distinct WXLAMBDA_HAS_IMAGE_DISPLAYS probe now checks STATBMP/DISPLAY and required IMAGE/LIBPNG/STREAMS/FFILE support. Forced cached FALSE configure rejects with the accurate prerequisite diagnostic (quiet-run.jAsecmiW, expected exit1); ordinary main configure/rebuild pass KxxrlDIA/ksOCH9Ow. This build-configuration correction changes no native behavior; full90 GUI suites remain the accepted evidence above. Independent review of packaged CHECK-IMAGE-RESOURCES found no actionable issue: actual PNG/alpha roundtrip, native static display GetBitmap/logical sizing, independent copied-value disposal and display availability are checked before other saved-image workflows. Isolated package and all5 checks pass PW63yF6h, output dist/wxlambda-images, report evidence/packaging/images-20261029/.") (:heading 2 "ABI61 native grid editing, events and dynamic string-table axes") (:p "Completed the selected bounded GRID dependency after independent root/agent source review: 26 generic exports /4 SETF writers, native-only notify kinds160..170, owned native string-table axes0..256/result<=16384cells (constructor stays1..256), per-cell read-only/RGB colours, native cursor/block selection and explicit native Save/Hide/Disable/active-editor Reset operations. GetCellEditor returns a locally reference-counted default native text editor; Reset restores its current baseline, which may change during prior Save/veto. No transaction/cancel guarantee, custom model/editor/renderer ownership or spreadsheet behavior is invented.") (:p "Snapshots capture immutable kind fields and copy current table text into private details23 before user dispatch; native GetString retains proposed CHANGING/old CHANGED semantics. Context reads retain current-innermost lifetime. Actual native grid source filtering/ancestor guards, early retirement and readonly metadata prevent native callback/teardown reentry. Range/hidden veto remains observational.") (:p "Verification: main build8oYlyjYw, normal-loader focused SBCL2iqnr3QV/CCLJV5npCGV, combined native JUwUMg2x/TGvlMdCZ with zero assertions and actual default editor commit/veto/Reset/Hide/dimension fixtures. Full91 GUI scenarios plus preflight pass SBCL538jfP5V and CCLpXUIA7PI; reports evidence/grid-editing/{sbcl,ccl}-20261029. Python runner/docset tests vaCYz6F6 pass. Actual loaded527exports /435named generics /122generic writers verified Vn57CfJ6; all-export/class/SETF docset checks pass both Lisps QJAQTQ41/ZAonRKkZ. Final metadata-only inventory/docset gates follow. The stage's temporary ABI loader bypass and probe sources were not integrated.") (:p "This completes the selected bounded binding slices before KryptonEdit application integration; root performs final survey/package/commit and goal report. Native classes remain partial, and physical input/IME/accessibility/other-port fidelity remain unverified. No exhaustive native parity is claimed.") (:p "ABI61 final metadata gates: factual partial wxGridEvent/wxGridRangeSelectEvent class/accessor scopes added; inventory regeneration tYd2lZqB and all14inventory checks hEsMd2d0 pass. Docset661entries, zero problems/discovery/symbol/guide/example reads mVZn5vTs; isolated install ZfOAbYgp under /private/tmp/wxlambda-grid-docsets/wxlambda. Public native WXL_EVENT_GRID_* enum constants added without behavioral/layout changes; final header rebuild Anc1frM9 passes. Independent packaged CHECK-GRID-EDITING review found no actionable issue. Root is completing package evidence and final reader-facing acceptance status, then must regenerate/check/install the docset for that prose before commit.") (:heading 2 "Selected KryptonEdit binding goal: completed local acceptance") (:p "All selected implementation batches ABI57–ABI61 are implemented, independently reviewed and verified under the documented bounds. Preserved ABI56 grid/WebView and the prior MVP. No editor behavior, language service, project model, third-party widget or terminal emulator was added to the library. Native inventories remain factual partial/pending records; wxAuiManager/wxHtmlWindow are survey-only outcomes. Basic WebView back/forward history is already bound; navigation cancellation/event coverage, richer history and other-platform backends remain explicit future scope.") (:p "Final91 GUI scenarios plus preflight pass in fresh processes on SBCL2.6.9 and CCL1.13 with local macOS wxWidgets3.2.12. Combined native fixtures pass with zero wx assertions; actual default grid-editor commit/veto/reset, virtual callbacks, worker lifetime/shutdown races and RGBA/resource teardown are exercised. Final 527 exports,435 named generics,122 generic writers and37 WINDOW wrappers are documented. The format1 docset contains661 entries (527 API,65 examples,69 guides), with both-Lisp actual-export/class/SETF coverage, zero check-docset problems, links, discovery, lookup and guide/example access. This verifies Cadre format/API discovery, not graphical Cadre interaction or every native argument combination.") (:p "Final package dist/wxlambda-krypton-edit-final builds and all5 isolation checks pass (quiet-run.mPwcN76O), report evidence/packaging/krypton-edit-final-20261029/. Its self-test exercises native grid editor/selection/dynamic rows, image PNG/alpha/ DPI, actual million-row virtual text, real worker GUI delivery and the previous STC/AUI/WebView/form/renderer workflow outside the checkout. A packaging-only accessor typo was corrected to the documented GRID-ROWS before this passing run. Final prose/docset regeneration, checker and isolated install follow this record. Install instructions are in docs/DOCSET.md; normal location is $XDG_DATA_HOME/docsets/wxlambda (default ~/.local/share/docsets/wxlambda/). The user's default installation was not modified.") (:p "Physical keyboard/IME/mouse/drag/accessibility, display hotplug/color fidelity, GTK/MSW/Qt and additional wx versions remain unverified. WebView remains gated to the audited macOS3.2.12 WKWebView backend. AUI physical splitting/external page transfer remain disabled, multi-group physical rearrangement restricted, PNG file formats and resources/scenes bounded, and virtual providers have explicit container ancestry/query restrictions. No automatic system clipboard transfer occurred. See docs/KRYPTONEDIT-COVERAGE.md for the current capability/limitation report. Further bindings should follow a demonstrated application need, not inventory checkbox exhaustion; application integration is the next step.") (:heading 2 "WX package nickname (2026-10-29)") (:p "WXLAMBDA now has the standard Common Lisp nickname WX. Package, class, function and SETF symbols are identical; ASDF/Quicklisp system name remains wxlambda and canonical docset package remains WXLAMBDA. No new exports, native bindings or ABI change (61); native coverage metadata remains unchanged. README/CLOS guide and the hello example document/use the short spelling. Independent review found no actionable issues.") (:p "Normal Quicklisp fresh SBCL/CCL checks verify package/class/function/SETF identity and execute hello construction/callback setup with bounded GUI polling (quiet-run.KE4zFIuX). The initial interactive RUN harness stalled after example loading replaced its hook; it was stopped and superseded by the bounded check. No full-suite/native rebuild was needed for a package-only nickname. Pinned inventory regeneration and14 checks pass unchanged (quiet-run.YRDot8vM). Docset661 entries/all527 public exports, both-Lisp class/SETF coverage and zero checker problems pass (quiet-run.JcDA4ejS); final handoff regeneration follows."))))
(:entry "guide/docs/ACTIVITY-INDICATORS.md" :names ("docs/ACTIVITY-INDICATORS.md" "ACTIVITY-INDICATORS") :kind :guide :kind-name "Guide" :summary "docs/ACTIVITY-INDICATORS.md" :sections (("Guide" (:heading 1 "Activity indicators for busy workflows") (:p "ABI55 adds native-backed " (:code "activity-indicator") ", generic " (:code "make-activity-indicator") " and generic " (:code "activity-running-p") "/SETF. The indicator is a WINDOW subtype with a native animation owned by its parent window.") (:code-block "lisp" "(defparameter indicator
  (wxlambda:make-activity-indicator parent :running-p nil))
(setf (wxlambda:activity-running-p indicator) t)
(wxlambda:activity-running-p indicator) ; native boolean state
(setf (wxlambda:activity-running-p indicator) nil)") (:p (:code ":parent") " is required; " (:code ":running-p") " defaults to NIL and accepts a generalized boolean. Native state is verified after construction and each write. The reader returns T/NIL; the writer returns its supplied value. Repeated true writes do not accumulate starts, and one NIL write stops animation. Hidden or disabled controls may retain running state; the state reports native animation activity, not a promise that pixels are visible or changing.") (:p "Direct MAKE-INSTANCE subclasses support slot initargs, " (:code ":default-initargs") ", native properties in AFTER hooks and managed failure/root rollback. The factory is thin, validates " (:code ":class") ", and forwards subclass initargs. Native size/style/animation appearance and frame cadence are port-specific. No standalone animation resource, raw pointer, native timer/Notify event, progress percentage, artwork/style or worker-thread API is exposed. Lisp subclasses do not override C++ methods.") (:p "Animation is feedback only: it does not run application work. Keep native GUI processing responsive; a long blocking Lisp computation can stop visible updates. Use existing deferred actions/UI timers or an application-specific worker model with appropriate GUI-thread handoff rather than assuming this control starts a background task.") (:heading 2 "Main-thread and callback boundaries") (:p "All access requires a live control in the active main-thread GUI session. The reader is callback-safe. Start/stop writes reject event callbacks, including writes to a different indicator, and should be deferred:") (:code-block "lisp" "(wxlambda:on-click busy-button
  (lambda ()
    (wxlambda:defer-ui-action
      (lambda () (setf (wxlambda:activity-running-p indicator) t))
      :owner indicator)))") (:p "During a synchronous native start/stop operation, the shared Input guard protects the receiver and ancestors from bridge destroy/close, rejects recursive writes, and blocks nested GUI/RUN/pumps/finish, modal/clipboard entry and safe-idle delivery. Native animation state belongs to the window; parent/session destruction releases native animation resources and invalidates the Lisp wrapper normally. Owner-bound deferred actions cancel if the owner disappears. There is no Lisp animation callback root to release.") (:heading 2 "Build and verification scope") (:p "CMake requires wxUSE_ACTIVITYINDICATOR=1 and wxUSE_GRAPHICS_CONTEXT=1; existing TIMER support is also needed by the generic implementation. The installed wxWidgets3.2.12 class is exported from adv despite the interface header's core library annotation. Linkage remains core/base/adv.") (:p "Source audit covers Cocoa NSProgressIndicator, GTK spinner, and generic private wxTimer/graphics rendering. Native appearance, enabled/hidden behavior, smoothness, accessibility, hosted Windows/Linux/Qt and graphical Cadre remain unverified. The deterministic example toggles busy feedback through owner-bound deferred commands; it does not claim pixel/animation-fidelity testing. Native probes cover raw state/type validation, repeated writes, synchronous operation/lifetime guards, main-thread rejection and deletion while running. Lisp tests cover CLOS/defaults/ factory/rollback and callback deferral. No automatic test reads or overwrites system clipboard contents.") (:p "Run " (:ref "example/examples/activity-indicator.lisp" "activity-indicator.lisp") " using its indexed command in the docset. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ", " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") ", " (:ref "guide/docs/UI-TIMERS.md" "UI timers") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:p "Native reference: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/activityindicator.h" "wxActivityIndicator") "."))))
(:entry "guide/docs/APPLICATION-EVENTS.md" :names ("docs/APPLICATION-EVENTS.md" "APPLICATION-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/APPLICATION-EVENTS.md" :sections (("Guide" (:heading 1 "Application event dispatch") (:p "This C1 foundation slice defines dispatch entry and observation for the existing bridge application. It precedes broader event-handler, timer and worker-dispatch bindings. It does not introduce arbitrary application or event-loop objects.") (:p "All operations require the active GUI session on its process main thread. Inactive-session calls signal " (:code "native-error") ", including boolean queries. The three new APIs enforce this before any FFI call, so it also holds immediately after loading the Lisp system, before loading the native bridge.") (:heading 2 "Observe the application") (:code-block "lisp" "(wxlambda:main-loop-running-p) ; T while the native blocking main loop runs
(wxlambda:pending-events-p)    ; T if wxWidgets has queued pending events") (:p (:code "main-loop-running-p") " maps to " (:code "wxAppConsole::IsMainLoopRunning") ". It is false during standalone " (:code "process-events") ", " (:code "process-pending-events") " and the cooperative application REPL. Those modes can still invoke callbacks; a false query does not mean it is safe to enter another pump. Inside a " (:code "run") " callback, the query reports the native main-loop state.") (:p (:code "pending-events-p") " maps to " (:code "wxAppConsole::HasPendingEvents") ". It observes the application's wx pending-event handlers, including events queued by " (:code "queue-click") ". It does not inspect OS input, idle work or timers that have not queued events. Its result is an observation rather than a promise about subsequent dispatch. Both queries return T/NIL and are safe to call from callbacks.") (:heading 2 "Dispatch queued wx events") (:code-block "lisp" "(wxlambda:queue-click button)
(assert (wxlambda:pending-events-p))
(wxlambda:process-pending-events) ; returns NIL") (:p (:code "process-pending-events") " maps to " (:code "wxAppConsole::ProcessPendingEvents") " across all pending handlers in the bridge application. It dispatches queued wx events, without yielding to OS input or running " (:code "ProcessIdle") ". It does not wait for new events, but callbacks and continuously requeued work can delay its return. It is not a replacement for the GUI loop needed to keep an application responsive.") (:p "Use " (:code "process-events") " to yield to GUI events and process idle work, or " (:code "run") " to enter the blocking native main loop. " (:code "stop") " exits that loop; in the cooperative application REPL it instead ends the REPL. Pending-only dispatch does not create a native main loop, so " (:code "stop") " outside RUN/REPL still signals " (:code "native-error") ".") (:heading 2 "Callback and pump boundaries") (:p (:code "run") ", " (:code "process-events") " and " (:code "process-pending-events") " reject entry while RUN, either pump, or any native-to-Lisp callback is active. These failures signal " (:code "native-error") "; the same protection applies to raw bridge calls. This includes synchronous command callbacks invoked by a notifying SETF writer before any main loop starts. Native cleanup is also forbidden from pumps and callbacks. RAII guards restore dispatch state after native exceptions and callback failures.") (:p "Property reads, queries, ordinary window operations, handler replacement and synchronous notifying setters retain their existing callback behavior. This boundary prevents recursive event pumping; it does not disable synchronous command notifications or provide native virtual-method callbacks.") (:p "Both pump functions reject dispatch in the application REPL debugger, keeping the documented pause while debugging. Callback conditions never unwind through C++; they are recorded and re-signaled when the native operation returns. Handled boundary failures allow the callback to continue; an escaping condition uses the existing callback-error recovery rules. A subsequent pump remains usable.") (:p "Application dispatch was introduced in ABI 11; the current bridge is ABI 31. Rebuild it alongside the Lisp bindings. This uses the wxWidgets 3.2.12 inventory baseline; application traits, arbitrary event-loop objects, generic event binding, pending-event suspension/deletion, filters, propagation, idle handlers, timers and worker dispatch remain open C1 work.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/application-events.lisp" "application-events example") " displays main-loop state from a button callback:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp \\
  --eval '(wxlambda-application-events:start)'") (:p "The reusable " (:code "exercise") " invokes that same callback once through explicit pending dispatch and once through RUN, verifying the different loop states and cleaning up handlers/windows. The focused scenario also tests reentrancy from pending, GUI-poll and blocking-loop callbacks, synchronous text notifications, inactive sessions, debugger pauses and recovery after an escaping callback error:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/application-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/application-events.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete GUI runner includes this scenario. " (:ref "guide/docs/DOCSET.md" "Install the Cadre docset") " with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") to browse these APIs, this guide and the example together.") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound.") (:p "ABI43 " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") " provide safe FIFO work after callbacks, including modal/clipboard/destructive requests. Existing nested event callback guards still apply; pending-only dispatch does not run the action queue."))))
(:entry "guide/docs/APPLICATION-HANDLER.md" :names ("docs/APPLICATION-HANDLER.md") :kind :guide :kind-name "Guide" :summary "docs/APPLICATION-HANDLER.md" :sections (("Guide" (:heading 1 "Borrowed application event handler") (:p (:code "current-application-handler") " returns the session's unique " (:code "application-handler") " view of the bridge-owned wxApp. It is an " (:code "event-handler") ", not a window or a user-constructible application. It borrows native ownership; only application session cleanup destroys wxApp. Repeated lookups return the same Lisp object, including inside callbacks. Lookup requires the active main-thread session. The bridge supports one application session per process.") (:code-block "lisp" "(wxlambda:with-application ()
  (wxlambda:register-event-type :application-message :family :command)
  (let* ((app (wxlambda:current-application-handler))
         (binding (wxlambda:bind-event app :application-message
                    (lambda (event) (print (wxlambda:event-text event))))))
    (unwind-protect
         (progn
           (wxlambda:queue-event app :application-message :text \"Hello\")
           (wxlambda:process-pending-events))
      (wxlambda:unbind-event binding))))") (:p "The inherited generic binding, unbinding, queueing, synchronous dispatch, handler liveness and handler-enabled SETF operations apply to this view. Observer callbacks still Skip, so delivery does not imply a true PROCESS-EVENT handled result. Contexts and notify Veto/Allow retain their existing lifetime and snapshot rules. " (:code "event-source") " is the cached application view when it is the binding receiver. Supported types remain built-ins and registered command/ notify types; no new native event families are introduced.") (:p (:code "make-instance") " on APPLICATION-HANDLER or its subclasses signals an error; MAKE-EVENT-HANDLER cannot manufacture it either. Subclassing cannot replace the managed native wxApp or install virtual overrides. DESTROY-EVENT-HANDLER rejects the borrowed view before deleting anything, including during a callback. Native application identity uses an opaque handle distinct from windows and owned standalone handlers. No native pointer is public.") (:p "HANDLER-ENABLED-P reads or writes wxApp's own wxEvtHandler enabled flag. Disabling it can suppress application event processing and delay application-queued work, including deferred receiver disposal, potentially until session cleanup. Restore it with UNWIND-PROTECT when temporarily changing it. It is independent of RUN's loop state. Bindings are removed before native application cleanup. A saved view cannot perform native operations outside the session; these signal NATIVE-ERROR. Saved immutable event snapshots remain readable, including their source view, without implying that the source is still live.") (:p "This is a bounded wxWidgets 3.2.12 GetInstance/wxTheApp mapping. Application construction, subclass hooks, traits, top-window operations, replacement of an external wxApp and native application overrides remain unbound. Session-event bindings and logging-off metadata are available; real OS delivery remains unverified. In particular, native query/end-session events route to wxApp and default END_SESSION can exit the process. Synthetic session events are restricted to isolated owned handlers; application/window receivers reject emission before event creation. See " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " for routing restrictions and native policy.") (:p "Run the example (it queues a message, verifies delivery, unbinds and exits):") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-handler.lisp --eval '(wxlambda-application-handler:start)'") (:p (:code "tests/application-handler.lisp") " also checks cached identity, inherited notify dispatch and final veto, disabling/restoration, construction and destruction rejection, binding cleanup, expired native access and saved snapshots.") (:p "Build/check the docset with " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery, API lookup and examples. See " (:ref "guide/docs/DOCSET.md" "docset installation") ", " (:ref "guide/docs/EVENT-HANDLERS.md" "handlers") " and " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify events") "."))))
(:entry "guide/docs/AUI-NOTEBOOK.md" :names ("docs/AUI-NOTEBOOK.md") :kind :guide :kind-name "Guide" :summary "docs/AUI-NOTEBOOK.md" :sections (("Guide" (:heading 1 "Dynamic AUI notebooks and splitter panes") (:p (:code "aui-notebook") " is a native-backed WINDOW class for general dynamic window workspaces. It owns PANEL pages; put any supported controls or layouts inside those panels. It supplies no editor buffer, document, file, project or persistence abstraction. The existing " (:code "notebook") " retains its separate native class and scope.") (:code-block "lisp" "(defparameter book (wxlambda:make-aui-notebook parent))
(defparameter page (wxlambda:make-panel book))
(wxlambda:add-notebook-page book page :label \"Tools λ\" :select t)
(wxlambda:insert-notebook-page book another-page 0 :label \"Overview\")
(wxlambda:notebook-page-count book)
(wxlambda:notebook-page book 0)          ; canonical EQ page wrapper
(wxlambda:notebook-page-index book page) ; current index or NIL
(setf (wxlambda:notebook-page-label book 0) \"Overview λ\")
(setf (wxlambda:selection book) 0)        ; silent native selection
(setf (wxlambda:selection book :notify t) 1) ; native vetoable navigation
(wxlambda:move-notebook-page book 1 0)    ; silent, selected identity preserved
(wxlambda:split-notebook-page book 1 :right) ; native tab group, same page owner
(wxlambda:remove-notebook-page book 0)   ; returns hidden, live PANEL
(wxlambda:delete-notebook-page book 0)   ; destroys selected indexed page; returns T") (:p "Construction requires a live " (:code ":parent") " WINDOW. The thin factory validates " (:code ":class") " and forwards subclass initargs. Direct subclasses/default initargs/native-ready AFTER hooks and managed initializer failure/root rollback follow the CLOS API. The native " (:code "aui") " library and " (:code "wxUSE_AUI=1") " are build prerequisites.") (:p "Tabs use a fixed top-tab style with scrolling, an active-tab close button and mouse reordering while the notebook has one tab group. Programmatic native splitting and movement are described below. External notebook transfer/reparenting, mouse drag splitting, middle-button close, arbitrary style flags, art providers, page icons, raw tab/manager resources and docking/perspective APIs are not exposed. Native dragging changes current indices; retain canonical page wrappers and ask " (:code "notebook-page-index") " when acting later. No operation turns Lisp subclassing into native C++ virtual callbacks.") (:p (:code "split-notebook-page") " calls native " (:code "wxAuiNotebook::Split") " with a current global page index and one of " (:code ":left") ", " (:code ":right") ", " (:code ":top") " or " (:code ":bottom") "; it returns BOOK. At least two pages are required. Native private tab groups are created and arranged without reparenting page windows: each page remains a direct child of the same book, with the same wrapper, bridge ID and global catalogue index. Splitting a group's sole page can replace that group rather than increase the number of groups. Geometry is native policy. Splitting may notify selection; a selection veto does not undo the already committed group structure, so read actual " (:code "selection") " afterward.") (:p "Pinned3.2.12 mouse drag handlers mix group-local indices with global page indices. To preserve page/selection identity, mouse movement is disabled while multiple groups exist, and native drag completion is cancelled with native hint/cursor cleanup. It is restored when removal/movement leaves one group. Use " (:code "move-notebook-page") " for checked moves in split notebooks; its remove/insert places the moved page in the active native group and may remove an empty source group. Mouse drag splitting (" (:code "wxAUI_NB_TAB_SPLIT") ") remains disabled; the supported split operation is the existing native programmatic method, not a constructor policy.") (:p "Native private tab handlers in3.2.12 cover501 tab-group IDs per notebook lifetime. The adapter refuses a split or an empty-book insertion that would allocate beyond that range; removing groups does not replenish it. Existing pages remain usable, selectable and removable; create a new notebook to obtain a fresh native range. This prevents creating private tabs with unusable native click/close handlers.") (:heading 2 "Pages, identity and mutation") (:p "At most256 pages may be attached. Insert accepts an index from0 through current count; ordinary page/selection indices must already exist. Captions are copied, NUL-free strings of at most4096 UTF-8 bytes; empty is valid. Exact native rendering and mnemonic treatment are port policy. A page must be a fully initialized direct unsizered PANEL child of that book, with no existing page membership. Native InsertPage can reparent arbitrary windows, but this binding deliberately refuses that ownership change. Pages cannot attach themselves during their own initializer.") (:p "Page wrappers are strongly rooted before native publication, so callbacks see canonical identity. An internal book binding retains that canonical identity; the transport prunes closed-page roots before user CLOSED callbacks, so a consuming context cannot bypass cleanup. Explicit removal/deletion updates roots at its Lisp boundary. Cleanup still runs when an earlier callback condition is pending, without replacing that original condition or calling user handlers. Callback errors are re-signalled after native return; successful publication/removal may already have happened. Moves are staged as native remove/insert while events are blocked, then restore the selected page by identity. Native allocation failures are not a general transaction guarantee; a failed move may leave a live detached page that can be explicitly reinserted.") (:p "Remove hides a page without deleting or reparenting it. The returned wrapper remains a native child of the book, can be reinserted or explicitly destroyed, and still dies with its native parent. Delete destroys the page and its descendants; saved wrappers become invalid. Direct destruction of an attached page is rejected. Destroy the book/ancestor or use the explicit page deletion operation. A row/column sizer belongs inside a page, not on the book. Managed handler-stack protocols reject AUI notebooks because their internal manager/tab handlers remain private.") (:p "All AUI writers reject Lisp callback use and an active native tab drag/mouse capture. Finish the tab gesture before retrying a change. Structural add/insert/remove/delete/move/split requires a quiescent boundary or the outer owner-bound deferred UI action phase. Use " (:code "defer-ui-action") " from menu/button/key/tab callbacks. Ordinary scalar selection and caption writes remain main-thread operations outside callbacks. Readers may run in callbacks while lifetimes remain valid. Notifying selection returns its requested index even if vetoed; read " (:code "selection") " for actual state. The first page becomes selected under native rules; exact selection-event counts on insertion, deletion, unchanged assignments and physical input can vary.") (:heading 2 "Native events and close policy") (:p "The notify-family native-only event kinds are " (:code ":aui-page-changing") ", " (:code ":aui-page-changed") ", " (:code ":aui-page-close") ", " (:code ":aui-page-closed") " and " (:code ":aui-drag-done") ". Bind ordinary observers or current borrowed contexts with " (:code "bind-event") ". " (:code "event-selection") " is native index metadata; " (:code "event-old-selection") " reports native old-selection metadata when available. " (:code "event-aui-page-id") " is an immutable numeric bridge identity for the captured target, or NIL if unavailable. It does not adopt or resurrect a page wrapper. The native CLOSED event carries a former index after removal; its saved target ID is captured during the native close span, never by looking up that now-shifted index. DRAG-DONE metadata follows native event meaning, not an application-defined old/new ordering transaction. Native drag completion can return early, so no exact notification count or full old/new ordering transaction is promised. Private group-local selection events are suppressed at the Lisp boundary. Public " (:code "event-selection") " reports the book's global catalogue index when that native event defines it; " (:code "event-old-selection") " keeps its distinct native semantics and can be group-local for CLOSE.") (:p "Payload text/integer/selection/extra metadata and event-ID writers reject for these kinds; normal scoped Skip/propagation/veto controls retain their contracts. CHANGING and CLOSE can veto upcoming native actions. CHANGED/CLOSED have already happened, so veto metadata does not reverse them. A native close emits CLOSE, deletes the page if allowed, then emits CLOSED. Explicit " (:code "delete-notebook-page") " is a deletion command and does not manufacture or promise the user-close veto/event sequence. Applications can first veto a close, capture its page identity, and defer any modal decision. Resolve that retained page's current index at delivery before explicit deletion. Never retain a borrowed context for deferred use.") (:p "The bridge guards the complete native tab-button/drag handler span, including callbacks propagated to ancestors. It protects the book, attached/participating pages and ancestors against destruction/close; same-book mutation and nested GUI, modal, clipboard and scheduler entry reject until native work returns. Composite private child input and native teardown retain Input operation protections. Owned/synthetic/queued construction and detached cloning of AUI event kinds reject. Snapshots remain immutable; contexts are valid only in the innermost callback.") (:heading 2 "Dynamic splitter extension") (:p "The existing fixed two-pane " (:code "split-window") " remains available. New generic window operations allow one-pane initialization, explicit unsplit/re-split, replacement and SETF orientation:") (:code-block "lisp" "(wxlambda:initialize-splitter splitter first-panel)
(wxlambda:resplit-window splitter second-panel)
(wxlambda:replace-splitter-pane splitter 1 replacement-panel) ; returns old panel
(wxlambda:unsplit-window splitter :remove 1)                 ; returns removed panel
(setf (wxlambda:splitter-orientation splitter) :horizontal)  ; or :vertical") (:p "Initialize requires an empty splitter. Resplit requires exactly one attached pane and attaches its supplied pane as the second. Replacement addresses an existing pane0/1. Removed/replaced panels are hidden and retained alive as native children; they are no longer attached and may be reused or destroyed explicitly. Unsplit removal0 leaves the former second pane at index0. Parent teardown invalidates all children, including detached hidden panels. New panes must be fully initialized distinct direct unsizered PANEL children and cannot already be attached.") (:p "These operations reject callbacks and require a safe structural boundary. Roots are published before native sizing/focus work; old/new pane lifetimes and ancestor guards cover synchronous native callbacks. Existing positive minimum size, suppressed double-click unsplit, sash geometry clamping and sash-event semantics remain. Orientation is now mutable through the generic SETF protocol; it retiles existing panes and uses native geometry/readback, not exact requested pixels. Explicit Unsplit does not promise a native sash-triggered UNSPLIT notification; new resize/double-click/unsplit event families remain unbound.") (:heading 2 "Example and verification") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/aui-notebook.lisp \\
  --eval '(wxlambda-aui-notebook:start)'") (:p "The example creates general panel pages through owner-bound deferred Add/Delete/ Move/Split actions inside a two-pane window; tabs can be closed, and native mouse reordering is available while there is one group. Tests cover canonical pages, detach/delete distinction, selection veto, callback deferral, CLOS rollback, stale identities and dynamic splitter panes. Fabricated Lisp transport tests separately verify cleanup before a consuming CLOSED callback and while a pending condition skips user callbacks. The native invariant helper additionally drives the actual private close-button path and propagated veto, captured CLOSED target identity, synchronous replacement sizing, foreign-thread rejection, split-group global-index translation, native private-ID exhaustion guards and teardown. Native rendering, physical drag/focus, accessibility and hosted GTK/MSW behavior require separate runtime checks. The binding targets pinned wxWidgets3.2.12 and makes no full wxAUI parity claim."))))
(:entry "guide/docs/BINDING-USER-DATA.md" :names ("docs/BINDING-USER-DATA.md" "BINDING-USER-DATA") :kind :guide :kind-name "Guide" :summary "docs/BINDING-USER-DATA.md" :sections (("Guide" (:heading 1 "Rooted Lisp user data on individual bindings") (:p "ABI 31 adds " (:code ":user-data") " to BIND-EVENT and the read-only EVENT-USER-DATA generic. The baseline is wxWidgets 3.2.12. User data belongs to one registration, not to the receiving handler as a whole or to a reusable owned-event payload.") (:p "BIND-EVENT accepts any Lisp object; NIL means no association. The value is retained by EQ with the binding's callback roots. It does not alter callback arity: observers still receive one immutable snapshot, and " (:code ":with-context t") " callbacks still receive " (:code "(snapshot context)") ". Retrieve the value with EVENT-USER-DATA instead of expecting an extra callback argument.") (:code-block "lisp" "(let* ((state (list :count 0))
       (binding
         (wxlambda:bind-event receiver :message
           (lambda (event context)
             (assert (eq state (wxlambda:event-user-data event)))
             (let ((value (wxlambda:event-user-data context)))
               (incf (getf value :count))))
           :with-context t :user-data state)))
  (unwind-protect
       (wxlambda:process-event receiver :message)
    (wxlambda:unbind-event binding)))") (:p "The receiver/kind must already be valid and " (:code ":message") " registered as appropriate. The complete runnable example supplies that setup and cleanup.") (:heading 2 "Immutable association, ordinary mutable Lisp value") (:p "A snapshot captures the association before its callback. EVENT-USER-DATA on that snapshot needs no native session and remains usable after unbinding, receiver cleanup or session end. It retains the same Lisp reference, not a deep copy. Mutable object contents can change and those changes are visible through other references and earlier snapshots. Immutable snapshot structure does not freeze an arbitrary list/hash-table/object stored inside it.") (:p "No SETF EVENT-USER-DATA or binding-data mutation API is supplied. To replace the association, unbind and create a new registration. Existing snapshots retain the old reference; another binding can use a different value on the same receiver, kind and callback function.") (:p "For generalized places such as GETF, first bind the reader's result to a local variable as above. Direct " (:code "(incf (getf (event-user-data context) :count))") " can require a nonexistent SETF EVENT-USER-DATA even when modifying existing plist contents. Assigning a new object to that local variable does not replace the binding association; mutate the existing object or rebind explicitly.") (:heading 2 "Current-context lifetime and self-unbinding") (:p "Context reads require an active main-thread session and the innermost current callback. The native context captures the binding identity before invoking Lisp; a local Lisp dispatch frame retains its value until callback return. Self-unbind, peer-unbind or garbage collection therefore cannot invalidate the active association merely by removing its global binding roots.") (:p "The reader does not dereference a binding userData pointer after unbinding has deleted its native adapter. Nested dispatch suspends outer context access; after it returns, the outer association is restored. Expired/suspended contexts signal NATIVE-ERROR even when the data itself is an ordinary still-live object. Retaining a context does not grant future access; retain a snapshot/value instead.") (:p "Unbinding, receiver deletion and session cleanup release binding roots according to the existing callback/lifetime rules. Captured snapshots, active frames and ordinary application references may independently keep the Lisp object alive. No immediate garbage-collection timing, worker-thread binding or cross-session native callback is promised.") (:heading 2 "Native ownership and the three separate data mechanisms") (:p "A native wxObject adapter stores only an opaque numeric binding token. The wxWidgets Bind entry owns/deletes that adapter on disconnect/teardown. The Lisp binding/dispatch roots hold the actual Lisp value; no Lisp address or arbitrary native pointer is exported. This is a prerequisite use of wxObject, not a public generic wxObject factory/adoption interface.") (:list (:item (:p "EVENT-USER-DATA is per-binding callback association, captured into snapshots."))) (:list (:item (:p "EVENT-HANDLER-CLIENT-DATA is a separate handler-wide EQ value in a wxClientData"))) (:p "token adapter. Changing it does not replace any binding user data.") (:list (:item (:p "wxCommandEvent client data/client object and control item data are still"))) (:p "separate native payload/ownership APIs and remain unbound.") (:p "Live OWNED-EVENT reads validate the resource and return NIL because safe owned events do not carry borrowed binding pointers. A non-null borrowed pointer rejects rather than being adopted. No user-data constructor or synthetic queue/process keyword payload is added; data comes from the matching binding when delivery occurs. Existing convenience ON-* registrations do not gain a USER-DATA keyword; their snapshots report NIL.") (:p "CLONE-EVENT still rejects a current event carrying non-null borrowed native binding userData, including after self-unbind. The guard only tests pointer presence and does not dereference a deleted adapter. A saved snapshot/value is the supported way to retain that Lisp association; an owned native clone does not adopt it. NIL-data bindings leave the prior supported clone behavior intact.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/binding-user-data.lisp --eval '(wxlambda-binding-user-data:start)'") (:p "The optional native invariant target also checks captured context identity after self-unbinding, expired context rejection and owned borrowed-pointer guards:") (:code-block "sh" "cmake -S . -B build-native-tests -DWXLAMBDA_BUILD_NATIVE_TESTS=ON
cmake --build build-native-tests --target wxlambda-client-data-native
./build-native-tests/wxlambda-client-data-native") (:p "It is OFF by default, requires a native GUI-capable process and injects internal states without public pointer APIs. Require zero captured native assertions. Local validation does not establish hosted Windows/Linux GUI, real OS-session or graphical Cadre behavior. General native userData adoption, mutable binding associations, untyped/client/item payload ownership and arbitrary wxObject wrappers remain C1 work.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-BINDINGS.md" "bindings") ", " (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "handler client data") ", " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/CLIPBOARD.md" :names ("docs/CLIPBOARD.md" "CLIPBOARD") :kind :guide :kind-name "Guide" :summary "docs/CLIPBOARD.md" :sections (("Guide" (:heading 1 "Text clipboard") (:p "ABI35 exposes text on the standard system clipboard through three public names:") (:code-block "lisp" "(wxlambda:clipboard-text-available-p) ; T/NIL, advisory only
(wxlambda:clipboard-text)            ; independent string, or NIL for no text
(setf (wxlambda:clipboard-text) \"Hello λ\") ; returns that same Lisp string
(wxlambda:flush-clipboard)           ; T if persistence succeeds, NIL otherwise") (:p "All operations require an active application on the main thread. " (:code "clipboard-text") " and its SETF writer are generic functions, following the property protocol even though the clipboard has no public receiver object. Availability and flush are ordinary functions. Each operation briefly opens the native clipboard, closes it on completion/failure and restores any preexisting primary-selection preference. The API always selects the standard clipboard, not X11 PRIMARY. It rejects an already-open clipboard rather than closing a lock owned by other native code. ABI37 also rejects clipboard entry during notebook navigation/page callbacks or list/tree-origin selection callbacks; defer transfers until navigation returns. Reentrant clipboard access is rejected; outer borrowed event contexts are suspended across a native transfer and resume afterward. Callback conditions remain contained at the C boundary and re-signal after lock cleanup, taking precedence over native transfer errors. As with other native operations, earlier side effects are not rolled back when a callback condition escapes.") (:heading 2 "Text and persistence") (:p "NIL means no supported native text is present; " (:code "\"\"") " is available empty text. A failed open or supported-text transfer signals " (:code "native-error") ", rather than returning NIL. Availability can change before a later read; Paste should read directly and handle NIL/errors. Reads copy UTF-8 into an independent Lisp string. Unicode text is preferred, with the native legacy text format accepted as fallback; conversion and line endings follow the wxWidgets port. Embedded NUL is rejected on reads and writes. Non-string writes have no applicable SETF method. The setter replaces all prior clipboard formats and transfers a text data object to wxWidgets; it does not append or preserve images, HTML, files or other formats. There is no automatic clipboard restoration or transactional rollback of failed native writes.") (:p "Writing does not imply persistence after the application exits. " (:code "flush-clipboard") " is a separate best-effort request and returns NIL when unsupported or unsuccessful; a valid false result is not " (:code "native-error") ". The pinned documentation identifies MSW/GTK persistence support, with port-specific differences; no guarantee is made for macOS or for clipboard contents surviving exit without a successful flush. Open/session failures still signal. No raw Open/Close, Clear, PRIMARY selection, data-object classes, asynchronous format callbacks, clipboard events, binary/image/ file payloads, control selection ranges or Cut are exposed in this slice.") (:heading 2 "Examples") (:p (:code "examples/clipboard.lisp") " has an interactive START with Copy whole field and Replace field from clipboard buttons. Copy changes the system clipboard only when clicked. Paste accepts a single line, including an empty string, and reports absent text or transfer errors. Automatic EXERCISE only queries availability:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/clipboard.lisp --eval '(wxlambda:with-application () (wxlambda-clipboard:exercise))'
sbcl --load ~/quicklisp/setup.lisp --load examples/clipboard.lisp --eval '(wxlambda-clipboard:start)'") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " adds Edit / Copy name and Paste name. Copy leaves dirty state unchanged; Paste replaces the whole name and compares it against the saved baseline. No clipboard text leaves the form unchanged, while multiline text is rejected before mutation. Clipboard errors use its existing error dialog. These actions are not native text-control selection editing or an operating system shortcut implementation.") (:heading 2 "Verification boundaries") (:p "Native invariant tests substitute an in-memory " (:code "wxClipboardBase") " only in the test executable; that substitution is absent from the production bridge and has no ABI export. They cover Unicode/empty/no-text/large transfers, ownership on success and failure, lock cleanup, PRIMARY restoration, malformed input, legacy text fallback, reentrancy, worker-thread rejection and flush true/false. MSW/OLE retains caller ownership on failed SetData, unlike the reviewed GTK/macOS paths; both cleanup policies are exercised by the test double. Hosted ports still need runtime checks. Lisp tests cover copied storage, generic SETF return/type behavior, callback/error precedence, native error text preservation across root cleanup and form Copy/Paste. The only live system-clipboard operation in automatic tests is availability: existing clipboard content/formats are neither read nor replaced. Actual external application interoperability, live writes and exit persistence remain manual checks; do not infer them from the isolated test double. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:p "ABI43 " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") " provide safe FIFO work after callbacks, including modal/clipboard/destructive requests. Existing nested event callback guards still apply; pending-only dispatch does not run the action queue.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes these APIs with deferred shared Open/Save/Copy/Paste/close requests, toolbar/keyboard entry points and status feedback. Its coalescing and scoped close-replay policy are application logic; no extra public binding or native parity claim is introduced."))))
(:entry "guide/docs/CLOS-API.md" :names ("docs/CLOS-API.md" "CLOS-API") :kind :guide :kind-name "Guide" :summary "docs/CLOS-API.md" :sections (("Guide" (:heading 1 "CLOS widget API") (:p "The " (:code "WXLAMBDA") " package has the nickname " (:code "WX") ": " (:code "wx:make-frame") ", " (:code "wx:frame") " and " (:code "(setf (wx:frame-title frame) \"Title\")") " use the same symbols as their " (:code "wxlambda:") " spellings. Load the ASDF/Quicklisp system as " (:code "\"wxlambda\"") "; its system name and the docset's canonical " (:code "WXLAMBDA") " package are unchanged.") (:p "Widgets are native-backed CLOS instances. The public classes are " (:code "window") ", " (:code "styled-text-control") ", " (:code "aui-notebook") ", " (:code "grid") ", " (:code "web-view") ", " (:code "drawing-canvas") ", " (:code "activity-indicator") ", " (:code "frame") ", " (:code "toolbar") ", " (:code "status-bar") ", " (:code "panel") ", " (:code "scrolled-panel") ", " (:code "notebook") ", " (:code "list-box") ", " (:code "tree-control") ", " (:code "splitter-window") ", " (:code "button") ", " (:code "text-control") ", " (:code "label") ", " (:code "checkbox") ", " (:code "choice") ", " (:code "gauge") ", " (:code "slider") ", " (:code "spin-control") ", " (:code "radio-box") ", " (:code "toggle-button") ", " (:code "combo-box") ", " (:code "date-picker") ", " (:code "time-picker") ", " (:code "search-control") ", abstract " (:code "dialog") ", and its " (:code "text-entry-dialog") ", " (:code "single-choice-dialog") ", " (:code "message-dialog") " and " (:code "file-dialog") " concrete families. " (:code "window") " inherits from " (:code "event-handler") " and is abstract. Standalone " (:code "event-handler") " instances are native-backed session-owned resources; window instances reuse their existing native widget as a borrowed handler identity. See " (:ref "guide/docs/EVENT-HANDLERS.md" "ownership and handler state") ". Every concrete window wrapper inherits from " (:code "window") " and represents one native widget kind. Native handles remain private and validated.") (:heading 2 "Construction") (:p "Use " (:code "make-instance") " directly, including for your own subclasses:") (:code-block "lisp" "(defclass document-frame (wxlambda:frame)
  ((project :initarg :project :reader project)
   (title-changes :initform 0 :accessor title-changes))
  (:default-initargs :title \"Document\"))

(defmethod initialize-instance :after ((frame document-frame) &key)
  ;; Inherited initialization has already created the native widget.
  (setf (wxlambda:window-name frame) (project frame)))

(defmethod (setf wxlambda:frame-title) :after (value (frame document-frame))
  (declare (ignore value))
  (incf (title-changes frame)))

(wxlambda:with-application ()
  (let ((frame (make-instance 'document-frame :project \"example\")))
    (setf (wxlambda:frame-title frame) \"Document — λ\")
    (assert (= 1 (title-changes frame)))
    (assert (string= \"example\" (wxlambda:window-name frame)))
    (wxlambda:destroy-window frame)))") (:p "Concrete native initargs are:") (:list (:item (:p (:code "frame") ": " (:code ":title") " (default \"wxlambda\"), " (:code ":width") " (480), " (:code ":height") " (240), " (:code ":accelerators") " (NIL). See " (:ref "guide/docs/KEYBOARD-ACCELERATORS.md" "keyboard actions") "."))) (:list (:item (:p (:code "styled-text-control") ": required " (:code ":parent") ", " (:code ":value") " defaults empty UTF-8 text. Native byte offsets and manual container styling; see " (:ref "guide/docs/STYLED-TEXT.md" "styled text") "."))) (:list (:item (:p (:code "aui-notebook") ": required " (:code ":parent") "; dynamic native PANEL pages with removal/deletion distinction. See " (:ref "guide/docs/AUI-NOTEBOOK.md" "AUI tabs") "."))) (:list (:item (:p (:code "grid") ": required " (:code ":parent") "; rows10/columns5/editable-pT defaults; bounded owned string table with native editing/selection events and row/column mutations. See " (:ref "guide/docs/GRID.md" "grid") "."))) (:list (:item (:p (:code "web-view") ": required " (:code ":parent") "; initial about:blank, private WKWebView browser and asynchronous JavaScript. See " (:ref "guide/docs/WEB-VIEW.md" "web development") "."))) (:list (:item (:p (:code "drawing-canvas") ": required " (:code ":parent") "; " (:code ":content") " defaults to an empty white retained scene. See " (:ref "guide/docs/DRAWING-CANVAS.md" "drawing") "."))) (:list (:item (:p (:code "activity-indicator") ": required " (:code ":parent") "; " (:code ":running-p") " defaults to NIL. See " (:ref "guide/docs/ACTIVITY-INDICATORS.md" "activity feedback") "."))) (:list (:item (:p (:code "panel") ": required " (:code ":parent") " window."))) (:list (:item (:p (:code "search-control") ": required " (:code ":parent") "; " (:code ":value") " defaults " (:code "\"\"") ", " (:code ":hint") " defaults " (:code "\"Search\"") ". Lisp WINDOW ancestry, bounded TEXT/hint properties only; see " (:ref "guide/docs/SEARCH-CONTROLS.md" "search controls") "."))) (:list (:item (:p (:code "time-picker") ": required " (:code ":parent") "; " (:code ":time") " defaults to " (:code "(0 0 0)") ", a copied hour/minute/second tuple. See " (:ref "guide/docs/TIME-PICKER.md" "time-of-day values") "."))) (:list (:item (:p (:code "date-picker") ": required " (:code ":parent") "; " (:code ":date") " defaults to " (:code "(2000 1 1)") ", a copied required Gregorian date in 1900..2100. See " (:ref "guide/docs/DATE-PICKER.md" "calendar dates") "."))) (:list (:item (:p (:code "slider") ": required " (:code ":parent") "; :minimum0/:maximum100/:value0, :orientation :horizontal."))) (:list (:item (:p (:code "spin-control") ": required " (:code ":parent") "; :minimum0/:maximum100/:value0. Both numeric families use strict bounds within ±1000000; see " (:ref "guide/docs/NUMERIC-INPUT.md" "numeric input") "."))) (:list (:item (:p (:code "toolbar") ": required " (:code ":parent") " frame; fixed tools after realization."))) (:list (:item (:p (:code "status-bar") ": required " (:code ":parent") " frame, " (:code ":fields") " (1, range 1..16). See " (:ref "guide/docs/FRAME-ACTIONS.md" "frame actions") "."))) (:list (:item (:p (:code "button") ": required " (:code ":parent") ", " (:code ":label") " (\"Button\")."))) (:list (:item (:p (:code "text-control") ": required " (:code ":parent") ", " (:code ":value") " (empty string)."))) (:list (:item (:p (:code "label") ": required " (:code ":parent") ", " (:code ":label") " (empty string)."))) (:list (:item (:p (:code "checkbox") ": required " (:code ":parent") ", " (:code ":label") " (empty string), " (:code ":checked") " (NIL)."))) (:list (:item (:p (:code "gauge") ": required " (:code ":parent") ", " (:code ":range") " (100), " (:code ":value") " (0), " (:code ":orientation")))) (:p "(" (:code ":horizontal") " or " (:code ":vertical") "). See " (:ref "guide/docs/GAUGE.md" "gauge behavior") ".") (:list (:item (:p (:code "choice") ": required " (:code ":parent") ", " (:code ":items") " (NIL), " (:code ":selection") " (NIL)."))) (:p "Construction requires an active main-thread application session. Inherited " (:code "initialize-instance") " methods allocate exactly one native widget. Subclass " (:code ":default-initargs") ", slot initargs and ordinary " (:code ":after") " hooks work normally; these hooks can read/write native properties. An overriding primary initializer must call its inherited method. Unsupported abstract classes, missing parents, unknown initargs, repeated initialization and multiple native widget bases are rejected with clear errors. Supplying a raw " (:code ":handle") " is unsupported.") (:p "Failures during inherited initialization and subclass " (:code ":before") "/" (:code ":after") " hooks roll back native widgets created through this protocol in that initialization, including nested construction, and remove their callback roots. Cleanup preserves the original condition or nonlocal exit. Custom outer " (:code ":around") " methods remain responsible for failures they introduce after the inherited initialization has completed.") (:heading 2 "Factory conveniences") (:p "The " (:code "make-*") " functions are thin wrappers around " (:code "make-instance") ". Each accepts " (:code ":class") " as a class name or class object and forwards additional initargs:") (:code-block "lisp" "(wxlambda:make-frame :class 'document-frame :project \"example\")
(wxlambda:make-button parent :class 'wxlambda:button :label \"Run\")") (:p "A factory validates that " (:code ":class") " is a subclass of its corresponding concrete widget class. Child factories dispatch on their parent; methods extending a factory should accept " (:code "&rest") "/" (:code "&allow-other-keys") " to forward subclass initargs. " (:code "make-frame") " remains an ordinary function because it has no required dispatch argument. Application lifecycle functions/macros and immutable event snapshots keep their separate roles.") (:heading 2 "Generic properties") (:p "Use these thirteen generic " (:code "setf") " accessors:") (:code-block "lisp" "(setf (wxlambda:text input) \"Text\")
(setf (wxlambda:label-text caption) \"Ready\")
(setf (wxlambda:checked-p checkbox) t)
(setf (wxlambda:selection choice) 0)
(setf (wxlambda:window-name window) \"logical-name\")
(setf (wxlambda:frame-title frame) \"Title\")
(setf (wxlambda:shown-p window) nil)
(setf (wxlambda:enabled-p window) t)
(setf (wxlambda:gauge-value gauge) 25)
(setf (wxlambda:gauge-range gauge) 100)
(setf (wxlambda:handler-enabled-p handler) t)
(setf (wxlambda:event-skipped-p context) t) ; only in its contextual callback
(setf (wxlambda:event-vetoed-p context) t)  ; only in a vetoable close context") (:p "A writer's method lambda list starts with the new value, followed by the receiver. Specialize " (:code "(setf accessor)") " with primary, " (:code ":around") ", " (:code ":before") " or " (:code ":after") " methods; " (:code "call-next-method") " retains inherited behavior. Assignment returns the supplied value. Boolean reads normalize generalized booleans to T/NIL. The shown/enabled writers also return a native changed-state flag as a second value; " (:code "show-window") "/" (:code "enable-window") " are action conveniences returning the window and that flag.") (:p "Text, checkbox and selection writes are silent by default. Use " (:code ":notify t") " on the place for synchronous command events:") (:code-block "lisp" "(setf (wxlambda:text input :notify t) \"Changed\")
(setf (wxlambda:checked-p checkbox :notify t) t)
(incf (wxlambda:selection choice :notify t))") (:p "The corresponding readers accept and ignore " (:code ":notify") ", so modifying macros can read the same place. Callback conditions are re-signaled at the writer's Lisp boundary. Reads of " (:code "shown-p") " use the own shown flag; reads of " (:code "enabled-p") " include disabled ancestors, while its writer requests the own enabled state.") (:p "This project is establishing its API from the ground up: the six separate " (:code "set-*") " property aliases and compatibility-only wrong-receiver methods have been removed. Unsupported receiver types signal standard Lisp dispatch errors; native handle/state failures still signal " (:code "native-error") ".") (:heading 2 "Scope and verification") (:p "The " (:ref "example/examples/window-metadata.lisp" "metadata example") " uses direct subclass construction and a generic writer hook. Lisp subclassing extends the wrapper; it does not change the native C++ class or provide native virtual callbacks. Native ownership, main-thread restrictions and explicit handler unbinding before destruction still apply. Start a fresh Lisp when changing these class definitions. The " (:ref "guide/docs/THREAD-EVENTS.md" "thread event") " " (:code "queue-thread-event") " generic is the bounded worker-safe exception: it copies payloads to a GUI-registered existing receiver; construction, binding, property access and callback dispatch stay on the GUI thread.") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/clos.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/clos.lisp") (:p "The CLOS test covers direct native construction for the original seven concrete types, subclass slots/defaults/hooks, all factory " (:code ":class") " paths, invalid construction, initializer rollback of nested native objects and callback roots, eight generic writers, method combination and native handle protection. Those checks exercise the original 34 named generic functions and eight generic SETF functions. The docset includes construction instructions on class pages and indexed SETF forms on property pages.") (:p "The gauge scenario additionally verifies direct and factory subclass construction, subclass AFTER access, rollback, and the two gauge SETF writers. Across the public API there are now 55 named generic functions and thirteen generic SETF functions.") (:p "Independent " (:code "event-binding") " values are immutable registration identities rather than native-backed CLOS resources. The generic " (:code "bind-event") ", " (:code "unbind-event") ", " (:code "binding-active-p") " and " (:code "queue-event") " operations cover the four current command kinds; see " (:ref "guide/docs/EVENT-BINDINGS.md" "binding scope and lifecycle") ".") (:p (:code "event-context") " is a borrowed, immutable-token view whose generic operations mutate a native event only during its current callback. Its scoped SETF writer does not change immutable snapshot semantics. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "context lifetime") ".") (:p "Close capability/veto readers accept immutable snapshots or current contexts; the veto SETF writer accepts only a current vetoable close context. Frame close requests use the generic " (:code "close-window") "; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close-family scope") ".") (:p (:code "process-event") " synchronously dispatches supported copied events and returns native handled/final-veto values. Registered custom families remain session-scoped metadata; see " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify type scope") ".") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. General native event/client/item pointer ownership remains unbound; per-binding Lisp USER-DATA is separately supported.") (:heading 2 "Native-owned menu resource classes") (:p "MENU-RESOURCE is abstract; MENU-BAR, MENU and MENU-ITEM are native-backed resource classes outside the window/event-handler hierarchy. Direct MAKE-INSTANCE uses :PARENT frame/bar/menu. Generic MAKE-MENU-BAR/MAKE-MENU/MAKE-MENU-ITEM accept validated :CLASS and subclass initargs, including DEFAULT-INITARGS. Native properties exist in subclass AFTER hooks. Mixed managed ancestry rejects before allocation; failed initialization removes its new native resource/descendants. This cleanup does not reverse arbitrary edits to existing external resources.") (:p "Native frame→bar→menu→items ownership controls lifetime. Explicit destruction or parent destruction invalidates descendant identities; wrappers and GC do not retain/delete native objects. Structural operations reject callbacks/pumps/RUN, while scalar label/check/enabled writes are allowed. See " (:ref "guide/docs/MENUS.md" "menus") " for separator constraints, raw labels, per-bar IDs and command routing.") (:heading 2 "Modal dialog families") (:p "DIALOG is an abstract WINDOW subclass. TEXT-ENTRY-DIALOG and SINGLE-CHOICE-DIALOG use native-backed direct initialization with optional :PARENT plus message/title and family payloads. Their keyword-only MAKE-* factories remain ordinary functions with validated :CLASS forwarding. Native properties are ready in subclass AFTER hooks; failure cleans new resources and roots. The modal-only protocol and active-modal/ancestor destruction guards are documented in " (:ref "guide/docs/STANDARD-DIALOGS.md" "standard dialogs") ". No native virtual subclass or general modeless/validation API is implied.") (:p "Generic MESSAGE-DIALOG and FILE-DIALOG extend the same DIALOG hierarchy with keyword-only ordinary factories and Construction entries. Their fixed generic wxWidgets backend preserves eager native properties for subclass AFTER hooks, explicit parent normalization and managed invalidation. Native OS dialog implementations remain unbound. See " (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "message/file workflows") ".") (:p "The singleton " (:code "clipboard-text") " property uses a zero-argument generic reader and a generic SETF writer specialized on STRING, without a public clipboard class. See " (:ref "guide/docs/CLIPBOARD.md" "text clipboard") " for transfer, errors and persistence scope.") (:p "Text controls accept " (:code ":multiline") " (default NIL) and " (:code ":editable-p") " (default T). Native properties are available in subclass AFTER hooks; editable/selection/caret properties have generic SETF. See " (:ref "guide/docs/TEXT-EDITING.md" "text editing") " for native offset semantics, notifying replacements, read-only policy and limits.") (:p "The concrete " (:code "notebook") " window uses native-backed CLOS construction and fixed fully initialized " (:code "panel") " pages. Page identity is rooted before native publication; page self-attachment during initialization rejects. See " (:ref "guide/docs/NOTEBOOK.md" "notebook navigation") ".") (:p (:code "list-box") " constructs an unsorted native single-selection list from " (:code ":items") " and " (:code ":selection") "; subclass AFTER hooks can query/edit it. Item text uses generic SETF. See " (:ref "guide/docs/LIST-BOX.md" "single-selection lists") " for item and callback lifetime rules.") (:p (:code "tree-control") " is a concrete native-backed window. " (:code "tree-item") " is a borrowed checked view, obtained from tree APIs rather than direct MAKE-INSTANCE. Canonical view identity can outlive native validity; see " (:ref "guide/docs/TREE-NAVIGATION.md" "tree ownership/navigation") ".") (:heading 2 "Fixed splitter panes") (:p "The bounded splitter batch adds native-backed " (:code "splitter-window") ", persistent panel panes and guarded sash notifications. See " (:ref "guide/docs/SPLITTER.md" "supported scope and example") ". Dynamic pane replacement/removal and complete splitter parity remain deferred.") (:heading 2 "Frame toolbar/status actions") (:p "Native-backed " (:code "toolbar") " and " (:code "status-bar") " add a bounded application-shell slice: fixed normal/check/separator tools with stock art and :menu action routing, silent tool state and application-owned indexed status fields. See " (:ref "guide/docs/FRAME-ACTIONS.md" "supported scope, backend policy and example") ". Native Cocoa toolbar chrome, dynamic tools and status widths/stacks remain deferred.") (:p "ABI43 " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") " provide safe FIFO work after callbacks, including modal/clipboard/destructive requests. Existing nested event callback guards still apply; pending-only dispatch does not run the action queue.") (:p "ABI44 UI-TIMER is an immutable scheduler identity obtained from START-UI-TIMER, like UI-ACTION for deferred work; it is not a native event-handler/resource wrapper. No public wxTimer subclass/Notify override/adoption protocol is exposed. See " (:ref "guide/docs/UI-TIMERS.md" "UI timers") ".") (:p "RADIO-BOX adds fixed mutually exclusive choices via :parent/:items/:label/:selection/:orientation; see " (:ref "guide/docs/RADIO-GROUPS.md" "radio groups") ".") (:p "TOGGLE-BUTTON supports :parent/:label/:checked with direct subclass slots/defaults and native-ready AFTER hooks. See " (:ref "guide/docs/TOGGLE-BUTTONS.md" "toggle buttons") ".") (:p "COMBO-BOX adds :parent/:items/:value/:selection with native-backed subclass construction, properties in AFTER hooks and managed rollback. See " (:ref "guide/docs/COMBO-BOXES.md" "combo boxes") ".") (:p "SCROLLED-PANEL is a WINDOW subtype backed by wxScrolled<wxPanel>, with :parent/:scroll-rate and native-ready subclass hooks. Nest it inside ordinary notebook/splitter PANEL content. See " (:ref "guide/docs/SCROLLING-PANELS.md" "scrolling panels") ".") (:p "DATE-PICKER is a WINDOW subtype with :parent/:date, a copied Gregorian tuple and native-ready subclass hooks. See " (:ref "guide/docs/DATE-PICKER.md" "required calendar dates") ".") (:p "TIME-PICKER is a WINDOW subtype with :parent/:time, a copied time-of-day tuple and native-ready subclass hooks. See " (:ref "guide/docs/TIME-PICKER.md" "time pickers") ".") (:p "SEARCH-CONTROL is a WINDOW subtype with :parent/:value/:hint, copied query and placeholder strings, and native-ready subclass hooks; it does not inherit Lisp TEXT-CONTROL. See " (:ref "guide/docs/SEARCH-CONTROLS.md" "search controls") "."))))
(:entry "guide/docs/CLOSE-EVENTS.md" :names ("docs/CLOSE-EVENTS.md" "CLOSE-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/CLOSE-EVENTS.md" :sections (("Guide" (:heading 1 "Close-event family and veto") (:p "This C1 slice extends bindings beyond command events with " (:code ":close") ", backed by " (:code "wxEVT_CLOSE_WINDOW") " and " (:code "wxCloseEvent") ". The four command kinds remain supported. " (:code "event-family") " classifies these snapshots as " (:code ":command") " or " (:code ":close") "; registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify events") " additionally use " (:code ":notify") "; this is a portable supported-kind classification, not arbitrary native RTTI or event registration. The baseline is wxWidgets 3.2.12 and the native bridge is ABI 31.") (:p "The native type lookup is now " (:b "`event-type`") ", replacing " (:code "command-event-type") " without an alias. It accepts the seven built-in kinds and registered command/notify names. Native type IDs remain process-local; saved snapshots keep immutable copied values.") (:heading 2 "Veto a real frame close request") (:code-block "lisp" "(wxlambda:bind-event frame :close
  (lambda (snapshot context)
    (format t \"Close can be vetoed: ~S~%\" (wxlambda:event-can-veto-p snapshot))
    (if (wxlambda:event-can-veto-p context)
        (setf (wxlambda:event-vetoed-p context) t)
        (setf (wxlambda:event-skipped-p context) t)))
  :with-context t)
(wxlambda:close-window frame) ; NIL if that handler vetoes") (:p (:code "event-can-veto-p") " reads the snapshot's captured capability or the current native context's " (:code "CanVeto") ". Command snapshots/contexts report NIL. " (:code "event-vetoed-p") " reads the snapshot's captured flag or the current close context's " (:code "GetVeto") ". Snapshots capture state " (:b "before this callback") " and never reflect later context mutation. Saved flags can be read without a native session; snapshots have no SETF method.") (:p "The canonical generic " (:code "(setf event-vetoed-p)") " writer applies only to the current close context. It checks the actual native event class and " (:code "CanVeto") " before calling " (:code "Veto(bool)") ". Setting or clearing a non-vetoable close, accessing live veto state on a command context, or using an expired/suspended context signals " (:code "native-error") " before any wx assertion or invalid pointer access. The writer returns the supplied generalized boolean. Vetoable contexts permit both veto and clearing a veto. Context SETF " (:code "event-can-veto-p") " now maps SetCanVeto directly, including false to true. It changes metadata and can hide/restore a stored veto; see " (:ref "guide/docs/EVENT-METADATA.md" "metadata semantics") ".") (:heading 2 "Acceptance, consumption, veto and destruction") (:p (:code "close-window") " is a generic frame-only operation that synchronously calls " (:code "wxWindow::Close(force)") ". It preserves the native acceptance boolean; it does not promise destruction. A contextual callback begins unskipped and may consume the request without deleting anything. An accepted request can therefore return T while the frame remains alive. Delegate with Skip true when native default frame closing should run. Use " (:code "destroy-window") " to request explicit destruction.") (:p "A vetoing contextual handler should consume the close event (leave Skip false), so native default closing is not run. Veto and Skip are independent: setting veto is not a substitute for controlling which later native handlers execute. Veto also cannot undo an independent " (:code "destroy-window") " request.") (:p (:code ":force t") " sets native " (:code "CanVeto") " false. Both true and NIL veto assignments then signal " (:code "native-error") " while CanVeto stays false. A handler can explicitly change CanVeto through SETF, affecting native closing results. Force does not bypass a contextual handler's consumption or guarantee deletion. A handler should check capability and choose the appropriate native default/explicit closing action.") (:p "Observer bindings still automatically Skip. " (:b "A callback error does not itself veto") " an observer-delivered close: native default handling may continue before the condition is re-signaled. Use contextual policy and explicit veto when rejection is required. Callback errors from " (:code "close-window") " have a nearer Lisp boundary, like notifying writers; handling a nested close error does not stop an enclosing RUN. Errors escaping an actual native UI callback use the existing callback error/loop-stop rules.") (:heading 2 "Synthetic close events") (:code-block "lisp" "(wxlambda:queue-event receiver :close :id 42)                 ; vetoable
(wxlambda:queue-event receiver :close :id 42 :can-veto-p nil) ; not vetoable") (:p "The queue makes an owned copy of a " (:code "wxCloseEvent") ", rather than incorrectly treating it as " (:code "wxCommandEvent") ". " (:code ":can-veto-p") " defaults T and is accepted only for " (:code ":close") "; it sets initial capability, not an existing context's native flag. Close events reject non-default text/checked/selection payloads. They do not normally propagate to parents as command events do, although base event context Skip/propagation operations remain available.") (:p "A synthetic close queued to a frame " (:b "may invoke its native default closing action") ". A standalone handler has no frame default. Queuing provides no synchronous acceptance result and is not a substitute for " (:code "close-window") " when that result is needed. Session/main-thread, ID filter, weak lifetime, safe unbinding and deferred callback-disposal rules remain as documented in " (:ref "guide/docs/EVENT-BINDINGS.md" "bindings") " and " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") ".") (:heading 2 "Scope still missing") (:p "This guide covers " (:code "wxEVT_CLOSE_WINDOW") "; " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " add query/end-session tags and logging-off state. Registered command/notify types are supported. Native control-specific notify subclasses, arbitrary native event classes/factories, persistent event ownership/cloning, origin/type mutation and arbitrary native userData adoption remain open. The frame-only close request is a bounded mapping of an inherited window operation; panel/dialog/other top-level receivers are not exposed here. Native virtual callbacks, pushed handler ownership, timer/idle and worker dispatch also remain C1 work. No claim of full wxCloseEvent, wxEvent or C1 coverage is made.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/close-events.lisp" "close-events example") " blocks frame closing until a checkbox permits it. Its callback releases the button's control-specific closure before delegating to default closing. The reusable " (:code "exercise") " runs real close requests through the button callback and checks veto, liveness and cleanup:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/close-events.lisp \\
  --eval '(wxlambda-close-events:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/close-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/close-events.lisp
python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover real close acceptance versus deletion, forced requests, immutable flags, synthetic events, wrong-family rejection, expired contexts and handled nested close errors while RUN continues. These APIs, this guide and example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted GUI and graphical Cadre checks remain separate from local shared-reader validation.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open."))))
(:entry "guide/docs/COMBO-BOXES.md" :names ("docs/COMBO-BOXES.md" "COMBO-BOXES") :kind :guide :kind-name "Guide" :summary "docs/COMBO-BOXES.md" :sections (("Guide" (:heading 1 "Editable combo boxes with fixed choices") (:p "ABI48 adds native-backed " (:code "combo-box") ", an editable single-line WINDOW subclass with fixed unsorted choices. Required " (:code ":parent") " is a window. " (:code ":items") " defaults to NIL and accepts a finite proper list of0..256 nonempty strings. Native wxString::CmpNoCase must distinguish every pair; duplicate/case-only choices reject to avoid known MSW ambiguities. This is native comparison, not Unicode normalization or full casefold identity. Choice/value strings reject NUL, CR and LF. Unicode single-line values are supported. Baseline wxWidgets3.2.12; build requirement wxUSE_COMBOBOX.") (:p (:code ":value") " defaults to empty text. Optional " (:code ":selection") " is NIL or a valid zero-based choice index. A non-NIL selection cannot accompany nonempty initial value; it initializes text to the selected item. Empty choice lists still accept arbitrary editor text. Native selection readback after arbitrary text is platform-dependent. There is no read-only, sorted, popup/style, owner-drawn or bitmap variant here.") (:code-block "lisp" "(let ((destination (make-instance 'wxlambda:combo-box :parent panel
                                  :items '(\"Inbox\" \"Archive\") :selection 0)))
  (setf (wxlambda:selection destination :notify t) 1)
  (setf (wxlambda:text destination :notify t) \"Custom λ\")
  (setf (wxlambda:selection destination) nil)) ; clear both selection and text") (:p (:code "make-combo-box") " is a thin generic factory with validated " (:code ":class") " and forwarded subclass initargs. Direct subclasses support slots/default initargs and native properties in AFTER hooks; invalid mixed native ancestry rejects and managed initialization failure cleans widgets/callback roots. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ".") (:heading 2 "Text, selection and fixed item properties") (:p "Generic " (:code "text") "/SETF reads/writes independent explicit-length UTF-8 strings. A text write clears the prior native list selection then calls silent ChangeValue; native backends may recognize matching text again. Read " (:code "selection") " if needed; text is not a promise that an item was chosen. Native typing/popup matching also varies by port. Single-line validation applies to programmatic writes; physical editing uses native platform behavior.") (:p "Generic " (:code "selection") " reads native committed GetSelection, returning index/NIL. It does not promise the currently highlighted open-popup item (notably MSW). SETF requires an existing index or NIL. An index write sets the item's text and selection under blockers; NIL clears selection and text. Both readers ignore their shared " (:code ":notify") " keyword. Writes return the supplied value and are silent by default. " (:code ":notify t") " on TEXT emits exactly one :text-change; on SELECTION emits exactly one :combo-selection, even unchanged or NIL. Selection notify does not also emit text notify. Callback errors re-signal original conditions after the native call without rolling committed state back.") (:p (:code "item-count") " returns the fixed count; " (:code "item-text") " copies native text at a checked index. There are no append/delete/clear/item-text writer methods for COMBO-BOX. Text selection/caret/editability/clipboard editing APIs remain TEXT-CONTROL-only; no ON-SELECTION/ON-TEXT-CHANGE convenience methods are added. Use generic bindings.") (:heading 2 "Events and native callback safety") (:p "Bind " (:code ":combo-selection") " for chosen-list updates and existing " (:code ":text-change") " for editor updates. Both are native command events carrying text. Combo selection also exposes copied/current " (:code "event-selection") "; unrelated TEXT snapshots have NIL selection metadata. Default observers Skip automatically; frame observers can receive propagation. Physical selection may emit COMBO then TEXT, with native order/count varying by backend. Exact-one guarantees apply only to explicit bridge setter notification, not to physical input.") (:p "Immutable snapshots survive source/session cleanup. Borrowed contexts require the innermost current callback and expire on return. Semantic EVENT-SELECTION SETF, owned/synthetic construction and detached clones reject for the new combo selection kind. Existing generic TEXT event construction/dispatch rules retain their scope; the new restriction is not a blanket ban on all combo-origin events. Raw current integer edits and combo-selection text edits are metadata, not calls to the combo setter. Source-bound native TEXT context text SETF rejects because text-entry payloads can be lazy; existing owned TEXT dispatch also retains its text-entry receiver restrictions.") (:p "Shared Input guards cover actual native COMBO and TEXT origins, composite child identities and parent propagation. Same-combo text/selection writes reject during callbacks/operations, source/ancestor destruction/close defer, and modal/clipboard/ RUN/pump/nested safe-idle entry reject. Silent updates of another combo are allowed. Creation/failure/base teardown suppress relevant callbacks. Matching uses tracked live identities without unchecked event-object casts/dereferences. Constructor and programmatic writes block incidental native callbacks before explicit notify. No native pointer adoption or full wxComboBox/wxTextEntry/item-container parity.") (:heading 2 "Example and verification") (:p (:ref "example/examples/combo-boxes.lisp" "examples/combo-boxes.lisp") " selects a destination preset or accepts a custom value. START is interactive. EXERCISE verifies silent selection, one combo notification, one text notification, UTF-8 and NIL clear.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/combo-boxes.lisp --eval '(wxlambda-combo-boxes:start)'
sbcl --noinform --non-interactive --load ci/setup.lisp --load tests/combo-boxes.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/combo-boxes.lisp") (:p "Tests cover construction/subclasses/rollback, fixed items and validation, text vs selection, snapshots/current contexts, callback error identity/committed state and stale handles. Native probes observe constructor silence and dispatch COMBO then TEXT directly outside setter guards, including parent propagation, protected source/ancestor/mutation/modal/clipboard/loop entry and silent cross-combo writes. Runtime evidence is macOS wxWidgets3.2.12; OSX/GTK/MSW/Qt paths were source-reviewed. Physical popup/typing/IME/key/accessibility input, hosted Linux/Windows/Qt GUI, arbitrary native allocation failures and graphical Cadre remain unverified. Automatic tests do not read/replace system clipboard contents. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/COMMAND-EVENT-PAYLOADS.md" :names ("docs/COMMAND-EVENT-PAYLOADS.md" "COMMAND-EVENT-PAYLOADS") :kind :guide :kind-name "Guide" :summary "docs/COMMAND-EVENT-PAYLOADS.md" :sections (("Guide" (:heading 1 "Command payload views and bounded origin detachment") (:p "ABI 31 adds EVENT-EXTRA-LONG and EVENT-SELECTION-P, extends EVENT-CHECKED-P and EVENT-SELECTION to generic saved/current/owned readers with live SETF writers, and adds clear-only SETF EVENT-ORIGIN-ID. The baseline is wxWidgets 3.2.12. Snapshots remain immutable; current-context access remains innermost-callback scoped and owned-event access remains valid only while the native resource lives.") (:heading 2 "Extra LONG and raw selection-action metadata") (:p "EVENT-EXTRA-LONG reads the copied/current wxCommandEvent GetExtraLong value for command/notify-derived events. SETF accepts signed native C LONG values and calls SetExtraLong; native bounds are platform dependent (normally 32 bits on Windows, 64 bits on 64-bit Unix). Malformed/out-of-range writes reject before narrowing. Close-family reads return zero and writes reject. This field is independent of the signed32 EVENT-INTEGER payload and of a selection item's index.") (:p "MAKE-EVENT/MAKE-INSTANCE accepts optional " (:code ":extra-long") " for command/notify construction only. Clones preserve the source native value rather than inherited payload defaults; clone factories reject explicit extra-long overrides just as they reject other explicit payload overrides. Keyword synthetic QUEUE-EVENT and PROCESS-EVENT do not add an :EXTRA-LONG option: construct or clone an owned event, set its value, and dispatch it when that field is needed.") (:p "EVENT-SELECTION-P copies/reads raw native IsSelection for any command/notify event: it is true when extra LONG is nonzero, and NIL when zero. Close-family reads are NIL. It has no SETF writer; change EXTRA-LONG when raw action metadata is intended. This is not an EVENT-KIND predicate, a test for :SELECTION or proof that a choice index is valid. A normal choice event can have extra LONG zero and therefore report NIL even though it has :SELECTION kind and a valid item index. For listbox-like native events the flag can describe selection versus deselection, but this batch does not bind listbox classes or reconstruct their item state.") (:heading 2 "Semantic checked and selection views") (:p "EVENT-CHECKED-P reports checked state for :TOGGLE and :MENU; other supported kinds read NIL. Snapshot/current/owned views share this restriction. SETF accepts a generalized boolean only for current/owned :TOGGLE/:MENU events, writes native SetInt as 0/1 and returns the supplied value. This is raw IsChecked metadata: no menu-item kind lookup or checkbox/menu-resource synchronization is implied.") (:p "EVENT-SELECTION retains its kind restriction too: only :SELECTION returns the native command selection integer, with -1 mapped to NIL; other kinds read NIL. SETF is allowed only on current/owned :SELECTION events and accepts NIL (stored as -1) or a nonnegative signed32 index. It validates no control item list and does not call a choice-control setter or synthesize another native notification.") (:p "Raw EVENT-INTEGER still accepts any signed32 value for command/notify events. Thus nonzero raw toggle values can read as checked, and raw selection mutation can make GetSelection return another negative number. The semantic selection reader preserves that native number; only -1 maps to NIL. Its SETF protocol is stricter than raw integer access and rejects other negative indices. Raw EVENT-SELECTION-P remains driven by EXTRA-LONG, not by this integer field. Earlier snapshots retain their pre-callback values after any live mutation. Later native or user handlers can react to changed metadata and change controls; there is no guarantee that the whole dispatch leaves UI state unchanged.") (:code-block "lisp" "(let ((event (wxlambda:make-event :kind :selection :selection 0 :extra-long 0)))
  (unwind-protect
       (progn
         (assert (= 0 (wxlambda:event-selection event)))
         (assert (not (wxlambda:event-selection-p event)))
         (setf (wxlambda:event-extra-long event) 1)
         (assert (wxlambda:event-selection-p event))
         (setf (wxlambda:event-selection event) nil))
    (wxlambda:destroy-event event)))") (:heading 2 "Clear-only native origin detachment") (:p "SETF EVENT-ORIGIN-ID accepts only NIL; non-NIL values signal TYPE-ERROR after the active-session check. It never accepts a bridge integer ID, wrapper or native pointer and never installs a new native origin. Owned events are already detached, so NIL is an idempotent native-validated no-op while the resource is live.") (:p "For a current context with an actual non-null native origin, clearing is allowed only for a registered command/notify tag whose actual native class matches its registered family. Built-in/nonregistered non-null origins reject before change. An actual null origin permits a no-op. EVENT-ORIGIN-ID reader NIL can also mean untracked, so reader NIL alone is not proof that this no-op condition holds. No origin object is dereferenced, retained or destroyed by dropping the event's pointer. This bounded policy avoids changing built-in semantics such as lazy wxEVT_TEXT origin-backed strings; registered custom strings retain their payload.") (:p "EVENT-SOURCE remains the callback's Lisp registration receiver. Earlier snapshot origin IDs remain unchanged; later callbacks can capture NIL after a successful clear. Clearing does not change native class, type, ID, payload, ownership or propagation policy. New copies dispatched from owned events still acquire their receiver as origin, independently of the owned source's detached state.") (:p "All live reads/writes require the active main-thread session. Expired/suspended contexts, destroyed/consumed owned events and unsupported field families reject. Snapshot writers have no methods. There is no pointer retention/pinning protocol, arbitrary SetEventObject, client/userData ownership or raw native adoption.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/command-event-payloads.lisp --eval '(wxlambda-command-event-payloads:start)'") (:p "Validation should distinguish the raw action flag from semantic kind/index, extra LONG bounds from signed32 payload bounds, detached no-op from guarded context clearing, and immutable snapshots from current native state. Safe APIs do not manufacture arbitrary native class mismatches or untracked origins; those prior coverage limitations remain. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre validation remain separate requirements.") (:p "Remaining C1 work includes retained arbitrary origins, full SetEventObject, client/userData ownership, broader command-derived native classes and their specific payload semantics, timer/idle and worker dispatch. Do not treat a native extra field or generic flag reader as completion of every derived event class.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") ", " (:ref "guide/docs/EVENT-ORIGINS.md" "origin/type access") ", " (:ref "guide/docs/EVENT-METADATA.md" "metadata") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/DATE-PICKER.md" :names ("docs/DATE-PICKER.md") :kind :guide :kind-name "Guide" :summary "docs/DATE-PICKER.md" :sections (("Guide" (:heading 1 "Required calendar dates in forms") (:p "ABI52 adds native-backed " (:code "date-picker") ", generic " (:code "make-date-picker") ", generic " (:code "calendar-date") "/SETF and read-only " (:code "event-date") ". Dates are copied proper lists " (:code "(year month day)") ", with years 1900..2100, months 1..12 and valid Gregorian days. 1900 and 2100 are not leap years; 2000 is. NIL, incomplete lists, invalid days, non-integers and years outside this range reject before native mutation.") (:code-block "lisp" "(defparameter picker
  (wxlambda:make-date-picker parent :date '(2028 2 29)))
(wxlambda:calendar-date picker) ; fresh (2028 2 29)
(setf (wxlambda:calendar-date picker) '(2030 12 31)) ; silent
(setf (wxlambda:calendar-date picker :notify t) '(2030 12 31))") (:p "The required " (:code ":parent") " is a WINDOW; " (:code ":date") " defaults to " (:code "(2000 1 1)") " rather than consulting today's clock. Native style is wxDP_DEFAULT|wxDP_SHOWCENTURY, with a fixed inclusive range from 1900-01-01 through 2100-12-31. Construction verifies native range and value readback before publication. The native editor, formatting, calendar popup/spin presentation and century display depend on the port/locale. There is no style selector, nullable date, free editor text, time picker, mutable range or standalone wxDateTime object exposed by this slice.") (:p (:code "date-picker") " inherits WINDOW. Direct MAKE-INSTANCE subclasses support slot initargs, " (:code ":default-initargs") ", native properties in AFTER hooks and managed rollback. " (:code "make-date-picker") " is a thin generic factory with validated " (:code ":class") " and forwarded initargs. Lisp subclassing does not add native C++ virtual hooks. Factory example:") (:code-block "lisp" "(defclass due-date (wxlambda:date-picker)
  ((record-id :initarg :record-id))
  (:default-initargs :date '(2028 2 29)))
(make-instance 'due-date :parent parent :record-id 42)") (:p "The adapter represents a local civil calendar date. It exposes no time-of-day, Unix timestamp, Common Lisp universal-time, UTC conversion or timezone object. Native wxDateTime construction must round-trip the requested local date; dates not representable in the process's native local calendar signal NATIVE-ERROR. This can matter for historical timezone changes that skipped an entire day. Changing the process timezone during a GUI session is outside supported scope. The native date getter must return a valid supported committed date or signals NATIVE-ERROR. It does not parse or validate intermediate editor text for the app. Input/output lists are independent copies; SETF returns the supplied list.") (:heading 2 "Date-change events and safe updates") (:p "Bind " (:code ":date-change") " via " (:code "bind-event") ". Default programmatic writes are silent; " (:code ":notify t") " emits exactly one native wxDateEvent after native value readback, even when the date is unchanged. Physical keyboard/calendar interaction has native event timing/count/order; it is not constrained to that explicit-notify contract. Date-change is a command family event and cannot be vetoed.") (:code-block "lisp" "(wxlambda:bind-event picker :date-change
  (lambda (event)
    (format t \"Selected calendar date: ~S~%\" (wxlambda:event-date event))))") (:p (:code "event-date") " returns a fresh tuple from the captured event date. It freezes the payload date, not a live read of the control. It remains readable after the callback/window/session ends. For non-date snapshots or native date events with invalid/out-of-scope dates it returns NIL. A " (:code ":with-context t") " borrowed context reads the current native date payload and rejects access after expiry or from an outer context during a nested callback. Non-date contexts reject EVENT-DATE. There is no EVENT-DATE SETF, synthetic/owned date event or detached date clone. Raw command integer/text/selection metadata is not a date encoding and cannot change the date payload; snapshot EVENT-TEXT is NIL for date-change.") (:p "The shared Input guards cover actual date origins, propagated callbacks and composite-child TEXT events. Same-picker writes, source/ancestor destroy/close and nested GUI/RUN/pumps, modal/clipboard entry and safe-idle delivery reject during these callbacks. Silent cross-picker synchronization is supported. Native creation and early generic composite Destroy/base teardown suppress input callbacks. A refused native Destroy restores the guard state. Callback conditions re-signal after the native setter returns without rolling back committed dates.") (:p "Use owner-bound deferred actions for navigation, disposal or structural work from callbacks; see " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") ". The example's Reset due date button uses this path. See " (:ref "example/examples/date-picker.lisp" "date-picker.lisp") " and " (:ref "guide/docs/CLOS-API.md" "CLOS API") ".") (:heading 2 "Build and verification scope") (:p "Link wxWidgets core/base/adv and require wxUSE_DATEPICKCTRL=1 plus wxUSE_DATETIME=1. CMake checks these requirements; the pinned installed headers export this control from adv even though the interface documentation labels it core. macOS packaging includes its transitive library dependencies. The copied adapter is not full wxDateTime parity. See " (:ref "guide/docs/DOCSET.md" "Cadre docset installation") ".") (:p "Deterministic example/tests cover date bounds/leap years, copied values, native range readback, constructor rollback, silence/explicit notify, native-origin and propagated guards and teardown. Physical date editing/calendar/spin input, locale formatting, accessibility, historical timezone combinations, hosted Windows/Linux/ Qt and graphical Cadre remain separate interactive verification. Generic teardown is probed through an injected early Destroy phase on macOS; hosted generic GUI behavior is not claimed. Tests do not read or overwrite system clipboard content.") (:p "Native references: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/datectrl.h" "date picker") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/dateevt.h" "date events") ".") (:p "For a separate time-of-day field, see " (:ref "guide/docs/TIME-PICKER.md" "time pickers") ". Date/time composition into an instant remains application policy."))))
(:entry "guide/docs/DEFERRED-UI-ACTIONS.md" :names ("docs/DEFERRED-UI-ACTIONS.md" "DEFERRED-UI-ACTIONS") :kind :guide :kind-name "Guide" :summary "docs/DEFERRED-UI-ACTIONS.md" :sections (("Guide" (:heading 1 "Deferred UI actions") (:p "ABI43 adds a session-owned FIFO queue for main-thread UI work after native callbacks. Use it when a menu, toolbar, accelerator or navigation callback needs to open a modal dialog, transfer clipboard text or destroy/restructure windows. Existing direct callback guards remain in force.") (:code-block "lisp" "(wxlambda:bind-event frame :menu
  (lambda (snapshot context)
    (declare (ignore snapshot context))
    (wxlambda:defer-ui-action
      (lambda ()
        (let ((dialog (wxlambda:make-file-dialog :parent frame)))
          (unwind-protect
               (when (eq :ok (wxlambda:show-modal dialog))
                 (setf (wxlambda:status-text status)
                       (wxlambda:file-dialog-path dialog)))
            (wxlambda:destroy-window dialog))))
      :owner frame))
  :id 32101 :with-context t)") (:p (:code "defer-ui-action") " takes a function of no arguments and optional " (:code ":owner") " window, and returns an immutable " (:code "ui-action") " ticket. Scheduling never calls the function inline. At most 1024 pending actions are supported. The function is strongly rooted by the session until delivery, cancellation, observed owner expiry or session cleanup; a local root retains an executing function across modal callbacks and garbage collection. " (:code "ui-action-p") " identifies tickets; no public constructor, token accessor, raw callback pointer or native resource adoption is exposed.") (:heading 2 "Delivery and cancellation") (:p "Actions retain FIFO order and merge with coalesced due " (:ref "guide/docs/UI-TIMERS.md" "UI timers") " by first due/enqueue sequence, at most one work item per safe native idle iteration, after wxApp::ProcessIdle and its callbacks return. A single " (:code "process-events") " call may perform several idle iterations and deliver several actions. " (:code "run") " and " (:code "process-events") " drive delivery. " (:code "process-pending-events") " deliberately does not run this queue; pending-event queries describe wx events, not queue length. Idle availability determines timing: there is no deadline/timer or background worker. Long action functions still occupy the GUI thread.") (:p "Native idle/bridge-entry depth gates prevent early delivery inside the originating callback or a still-running synchronous native operation, even if it processes idle recursively. Delivery waits while a modal/dialog/clipboard or navigation/ tool/accelerator operation is active, while another action runs, during shutdown or while a callback error is pending. A modal opened by one action cannot deliver following actions in its nested event loop. Use END-MODAL directly from an appropriate current dialog callback to finish an existing modal: deferred actions wait for modal exit and cannot dismiss that active dialog. Actions enqueued by an executing action join the tail and never run recursively. An idle wake requests work without busy requeueing blocked actions during modal loops.") (:p (:code "ui-action-pending-p") " is true only while the ticket is queued and its optional owner is live. It is false during execution and after completion/cancellation. " (:code "cancel-ui-action") " removes queued work and returns T once, NIL if no entry remains; it cannot interrupt active work. It can remove an expired owner entry before a query/prune has already removed it. A ticket retains its type after completion. Both operations require the active session and main thread.") (:p (:code ":owner") " is checked before delivery through a native weak reference; native window ownership and pending ancestor deletion count. It does not keep a widget alive or grant protection to an executing function. Expired owners suppress the function. Their Lisp roots are released when expiry is observed/pruned, at safe idle delivery or session cleanup, rather than synchronously in a native destructor. Without an owner, work belongs to the session and can outlive individual frames. Validate any other captured widget identities when needed. Capture immutable event snapshots/values, not borrowed contexts: old event contexts are expired in actions. Current UI values are read at delivery unless the closure captured earlier values.") (:heading 2 "Safe action phase") (:p "The action itself is outside native event callback guards. Modal/clipboard access, window destruction and previously quiescent structural operations are allowed from this safe phase even while the surrounding RUN/poll driver is active. This includes menus, frame bars, accelerator tables, notebook/splitter attachment, managed handler chains/stacks and deleting managed pending events. Normal type, ownership, initialization and native lifetime checks still apply. Newly nested event callbacks receive their usual guards; the exception belongs only to the outer action body. Clipboard and modal APIs retain their own context suspension.") (:p "Calling RUN, either event-pump API or session finish recursively from an action rejects. " (:code "stop") " may exit an active RUN; it does not cancel the session's remaining queue. Outside actions, structural operations retain their prior quiescent rule. Do not process GUI events during incomplete managed initialization; queue an owner-bound action and let the constructor return first.") (:p "Errors are contained at the native/Lisp boundary, pause later work and are re-signaled at the outer RUN/process-events boundary. The original error object is preserved. Remaining queued actions stay pending for a subsequent pump if the caller handles the error within the session; leaving WITH-APPLICATION cancels them. An action can handle errors from its own notifying operations normally. A nonlocal exit across the deferred callback boundary is converted to a contained error. Return values are ignored. Cancellation is queue removal, not interruption or rollback of an action's effects. Session finish clears pending native work before toolkit teardown and clears all Lisp closure roots on exit.") (:heading 2 "Example and verified scope") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/deferred-actions.lisp --eval '(wxlambda-deferred-actions:start)'") (:p "The example shares menu/tool/keyboard requests for file selection, copying text and confirmed close. File selection reports the path; it does not read/write file contents. Its automatic EXERCISE injects deterministic chooser/clipboard/confirmation functions, avoiding interactive prompts and system clipboard changes. Separate tests exercise real generic message/file dialogs with automatic cancellation, modal non-reentrancy, structural operations under RUN/poll, owner expiry, FIFO, cancellation, errors/nonlocal exits and shutdown on both Lisps. Native tests force idle within callbacks/native operations/modal loops and transfer Unicode text through an isolated in-memory clipboard fixture. Live automatic clipboard checks are availability queries only; no system text is read/replaced.") (:p "Baseline: wxWidgets 3.2.12. Scheduling is bridge-specific; wxWakeUpIdle and the managed App::ProcessIdle override supply the native wake/safe point. ProcessIdle is present in installed native headers but omitted from the pinned interface inventory; that inventory remains factual rather than inventing a declaration. Physical input, OS clipboard interoperability, hosted Windows/Linux GUI, arbitrary allocation-race injection and graphical Cadre remain unverified. This is not a worker/thread scheduler, timer, promise/future API, transaction or shutdown hook. See " (:ref "guide/docs/KEYBOARD-ACCELERATORS.md" "keyboard actions") ", " (:ref "guide/docs/CLIPBOARD.md" "clipboard") ", " (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "dialogs") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes these APIs with deferred shared Open/Save/Copy/Paste/close requests, toolbar/keyboard entry points and status feedback. Its coalescing and scoped close-replay policy are application logic; no extra public binding or native parity claim is introduced.") (:p "ABI44 " (:ref "guide/docs/UI-TIMERS.md" "UI timers") " share this safe function phase. Their due work is separate from action capacity, coalesces missed expirations and honors the same modal/error/owner/session gates. Timer errors retire the offending registration."))))
(:entry "guide/docs/DOCSET.md" :names ("docs/DOCSET.md" "DOCSET") :kind :guide :kind-name "Guide" :summary "docs/DOCSET.md" :sections (("Guide" (:heading 1 "Cadre docset") (:p "The primary documentation artifact is " (:code "docs/docset/") ". It contains the public wxlambda API reference, guides and explained example sources together, in the " (:code "docset") " library's format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). The generated files are committed so readers can use them without building the bridge or opening a GUI.") (:heading 2 "Build and check") (:p "Requirements: Python 3, SBCL and the shared " (:link "https://github.com/crazymevt/docset" "docset library") ". The baseline used here is commit " (:code "481f57e7222925c3157e41a7e3deaeb628ecc9a7") " (format version 1). Check it out beside wxlambda as " (:code "../docset") ", or set " (:code "WXLAMBDA_DOCSET_SOURCE") " to its directory. The library has no runtime dependencies; it is a documentation tool dependency, not a wxlambda runtime dependency.") (:code-block "sh" "python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper when running these in an agent session. " (:code "--library /path/to/docset") " overrides the library location and " (:code "--lisp") " selects the SBCL executable. Builds do not load the native bridge or start a GUI.") (:p "The build requires one authored reference record per public export, derives function, macro and generic-function lambda lists from the implementation (including method defaults while omitting specializers), converts README, the implementation roadmap and " (:code "docs/*.md") " guides and the generated " (:code "docs/coverage/README.md") " coverage summary into docset blocks, and embeds every " (:code "examples/*.lisp") " source with usage notes. Agent instruction files (" (:code "AGENTS.md") " and " (:code "CLAUDE.md") ") are excluded from the guide list. Bundled guides and examples must not contain machine-specific paths. Update " (:code "docs/api-reference.json") " and " (:code "docs/example-reference.json") " with implementation changes. API entries must state arguments, returns, behavior, errors/scope and the related wxWidgets APIs. Class pages include Construction sections; mutable-property pages include SETF sections and searchable compound function names such as " (:code "(setf frame-title)") ". Bordered Markdown pipe tables with a separator row become format-v1 " (:code ":table") " blocks, retaining headers, rows and inline code/links. Escaped pipes and pipes inside inline code stay within their cell; inconsistent column counts are rejected. The generated coverage summary exercises this conversion for phase totals and all 398 header rows, so the backlog stays readable in Cadre. Guide/example filename stems that coincide with public symbols are omitted as aliases, so symbol lookup stays unambiguous. Their source paths remain indexed. Build/check requires exactly one matching API record for each symbol and SETF name.") (:p "Both commands run " (:code "docset:check-docset") " and require zero problems, then exercise the same discovery, symbol lookup and indexed entry reader used by Cadre. Every API entry and guide/example entry is read back and compared with source content; " (:code "check") " also rejects stale generated content. Cadre's graphical viewer is a separate manual integration check; shared-reader success alone is not a claim that the viewer was manually tested.") (:heading 2 "Install for Cadre") (:code-block "sh" "python3 tools/docset.py install") (:p "This verifies the build, copies the three files into " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "), and verifies discovery and reading there. Use " (:code "--destination /path/to/wxlambda") " for an isolated installation. Only the three generated files are overwritten. The install command does not alter Cadre's source or its bundled Common Lisp docs.") (:p "Open Cadre after installation, or restart it if it already cached its docsets. In Lisp source, use Look Up in Docs/HyperSpec on " (:code "wxlambda:make-frame") " to open its API entry. Search for " (:code "README") " or an example filename such as " (:code "hello.lisp") " to open guides and example source. Use the docset table of contents for the API reference, Guides and Examples groups.") (:heading 2 "Maintaining the artifact") (:p "Run examples affected by a change, build the docset, and run " (:code "check") ". Commit all three generated files alongside source/reference changes. The generator uses only the tracked reference, guides and examples. It adds no build timestamps or machine-specific output paths; source text is preserved. A repeated build from identical sources produces identical bytes. The checker verifies internal references and index positions; external guide links still require ordinary documentation review. Links between bundled guides and examples become docset references. Links to repository files that are not bundled are shown as source paths, without broken relative hyperlinks."))))
(:entry "guide/docs/DOCUMENT-FORM.md" :names ("docs/DOCUMENT-FORM.md" "DOCUMENT-FORM") :kind :guide :kind-name "Guide" :summary "docs/DOCUMENT-FORM.md" :sections (("Guide" (:heading 1 "Persistent form workflow") (:p (:code "examples/document-form.lisp") " composes controls, frame menus, a toolbar/status bar, keyboard accelerators and owner-bound deferred UI actions into a persistent form. It uses existing ABI43 APIs, adding no public bindings or native document framework. Document models, validation and UTF-8 file IO belong to the Lisp application. This is a small whole-field form workflow, not a multiline text editor.") (:heading 2 "Run and shared actions") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/document-form.lisp --eval '(wxlambda-document-form:start)'") (:p "Edit the name, greeting checkbox and style choice. File offers Open, Save, Save As and Close; Edit offers Copy name/Paste name. The toolbar provides the same six actions, with help text; an application-owned status bar reports results. Menus, tools and the frame accelerator table share portable IDs12101..12106:") (:table :header (("Action") ("Shortcut")) :rows ((("Open") ("Ctrl/Command+O")) (("Save") ("Ctrl/Command+S")) (("Save As") ("Ctrl/Command+Shift+S")) (("Close") ("Ctrl/Command+W")) (("Copy whole name") ("Ctrl/Command+Shift+C")) (("Paste whole name") ("Ctrl/Command+Shift+V")))) (:p "Logical Control means Command on macOS. Ordinary Ctrl/Command+C/V retain the focused control's native selection-editing behavior; the form shortcuts deliberately add Shift for whole-name operations. Explicit frame shortcuts do not add native menu-label accelerators. Physical input, focus and system shortcut conflicts need platform verification. The toolbar uses the library's safe in-window macOS backend; native Cocoa toolbar chrome remains excluded.") (:p "Each UI command queues an owner-bound action and consumes its command event. Toolbar events consume before frame propagation, preventing duplicate requests. The first request wins while any command is pending or executing: subsequent requests, even different commands, are ignored rather than queued for later. This includes a close request while Open/Save is pending; request close again after the current operation finishes. Menus/tools disable during execution and re-enable on cancellation/failure if the frame survives. They remain enabled while awaiting delivery because same-toolbar callback state writes are guarded. The queue latch coalesces requests during that interval.") (:p "RUN/full GUI polling delivers work after native callback/operation stacks return; pending-only event processing does not. Values, clipboard contents and dirty state are read during execution, not captured at click time. Edits before delivery therefore affect the requested save/close/paste. Nested modal commands are ignored. Disposal cancels pending work; the weak owner also suppresses work after frame or ancestor destruction. A canceled ticket cannot leave the request latch stuck. The form's internal synchronous execution helpers are test/implementation seams; all GUI entry points use the deferred request path.") (:heading 2 "Persistence, clipboard and close policy") (:p "The title's star compares current values with the saved/loaded baseline; reverting all edits clears it. Save reuses the current path. Save As asks for a destination and uses the generic chooser's overwrite prompt. Regular Save replaces its current destination without another prompt. Chooser paths use " (:code "uiop:parse-native-namestring") ", preserving native filename characters rather than Lisp pathname escapes.") (:p "When Open or a vetoable Close would discard changes, Yes saves first, No discards, and Cancel keeps the form. Canceling the save chooser or failing to save blocks the destructive operation. Canceling the open chooser leaves current data intact; if Yes already saved, that save remains completed. A complete successful read precedes replacement of values/path/baseline. Read/parse/write errors report through a generic error dialog and preserve the document state. Reporter errors also clear busy/active state and restore surviving command views before propagating outward.") (:p "A native vetoable close is immediately vetoed, without opening a dialog inside its borrowed callback. Its deferred action asks/save-checks, then retries close with a scoped, one-use approval. The close handler consumes that approval and allows native default handling; unwind cleanup removes any unused approval. A preceding observed veto from another handler is consumed and preserved. A blocked retry cannot authorize a future close without a new decision. Arbitrary handler ordering/default policies remain the library's existing contract; close acceptance is not a destruction guarantee.") (:p "Consequently, the initial " (:code "close-window") " call returns NIL even for a clean form that may close after delivery. Tests/polling callers inspect the eventual frame liveness and file result after processing events. Forced/non-vetoable close follows native default policy without prompting and cancels pending form work; it can lose unsaved changes. Native modal-parent protections still apply. Session shutdown is not autosave, and the example does not override OS shutdown policy.") (:p "Copy name copies the whole field and attempts best-effort persistence. Paste reads text at delivery, accepts empty text, rejects multiline input before changing the form, and updates dirty state. No available text leaves the name unchanged. Copy replaces all clipboard formats; there is no whole-field Cut or implicit selection editing. See " (:ref "guide/docs/CLIPBOARD.md" "text clipboard") " and " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred action boundaries") ".") (:heading 2 "File format and write scope") (:p "The UTF-8 " (:code ".wxform") " format contains exactly four lines:") (:code-block "text" "WXLAMBDA-FORM-1
Ada
yes
friendly") (:p "The third line must be " (:code "yes") " or " (:code "no") "; the fourth must be " (:code "friendly") " or " (:code "formal") ". The name may be empty but must fit on one line. Trailing extra lines are rejected. The reader does not call the Lisp reader or evaluate file contents. It is intended for small local form documents, without file-size limits or streaming large-document support.") (:p "Writes create a unique temporary sibling, write and close it completely, then use " (:code "uiop:rename-file-overwriting-target") ". Failed replacement attempts clean up their temporary sibling; earlier document state is retained. This reduces exposure to partial content writes but promises neither crash durability nor atomic replacement on every platform. Replacement can change permissions/metadata and replace a symlink itself. Concurrent external edits are not detected; Save can overwrite them. There is no locking, backup, undo, recovery or transactional filesystem API. Use it for ordinary user-selected local documents rather than privileged files.") (:heading 2 "Automated exercise and checks") (:p "The bounded example exercise requests toolbar Save, verifies deferral and pumps a scripted canceled chooser without touching files or system clipboard text:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/document-form.lisp --eval '(wxlambda:with-application () (wxlambda-document-form:exercise))'") (:p (:code "tests/document-form.lisp") " retains isolated UTF-8 round trips, literal filenames, failed/malformed/missing files, staged replacement cleanup, save-before-open, dirty-state reversion, and canceled/failed-save/discard/successful-save close outcomes. It now pumps deferred close decisions; real default save, unsaved-close and error dialogs are automatically canceled from native idle. No old borrowed close context is retained across those prompts.") (:p (:code "tests/document-form-actions.lisp") " verifies menu/tool/configured shortcut-command routing, exactly one pending request, different-command coalescing, delivery-time values/clipboard, canceled request recovery, disabled views/active-command rejection, file-state preservation, reporter-error cleanup, preceding close veto/approval reset, force/disposal cancellation, and delivery under blocking RUN. Its clipboard functions are isolated fixtures; system text is never read/replaced. The shortcut checks validate the table and action command path, not physical typing; native key translation is tested separately by the library's accelerator probes.") (:p "The complete runner includes both scenarios and the original clipboard protocol scenario. No public exports, native ABI or native inventory statuses change. Existing unbound " (:code "wxDocument") "/" (:code "wxDocManager") ", native streams, OS alerts/panels and deep editor APIs remain pending/deferred. Physical menu/tool/keyboard/chooser input, OS clipboard interoperability, hosted Windows/Linux GUI, graphical Cadre, crash-durability and arbitrary IO-race injection remain unverified. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage policy") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/DRAWING-CANVAS.md" :names ("docs/DRAWING-CANVAS.md") :kind :guide :kind-name "Guide" :summary "docs/DRAWING-CANVAS.md" :sections (("Guide" (:heading 1 "Retained drawing canvas and monitoring workflow") (:p "ABI55 adds native-backed " (:code "drawing-canvas") ", " (:code "make-drawing-canvas") ", " (:code "canvas-content") "/SETF, " (:code "canvas-client-size") " and " (:code "save-canvas-image") ". This is a bounded retained renderer for practical drawings and monitoring tools. Lisp supplies copied scene data; native paint/resize handling owns the DC and renders without calling Lisp. It does not expose paint callbacks, DC/bitmap/font handles, native pointer adoption or C++ virtual methods to Lisp subclasses. Separately owned image/bitmap values and static displays are documented in " (:ref "guide/docs/IMAGES-DISPLAYS.md" "Images and displays") ".") (:code-block "lisp" "(defparameter view
  (wxlambda:make-drawing-canvas parent
    :content '(:background (245 248 252)
               :items ((:rect 20 20 120 40 (30 140 190))
                       (:line 20 80 200 80 (40 50 60) 2)
                       (:ellipse 180 20 32 32 (230 150 40))
                       (:text 20 100 \"Signal λ\" 16 (20 30 40))))))
(wxlambda:canvas-client-size view) ; fresh (width height) in DIP
(wxlambda:save-canvas-image view #p\"/private/tmp/drawing.png\" :width 320 :height 180)") (:p (:code "drawing-canvas") " is a WINDOW subtype backed by an internal wxPanel subclass. Required " (:code ":parent") " is a WINDOW. " (:code ":content") " defaults to white background and no items. Direct MAKE-INSTANCE subclasses support slots/default initargs, native-ready AFTER hooks and ordinary managed initialization rollback. The thin generic factory validates " (:code ":class") " and forwards initargs. Nest the canvas in a row/column with " (:code ":proportion 1 :expand t") ". Lisp ancestry is WINDOW, not PANEL.") (:heading 2 "Scene format and bounds") (:p "Content is a proper four-element plist containing exactly " (:code ":background") " and " (:code ":items") " (either key order accepted). RGB colours are three integer bytes0..255; primitive colours are opaque. Items are drawn in supplied order with native clipping:") (:table :header (("Item") ("Data")) :rows ((((:code ":rect")) ((:code "(:rect x y width height rgb)") " filled rectangle with matching outline")) (((:code ":ellipse")) ((:code "(:ellipse x y width height rgb)") " filled ellipse with matching outline")) (((:code ":line")) ((:code "(:line x1 y1 x2 y2 rgb stroke-width)"))) (((:code ":text")) ((:code "(:text x y string point-size rgb)") " single-line Unicode text in native Swiss/sans family")) (((:code ":bitmap")) ((:code "(:bitmap x y width height pixels)") " opaque row-major RGB byte vector")) (((:code ":rgba-bitmap")) ((:code "(:rgba-bitmap x y width height pixels)") " straight row-major RGBA byte vector, native alpha composition")))) (:p "Coordinates/endpoints are signed integers within±10000. Rectangle/ellipse extents are1..10000. Stroke width is1..32. Font point size is6..72; exact font face, glyph coverage and metrics follow native fallback. Text rejects NUL/CR/LF. At most512 items,65536 total UTF-8 text bytes and2MiB total bitmap bytes are supported. Each bitmap dimension is1..256; PIXELS is a simple " (:code "(unsigned-byte 8)") " vector of exactly width*height*3 bytes for RGB or width*height*4 bytes for RGBA. RGBA values use straight alpha; native display conversion can premultiply and round colours. Screen bitmap extents use DIP, while export extents use pixels. Scene bitmaps remain copied scene data; the separate IMAGE/BITMAP resource API does not transfer pointers into this transport. All data crosses the ABI by value/copy, never pointer adoption.") (:p "Native scene compilation stages all items/strings/bitmaps before replacing the old scene; invalid inputs preserve the old model. The Lisp writer returns its supplied object. The stored normalized model, getter results, strings, colour lists and pixel vectors are independent copies, so later input/output mutation does not edit the scene. The getter validates native lifetime and reports the last native paint failure before returning the copied model. A successful native paint or new content clears that failure. Native callback conditions, if any, are signaled after the committed Lisp/native model is synchronized.") (:p "Scene coordinates/extents/strokes are DIP on screen, converted through native FromDIP. " (:code "canvas-client-size") " reports native client dimensions through ToDIP; integer conversions can round by a pixel. Native resize invalidates/repaints the retained scene. It does not automatically rewrite the model. The monitor example reads client size on each timer tick and rebuilds its bounded geometry. The monitor geometry is clamped to 320..1200 by 180..700 scene units; smaller viewports clip that drawing, and larger viewports can leave unused space. Native window/font/content-scale behavior and antialiasing remain port-specific; this is not a claim of pixel-identical multi-monitor rendering or globally bounded inherited window geometry. There is no exposed resize/DPI event or zoom API.") (:heading 2 "Main-thread and callback rules") (:p "Construction and all operations require the active GUI thread/session and valid native lifetime. Content writes and PNG export reject Lisp event callbacks; use an owner-bound deferred action or safe-idle UI timer body. Native staging, refresh, rendering and export hold Input operation guards against source/ancestor destroy/close, same-canvas recursion and nested GUI/modal/clipboard entry. Native painting exceptions are contained and reported by subsequent canvas reads; bitmap/image/font validity is checked before use. Native diagnostic logging is suppressed inside these private operations so a failed export does not create an unmanaged GUI error dialog.") (:code-block "lisp" "(wxlambda:defer-ui-action
  (lambda () (setf (wxlambda:canvas-content view) next-scene)) :owner view)") (:p "The renderer has no Lisp paint callback, so arbitrary callback code cannot retain borrowed DC objects. Parent destruction disposes native scene bitmaps along with the window. Getter/writer/export operations on stale wrappers reject normally. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") " and " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") ".") (:heading 2 "PNG export") (:p (:code "save-canvas-image") " takes a string/pathname and optional WIDTH/HEIGHT, default 640x480, each1..2048. It renders the same scene into a private 24-bit bitmap and encodes PNG using an internal handler. Export dimensions and scene coordinates are output pixels (one pixel per scene unit); clipping occurs at that viewport. It does not scale the model to fit. Fonts retain native point-size metrics. The encoder does not alter the global image-handler registry.") (:p "The supplied file is overwritten. Encoding finishes in memory before file open, but file replacement is not atomic: write/flush/close failure can leave partial output and does not restore previous contents. Errors signal NATIVE-ERROR. Native path conversion is explicit UTF-8 with NUL rejection. Write, flush and close status are checked, and the FILE is detached before checked close to avoid pinned wxFFile retrying a consumed handle on a close error. There is no general image/document/printing API or promise of arbitrary filesystem fault recovery.") (:heading 2 "Demonstrated monitoring workflow") (:p (:ref "example/examples/drawing-monitor.lisp" "Drawing monitor") " combines native canvas, Unicode text/font/colour/geometry, a copied RGB badge, an activity indicator, owner-bound periodic UI updates and deferred Pause/Resume. Its data is explicitly simulated; it does not run a background worker. EXERCISE self-stops after three real timer ticks, verifies animation state, exports PNG and resumes before cleanup. A separate native test decodes PNG and checks geometry/bitmap pixels, failed-scene preservation, native resize/DIP roundtrip (one-pixel tolerance), synchronous operation reentry, and owner teardown.") (:p "CMake requires IMAGE/LIBPNG/GRAPHICS_CONTEXT/ACTIVITYINDICATOR/STREAMS/FFILE plus existing TIMER support; native components are core/base/adv. The rendering implementation is modular but remains in the same checked bridge ABI. Source inventory records these as bounded private value/retained-rendering adapters, not standalone wxDC/image/font/colour class parity.") (:p "Physical window-paint fidelity, all font glyphs/locale/DPI combinations, hosted Windows/Linux/Qt, accessibility and graphical Cadre remain unverified. Native PNG rendering and local automated GUI tests are the declared acceptance target. See " (:ref "guide/docs/MVP-ACCEPTANCE.md" "MVP acceptance") ", " (:ref "guide/docs/DOCSET.md" "Cadre installation") " and " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/dc.h" "native drawing reference") "."))))
(:entry "guide/docs/EVENT-BINDINGS.md" :names ("docs/EVENT-BINDINGS.md" "EVENT-BINDINGS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-BINDINGS.md" :sections (("Guide" (:heading 1 "Command-event bindings") (:p "This C1 slice adds independent observer bindings on standalone " (:code "event-handler") " objects and borrowed window identities. It covers " (:code ":click") " (" (:code "wxEVT_BUTTON") "), " (:code ":text-change") " (" (:code "wxEVT_TEXT") "), " (:code ":toggle") " (" (:code "wxEVT_CHECKBOX") ") and " (:code ":selection") " (" (:code "wxEVT_CHOICE") "), using the wxWidgets 3.2.12 baseline. The bridge is ABI 31. Optional " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") " now support Skip/propagation; close-veto support is now available through the " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") ". Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify/command types") " now add named native tags and synchronous dispatch; native control-specific notify subclasses/session routing remain open.") (:heading 2 "Register and remove independent observers") (:code-block "lisp" "(defvar receiver (wxlambda:make-event-handler))
(defvar subscription
  (wxlambda:bind-event receiver :click
    (lambda (event)
      (format t \"Receiver ~S; command ID ~D~%\"
              (wxlambda:event-source event) (wxlambda:event-id event)))
    :id 40 :last-id 49))
(wxlambda:binding-active-p subscription) ; T
(wxlambda:queue-event receiver :click :id 42)
(wxlambda:process-pending-events)
(wxlambda:unbind-event subscription)     ; T
(wxlambda:unbind-event subscription)     ; NIL") (:p "Use these forms inside an active main-thread " (:code "with-application") " session. Every call to " (:code "bind-event") " returns a distinct opaque, read-only " (:code "event-binding") " value; " (:code "event-binding-p") " tests its type without consulting native state. There is no public constructor or callback-function slot on that value. Keep it to remove or query exactly that registration. Bindings may share a receiver, kind, ID filter and callback function; none replaces another binding.") (:p "An omitted/NIL " (:code ":id") " matches any command ID. A supplied ID matches exactly unless " (:code ":last-id") " specifies an inclusive range. IDs must fit signed 32-bit integers; " (:code "-1") " is reserved for native " (:code "wxID_ANY") ", represented by NIL in binding filters. " (:code ":last-id") " requires " (:code ":id") " and must be at least as large. Invalid registration releases its temporary Lisp roots. Native unbinding uses the exact receiver, event tag, ID range and native binding identity.") (:p (:code "unbind-event") " is safe from inside the binding's own callback or a peer callback. It returns T for an active removed registration, NIL after removal/receiver expiration. The current callback can finish, but removed callbacks cannot receive later deliveries. The native callback object stays alive until its current call returns. Relative callback order follows wxWidgets; no Lisp ordering guarantee is provided, including for bindings added during dispatch.") (:heading 2 "Observer and source semantics") (:p "Each observer callback takes one immutable " (:code "event") " snapshot. With " (:code ":with-context t") ", a generic callback instead receives " (:code "(snapshot context)") " and starts unskipped; it must explicitly set Skip to continue routing. Generic bindings and the control-specific " (:code "on-click") ", " (:code "on-text-change") ", " (:code "on-toggle") " and " (:code "on-selection") " callbacks are observers by default: their native hooks call " (:code "Skip") " after delivery, including when no control-specific callback is installed. Remaining matching native handlers and normal command-parent routing can therefore continue. The control-specific APIs still provide one replacement slot per control; generic registrations coexist independently and are removed with " (:code "unbind-event") ".") (:p "The default observer policy is unchanged. Contextual bindings can now consume commands and control Skip/propagation levels through borrowed, callback-scoped access. Veto is supported for current veto-capable close contexts and registered notify contexts. Native notify subclasses/session routing and native virtual overrides remain missing; do not infer full wxEvent coverage from these command APIs. " (:code "handler-enabled-p") " still controls only the receiving handler's own processing.") (:p (:code "event-source") " is the " (:b "Lisp receiver on which that callback was registered") ". For a parent binding that observes a child's command, it is the parent, not necessarily the native originating child. EVENT-ORIGIN-ID now reports a known bridge origin identity; arbitrary native origin-object wrapping remains unbound. " (:code "event-id") " copies the native command ID; it is not a globally unique event or native handle. Existing control-specific snapshots likewise carry their registered control as source. Snapshots and copied strings survive callbacks, unbinding and native receiver destruction, without requiring a session to read.") (:heading 2 "Queue copied synthetic events") (:code-block "lisp" "(wxlambda:queue-event receiver :text-change :id 42 :text \"Copied Unicode λ\")
(wxlambda:queue-event receiver :toggle :checked-p t)
(wxlambda:queue-event receiver :selection :selection 3)") (:p (:code "queue-event") " returns the supplied handler and queues a fresh " (:code "wxCommandEvent") " using " (:code "wxEvtHandler::QueueEvent") ". It works on exposed standalone handlers and windows, on the main thread only. " (:code ":id") " defaults to 0. " (:code ":text") " defaults to an empty string and applies only to text-change events; explicit UTF-8 byte counts preserve Unicode, empty strings and embedded NULs. Non-default payloads for the wrong kind are rejected. " (:code ":checked-p") " is a generalized boolean for toggles; " (:code ":selection") " is NIL (no selection) or a nonnegative signed-32-bit index.") (:p "Queuing only supplies event data: it does not change a text control's contents, checkbox state or choice selection. Use generic SETF properties to change those values and optionally notify. Synthetic selections are payload indices, not validated against a choice's items. Native origin override, arbitrary custom event classes, arbitrary native userData adoption and worker-to-GUI dispatch are not implemented. Synthetic " (:code ":close") " events use a separate native event class and may run default frame closing; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close events") ".") (:heading 2 "Lifetime, errors and cleanup") (:p "Native weak references invalidate bindings when receivers disappear. Lisp roots for generic callbacks are reaped when RUN, a pump or a notifying setter returns, after explicit destruction, or when " (:code "binding-active-p") " is called. A closed window during a still-blocking RUN may retain roots until one of these boundaries or explicit unbinding. Session cleanup releases remaining bindings. This does not alter the control-specific callback-root rule: explicitly unbind those callbacks before destruction or they remain rooted until session cleanup.") (:p "Disposal requested during a native-to-Lisp callback marks the target identity invalid immediately and defers actual deletion through application " (:code "CallAfter") ". This lets native event and notifying-setter stacks return before their receiver is deleted. Descendants follow their actual parent/window destruction lifetime. Already queued events for a pending-disposal target cannot invoke its bindings. If the application exits before deferred deletion runs, session cleanup owns remaining native resources. Outside callbacks, owned-handler destruction remains immediate and windows retain their existing native destruction behavior.") (:p "Inactive sessions signal " (:code "native-error") " for registration, queuing, unbinding and liveness queries, including before native-library loading. Stale/deleting receivers reject operations; unbinding an expired registration returns NIL during the active session. Unsupported Lisp receiver types signal CLOS dispatch errors. Callback errors are contained at the native boundary and re-signaled after the native call returns; event-pump reentrancy is still rejected. Initializer rollback removes new generic registrations and callback roots across nested resources.") (:heading 2 "Runnable example and verification") (:p "The " (:ref "example/examples/event-bindings.lisp" "event-bindings example") " installs two observers on a standalone handler. A button queues an ID-42 notification; its reusable " (:code "exercise") " verifies that removing one subscription leaves the other:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-bindings.lisp \\
  --eval '(wxlambda-event-bindings:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-bindings.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-bindings.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover ID filters, duplicate registrations, all four payload kinds, text copying, self/peer unbinding, error recovery, disabled handlers, initializer rollback, parent/child observer routing and disposal during queued and synchronous setter callbacks. The API, guide and example are indexed in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Graphical Cadre and hosted-platform GUI verification remain separate checks.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/BINDING-USER-DATA.md" "Per-binding Lisp user data") " now provides BIND-EVENT :USER-DATA and read-only snapshot/context association access, distinct from handler client data and native command/client/item pointers. Borrowed native userdata still prevents owned cloning; no mutable association API is added."))))
(:entry "guide/docs/EVENT-CATEGORIES.md" :names ("docs/EVENT-CATEGORIES.md" "EVENT-CATEGORIES") :kind :guide :kind-name "Guide" :summary "docs/EVENT-CATEGORIES.md" :sections (("Guide" (:heading 1 "Event-category metadata") (:p "ABI 31 adds EVENT-CATEGORY for saved immutable snapshots and current innermost contexts, plus EVENT-CATEGORY-MASK for compiled native category values. The coverage baseline is wxWidgets 3.2.12. Categories are numeric flags, not native type IDs, EVENT-ID routing values or EVENT-FAMILY keywords.") (:p "EVENT-CATEGORY reads/copies virtual GetEventCategory. Current supported command and notify-derived events report USER_INPUT; close/query-end/end-session events report UI. This follows the native class override even for registered synthetic command/notify tags; a synthetic event is not proof of actual user input. All generic and control-specific snapshots capture native category at callback entry and remain readable after native receiver/session cleanup.") (:p "EVENT-CATEGORY-MASK accepts :UI, :USER-INPUT, :SOCKET, :TIMER, :THREAD or :ALL. It loads the bridge and reads compiled native constants without creating an application or requiring an active GUI session. Native library/ABI loading can fail normally. Unknown keywords signal a Lisp error before native lookup. The five public bits in the pinned baseline are 1,2,4,8,16; use the lookup rather than hardcoding them. Combine flags with LOGIOR and test membership with LOGTEST.") (:p ":ALL is the actual compiled wxEVT_CATEGORY_ALL mask, including any internal bits. It is not necessarily the OR of only the five public category values. The pinned interface documentation shows 31, but the local 3.2.12 implementation header also includes internal UNKNOWN/CLIPBOARD bits and reports 127. Those internal names are not public bindings here. Likewise, the documentation interface omits the wxCommandEvent GetEventCategory override present in the implementation header. These discrepancies are retained as evidence for C7 public-interface reconciliation; they do not authorize binding undocumented implementation APIs.") (:code-block "lisp" "(logtest (wxlambda:event-category-mask :user-input)
         (wxlambda:event-category event))") (:p "No SETF writer is supplied: category is native virtual behavior, not a mutable base event field. No native override/subclass callback is introduced. Context reads require an active main-thread session and the innermost callback; expired or suspended outer contexts signal NATIVE-ERROR. Saved snapshots need no native session. Mask lookup is session-independent and does not pump events.") (:p "Run the isolated synthetic example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-categories.lisp --eval '(wxlambda-event-categories:start)'") (:p "Tests cover all eight built-in and registered command/notify kinds, each of the four convenience snapshot paths, saved values, nested/expired context isolation, invalid mask names and public-bit inclusion in the native ALL mask. No native socket/timer/thread events or real OS session events are generated. Category constants do not imply those event families are bound.") (:p "wxEventLoopBase::YieldFor and category-selective pumping remain unbound. Existing PROCESS-EVENTS/PROCESS-PENDING-EVENTS behavior is unchanged. Remaining C1 work includes typed tag mutation, origin retention, persistent event ownership/cloning, arbitrary native userData adoption, externally adopted handlers, timer/idle and worker dispatch. Next design bounded registered-tag mutation using actual native class checks, retaining the session fallback isolation and rejecting incompatible native tag changes.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-METADATA.md" "metadata") ", " (:ref "guide/docs/EVENT-ORIGINS.md" "origin/type readers") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded.") (:p (:ref "guide/docs/IDLE-EVENTS.md" "Idle events") " add family :IDLE, bounded RequestMore, global automatic policy and own-window opt-in metadata. Frame menus/actions now extend GUI breadth; standard dialogs are next, without requiring exhaustive foundation parity."))))
(:entry "guide/docs/EVENT-CONTEXTS.md" :names ("docs/EVENT-CONTEXTS.md" "EVENT-CONTEXTS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-CONTEXTS.md" :sections (("Guide" (:heading 1 "Scoped native event contexts") (:p "This C1 slice adds borrowed " (:code "event-context") " values for native Skip and propagation control. Existing " (:code "event") " snapshots remain immutable Lisp-owned data. The bridge is ABI 39, using the wxWidgets 3.2.12 inventory baseline. Supported events now include seven command kinds (including :MENU and listbox selection/activation), the " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") ", registered command/notify types, " (:ref "guide/docs/IDLE-EVENTS.md" "idle events") " and native " (:ref "guide/docs/NOTEBOOK.md" "notebook page events") " and " (:ref "guide/docs/TREE-NAVIGATION.md" "tree selection events") ". Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify types") " support scoped Veto/Allow. Arbitrary native classes and other native notify subclasses remain outside the bounded bridge; platform session routing still needs target-specific verification.") (:heading 2 "Opt into contextual callbacks") (:code-block "lisp" "(wxlambda:bind-event button :click
  (lambda (snapshot context)
    (format t \"Command ~D; native type ~D~%\"
            (wxlambda:event-id snapshot) (wxlambda:event-native-type snapshot))
    (setf (wxlambda:event-skipped-p context) t))
  :with-context t)") (:p "With " (:code ":with-context") " true, the callback takes two arguments: an immutable snapshot and a borrowed native-event context. " (:b "Contextual bindings begin unskipped") ": returning without setting Skip consumes the command at that handler. Callback return values do not determine routing. Set " (:code "(event-skipped-p context)") " true to continue to later native handlers and normal parent routing; set it false to consume. The generic writer returns the supplied generalized boolean, while the reader normalizes the native flag to T/NIL.") (:p "The default " (:code ":with-context nil") " remains an observer binding: its callback receives only a snapshot and the bridge automatically Skips afterwards. Control-specific " (:code "on-*") " callbacks also remain observers. Callback order is still governed by wxWidgets, with no Lisp ordering guarantee. A consuming contextual binding can prevent later observers from running, but cannot undo an earlier delivery. See " (:ref "guide/docs/EVENT-BINDINGS.md" "command binding and queue scope") ".") (:heading 2 "Propagation is separate from Skip") (:code-block "lisp" "(let ((previous-level (wxlambda:stop-event-propagation context)))
  (assert (not (wxlambda:event-propagates-p context)))
  ;; Restore the level when parent routing is wanted again.
  (wxlambda:resume-event-propagation context previous-level)
  (setf (wxlambda:event-skipped-p context) t))") (:p (:code "event-propagates-p") " maps to " (:code "wxEvent::ShouldPropagate") ": it tests whether the native propagation level is positive. " (:code "stop-event-propagation") " sets that level to zero and returns its previous value. " (:code "resume-event-propagation") " restores a nonnegative signed-32-bit level and returns the supplied context. Zero is allowed. Invalid levels signal a Lisp type error.") (:p "Neither operation changes Skip. Stop plus Skip true allows later handlers on the current receiver while preventing parent propagation. A positive propagation level alone does not forward a consumed event. This exposes native command propagation behavior, not a complete propagation/filter/handler-chain API.") (:heading 2 "Exact borrowed lifetime") (:p "Contexts have private immutable tokens, not native pointers. They have no public constructor and cannot be used to construct or clone native events. A native scope registry validates both the token and callback depth before every access. Only the " (:b "currently executing innermost native-to-Lisp callback") " can use its own context. A nested contextual callback suspends outer access. A nested observer or control-specific callback also suspends outer access, even though it receives no context of its own. After the nested callback returns, the outer context is usable again until its own callback returns.") (:p (:code "event-context-p") " only tests the Lisp value's type; it needs no session and remains true for an expired value. " (:code "event-context-active-p") " returns T for the currently usable context and NIL for suspended/expired contexts in an active session. Outside a session, the activity query signals " (:code "native-error") ". All native readers, writers and propagation actions reject suspended or expired contexts with " (:code "native-error") " rather than dereferencing an old event pointer.") (:p "The context expires on callback return, including after a callback condition. Errors are contained and re-signaled using the existing native boundary; native event mutations are not rolled back. Unbinding the current registration or requesting deferred receiver disposal does not expire its still-running context: the native event remains on the dispatch stack until return. Event-pump reentrancy continues to be rejected. All operations require the active main-thread session; worker-thread context access is not supported.") (:p "Keep the snapshot to inspect data after return. Do not keep a context expecting to mutate the event later. The snapshot's source remains the binding receiver, not necessarily the native originating child. General native origin-object wrapping and origin/type mutation, arbitrary native userData adoption, arbitrary event classes and native virtual overrides remain open. Veto is available for current vetoable close contexts and registered notify contexts; plain command kinds do not provide veto state. See " (:ref "guide/docs/CLOSE-EVENTS.md" "close semantics") ".") (:heading 2 "Native event type values") (:p (:code "event-native-type") " reads a copied native " (:code "wxEventType") " integer from any current supported snapshot, including observer/control-specific callbacks:") (:code-block "lisp" "(= (wxlambda:event-native-type snapshot)
   (wxlambda:event-type :click))") (:p "The lookup accepts " (:code ":click") ", " (:code ":text-change") ", " (:code ":toggle") ", " (:code ":selection") ", " (:code ":menu") ", " (:code ":close") ", " (:code ":query-end-session") ", " (:code ":end-session") " and " (:code ":idle") ", or a registered command/notify name, and requires an active main-thread session. Saved snapshot integers can be read without a session. These are process-local runtime IDs; do not serialize them as stable type identifiers or compare IDs from different processes. " (:code "event-kind") " retains the supported portable keywords. This is bounded native type-value introspection, not custom type registration or arbitrary numeric-type binding. The old " (:code "command-event-type") " name was removed when the non-command close family was added.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/event-contexts.lisp" "event-contexts example") " uses a checkbox to decide whether a contextual button callback forwards commands to its parent:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-contexts.lisp \\
  --eval '(wxlambda-event-contexts:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-contexts.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-contexts.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Its reusable " (:code "exercise") " runs the actual callback, checks forwarding/consumption, native type copying and scope expiration, and cleans up bindings and windows. Focused tests additionally cover stop/resume, suspended outer contexts across all three callback modes, stale readers/writers, callback conditions, self-unbinding and deferred disposal. The API, this guide and the example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted-platform GUI and graphical Cadre verification remain separate checks.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " adds copied/current timestamps and command classification, bounded timestamp SETF and close-family CanVeto SETF.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects.") (:p (:ref "guide/docs/BINDING-USER-DATA.md" "Per-binding Lisp user data") " now provides BIND-EVENT :USER-DATA and read-only snapshot/context association access, distinct from handler client data and native command/client/item pointers. Borrowed native userdata still prevents owned cloning; no mutable association API is added.") (:p "ABI45 " (:ref "guide/docs/NUMERIC-INPUT.md" "numeric controls") " add read-only EVENT-NUMERIC-VALUE for slider/spin snapshots and current contexts. Spin updates are notify-derived but observational; veto/raw payload changes do not roll back widget state. Numeric event owned/synthetic/clone support is unbound; forwarded spin text callbacks retain numeric lifetime/reentry guards.") (:p (:code ":radio-selection") " command events expose copied/current index and native label; EVENT-SELECTION SETF and owned/synthetic/cloning reject. Shared input guards protect source/ancestors; see " (:ref "guide/docs/RADIO-GROUPS.md" "radio groups") ".") (:p (:code ":toggle-button-change") " exposes copied/current checked metadata and native text (normally empty); semantic EVENT-CHECKED-P SETF and owned/synthetic/cloning reject. Source/ancestor Input guards apply to native and propagated callbacks. See " (:ref "guide/docs/TOGGLE-BUTTONS.md" "toggle buttons") ".") (:p (:code ":combo-selection") " observes a native list index/text; semantic selection SETF and owned/synthetic/cloning reject for this kind. Existing :text-change remains shared command support. Both combo-origin families retain Input guards; physical selection may send COMBO then TEXT. See " (:ref "guide/docs/COMBO-BOXES.md" "combo boxes") ".") (:p (:code ":date-change") " is a native command-family date-picker event. " (:code "event-date") " reads a copied supported Gregorian tuple from the snapshot or current innermost context, independently of current control value; invalid/out-of-scope native event dates yield NIL. Non-date contexts and expired contexts reject. Date payload SETF, owned/synthetic date events and detached clones are unbound. Native/propagated/composite TEXT callbacks retain Input lifetime/reentry guards. See " (:ref "guide/docs/DATE-PICKER.md" "date pickers") ".") (:p (:code ":time-change") " is a native command-family time-picker event. " (:code "event-time") " reads a copied hour/minute/second tuple from the snapshot/current innermost context; midnight is " (:code "(0 0 0)") ", invalid native payloads yield NIL. Non-time and expired contexts reject. Date payloads/timestamps remain separate; no semantic time writer, owned/synthetic time event or detached clone. Source/ancestor/composite Input guards and silent cross-picker synchronization apply. See " (:ref "guide/docs/TIME-PICKER.md" "time pickers") ".") (:p (:code ":search") "/" (:code ":search-cancel") " are native-only SEARCH-CONTROL command kinds with copied native string payloads, including empty (no query inference). Current-context command string writes affect metadata only; source-bound TEXT payload string writes reject. Actual/propagated/composite Input guards protect query/hint mutations and lifetimes. No new owned/synthetic/search clones; generic TEXT scope is retained. Cancel effects, icons and Enter behavior vary by port. See " (:ref "guide/docs/SEARCH-CONTROLS.md" "search controls") "."))))
(:entry "guide/docs/EVENT-HANDLERS.md" :names ("docs/EVENT-HANDLERS.md" "EVENT-HANDLERS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-HANDLERS.md" :sections (("Guide" (:heading 1 "Event-handler ownership and lifetime") (:p "This C1 foundation slice introduces " (:code "event-handler") ", a native-backed CLOS wrapper for " (:code "wxEvtHandler") " and the superclass of " (:code "window") ". It establishes ownership and state before generic binding/unbinding, timers and broader event routing. The coverage baseline is wxWidgets 3.2.12; current native ABI is 16. Four command-event observer kinds now have " (:ref "guide/docs/EVENT-BINDINGS.md" "independent bindings") ".") (:heading 2 "Owned standalone handlers") (:code-block "lisp" "(defclass named-handler (wxlambda:event-handler)
  ((name :initarg :name :reader name))
  (:default-initargs :name \"worker-results\"))

(defvar handler (wxlambda:make-event-handler :class 'named-handler))
(wxlambda:handler-alive-p handler)           ; T
(setf (wxlambda:handler-enabled-p handler) nil)
(wxlambda:handler-enabled-p handler)         ; NIL
(wxlambda:destroy-event-handler handler)     ; T
(wxlambda:handler-alive-p handler)           ; NIL in this active session") (:p "Use these forms inside " (:code "with-application") ". Direct " (:code "make-instance") " is supported; subclass slot initargs, defaults and AFTER hooks work normally. A subclass AFTER hook can read native state. No native initargs are currently exposed on the standalone base. The thin keyword-only factory forwards subclass initargs and accepts a class symbol or class object, rejecting window and non-handler classes.") (:p "The session owns each standalone native handler. Explicit destruction deletes it immediately outside callbacks. During callbacks the target is invalidated and native deletion is deferred until its dispatch/setter stack returns; any remaining standalone handlers are deleted during session cleanup, before native application exit. Dropping a Lisp wrapper does not delete its native object: no GC finalizer is installed. Failed managed initialization rolls back native handlers/windows allocated in that initialization and releases callback roots, preserving the original condition or nonlocal exit.") (:p "Repeated explicit destruction is an error. Reads/writes on destroyed handlers signal " (:code "native-error") ", except " (:code "handler-alive-p") ", which returns NIL for a stale native identity during an active session. Failed/uninitialized wrappers have no handle and signal " (:code "native-error") ". All three operations require an active session; after session cleanup even the liveness query signals " (:code "native-error") ".") (:heading 2 "Borrowed window identities") (:p "Every concrete window inherits " (:code "event-handler") ". It uses its existing " (:code "wxWindow") " as the native " (:code "wxEvtHandler") " base, allocating " (:b "one native widget") ", with no second standalone handler. Existing window construction, subclass defaults and AFTER hooks remain unchanged. The window is still owned according to its window/parent lifetime. " (:code "destroy-event-handler") " rejects window wrappers; use " (:code "destroy-window") " and the existing parent-ownership rules. The raw bridge enforces this distinction.") (:p "This interface refers to the window's own native base identity. It does not wrap an arbitrary " (:code "GetEventHandler()") " chain, push/pop handlers, transfer ownership or allow supplied native handles. The base " (:code "window") " class remains abstract.") (:heading 2 "Event processing versus window input") (:code-block "lisp" "(assert (typep button 'wxlambda:event-handler))
(setf (wxlambda:handler-enabled-p button) nil)
(wxlambda:handler-enabled-p button) ; NIL: its handler skips processing
(wxlambda:enabled-p button)         ; window input state is unchanged") (:p (:code "handler-enabled-p") " reads " (:code "wxEvtHandler::GetEvtHandlerEnabled") "; its canonical generic SETF writer calls " (:code "SetEvtHandlerEnabled") ", normalizes a generalized boolean and returns the supplied value. This is the own event-processing flag, separate from " (:code "enabled-p") " and ancestor input state. It does not grey out a control, synthesize a command event or promise to suppress processing elsewhere in a native handler chain or parent propagation route. Native wxWidgets routing rules still apply.") (:p "Disabling event processing can suppress " (:code "wxEVT_DESTROY") " delivery. Native window lookup therefore also uses weak tracking, independent of that event, before dereferencing a pointer. Destruction invalidates the window and child identities even if their handlers are disabled. The existing native destroy hook removes ordinary registry entries; dead weak entries may remain until session cleanup but cannot be dereferenced. This is internal tracking, not a public " (:code "wxWeakRef") " wrapper.") (:p "All operations are restricted to the main-thread GUI session. Callback roots for the existing control-specific handlers still require explicit unbinding before window destruction, or they remain rooted until session cleanup. Standalone handlers, windows and the borrowed application view support built-in and registered command/notify observer kinds, ID filters, safe generic unbinding and copied synthetic queues; see " (:ref "guide/docs/EVENT-BINDINGS.md" "command-event bindings") ". Arbitrary event types, borrowed window/app chains and pushed handler ownership, filters, derived notify/session event classes, timer/idle handlers, worker dispatch and native virtual overrides remain open C1 work. " (:ref "guide/docs/EVENT-CONTEXTS.md" "Scoped contexts") " provide Skip/propagation for supported built-in and registered kinds, plus checked close/notify veto, without making saved snapshots mutable. Immutable event snapshots retain their existing contract.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/event-handlers.lisp" "event-handlers example") " constructs a handler subclass with native state read in its AFTER hook. Separate window callbacks toggle a target button's own event-processing flag. The button stays enabled for input while its callback is gated:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-handlers.lisp \\
  --eval '(wxlambda-event-handlers:start)'") (:p "Its " (:code "exercise") " runs those same callbacks, verifies event counts and restores the handler state before unbinding and destroying resources. The focused scenario also verifies factories/class objects, slots/defaults, initializer rollback, borrowed-destruction errors, stale handles and disabled-parent/child destruction:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-handlers.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-handlers.lisp
python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Rebuild the ABI 31 bridge alongside the bindings. The GUI runner includes this scenario; broader platform and graphical Cadre verification remain separate. The API, this guide and example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ").") (:p "The non-command " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") " now supports checked scoped veto and real frame close requests; standalone handlers can receive synthetic close events.") (:p "Registered command/notify names and synchronous " (:code "process-event") " extend the standalone/window interface; see " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify payload and dispatch scope") ".") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Managed standalone chains") " now have canonical peer access, reciprocal SETF joins/splits and explicit unlink. Window/application sources and peers remain excluded; native ownership stays with the session.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. General native event/client/item pointer ownership remains unbound; per-binding Lisp USER-DATA is separately supported."))))
(:entry "guide/docs/EVENT-METADATA.md" :names ("docs/EVENT-METADATA.md" "EVENT-METADATA") :kind :guide :kind-name "Guide" :summary "docs/EVENT-METADATA.md" :sections (("Guide" (:heading 1 "Event metadata and mutable CanVeto") (:p "Native bridge ABI 31 adds EVENT-TIMESTAMP and EVENT-COMMAND-P readers for immutable snapshots and current innermost event contexts. EVENT-TIMESTAMP also has a context-only SETF writer. EVENT-CAN-VETO-P now has a context-only SETF writer for wxCloseEvent: window-close, query-end-session and end-session events. The baseline is wxWidgets 3.2.12. These extend existing native event views; they do not create persistent mutable native event objects.") (:heading 2 "Timestamp and command classification") (:p "EVENT-TIMESTAMP returns the native signed C long timestamp, widened without loss across the ABI. wxWidgets describes it as milliseconds since a fixed moment, not necessarily the Unix epoch; do not convert it to a calendar date. Native documentation warns that nonzero timestamps are normally supplied only for mouse/key events, which this bridge does not yet bind. Synthetic supported events start at zero. Negative values, including -1, are valid metadata and do not double as native error sentinels.") (:p "SETF accepts a signed native C long integer (32 bits on Windows; typically 64 bits on 64-bit Unix). Lisp validation uses CFFI's native LONG size; native validation repeats the range check before narrowing the fixed-width ABI value. Out-of-range or non-integer values signal TYPE-ERROR. Changing a timestamp only changes metadata: it neither schedules nor delays delivery. Synthetic queue and process calls have no timestamp initialization keyword; change it in a current context if needed.") (:p "EVENT-COMMAND-P copies/reads native IsCommandEvent. It is true for command and notify-derived events and false for close-family events. It is read-only; there is no classification writer or native event-class replacement.") (:heading 2 "CanVeto is mutable native metadata") (:p "SETF EVENT-CAN-VETO-P maps directly to wxCloseEvent::SetCanVeto. It accepts a generalized boolean and returns the supplied value. It can change false to true, including an event that began non-vetoable. Every subsequent SETF EVENT-VETOED-P still checks the *current* CanVeto flag before invoking Veto. No CanVeto writer exists for snapshots or notify/command contexts; live access on those non-close contexts rejects with NATIVE-ERROR. Notify veto capability is intrinsic and cannot be changed by SetCanVeto.") (:p "Native GetVeto is CanVeto AND the stored veto bit. Setting CanVeto false hides an existing veto without clearing that bit; setting it true again exposes the stored veto. Explicitly clear veto while CanVeto is true if that is the intended policy. A forced close starts with CanVeto false, but code that explicitly changes this flag can change the result observed by native closing logic. The flag is not proof that the OS permits cancelling shutdown; changing event metadata does not change OS intent or guarantee that a veto will be honored.") (:p "Snapshots capture each callback's pre-callback timestamp, command classification and CanVeto/veto state. Changes through a live context do not alter a snapshot already captured. Later callbacks can capture changed native metadata. Native callback ordering remains wxWidgets behavior, not a Lisp ordering guarantee. All native reads/writes require the active main-thread session and the innermost current context. Expired or suspended outer contexts signal NATIVE-ERROR; saved snapshot readers need no native session and remain usable after cleanup.") (:code-block "lisp" "(wxlambda:bind-event receiver :close
  (lambda (event context)
    (assert (not (wxlambda:event-command-p event)))
    (setf (wxlambda:event-timestamp context) 123
          (wxlambda:event-can-veto-p context) t
          (wxlambda:event-vetoed-p context) t))
  :with-context t)") (:p "Run the isolated synthetic example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-metadata.lisp --eval '(wxlambda-event-metadata:start)'") (:p "The regression covers all eight built-in and both registered families, native LONG extremes and negative timestamps, malformed/range errors, immutable snapshots, later snapshot capture, stored-veto hiding/restoration, non-close writer rejection and nested/expired context isolation. It does not emit real OS session events or claim hosted Windows/Linux runtime verification.") (:p "Native origin/type mutation, persistent event ownership/cloning, arbitrary native userData adoption, derived notify classes, pushed handlers, mouse/key, timer/idle and worker dispatch remain required C1 work. Next consider native type/origin access and broader event ownership.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects.") (:p (:ref "guide/docs/IDLE-EVENTS.md" "Idle events") " add family :IDLE, bounded RequestMore, global automatic policy and own-window opt-in metadata. Frame menus/actions now extend GUI breadth; standard dialogs are next, without requiring exhaustive foundation parity."))))
(:entry "guide/docs/EVENT-ORIGINS.md" :names ("docs/EVENT-ORIGINS.md" "EVENT-ORIGINS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-ORIGINS.md" :sections (("Guide" (:heading 1 "Native event type and origin identity") (:p "ABI 31 extends EVENT-NATIVE-TYPE to a generic reader for immutable snapshots and current innermost contexts. EVENT-ORIGIN-ID is a new generic reader with the same saved/current lifetime distinction. Baseline: wxWidgets 3.2.12.") (:p "EVENT-NATIVE-TYPE returns the actual process-local native type integer from GetEventType. Compare it with EVENT-TYPE during the active session; registry names expire at cleanup, while saved integer metadata remains readable. Type numbers are not stable serialized IDs or authority to cast native objects. A bounded " (:ref "guide/docs/EVENT-TAGS.md" "registered-tag writer") " now exists for native type; origin now has bounded " (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "clear-only detachment") ". Changing a type tag does not change the native C++ event class, so unvalidated type mutation could make native handlers cast incompatible storage. Unrestricted mutation remains unbound; the registered-tag writer checks both registry families and actual native class.") (:p "EVENT-ORIGIN-ID returns a positive opaque bridge identity if GetEventObject matches a currently registered application, owned handler, tracked window or managed menu resource. It returns NIL for null or untracked origins; it does not distinguish those two cases. The bridge compares pointer identities without dereferencing the origin. This is not a general wxObject wrapper, native pointer, native window ID or EVENT-ID value. It cannot be passed as a public receiver or used to reconstruct a wrapper. It transfers no ownership and makes no liveness guarantee. A pending destruction object can still have a captured origin identity. Lookup reflects the registry at capture/read time, not a historical reconstruction of arbitrary native pointer lifetimes.") (:p "EVENT-SOURCE remains the Lisp receiver on which the callback was registered. A child command observed on its parent has the parent as EVENT-SOURCE, but its native origin identity can still identify the child. The origin ID alone does not tell you the originating object's class. Synthetic events use their initial receiving handler as native origin; parent forwarding does not change it. Each generic and control-specific callback copies origin metadata independently. Already captured snapshots remain unchanged after later dispatch or source cleanup. Saved integer type/origin metadata requires no GUI session.") (:p "Context reads require an active main-thread session and the innermost callback. Expired or suspended outer contexts signal NATIVE-ERROR. No native event pointer escapes. There is no new-origin setter or retention/pinning protocol yet; using a borrowed object as native origin would require explicit lifetime rules. Unsupported/untracked objects remain a coverage gap, rather than being silently wrapped or adopted.") (:p "Run the example, which compares child and parent observations, checks current native type and cleans up its bindings/windows:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-origins.lisp --eval '(wxlambda-event-origins:start)'") (:p "Regression checks cover all supported kinds, registered command/notify types, standalone/application origin identity, child/parent receiver distinctions, context expiration/suspension and saved reads after cleanup. Null/untracked native-origin lookup is bounded to NIL by implementation; the public synthetic API always supplies a known receiver and cannot manufacture arbitrary native origin pointers. Real OS session events are not emitted.") (:p "GetEventObject coverage is partial: generic wxObject wrappers, origin retention, full SetEventObject, arbitrary SetEventType, arbitrary native userData adoption and broader native event ownership/cloning remain C1 work. Bounded owned-event/cloning, registered tags, clear-only origins and category metadata are now bound. Next design typed mutation/ownership contracts that preserve native storage compatibility and session isolation. Existing read-only type lookups must not become an unchecked route to native tag mutation.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/EVENT-ROUTING.md" "ID routing") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/IDLE-EVENTS.md" "Idle events") " add family :IDLE, bounded RequestMore, global automatic policy and own-window opt-in metadata. Frame menus/actions now extend GUI breadth; standard dialogs are next, without requiring exhaustive foundation parity.") (:p "Managed menu-resource identities also participate in the bounded native-origin registry. This does not guarantee actual OS-generated menu origins or equate origin with the frame binding receiver."))))
(:entry "guide/docs/EVENT-ROUTING.md" :names ("docs/EVENT-ROUTING.md" "EVENT-ROUTING") :kind :guide :kind-name "Guide" :summary "docs/EVENT-ROUTING.md" :sections (("Guide" (:heading 1 "Scoped event IDs and routing") (:p "ABI 31 extends EVENT-ID to a generic reader for saved immutable snapshots and current innermost contexts. Context-only SETF maps wxEvent::SetId. Supported scope is the existing seven built-in kinds and registered command/notify types, using the wxWidgets 3.2.12 baseline. No native event ownership is transferred.") (:p "SETF accepts signed 32-bit integers and returns the assigned integer. Native GetId uses status plus a separate output, so -1 is a valid ID rather than an error sentinel. Non-integer/out-of-range assignments signal TYPE-ERROR before FFI. Direct SetId accepts -1 as native metadata. Binding filters and initial synthetic IDs still reserve -1: use NIL for an unfiltered binding, and another initial ID for QUEUE-EVENT/PROCESS-EVENT. A mutated event ID of -1 does not make all exact filters match; an unfiltered binding still matches any event ID.") (:p "Changing an event ID affects later native matching against that event, including parent exact-ID and inclusive-range filters. It does not change the native window's own ID, change binding filters, restart dispatch or re-run handlers already visited. A consuming contextual callback still stops normal delivery; set EVENT-SKIPPED-P true when forwarding is intended. Native propagation rules still apply. Do not use ID mutation as a substitute for explicit Skip/propagation policy. This API does not promise local handler callback order.") (:p "A snapshot captures the ID before its callback. Mutating the context never changes an earlier snapshot. A later callback can capture the new ID; EVENT-SOURCE remains the Lisp receiver on which that callback was registered, not a newly inferred native origin. Saved snapshots remain readable after source/session cleanup. There is no snapshot writer. Native context access requires an active main-thread session and the innermost current callback; expired or suspended outer contexts signal NATIVE-ERROR.") (:code-block "lisp" "(wxlambda:bind-event child :routed-command
  (lambda (event context)
    (assert (= 10 (wxlambda:event-id event)))
    (setf (wxlambda:event-id context) 42
          (wxlambda:event-skipped-p context) t))
  :id 10 :with-context t)
;; A parent binding filtered to ID 42 can now match the forwarded event.") (:p "The complete runnable example constructs the child/parent, registers the custom command, verifies both snapshots and releases its bindings/windows:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-routing.lisp --eval '(wxlambda-event-routing:start)'") (:p "The regression verifies signed bounds and -1, malformed assignments, all existing event families, unchanged snapshots, nested-context suspension and expiration, parent exact/range/wildcard matching, consumption and queued delivery. It does not generate native OS logout/shutdown events. Synthetic session events retain their isolated owned-handler restrictions.") (:p "Arbitrary native tag/origin mutation, general native userData/client pointer adoption, broader persistent event ownership/cloning, derived notify classes, external native handler adoption, timer/idle and worker dispatch remain C1 work. Bounded registered tag mutation, origin clearing, category metadata and detached owned events are now supported; no type tag authorizes incompatible native casts.") (:p "Build/check using " (:code "python3 tools/docset.py build") " and " (:code "check") "; install using " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/EVENT-METADATA.md" "metadata") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded."))))
(:entry "guide/docs/EVENT-TAGS.md" :names ("docs/EVENT-TAGS.md" "EVENT-TAGS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-TAGS.md" :sections (("Guide" (:heading 1 "Bounded registered event-tag mutation") (:p "ABI 31 adds context-only SETF EVENT-NATIVE-TYPE. The reader still returns the captured/current native type integer; assign an integer returned by EVENT-TYPE for a name registered in the active session. Baseline: wxWidgets 3.2.12.") (:p "Both the current native tag and target must be registered command/notify tags. The registry families must match, and native dynamic class checks must confirm wxCommandEvent without wxNotifyEvent for command tags, or wxNotifyEvent for notify tags. A changed tag never changes native C++ storage/class. Built-in sources and targets reject, even if the apparent family matches. Window-close and both OS session tags cannot be assigned or changed by this writer. These restrictions preserve native cast compatibility and isolated synthetic session fallback. Arbitrary native type mutation remains a coverage gap.") (:p "SETF accepts signed32 integers, validates registration/family/class natively and returns the supplied integer. Unknown/built-in/cross-family types signal NATIVE-ERROR before mutation; malformed/out-of-range values signal TYPE-ERROR. Assigning the current registered type is allowed. A failed write leaves the native tag unchanged. Snapshot SETF has no method. Native reads/writes require the active main-thread session and innermost callback; expired or suspended outer contexts signal NATIVE-ERROR.") (:p "Each callback snapshot reflects the actual current supported native tag, not an assumption that it still equals the binding's registered kind. Earlier snapshots retain their original EVENT-KIND and EVENT-NATIVE-TYPE. Binding identities and Unbind retain their original registration tag. Changing a tag does not rebind, restart dispatch or guarantee which remaining local callbacks will run. Native dynamic/static lookup can match tags at different points; local callback order is not a Lisp API promise. Explicit Skip and normal propagation rules still control whether the event continues. A parent searches the changed tag when it receives a forwarded command.") (:code-block "lisp" "(wxlambda:bind-event child :raw-tag
  (lambda (event context)
    (assert (eq :raw-tag (wxlambda:event-kind event)))
    (setf (wxlambda:event-native-type context)
          (wxlambda:event-type :translated-tag)
          (wxlambda:event-skipped-p context) t))
  :with-context t)
;; Both names must have been registered with :family :command.") (:p "Text/integer, ID, timestamp, category, native class and origin are unchanged by the writer. Notify veto behavior remains available after a same-family change; PROCESS-EVENT copies the final native veto state. Type values are process-local, not stable serialized IDs. Saved snapshots remain readable after registry/session cleanup and confer no native cast or object-lifetime authority.") (:p "Run the example, which registers both command tags and verifies changed-tag parent delivery for synchronous and queued dispatch, then cleans up:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-tags.lisp --eval '(wxlambda-event-tags:start)'") (:p "Regression checks cover command/notify changes, built-in/session/cross-family and unknown targets, bad integers, failed-write preservation, immutable snapshots, nested/expired contexts and payload-preserving parent delivery. Public APIs cannot manufacture an incompatible native object carrying a registered tag, so the actual-class rejection branch is statically reviewed rather than directly exercised. Tests do not impose local callback order or emit real OS session events.") (:p "SetEventType coverage remains partial. Native origin retention/SetEventObject, generic wxObject wrappers, persistent native event ownership/cloning, arbitrary native userData adoption, pushed handlers and broader event families remain C1 work. Next define the ownership/lifetime policy needed for origin writes and persistent events before exposing borrowed native object pointers or widening mutable tags.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-ORIGINS.md" "type/origin readers") ", " (:ref "guide/docs/EVENT-ROUTING.md" "ID routing") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open."))))
(:entry "guide/docs/FOCUS-NAVIGATION.md" :names ("docs/FOCUS-NAVIGATION.md" "FOCUS-NAVIGATION") :kind :guide :kind-name "Guide" :summary "docs/FOCUS-NAVIGATION.md" :sections (("Guide" (:heading 1 "Focus navigation for keyboard-driven forms") (:p "ABI50 adds generic " (:code "focus-window") " and " (:code "navigate-focus") " on public WINDOW wrappers. Both require a live, shown-on-screen, enabled window on the GUI thread. Hidden, disabled (including ancestors) and destroyed receivers signal NATIVE-ERROR.") (:code-block "lisp" "(wxlambda:focus-window name-field :from-keyboard t)
(wxlambda:navigate-focus name-field) ; forward
(wxlambda:navigate-focus name-field :forward nil) ; backward") (:p (:code "focus-window") " returns its receiver after native SetFocus, or SetFocusFromKbd when FROM-KEYBOARD is non-NIL. Container SetFocus may delegate to a child. Keyboard-origin focus may select editor text according to native control policy. A request does not guarantee OS activation, delivery or a specific focused child. " (:code "navigate-focus") " returns T/NIL from native Navigate and starts at the receiver's parent traversal container. FORWARD defaults T; NIL selects backward traversal. Both keywords accept generalized booleans. Native eligibility, order and wrapping vary by port and container. No tab-order mutation, NavigateIn, window-change flag, focus event resources, raw focus pointer or C++ virtual hooks are exposed.") (:p "Focus changes can synchronously dispatch native focus/navigation events. Calls from Lisp event callbacks reject; enqueue an owner-bound deferred UI action:") (:code-block "lisp" "(wxlambda:on-click return-button
  (lambda ()
    (wxlambda:defer-ui-action
      (lambda () (wxlambda:focus-window name-field)) :owner name-field)))") (:p "During the native operation, bridge destruction/close of any session window is rejected, because the previous focus and traversal siblings can be involved. Shared Input operation guards also block nested GUI pumps/RUN, modal/clipboard entry and safe-idle delivery. Recursive focus operations reject. Callback errors re-signal at the Lisp boundary without rolling native state back. This does not intercept arbitrary foreign native deletion or change OS policy.") (:p "Run " (:ref "example/examples/focus-navigation.lisp" "focus-navigation.lisp") " using its indexed command in the docset. The deterministic exercise issues requests and uses a deferred command; physical Tab/Shift-Tab, OS activation, accessibility and hosted ports require separate interactive verification. Native baseline: wxWidgets3.2.12 " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/window.h" "window declarations") ". See " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/FRAME-ACTIONS.md" :names ("docs/FRAME-ACTIONS.md" "FRAME-ACTIONS") :kind :guide :kind-name "Guide" :summary "docs/FRAME-ACTIONS.md" :sections (("Guide" (:heading 1 "Toolbar and status-bar actions") (:p "ABI41 supplies frame-owned " (:code "toolbar") " and " (:code "status-bar") " window subclasses. Use native-backed " (:code "make-instance") " with " (:code ":parent frame") ", or thin generic factories " (:code "make-toolbar") " / " (:code "make-status-bar") " with validated " (:code ":class") ". Subclass slot initargs, default initargs and AFTER hooks work with native properties ready. Failed managed initialization cleans up native children and callback roots.") (:p "A frame owns at most one of each bar. Create/destroy bars outside RUN, pumps, callbacks and modal loops. Direct bar destruction is synchronous at quiescence, clears frame associations and permits replacement. Destroying a frame invalidates its bars. Bars manage frame chrome: do not install sizers on them or add them to frame sizers. Lay out ordinary content in a panel or the frame client area.") (:heading 2 "Fixed toolbar tools") (:code-block "lisp" "(let ((bar (wxlambda:make-toolbar frame)))
  (wxlambda:add-toolbar-tool bar 1001 \"Open\" :art :open :help \"Open a document\")
  (wxlambda:add-toolbar-separator bar)
  (wxlambda:add-toolbar-tool bar 1002 \"Details\" :kind :check :art :information)
  (wxlambda:realize-toolbar bar))") (:p "Tool IDs are positive signed 32-bit integers, unique within a toolbar. They may match menu action IDs intentionally; no global menu/tool state synchronization is implicit. Tools are addressed by toolbar plus ID, with no borrowed tool wrapper or raw native tool adoption. Labels are nonempty strings; help defaults to empty. Text uses explicit UTF-8 lengths and rejects embedded NUL.") (:p "Supported " (:code ":kind") " values are " (:code ":normal") " and " (:code ":check") ". Stock " (:code ":art") " values are " (:code ":new") ", " (:code ":open") ", " (:code ":save") ", " (:code ":copy") ", " (:code ":paste") ", " (:code ":quit") " and " (:code ":information") " (default). The native art provider is asked for 16-by-16 bitmaps (native DPI behavior applies); unavailable art signals NATIVE-ERROR. Separators have no public action ID or state. " (:code "toolbar-tool-count") " includes them. Add tools/separators only while quiescent before the one successful " (:code "realize-toolbar") "; it returns T and rejects an empty/already-realized bar. Realization fixes the tool collection. No removal, reordering or additions after realization, embedded controls, radio tools, dropdowns, custom images or native Cocoa customization are exposed.") (:p (:code "tool-enabled-p") " and " (:code "tool-checked-p") " read " (:code "(toolbar id)") "; generic SETF writes return the supplied Lisp value and are silent. Checked access requires a check tool. Unknown IDs, separators and invalid receiver kinds reject. Same-toolbar state writes and recursive activation defer during its action callbacks.") (:heading 2 "Route actions") (:p "Toolbar events use " (:code ":menu") ": wxEVT_TOOL is a native alias of wxEVT_MENU. Bind on the toolbar or its frame, using existing ID/range filtering, user-data, immutable snapshots and optional scoped contexts. Toolbar action origin IDs identify the tracked toolbar; event IDs identify tools. Check clicks toggle native tool state before callbacks; event checked/integer metadata copies that action state. Normal tool activations carry false/zero checked metadata. Editing an event does not write tool state. Default observers Skip and propagate, so avoid running the same action twice in both toolbar and frame observers. A contextual toolbar handler can consume it, or a single frame handler can handle shared action IDs.") (:p (:code "activate-toolbar-tool") " exercises the native OnLeftClick command path after realization: disabled tools return NIL without dispatch; enabled tools toggle check state and return T for accepted activation, independent of handler/Skip results. It does not simulate physical mouse/keyboard interaction. Callback conditions are contained at the native boundary and re-signaled after dispatch. Actual native and propagated toolbar-origin callbacks reject destruction/close of their toolbar or ancestors, same-toolbar tool-state writes/activation and nested pump/dispatch, modal or clipboard entry. Status text writes remain available. Defer guarded actions until the callback returns. Unrelated window lifetimes retain their existing contracts. Native :menu events remain independently constructible/cloneable; such payloads do not activate or mutate toolbar tools.") (:heading 2 "Status fields") (:p (:code "make-status-bar") " accepts immutable " (:code ":fields") " from 1 through 16 (default 1), with native equal relative widths. " (:code "status-field-count") " reads the count. Read/write " (:code "status-text") " with an optional zero-based field index (default 0):") (:code-block "lisp" "(setf (wxlambda:status-text status) \"Ready λ\"
      (wxlambda:status-text status 1) \"Details on\")") (:p "Empty and Unicode text round-trip; NUL, invalid indices and destroyed bars reject. SETF returns the supplied string. Frame automatic menu/tool status-help updates are disabled via SetStatusBarPane(-1), keeping fields application-owned; short tooltips remain native. Width/style changes and push/pop status stacks defer.") (:heading 2 "Backend and verification scope") (:p "The baseline is wxWidgets 3.2.12. macOS explicitly uses wxWidgets' ordinary in-window toolbar controls. Native Cocoa NSToolbar construction can restore stale raw tool-pointer placeholders when C++ toolbar addresses are reused; this path is excluded. Construction temporarily sets " (:code "mac.toolbar.no-native") " and restores its previous effective string/HasOption value. wxSystemOptions has no public remove operation: restoring an originally absent value as empty retains an internal entry, so later environment changes to that option can be shadowed. OSX builds without wxUSE_SYSTEM_OPTIONS reject toolbar construction. Other backends retain wxWidgets' toolbar controls; hosted Windows/Linux GUI verification is outstanding. Native Cocoa toolbar chrome is not claimed supported.") (:p "Run the shared-action example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/frame-actions.lisp --eval '(wxlambda-frame-actions:start)'") (:p "EXERCISE runs inside an application session and verifies shared menu/tool actions, check synchronization, disabled activation and status updates. It uses in-memory state. Automated tests cover both Lisps, native and propagated click callbacks, Unicode fields, CLOS rollback, parent invalidation, repeated bar replacement and backend option restoration. Physical tool clicks, keyboard/accessibility, display scaling and hosted OS GUIs require separate manual verification.") (:p "See " (:ref "guide/docs/MENUS.md" "menus") ", " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes these APIs with deferred shared Open/Save/Copy/Paste/close requests, toolbar/keyboard entry points and status feedback. Its coalescing and scoped close-replay policy are application logic; no extra public binding or native parity claim is introduced."))))
(:entry "guide/docs/GAUGE.md" :names ("docs/GAUGE.md") :kind :guide :kind-name "Guide" :summary "docs/GAUGE.md" :sections (("Guide" (:heading 1 "Progress gauges") (:p (:code "gauge") " is a native-backed CLOS " (:code "window") " subclass for " (:code "wxGauge") ", using the wxWidgets 3.2.12 coverage baseline. Construct it directly or through the thin " (:code "make-gauge") " factory:") (:code-block "lisp" "(defclass progress (wxlambda:gauge)
  ((job :initarg :job :reader job))
  (:default-initargs :range 100 :value 0))

(defvar progress
  (wxlambda:make-gauge panel :class 'progress :job :download
                       :orientation :horizontal))
(setf (wxlambda:gauge-value progress) 25)
(setf (wxlambda:gauge-range progress) 200)
(wxlambda:gauge-value progress)       ; 25
(wxlambda:gauge-range progress)       ; 200
(wxlambda:gauge-vertical-p progress)  ; NIL") (:p "PARENT is required. RANGE defaults to 100 and must be a positive signed 32-bit integer. VALUE defaults to zero and must be between zero and RANGE, inclusive. ORIENTATION defaults to " (:code ":horizontal") "; " (:code ":vertical") " is also supported, with no orientation writer. These restrictions are checked before passing invalid values to wxWidgets. Lisp type/range checks signal " (:code "type-error") "; a value above the current range signals " (:code "native-error") ". Invalid assignments preserve state.") (:p "The canonical writers are generic " (:code "(setf gauge-value)") " and " (:code "(setf gauge-range)") "; both return the supplied integer. Reducing a range clamps existing progress to the new maximum. Increasing it preserves progress. Range assignment calls " (:code "SetRange") " followed by " (:code "SetValue") " to restore determinate mode consistently. This explicit clamping policy is part of the Lisp binding contract.") (:p "For work with an unknown completion fraction:") (:code-block "lisp" "(wxlambda:pulse-gauge progress) ; returns PROGRESS
;; Call periodically while processing GUI events.
(setf (wxlambda:gauge-value progress) 50) ; resume determinate progress") (:p (:code "pulse-gauge") " maps to " (:code "wxGauge::Pulse") "; animation and progress readings while pulsing are platform-dependent. Neither reading the value nor changing the range after a pulse measures completed work. Assign an explicit value to resume measured progress. Pulsing does not provide a timer or thread dispatch, and it does not make blocking work responsive. Gauges emit no command events here.") (:p "The inherited layout, visibility, enabled state, logical name and destruction operations work on gauges. Native ownership stays with the parent; destroyed handles are invalid. All operations require an active main-thread GUI session. Subclass slot initargs, defaults and AFTER hooks work as described in the " (:ref "guide/docs/CLOS-API.md" "CLOS guide") ", including rollback when initialization fails.") (:p "This slice binds " (:code "wxGauge") " construction, " (:code "GetValue") ", " (:code "SetValue") ", " (:code "GetRange") ", " (:code "SetRange") ", " (:code "IsVertical") " and " (:code "Pulse") ". The constructor fixes ID to " (:code "wxID_ANY") ", position/size to native defaults and validator/name to native defaults; styles are limited to horizontal/vertical. Two-step creation, custom IDs, additional styles such as taskbar progress, and the remaining inherited API stay open. Gauge support was introduced in native ABI 10. Registered event dispatch now requires ABI 31; rebuild the bridge alongside the current Lisp bindings.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/gauge.lisp" "gauge example") " uses a subclass with a custom step slot. It keeps completed work in a Lisp slot so the advance button resumes from measured progress after a pulse, independent of native animation readings. Buttons advance/restart progress and request indeterminate pulsing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp \\
  --eval '(wxlambda-gauge:start)'") (:p "Its " (:code "exercise") " runs those same callbacks, restores determinate mode and cleans up handlers and windows. The focused test runs it and verifies orientations, factory/subclass initargs, range clamping, invalid arguments, native type checks, initialization rollback, inherited operations and stale/session handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/gauge.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/gauge.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete scenario runner also includes " (:code "gauge") ". See " (:ref "guide/docs/DOCSET.md" "docset installation") " to install the API, this guide and the example under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre."))))
(:entry "guide/docs/GRID-EDITING.md" :names ("docs/GRID-EDITING.md" "GRID-EDITING") :kind :guide :kind-name "Guide" :summary "docs/GRID-EDITING.md" :sections (("Guide" (:heading 1 "Native grid editing, selection and table changes") (:p "This slice extends the owned " (:code "wxGridStringTable") " created by " (:code "GRID") ". It adds native editor operations, cell attributes, selection events and dimension changes. It does not expose custom table models, editor ownership or a transaction API.") (:p (:code "GRID-CELL-READ-ONLY-P") ", " (:code "GRID-CELL-BACKGROUND") " and " (:code "GRID-CELL-FOREGROUND") " are generic SETF properties with " (:code "(grid row column)") " readers. Colours are copied integers " (:code "#xRRGGBB") ". Coordinates are zero based. The global " (:code "GRID-EDITABLE-P") " switch and individual read-only cells both affect native editor availability. " (:code "GRID-CAN-ENABLE-CELL-CONTROL-P") " queries native availability at the cursor; " (:code "GRID-CELL-EDITOR-SHOWN-P") " distinguishes visibility from " (:code "GRID-EDITING-P") ".") (:p (:code "GRID-CURSOR") " returns a fresh " (:code "(row column)") " pair or NIL for an empty table. SETF requests native " (:code "SetGridCursor") ", which can be vetoed by SELECT_CELL; read back to learn the resulting cursor. " (:code "SELECT-GRID-BLOCK") " takes grid, top, left, bottom and right, with optional " (:code ":ADD") "; " (:code "CLEAR-GRID-SELECTION") " clears native selection. There is no added application selection model.") (:heading 2 "Editor operations preserve native distinctions") (:p "All operations take a grid and return it. They must run after callbacks return, normally through an owner-bound " (:code "DEFER-UI-ACTION") ".") (:table :header (("Lisp generic") ("Native method and behavior")) :rows ((("ENABLE-GRID-CELL-EDIT-CONTROL") ("EnableCellEditControl; rejects when CanEnableCellControl is false.")) (("SAVE-GRID-EDIT-CONTROL-VALUE") ("SaveEditControlValue; attempts validation and table update, leaving the editor enabled. Repeated calls can produce repeated native notifications.")) (("HIDE-GRID-CELL-EDIT-CONTROL") ("HideCellEditControl; hides the editor and leaves it enabled. Focus loss can schedule a later native Disable and save. It is not cancellation.")) (("DISABLE-GRID-CELL-EDIT-CONTROL") ("DisableCellEditControl; sends HIDDEN and attempts to save. It is a commit attempt, not cancellation.")) (("RESET-GRID-CELL-EDITOR") ("Reset on the active created native text editor, held through a temporary reference-counted GetCellEditor result. It restores that editor's current baseline.")))) (:p "For an unchanged baseline, Reset followed by Disable discards newly typed text. Reset does not guarantee restoration of the original table value after a prior Save or veto: the native text editor updates its internal baseline during EndEdit. There is no general cancel guarantee. Normal native Escape behavior also performs Reset followed by deferred Disable.") (:p "Cell value, attribute and dimension writes reject while an editor is enabled. Finish the native edit first. Native editor operations and cursor/selection changes retain actual-source and ancestor lifetime guards through synchronous events. Active callbacks reject destruction, nested native loop entry and mutations; read-only native properties remain available.") (:heading 2 "Native event families") (:p "These immutable snapshots and borrowed current callback contexts use " (:code "BIND-EVENT") ":") (:table :header (("Keyword") ("Native meaning")) :rows (((":GRID-CELL-CHANGING") ("Proposed text is EVENT-TEXT. Veto prevents ApplyEdit.")) ((":GRID-CELL-CHANGED") ("EVENT-TEXT is the old text. Legacy native veto restores it after callbacks.")) ((":GRID-SELECT-CELL") ("Before cursor movement; native veto can prevent it. No post-cursor event is invented.")) ((":GRID-RANGE-SELECTING / :GRID-RANGE-SELECTED") ("Native range notifications; veto is observational because the audited native sender ignores it. Some keyboard paths emit only SELECTED.")) ((":GRID-EDITOR-SHOWN") ("Before native editor creation/show; veto can prevent it.")) ((":GRID-EDITOR-HIDDEN") ("Native notification; veto does not prevent hide/save. Creation failure can also emit it.")) ((":GRID-CELL-LEFT-CLICK / :GRID-CELL-RIGHT-CLICK") ("Native cell mouse notifications.")) ((":GRID-CELL-LEFT-DOUBLE-CLICK / :GRID-CELL-RIGHT-DOUBLE-CLICK") ("Native cell double-click notifications.")))) (:p (:code "EVENT-GRID-ROW") ", " (:code "EVENT-GRID-COLUMN") " and " (:code "EVENT-GRID-POSITION") " apply to cell events. Position is a fresh " (:code "(x y)") " in grid client coordinates including label offsets, or NIL for native " (:code "(-1 -1)") ". " (:code "EVENT-GRID-RANGE") " applies to range events and returns fresh " (:code "(top left bottom right)") ". " (:code "EVENT-GRID-MODIFIERS") " and " (:code "EVENT-GRID-SELECTING-P") " apply to both. Values are native metadata, not inferred application state. Invalid kind/accessor combinations signal an error.") (:p (:code "EVENT-GRID-CELL-VALUE") " is limited to CHANGING/CHANGED. Snapshots copy the table value before the user callback; contexts copy the current table value during their current innermost callback. CHANGING therefore ordinarily sees the old value while EVENT-TEXT contains proposed text; CHANGED sees applied text while EVENT-TEXT contains old text. Returned strings are independent copies. A legacy CHANGED veto can subsequently roll back the table, so snapshots do not predict the final table. No native pointers or mutable event resources are exposed.") (:p "Default observers automatically Skip. " (:code ":WITH-CONTEXT T") " permits explicit Skip, propagation and scoped native notify veto. An explicitly consumed event can prevent default native mouse behavior; use ordinary observers when preserving selection/editing. Event metadata/text remain read-only; detached creation, synthetic dispatch and cloning reject these kinds.") (:heading 2 "Dynamic owned table dimensions") (:p (:code "APPEND-GRID-ROWS") " and " (:code "APPEND-GRID-COLUMNS") " take optional count (default 1). " (:code "INSERT-GRID-ROWS") ", " (:code "DELETE-GRID-ROWS") ", " (:code "INSERT-GRID-COLUMNS") " and " (:code "DELETE-GRID-COLUMNS") " take a zero-based position and optional count. Native methods shift cell data, labels and attributes. Each count is 1..256; resulting axes are 0..256 with at most 16384 cells. Constructor axes remain 1..256. An empty axis makes cell access invalid; append/insert can restore cells. Dimension edits require the safe structural phase outside callbacks, RUN and event pumps, or an owner-bound deferred UI action. All table operations return the grid and signal on native failure; there is no custom-model ownership.") (:p "See " (:ref "guide/docs/GRID-EDITOR-AUDIT.md" "the pinned editor audit") " for wxWidgets 3.2.12 source links and detailed commit/hide/reset timing. The standalone example is " (:code "examples/grid-editing.lisp") "; run its START function under SBCL or CCL."))))
(:entry "guide/docs/GRID-EDITOR-AUDIT.md" :names ("docs/GRID-EDITOR-AUDIT.md" "GRID-EDITOR-AUDIT") :kind :guide :kind-name "Guide" :summary "docs/GRID-EDITOR-AUDIT.md" :sections (("Guide" (:heading 1 "Pinned wx3.2.12 grid editor/event audit") (:p "Read-only source survey before the next bounded implementation. Sources: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/generic/grid.cpp" "grid.cpp") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/generic/grideditors.cpp" "grideditors.cpp") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/generic/gridsel.cpp" "gridsel.cpp") " and " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/grid.h" "grid interface") ". Copies are in /private/tmp/wxl-grid-{grid.cpp,grideditors.cpp,gridsel.cpp}.") (:heading 2 "Commit, hide and reset are distinct native operations") (:table :header (("Native operation") ("Observed pinned behavior")) :rows ((("SaveEditControlValue") ("If enabled, EndEdit computes proposed value, CELL_CHANGING can veto, ApplyEdit updates the table, then CELL_CHANGED reports old value. Leaves editor enabled/shown; not a transaction boundary.")) (("DisableCellEditControl") ("Sends EDITOR_HIDDEN, then DoAccept sets enabled=false, hides and saves through the same validation path. HIDDEN veto does not stop it. This is a commit attempt, not cancel.")) (("HideCellEditControl") ("Calls DoHide only and does not directly save or disable. It may refocus grid; editor KillFocus calls DismissEditor, which queues DisableCellEditControl with CallAfter. Consequently Hide can cause a deferred commit and cannot be advertised as cancellation.")) (("Native editor Reset") ("The Escape handler calls editor.Reset then deferred Disable. For the native text editor, Reset restores its current internal m_value baseline, not necessarily the original table value across prior Save/veto calls.")))) (:p "Text editor EndEdit assigns m_value before validation. ApplyEdit clears it after successful table write. Therefore repeated Save can emit repeated native change events, and after a veto the editor's own baseline may differ from the table. Do not invent a transaction API or promise cancellation/validation retry behavior that upstream methods do not supply. A bounded current-editor Reset adapter must identify the native operation honestly and retain no editor resource/pointer.") (:heading 2 "Events and veto semantics") (:p "CELL_CHANGING GetString is proposed new text; GetCellValue is still current old text. CELL_CHANGED GetString is old text; GetCellValue is current applied text. Native legacy CELL_CHANGED veto restores the old table value after callbacks; new validation should use CHANGING. Current value must be copied at snapshot delivery and remain independent from the mutable live table.") (:p "SELECT_CELL occurs before cursor movement and can veto. Its row/column are the proposed target; current grid cursor is still previous. No corresponding native post-cursor-change event exists in this pinned interface. RANGE_SELECTING and RANGE_SELECTED report changing/final blocks, but native selection code ignores their IsAllowed result, so their veto is observational. Keyboard selection may emit SELECTED without SELECTING. SHOWN can veto before editor activation; HIDDEN is unconditional and may be sent even when editor creation failed.") (:p "All events use existing BIND-EVENT, immutable snapshots/scoped contexts, and actual-origin/composite lifetime guards. No synthetic/owned/cloned grid events, mutable row/column/payload metadata, custom table/model callbacks, or retained native editor/attribute pointers. Do not infer transaction success from generic notify CanVeto metadata alone.") (:heading 2 "Proposed bounded scope") (:list (:item (:p "General native cell/change/select/range/editor/click kinds160..170, numeric"))) (:p "row/column/range/modifier metadata and copied native text/current cell value.") (:list (:item (:p "Native cursor and editor enabled/shown/read-only capability queries; guarded"))) (:p "Save/Hide/Disable (and optional bounded current-editor Reset) outside callbacks.") (:list (:item (:p "Per-cell read-only, background and text foreground properties using owned"))) (:p "native attributes and packed RGB values, no attribute resource adoption.") (:list (:item (:p "Native string-table Append/Insert/Delete rows/columns under existing active"))) (:p "editor and main-thread guards; dimensions bounded0..256 after deletion, at most16384 cells, while construction may remain nonempty. Zero dimensions require NIL cursor/sentinel-aware reads and CanEnableCellControl checks.") (:p "Structural writes require safe quiescence/owner-bound UI action. Active-editor property/table changes reject. Explicit native editor operations retain full InputOperation source/ancestor/native-entry guards around synchronous callbacks and focus work. Native table changes may notify differently by operation; do not manufacture CELL_CHANGING/CHANGED for silent SetCellValue calls.") (:heading 2 "Acceptance probes") (:p "Use actual default text editor in native fixtures, changing its private control only for tests. Verify proposed/old/current snapshot values, CHANGING veto, legacy CHANGED rollback, SHOWN veto/HIDDEN observation, Save enabled state, Hide deferred focus-loss behavior, and Reset-before-Disable baseline semantics. Cover selection target/range payloads and context expiry, actual/composite/parent callback lifetime guards, table mutation bounds/empty states/attributes moving with native rows, active-editor rejection and native teardown. Both-Lisp examples must avoid physical-input claims; no system clipboard transfer in automation."))))
(:entry "guide/docs/GRID.md" :names ("docs/GRID.md") :kind :guide :kind-name "Guide" :summary "docs/GRID.md" :sections (("Guide" (:heading 1 "Editable native string grids") (:p "The native-backed " (:code "grid") " WINDOW subtype exposes a useful bounded " (:code "wxGrid") " string table. It supports native mouse/keyboard cell selection and editing, copied cell text, row/column labels and whole-grid editing policy. It is a string table: there is no formula evaluation, numeric coercion, custom table, editor, renderer or attribute ownership API.") (:code-block "lisp" "(defparameter table
  (wxlambda:make-grid parent :rows 12 :columns 3 :editable-p t))
(setf (wxlambda:grid-column-label table 0) \"Item\"
      (wxlambda:grid-row-label table 0) \"First\"
      (wxlambda:grid-cell-text table 0 0) \"Keyboard λ\")
(wxlambda:grid-cell-text table 0 0) ; fresh Lisp string
(wxlambda:grid-rows table)         ; 12
(wxlambda:grid-columns table)      ; 3
(wxlambda:grid-editable-p table)    ; T
(wxlambda:grid-editing-p table)     ; native cell editor currently enabled?") (:p (:code ":parent") " requires a live WINDOW. Defaults are10 rows,5 columns and editable T. Constructor dimensions are1..256 and the total cannot exceed16384 cells. Bounded native row/column insertion/deletion can produce empty axes; custom table adoption remains unbound. See " (:ref "guide/docs/GRID-EDITING.md" "native editing and dimensions") ". Cell indices are zero-based and checked against the actual shape. Labels initially use native defaults; applications can replace them with strings, including empty strings. Programmatic cell/label text is NUL-free and at most65536 UTF-8 bytes per value. Multiline strings are accepted. Reads copy native text with explicit lengths; changing the returned Lisp string never changes the grid. The programmatic limit does not constrain text entered through native editing.") (:p (:code "grid-cell-text") ", " (:code "grid-row-label") ", " (:code "grid-column-label") " and " (:code "grid-editable-p") " have generic SETF writers returning the supplied value. Editing state accepts generalized booleans. Turning editing off prevents native user changes; it does not prohibit programmatic cell text updates. The initial edit policy does not imply every future cell will have arbitrary editor or per-cell read-only overrides.") (:p "All grid writes reject Lisp callback use, including writes to another grid. Use an owner-bound " (:code "defer-ui-action") ". Writes also reject while the native cell editor is enabled, even if currently hidden or the requested value is unchanged. This avoids implicitly committing an unfinished edit or hiding/recreating its editor. Finish or cancel the edit with the native keyboard/mouse interaction first. " (:code "grid-editing-p") " reports editor enablement, not focus or unsaved-change state. Readers remain callback-safe and report committed table values; an unfinished editor buffer can differ. Native Save/Hide/Disable and active-editor Reset are exposed with distinct semantics; none is an invented transaction/cancel API.") (:p "The wrapper uses the native-owned default " (:code "wxGridStringTable") "; native editors, renderers and composite child windows remain private. Selected immutable native grid events, scoped native validation/veto, cursor/selection requests and bounded dimension changes are documented in " (:ref "guide/docs/GRID-EDITING.md" "GRID-EDITING") ". Sorting, custom native callbacks and spreadsheet clipboard operations remain unbound. Generic child TEXT/BUTTON events retain their existing event scope and are not a grid cell-change API. Inherited window operations, including layout/geometry/visibility, are available under their normal contracts; managed handler stacks remain unavailable for this native scrolled composite.") (:p "All operations require the active main-thread GUI session and checked native lifetime. Parent destruction invalidates the grid. Composite child input callbacks protect the grid and its ancestors from destruction/close, and prevent nested GUI, modal or clipboard entry. Mutations hold the shared Input operation guard; early Destroy and native-base teardown suppress child input dispatch while the native editor/table is being removed. CLOS construction supports direct subclasses, slot/default initargs, native-ready AFTER hooks, validated factory " (:code ":class") " and managed initializer failure/root rollback. Lisp subclassing does not override native C++ virtual methods.") (:p "Requires " (:code "wxUSE_GRID=1") " in the pinned wxWidgets3.2.12 core build. The C ABI constructor returns a handle or0; property getters return nonnegative values or-1 on error; string readers return borrowed UTF-8 plus explicit length orNULL on error; setters return0/-1. Lisp copies strings before another native call and maps errors to " (:code "native-error") ".") (:p "Run the example with:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/grid.lisp \\
  --eval '(wxlambda-grid:start)'") (:p "The example displays an inventory table and reads a committed value through an owner-bound deferred button action. " (:code "tests/grid.lisp") " exercises its automatic path, copies/bounds, CLOS rollback, callbacks and disposal. The native invariant helper also exercises a real string editor, private child TEXT/BUTTON propagation, active-editor refusal, synchronous operation reentry, early Destroy restoration and foreign-thread rejection. Native interaction, rendering, accessibility and editing details remain port policy; local automated checks do not establish cross-platform manual interaction fidelity."))))
(:entry "guide/docs/HANDLER-CHAINS.md" :names ("docs/HANDLER-CHAINS.md" "HANDLER-CHAINS") :kind :guide :kind-name "Guide" :summary "docs/HANDLER-CHAINS.md" :sections (("Guide" (:heading 1 "Managed standalone event-handler chains") (:p "ABI 31 adds NEXT-HANDLER, PREVIOUS-HANDLER, HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER for session-owned standalone EVENT-HANDLER objects and subclasses. The two peer properties have generic SETF writers. The baseline is wxWidgets 3.2.12. Borrowed window/application sources and peers reject these operations; dedicated managed " (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "window stack APIs") " now cover Push/Pop/Remove while preserving bridge ownership. General standalone peer operations still exclude attached/borrowed window chains.") (:heading 2 "Canonical peers and native ownership") (:p "NEXT-HANDLER and PREVIOUS-HANDLER return the existing managed Lisp peer, or NIL for a vacant endpoint. Repeated lookup is EQ to the original wrapper, including subclasses and their slot state. These are wrapper references, not native pointer values or reconstructed objects. HANDLER-UNLINKED-P is true only when both peer links are NIL.") (:p "The session strongly roots standalone wrappers in a canonical identity map until explicit destruction, failed-construction rollback or session cleanup. This is true even for unlinked handlers: dropping application references does not make a new wrapper appear on lookup or destroy native state. Native ownership remains in the session registry; linking does not adopt, transfer or parent a handler. There is no GC finalizer. Native fields remain available in subclass AFTER hooks and constructor rollback removes canonical registrations and native resources. It does not undo arbitrary edits made to pre-existing external chains. Removing a failed node invokes native Unlink, which can leave surviving prefix/suffix segments joined. Resource cleanup is not a graph-state transaction.") (:p "Reads require the active main-thread session and valid non-deleting standalone handles, but are permitted during callbacks. Outside-session and stale/pending native access signal NATIVE-ERROR. Window/application receivers and peers signal NATIVE-ERROR before mutation rather than exposing a borrowed native chain.") (:heading 2 "Reciprocal linking and splitting") (:p "The Lisp SETF protocol preserves both directions of each edge. It is deliberately stronger than calling one raw native setter and leaving the other link stale.") (:code-block "lisp" "(wxlambda:with-application ()
  (let ((first (wxlambda:make-event-handler))
        (middle (wxlambda:make-event-handler))
        (last (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (setf (wxlambda:next-handler first) middle
                 (wxlambda:next-handler middle) last)
           (assert (eq first (wxlambda:previous-handler middle)))
           (wxlambda:unlink-event-handler middle)
           (assert (eq last (wxlambda:next-handler first)))
           (assert (wxlambda:handler-unlinked-p middle)))
      (dolist (handler (list first middle last))
        (wxlambda:destroy-event-handler handler)))))") (:p "Setting NEXT-HANDLER joins the source's vacant next endpoint to the peer's vacant previous endpoint; setting PREVIOUS-HANDLER is the mirror operation. Existing segments can be joined at compatible vacant endpoints. Repeating an already reciprocal pair is idempotent. Self-links, cycles, occupied conflicting endpoints and invalid peers reject before changing either chain. SETF returns the supplied peer wrapper.") (:p "The pinned interface text says native SetNextHandler/SetPreviousHandler cannot receive NULL, but the implementation setters permit pointer clearing and native Unlink uses the same paired clearing pattern. Lisp NIL is a bounded reciprocal detach operation, not an exposed one-sided null setter. Retain this interface/ implementation discrepancy for C7 reconciliation.") (:p "SETF NIL detaches just that edge and its reciprocal link, splitting a chain into two segments; it returns NIL. It does not remove the source from both neighbors. UNLINK-EVENT-HANDLER instead splices the source's previous and next neighbors together and leaves the source detached and alive, returning the source handler. Unlinking an already detached handler is harmless.") (:p "All mutations require a non-dispatch boundary: RUN, native pumps and callbacks reject linking, edge detachment and UNLINK, even if the requested change would be idempotent. Read peers during a callback and schedule structural changes for after dispatch instead. No new asynchronous mutation scheduler is supplied. Attached pushed nodes also reject general peer reads/SETF/UNLINK; HANDLER-UNLINKED-P can report false. Use the window stack APIs to inspect or detach those nodes.") (:heading 2 "Dispatch and lifetime") (:p "Normal processing, native pending delivery and PROCESS-EVENT-LOCALLY now traverse these standalone native chains using wxWidgets rules. An observer Skips, so a following node can run. A consuming contextual callback can stop local chain handling. Disabling a node's HANDLER-ENABLED-P skips its own handling without disabling following nodes. Skip, parent propagation and local chain traversal remain distinct native mechanisms; STOP-EVENT-PROPAGATION is not a promised replacement for consuming a chain event.") (:p "Each snapshot's EVENT-SOURCE is the wrapper on which that callback was registered. It can be a downstream handler while EVENT-ORIGIN-ID still identifies the original delivery receiver. Callback modifications remain subject to native matching and snapshot immutability; native node traversal follows the next-link chain, but linking does not promise callback registration order within an individual node.") (:p "Destroying a linked handler during a callback rejects before native deletion so the active chain is not edited under native traversal. Destroying an unlinked handler from a callback keeps the existing deferred-destruction behavior. Outside callbacks, native handler destruction unlinks/splices a linked node; its neighbors remain alive and reciprocal. Explicit UNLINK never destroys the node. Session cleanup removes bindings, canonical roots and remaining native handlers safely.") (:p "Pending queues belong to their target handler, not to every node that might later observe an event through a chain. DELETE-PENDING-EVENTS deletes only its receiver's own queue. It does not cancel upstream queued events merely because they might later traverse that node. Linking/unlinking does not move queued objects between queues. Destination destruction and consuming TRANSFER-EVENT retain their existing ownership rules.") (:p "Session tags remain isolated from wxApp fallback. Managed chains cannot include a borrowed application/window handler, and standalone session fallback remains blocked. Native chain support does not authorize synthetic OS session delivery, window pushed-handler ownership or arbitrary native chain edits.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-chains.lisp --eval '(wxlambda-handler-chains:start)'") (:p "Validation should cover reciprocal/canonical peers, segment joining/splitting, cycle/occupied-endpoint rejection without mutation, unlink/destructor splicing, Skip/consumption/disabled-node delivery, pending/local dispatch, callback mutation rejection and constructor rollback. Local results do not establish hosted Windows/Linux GUI, real OS-session or graphical Cadre validation.") (:p "Coverage remains partial: borrowed window/app chains, native Push/Pop/Remove, external/native handler adoption, worker access, ownership transfer, native virtual overrides and arbitrary event-origin retention remain required C1 work. Next define borrowed window handler-stack ownership before exposing Push/Pop or widening chain receivers; preserve managed reciprocal identity and dispatch guards.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/PENDING-EVENTS.md" "pending delivery") ", " (:ref "guide/docs/EVENT-BINDINGS.md" "bindings") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window stacks") " now provide bounded Push/Pop/ Remove and explicit stack-aware synchronous processing; external adoption and general SetEventHandler remain gaps.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. General native event/client/item pointer ownership remains unbound; per-binding Lisp USER-DATA is separately supported.") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/HANDLER-CLIENT-DATA.md" :names ("docs/HANDLER-CLIENT-DATA.md" "HANDLER-CLIENT-DATA") :kind :guide :kind-name "Guide" :summary "docs/HANDLER-CLIENT-DATA.md" :sections (("Guide" (:heading 1 "Lisp client data attached to managed handlers") (:p "ABI 31 adds EVENT-HANDLER-CLIENT-DATA and its generic SETF writer. The receiver is any current public EVENT-HANDLER wrapper: an owned standalone handler, a managed window/control or the borrowed managed APPLICATION-HANDLER. The baseline is wxWidgets 3.2.12. OWNED-EVENT and immutable event snapshots are different resources and are not handler-client-data receivers.") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((handler (wxlambda:make-event-handler))
         (state (list :count 0)))
    (unwind-protect
         (progn
           (setf (wxlambda:event-handler-client-data handler) state)
           (assert (eq state (wxlambda:event-handler-client-data handler)))
           (setf (getf state :count) 1))
      (setf (wxlambda:event-handler-client-data handler) nil)
      (wxlambda:destroy-event-handler handler))))") (:heading 2 "Value identity and native representation") (:p "The property accepts any non-NIL Lisp object, retains it strongly and returns the same object by EQ. It does not copy/serialize the object or snapshot its mutable contents. Multiple handler associations can refer to the same Lisp value without making it native-owned memory. SETF returns the supplied value. NIL clears the bridge association and reads NIL when no bridge datum is present; NIL is not a distinct stored payload.") (:p "A native wxClientData subclass carries only an opaque numeric root token. The Lisp session root table holds the actual object. No native pointer to a Lisp object, raw client-data address or generic wxClientData wrapper is exposed. Native handler ownership deletes the adapter; it does not directly destroy the Lisp object or call Lisp finalizers. An ordinary Lisp reference to a previously returned value stays valid independently of the handler association.") (:p "Fresh native storage and an empty typed slot read NIL. Replacing or clearing an association deletes the old native adapter and releases its root through normal cleanup. A candidate root is established before native assignment and removed if the write fails, leaving prior native state intact on preflight rejection. There is no new constructor initarg: a subclass AFTER hook may use SETF once its native handler exists. The property does not alter handler-enabled state, bindings, event IDs, stack links or native ownership.") (:heading 2 "Foreign storage and typed mode safety") (:p "Native wxEvtHandler supports either typed wxClientData or untyped void* storage, not both. This binding supports only an empty slot or its own typed adapter. Foreign non-null typed client objects reject get/set without replacement or deletion. Every untyped/Void mode rejects too, including a slot whose raw pointer was set to NULL: clearing an untyped pointer does not reset its native mode. NIL assignment does not grant permission to erase foreign storage or switch between native modes.") (:p "The implementation checks mode before GetClientObject, avoiding native assertions from calling a typed getter on untyped storage. wxEvtHandler has no public mode getter. A private implementation interface on the bridge's managed App, StandaloneHandler and ManagedWindow classes exposes their protected m_clientDataType solely for this guard. This implementation-header dependency must be reviewed when advancing the wxWidgets baseline and retained for C7 reconciliation. It is not a new public field/mode getter, arbitrary native handler adoption or wxClientDataContainer binding.") (:p "Untyped GetClientData/SetClientData remains unbound. This property is also not wxCommandEvent::GetClientObject/SetClientObject or per-item client data on a choice/list control. Those pointer lifetimes and ownership rules remain gaps. Per-binding Lisp USER-DATA is now supported separately; it is not this handler slot. Owned-event clone/dispatch rejection of borrowed event client or userData pointers is unchanged by storing a Lisp value on a handler.") (:heading 2 "Lifetime and cleanup boundaries") (:p "All accesses require the active main-thread application session and a live managed receiver. Expired/stale/pending-destruction native access rejects through existing lifetime guards. Native slot mutation is allowed during callbacks; it is not a structural handler-chain/stack edit and does not pump native events.") (:p "Lisp roots are reaped at client-data access and existing generic binding cleanup and rollback boundaries; the session root table is cleared after native finish. Asynchronous native destruction can retain a root until actual deletion followed by the next cleanup boundary or session end. Do not infer immediate garbage collection from DESTROY-WINDOW or a weak-reference observation. There is no GC finalizer, worker access, pointer retention API or cross-session value lookup.") (:p "Unlinking a standalone handler, default pop/remove or window destruction that detaches a pushed handler leaves that handler alive with its own client datum. Deleting a handler, deleting pop, or actual window/application destruction drops the associated native adapter; roots are subsequently released as above. Data on a window and data on its pushed handler are separate associations. Constructor rollback cleans created native resources and their client roots, without undoing arbitrary side effects on pre-existing external objects.") (:p "Immutable event snapshots do not capture this property. EVENT-SOURCE can identify a live callback receiver that has handler client data, but saving an event does not create a separate client-data snapshot or extend native handler lifetime. Already retained Lisp values remain ordinary valid objects after native cleanup.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-client-data.lisp --eval '(wxlambda-handler-client-data:start)'") (:p "It associates Lisp state, observes it through a callback's receiver, checks EQ identity and clears the association before disposing resources. Validation must also distinguish retained values from native pointer payloads, replacement/clear from foreign-mode overwrite, requested from actual asynchronous deletion, and managed window data from detached pushed-handler data. Local checks do not establish hosted Windows/Linux GUI, native OS-session or graphical Cadre behavior.") (:p "A separate optional native regression creates otherwise-unreachable foreign storage states without adding public injection exports. It includes the bridge implementation in a dedicated test translation unit and checks typed/untyped rejection with a captured native assertion counter. Build/run in a separate GUI capable process:") (:code-block "sh" "cmake -S . -B build-native-tests -DWXLAMBDA_BUILD_NATIVE_TESTS=ON
cmake --build build-native-tests --target wxlambda-client-data-native
./build-native-tests/wxlambda-client-data-native") (:p "The option is OFF by default; this target is development verification, not a packaged library API or worker-thread facility. Native GUI/display prerequisites still apply. Require a passing result and zero captured assertions before claiming safe foreign-mode validation.") (:p "Coverage is partial: this supplies managed-handler typed client objects with Lisp root identity, not arbitrary wxClientData construction, untyped storage, event client/userData, item data, foreign object adoption or complete client-data container APIs. Continue those C1 ownership prerequisites explicitly before widening pointer-bearing APIs.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "window stacks") ", " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/BINDING-USER-DATA.md" "Per-binding Lisp user data") " now provides BIND-EVENT :USER-DATA and read-only snapshot/context association access, distinct from handler client data and native command/client/item pointers. Borrowed native userdata still prevents owned cloning; no mutable association API is added."))))
(:entry "guide/docs/IDLE-EVENTS.md" :names ("docs/IDLE-EVENTS.md" "IDLE-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/IDLE-EVENTS.md" :sections (("Guide" (:heading 1 "Idle events and bounded idle work") (:p "ABI 31 adds built-in :IDLE with EVENT-FAMILY :IDLE and exact wxIdleEvent owned construction/cloning, plus EVENT-MORE-REQUESTED-P, IDLE-MODE, WINDOW-PROCESS-IDLE-P and WAKE-UP-IDLE. The baseline is wxWidgets 3.2.12. This bounded foundation supports useful GUI updates; it does not make exhaustive native utility/event parity a prerequisite for menus, dialogs or other controls.") (:heading 2 "Idle delivery versus explicit event dispatch") (:p "BIND-EVENT accepts :IDLE on supported receivers, including the managed application/window entry paths. Saved snapshots copy idle MoreRequested before the callback. Native idle generation happens when the event loop/polling reaches idle processing, not continuously merely because an application is quiet.") (:p "EVENT-MORE-REQUESTED-P reads captured/current/owned MoreRequested; it is NIL for other event families. SETF calls RequestMore only on a live idle context or owned idle event, normalizing a generalized boolean and returning the supplied value. It requests further idle processing when the native loop is idle, not a busy-loop or timing guarantee. Keep work bounded and stop requesting more when the work list is empty. Owned flag changes prepare metadata for later copying; synthetic dispatch is not a promise of automatic scheduling.") (:code-block "lisp" "(wxlambda:bind-event (wxlambda:current-application-handler) :idle
  (lambda (snapshot context)
    (declare (ignore snapshot))
    (when work (perform-one-small-piece (pop work)))
    (setf (wxlambda:event-more-requested-p context) (not (null work))))
  :with-context t)") (:p "MAKE-EVENT/MAKE-INSTANCE accepts optional :MORE-REQUESTED-P for idle construction. Supplying it for a non-idle kind, even NIL, rejects and rolls back construction. Clone source state wins inherited defaults; factories reject explicit clone payload overrides including :MORE-REQUESTED-P. Keyword synthetic QUEUE-EVENT and PROCESS-EVENT do not add this option: use an owned idle event to initialize it.") (:p "Owned idle resources support existing metadata, copy/post/transfer/normal/local processing and lifecycle rules, including window stack-aware processing. Exact wxIdleEvent is added to the bounded clone-class set; borrowed userData still prevents native cloning. Idle is not a command event: command payload writes, close veto/logging-off operations and registered-tag mutation reject under their existing family/type rules. General native pointer adoption remains unbound.") (:heading 2 "Automatic native policy") (:p "IDLE-MODE is a zero-argument generic reader with SETF for :ALL or :SPECIFIED, mapping native wxIdleEvent GetMode/SetMode. It requires the active main-thread GUI session. This is a process-wide native automatic-window idle policy, not a property of one application wrapper or synthetic event. The native default is :ALL; the actual pre-session value is saved and restored during native finish, including body-error cleanup. Restore a temporary mode within a session with UNWIND-PROTECT when other code must keep seeing its prior policy.") (:p "WINDOW-PROCESS-IDLE-P reads/writes only the receiver window's own wxWS_EX_PROCESS_IDLE extra-style bit. SETF preserves all other extra-style bits and returns the generalized boolean. It does not change global mode or report effective delivery eligibility. Under :SPECIFIED the bit opts windows into native idle delivery; :ALL is not restricted to windows with this bit. Native visibility/ancestor rules and platform behavior also matter. The upstream baseline allows hidden windows to receive idle, but excludes children of hidden windows. The application can also receive global idle events independently of which windows opt in. No raw arbitrary extra-style writer is added here.") (:code-block "lisp" "(setf (wxlambda:idle-mode) :specified
      (wxlambda:window-process-idle-p window) t)
(wxlambda:wake-up-idle)") (:p "WAKE-UP-IDLE returns T after scheduling a native wake. It does not pump events, invoke callbacks inline, guarantee immediate delivery or expose worker-thread wake/posting support. The binding deliberately requires the active GUI thread, even though broader native thread use exists.") (:p "PROCESS-PENDING-EVENTS drains posted native pending queues; it does not generate new native idle processing. An explicitly queued idle event can of course be delivered from that queue. PROCESS-EVENTS uses native Yield plus ProcessIdle and can generate automatic idle callbacks. Explicit synthetic idle dispatch bypasses automatic mode/own-window-bit eligibility: it tests event handling, not native idle scheduling policy. RequestMore is metadata and must not be mistaken for a separate timer or a guaranteed number of callbacks per poll.") (:heading 2 "Verification and next GUI feature") (:p "Run the bounded work-list example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/idle-events.lisp --eval '(wxlambda-idle-events:start)'") (:p "It requests only as much idle work as remains, restores policy and cleans up. Validation distinguishes saved/current flags, exact idle owned/cloned resources, synthetic versus native policy, preserved unrelated extra-style bits, native wake versus inline callbacks and session-exit restoration. Existing event-context lifetime and session-event isolation rules remain; :IDLE does not authorize process-exiting session tags. Local checks do not prove hosted Windows/Linux GUI, real OS-session delivery or graphical Cadre behavior.") (:p "No CanSend binding is added: that method is absent from the pinned wxWidgets 3.2.12 idle interface. Arbitrary event classes, retained origins and native client/item pointers remain factual gaps but are not automatic blockers for unrelated GUI breadth. " (:b "Frame menus/actions are available; standard dialogs are next") ", adding only prerequisites those workflows need. Use the form/editor, tree/list manager and drawing/monitoring roadmap in " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "GUI coverage priorities") ", not C1 exhaustion.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") ", " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") ", " (:ref "guide/docs/PENDING-EVENTS.md" "pending dispatch") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p "ABI43 " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") " provide safe FIFO work after callbacks, including modal/clipboard/destructive requests. Existing nested event callback guards still apply; pending-only dispatch does not run the action queue."))))
(:entry "guide/docs/IMAGES-DISPLAYS.md" :names ("docs/IMAGES-DISPLAYS.md" "IMAGES-DISPLAYS") :kind :guide :kind-name "Guide" :summary "docs/IMAGES-DISPLAYS.md" :sections (("Guide" (:heading 1 "Images, bitmaps and displays") (:p "This slice binds session-owned native wxImage/wxBitmap values and wxStaticBitmap. It supplies copying, pixel/channel access, PNG file decoding/encoding, native scaling and display/coordinate queries. Image grids, zoom/pan policy, flame graph models and image editing behavior belong in applications. Existing drawing-canvas supplies bounded retained wxDC primitives; raw paint/DC lifetime adoption is not exposed. Native input events can be bound on canvas/static-bitmap windows.") (:heading 2 "Construction, ownership and pixel data") (:p "Use " (:code "(make-instance 'wxlambda:image :width 32 :height 32 :rgb bytes :alpha alpha)") " or MAKE-IMAGE with validated :CLASS/subclass initargs. RGB defaults to black; ALPHA defaults to absent/opaque. Dimensions are1..4096 " (:b "pixels") " on each axis. RGB is a simple unsigned-byte8 vector of exactly width*height*3 interleaved bytes; optional ALPHA is width*height opacity bytes (0 transparent,255 opaque). The binding copies input, retains no Lisp pointers and returns independent vectors from IMAGE-RGB/IMAGE-ALPHA. Mutating those vectors does not update native pixels. Use generic SETF to replace channels. IMAGE-ALPHA always returns opacity bytes; IMAGE-ALPHA-P distinguishes absent alpha. SETF ALPHA NIL clears the channel. IMAGE-PIXEL reads/SETFs a four-element (R G B A) list with zero-based pixel X/Y; writing nonopaque A creates alpha if absent. No premultiplication is used in wxImage channels. Native mask transparency is normalized to alpha on import.") (:p "IMAGE-SIZE returns (width height). SCALE-IMAGE returns a new owned image using native nearest-neighbour (:NEAREST) or high-quality (:HIGH, default) scaling; MAKE-INSTANCE IMAGE :SOURCE image :WIDTH/:HEIGHT is the same construction path. All image/bitmap resources together are bounded to256 values and64Mi pixels per session; converted/display copies count too. Allocation failures signal NATIVE-ERROR. Explicit DESTROY-IMAGE/DESTROY-BITMAP releases a resource; double disposal and stale access reject. IMAGE-ALIVE-P/BITMAP-ALIVE-P query validity during an active session. Session shutdown releases remaining resources. There is no garbage-collector finalizer or raw pointer adoption. Each resource belongs to its original session.") (:p "Concrete IMAGE and BITMAP subclasses support slot initargs, :DEFAULT-INITARGS and native properties in AFTER hooks. Mixed resource/window/event ancestry and abstract resource construction reject before allocation. Failed managed initialization rolls back nested native resources, windows and callback roots.") (:heading 2 "Files and bitmaps") (:p "MAKE-IMAGE :PATH loads a local PNG. SAVE-IMAGE writes PNG to a supplied native pathname and returns PATH. Decode/encode uses native wxPNGHandler without changing global handlers. Input requires a PNG signature/IHDR,24 bytes..64MiB encoded data and dimensions within the pixel cap before decoding. Unsupported formats, invalid PNG, missing paths, decode/allocation or write/flush/close failures signal native errors. Save may overwrite an existing path and a failure may leave partial output; applications own atomic-save policy. Animated images, JPEG/GIF/SVG, metadata/color profile editing and general image-handler registration are outside this slice.") (:p "MAKE-BITMAP :IMAGE creates an independently disposable native bitmap. :SOURCE instead accepts BITMAP or STATIC-BITMAP to copy an existing native value. BITMAP-IMAGE (or MAKE-IMAGE :SOURCE bitmap) converts to a new image. Native bitmap conversion can premultiply/round alpha and discard RGB at fully transparent pixels; do not use a display bitmap as a lossless pixel archive. Keep authoritative channel data in IMAGE; PNG decoding and scaling follow native wxImage semantics. BITMAP-SIZE is the native backing " (:b "pixel") " size. BITMAP-LOGICAL-SIZE, BITMAP-DIP-SIZE and BITMAP-SCALE-FACTOR expose the separate native sizing concepts; they are not interchangeable across ports.") (:p "STATIC-BITMAP is a WINDOW with :PARENT and :BITMAP construction, thin MAKE-STATIC-BITMAP, subclass hooks and generic BITMAP-VALUE SETF. It retains its own native bitmap value; disposing the source wrapper does not destroy the display. BITMAP-VALUE reading returns a " (:b "new owned BITMAP every time") ", to be explicitly disposed. Native wxStaticBitmap may resample for high DPI: on local Cocoa a2x2 source reads back as4x4 backing pixels at scale2 with2x2 logical size. This is native GetBitmap behavior, not identity with the originally supplied wrapper. Large DPI readback copies can exceed the adapter pixel limit and reject. Bitmap conversion and display copies obey native port color/alpha behavior.") (:heading 2 "Displays and coordinates") (:p "DISPLAY-COUNT, DISPLAY-GEOMETRY (optional :CLIENT-P excluding taskbar/menu space), DISPLAY-PPI and DISPLAY-SCALE-FACTOR query current native displays. Indices are zero-based and transient across display changes. Geometry returns (x y width height) in native screen units, with possibly negative origins. WINDOW-DISPLAY-INDEX returns an index or NIL when native GetFromWindow finds none.") (:p "WINDOW-CLIENT-SIZE returns native client logical units. CLIENT-TO-SCREEN and SCREEN-TO-CLIENT convert an (x y) pair; FROM-DIP/TO-DIP convert native wxPoint units using the receiver. Each returns a two-element list. Input coordinates are bounded to±1000000. WINDOW-CONTENT-SCALE-FACTOR is native GetContentScaleFactor. Cocoa logical screen coordinates, physical backing pixels and DIP coincide differently on other ports; convert explicitly before indexing image pixels. No physical display mode changes, screenshot capture, screen pointer adoption or display objects are exposed.") (:p "All APIs require the active GUI/main thread, including detached image resources. Reads of existing data/geometry are callback-safe. Writes, file IO, scaling, construction, disposal and BITMAP-VALUE copying reject callback execution; defer these operations with an owner-bound UI action. Native widget operations preserve actual-origin/ancestor lifetime and native-entry guards. Worker delivery remains QUEUE-THREAD-EVENT only. Native resources must be cleared before wx cleanup.") (:heading 2 "Verification") (:p "Native and Lisp tests exercise copy isolation, RGB/alpha/pixel bounds, PNG round trips, scaling, bitmap conversion and native high-DPI readback, static display source disposal, coordinates and CLOS rollback. Local macOS evidence does not certify other ports, physical monitor hotplug, color fidelity or physical input. See " (:ref "example/examples/image-viewer.lisp" "image example") ", " (:ref "guide/docs/DRAWING-CANVAS.md" "drawing") " and " (:ref "guide/docs/INPUT-EVENTS.md" "input events") ". Required native features: IMAGE/LIBPNG, STREAMS/FFILE, STATBMP and DISPLAY. No third-party widgets are used."))))
(:entry "guide/docs/INPUT-EVENTS.md" :names ("docs/INPUT-EVENTS.md" "INPUT-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/INPUT-EVENTS.md" :sections (("Guide" (:heading 1 "General input events") (:p "ABI57 extends the existing " (:code "bind-event") " protocol with raw keyboard, character, mouse, wheel, focus, context-menu and size events. Payload readers accept an immutable EVENT snapshot or the current innermost borrowed EVENT-CONTEXT. They reject unrelated kinds; there are no payload SETF methods. Snapshots retain copied numeric values, never native key objects or focus/window pointers.") (:table :header (("Kinds") ("Readers")) :rows ((((:code ":key-down") ", " (:code ":key-up") ", " (:code ":char") ", " (:code ":char-hook")) ((:code "event-key-code") ", " (:code "event-unicode-key") ", " (:code "event-raw-key-code") ", " (:code "event-raw-key-flags") ", " (:code "event-modifiers") ", " (:code "event-auto-repeat-p") ", " (:code "event-position"))) (((:code ":left-down") ", " (:code ":left-up") ", " (:code ":left-double-click") "; corresponding " (:code ":middle-*") ", " (:code ":right-*") ", " (:code ":aux1-*") ", " (:code ":aux2-*")) ((:code "event-position") ", " (:code "event-mouse-button") ", " (:code "event-mouse-buttons") ", " (:code "event-mouse-click-count") ", " (:code "event-modifiers") ", " (:code "event-dragging-p"))) (((:code ":mouse-motion") ", " (:code ":mouse-enter") ", " (:code ":mouse-leave")) ("Same mouse readers; triggering button is NIL")) (((:code ":mouse-wheel")) ("Mouse readers plus " (:code "event-wheel-rotation") ", " (:code "event-wheel-delta") ", " (:code "event-wheel-axis") ", " (:code "event-wheel-lines") ", " (:code "event-wheel-columns") ", " (:code "event-wheel-page-scroll-p") ", " (:code "event-wheel-inverted-p"))) (((:code ":focus-gained") ", " (:code ":focus-lost")) ((:code "event-related-window-id"))) (((:code ":context-menu")) ((:code "event-position"))) (((:code ":size")) ((:code "event-size"))))) (:p "Raw key/mouse/focus/size events have " (:code "event-family") " " (:code ":base") " and are not command events. Context-menu events are native command events. Existing generic metadata and scoped Skip/propagation operations remain available with their normal native meaning; those operations do not rewrite input payloads. No synthetic, owned or cloned raw input events are supported.") (:heading 2 "Values and coordinates") (:p (:code "event-key-code") " is the native wx key code, not a Unicode character. Prefer " (:code "event-unicode-key") " for translated characters; it returns an integer Unicode value or NIL for native WXK_NONE. It does not convert special key codes to characters. Raw key code/flags are platform-specific integers or NIL when the build lacks raw-key support. " (:code "event-auto-repeat-p") " reports native availability; not all ports distinguish repeat. KEY_UP does not pair one-for-one with repeated KEY_DOWN. A key's position is generally the current mouse position, not a caret.") (:p (:code "event-modifiers") " copies wx GetModifiers bits: ALT1, CONTROL2, SHIFT4, META8; RAW_CONTROL is16 on macOS and aliases CONTROL on other ports. CONTROL/CMD represents Command on macOS; RAW_CONTROL distinguishes its physical Control key. Do not interpret raw OS key flags as this portable wx modifier bitfield.") (:p (:code "event-position") " returns a fresh " (:code "(x y)") " list. Key/mouse coordinates are native client coordinates; context-menu coordinates are screen coordinates. A keyboard context-menu invocation returns NIL for wxDefaultPosition. These are not an automatic screen/client or DIP conversion. " (:code "event-size") " returns a fresh " (:code "(width height)") " native whole-window extent, not client size or a DIP guarantee.") (:p (:code "event-mouse-button") " is NIL or one of " (:code ":left") ", " (:code ":middle") ", " (:code ":right") ", " (:code ":aux1") ", " (:code ":aux2") ". " (:code "event-mouse-buttons") " returns a fresh list of currently held buttons, which differs from the triggering button. " (:code "event-mouse-click-count") " is native and can be -1 on unsupported ports. Dragging does not imply mouse capture; capture/release/gesture APIs are outside this slice.") (:p "Wheel rotation is signed and may be smaller than its native delta; do not assume one event equals one line. The axis is " (:code ":vertical") " or " (:code ":horizontal") ", with native lines/columns-per-action and page-scroll metadata. Inverted reports native natural-scroll metadata where supported. macOS already applies its configured scroll direction; do not invert again merely because that flag is true.") (:p (:code "event-related-window-id") " is the registered numeric bridge identity of the previous/next focus window, or NIL for null/unregistered native windows. It does not keep that window alive or promise it is still valid at delivery/read time.") (:heading 2 "Observing versus consuming input") (:p "Default observer bindings automatically Skip, preserving native editing, selection, accelerators, focus and sizer processing:") (:code-block "lisp" "(wxlambda:bind-event editor :key-down
  (lambda (event)
    (format t \"key=~D unicode=~S modifiers=~D~%\"
      (wxlambda:event-key-code event) (wxlambda:event-unicode-key event)
      (wxlambda:event-modifiers event))))") (:p (:code ":with-context t") " bindings begin consumed, as for existing events. Explicitly Skip unhandled input. Consuming KEY_DOWN prevents corresponding CHAR and can suppress accelerators; consuming CHAR_HOOK usually prevents both KEY_DOWN and CHAR. " (:code "allow-next-key-event") " accepts only a live CHAR_HOOK context and calls native DoAllowNextEvent: the hook can remain consumed while normal key events are permitted. " (:code "event-next-key-event-allowed-p") " reads copied/current hook state; an earlier snapshot does not change when the live context is modified.") (:p "Focus and size handlers should normally Skip; native focus and sizer behavior can break when they are consumed. Defer focus changes from FOCUS_LOST. Prefer CONTEXT_MENU to assumptions about right-button ordering, which varies by port; consuming right-button events can suppress native context-menu generation.") (:p "CHAR_HOOK propagates up the window hierarchy. Ordinary key/mouse/focus/size events do not generally bubble like command events. A parent binding is not a global child-input monitor. Context-menu follows command propagation. Existing explicit native propagation operations do not promise every native port will generate the same sequences.") (:heading 2 "Lifetime, IME and verification scope") (:p "Readers validate kind and current context lifetime. Retaining a context after its callback, or using an outer context during a nested callback, rejects. Actual managed/composite origins and ancestors retain input callback guards: destroy/close, modal/clipboard entry and nested GUI pumping defer. Creation and early teardown suppress unpublished/retiring native input. Deferral is required for focus/navigation changes and other callback-restricted operations.") (:p "Raw CHAR/key data is not a portable IME composition API. It does not expose marked text, candidate lists or composition start/update/end/replacement ranges. Let native text controls/STC handle composition and observe committed document changes. STC IME presentation policy does not imply composition callbacks. Physical IME/dead-key/emoji input remains a separate manual acceptance target.") (:p (:ref "example/examples/input-events.lisp" "Input observer example") " leaves native text editing intact while displaying key, pointer and focus metadata. Its EXERCISE observes native size delivery. Native fixtures use actual wx event classes to test copied key/wheel/focus/context/size payloads, observer/context Skip, hook allow-next, kind/context rejection, source/ancestor/native-entry guards and synthetic refusal. They do not inject physical keyboard/mouse actions or prove OS input/IME parity.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/input-events.lisp \\
  --eval '(wxlambda-input-events:start)'") (:p "See " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") ", " (:ref "guide/docs/FOCUS-NAVIGATION.md" "focus/navigation") ", " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:code "event-cmd-down-p") " and " (:code "event-raw-control-down-p") " copy the native CmdDown and RawControlDown states for key/mouse events. This preserves Command versus physical Control distinctions on macOS without interpreting platform raw flags in Lisp. On other ports the native methods define their relationship. They are distinct from " (:code "event-command-p") ", which identifies the wxEvent command-event class."))))
(:entry "guide/docs/KEYBOARD-ACCELERATORS.md" :names ("docs/KEYBOARD-ACCELERATORS.md" "KEYBOARD-ACCELERATORS") :kind :guide :kind-name "Guide" :summary "docs/KEYBOARD-ACCELERATORS.md" :sections (("Guide" (:heading 1 "Keyboard accelerators for shared actions") (:p "ABI42 adds generic " (:code "frame-accelerators") " and its SETF writer. The value is a proper finite list of entries " (:code "(KEY ID &rest MODIFIERS)") ". Construct a frame with the " (:code ":accelerators") " initarg, or replace the complete table while quiescent:") (:code-block "lisp" "(setf (wxlambda:frame-accelerators frame)
      '((#\\n 3101 :ctrl) (#\\d 3102 :ctrl) (:f1 3103)))
(setf (wxlambda:frame-accelerators frame) nil) ; clear explicit table") (:p "Keys are ASCII letters/digits or keywords " (:code ":f1") " through " (:code ":f12") ". Letters normalize to uppercase. Modifiers are " (:code ":ctrl") ", " (:code ":shift") ", " (:code ":alt") " and " (:code ":raw-ctrl") ", each at most once. " (:code ":ctrl") " is wxWidgets' logical Control, corresponding to Command on macOS; " (:code ":raw-ctrl") " means physical Control there and aliases " (:code ":ctrl") " on other ports. Using both in one chord rejects. Letter/digit chords require " (:code ":ctrl") ", " (:code ":alt") " or " (:code ":raw-ctrl") "; shift alone or no modifiers would intercept ordinary text and are outside this slice. Function keys may be unmodified.") (:p "Portable command IDs are integers 1..32767 (Windows native command storage/menu lookup has a narrower bound than general menu/tool IDs). At most 256 entries are supported. Duplicate effective native chords reject, including Control/raw-Control aliases off macOS. Multiple different chords may target the same command ID. Cyclic/improper lists, unsupported keys/modifiers and invalid IDs reject before installation. Failed validation or native table construction leaves the previous table intact. SETF returns the original supplied Lisp value.") (:p "Native tables copy entries and retain no wxMenuItem pointer or Lisp list. Getters return fresh nested lists of normalized keys/IDs/modifiers (canonical modifier order Control, Shift, Alt, raw-Control), and validate native frame liveness even when the table is empty. Mutating input/output lists cannot change the installed table. NIL installs wxNullAcceleratorTable. No table/entry resource wrappers, string parsers, raw key codes, menu-item adoption or resource-file tables exist.") (:p (:code ":accelerators") " defaults to NIL on " (:code "frame") ". Native-backed subclass construction, " (:code ":default-initargs") ", slot initargs and AFTER hooks work; hooks can query the table. Failed initialization cleans up the frame, table registry and callback roots. Replacement/clear require an active main-thread application outside RUN, pumps, callbacks and modal loops. Frame destruction invalidates the property.") (:heading 2 "Shared actions and platform semantics") (:p "Bind contextual " (:code ":menu") " handlers on the frame, filtered by command IDs, and route them to the same Lisp action/model used by menu and toolbar handlers. Consume handled actions (leave context Skip false) to avoid native fallback, which can try a button command when the menu command is unhandled.") (:p "Accelerators dispatch native commands; they do not portably activate menu or tool resources. On macOS/GTK the native table sends a direct menu command with unset origin/default integer metadata, ignoring matching menu enable/check state. Windows can resolve a matching menu item, honor disabled state and toggle checks first. Origin/checked/integer snapshot metadata must not be treated as a portable action-state protocol. Keep enable/check policy in the Lisp model and synchronize views from that model. Distinct accelerator IDs mapped to the same Lisp action are also supported. No automatic menu/tool state synchronization.") (:p "The example uses the same IDs and ignores native checked metadata: its model owns toggles, gates disabled New actions and explicitly synchronizes menu/tool views. Toolbar events consume before frame propagation; frame handlers consume menu/accelerator commands. Tool check clicks already toggle their native state, so same-toolbar callback state writes are avoided.") (:p "Explicit frame tables do not edit menu labels or own menu shortcuts. Plain example menu labels avoid conflicting tab-delimited native shortcut hints. Menu/control/system shortcuts, focus, keyboard layout, input methods and reserved OS keys can affect delivery or precedence. Clearing this explicit table does not remove menu-owned or system shortcuts. This is not a general key-event, text-input, accelerator-text-parsing or global-hotkey API.") (:heading 2 "Conservative callback boundary") (:p "Native accelerator commands lack a portable origin marker and can reach pushed handlers or application handlers. Therefore, while any explicit frame table is nonempty, " (:b "every managed `:menu` callback") " conservatively protects all frames with nonempty tables and their descendant windows. This includes unrelated menu callbacks and synthetic menu events. Destruction/close of those windows rejects; modal dialogs, clipboard and nested dispatch/pump entry also reject for the callback duration. Property writes such as status feedback remain available. Table changes already require quiescence. Defer destructive/modal/clipboard work until after callback return (for example DEFER-UI-ACTION). ABI43 adds a deferred-action queue for these requests; see the safe boundary below. The keyboard-only slice does not itself perform file IO. Clearing all explicit tables restores the previous menu callback policy. Existing toolbar/navigation guards continue to apply independently.") (:heading 2 "Example and verification") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/keyboard-actions.lisp --eval '(wxlambda-keyboard-actions:start)'") (:p "EXERCISE runs inside an active session, checks menu/tool/model synchronization, disabled model policy and status feedback. Its synthetic commands verify action logic, not key translation. Separate native macOS tests call the actual child CHAR_HOOK dispatch path, verify frame-table lookup and pushed-handler propagation, F12/Alt-digit commands and matching disabled/check-menu behavior. Tests also cover atomic invalid replacement, native arrays/ranges, copied data, rollback, clear, callback lifetime/loop gates and stale frames on SBCL and CCL.") (:p "wxWidgets 3.2.12 is the documented baseline; CMake requires wxUSE_ACCEL=1. Physical keyboard input/focus, accessibility, alternate layouts/input methods, reserved-key conflicts, hosted Windows/Linux translation and graphical Cadre remain unverified. See " (:ref "guide/docs/FRAME-ACTIONS.md" "frame actions") ", " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes these APIs with deferred shared Open/Save/Copy/Paste/close requests, toolbar/keyboard entry points and status feedback. Its coalescing and scoped close-replay policy are application logic; no extra public binding or native parity claim is introduced."))))
(:entry "guide/docs/KRYPTONEDIT-COVERAGE.md" :names ("docs/KRYPTONEDIT-COVERAGE.md" "KRYPTONEDIT-COVERAGE") :kind :guide :kind-name "Guide" :summary "docs/KRYPTONEDIT-COVERAGE.md" :sections (("Guide" (:heading 1 "General-purpose wxWidgets capabilities for KryptonEdit") (:p "Survey baseline: clean commit " (:code "371edbe") ", ABI56. Grid/WebView were already committed; there were no in-progress source changes to discard. This roadmap preserves that work and supersedes the old “no next required batch” handoff for this explicit application request. It does not supersede the completed local MVP checkpoint. wxLambda remains general-purpose: only native wxWidgets controls/methods/properties/ events are binding targets. Parsing, highlighting decisions, paredit, refactoring, language services, document/workspace policy and persistence belong to KryptonEdit. No terminal emulator is planned: wxWidgets has no standard full terminal-emulator control. A terminal requires application-level integration.") (:p "The authoritative scope is the pinned3.2.12 interface inventory and selected native implementations, not declaration totals interpreted as parity percentages. Local macOS SBCL/CCL results do not certify Windows/Linux/Qt or physical IME.") (:heading 2 "Prioritized delivery batches") (:table :header (("Order") ("General native capability") ("Baseline / required dependency")) :rows ((("1") ("wxStyledTextCtrl UTF-8 text/ranges, modification payloads, selection/undo/style/fold/assist APIs") ("Previously unbound; link " (:code "stc") ", require " (:code "wxUSE_STC") ". Container/manual styling must work without a built-in lexer. Native positions are UTF-8 bytes, not Lisp character indices.")) (("2") ("Raw input/command routing") ("Command/notify/close/idle only at baseline; add appropriate raw event classes and immutable fields, preserve native Skip and IME defaults.")) (("3") ("wxAuiNotebook and dynamic splitters") ("Fixed notebook/two-pane splitter only; link " (:code "aui") ", require " (:code "wxUSE_AUI") "; page removal must differ from deletion and reparenting/drag policy must be explicit.")) (("4") ("Tree/list/data-view/grid depth") ("Bounded existing tree/grid; no listctrl/dataview. Native model callback ownership and scalable data are separate focused work.")) (("5") ("Web navigation/HTML/images/drawing") ("Existing audited macOS interactive WebView and private retained renderer; broader native resources and navigation events remain gaps.")) (("6") ("Worker-to-GUI delivery") ("Main-thread deferred actions/timers already exist; they are not a worker API. Bind a checked wxThreadEvent/wxQueueEvent delivery path.")))) (:p "Baseline header mappings: STC0, AUI notebook/manager0, listctrl/dataview0, HTML0, thread0; grid15 partial declarations, WebView12 partial, tree20 partial, splitter18 partial. Existing image2/bitmap4/DC6 partial adapters are private retained-rendering support, not public image/DC resource coverage. These are mapped declarations, not function totals or completion percentages; see the generated inventory for current statuses after each batch.") (:p "The installed local3.2.12 configuration has STC/AUI/HTML/THREADS enabled and their libraries available. New CMake linkage is required where components are selected. ABI57 implements the first three rows in bounded scope; ABI58 adds the selected worker delivery row. See the current delivery record below. Other rows remain pending until separately implemented.") (:heading 2 "Priority input events for KryptonEdit") (:p "Survey target: pinned wxWidgets3.2.12, current bridge at371edbe. This is an implementation recommendation, not a claim that these bindings already exist. The pinned interface sources are " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/event.h" "event.h") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/kbdstate.h" "kbdstate.h") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/mousestate.h" "mousestate.h") " and " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/stc/stc.h" "STC") ".") (:heading 3 "Recommended useful initial surface") (:p "Reuse BIND-EVENT, immutable EVENT snapshots and scoped EVENT-CONTEXT, instead of adding separate per-widget key/mouse callback systems. Bind on WINDOW receivers; do not make parent bindings imply that every raw child input event propagates.") (:table :header (("Native kinds") ("Suggested Lisp kinds") ("Read-only copied payload")) :rows ((("KEY_DOWN, KEY_UP, CHAR, CHAR_HOOK") (":key-down, :key-up, :char, :char-hook") ("native key code, Unicode code point or NIL for WXK_NONE, raw key code/flags, modifiers, auto-repeat, client x/y")) (("LEFT/MIDDLE/RIGHT_DOWN/UP/DCLICK; AUX1/AUX2 variants") (":left-down/:left-up/:left-double-click etc.") ("client x/y, triggering button, current buttons-down, modifiers, native click count")) (("MOTION, ENTER_WINDOW, LEAVE_WINDOW") (":mouse-motion, :mouse-enter, :mouse-leave") ("client x/y, buttons-down, modifiers; dragging derived from native Dragging() or copied explicitly")) (("MOUSEWHEEL") (":mouse-wheel") ("mouse payload plus signed rotation, delta, axis, lines/columns per action, page-scroll, inverted")) (("SET_FOCUS, KILL_FOCUS") (":focus-gained, :focus-lost") ("source bridge identity; optional related registered-window ID only, never raw GetWindow pointer")) (("CONTEXT_MENU") (":context-menu") ("screen coordinates, or explicit NIL for wxDefaultPosition keyboard-origin sentinel")) (("SIZE") (":size") ("copied whole-window width/height, distinct from client extent and DIP conversion")))) (:p "Add ordinary generic event readers, e.g. EVENT-KEY-CODE, EVENT-UNICODE-KEY, EVENT-RAW-KEY-CODE/FLAGS, EVENT-MODIFIERS, EVENT-AUTO-REPEAT-P, EVENT-POSITION, EVENT-MOUSE-BUTTON, EVENT-MOUSE-BUTTONS, EVENT-WHEEL-ROTATION, EVENT-WHEEL-DELTA/AXIS, EVENT-WHEEL-LINES/COLUMNS/PAGE-SCROLL-P/INVERTED-P, EVENT-RELATED-WINDOW-ID and EVENT-SIZE. Exact names can be consolidated before implementation. Fresh tuples/bitfield decoding preserve immutable snapshots. Kind-check readers rather than treating absent data as misleading valid zero. Use numeric native key codes plus a documented bounded keyword mapping for common keys; avoid exposing hundreds of wx constants merely to handle shortcuts. Expose explicit modifier distinctions: native GetModifiers plus CmdDown and RawControlDown semantics differ on macOS. Raw flags are platform-specific.") (:heading 3 "Default input and propagation are correctness requirements") (:p "Current Binding::on_event automatically Skip()s observer callbacks. Preserve this for raw input: observing a key must not disable text entry, accelerators or native selection. Scoped contextual bindings already begin consumed (Skip(false)); this is useful for intentional key interception but must be conspicuous in docs. Consuming KEY_DOWN prevents corresponding CHAR and can suppress accelerators; KEY_UP need not match each repeated KEY_DOWN. Consume only recognized shortcuts, Skip everything else. Prefer translated CHAR for character information and KEY_DOWN for physical/logical shortcut handling; neither is a full text editor.") (:p "CHAR_HOOK uniquely propagates upward before normal key events; consuming it normally suppresses KEY_DOWN/CHAR. A tightly scoped context-only operation for DoAllowNextEvent()/IsNextEventAllowed may be warranted: it can stop ancestor hooks while allowing normal input. Do not overload ordinary Skip with this different native behavior. Ordinary key/mouse/focus/size events are wxEvent subclasses, not command events, and do not generally bubble like button commands. CONTEXT_MENU is wxCommandEvent and has normal command propagation.") (:p "Focus and SIZE handlers should almost always Skip: otherwise native focus behavior or sizer layout can break. Never synchronously refocus from KILL_FOCUS; existing deferred FOCUS-WINDOW operation is appropriate. Preserve existing callback mutation protections. Context menus should use CONTEXT_MENU, not infer platform timing from RIGHT_DOWN/UP: Windows and GTK generate them at different points, and consuming a right-button event can suppress the native context event.") (:heading 3 "Lifetime and bridge integration") (:p "Current native_event_family only handles command/notify/close/idle. Add a truthful base family (:event or named raw families); do not claim raw key/mouse/focus/size events are command events. Update all Lisp family decoding and context readers. Append ABI fields or a bounded copied payload record; update native struct, FFI, snapshot construction, immutable Lisp representation, context getters and ABI version together. Raw accessors must not call command-only GetString/GetInt.") (:p "InputCallbackOperation currently protects selected control-origin events using input_owners and actual/child origins. General raw events must protect the actual source and its ancestors even when the binding is on a propagated parent or a pushed handler. Resolve registered source safely; composite native children must map to their managed owner without publishing borrowed child wrappers. Apply same pending/scheduled/early-teardown suppression as existing input controls. Keep innermost context tokens, original snapshot identity, callback error containment and user-data rooting. Destruction, modal/clipboard entry, focus and nested native pumps remain deferred during raw input. Native size/focus may fire synchronously during creation/layout/destruction: suppress before publication and during base teardown; rollback must remove callback roots.") (:p "Initially keep raw native events nonconstructible/noncloneable, with immutable key/mouse/size/focus payloads. Existing context Skip/propagation operations remain available; no blanket payload SETF gate that accidentally blocks those operations. No raw focus/window pointers or OS event injection. Capture/release mouse, capture-lost and gesture/touch APIs can be a separate coherent followup if a custom-dragging application requires them; don't imply drag tracking continues outside a window without capture.") (:heading 3 "IME boundary") (:p "The pinned generic event surface does not provide a portable composition start/ update/end or marked-text range payload. CHAR Unicode data is not an IME composition API and must not be advertised as one. Dead keys, non-Latin input, emoji/supplementary characters, candidate selection and replacement ranges need native text-control/STC handling. STC has Get/SetIMEInteraction (windowed/inline), but that is a presentation policy, not Lisp composition callbacks. Let STC own native composition; use editor text/modification notifications for committed document state. Automated synthetic key events are insufficient evidence of IME support. Physical macOS IME/dead-key/emoji tests and hosted Windows/GTK IME tests remain explicit unverified targets until performed.") (:heading 3 "Acceptance") (:p "Native fixtures should dispatch actual wxKeyEvent/wxMouseEvent/wxFocusEvent/ wxContextMenuEvent/wxSizeEvent classes through generic bindings to verify copied payloads, no raw pointer exposure, kind errors and context lifetime. Check observer Skip, intentional consume, hook allow-next if exposed, parent command/hook vs nonpropagating raw events, and payload immutability. Test source/ancestor deletion, propagated/pushed bindings, nested native entry, creation/teardown suppression and error unwinding. Add an editor input inspector example showing modifier/key/char, mouse/wheel/focus/size events without consuming native editing. Physical typing, selection, shortcut, wheel, context-menu and IME acceptance stays separate from fixture coverage. Both-Lisp suites, native zero-assertions, examples, factual native coverage and zero-problem docset remain delivery gates.") (:heading 2 "Baseline workspace, navigation, tables, background work and images") (:p "Survey baseline: clean ABI56 checkpoint " (:code "371edbe") ", pinned wxWidgets3.2.12 interface inventory and reviewed " (:code "src/aui/auibook.cpp") " / " (:code "src/generic/splitter.cpp") ". These are general-purpose binding capabilities; document buffers, projects, search indexes, language servers, persistence and editor policy belong in the application.") (:table :header (("Area") ("Existing binding") ("Missing native-facing capability / useful next scope")) :rows ((("Workspace tabs") ((:code "notebook") ": canonical owned PANEL pages, captions, silent/notifying selection and vetoable native page events; safe deferred actions permit AddPage after callbacks return.") ("No insertion, removal/deletion, reordering, close buttons or alternate book. Add a distinct " (:code "aui-notebook") " WINDOW with dynamic owned pages and actual close/change events; do not confuse CLOS ancestry with native wxNotebook.")) (("Split workspace") ((:code "splitter-window") ": two fixed PANEL panes, immutable orientation, sash position/minimum/gravity and guarded sash notifications.") ("No single-pane initialization, unsplit/re-split or replacement. Bounded " (:code "Initialize") ", " (:code "Unsplit") " and " (:code "ReplaceWindow") " adapters can retain hidden removed panes without deleting or reparenting them. No docking manager is needed for a two-pane workspace.")) (("Project tree") ("Single-selection " (:code "tree-control") ", canonical generation-checked item views, copied labels, append/delete/traversal/expand and native selection snapshots.") ("No icons/image lists, lazy expansion notifications, activation/context menu, drag/drop, label editing, hidden-root, multiselect or virtual model. Directory traversal can already use Lisp IO/model code; large/lazy trees need expansion and activation events plus bounded item styling/images. wxQt stays unavailable until raw asynchronous item events are generation safe.")) (("Results list/table") ("Dynamic single-selection unsorted " (:code "list-box") " with append/rename/delete/clear, selection and double-click. " (:code "grid") " has a fixed native-owned string table, copied cell/label text, editing policy and committed-value readback.") ("No multi-column report/virtual list (" (:code "wxListCtrl") "/" (:code "wxListView") "), data view/tree list, grid cell/selection events, dynamic grid shape or custom model ownership. A nonvirtual report-list with copied columns/rows and selection/activation would be a smaller reusable first results-table slice than Lisp virtual-model callbacks.")) (("Background activity") ("Owner-bound deferred UI actions/timers deliver at safe main-thread idle; activity indicator supplies feedback. ABI58 " (:code "queue-thread-event") " copies bounded strings from workers to existing GUI-registered receivers; callbacks run on the GUI thread.") ("No process IO/subprocess abstraction, filesystem watcher or worker scheduler. Other native operations, including " (:code "defer-ui-action") ", timers and " (:code "wake-up-idle") ", retain GUI-thread rules. No arbitrary Lisp object/native pointer transfer; see " (:ref "guide/docs/THREAD-EVENTS.md" "thread events") ".")) (("Images/icons") ("Retained canvas supports copied opaque RGB buffers (each bitmap1..256, total2MiB) and private PNG export; native DC/font/bitmap/image resources remain hidden.") ("No image file decode, alpha, scaling, standalone image/bitmap resource, static-bitmap widget, image lists, toolbar/tree/tab icons or DPI bitmap bundles. Introduce copied RGBA image values and a small native display/icon adapter only when selected; avoid raw resource adoption/global handler mutation. Decode failures, byte/pixel limits, alpha/scale/DPI and disposal need explicit contracts.")))) (:p "Dependencies and platform boundaries: current CMake links core/base/adv/webview; " (:code "wxAuiNotebook") " additionally requires the " (:code "aui") " component and " (:code "wxUSE_AUI=1") " (" (:code "wxUSE_AUI=1") " is present locally but linking is not selected). List/report and data view controls require " (:code "wxUSE_LISTCTRL") " / " (:code "wxUSE_DATAVIEWCTRL") "; both are enabled in the installed build but unbound. Images already have IMAGE/LIBPNG prerequisites; new formats/handlers and bitmap bundles need selected feature checks, not a claim of blanket image parity. File watchers require " (:code "wxUSE_FSWATCHER") " and copied platform-dependent event semantics. Local feature availability does not establish hosted GTK/MSW correctness. Existing WebView remains specifically gated to verified macOS3.2.12 WKWebView; it does not supply cross-thread UI or workspace ownership.") (:heading 3 "Original dynamic-tab proposal (superseded by ABI57 scope)") (:list (:item (:p "Add native-backed " (:code "aui-notebook") " as a separate WINDOW class with validated"))) (:p (:code ":parent") "/" (:code ":class") " construction, subclass/default initargs and managed rollback. Reuse existing notebook generics where their semantics truly match: page count, page lookup, caption and " (:code "selection") ". Accept owned PANEL pages initially so any editor/control can be composed inside a page without an editor abstraction.") (:list (:item (:p "Add guarded append/insert/delete plus page-to-current-index lookup. Require"))) (:p "native parent==book, no sizer/membership and fully completed page initialization. Root canonical wrappers before native publication, retain membership by window identity across reorder, and invalidate on actual native destruction. Resolve a retained page identity at deferred delivery; indices are not durable IDs. Defer remove-without-delete/reparent transfer until ownership semantics are deliberately chosen; native RemovePage leaves the page alive and parented.") (:list (:item (:p "Choose explicit initial styles: top tabs, scrolling, same-book tab move and"))) (:p "active-tab close. Disable external transfer and internal tab splitting first; default native styles enable more behavior than this contract. Do not expose raw art providers, tab controls, AUI manager/perspective resources or arbitrary flags. Programmatic page deletion does not inherently run the user-close veto path; its API must say so or deliberately implement a separate close request.") (:list (:item (:p "Bind actual " (:code "wxAuiNotebookEvent") " page-changing/changed and page-close request."))) (:p "Changing/close veto is scoped to its native event; a modal confirmation must first veto and schedule an owner-bound action. Native close later deletes the page. Guard the originating book, affected pages and ancestors throughout native operations and actual/propagated callbacks, including private tab-child origins. Reject callback structural mutation, same-book selection recursion, destructive close/reentry and owned/synthetic/cloned AUI events. Capture a stable target before deferral; native PAGE_CLOSED reports an old index after deletion, so it cannot be treated as a live current-page lookup. Omit that public event initially unless its removed-page identity contract is explicit.") (:list (:item (:p "Audit internal manager/tab handlers before allowing managed handler-stack edits;"))) (:p "default to rejecting them. Test native UI close/veto, reorder, selection, last-page deletion, callback failure, constructor failure, stale wrappers, ancestor teardown and zero native assertions. Add a general dynamic-workspace example with arbitrary panel content; include SBCL/CCL, coverage and docset.") (:p "For the matching splitter extension, retain the current immutable orientation and positive minimum size. Add a safe single-pane initializer, explicit unsplit and replacement with canonical pane identity. Removed/replaced panes remain hidden, alive and native children of the splitter until explicitly reused/destroyed; they are no longer attached members. Validate distinct initialized same-parent panels, prepublish new roots, and protect old/new panes plus ancestors across synchronous sizing/focus callbacks. Native ReplaceWindow does not destroy " (:b "or automatically hide") " the old pane; the bridge must specify and perform hiding. Unsplit hides its removed pane by default and need not emit the same notification path as a native sash-triggered unsplit. Treat interactive unsplitting and dynamic orientation as later scope. This should remain a reusable window operation, not an editor layout or document lifecycle API.") (:p "Pinned references: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/aui/auibook.h" "AUI notebook interface") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/aui/auibook.cpp" "AUI implementation") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/splitter.h" "splitter interface") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/generic/splitter.cpp" "splitter implementation") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/listctrl.h" "list controls") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/dataview.h" "data views") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/image.h" "images") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/fswatcher.h" "filesystem watcher") ".") (:heading 2 "Current delivery: ABI57–ABI61 selected native bindings") (:p "Implemented: native-backed styled text with UTF-8 byte ranges, modification metadata, multiple/rectangular selection, undo/save points, application styling, indicators/margins/markers/folding, coordinate conversion, scrolling, completion and call tips; copied STC events. Native key/character/mouse/wheel/focus/context/ size events expose scoped Skip/propagation and CHAR_HOOK AllowNextKeyEvent. AUI tabs support insert/remove/delete/move and programmatic splitting; splitters support initialize/unsplit/replacement/resplit and mutable orientation. See " (:ref "guide/docs/STYLED-TEXT.md" "styled text") ", " (:ref "guide/docs/INPUT-EVENTS.md" "input") ", " (:ref "guide/docs/AUI-NOTEBOOK.md" "AUI") " and " (:ref "guide/docs/SPLITTER.md" "splitters") " for exact contracts.") (:p "Unlike the baseline proposal, removal without deletion and PAGE_CLOSED are bound with explicit stable identities and cache cleanup. Programmatic AUI splitting is supported; physical tab splitting and external transfer remain disabled. Physical tab rearrangement is restricted to one private tab group because pinned native code mixes local/global indices across groups. Private tab-ID allocation is bounded to501 groups per book lifetime. The current guides supersede baseline recommendations above. No exhaustive native parity is implied.") (:p "Final91-scenario GUI suites plus preflight pass on both SBCL and CCL, alongside native fixtures, isolated package checks and the661-entry docset. Evidence is local macOS wxWidgets3.2.12; physical keyboard/IME/drag/accessibility and other ports remain unverified. These are binding and automated acceptance results, not a claim of every native argument combination or physical input fidelity.") (:p "ABI59 adds native report LIST-CONTROL with stored rows or a copied synchronous OnGetItemText provider, selection/activation/context/cache notifications, and tree activation/context/expansion events plus bold/color/expander decorations. Virtual providers run as guarded pure queries with explicit supported container ancestry; see " (:ref "guide/docs/REPORT-TREE-VIEWS.md" "report/tree views") ". wxDataViewCtrl and custom native model ownership remain unbound; virtual wxListCtrl supplies the selected scalable results-table path.") (:p "ABI60 adds session-owned wxImage/wxBitmap, native static bitmap display, copied RGB/alpha/pixel access, PNG loading/saving, scaling and native display/coordinate queries. Bitmap backing pixels, logical units, DIP and scale remain distinct. The retained wxDC renderer accepts copied RGBA images. No image-grid/flame-graph application model is provided. See " (:ref "guide/docs/IMAGES-DISPLAYS.md" "images/displays") " and " (:ref "guide/docs/DRAWING-CANVAS.md" "drawing") ". PNG-only file loading and resource/scene bounds are explicit supported scope; physical color fidelity, hotplug and other ports are unverified.") (:p "ABI58 adds " (:code "queue-thread-event") " and native " (:code ":thread") " delivery through existing EVENT-HANDLER receivers. Registration/binding stays on the GUI thread; workers copy only bounded UTF-8 payloads through a separately synchronized native endpoint. Receiver retirement, pending-event deletion and shutdown serialize against posts; callbacks stay on the GUI thread. Focused both-Lisp worker tests and native race fixtures pass. See " (:ref "guide/docs/THREAD-EVENTS.md" "thread events") " for exact limits and evidence in the implementation handoff; this is not a worker scheduler or editor job API.") (:p "ABI61 completes the selected GRID depth: native cell/selection/range/editor/click events with copied proposed/old/current values, scoped validation veto, per-cell read-only/color attributes and dynamic native string-table dimensions (axes0..256 after deletion, at most16384 cells). Save, Hide, Disable and current-editor Reset retain native semantics; Hide can cause a deferred commit and Reset is not a transaction rollback. See " (:ref "guide/docs/GRID-EDITING.md" "grid editing") " and " (:ref "guide/docs/GRID-EDITOR-AUDIT.md" "the pinned editor audit") ". Custom models/editors remain unbound.") (:p (:b "The primary selected binding goal is complete within this documented scope.") " KryptonEdit application integration is the next step; no additional broad binding batch is required. Add further native capabilities only for a concrete application need. The survey-only candidates and verification limits below remain explicit.") (:heading 2 "Docking and lightweight HTML survey") (:p (:code "wxAuiManager") " remains unbound. Pinned3.2.12 provides AddPane/InsertPane/DetachPane, wxAuiPaneInfo descriptions, Update, pane events and SavePerspective/LoadPerspective. A reusable binding needs managed manager/window lifetimes, explicit UnInit before managed-window destruction, canonical pane ownership and floating-frame teardown, scoped pane-close veto and guarded layout updates. DetachPane is distinct from window destruction. Perspectives are opaque native strings tied to pane names; KryptonEdit owns naming, storage and restore policy. It requires AUI, already linked for notebook support; macOS floating panes and hosted-port layout behavior need separate evidence. It is surveyed, not implemented by the notebook slice.") (:p (:code "wxHtmlWindow") " remains unbound. SetPage/AppendToPage, LoadPage/LoadFile, history, opened-page/title and link events provide lightweight rendered documentation. It uses wxHTML and wxFileSystem resource loading, without WebView JavaScript or modern browser rendering. A future binding must specify resource URL policy, copied link payloads, OnOpeningURL/OnLinkClicked callback scope and filesystem ownership. The installed HTML component is available but not currently linked by this bridge.") (:p "Interactive WebView is already implemented within the audited macOS3.2.12 WKWebView gate. LOADED/error/script-message and copied asynchronous script results do not supply complete navigation policy. NAVIGATING cancellation, NAVIGATED/title/new-window events, redirect/navigation cancellation and unsupported platforms need separate source/lifetime audits. Basic CanGoBack/Forward and GoBack/Forward are already bound; richer history metadata/policy remain future scope; native LOADED is not application readiness. Existing platform constraints remain in " (:ref "guide/docs/WEB-VIEW.md" "WebView") ".") (:p "Pinned references: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/aui/framemanager.h" "AUI manager") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/html/htmlwin.h" "HTML window") ".") (:heading 2 "Audited grid editing and owned table changes") (:p "ABI61 adds " (:ref "guide/docs/GRID-EDITING.md" "native grid editing") ": selected native notify events, scoped validation, cursor/block selection requests, per-cell read-only/colour attributes and bounded append/insert/delete of owned string-table axes. Native Save/Hide/Disable/Reset semantics remain distinct; no invented cancellation or transaction guarantee, custom model/editor ownership or full native parity is claimed. Empty axes are supported after dimension edits. This closes the selected bounded grid binding dependency; application integration and unverified physical interaction/IME/accessibility/other-port behavior remain separate."))))
(:entry "guide/docs/LIST-BOX.md" :names ("docs/LIST-BOX.md") :kind :guide :kind-name "Guide" :summary "docs/LIST-BOX.md" :sections (("Guide" (:heading 1 "Single-selection list boxes") (:p "ABI38 adds " (:code "list-box") ", an unsorted native list with at most one selected row:") (:code-block "lisp" "(wxlambda:make-list-box parent :items '(\"Ada\" \"Grace λ\" \"日本語 😀\") :selection 1)
(make-instance 'wxlambda:list-box :parent parent :items '(\"\" \"duplicate\" \"duplicate\"))") (:p "The parent is required. Items default to an empty finite proper list of strings; selection defaults NIL (none). Empty strings and duplicates are accepted. Strings cross an explicit-length UTF-8 boundary and reject NUL. A selected index must exist. The thin generic factory validates " (:code ":class") " and forwards subclass slots/initargs. Native-backed direct construction, default initargs, native properties in AFTER hooks and failed-initialization cleanup follow the " (:ref "guide/docs/CLOS-API.md" "CLOS API") ". No sorting, multi/extended selection, checkboxes, owner drawing, virtual models, item client data or arbitrary style flags are exposed in this slice.") (:heading 2 "Items and selection") (:code-block "lisp" "(wxlambda:item-count control)
(wxlambda:item-text control 0)            ; independent string
(setf (wxlambda:item-text control 0) \"Ada λ\") ; returns supplied string
(wxlambda:append-item control \"Another\")  ; appended zero-based index
(wxlambda:delete-item control 0)          ; T
(wxlambda:clear-items control)           ; T
(wxlambda:selection control)             ; index or NIL
(setf (wxlambda:selection control) nil)   ; silent deselection
(setf (wxlambda:selection control :notify t) 0)") (:p "Item operations currently specialize on LIST-BOX only; no receiver fallbacks or CHOICE expansion is added. All operations require an active main-thread session and valid native receiver. Indices are signed-int nonnegative integers within current count; invalid indices signal instead of native clamping. Setf selection also accepts NIL to clear. Native failures signal " (:code "native-error") "; Lisp dispatch/ type errors remain Lisp conditions. Native failures are not transactional rollback of earlier side effects.") (:p "Append preserves selection and returns its new index. Rename preserves the selected index. Delete clears selection when deleting that row; deleting an earlier row shifts the selected index down one, preserving the same item. Clear leaves no items or selection. These item mutations and default selection SETF suppress selection events. They are allowed from list callbacks; a temporary native event blocker restores any managed pushed-handler stack before returning. " (:code ":notify t") " selection SETF changes the model then emits one synthetic native selection event, including unchanged assignments and NIL. It returns the supplied index/NIL. A callback error can escape after the selection changed; handled errors permit subsequent use.") (:p "Indices describe current order, not durable identities. Saved indices/snapshots can refer to different rows after edits. Keep stable IDs and domain data in Lisp models when needed; strings, duplicates and native item positions are not an ID system. Native display, scrolling and keyboard behavior remain port-specific.") (:heading 2 "Selection and activation events") (:p (:code "on-selection") "/" (:code "off-selection") " specialize on LIST-BOX for one replaceable convenience observer. It receives " (:code ":listbox-selection") ", distinct from CHOICE's " (:code ":selection") ". Generic " (:code "bind-event") " supports both " (:code ":listbox-selection") " and " (:code ":listbox-double-click") " (including native keyboard activation when the port emits it):") (:code-block "lisp" "(wxlambda:bind-event control :listbox-double-click
  (lambda (event)
    (format t \"Activated index ~S, text ~S~%\"
            (wxlambda:event-selection event) (wxlambda:event-text event))))") (:p "Both are command events with copied string/index payloads, origin metadata, propagation and per-binding Lisp data. " (:code "event-selection") " is index/NIL; " (:code "event-text") " is the native event's cached label (empty for a synthetic NIL selection). Current widget state may already differ after a preceding callback edits items. Observers Skip automatically; contextual callbacks explicitly control Skip. Snapshots remain immutable. Context/owned " (:code "event-selection") " and " (:code "event-text") " writes change event payload only, not the list model. Raw " (:code "event-selection-p") "/extra-LONG action metadata is independent of the index after metadata mutation; bridge-generated list events initialize it from whether a selection was supplied. It is not a veto protocol.") (:p "Unlike notebook derived events, these simple wxCommandEvent kinds support owned construction, cloning, queue/process/post/transfer and standalone/non-list receivers. Synthetic events never change list items/selection automatically. " (:code ":text") " and " (:code ":selection") " are accepted for these kinds. Native actual selection/double-click callbacks protect the originating list and its ancestors, including propagated and convenience callbacks. Direct window destruction/close and synchronous modal or clipboard entry are rejected until callbacks return; defer those actions to later application work. Item mutations and nested selection are allowed. Native callbacks from deleting origins are suppressed. This prevents a nested native loop from pumping deletion while the port's activation stack still uses the widget.") (:heading 2 "Example and checks") (:p (:code "examples/list-manager.lisp") " wires a list, edit field and Append/Rename/Delete/Clear buttons, plus selection and activation feedback. START is interactive; bounded EXERCISE verifies real native item/selection behavior without physical input:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/list-manager.lisp --eval '(wxlambda-list-manager:start)'
sbcl --load ~/quicklisp/setup.lisp --load examples/list-manager.lisp --eval '(wxlambda:with-application () (wxlambda-list-manager:exercise))'") (:p "Lisp tests cover direct/factory subclasses/defaults/AFTER hooks/rollback, Unicode, empty/duplicate strings, copied storage, deterministic selection adjustment, silent edits, managed handler stacks, context edits/snapshots, detached/synthetic events and callback errors. The native harness dispatches actual list events outside the setter through generic, propagated and convenience callbacks, probing lifetime/native-loop guards and item mutation. Raw invalid UTF-8/NUL/arrays/indices/pointers and stale or wrong receivers reject without wx assertions. Physical mouse/keyboard activation, scrolling/accessibility, hosted Windows/Linux and a complete tree/list-manager app remain separate checks. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") ", " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/MENUS.md" :names ("docs/MENUS.md" "MENUS") :kind :guide :kind-name "Guide" :summary "docs/MENUS.md" :sections (("Guide" (:heading 1 "Frame menus and command actions") (:p "ABI 32 adds a bounded native menu hierarchy: MENU-RESOURCE is abstract, with MENU-BAR, MENU and MENU-ITEM concrete classes. A frame owns one managed menu bar, which owns its menus and items. This delivers the menus/actions part of the selected GUI slice. " (:ref "guide/docs/STANDARD-DIALOGS.md" "Modal text/single-choice dialogs") " extend the workflow in a separate bounded interface; they are not menu resources. The baseline is wxWidgets 3.2.12.") (:heading 2 "Construct and route an action") (:code-block "lisp" "(let* ((bar (wxlambda:make-menu-bar frame))
       (file (wxlambda:make-menu bar :label \"&File\"))
       (open (wxlambda:make-menu-item file :id 1001 :label \"&Open\"))
       (option (wxlambda:make-menu-item file :id 1002 :kind :check
                                      :label \"Show &details\")))
  (wxlambda:bind-event frame :menu
    (lambda (snapshot)
      (format t \"Action ~D checked ~S~%\"
              (wxlambda:event-id snapshot)
              (wxlambda:event-checked-p snapshot)))
    :id 1001 :last-id 1002)
  (setf (wxlambda:checked-p option) t)
  (wxlambda:activate-menu-item open))") (:p "Generic BIND-EVENT observes :MENU command events on the frame, with existing ID or ID-range filtering, observer ordering, per-binding :USER-DATA, immutable snapshots and optional scoped :WITH-CONTEXT T control. Menu resources are not event-handler receivers. Raw EVENT-INTEGER and the kind-specific checked view are command metadata, not a resource lookup or an implicit resource-state writer. Changing event fields does not synchronize the MENU-ITEM object. EVENT-ORIGIN-ID is the tracked native origin when known, which can differ from the frame binding receiver EVENT-SOURCE; it is not a portable promise about OS-generated origins. Native/user handlers later in a dispatch can still react to those fields.") (:p "ACTIVATE-MENU-ITEM invokes native frame command processing for a managed item. A disabled item returns NIL and does not dispatch; separators reject. The result is the native handled boolean, not a graphical OS-menu interaction guarantee. Native check-item activation toggles the actual resource before callbacks. A normal-menu command can carry native integer -1, so its raw EVENT-CHECKED-P can be true even though it is not a check item. Use CHECKED-P on a known check resource for its actual state. Programmatic commands and actual user selection need separate verification.") (:heading 2 "Resources, CLOS and ownership") (:p "Direct constructors use :PARENT for the frame/bar/menu respectively. MAKE-MENU-BAR, MAKE-MENU and MAKE-MENU-ITEM are generic thin factories with validated :CLASS subclass support. Direct MAKE-INSTANCE, subclass slot initargs, :DEFAULT-INITARGS and subclass AFTER hooks use the same native-backed protocol. Native properties exist before a subclass AFTER hook runs. Abstract construction, invalid parents and mixed managed ancestry reject. Initialization failure cleans newly allocated resources and descendants; it does not undo arbitrary external mutations performed by user initialization hooks.") (:p "Ownership is native frame → bar → menus → items. Lisp wrappers do not own a second native allocation, and Lisp GC does not delete resources. Explicit DESTROY-MENU-RESOURCE removes/deletes through the owner and invalidates all managed descendants. Frame native destruction cleans its remaining menu tree, including when ordinary event processing is disabled or a destroy observer does not propagate. MENU-RESOURCE-ALIVE-P queries tracked identity within the active session; saved wrappers do not extend native lifetime. Deleting one item leaves its surviving siblings intact. Only one managed bar is allowed on a frame.") (:p "Construction, attachment and destruction are structural operations and reject inside callbacks, pumps and RUN. Reading scalar properties and changing labels, enabled flags or check state are allowed during callbacks. All native operations require the active GUI session on its main thread. No raw native adoption, reparenting, pop-up menus, submenus, radio groups or detach-and-reattach ownership protocol is supplied in this slice.") (:heading 2 "Labels, IDs and resource state") (:p "MENU-LABEL reads/writes a menu's raw bar-tab label. LABEL-TEXT reads/writes a item's raw label, including native mnemonic/accelerator syntax; it does not strip that syntax into display text. Separator label reads are empty, and all separator label writes reject. Constructor labels and help are Unicode strings without NUL. Normal/check and tab labels must be nonempty. :HELP is construction-only. MENU-COUNT and MENU-ITEM-COUNT return native counts; item counts include separators.") (:p "MENU-ITEM-ID and MENU-ITEM-KIND are immutable. Normal/check IDs are integers from 1 through 2147483647, unique across the managed bar. Kinds are :NORMAL (default), :CHECK or :SEPARATOR. Separators require :ID NIL and empty label/help; use MAKE-MENU-ITEM with :KIND :SEPARATOR. Explicit :ENABLED-P or :CHECKED-P on a separator rejects even NIL. Normal items permit NIL checked state but reject a non-NIL initial check. These are not arbitrary native stock-ID, radio, submenu or menu-item adoption interfaces.") (:p "CHECKED-P is supported only for check menu items. Its SETF writer normalizes a generalized boolean and returns the supplied value; reads return T/NIL. :NOTIFY T rejects before mutation. Reads ignore :NOTIFY as in the checkbox protocol. ENABLED-P returns the item's own native flag; its SETF returns the supplied value and a second boolean indicating change. Separators reject both enabled-state reads and writes. Resource scalar writes are silent: use native command activation to exercise routing, rather than assuming a property setter sends a command.") (:heading 2 "Example and verification scope") (:p (:ref "example/examples/menus.lisp" "The menu example") " provides WXLAMBDA-MENUS:EXERCISE within an active session for programmatic construction, property updates, command routing and cleanup:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/menus.lisp \\
  --eval '(wxlambda-menus:start)'") (:p "START opens the managed session and runs the programmatic exercise. CCL can use the same load/eval arguments. Final local regression, independent review, packaging and docset evidence is recorded in the current " (:ref "guide/IMPLEMENTATION.md" "handoff") ". Graphical menu selection, keyboard accelerators, platform menu conventions and hosted Linux/Windows GUI behavior require their own evidence. The native inventory remains partial and records additional menu APIs without making all of them release prerequisites. Continue the representative form/editor workflow through the bounded " (:ref "guide/docs/STANDARD-DIALOGS.md" "standard-dialog interface") "; message/file families still need safe platform cancellation.") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/MESSAGE-FILE-DIALOGS.md" :names ("docs/MESSAGE-FILE-DIALOGS.md" "MESSAGE-FILE-DIALOGS") :kind :guide :kind-name "Guide" :summary "docs/MESSAGE-FILE-DIALOGS.md" :sections (("Guide" (:heading 1 "Generic message and single-file dialogs") (:p "ABI 34 adds MESSAGE-DIALOG and FILE-DIALOG using " (:b "wxGenericMessageDialog and wxGenericFileDialog") ": native wxWidgets GUI controls with a guarded modal bridge. The choice is explicit in this API's scope; there is no :BACKEND argument. Platform-native alerts/file panels, including macOS NSAlert/NSPanel, remain unbound after their cancellation probe hung. This generic implementation does not claim native OS-dialog parity. The baseline is wxWidgets 3.2.12.") (:p "Both classes inherit DIALOG/WINDOW and the " (:ref "guide/docs/STANDARD-DIALOGS.md" "modal lifetime protocol") ". Keyword-only MAKE-MESSAGE-DIALOG/MAKE-FILE-DIALOG are thin ordinary factories with validated :CLASS. Direct construction, subclass slots/defaults/AFTER hooks, rollback and optional parent normalization work like the earlier dialog families. A requested hidden parent remains the actual native parent; NIL is truly parentless. Construction is allowed on the GUI thread in callbacks/RUN/pumps. Receiver/ancestor pending and scheduled deletion rejects before modal entry. Strings must be Unicode without NUL; stale handles and wrong native state reject.") (:heading 2 "Message body, buttons and results") (:code-block "lisp" "(let ((dialog (wxlambda:make-message-dialog
               :parent frame :title \"Unsaved changes\"
               :message \"Save this document?\" :buttons :yes-no-cancel
               :icon :question)))
  (unwind-protect
       (case (wxlambda:show-modal dialog)
         (:yes (save-document))
         (:no (discard-edits))
         (:cancel nil))
    (wxlambda:destroy-window dialog)))") (:p ":BUTTONS is :OK (default), :OK-CANCEL, :YES-NO or :YES-NO-CANCEL. :ICON is :NONE, :INFORMATION (default), :WARNING, :ERROR or :QUESTION. DIALOG-MESSAGE reads the fixed message body and MESSAGE-DIALOG-BUTTONS reads the offered button set. DIALOG-TITLE remains separately mutable; message body/buttons/icon have no writers in this slice.") (:p "SHOW-MODAL can return :YES/:NO for a message dialog offering those buttons, in addition to :OK/:CANCEL where applicable. END-MODAL validates requested results against the dialog's offered buttons; :CANCEL is always available as a safe completion/unwind result, including a dialog without a visible Cancel button. The operation remains raw native result assignment, not a simulated button click.") (:heading 2 "Configure one file selection") (:code-block "lisp" "(let ((dialog (wxlambda:make-file-dialog
               :parent frame :mode :open :title \"Open Lisp source\"
               :wildcard \"Lisp files|*.lisp|All files|*\" :filter-index 0)))
  (unwind-protect
       (when (eq :ok (wxlambda:show-modal dialog))
         (open-document (wxlambda:file-dialog-path dialog)))
    (wxlambda:destroy-window dialog)))") (:p ":MODE is :OPEN (default) or :SAVE, readable through FILE-DIALOG-MODE. The default title is \"Open file\" or \"Save file\" according to mode. :DIRECTORY and :FILENAME default to empty strings; an empty directory lets native code use the current directory. A supplied directory must exist. :DIRECTORY and optional :PATH accept strings or pathnames, converted through native namestring; :FILENAME is a string. A supplied path must be nonempty and its directory, when present, must exist. The wrapper does not request wxFD_CHANGE_DIR.") (:p ":MUST-EXIST defaults true for open and NIL for save. :OVERWRITE-PROMPT defaults true for save and NIL for open. True :MUST-EXIST is rejected for save; true :OVERWRITE-PROMPT is rejected for open. These configure actual native OK-button behavior. END-MODAL :OK does " (:b "not") " enforce existence/overwrite checks, validation or data transfer. A programmatically assigned success result is not evidence of accepted file selection. Application code should still handle its own subsequent IO errors.") (:p ":WILDCARD defaults to \"All files|*\" and requires nonempty description/pattern pairs, such as \"Lisp files|*.lisp|All files|*\". :FILTER-INDEX defaults zero and must identify a pair. FILE-DIALOG-FILTER-INDEX reads/writes that zero-based index; no wildcard/item-list mutation API is supplied.") (:p "FILE-DIALOG-PATH reads the current native path as a string. Its SETF accepts a nonempty string/pathname and returns the original supplied value; the getter can return a native-normalized string. Current path is not an accepted-result flag. The file dialog selects one file; multiselect, external/custom controls and raw native panel adoption remain outside this scope.") (:p "The wrapper does not read or write selected file contents. Native browser actions can have filesystem effects: for example, New Directory can create a directory immediately. Do not interpret a picker as guaranteeing zero filesystem changes, or assume Cancel reverses a browser action. Configured existence checks happen through actual UI acceptance; neither constructing a path nor reading one proves that its target exists or will remain accessible.") (:heading 2 "Internal prompts and safe cancellation") (:p "The generic file UI can open internal message prompts, for example during native overwrite/validation/browser actions. The bridge redirects those prompts to the generic message implementation and tracks their modal depth. Borrowed contexts are suspended across each internal modal boundary. These are bridge-controlled native prompts; nested " (:b "public") " SHOW-MODAL calls remain forbidden.") (:p "A callback error at a newly entered native modal boundary cancels the whole workflow and re-signals the primary Lisp condition after unwind. Internal prompts are ended before the outer dialog, sequentially; public END-MODAL cancellation uses the same order. While an internal prompt is active, a public request to successfully end the outer dialog (:OK/:YES/:NO) rejects. Only public :CANCEL requests whole-workflow unwind. Ordinary user Cancel on an inner prompt returns normally to the outer dialog. A notifying operation whose error is handled locally at the same modal depth can recover without cancelling the workflow. Until a captured callback condition reaches its Lisp boundary, a private error handoff latch prevents native code from opening another prompt with callbacks suppressed. The latch clears before the primary condition is re-signaled, so handled errors can resume normal prompting. SHOW-MODAL and construction drain a pending primary condition before opening UI or allocating a new dialog. This is an internal safety protocol, not a public FFI or error-state API. Property calls that trigger native internal prompts use this protection too. Cancellation requested before modal-loop entry is remembered rather than opening a stranded loop.") (:p "Current-dialog close cancels; ancestor close is consumed, and explicit ancestor/dialog destruction remains blocked until the outer SHOW-MODAL returns. Manual pumps/RUN/finish and structural menu edits remain guarded. Use ordinary UNWIND-PROTECT cleanup after modal return. No worker-thread modal dispatch, platform-native cancellation backend or native Lisp virtual override is added.") (:heading 2 "Example, implementation dependencies and next workflow") (:p (:ref "example/examples/message-file-dialogs.lisp" "message-file-dialogs.lisp") " supplies WXLAMBDA-MESSAGE-FILE-DIALOGS:EXERCISE inside an active GUI session. It checks message buttons/file mode and cancels actual generic message/file modal loops from native idle, including a message without a visible Cancel button:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/message-file-dialogs.lisp \\
  --eval '(wxlambda:with-application () (wxlambda-message-file-dialogs:exercise))'") (:p "START is interactive: it asks whether to choose a file, then prints an accepted selection; it does not read the selected contents. Replace the eval expression with " (:code "(wxlambda-message-file-dialogs:start)") " for that manual workflow. The current " (:ref "guide/IMPLEMENTATION.md" "handoff") " records exact automated/manual evidence and gaps. Final regression, package and installed-docset checks remain batch-specific.") (:p "The bridge depends on generic wxWidgets implementation headers and the generic internal-message hook. It preserves the requested file save/overwrite style flags when generic wxDialog style normalization overlaps them on macOS. These bounded implementation dependencies do not expose a public raw style or hook interface. The public source inventory maps the supported inherited/equivalent message/file surface partially; generic implementation classes absent from the pinned public interface are not invented as fully covered declarations.") (:p "Next compose a form/editor open/save workflow with menus and these dialogs, keeping file-content IO and the document model Lisp-native. Graphical platform conventions, actual user acceptance, overwrite/browser operations and hosted Linux/Windows behavior require their own evidence. The earlier native OS probe remains an explicit gap rather than a claim that every standard dialog is done.") (:p "ABI43 " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") " provide safe FIFO work after callbacks, including modal/clipboard/destructive requests. Existing nested event callback guards still apply; pending-only dispatch does not run the action queue.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes these APIs with deferred shared Open/Save/Copy/Paste/close requests, toolbar/keyboard entry points and status feedback. Its coalescing and scoped close-replay policy are application logic; no extra public binding or native parity claim is introduced."))))
(:entry "guide/docs/MVP-ACCEPTANCE.md" :names ("docs/MVP-ACCEPTANCE.md" "MVP-ACCEPTANCE") :kind :guide :kind-name "Guide" :summary "docs/MVP-ACCEPTANCE.md" :sections (("Guide" (:heading 1 "Finite primary-goal acceptance") (:p "The primary goal is a useful Common Lisp GUI foundation with broad everyday coverage and selective depth. It is not exhaustive wxWidgets parity. This report sets a finite completion checkpoint so repeated requests for another batch do not silently become a requirement to bind the entire native inventory.") (:p "The declared target is the automated local Apple Silicon macOS MVP using wxWidgets3.2.12, SBCL and CCL. Completion requires all rows below and the shared reliability/documentation/package gates. " (:b "Primary automated local macOS MVP goal reached on 2026-10-29.") " All declared workflow, reliability, documentation, inventory and package gates passed.") (:table :header (("Workflow") ("Bounded acceptance")) :rows ((("Form/editor") ("Persistent document form with cancellation/failed-save close protection, dirty baseline, UTF-8 IO, menus/toolbars/status/shortcuts, deferred dialogs and clipboard adapters; native multiline editing and everyday controls have independent coverage.")) (("Tree/list manager") ("Cohesive record manager: stable IDs, tree category selection, search filtering, list selection, notebook details, shared menu/tool/keyboard CRUD and copy actions, injected deterministic prompt/confirmation/clipboard paths, pending-action disposal and stale-target tests.")) (("Drawing/monitoring") ("Retained geometry/text/font/colour/RGB bitmap rendering, PNG pixel verification, native resize/DIP conversion, activity feedback, real owner-bound timer updates, deferred Pause/Resume and teardown.")) (("Reliability") ("Main-thread/native-entry rules, CLOS construction rollback, checked lifetimes, immutable snapshots/context isolation, error/commit semantics, native zero-assertion harness and both-Lisp full GUI suites.")) (("Deliverables") ("Standalone docs/examples, factual pinned native coverage, all public exports indexed in the Cadre-format docset, zero docset checker/link/discovery/lookup problems and relocated package smoke tests.")))) (:heading 2 "Boundaries") (:p "A completed checkpoint does not claim full native class parity, every desktop platform, or production validation of every physical interaction. Hosted Windows/Linux/Qt, native input/IME/accessibility, exhaustive locale/font/DPI combinations, external clipboard interoperability and graphical Cadre remain unverified. The existing wxQt tree gate remains in force. Native OS message/file dialogs, raw ownership adoption and broad virtual overrides remain unbound.") (:p "Specialized grid/data-view, rich text, AUI/ribbon, web/media/OpenGL, printing, additional drawing backends and unneeded overloads are on-demand/deferred under the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "feature policy") ". They are not automatic blockers for this checkpoint. The native inventory keeps their true pending/partial states.") (:p "The primary automated local macOS MVP goal has been reached. There is no next mandatory widget batch. Further work should be driven by a concrete application, a requested platform/manual validation target or an explicitly chosen extension.") (:heading 2 "Evidence") (:p "Local final evidence, 2026-10-29:") (:list (:item (:p "ABI55 main/native builds passed; native combined regression reported zero wx"))) (:p "assertions and checked exact PNG geometry/bitmap pixels (quiet-run.51d4fRNq, quiet-run.hDxZV5Dn). Final monitor PNG was visually inspected.") (:list (:item (:p "Full82 GUI scenarios plus preflight passed on SBCL2.6.9 and CCL1.13:"))) (:p (:code "evidence/mvp/{sbcl,ccl}-20261029/") " (quiet-run.ZeZLFmJK/89VRCUnf).") (:list (:item (:p "All five relocated package isolation checks passed, including new canvas PNG"))) (:p "and activity smoke checks: " (:code "evidence/packaging/mvp-20261029/") " (quiet-run.3sDyUEjf/tYx5iZ0g).") (:list (:item (:p "The docset contains392 entries:278 public exports,56 examples and58 project"))) (:p "guides. Build/check reports zero problems; both-Lisp actual class/SETF/export coverage and isolated install/discovery/symbol/guide/example reading passed (quiet-run.w2lndltK/6KS7vQ0h). Final regenerated inventory is included.") (:list (:item (:p "All16 Python runner/documentation checks passed. Pinned native inventory"))) (:p "regeneration and all14 consistency checks passed (quiet-run.BY4cUhyv/yMEP7cuM).") (:list (:item (:p "Two independent subagents reviewed implementation, workflow, documentation,"))) (:p "metadata and package integration; actionable findings were resolved.") (:p "Normal Cadre installation uses " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). The verified isolated install is under " (:code "/private/tmp/wxlambda-mvp-docsets/wxlambda/") ". Graphical Cadre itself was not exercised. See " (:ref "guide/docs/DOCSET.md" "docset installation") ", " (:ref "guide/docs/RECORD-MANAGER.md" "record manager") ", " (:ref "guide/docs/DRAWING-CANVAS.md" "drawing canvas") ", " (:ref "guide/docs/ACTIVITY-INDICATORS.md" "activity indicators") " and " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent form") ".") (:heading 2 "Requested extensions after acceptance") (:p "ABI56 adds " (:ref "guide/docs/GRID.md" "grid") " and an " (:ref "guide/docs/WEB-VIEW.md" "interactive WebView") " for the user's next project. This explicitly requested extension preserves the completed MVP checkpoint above. Its current verification is recorded in IMPLEMENTATION.md: 84 GUI scenarios per Lisp,300 exports,418 docset entries and all package checks. The WebView backend is explicitly limited to verified macOS wxWidgets3.2.12 WKWebView."))))
(:entry "guide/docs/NOTEBOOK.md" :names ("docs/NOTEBOOK.md") :kind :guide :kind-name "Guide" :summary "docs/NOTEBOOK.md" :sections (("Guide" (:heading 1 "Notebook navigation") (:p "ABI37 adds native-backed " (:code "notebook") " windows with fixed setup-time panel pages:") (:code-block "lisp" "(let* ((book (wxlambda:make-notebook frame))
       (editor (wxlambda:make-panel book))
       (settings (wxlambda:make-panel book)))
  (wxlambda:add-notebook-page book editor :label \"Editor λ\")
  (wxlambda:add-notebook-page book settings :label \"Settings\" :select t)
  (setf (wxlambda:selection book) 0))") (:p (:code "make-notebook") " is a thin generic factory with validated " (:code ":class") " support. Direct " (:code "make-instance") ", subclass slots/default initargs and native properties in subclass AFTER hooks follow the " (:ref "guide/docs/CLOS-API.md" "CLOS contract") ". " (:code ":parent") " is required; ID, geometry and top-tab style use native defaults. No alternate book class, page icon, image list, arbitrary notebook style or raw native adoption is exposed.") (:heading 2 "Pages and ownership") (:p (:code "add-notebook-page") " accepts only an already initialized " (:code "panel") " whose native parent is that notebook, with no containing sizer and no existing page membership. Label defaults to empty; Select defaults NIL. It returns the supplied page wrapper. Add pages outside RUN, event pumps, modal loops and callbacks (including quiescent terminal REPL evaluations between pumps). Fully initialized child pages can be added from a notebook subclass AFTER hook; a page cannot attach itself while its own initializer is still running. Managed constructor failure cleans up the notebook/pages and callback roots. Page wrappers are rooted before native publication, so callbacks during AddPage can use canonical page identity. A callback condition can escape after adoption; it does not undo a successfully added page.") (:p (:code "notebook-page-count") " reads the count and " (:code "notebook-page") " returns the same EQ panel wrapper at a zero-based index. Native notebook ownership controls page lifetime. Direct destruction of attached page panels is rejected; destroying their notebook or ancestor invalidates them and their descendants. Unattached panel children can still be destroyed normally. No RemovePage, DeletePage, insertion, reordering, reparenting or page mutation from running callbacks is provided in this first slice.") (:p "Lay out controls inside page panels, and add the notebook to its parent's sizer. Creating a row/column on the notebook itself is rejected because it manages its own page layout. Page labels use generic SETF:") (:code-block "lisp" "(wxlambda:notebook-page-label book 0)
(setf (wxlambda:notebook-page-label book 0) \"Editor\")") (:p "Strings must be UTF-8 representable without NUL; empty captions are allowed. The setter returns the supplied string; the getter returns current native caption text. Native mnemonic processing and caption length limits differ across ports, so exact arbitrary-label echo is not promised. Indices must be nonnegative signed-int values within current page count; invalid indices signal instead of native clamping.") (:heading 2 "Selection and events") (:p "The existing " (:code "selection") " generic specializes on notebooks. It returns a zero-based index, or NIL for an empty notebook. The first page's automatic selection follows the port; adding with Select does not promise an event count or bypass veto.") (:code-block "lisp" "(setf (wxlambda:selection book) 0)           ; native ChangeSelection: silent
(setf (wxlambda:selection book :notify t) 1) ; native SetSelection: vetoable") (:p "The writer requires an existing integer page index; NIL and " (:code "-1") " are not accepted as clearing/sentinel operations. It returns the requested index even if a native changing handler vetoes; read " (:code "selection") " afterward for actual state. Silent writes bypass page-changing events and veto deliberately. Notifying writes use native events; same-page changes and construction can differ in event counts by port.") (:p "Bind " (:code ":notebook-page-changing") " or " (:code ":notebook-page-changed") " with " (:code "bind-event") ". Both carry immutable snapshots in the notify family, or an exact borrowed event context with " (:code ":with-context t") ". " (:code "event-selection") " reads native wxBookCtrlEvent selection metadata, distinct from its inherited command integer. Its meaning during CHANGING is port-dependent: pinned documentation notes Windows may report the old page, so do not assume a portable proposed-target index or infer it from a control query. Old-selection metadata is not exposed in this slice. Normal IDs, source/origin, Skip/propagation, per-binding user data and lifetime rules apply.") (:code-block "lisp" "(wxlambda:bind-event book :notebook-page-changing
  (lambda (event context)
    (declare (ignore event))
    (unless application-allows-navigation-p
      (setf (wxlambda:event-vetoed-p context) t)))
  :with-context t)") (:p "Veto/Allow metadata is available on both notify events; only CHANGING can prevent navigation. CHANGED has already happened. Page-event selection metadata is read-only at the public context level; the choice-event writer does not extend to books. Synthetic queue/process/owned construction, contextual cloning, and detached page events are rejected because they require the actual derived native class. Observer bindings Skip automatically; contextual bindings choose Skip explicitly.") (:heading 2 "Reentry and verification") (:p "Bridge navigation, AddPage and actual native page-event callbacks (including propagated bindings) protect the notebook and its ancestors. Same-notebook recursive selection, direct destruction/close of protected receivers/ancestors, and nested modal or clipboard entry are rejected until the operation/callback returns. Defer prompts/transfers to later application work; callback-time event pumping is already forbidden. Different notebook scalar operations can nest under their own guards. Callbacks emitted during native teardown are suppressed for a deleting origin. Uncaught callback conditions re-signal at the surrounding Lisp boundary after native code returns; native selection/adoption may already have completed. No rollback or exact post-error native selection outcome is promised; later silent selection can recover a usable notebook.") (:p (:code "examples/notebook.lisp") " builds an editor/settings notebook, a navigation-veto checkbox and a Back button. START is interactive; EXERCISE uses real native selection, veto and canonical page lookup:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notebook.lisp --eval '(wxlambda-notebook:start)'
sbcl --load ~/quicklisp/setup.lisp --load examples/notebook.lisp --eval '(wxlambda:with-application () (wxlambda-notebook:exercise))'") (:p "The Lisp regression covers subclass construction/defaults, setup-time publication, Unicode captions, selection/veto/silent behavior, invalid ownership/indices, attached page and layout guards, callback errors, initializer rollback and invalidation. The native harness dispatches an actual derived wxBookCtrlEvent outside bridge selection guards and through parent propagation, checking lifetime/reentry/modal/ clipboard protection. Physical tab clicks, keyboard navigation, port-specific caption/CHANGING metadata behavior and hosted Windows/Linux remain separate checks. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") ", " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/NOTIFY-EVENTS.md" :names ("docs/NOTIFY-EVENTS.md" "NOTIFY-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/NOTIFY-EVENTS.md" :sections (("Guide" (:heading 1 "Registered command and notify events") (:p "This C1 slice binds " (:code "wxNewEventType") ", synthetic " (:code "wxCommandEvent") "/" (:code "wxNotifyEvent") " families and synchronous " (:code "wxEvtHandler::ProcessEvent") ". The baseline is wxWidgets 3.2.12 and the native bridge is ABI 31. It does not bind native control-specific notify subclasses or OS session routing.") (:heading 2 "Register a named native type") (:code-block "lisp" "(wxlambda:register-event-type :before-apply :family :notify) ; :BEFORE-APPLY
(wxlambda:event-type :before-apply)                        ; native integer ID
(wxlambda:register-event-type :result-ready :family :command)") (:p "Names must be unique keywords in the active main-thread session. The default family is " (:code ":notify") "; " (:code ":command") " is also supported. Built-in kinds cannot be redefined, and duplicate names or unsupported families are errors. Registration does not replace existing handlers or type definitions. There is no unregister operation. Names and bridge mappings last until session cleanup; native IDs are allocated by wxWidgets and must not be treated as stable serialized identifiers. Register each name once per session before binding or dispatching it.") (:p "Type declarations are session-wide metadata, not owned resource allocations. If an initializer registers a type and later fails, that declaration is not rolled back; managed rollback still removes its native handlers, windows and callback registrations. Saved snapshots retain copied kind, family and native type data after the registry/session ends.") (:heading 2 "Validate synchronously with Veto and Allow") (:code-block "lisp" "(defvar receiver (wxlambda:make-event-handler))
(wxlambda:bind-event receiver :before-apply
  (lambda (event context)
    (setf (wxlambda:event-vetoed-p context)
          (minusp (wxlambda:event-integer event))))
  :with-context t)

(multiple-value-bind (handled vetoed)
    (wxlambda:process-event receiver :before-apply :integer -1 :text \"Proposed change\")
  (when (and handled (not vetoed))
    ;; Apply the change here, after validation.
    (format t \"Accepted~%\")))") (:p (:code "process-event") " creates a fresh native event, dispatches it synchronously and returns two values: native " (:b "handled-p") " and final " (:b "vetoed-p") ". These are independent. Observer callbacks can run while handled-p is NIL because they Skip; it reports native consumption/default handling, not whether a callback ran. An initial veto can remain true even if no binding matched. The example uses a consuming contextual policy handler and requires both handling and no veto before applying the proposed change.") (:p "Notify contexts support veto intrinsically: " (:code "event-can-veto-p") " returns T. " (:code "event-vetoed-p") " reads " (:code "NOT IsAllowed") "; SETF true calls " (:code "wxNotifyEvent::Veto") ", and SETF NIL calls " (:code "Allow") ". This is distinct from close-event " (:code "CanVeto") " restrictions, which remain checked. Neither notify veto nor Allow changes Skip. Contextual bindings still begin unskipped; observers still automatically Skip.") (:p "Snapshots capture veto state before their callback. They do not change after a context calls Veto/Allow. The existing innermost-callback checks, nested context suspension and expiration rules apply; saved contexts cannot mutate a later event.") (:heading 2 "Payloads and asynchronous queuing") (:p "Registered command and notify types accept:") (:list (:item (:p (:code ":id") ": signed 32-bit command identifier, default 0, excluding reserved -1."))) (:list (:item (:p (:code ":text") ": copied UTF-8 string, default empty; Unicode and embedded NULs survive."))) (:list (:item (:p (:code ":integer") ": signed 32-bit value, default 0, copied from native " (:code "GetInt") "."))) (:list (:item (:p (:code ":vetoed-p") ": initial generalized-boolean veto, default NIL, notify family only."))) (:p (:code "queue-event") " accepts the same payloads and returns the supplied receiver, but offers no synchronous final result. Mutating the original Lisp string after the call does not change the queued event. " (:code "event-integer") " reads the copied command integer in saved snapshots; close snapshots report zero. Built-in toggle and selection events keep their specialized payload accessors. Custom kinds use " (:code "event-integer") ", not the built-in " (:code "event-selection") " slot.") (:p (:code "event-family") " now reads stored " (:code ":command") ", " (:code ":close") " or " (:code ":notify") " classification; it does not consult a live registry. Registered types work with existing ID filters, independent bindings, safe unbinding, disabled-handler behavior and borrowed window identities. They do not automatically change a control or apply the proposed operation. Use the returned decision to implement application policy.") (:heading 2 "Dispatch lifetime and errors") (:p "The bridge owns the temporary native event during synchronous dispatch, copies the final veto flag and deletes the event after dispatch returns. Deferred receiver disposal during its callback does not invalidate that event or its still-running context. Native callback objects remain pinned across unbinding. Managed initialization failure removes callback roots and registrations for its constructed resources.") (:p "Callback errors are re-signaled at the " (:code "process-event") " Lisp boundary, so handling a nested error need not stop an enclosing RUN. No result values are returned when a condition escapes; earlier handler mutations are not rolled back. An error is not an implicit veto. Existing " (:ref "guide/docs/CLOSE-EVENTS.md" "close-event default actions") " also apply when a close is synchronously dispatched. Synchronous dispatch is not an event pump; nested calls are permitted with context isolation, while recursive RUN/poll entry remains forbidden. All calls are main-thread/session restricted. Worker-to-GUI dispatch is not supplied here.") (:heading 2 "Session and remaining family prerequisites") (:p "Native query/end-session events belong to " (:code "wxApp") ", not a window handler. The default end-session action may exit the process. A borrowed application handler view and session-family bindings/metadata are now available; synthetic session events require isolated owned handlers and never reach wxApp fallback. Real OS delivery remains unverified. See " (:ref "guide/docs/SESSION-EVENTS.md" "session events") ". Tests do not emit real OS logout/shutdown events.") (:p "Native control-specific notify subclasses, arbitrary native class registration, arbitrary native userData adoption, broader persistent event ownership/cloning, remaining native payload fields, context text/integer mutation, pushed/linked handlers, timer/idle and worker dispatch remain required coverage work. The registered base notify mapping does not complete those classes or the full C1 phase.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/notify-events.lisp" "notify-events example") " registers a notify policy, vetoes while a checkbox blocks changes, then Allows and applies a change. Its reusable " (:code "exercise") " invokes the same button callback in both cases:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notify-events.lisp \\
  --eval '(wxlambda-notify-events:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/notify-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/notify-events.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover registration conflicts, synchronous handled/veto distinctions, initial-veto Allow, integer bounds, copied NUL/Unicode text, saved registry-independent snapshots, disposal, initializer rollback and nested error recovery while RUN continues. The API, guide and example are indexed in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted GUI and graphical Cadre remain separate validation work.") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session-event routing remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects."))))
(:entry "guide/docs/NUMERIC-INPUT.md" :names ("docs/NUMERIC-INPUT.md" "NUMERIC-INPUT") :kind :guide :kind-name "Guide" :summary "docs/NUMERIC-INPUT.md" :sections (("Guide" (:heading 1 "Bounded sliders and integer spin controls") (:p "ABI45 adds native-backed " (:code "slider") " and " (:code "spin-control") " WINDOW subclasses. Both use required " (:code ":parent") " window, " (:code ":minimum") " (default0), " (:code ":maximum") " (100) and " (:code ":value") " (0). Endpoints must be integers within -1000000..1000000 with minimum strictly less than maximum; the initial value must lie in that range. A custom positive range therefore needs an explicit valid value. The bounds keep native arithmetic and range spans within supported integer limits.") (:code-block "lisp" "(let* ((slider (wxlambda:make-slider panel :minimum -100 :maximum 100 :value 25))
       (spin (make-instance 'wxlambda:spin-control :parent panel
                                                :minimum -100 :maximum 100 :value 25)))
  (setf (wxlambda:numeric-value slider) 40
        (wxlambda:numeric-value spin :notify t) -20)
  (setf (wxlambda:numeric-range slider) '(0 10))) ; silently clamps to10") (:p "Slider " (:code ":orientation") " is immutable " (:code ":horizontal") " (default) or " (:code ":vertical") ", queried by " (:code "slider-orientation") ". Spin controls use editable decimal integer text, unit arrows and fixed wxSP_ARROW_KEYS, without wrap/base/increment/double variants. Native style/tick/label/page/line/selection-range options are not exposed. Use panels for ordinary layout. CMake requires wxUSE_SLIDER, wxUSE_SPINCTRL and wxUSE_SPINBTN; the no-spin-button generic fallback is outside this slice. Baseline: wxWidgets3.2.12.") (:p (:code "make-slider") "/" (:code "make-spin-control") " are thin generic factories with validated " (:code ":class") " and forwarded subclass initargs. Direct MAKE-INSTANCE supports slots/default initargs and AFTER hooks with native properties ready. Abstract/ambiguous native ancestry and invalid construction reject; managed initialization failure cleans up native widgets and callback roots. Lisp subclasses do not imply native C++ virtual overrides. See " (:ref "guide/docs/CLOS-API.md" "CLOS construction") ".") (:heading 2 "Value and range properties") (:p (:code "numeric-value") " reads the native value. Generic SETF validates and writes a bounded integer; out-of-range values reject without implicit clamping. Writes are silent by default, including native numeric/text callback suppression. " (:code ":notify t") " commits the value then emits one native-class update event, even if the value is unchanged. It returns the supplied integer; an escaping callback condition is contained and re-signaled after the native call, without rolling the committed value back.") (:p (:code "numeric-range") " returns a fresh two-element list " (:code "(minimum maximum)") ". SETF accepts exactly two valid endpoints, changes them silently and clamps the prior numeric value to the new range. It returns the supplied list; mutating that list or a getter result cannot change the native range. There are no separate bound setters or range-change notifications. Constructor, range and silent value operations suppress bridge numeric/text callbacks; the native controls retain their own internal normalization.") (:p "A spin getter first validates GetTextValue using a decimal integer parse before calling the native numeric getter. Empty/intermediate signs, non-integer strings, NaN or overflow beyond that parser reject with NATIVE-ERROR; a range write also needs a readable prior numeric value. An integer value write can recover an invalid edit because it does not read the old edit first. For valid decimal text, native current-versus-committed interpretation and focus-loss/arrow validation timing vary by port. Do not treat this property as raw text or promise identical intermediate edit behavior on all backends. There is no public string setter for spin text.") (:heading 2 "Update events and callback boundary") (:p "Bind " (:code ":slider-change") " (wxEVT_SLIDER, command family) and " (:code ":spin-change") " (wxEVT_SPINCTRL/wxSpinEvent, notify family) using BIND-EVENT, with existing IDs, ranges, user-data, immutable snapshots and optional borrowed contexts. " (:code "event-numeric-value") " reads the integer payload from numeric snapshots/contexts; unrelated snapshots return NIL and unrelated contexts reject. It is read-only. The event payload is a snapshot of that event, not a live control property. Existing raw EVENT-INTEGER context editing can change metadata without writing widget state. Native spin veto is observational: it cannot portably undo a committed numeric update. Use validated property writes/application policy.") (:p "These new kinds are native/explicit-notified-setter only: no synthetic, owned, queued/posting constructor or detached clone support. Cloning an unrelated text context retains its existing rules; numeric kinds reject even when the slider uses an ordinary wxCommandEvent. Registered-kind numbering starts after both new kinds and is protected by the ABI check.") (:p "Source numeric updates and spin-origin forwarded text callbacks protect the numeric control and its ancestors against destruction/close, same-control value/range writes, and modal/clipboard/nested dispatch entry. Composite child origins are matched by identity against live numeric controls/children before any origin pointer dereference. Creation/native-base teardown suppresses numeric/text delivery. A spin can emit TEXT before continuing native processing and then SPINCTRL; raw text callbacks therefore have the same lifetime guard. They are not commit events.") (:p "Silent writes to a different numeric control are allowed for slider/spin synchronization; same-control recursive mutation rejects. Defer protected work with " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "DEFER-UI-ACTION") ", or apply it after callback return. Default event observers Skip; contextual handlers choose propagation explicitly. No callback ordering or hardware drag/spin timing promise is added.") (:heading 2 "Example and verification scope") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/numeric-input.lisp --eval '(wxlambda-numeric-input:start)'") (:p "The example mirrors slider and spin updates using silent cross-control writes, shows a value label, and narrows both ranges with deterministic clamping. EXERCISE uses explicit notified setters to exercise the same callback logic; it does not simulate hardware dragging/typing. Tests cover native-backed subclasses/defaults/ AFTER hooks, bounds, copy isolation, silent clamp, immutable/context payloads, observational veto, same-control/lifetime gates, stale handles and rollback on SBCL and CCL. Native probes directly dispatch authentic slider/spin/text event classes outside setter guards, including propagation, raw invalid edit recovery, constructor silence and native teardown with zero wx assertions.") (:p "Runtime evidence is macOS wxWidgets3.2.12. GTK/MSW native behavior was source-audited; hosted Windows/Linux/Qt GUI, physical drag/spin/typing/accessibility, all transient input-method/clipboard edit states and arbitrary allocation races remain unverified. No system clipboard text is read/replaced in these automatic tests. This slice does not bind wxSpinCtrlDouble, wxSpinButton, all scroll event families, raw numeric native event construction or complete native control parity. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/OWNED-EVENTS.md" :names ("docs/OWNED-EVENTS.md" "OWNED-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/OWNED-EVENTS.md" :sections (("Guide" (:heading 1 "Owned native events, detached clones and copied dispatch") (:p "ABI 31 adds the native-backed " (:code "owned-event") " CLOS class and " (:code "make-event") ", " (:code "clone-event") ", " (:code "destroy-event") " and " (:code "event-alive-p") ". These are independently owned native resources, distinct from immutable " (:code "event") " snapshots and borrowed callback-scoped " (:code "event-context") " values. The baseline is wxWidgets 3.2.12.") (:heading 2 "Construction and disposal") (:p (:code "make-instance") " on OWNED-EVENT or a subclass creates the native event through inherited initialization. " (:code "make-event") " is a thin factory with validated " (:code ":class") " and forwarded initargs. Subclass slots, " (:code ":default-initargs") " and AFTER hooks work; native properties are available in subclass AFTER hooks. Combining OWNED-EVENT with EVENT-HANDLER or a window class is invalid and must reject before native allocation. These wrappers do not install native C++ virtual overrides.") (:code-block "lisp" "(wxlambda:with-application ()
  (wxlambda:register-event-type :message :family :command)
  (let ((event (wxlambda:make-event :kind :message :text \"Hello\" :integer 1)))
    (unwind-protect
         (setf (wxlambda:event-text event) \"Reusable payload\"
               (wxlambda:event-integer event) 2)
      (wxlambda:destroy-event event))))") (:p (:code ":kind") " defaults to :CLICK and accepts the eleven constructible built-in kinds (not notebook page events) or a registered command/notify name. The other base construction initargs match synthetic event payloads: " (:code ":id") " defaults to 0, " (:code ":text") " to an empty string, " (:code ":integer") " to 0, " (:code ":checked-p") " and " (:code ":selection") " apply only to their built-in kinds, " (:code ":can-veto-p") " defaults T for close-family construction, initial " (:code ":vetoed-p") " applies only to registered notify kinds, and " (:code ":logging-off-p") " applies only to session kinds. Explicit wrong-family payload options follow QUEUE-EVENT validation. Initial ID -1 remains reserved; subsequent EVENT-ID SETF can assign it as native metadata. No native handle can be supplied as an initarg.") (:p "Native wxEVT_TEXT can lazily read the originating text control instead of its stored command string. Context EVENT-TEXT SETF therefore rejects that type when its tracked origin exposes a text entry, and rejects unknown native origins; it does not silently edit the control. Detached context cloning first captures the effective GetString value and stores it before clearing origin, freezing the observed text. Copied owned :TEXT-CHANGE dispatch to a text-entry receiver rejects before queueing or processing, rather than allowing receiver text to shadow the owned payload. Other receivers and custom command tags support payload copying. Existing keyword synthetic dispatch behavior is unchanged.") (:p "An owned event stays in the native session registry until explicit DESTROY-EVENT or session cleanup, even if its Lisp wrapper is garbage collected. There is no GC finalizer or cross-session reuse. EVENT-ALIVE-P returns NIL for an explicitly destroyed resource during the active session. Other native access and repeated destruction signal NATIVE-ERROR. A failed/uninitialized wrapper has no handle and also signals NATIVE-ERROR, including for EVENT-ALIVE-P. Outside a GUI session, all native resource operations signal NATIVE-ERROR. Native operations remain restricted to the main thread.") (:p "Initialization failure rolls back native events, widgets, standalone handlers and callback roots created in the same managed construction transaction. Window rollback still follows native asynchronous destruction; event deletion is immediate. Session cleanup destroys remaining owned events before handler/app teardown.") (:heading 2 "Detached native cloning") (:p "CLONE-EVENT accepts a live OWNED-EVENT or the current innermost EVENT-CONTEXT and returns a new OWNED-EVENT. It calls native Clone only for exact wxCommandEvent, wxNotifyEvent, wxCloseEvent or wxIdleEvent classes with supported tags. Other native subclasses and events carrying borrowed native userData or command client pointers reject cloning. A saved snapshot is not a native event and has no CLONE-EVENT method.") (:p "Native origin is cleared on every clone: a clone never retains a borrowed GetEventObject pointer. EVENT-ORIGIN-ID on an owned event therefore returns NIL. No new-origin setter, arbitrary wxObject wrapper or origin pinning/retention protocol is added. Clone preserves supported value metadata, payload, Skip/propagation and veto flags. Source and clone can be changed or destroyed independently.") (:p "CLONE-EVENT supports " (:code ":class") " and forwarded subclass slot initargs. The factory and MAKE-EVENT with " (:code ":clone-from") " reject explicit payload override initargs: clone first and use SETF to change its values. Inherited payload default initargs do not replace cloned values. Direct MAKE-INSTANCE with " (:code ":clone-from") " uses the source native state and ignores payload initargs, including inherited defaults; subclass slot initialization and AFTER hooks still apply. This source-wins rule avoids accidentally reconstructing a clone from subclass defaults.") (:p "Cloning a suspended outer or expired context signals NATIVE-ERROR. Snapshot readers stay independent of native lifetime; cloning does not extend a context's lifetime or expose a native event pointer.") (:heading 2 "Mutable properties") (:p "Owned events support generic reads for kind, family, ID, native type, timestamp, command classification, category, CanVeto/veto, session logging-off, Skip and propagation. SETF is supported for ID, timestamp, bounded registered native type, CanVeto/veto, session logging-off and Skip. STOP-EVENT-PROPAGATION and RESUME-EVENT-PROPAGATION also accept owned events. Kind/family/classification and category are derived read-only metadata; origin remains detached.") (:p "EVENT-TEXT and EVENT-INTEGER are now generic readers for snapshots, current contexts and owned events, with SETF for current/owned command and notify events. Strings use explicit UTF-8 byte counts and retain embedded NULs. Integer writes accept signed32 values. They alter native command payload fields, so built-in checked/selection interpretations can reflect the same underlying integer. EVENT-SELECTION snapshots normally contain an index, but explicitly mutated raw integers can be other signed values; -1 maps to NIL. No live item-list validation is implied by raw payload mutation. Live text reads return a string for command/notify events, including empty strings; close/idle-family text reads return NIL and writes reject. Close/idle-family integer reads return zero and writes reject. Saved snapshots retain their existing kind-specific copied payload interpretation and have no SETF methods.") (:p "Other validation is unchanged: timestamps must fit signed native C LONG; native type mutation requires registered same-family tags and actual native class; CanVeto writes require wxCloseEvent, veto writes check its current capability or use notify Veto/Allow, and logging-off requires a session event. Context methods remain valid only in the innermost callback. These metadata changes do not grant OS veto authority or change the native class.") (:heading 2 "Dispatch always copies") (:p (:code "(process-event receiver owned-event)") " dispatches a fresh detached clone and returns handled-p and final-vetoed-p from that copy. " (:code "(queue-event receiver owned-event)") " queues another independent native clone and returns RECEIVER. Both reject synthetic payload keyword overrides; mutate the owned event before copying instead. The receiver becomes the dispatch copy's native origin.") (:p "Mutations made by callbacks affect only that dispatch copy. The source owned event remains unchanged and may be destroyed inside the callback or immediately after queueing. Callback errors re-signal at the existing nearer Lisp boundary; previous copy mutations are not transactional. The source is never transferred to wxWidgets or consumed by dispatch. A contextual callback can CLONE-EVENT its current native copy to retain the changed state, with origin detached again. Observer Skip/handled-result and callback-time receiver-disposal rules remain in force.") (:p "Session event copies still require an isolated owned standalone receiver. Application/window receivers reject before dispatch, and standalone session fallback to wxApp stays blocked. Owned session construction is not OS event delivery and does not relax that rule. No live logout/shutdown is generated by automated checks.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/owned-events.lisp --eval '(wxlambda-owned-events:start)'") (:p "It constructs a reusable message, changes the synchronous copy, captures a detached clone of the current context, queues a copy, destroys its source before delivery, and verifies unchanged snapshots and independent payloads. Regressions also cover CLOS defaults/subclasses, mixed-resource rollback, explicit disposal, session cleanup, all built-in constructions, live payload writes and session receiver guards.") (:p "This is partial native ownership coverage. Arbitrary derived event classes, retained origin objects, client/userData ownership, snapshot-to-native conversion, arbitrary native source transfer, origin writes and broader worker or pushed-handler ownership remain open. Existing null/untracked-origin lookup and actual-class mismatch rejection branches are not manufactured by the safe public API. Hosted Windows/Linux GUI, native OS session delivery and graphical Cadre validation remain unverified.") (:p "Build/check the docset with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") ", " (:ref "guide/docs/EVENT-TAGS.md" "tag mutation") ", " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending delivery modes") " now add GUI posting copies, genuine TRANSFER-EVENT ownership handoff, synchronous local copies and handler-specific pending deletion. PROCESS-EVENT/QUEUE-EVENT retain the copy semantics above; transferred source wrappers are consumed and cannot be reused or destroyed.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " add native extra LONG, raw selection-action metadata, uniform checked/selection semantic SETF and clear-only origin detachment. Owned construction accepts command/notify :EXTRA-LONG; keyword synthetic queue/process calls do not add that option.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. General native event/client/item pointer ownership remains unbound; per-binding Lisp USER-DATA is separately supported.") (:p (:ref "guide/docs/BINDING-USER-DATA.md" "Per-binding Lisp user data") " now provides BIND-EVENT :USER-DATA and read-only snapshot/context association access, distinct from handler client data and native command/client/item pointers. Borrowed native userdata still prevents owned cloning; no mutable association API is added.") (:p (:ref "guide/docs/IDLE-EVENTS.md" "Idle events") " add family :IDLE, bounded RequestMore, global automatic policy and own-window opt-in metadata. Frame menus/actions now extend GUI breadth; standard dialogs are next, without requiring exhaustive foundation parity.") (:p (:ref "guide/docs/MENUS.md" "Menus and actions") " add built-in :MENU commands, including raw checked metadata. Event field writes do not synchronize a managed menu item.") (:p "ABI38 includes simple " (:code ":listbox-selection") "/" (:code ":listbox-double-click") " command events with explicit " (:code ":text") "/" (:code ":selection") " payloads, owned cloning and dispatch to arbitrary handlers. Payload mutation does not change list items/selection. See " (:ref "guide/docs/LIST-BOX.md" "lists") ".") (:p "ABI39 tree selection events, like notebook derived events, are native-only and cannot be constructed, queued as owned events or contextually cloned. Snapshots can retain checked TREE-ITEM views; those references do not freeze native validity."))))
(:entry "guide/docs/PENDING-EVENTS.md" :names ("docs/PENDING-EVENTS.md" "PENDING-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/PENDING-EVENTS.md" :sections (("Guide" (:heading 1 "Pending-event copies, transfer and local processing") (:p "ABI 31 adds POST-EVENT, TRANSFER-EVENT, PROCESS-EVENT-LOCALLY and DELETE-PENDING-EVENTS as generic handler operations. They build on detached OWNED-EVENT resources and the wxWidgets 3.2.12 event-handler interface. This batch distinguishes copy delivery from genuine native ownership handoff.") (:table :header (("Operation") ("Input resource after success") ("Native operation") ("Delivery")) :rows ((("POST-EVENT") ("Still live and unchanged") ("GUI wxPostEvent / AddPendingEvent copy") ("Queued")) (("QUEUE-EVENT with owned input") ("Still live and unchanged") ("QueueEvent with independent clone") ("Queued")) (("TRANSFER-EVENT") ("Consumed; no longer owned by the bridge") ("wxQueueEvent / QueueEvent ownership handoff") ("Queued")) (("PROCESS-EVENT") ("Still live and unchanged") ("ProcessEvent on independent clone") ("Synchronous normal routing")) (("PROCESS-EVENT-LOCALLY") ("Still live and unchanged") ("ProcessEventLocally on independent clone") ("Synchronous local routing")))) (:p "The four new operations require an active main-thread GUI session. They accept event-handler/window receivers as described below; event-delivery operations accept a live OWNED-EVENT rather than a kind keyword or snapshot. No payload override keywords are supported. Mutate the owned resource first, or clone it when a distinct reusable input is needed.") (:heading 2 "Posting a GUI copy") (:p "POST-EVENT returns RECEIVER after posting a detached copy using wxPostEvent, which uses AddPendingEvent in this GUI application. It does not process callbacks before returning. Its input remains live and unchanged and can be changed or destroyed immediately afterward without changing the queued copy. The receiver is the copy's native origin, just as for owned QUEUE-EVENT dispatch.") (:p "This mapping deliberately requires the existing GUI session; wxPostEvent's non-GUI immediate-dispatch behavior is not exposed. AddPendingEvent string copying is not a worker-thread facility here. Worker-to-GUI posting remains unbound, including any broader thread-safety guarantees.") (:code-block "lisp" "(wxlambda:post-event receiver message)
(assert (wxlambda:event-alive-p message))
(wxlambda:process-pending-events) ; existing application-wide pending dispatch") (:heading 2 "Transferring native ownership") (:p "TRANSFER-EVENT returns RECEIVER after handing the actual owned native object to wxQueueEvent. It validates the receiver, supported event and receiver-family restrictions before consuming the input. A validation failure leaves the owned resource live so it can be corrected, copied or destroyed normally.") (:p "After preflight, the native object is removed from the bridge-owned registry and handed off to wxWidgets. EVENT-ALIVE-P on the original wrapper then returns NIL during the active session; native property access, cloning and DESTROY-EVENT on that consumed wrapper reject. Its integer handle is not another owner's public receiver. The receiver becomes the transferred event's native origin.") (:p "There is no rollback after handoff or delivery guarantee. If the destination is later destroyed, pending events are deleted, or native delivery otherwise does not happen, ownership is not returned to the consumed wrapper. A failure after the handoff boundary does not restore bridge ownership either. Use POST-EVENT or QUEUE-EVENT when the input must remain reusable.") (:code-block "lisp" "(wxlambda:transfer-event receiver (wxlambda:clone-event message))
(assert (wxlambda:event-alive-p message)) ; original message was not transferred") (:p "Callbacks can retain immutable snapshots or clone their current context into a new detached resource. They cannot regain ownership of the consumed wrapper. The bridge never exposes the native event pointer during transfer.") (:heading 2 "Synchronous local processing") (:p "PROCESS-EVENT-LOCALLY returns two values: native handled-p and final-vetoed-p from an independent detached copy. It leaves the input alive and unchanged. Like native ProcessEventLocally, it tries the receiver and native chained handlers, including local pre-processing such as TryBefore/validators. Native local static/default handlers can still run, including frame-close behavior. Local processing is not an observer-only or no-default-action mode. It does not run the normal outer global-filter and parent/application fallback path of ProcessEvent. Managed standalone " (:ref "guide/docs/HANDLER-CHAINS.md" "handler chains") " are now available; dedicated managed window stacks are also bound, while external/native stack adoption, arbitrary SetEventHandler and virtual overrides remain unbound.") (:p "An observing callback can run and Skip while handled-p is NIL. Final veto state is independent of handled-p. Nested current-context lifetime rules and the nearer callback-error boundary remain the same as PROCESS-EVENT. Local processing is synchronous; it neither pumps unrelated pending queues nor converts them into local delivery. Choose PROCESS-EVENT for normal native parent/application routing.") (:heading 2 "Deleting one handler's pending events") (:p "DELETE-PENDING-EVENTS returns T after deleting every pending native event on the selected receiver. It does not execute callbacks or remove bindings. Later posts and queues on that handler still work. It does not delete another handler's queue, report a deletion count, restore transferred resources or perform application-wide queue deletion. An empty target queue is allowed.") (:p "The borrowed APPLICATION-HANDLER rejects this operation: application-queued work includes bridge deferred cleanup and must not be discarded through this API. The operation also rejects during RUN, a native pump or any callback. Call it at a non-dispatch boundary, not from the delivery being cancelled.") (:p "The wrapper synchronizes the target with wxApp's pending-handler list after native DeletePendingEvents. The implementation uses the native RemovePendingEventHandler management method because DeletePendingEvents alone does not remove the list entry. That method exists in the implementation header, but is absent from the pinned documentation-interface inventory; it is an implementation dependency for C7 reconciliation, not a new public Lisp binding.") (:p "Per-handler ProcessPendingEvents remains unbound. Native code requires a known nonempty target queue, and this bridge does not expose a safe per-handler pending query. Existing PROCESS-PENDING-EVENTS remains the application-wide dispatcher. wxAppConsole::DeletePendingEvents also remains unbound; target-handler deletion must not be mistaken for application-wide pending cancellation.") (:heading 2 "Shared restrictions and verification") (:p "All new delivery modes retain existing supported exact native classes, detached origin policy and session isolation. Session event delivery still requires an isolated owned standalone receiver; application/window targets reject before handoff or posting. Copied owned :TEXT-CHANGE delivery to text-entry receivers rejects before emission, preventing lazy native GetString from shadowing the owned payload. Transfer applies the same text-entry restriction. These APIs add no arbitrary origin retention, raw pointers, native class replacement, userdata/ client ownership, real OS session delivery or worker-thread posting.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/pending-events.lisp --eval '(wxlambda-pending-events:start)'") (:p "It demonstrates the distinct copy/transfer/local/cancellation semantics using owned events and releases resources. Regression validation should distinguish consumed handles from surviving copies, preflight failure from handoff, local routing from normal parent routing, handler-specific cancellation from other pending queues, and callback/pump/application restrictions. Local results do not validate hosted Windows/Linux GUI behavior, real OS session events or graphical Cadre. Remaining C1 gaps include origin retention, broader native classes, client/userdata ownership, application-wide cancellation, per-handler pending queries, pushed handlers, timer/idle and worker dispatch.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") ", " (:ref "guide/docs/APPLICATION-EVENTS.md" "application dispatch") ", " (:ref "guide/docs/EVENT-BINDINGS.md" "event bindings") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Window stack routing") " is explicit: generic and queued window operations retain wxEvtHandler stack-bypass behavior; PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY enter managed pushed handlers synchronously.") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/RADIO-GROUPS.md" :names ("docs/RADIO-GROUPS.md" "RADIO-GROUPS") :kind :guide :kind-name "Guide" :summary "docs/RADIO-GROUPS.md" :sections (("Guide" (:heading 1 "Bounded radio-button groups") (:p "ABI46 adds " (:code "radio-box") ", a native-backed wxRadioBox WINDOW subclass containing a fixed group of mutually exclusive choices. This composite owns its native radio buttons; grouping does not depend on sibling creation order. Required " (:code ":parent") " is a window, " (:code ":items") " is a proper list of2..64 strings, " (:code ":label") " defaults to an empty group caption, " (:code ":selection") " defaults to0, and " (:code ":orientation") " defaults to " (:code ":vertical") ". Horizontal uses one row, vertical one column. Selection is always a zero-based valid index, never NIL. Strings reject embedded NUL; duplicate or empty labels are allowed. Native mnemonic/display normalization (notably " (:code "&") ") can differ by port; native item/event text need not equal supplied strings. Baseline wxWidgets3.2.12; builds require wxUSE_RADIOBOX/RADIOBTN/STATBOX.") (:code-block "lisp" "(let ((group (make-instance 'wxlambda:radio-box :parent panel
                           :label \"Format\" :items '(\"Text\" \"HTML\" \"Markdown\"))))
  (setf (wxlambda:selection group) 1)             ; silent
  (setf (wxlambda:selection group :notify t) 2)   ; one notification
  (wxlambda:item-text group (wxlambda:selection group)))") (:p (:code "make-radio-box") " is a thin generic factory with validated " (:code ":class") " and forwarded subclass initargs. Direct subclasses support slots/default initargs and native properties in AFTER hooks. Invalid mixed native ancestry rejects before native allocation; failed managed initialization releases widgets and callback roots. See " (:ref "guide/docs/CLOS-API.md" "CLOS construction") ".") (:heading 2 "Selection and fixed items") (:p (:code "selection") " and its generic SETF specialize on RADIO-BOX. Values outside the fixed list reject without mutation. The reader ignores the shared " (:code ":notify") " keyword. Writes are silent by default. " (:code ":notify t") " commits then emits exactly one native-class wxCommandEvent, even when the index is unchanged; callback errors are re-signaled at the Lisp boundary without rolling selection back. Physical repeated-selection events can differ by port. " (:code "item-count") " returns the fixed count; " (:code "item-text") " returns native text at a checked index. No item insertion, removal, rename, group caption setter or runtime orientation change is exposed. Existing LIST-BOX-only item mutation methods do not apply to RADIO-BOX.") (:heading 2 "Events and callback safety") (:p "Use " (:code "bind-event") " with " (:code ":radio-selection") ", optionally " (:code ":with-context t") ". " (:code "event-selection") " reads the index from an immutable snapshot or the innermost current borrowed context. " (:code "event-text") " reads copied/native label text; " (:code "event-integer") " is the raw command payload. Snapshot values remain readable after source/session cleanup. Contexts expire on return. Events propagate as native command events, including frame observers; default observers Skip automatically. There is no dedicated on/off-selection convenience method for this class.") (:p "Numeric and radio composites share input lifetime guards. Actual source events and frame-propagated events protect the group and ancestors from destruction/ close and defer modal/clipboard transfers, RUN/pumps and nested safe-idle entry. Same-group selection writes reject during its callback/operation; silent writes to another group are allowed. Creation/failure/teardown suppress relevant input callbacks. Origin matching uses tracked live identities/composite descendants, without unchecked casting or dereferencing event-object pointers. Native setter calls are blocked from incidental delivery; explicit notify runs after blockers.") (:p "Radio events cannot be constructed as owned/synthetic events or detached/cloned. EVENT-SELECTION SETF is not supported for this kind. Raw current event integer/ text metadata changes are observational and do not modify the control or confer veto behavior. This is wxRadioBox support, not standalone wxRadioButton grouping, per-item enable/show/focus/tooltips, arbitrary styles or native class completeness.") (:heading 2 "Example and verification") (:p (:ref "example/examples/radio-groups.lisp" "examples/radio-groups.lisp") " selects an export format and updates a label. START is interactive; EXERCISE tests silent/notifying selection and cleanup without hardware input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/radio-groups.lisp --eval '(wxlambda-radio-groups:start)'
# In an initialized project environment:
sbcl --noinform --non-interactive --load ci/setup.lisp --load tests/radio-groups.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/radio-groups.lisp") (:p "Tests cover direct/subclass/factory construction, UTF-8, bounds, rollback, callback source/ancestor protection, silent cross-group updates, event lifetime and clone refusal. Native probes dispatch actual wxEVT_RADIOBOX command events outside the setter operation, including parent propagation; these do not simulate mouse or keyboard input. Runtime evidence is macOS3.2.12; OSX/GTK/MSW/Qt implementations were source-reviewed. Hosted Linux/Windows/Qt GUI, physical clicks/arrows, accessibility and graphical Cadre remain unverified. Automatic clipboard tests do not read or replace system contents. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/RECORD-MANAGER.md" :names ("docs/RECORD-MANAGER.md" "RECORD-MANAGER") :kind :guide :kind-name "Guide" :summary "docs/RECORD-MANAGER.md" :sections (("Guide" (:heading 1 "Cohesive tree/list record manager") (:p (:code "examples/record-manager.lisp") " composes existing bindings into one usable manager: category tree, search input, single-selection record list, splitter panes, Records/Details notebook pages, read-only multiline details, menu and toolbar actions, portable accelerator IDs, generic dialogs and clipboard copy. It adds no native binding or public library export. The records stay in memory; persistence and external database integration are application work.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/record-manager.lisp \\
  --eval '(wxlambda-record-manager:start)'") (:p "Select Documents or Images, filter titles, select a row, and use New/Edit/Delete/ Copy record/Details through the menu, toolbar or configured keyboard shortcuts. Copy record uses the system text clipboard only in the interactive START path. New and Edit use two sequential text-entry prompts; Delete uses a generic Yes/No message dialog. Cancel leaves model records unchanged. A nonempty single-line title is required; NUL is rejected in both fields. Notes can be multiline in the model and details view, although the bounded native prompt used here is single-line. The example does not advertise rich editing.") (:heading 2 "Model and callback behavior") (:p "Records have stable numeric IDs, category keywords, copied title and note strings. List indices are a temporary view over visible IDs. The category tree's borrowed item views map to category keywords; they are not stored as record IDs. Filtering uses Lisp CHAR-EQUAL substring matching, not locale/Unicode collation. Changing category or query preserves a selected record only if its ID remains visible; a hidden/deleted selection clears and disables selection-only actions.") (:p "Native tree/search callbacks enqueue one owner-bound deferred refresh. Pending refreshes coalesce and read the latest category/query at delivery. An explicit cancel request merges a clear flag into any pending refresh; clearing at delivery is application policy, not an assumption about native cancel timing or payload.") (:p "Menu, toolbar and keyboard commands converge on the same deferred model action. Contextual menu bindings consume commands so toolbar/frame propagation does not queue duplicate work. The first pending CRUD/copy/details request wins. New requests while an action is active are ignored. Action targets and creation categories are captured as Lisp IDs/keywords at request time, avoiding accidental retargeting when row order, filters or navigation change before delivery. The record's current contents are resolved from that ID when the action runs. Details refuses to resurrect a target hidden by an earlier pending refresh; deleting a captured target preserves a later selection of another surviving ID. Native command checked/enabled metadata is not the application model.") (:p "All modal/clipboard entry and notebook navigation happen in the safe idle phase. The action-active flag is cleared on normal return or unwinding. Unexpected adapter conditions propagate with their identity intact; a failing prompt does not partially mutate records. Explicit disposal cancels pending actions/refreshes before requesting frame destruction. Native owner destruction also cancels work through the existing weak-owner mechanism. This does not turn frame close acceptance into a native destruction guarantee.") (:heading 2 "Deterministic verification and scope") (:p (:code "EXERCISE") " runs inside an active application session. It injects prompt, confirmation and clipboard functions, so automatic tests never read or overwrite system clipboard content and never require manual modal input. It checks:") (:list (:item (:p "category navigation and Unicode filtering across tree/list views;"))) (:list (:item (:p "menu/toolbar/synthetic command convergence and deferred execution;"))) (:list (:item (:p "first-request-wins creation, stable-ID edit/copy targets and details navigation;"))) (:list (:item (:p "create/edit/delete success, canceled edit/delete and invalid title refusal;"))) (:list (:item (:p "selected-row/model/detail/menu/tool state synchronization."))) (:p (:code "tests/record-manager.lisp") " adds pending cancel-refresh merging, NIL selection, action reentry refusal, original prompt-condition identity, no partial mutation, active-flag cleanup, and cancellation before owner disposal. The synthetic menu command checks action logic, not a physical keypress. Native modal and clipboard bindings retain their independent fixture/isolation tests. Physical pointer/key/ IME interaction, hosted GUI ports, native clipboard interoperability and graphical Cadre remain unverified by these workflow tests.") (:heading 2 "Finite primary-goal checkpoint") (:p "The project's primary goal is broad everyday GUI coverage with selective depth, not exhaustive wxWidgets parity. For a local verified macOS MVP, a finite stopping point is acceptance of these representative workflows plus the shared reliability and delivery gates:") (:table :header (("Workflow") ("Evidence required")) :rows ((("Form/editor") ("Existing persistent document form: open/save/cancel/error/dirty close behavior, menus/tool/keyboard actions, clipboard through isolated adapters, multiline text and navigation primitives.")) (("Tree/list manager") ("This integrated example: category/filter/selection/model IDs, CRUD dialogs/actions, details, cancellation/failure/disposal and clipboard adapter acceptance.")) (("Drawing/monitoring") ("A retained drawing canvas with bounded geometry, colour/font/text and bitmap adapters, resize/DPI scope, and owner-bound periodic updates; see " (:ref "guide/docs/DRAWING-CANVAS.md" "drawing/monitoring") " and the consolidated " (:ref "guide/docs/MVP-ACCEPTANCE.md" "acceptance report") ".")) (("Shared delivery gates") ("Native/main-thread/lifetime/event regressions; both-Lisp suite and package checks; all exports documented; guides/examples and public references discoverable in a zero-problem Cadre-readable docset; independent review resolved.")))) (:p "Once all rows pass on the declared local target, further widgets and native inventory entries are optional expansion and should not be treated as an endless primary-goal backlog. Hosted Windows/Linux/Qt, physical interaction and graphical Cadre are separate unverified acceptance targets and must not be advertised as completed. A local milestone declaration must name that boundary explicitly.") (:p "See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "feature policy") ", " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") ", " (:ref "guide/docs/TREE-NAVIGATION.md" "tree navigation") ", " (:ref "guide/docs/SEARCH-CONTROLS.md" "search controls") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/REPORT-TREE-VIEWS.md" :names ("docs/REPORT-TREE-VIEWS.md" "REPORT-TREE-VIEWS") :kind :guide :kind-name "Guide" :summary "docs/REPORT-TREE-VIEWS.md" :sections (("Guide" (:heading 1 "Report lists, native virtual text and tree interaction") (:p (:code "list-control") " is a native-backed WINDOW around " (:code "wxListCtrl") " in REPORT and single-selection mode. " (:code ":parent") " is required. " (:code ":virtual-p") " is fixed at construction and defaults NIL. Factories validate " (:code ":class") "; direct subclasses, slot/default initargs, native-ready AFTER hooks and managed failure/root rollback follow the normal CLOS contract. No application file, search-result or editor model is built into this control.") (:code-block "lisp" "(defparameter report (wxlambda:make-list-control parent))
(wxlambda:insert-list-column report 0 \"Name λ\" :width 180)
(wxlambda:insert-list-column report 1 \"Value\" :width 120)
(wxlambda:append-item report '(\"First\" \"12\")) ; new row index
(setf (wxlambda:list-item-text report 0 1) \"13\")
(wxlambda:list-item-text report 0 1)          ; independent string
(setf (wxlambda:selection report) 0)
(wxlambda:delete-item report 0)") (:p "The report starts with no columns/items. At most64 columns are supported; clear items before inserting/deleting columns. Column captions are copied NUL-free UTF-8 strings of at most4096 bytes. " (:code "list-column-count") " reads the native count; " (:code "list-column-label") " and " (:code "list-column-width") " have generic SETF writers. Width writes accept1..10000 native pixels, with native layout/readback policy; automatic width scanning and arbitrary alignments/styles are not exposed.") (:p "Stored lists support at most100000 rows. " (:code "append-item") " accepts a proper list of strings matching the columns, with at most65536 UTF-8 bytes per cell and1MiB per row. " (:code "list-item-text") " reads a copied cell and SETF writes it. " (:code "item-count") ", " (:code "delete-item") ", " (:code "clear-items") " and " (:code "selection") " specialize on the new class. Indices are current zero-based positions, not stable row identities or item-data pointers. Keep durable identities in application data. There is no native per-item Lisp value/data ownership, label editing, checkboxes, multiselect, native sorting, custom attributes/renderers or image list in this slice.") (:p "Programmatic selection is silent by default; " (:code ":notify t") " permits the native selected/deselected notification sequence, without promising a synthetic single event or exact count. Selection reads return an index or NIL. NIL clears it. Item/count mutations are silent. All list writes reject callbacks, including a virtual text provider; structural changes require quiescence or an owner-bound deferred UI action. Reads remain GUI-thread/lifetime checked. Native operations and actual/propagated callbacks protect the list and ancestors against destruction, close and nested GUI/modal/clipboard entry. Private native handler stacks remain owned; managed stack access is not supported.") (:heading 2 "Virtual REPORT lists") (:code-block "lisp" "(defparameter report
  (wxlambda:make-list-control parent :virtual-p t
    :item-text-function
    (lambda (control row column)
      (declare (ignore control))
      (format nil \"Row ~D / column ~D\" row column))))
(wxlambda:insert-list-column report 0 \"Generated\")
(setf (wxlambda:item-count report) 1000000)
(wxlambda:refresh-list-items report 0 100)") (:p "Only virtual lists support SETF " (:code "item-count") ", from0 through10000000; positive counts require columns. They do not allocate a Lisp row array or copy all row strings into a native table. Native paint, layout, accessibility and explicit text queries request cells as needed, so request counts/order are not stable. Providers should read ready application data quickly. Update that data before publishing a new count, then refresh changed ranges. Timers/deferred actions remain GUI-thread mechanisms; worker results must reach application data through a separately safe handoff. The provider is not a background worker or streaming scheduler.") (:p "Virtual lists require a registered public container parent chain: frame, panel, scrolled-panel, drawing-canvas, web-view, notebook, aui-notebook or splitter-window. Public Lisp subclasses retain their usual native identities and are supported. Unregistered/native-private panels, arbitrary control ancestors and the built-in modal prompt hierarchy reject before allocation. This bounds the inherited native mutators that must preserve a pure text-provider query; stored report lists retain the usual parent WINDOW contract.") (:p "The native virtual method is " (:code "wxListCtrl::OnGetItemText") ". Its adapter invokes the public CLOS " (:code "list-item-text") " generic for the canonical receiver under a guarded native callback. A subclass may specialize that generic instead of supplying " (:code ":item-text-function") "; the default virtual method calls the constructor function with " (:code "(control row column)") ", or returns an empty string if no function is supplied. Nonvirtual defaults read the native stored text. Public virtual text queries pass through the same native hook. Virtual SETF text/append/delete reject; change the application provider data and native item count/refresh instead.") (:p "This is a native virtual-hook bridge, not a synthetic event. No event context or raw wx pointer is passed. The function/control is strongly rooted by a numeric token while native ownership is live. A scoped numeric request permits exactly one synchronous UTF-8 reply, copied into native storage before the callback returns; stale replies and replies from another nested callback reject. Returned text is NUL-free and at most65536 UTF-8 bytes. Same-control recursive provider queries reject. Ordinary Lisp errors retain their original condition; nonlocal exits are converted to a contained error. The native hook returns empty text on failure and Lisp re-signals at its safe surrounding boundary. No exception may unwind through native paint/layout. An unexpected native bridge failure is also contained and reported on the next list API boundary.") (:p "Provider calls suspend outer borrowed event contexts and hold source/ancestor guards. Native list writes, inherited source/container relayout/visibility/enabled and caption/name writes, destruction and nested GUI entry reject until return. Native construction is unavailable during a provider. Other existing controls retain their callback contracts; providers should avoid side effects. Parent destruction/accepted Destroy retires the provider before composite teardown. Refused/throwing Destroy restores its guards. Session reaping and shutdown release callback roots; late teardown requests never call Lisp.") (:heading 2 "List notifications and context menus") (:p "Native-only notify kinds are " (:code ":list-item-selected") ", " (:code ":list-item-deselected") ", " (:code ":list-item-activated") ", " (:code ":list-item-right-click") ", " (:code ":list-cache-hint") " and " (:code ":list-column-click") ". " (:code "event-list-index") " applies to the first four; " (:code "event-list-column") " to column clicks; " (:code "event-list-cache-range") " returns a fresh native " (:code "(from to)") " pair for hints; " (:code "event-list-position") " returns native client coordinates for item right-click. Cache ranges are native hints, not provider request/authorization guarantees. Activation/selection notifications are already committed; veto metadata does not undo them. Item right-click is not a portable keyboard context-menu API; the existing generic " (:code ":context-menu") " input event remains available for keyboard/native context requests.") (:p "Snapshots copy metadata; contexts are innermost-callback borrowed views. Payloads, IDs and timestamps are read-only. Normal Skip/propagation controls remain. No owned/synthetic/cloned list events or raw client/item data are exposed.") (:heading 2 "Existing tree extensions") (:p "The existing " (:code "tree-control") " and generation-checked canonical " (:code "tree-item") " views now support native " (:code ":tree-item-activated") ", " (:code ":tree-item-menu") ", " (:code ":tree-item-expanding") ", " (:code ":tree-item-expanded") ", " (:code ":tree-item-collapsing") " and " (:code ":tree-item-collapsed") " events. " (:code "event-tree-item") " retains the checked item identity; no raw " (:code "wxTreeItemId") " escapes. " (:code "event-tree-position") " returns a fresh native menu point; native keyboard/port sentinels and coordinate policy are preserved. Item snapshots freeze identity, not mutable label/decorations or lifetime.") (:p "EXPANDING/COLLAPSING can veto native changes. A consuming scoped handler must leave Skip false when vetoing; skipped/unhandled events may ignore veto. EXPANDED and COLLAPSED are observational. Same-tree writes and structural edits reject during all these native callbacks, including ancestor propagation. Capture item identity and defer edits or modal work. The existing wxQt tree construction gate remains.") (:code-block "lisp" "(setf (wxlambda:tree-item-bold-p item) t
      (wxlambda:tree-item-foreground item) #x28558a
      (wxlambda:tree-item-background item) #xf0f5fa)
(setf (wxlambda:tree-item-foreground item) nil) ; restore native default
(setf (wxlambda:tree-item-has-children-p item) t)") (:p "Bold is a generalized boolean. Colours are copied packed0xRRGGBB integers or NIL when the native colour is invalid. SETF NIL clears an explicit colour; some ports return the effective default RGB afterward. " (:code "tree-item-has-children-p") " maps the native potential-children/expander hint, not the actual child-list length; clearing it does not delete children. This supports a lazy-loading pattern: mark a possible branch, veto its first expansion, defer loading/insertion, then request expansion after data is ready. It does not add a filesystem or lazy model abstraction. Owned/synthetic/cloned tree event families remain unsupported.") (:p "Native prerequisites: wxUSE_LISTCTRL and existing wxUSE_TREECTRL/core. Native GUI calls and provider roots are main-thread/session owned; physical input, hosted GTK/MSW/Qt behavior and accessibility fidelity require separate checks. This is a bounded wxWidgets3.2.12 list/tree adapter, not complete ListCtrl/DataView parity.") (:heading 2 "Example and checks") (:p "Run " (:code "sbcl --load ~/quicklisp/setup.lisp --load examples/report-views.lisp --eval '(wxlambda-report-views:start)'") ". The " (:code "exercise") " entry point checks the million-row provider and copied values without manual input. " (:code "tests/report-views.lisp") " additionally verifies CLOS subclass initialization/rollback, provider errors/nonlocal containment, suspended outer contexts, tree veto and root cleanup. The native harness checks native list selection and tree expansion, nested supported containers, read-only provider ancestor operations and callback retirement. These derived event fixtures do not claim physical gesture coverage."))))
(:entry "guide/docs/SCROLLING-PANELS.md" :names ("docs/SCROLLING-PANELS.md" "SCROLLING-PANELS") :kind :guide :kind-name "Guide" :summary "docs/SCROLLING-PANELS.md" :sections (("Guide" (:heading 1 "Bounded scrolling panels for larger forms") (:p "ABI49 adds native-backed " (:code "scrolled-panel") ", a WINDOW subclass using wxScrolledWindow (wxScrolled<wxPanel>) for child controls. Required " (:code ":parent") " is a window and " (:code ":scroll-rate") " defaults to " (:code "(0 16)") ": horizontal disabled, vertical16 pixels per unit. The exact two-integer list accepts0..256 per axis; zero disables that axis, including " (:code "(0 0)") ". Native baseline wxWidgets3.2.12; wxUSE_SCROLLBAR is required. This is a control container, not a drawing canvas or a full wxScrolled binding.") (:code-block "lisp" "(let ((viewport (wxlambda:make-scrolled-panel parent :scroll-rate '(0 16))))
  (wxlambda:make-column viewport)
  (dotimes (index 24)
    (wxlambda:add-child viewport
      (wxlambda:make-text viewport :value (format nil \"Field ~D\" index))))
  (wxlambda:fit-scroll-content viewport)
  (setf (wxlambda:scroll-position viewport) '(0 10)))") (:p (:code "make-scrolled-panel") " is a thin generic factory with validated " (:code ":class") " and forwarded subclass initargs. Direct subclasses support slots/default initargs, native properties in AFTER hooks and managed failure rollback. Its Lisp base is WINDOW, not concrete PANEL, preserving one native kind per construction. Notebook pages and splitter panes requiring PANEL can contain a scrolled panel inside an ordinary page/pane panel. Lisp subclassing does not implement C++ virtual hooks. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ".") (:heading 2 "Layout, extent and scroll units") (:p "Existing " (:code "make-column") ", " (:code "make-row") ", " (:code "add-child") ", spacers and " (:code "layout-window") " work with the scrolling container. Children must have it as their direct parent. Place the viewport in its outer row/column with " (:code ":proportion 1 :expand t") " so it receives available viewport space instead of requesting the whole document height.") (:p (:code "fit-scroll-content") " requires an attached sizer and runs Layout/FitInside/Layout. It refreshes the virtual document size from the sizer minimum and client viewport; it does not resize the frame. Use it after content/layout changes. Layout alone need not refresh extent immediately; native size events may also recalculate it.") (:p (:code "scroll-extent") " returns a fresh " (:code "(width height)") " list of current virtual pixels, not scroll units, requested minimum, viewport size or scrollbar dimensions. " (:code "scroll-rate") " reads/writes a fresh/list pair of native pixels per unit. Rate changes can change pixel origin and clamp positions; no preservation guarantee. " (:code "scroll-position") " reads native view-start " (:code "(x y)") " in scroll units. SETF accepts exactly two nonnegative integers up to1000000; native code clamps to its content/ viewport range and ignores disabled axes. It returns the supplied list, not the accepted/clamped value; read back actual position. " (:code "-1") " unchanged-axis sentinels are not exposed. Lists are copied/not retained; there is no scalar/partial setter.") (:p "Native focus auto-scrolling, resize and platform scrollbar behavior can change positions independently of these setters. Content extent is supported up to 1000000 pixels per axis. Explicit fit/rate/position operations check current virtual/client dimensions and attached sizer minimum before native mutation; oversized content rejects. Existing layout/native automatic resizing is not globally policed by this new limit: applications must keep content within the supported bound. No claim of arbitrary huge sizer arithmetic safety follows. Rate/position argument bounds keep requested products below signed-int limits.") (:heading 2 "Callback safety and native helper ownership") (:p "Scroll can synchronously repaint/update before moving children. Rate/position writes and fitting reject during any event callback; defer them with an owner-bound action. The native operation holds existing Input lifetime and nested-entry guards so callbacks during synchronous native work cannot destroy/ close the viewport/ancestors or enter modal/clipboard/RUN/pump/safe-idle work. Painting is allowed to run; no whole-operation event blocker is installed. No new scroll event observer or explicit notification option is exposed.") (:code-block "lisp" "(wxlambda:on-click top-button
  (lambda ()
    (wxlambda:defer-ui-action
      (lambda () (setf (wxlambda:scroll-position viewport) '(0 0)))
      :owner viewport)))") (:p "wxWidgets owns a private pushed scroll-helper handler. Preserve it. Managed " (:code "window-event-handler") ", " (:code "push-event-handler") ", " (:code "pop-event-handler") ", " (:code "remove-event-handler") ", " (:code "process-window-event") " and " (:code "process-window-event-locally") " reject on SCROLLED-PANEL rather than adopting/removing that helper. Ordinary bindings and child command propagation still work. Native teardown owns helper cleanup. There is no scroll-helper/native pointer adoption, drawing/DC preparation, custom target window, coordinate conversion, focus policy override, physical scroll event API or complete scrollbar/style parity in this slice.") (:heading 2 "Example and verification") (:p (:ref "example/examples/scrolling-panels.lisp" "examples/scrolling-panels.lisp") " builds24 editable fields in a bounded viewport with a deferred Back to top button. START is interactive; EXERCISE verifies extent, actual scrolling and deferred return.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/scrolling-panels.lisp --eval '(wxlambda-scrolling-panels:start)'
sbcl --noinform --non-interactive --load ci/setup.lisp --load tests/scrolling-panels.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/scrolling-panels.lisp") (:p "Lisp checks cover native/subclass/factory construction, pair validation/copying, clamp/disabled axes, fit without frame resizing, callback deferral, private-handler API refusal, rollback and stale handles. Native probes test raw arguments and oversized content. A test-only native ScrollWindow override injects a supported callback inside actual bridge scrolling to check operation lifetime/reentry protection independently of ordinary callback rejection. This is not physical scrollbar or painting/accessibility validation. Runtime evidence is macOS3.2.12; generic/GTK native scrolling and common window behavior were source-reviewed. Hosted Linux/Windows/Qt GUI, physical wheel/trackpad/keyboard/focus navigation, painting fidelity, DPI/resize combinations and graphical Cadre remain unverified. Automatic tests do not read/replace system clipboard contents. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/SEARCH-CONTROLS.md" :names ("docs/SEARCH-CONTROLS.md" "SEARCH-CONTROLS") :kind :guide :kind-name "Guide" :summary "docs/SEARCH-CONTROLS.md" :sections (("Guide" (:heading 1 "Search controls and Lisp-native filtering") (:p "ABI54 adds native-backed " (:code "search-control") ", generic " (:code "make-search-control") ", generic " (:code "search-hint") "/SETF and TEXT/SETF methods for the new receiver. The control is an editable single-line query field with native search/cancel gestures. Filtering is application policy; the widget does not search a collection on its own.") (:code-block "lisp" "(defparameter query
  (wxlambda:make-search-control parent :value \"λ\" :hint \"Find records\"))
(wxlambda:text query) ; fresh native query string
(setf (wxlambda:text query) \"notes\") ; silent
(setf (wxlambda:text query :notify t) \"notes\") ; one TEXT event
(setf (wxlambda:search-hint query) \"\") ; silent placeholder update") (:p (:code ":parent") " is a required WINDOW, " (:code ":value") " defaults to " (:code "\"\"") " and " (:code ":hint") " to the literal " (:code "\"Search\"") ". Both fields accept copied UTF-8 strings with explicit byte lengths and reject NUL/CR/LF. Empty query and hint strings are valid. Reads are fresh native strings, not retained input storage; SETF returns the supplied string. Native readback, caret/selection changes and presentation remain native. There is no multiline/read-only/style/menu/raw-adoption API for this slice.") (:p "SEARCH-CONTROL inherits Lisp WINDOW, not TEXT-CONTROL, because wxSearchCtrl is not a wxTextCtrl subclass on every native port. Only the bounded TEXT property and search-specific hint property are added: text editing/selection/insertion APIs and ON-TEXT-CHANGE convenience methods retain their existing receiver scope. Direct MAKE-INSTANCE subclasses support slot initargs/defaults and native-ready AFTER hooks, with native/root rollback if initialization fails. The generic factory validates " (:code ":class") " and forwards subclass initargs. Lisp subclasses do not add native C++ virtual overrides. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ".") (:heading 2 "Native gestures and explicit application policy") (:p "Use BIND-EVENT with existing " (:code ":text-change") " plus new native-only " (:code ":search") " and " (:code ":search-cancel") " command kinds:") (:code-block "lisp" "(wxlambda:bind-event query :search
  (lambda (event)
    (format t \"Native search payload: ~S~%\" (wxlambda:event-text event))))") (:p "Search/cancel snapshots copy native GetString, including empty strings. They do not infer the query from the widget or promise that payload and live query match. Observers automatically Skip; contextual callbacks have ordinary explicit Skip/ propagation behavior. Context string metadata may be written without editing the query; snapshots remain immutable. Source-bound TEXT event string metadata writes reject because native TEXT payloads may lazily read the editor. This rejection also applies to generic search ports lacking the native text-entry hook, giving this new receiver one portable metadata-write rule. Generic TEXT owned/synthetic/cloning support retains its established scope; new search/cancel kinds reject owned/synthetic construction and detached clones.") (:p "Programmatic TEXT writes are silent by default; " (:code ":notify t") " emits exactly one native TEXT event even unchanged, after ChangeValue. It does not emit search or cancel. Hint writes are silent and have no notify option. Original callback conditions re-signal after the native setter returns with committed text retained. There is no public synthetic submit/cancel operation in this slice; applications can call their own filtering function independently of native gestures.") (:p "The bridge requests both native icons and wxTE_PROCESS_ENTER at construction. Their actual visibility and gestures remain port policy: GTK SearchEntry shows search permanently and cancel automatically when nonempty; its search icon is inactive and does not submit. Generic/GTK Enter submission normally suppresses empty queries. Cocoa may interpret an empty action as cancel. Cancellation can clear native text before or during dispatch, and event text may be empty. Native TEXT/search/cancel count/order and cancel default effects are not normalized by the bridge. Consuming an event does not guarantee restoring text already changed natively. No button visibility query/write protocol is exposed.") (:p "Actual search/cancel/TEXT origins, propagated callbacks and composite-child TEXT use shared Input guards: same-control query/hint writes, source/ancestor destroy/ close and nested GUI/RUN/pumps, modal/clipboard entry and safe-idle delivery reject. Silent cross-search writes remain supported. Creation, early managed Destroy and native-base teardown suppress relevant input callbacks; surviving native refusal/ exception restores the guard state. Saved snapshots outlive callback/session; borrowed contexts obey current-innermost lifetime/expiry.") (:p "Use owner-bound deferred actions to implement cancel or filtering after native processing. For example, explicit clearing avoids assuming a portable cancel side effect:") (:code-block "lisp" "(wxlambda:bind-event query :search-cancel
  (lambda (event)
    (declare (ignore event))
    (wxlambda:defer-ui-action
      (lambda ()
        (setf (wxlambda:text query) \"\")
        (filter-records)) :owner query)))") (:p "The " (:ref "example/examples/search-controls.lisp" "example") " filters a Lisp list into LIST-BOX items using CHAR-EQUAL substring matching, not locale/Unicode search collation. TEXT/search callbacks defer filtering and read the query at delivery time; cancel and the Clear filter button defer an explicit clear plus filtering. Owner removal cancels the pending action. This is an example policy, not native search behavior. See " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") ".") (:heading 2 "Build and verification scope") (:p "CMake requires wxUSE_SEARCHCTRL=1 and wxUSE_TEXTCTRL=1; native linkage remains core/base/adv (adv is already required by date/time controls). Tests cover copied Unicode fields, validation, silence/explicit TEXT notify, CLOS rollback, native search/cancel/TEXT events outside setters, propagation, composite input/teardown, TEXT clone preservation and callback ABI string copies. The Lisp callback-copy probe is a fabricated ABI payload, not a native gesture simulation.") (:p "Physical typing/IME/Enter/search/cancel input, locale/collation/accessibility, port icon presentation and hosted Windows/Linux/Qt GUI behavior remain unverified, as does graphical Cadre. Native event/early teardown probes run on macOS; source audits describe generic/GTK differences without claiming hosted tests. Tests never read or overwrite system clipboard contents. See " (:ref "guide/docs/DOCSET.md" "Cadre installation") ", " (:ref "guide/docs/TEXT-EDITING.md" "text editing") " and " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/srchctrl.h" "native search reference") "."))))
(:entry "guide/docs/SESSION-EVENTS.md" :names ("docs/SESSION-EVENTS.md" "SESSION-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/SESSION-EVENTS.md" :sections (("Guide" (:heading 1 "Session events and logging-off metadata") (:p "The wxWidgets 3.2.12 close family includes " (:code ":query-end-session") " and " (:code ":end-session") ", alongside window " (:code ":close") ". EVENT-FAMILY returns " (:code ":close") " for all three. EVENT-TYPE returns their process-local native tags; immutable snapshots retain kind, native type, ID, CanVeto, pre-callback veto and logging-off metadata after callback and session cleanup. Native bridge ABI: 18.") (:p "Bind native session tags on CURRENT-APPLICATION-HANDLER with BIND-EVENT. The operating system routes these events to wxApp; window receivers reject session bindings. Existing observer callbacks Skip after delivery. Contextual callbacks start unskipped and choose whether to delegate with EVENT-SKIPPED-P. Native query/default policy and OS behavior remain in wxWidgets. Default END_SESSION handling can terminate the process. An observer or callback error that Skips can therefore reach that default. Do not use an observer to prevent shutdown, and do not infer that a consumed event can cancel an irrevocable OS shutdown. Any veto write requires EVENT-CAN-VETO-P true, including writes of NIL.") (:p "This slice installs/removes application bindings locally but does not trigger real OS logout/shutdown. Native delivery and OS policy remain unverified on all ports; the declaration mappings remain partial. In particular, support for native session notifications varies by wxWidgets port. There is no managed shutdown transaction, persistence hook, native wxApp override or guarantee that all platforms deliver both events or permit veto.") (:heading 2 "Logging-off access") (:p "EVENT-LOGGING-OFF-P is a generic reader for a saved session snapshot or the current innermost session-event context. True means logging off; NIL means system shutdown. SETF changes the current native session event's flag and returns the supplied generalized boolean. This changes event metadata, not OS intent. Snapshots are immutable and preserve pre-callback state. Non-session snapshots signal a Lisp error; non-session/expired/suspended contexts signal NATIVE-ERROR. Native context access requires the active main-thread session. No SETF method exists for snapshots.") (:p "QUEUE-EVENT and PROCESS-EVENT accept " (:code ":logging-off-p") " (default NIL) only for session kinds, and " (:code ":can-veto-p") " (default T) for all close-family kinds. These are synthetic construction defaults, including CanVeto T for synthetic END_SESSION; native OS events retain their actual flags and may be non-vetoable. Initial " (:code ":vetoed-p") " remains restricted to registered notify types. Session construction rejects command text, integer, selection and toggle payloads. PROCESS-EVENT returns native handled-p and final-vetoed-p independently.") (:heading 2 "Isolated synthetic probes") (:p "Synthetic session dispatch/queueing requires an owned standalone EVENT-HANDLER. The native bridge rejects application and window receivers before creating or queueing the event. The internal standalone native handler suppresses wxApp fallback specifically for the two session tags. This matters even with no matching binding, a skipped observer or disabled handler: ordinary wxEvtHandler TryAfter can otherwise forward an unhandled event to the application and run its shutdown defaults. Other event kinds retain their native fallback behavior. Synthetic probes never simulate OS delivery or change the real session.") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((receiver (wxlambda:make-event-handler))
         (binding (wxlambda:bind-event receiver :query-end-session
                    (lambda (event context)
                      (declare (ignore event))
                      (when (wxlambda:event-can-veto-p context)
                        (setf (wxlambda:event-vetoed-p context) t)))
                    :with-context t)))
    (unwind-protect
         (wxlambda:process-event receiver :query-end-session :logging-off-p t)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))") (:p "Run the isolated example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/session-events.lisp --eval '(wxlambda-session-events:start)'") (:p "The regression also checks both kinds, unmatched/observer/disabled fallback isolation, queue copies, native application binding removal without emission, window binding rejection, synthetic receiver guards, snapshot independence, nested context suspension/expiration and guarded veto. No real OS logout or shutdown is used in automated checks.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " now adds timestamps, command classification and current close-family SetCanVeto, including explicit false-to-true changes. These do not grant OS shutdown cancellation. Persistent event objects/cloning, mutable native types/origin, derived notify classes, pushed handlers, timer/idle and worker dispatch remain required C1 work. Scoped ID mutation and routing are now implemented; next define native type/origin contracts before broader event ownership/families.") (:p "Build/check using " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install using " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/APPLICATION-HANDLER.md" "application identity") ", " (:ref "guide/docs/CLOSE-EVENTS.md" "close events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/SPLITTER.md" :names ("docs/SPLITTER.md" "SPLITTER") :kind :guide :kind-name "Guide" :summary "docs/SPLITTER.md" :sections (("Guide" (:heading 1 "Splitter panes") (:p (:code "splitter-window") " manages one or two attached panel panes. Construct with " (:code "make-splitter-window") " or native-backed " (:code "make-instance") ", create two distinct " (:code "panel") " children, lay out controls inside those panels, then call " (:code "(split-window splitter first second)") " outside RUN, pumps and callbacks. " (:code "split-window") " attaches the initial two panes to an empty splitter. " (:code "splitter-pane") " indexes 0 and 1 and returns canonical panel wrappers (NIL before attachment). The splitter owns attached panes; destroy their splitter or ancestor instead of destroying individual panes. Do not install a row/column sizer on the splitter itself.") (:p (:code ":orientation") " initially selects " (:code ":vertical") " for left/right (default) or " (:code ":horizontal") " for top/bottom. ABI57 adds generic SETF " (:code "splitter-orientation") " at a safe structural boundary; it retiles current panes using native geometry. Other generic SETF properties are " (:code "splitter-sash-position") " (default 0, native centering request), " (:code "splitter-minimum-pane-size") " (default 20, strictly positive), and " (:code "splitter-sash-gravity") " (default 0.5d0, real in [0,1]). Pixel arguments are bounded by 536870911; sash positions are nonnegative. Native geometry is clamped and may be deferred until layout. Getters report native state; exact requested pixel geometry is not guaranteed. SETF returns the supplied Lisp value. Positive minimum size and suppressed sash double-click keep both panes attached. Explicit structural operations can change that attachment as described below.") (:heading 2 "Explicit pane changes") (:code-block "lisp" "(wxlambda:initialize-splitter splitter first-panel) ; empty -> one pane
(wxlambda:resplit-window splitter second-panel)    ; one -> two panes
(wxlambda:replace-splitter-pane splitter 1 replacement) ; returns old pane
(wxlambda:unsplit-window splitter :remove 1)       ; returns removed pane
(setf (wxlambda:splitter-orientation splitter) :horizontal)") (:p "Initialize requires an empty splitter. Resplit requires exactly one pane and adds its supplied panel as pane1. Replace addresses an existing pane0/1. Unsplit requires two panes; removal0 leaves the former pane1 at index0. New panes must be fully initialized distinct direct unsizered PANEL children of the splitter, without existing attachment. No reparenting or foreign window adoption occurs.") (:p "Removed/replaced panes are hidden and remain live native children. They can be reattached or explicitly destroyed; parent destruction invalidates them even while hidden and detached. Replacement explicitly shows the new pane and hides the old one. Canonical Lisp roots are published before native sizing/focus work and updated after native success. Callback conditions can escape after a native change has committed; these operations do not promise general rollback.") (:p "Initialize/Unsplit/Replace/Resplit and orientation SETF reject callbacks and require quiescence or an outer owner-bound deferred UI action. Explicit Unsplit does not synthesize or promise the sash-triggered UNSPLIT notification path. Native geometry may clamp or change during later layout.") (:p "Bind native-only notify events " (:code ":splitter-sash-changing") " and " (:code ":splitter-sash-changed") ". " (:code "event-sash-position") " reads immutable snapshots or current contexts; unrelated snapshots return NIL and unrelated contexts signal NATIVE-ERROR. Its SETF writer accepts only a current CHANGING context, with -1 to cancel or a bounded nonnegative position. CHANGING veto also cancels. The event must be handled: leave SKIP false at the consuming handler; skipped, unhandled native events can ignore edits/veto. CHANGED is observational: veto cannot undo the committed position, and its sash writer is rejected. Programmatic position writes are silent; resizing/gravity can emit CHANGED. Snapshots and owned events have no writer; construction, synthetic delivery and cloning of these event kinds are unsupported.") (:p "During a splitter operation or native/propagated sash callback, splitter-property writes, destruction of its panes/splitter/ancestors, closing its ancestor frames, modal dialogs, clipboard and nested dispatch/pumping are rejected. Defer these operations. CLOS subclass slots/default initargs and AFTER hooks work; failed managed initialization cleans up native children and callback roots.") (:p "Run the two-pane tree/list example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/splitter-manager.lisp --eval '(wxlambda-splitter-manager:start)'") (:p "Its EXERCISE function runs inside an active application session and verifies model-driven tree/list navigation, canonical panes and sash updates. It is a small in-memory manager, with no filesystem operations. The tree backend is unavailable on wxQt pending safe asynchronous item identities. Physical sash interaction/accessibility and hosted Windows/Linux remain unverified.") (:p "Supported native scope: wxWidgets 3.2.12 wxSplitterWindow and wxSplitterEvent. Single-pane Initialize, explicit Unsplit/ReplaceWindow/resplit and orientation SETF are implemented. Arbitrary styles, resize/double-click/unsplit event bindings and complete native parity remain unbound. The dynamic workspace example in " (:code "examples/aui-notebook.lisp") " constructs panes through Initialize/Resplit; its EXERCISE also removes/replaces/reattaches panes and changes orientation while checking canonical identity. See " (:ref "guide/docs/AUI-NOTEBOOK.md" "dynamic AUI workspaces") ". See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ".") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/STANDARD-DIALOGS.md" :names ("docs/STANDARD-DIALOGS.md" "STANDARD-DIALOGS") :kind :guide :kind-name "Guide" :summary "docs/STANDARD-DIALOGS.md" :sections (("Guide" (:heading 1 "Modal text and single-choice dialogs") (:p "ABI 33 adds the abstract DIALOG window class and two concrete native-backed families: TEXT-ENTRY-DIALOG and SINGLE-CHOICE-DIALOG. This is a bounded extension of the form/editor GUI workflow after menus/actions. Platform-native message/file backends remain deferred after cancellation probes. " (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "Generic message/file workflows") " now provide a separate, explicit wxWidgets GUI implementation; this guide covers the text/choice families. The baseline is wxWidgets 3.2.12.") (:heading 2 "Construct a dialog and obtain a result") (:code-block "lisp" "(let ((dialog (wxlambda:make-text-entry-dialog
               :parent frame :message \"Document name\" :title \"Rename\"
               :value \"Untitled\")))
  (unwind-protect
       (when (eq :ok (wxlambda:show-modal dialog))
         (save-name (wxlambda:dialog-value dialog)))
    (wxlambda:destroy-window dialog)))") (:p "Construction is allowed on the GUI thread inside callbacks, RUN and pumps, so menu actions can create dialogs; menu structural-edit guards do not apply.") (:p "The keyword-only MAKE-TEXT-ENTRY-DIALOG and MAKE-SINGLE-CHOICE-DIALOG factories remain ordinary functions, with validated :CLASS subclass support. Direct MAKE-INSTANCE uses the same :PARENT/:MESSAGE/:TITLE and family-specific initargs. Parent is optional; when supplied it must be a live managed window. A receiver or ancestor pending native destruction is unavailable even before native IsBeingDeleted becomes true: bridge markers and the public wxApp scheduled- deletion list both participate in validation. SHOW-MODAL rejects before entering the native loop when the dialog or an ancestor is already scheduled for deletion. The bridge normalizes the actual native parent to that requested window, even when hidden. NIL means truly parentless; native automatic parent selection is undone. Unicode strings must not contain NUL; empty message/title/value strings are accepted. SINGLE-CHOICE-DIALOG requires a nonempty list/vector of strings in :ITEMS. :SELECTION defaults to zero and must remain an in-range nonnegative integer; NIL does not mean no selection in this bounded dialog API.") (:p "The DIALOG base is abstract. Subclass slots, :DEFAULT-INITARGS and AFTER hooks follow the native-backed CLOS protocol; native properties exist before the subclass AFTER hook. Invalid/mixed managed construction rejects before allocation. Initialization failure cleans newly allocated dialog resources and callback roots, without reversing arbitrary edits to preexisting external resources. Dialogs are managed windows: ordinary DESTROY-WINDOW, parent ownership and stale handle checks control native lifetime. No Lisp GC finalizer owns native deletion.") (:heading 2 "Native modal loop and scoped callbacks") (:p "SHOW-MODAL returns :OK or :CANCEL. It may run from a menu/event callback, a RUN loop or a native pump. Only one public managed modal call may be active: nested public SHOW-MODAL calls and already-shown dialogs reject. Guarded internal generic file prompts are described in the separate message/file guide. Native modal processing enters its own callbacks while SHOW-MODAL waits. The outer borrowed event context is suspended throughout SHOW-MODAL, including intervals without an inner callback. Each inner context is valid only in its own current innermost callback. After SHOW-MODAL returns, the outer context can resume under its ordinary lifetime rules.") (:p "Bare callback errors are retained at the bridge boundary, cancel the modal loop and re-signal the primary Lisp condition after native unwind. A nested notifying operation whose condition is caught locally can recover without cancelling the modal interaction. This does not allow Lisp conditions to unwind through C++. Manual RUN/pump/finish and structural menu edits remain guarded while the modal call is active; the native modal loop owns dispatch. STOP requests exit of an outer RUN loop, if one is running; use END-MODAL to dismiss the current prompt.") (:p "END-MODAL accepts :OK or :CANCEL, calls native EndModal directly and returns the dialog object. It does not simulate an OK/Cancel button, run button validation or perform native data transfer. A programmatic :OK result therefore does not prove that native form acceptance/transfer occurred. DIALOG-MODAL-P reports current native IsModal; that can become false after END-MODAL before SHOW-MODAL returns. The bridge still rejects destruction of the active dialog and all its ancestors until the modal call has fully returned. Unwind cleanup should destroy after SHOW-MODAL exits. Native close of the current dialog is consumed and cancels the modal loop; ancestor close events are consumed while the modal call is active. Public CLOSE-WINDOW on a protected ancestor rejects. This keeps a queued/native close from bypassing the lifetime guard.") (:p "These dialogs are modal-only. SHOW-WINDOW and SHOWN-P SETF reject them; the SHOWN-P reader and supported generic window operations retain their documented native semantics. Use SHOW-MODAL to show them. Arbitrary modeless/window-modal, custom button/validator, native adoption and virtual Lisp-dialog hooks are outside this slice.") (:heading 2 "Stored values and selection") (:p "DIALOG-TITLE reads/writes the native title and permits scalar changes during callbacks. DIALOG-VALUE reads/writes native TEXT-ENTRY-DIALOG stored value. GetValue need not return an unaccepted live text-control edit buffer. Its writer crosses a notifying callback boundary, so callback conditions return through the existing Lisp protocol. Use normal user acceptance when native validation/data transfer is part of the desired workflow.") (:p "DIALOG-SELECTION reads/writes a valid SINGLE-CHOICE-DIALOG index. The items are fixed at construction. DIALOG-SELECTION-TEXT reads native GetStringSelection, the last accepted native selection-string cache rather than a string derived from the current index. SetSelection changes the index, but GetStringSelection can stay empty until an actual OK-button transfer; a previous accepted cache can remain after index changes or raw END-MODAL. Do not assume a programmatic :OK result synchronizes accepted-value caches. No arbitrary clientData pointers, item mutation, multiselect or radio/list-control ownership interface is added.") (:heading 2 "Example, native probe and next scope") (:p (:ref "example/examples/standard-dialogs.lisp" "standard-dialogs.lisp") " provides a programmatic exercise for the bounded modal protocol. START opens an interactive text prompt:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/standard-dialogs.lisp \\
  --eval '(wxlambda-standard-dialogs:start)'") (:p "For deterministic native cancellation without user input, run EXERCISE in a managed session:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/standard-dialogs.lisp \\
  --eval '(wxlambda:with-application () (wxlambda-standard-dialogs:exercise))'") (:p "The exercise binds native idle, ends one actual text-dialog modal loop with :CANCEL and checks preserved stored value and cleanup. It does not exercise graphical acceptance or the choice dialog; those require separate evidence. Current verification evidence is kept in the " (:ref "guide/IMPLEMENTATION.md" "handoff") ".") (:p "The macOS exploratory native message/file cancellation probe hung past its five-second watchdog even when native IsModal was false; those platform-native backends remain unbound. The separate generic backend uses guarded native wxWidgets GUI controls instead. Text-entry/single-choice native cancellation completed promptly in the bounded probe. This is platform evidence, not proof of Windows/Linux behavior or a public guarantee about elapsed time.") (:p "Continue the form/editor open/save workflow with the explicit " (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "generic message/file API") ", retaining platform-native backends as a separate gap. Do not drain unrelated native event ownership utilities. Graphical user acceptance, validation, OS-native dialog conventions and cross-platform GUI behavior require their own reports; the native declaration inventory remains factual and partial.") (:p "ABI37 rejects synchronous modal entry during notebook navigation/page callbacks or list/tree-origin callbacks; defer prompts to later application work. See " (:ref "guide/docs/NOTEBOOK.md" "notebook navigation") "."))))
(:entry "guide/docs/STYLED-TEXT.md" :names ("docs/STYLED-TEXT.md" "STYLED-TEXT") :kind :guide :kind-name "Guide" :summary "docs/STYLED-TEXT.md" :sections (("Guide" (:heading 1 "Native styled text control") (:p "ABI57 binds " (:code "wxStyledTextCtrl") " as " (:code "styled-text-control") ", a WINDOW subtype with native-backed CLOS construction. " (:code "make-styled-text-control") " is a thin generic factory with " (:code ":class") " and forwarded subclass initargs. Required " (:code ":parent") " is a live WINDOW; " (:code ":value") " defaults to the empty string. Subclasses support slots, " (:code ":default-initargs") ", native properties in AFTER hooks and managed failure rollback. The " (:code "stc") " component and " (:code "wxUSE_STC") " are build prerequisites.") (:p "The binding exposes native editing/rendering facilities. It does not implement document buffers, parsing, highlighting decisions, paredit, refactoring, key sequences, language services or file IO. Those belong in the application.") (:heading 2 "Positions, encoding and changes") (:p "The native code page is fixed to " (:code "wxSTC_CP_UTF8") ". Every document position, selection endpoint and changed-range length is a " (:b "UTF-8 byte offset") ", not a Lisp string index, UTF-16 offset, glyph number or screen column. Ranges are half-open " (:code "[start,end)") ". Line indices are zero-based. Native columns include tab expansion policy and are not portable character indices. Point conversions use native client coordinates, not global screen coordinates or automatic DIP units.") (:p (:code "stc-text") " reads a fresh string; generic SETF replaces the document through native target-range editing. " (:code "stc-text-range") " retrieves a checked range and " (:code "replace-stc-range") " replaces one. The bridge validates endpoints at UTF-8 character boundaries before native calls. Explicit raw lengths preserve embedded NUL and supplementary characters. Native inputs must be valid UTF-8; a native string/pointer never escapes to Lisp. Programmatic document edits are bounded to 64MiB; native user editing is not capped by that programmatic bound. Native position arguments use signed32-bit values. Borrowed getter storage is copied before another native call. GUI-thread/session/lifetime checks apply to reads too.") (:p "Unlike the older text-control silent setters, STC edits preserve actual Scintilla modification notifications. " (:code ":stc-modified") " snapshots copy " (:code "event-text") ", byte position/length, modification bit mask, lines added, native line and fold levels. Before-insert/delete flags describe impending changes; insert/delete flags describe completed changes. Notifications can also describe style/indicator/ marker changes without inserted text. Do not treat every notification as one completed edit. Undo/redo and native input use the same native notification path. " (:code "stc-modification-mask") " maps native " (:code "SetModEventMask") "; applications control the mask.") (:p (:code "event-stc-position") ", " (:code "event-stc-length") ", " (:code "event-stc-lines-added") ", " (:code "event-stc-modification-type") ", " (:code "event-stc-line") ", " (:code "event-stc-fold-level-now") " and " (:code "event-stc-fold-level-previous") " expose the corresponding native fields. Readers reject event kinds where the pinned wxWidgets API does not define the field. Snapshots remain usable after source destruction/session cleanup; contexts are borrowed only for the current innermost callback. Changed text is an independent string, including embedded NUL. Snapshot identity does not freeze the live document.") (:heading 2 "Selection, undo and edit policy") (:p (:code "stc-current-position") " and " (:code "stc-anchor") " have generic SETF writers. " (:code "set-stc-selection") " takes anchor/caret; it uses the native selection operation. " (:code "stc-selection-count") ", indexed " (:code "stc-selection-caret") "/" (:code "stc-selection-anchor") ", " (:code "stc-main-selection") ", " (:code "add-stc-selection") ", " (:code "drop-stc-selection") " and " (:code "clear-stc-selections") " expose native multiple-selection state. At least one selection is retained. " (:code "stc-multiple-selection-p") " and " (:code "stc-additional-selection-typing-p") " control native interaction policy.") (:p (:code "stc-selection-mode") " uses native values0 stream,1 rectangle,2 lines,3 thin rectangle. Rectangular anchor/caret and their virtual-space properties map native methods. " (:code "stc-virtual-space-options") " accepts the native bit mask0..7. Virtual-space counts are not additional document bytes. These APIs do not implement application multi-cursor editing policy or promise identical gestures on every backend.") (:p (:code "stc-undo") ", " (:code "stc-redo") ", capability readers, " (:code "begin-stc-undo-action") ", " (:code "end-stc-undo-action") ", " (:code "empty-stc-undo-buffer") ", " (:code "set-stc-save-point") " and " (:code "stc-modified-p") " use Scintilla history/save points. Pair grouped undo with UNWIND-PROTECT; unmatched END and nesting beyond64 reject. Emptying history during an active group rejects. Save points are native history state, not successful filesystem saves. " (:code "stc-read-only-p") "/SETF maps native read-only policy; bridge text edits and undo/redo reject while read-only. There is no implicit temporary bypass.") (:heading 2 "Application-controlled styling and decorations") (:p "Construction selects " (:code "wxSTC_LEX_CONTAINER") ", not a built-in language lexer. Applications supply style decisions using " (:code "start-stc-styling") " and " (:code "set-stc-styling") "; lengths count UTF-8 bytes. " (:code "stc-end-styled") " reads the native styling frontier for incremental work. " (:code "set-stc-style-bytes") " copies a simple unsigned-byte8 vector and calls native SetStyleBytes, one style byte per text byte, up to64MiB and within the current styling range. " (:code "stc-style-at") " reads the native style. " (:code "clear-stc-document-style") " clears document styling; " (:code "clear-stc-styles") " copies the native default style to style definitions (" (:code "StyleClearAll") "). They are different wxWidgets operations. Styles0..255 support foreground/background packed RGB (" (:code "#xRRGGBB") "), font face, size1..256 points, bold, italic and underline. Exact fonts, glyph fallback and rendering remain native policy.") (:p "The exception to ordinary callback mutation rejection is deliberately narrow: the current innermost actual " (:b "same-control `:stc-style-needed` callback") " may call StartStyling/SetStyling/SetStyleBytes synchronously. This is the native container-styling protocol. It permits no document edits, cross-control styling, property writes or reentrant styling from nested modification/input callbacks. Receiver/ancestor destruction and nested GUI/modal/clipboard entry remain guarded. Other styling work can use an owner-bound deferred action and recheck current document state.") (:p "Indicators0..35 have style/foreground/under properties, a current indicator and value, and fill/clear range operations. Indicator styles use native values0..21. Margins0..4 expose type0..6, pixel width, signed native mask and sensitivity. For line numbers, use native " (:code "wxSTC_MARGIN_NUMBER") " (1) and a nonzero margin width. Markers0..31 support native symbol definitions0..31, add/delete/delete-all and per-line marker masks. Marker-add results are native marker handles, not windows or adopted resources. Marker31 masks are read as unsigned32-bit values.") (:p (:code "stc-fold-level") " combines native level/flags within0..#x3fff (base#x400, white#x1000, header#x2000). Expanded/parent/visibility queries, toggle-fold, show/hide-lines and ensure-visible map native methods. The first line cannot be hidden through the bridge. The application supplies fold levels; no parser or automatic folding decisions are added. Wrapped display lines are outside this initial scope: native wrap mode is fixed to NONE.") (:heading 2 "Coordinates, scrolling and assistance") (:p "Line/position/column conversions, document/visible-line conversions, " (:code "stc-point-from-position") " and " (:code "stc-position-from-point") " expose checked native operations. A point not close to text returns NIL. " (:code "stc-first-visible-line") ", " (:code "stc-x-offset") ", " (:code "scroll-stc-lines") " and " (:code "ensure-stc-caret-visible") " expose native scrolling. Explicit scroll deltas are limited to ±1000000. Other nonnegative scalar counts/widths/times are bounded to10000000; signed native masks retain signed32-bit semantics. Document byte ranges have their separate64MiB limit.") (:p (:code "show-stc-autocomplete") " takes a native byte-prefix length and native item-list string (default separator space). Prefix start must be a UTF-8 boundary. Separator1..127, active/cancel/complete operations map native autocomplete. " (:code "show-stc-call-tip") " takes a byte position and native text; active/cancel queries map native call tips. Strings reject NUL and are bounded to1MiB. Completion lists, language intelligence and signatures come from the application.") (:heading 2 "Events and lifetime rules") (:p "Use ordinary " (:code "bind-event") ":") (:table :header (("Kind") ("Native meaning / fields")) :rows ((((:code ":stc-modified")) ("Changed text/ranges, modification mask, lines/fold metadata")) (((:code ":stc-update-ui")) ((:code "event-stc-update-mask") ": content/selection/scroll update flags")) (((:code ":stc-style-needed")) ("Requested end byte position; manual styling protocol")) (((:code ":stc-margin-click") ", " (:code ":stc-margin-right-click")) ("Byte position, margin and native modifier mask")) (((:code ":stc-dwell-start") ", " (:code ":stc-dwell-end")) ("Byte position and native client x/y; dwell time property")) (((:code ":stc-save-point-reached") ", " (:code ":stc-save-point-left")) ("Native save-point transitions")) (((:code ":stc-autocomplete-selection") ", " (:code ":stc-autocomplete-completed")) ("Native completion text and byte position")) (((:code ":stc-call-tip-click")) ("Native position/arrow indication, not an application command")) (((:code ":stc-need-shown")) ("Byte position/length requiring visibility")) (((:code ":stc-read-only-attempt")) ("Native refused edit notification")) (((:code ":stc-char-added")) ("Native " (:code "event-stc-key") "; not a portable IME composition event")))) (:p "Observers automatically Skip. " (:code ":with-context t") " receives snapshot/context and controls Skip/propagation explicitly. These are native command events, with read-only payload metadata; no synthetic/owned/cloned STC events or native pointer/clientData adoption. Typed reads expose only appropriate native fields. All mutations except the narrow styling protocol reject event callback use. Use " (:code "defer-ui-action") " for structural or deferred changes. Private native handler stacks cannot be replaced with managed Push/Pop/Remove operations.") (:p "Native controls retain normal text input/IME handling when events Skip. Consuming keys/characters changes that behavior; no portable IME composition API is claimed. Automatic tests cover real UTF-8/NUL edits/notifications, undo, selections, styling/folding/assistance, checked lifetimes and callback rules. Physical typing, IME/dead keys, arbitrary fonts/DPI and hosted Windows/Linux/Qt remain unverified. See the " (:ref "guide/docs/KRYPTONEDIT-COVERAGE.md" "survey/remaining batches") ", " (:ref "guide/docs/INPUT-EVENTS.md" "input routing") ", " (:ref "guide/docs/AUI-NOTEBOOK.md" "AUI tabs") ", " (:ref "example/examples/styled-text.lisp" "example") " and " (:ref "guide/docs/DOCSET.md" "Cadre docset") "."))))
(:entry "guide/docs/TEXT-EDITING.md" :names ("docs/TEXT-EDITING.md" "TEXT-EDITING") :kind :guide :kind-name "Guide" :summary "docs/TEXT-EDITING.md" :sections (("Guide" (:heading 1 "Multiline text and basic editing") (:p "ABI36 extends " (:code "text-control") " with multiline construction, user editability and native text offsets. Existing calls still create a single-line editable control:") (:code-block "lisp" "(wxlambda:make-text parent :value \"Name\")
(make-instance 'wxlambda:text-control :parent parent
               :value (format nil \"First λ~%Second 日本語 😀\")
               :multiline t :editable-p nil)") (:p (:code ":multiline") " defaults NIL and fixes the native multiline style at construction; " (:code "text-multiline-p") " reads it. " (:code ":editable-p") " defaults T; generic SETF " (:code "text-editable-p") " changes whether the user can type. Like wxWidgets, read-only is user-input policy: explicit Lisp " (:code "(setf text)") " and " (:code "replace-text") " still change its contents. Lisp subclass slots, " (:code ":default-initargs") " and native access from subclass AFTER hooks work with both options. Failed managed initialization destroys native controls and releases callback roots. The factory remains a thin validated " (:code ":class") " wrapper, with no separate multiline class or compatibility aliases.") (:heading 2 "Values and notifications") (:p (:code "text") " returns an independent Lisp string; SETF returns the supplied string. Constructor, setter and range replacement validate strings and reject embedded NUL, rather than silently truncating through a C string. Native UTF-8 interfaces carry explicit byte lengths. Multiline values use wxWidgets' LF-separated text format, including on Windows. Single-line newline handling remains native-port behavior. No styles for password, rich text, wrapping, tabs, Enter processing or input filters are added. Rich-text/STC controls and native file load/save are outside this slice.") (:p "Whole-value SETF is silent by default; " (:code ":notify t") " uses native SetValue instead of ChangeValue. " (:code "replace-text") " uses native Replace and its text-change notification:") (:code-block "lisp" "(wxlambda:replace-text control from to \"replacement λ\")") (:p "It replaces the half-open native range " (:code "[from,to)") ", inserts when endpoints are equal, and removes when the replacement is empty. It returns the supplied replacement string. Use silent whole-value SETF when notification is unwanted. Native caret, selection, modified state and undo effects follow the port; no stable undo/modified API or exact no-op callback count is promised. Callback conditions re-signal only after native code returns; the mutation can already have happened. A handled error allows subsequent edits. Normal native callback and deferred-destruction protections apply, including edits invoked from callbacks.") (:heading 2 "Native offsets") (:code-block "lisp" "(wxlambda:text-last-position control) ; native end offset
(wxlambda:text-insertion-point control)
(setf (wxlambda:text-insertion-point control) 0)
(multiple-value-bind (from to) (wxlambda:text-selection control)
  (wxlambda:replace-text control from to \"λ\"))
(setf (wxlambda:text-selection control)
      (list 0 (wxlambda:text-last-position control)))") (:p (:code "text-selection") " returns two integer values; its SETF writer accepts a proper list of exactly two integers and returns that same list. Setting the insertion point collapses selection according to native behavior. All accepted positions are nonnegative signed-64-bit integers, further bounded by the control's current native last position. Selection/replacement requires ordered endpoints. Invalid ranges signal, without native clamping; the wxWidgets " (:code "-1") " select-all/end sentinels are not exposed. Pass the actual end offset instead.") (:p "These are " (:b "native offsets, never portable Lisp string indices") ". Unicode encoding units and native CRLF bookkeeping can make them differ from " (:code "length") ", " (:code "subseq") " or character/grapheme counts. Obtain offsets from the control and pass them back to native editing APIs. Selection values apply to current content; edits can invalidate saved ranges. This slice does not expose GetRange, text-coordinate conversion, selection clipboard operations, Cut, undo/redo or arbitrary style flags. The " (:ref "guide/docs/CLIPBOARD.md" "clipboard") " remains a separate whole-string API.") (:heading 2 "Example and verification") (:p (:code "examples/text-editor.lisp") " creates a multiline editor, appends lines at the native end, replaces its current selection and toggles user editability. Its status reports native end offsets. The existing persistent form remains a single-line form; its four-line document format is not a multiline editor format.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/text-editor.lisp --eval '(wxlambda-text-editor:start)'
sbcl --load ~/quicklisp/setup.lisp --load examples/text-editor.lisp --eval '(wxlambda:with-application () (wxlambda-text-editor:exercise))'") (:p "The bounded exercise selects/replaces Unicode multiline text, receives native text-change callbacks and checks read-only state before cleanup. " (:code "tests/text-editing.lisp") " adds defaults/direct/factory subclasses and AFTER-hook rollback, silent SETF versus notifying replacement, native selection/caret/end, invalid ranges/type/NUL/overflow, callback error recovery, nested borrowed-context suspension, callback-time disposal and stale-resource checks. The native harness checks raw UTF-8/flags/output pointers, wrong/stale handles and bounds without wx assertions. Physical typing/selection, platform-specific IME/grapheme behavior, hosted Windows/ Linux and a complete multiline document application remain separate work. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") ", " (:ref "guide/docs/CLOS-API.md" "CLOS API") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/THREAD-EVENTS.md" :names ("docs/THREAD-EVENTS.md" "THREAD-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/THREAD-EVENTS.md" :sections (("Guide" (:heading 1 "Worker-to-GUI thread events") (:p "ABI58 adds " (:code "queue-thread-event") ", mapping copied string delivery to native " (:code "wxThreadEvent") " and thread-safe " (:code "wxEvtHandler::QueueEvent") ". The build requires " (:code "wxUSE_THREADS=1") "; disabling native wx locking is unsupported. Its receiver is an existing managed EVENT-HANDLER, including a window or standalone handler. Establish its internal posting endpoint by binding " (:code ":thread") " on the GUI thread before starting a worker:") (:code-block "lisp" "(wxlambda:bind-event receiver :thread
  (lambda (event) (format t \"Worker sent: ~A~%\" (wxlambda:event-text event))))
;; In a Lisp worker thread:
(wxlambda:queue-thread-event receiver \"Finished λ 😀\")") (:p "The call returns RECEIVER after copying/enqueueing the payload. It accepts a string of at most1MiB UTF-8, including embedded NUL; malformed native UTF-8 rejects. A posting worker may reuse/mutate its source after return. Do not mutate the same Lisp string concurrently while it is being encoded. Native code retains an independently owned native wxThreadEvent string, never the Lisp string, closure, wxAny value or raw user pointer. The worker constructs/uniquifies that native string and destroys all temporary wxString aliases before queue publication. Native GetString therefore reports the actual payload; native wxThreadEvent::Clone deep-copies it without copying queue-accounting reservations. The public owned-event clone API still rejects thread events. This operation does not create or manage Lisp worker threads.") (:p "Only " (:code "queue-thread-event") " is worker-safe. Binding/unbinding, receiver creation, GUI property access, event-loop entry, destruction and ordinary " (:code "queue-event") " retain their GUI-thread/session rules. The posting path does not consult the ordinary GUI/session registries, call GUI-ready validation or invoke Lisp GUI callbacks. No new public endpoint or editor/task abstraction is introduced.") (:heading 2 "Delivery and lifetime") (:p (:code ":thread") " is a native base event (" (:code "event-family") " " (:code ":base") ", native THREAD category), not a command event. " (:code "event-text") " is copied into an immutable snapshot and may also be read from the current innermost borrowed context. Payload SETF and owned/synthetic/cloned thread events reject. Observers automatically Skip; contexts retain the existing explicit Skip/propagation rules. Thread events do not automatically bubble through window parents like command events.") (:p "Delivery occurs only through GUI event dispatch. Workers never run the binding callback. Existing callback lifetime/context protections apply. Snapshot text remains usable after receiver/session teardown. Native QueueEvent wakes the GUI loop; it does not run the receiver synchronously on the posting thread. An accepted post is not an acknowledgment that a binding eventually ran.") (:p "The internal endpoint survives unbinding until the native receiver dies. Posts to a previously registered receiver with no binding can be accepted and ignored by native dispatch. Before initial binding, unknown/stale handles and closed session ingress reject with NATIVE-ERROR. Native Destroy retires the endpoint before native cleanup, with weak-safe restoration on refusal/exception. Native destruction unregisters the endpoint while excluding concurrent queue operations. A post accepted just before deletion/pending destruction may be discarded. Frame Close acceptance does not itself guarantee native destruction. Receiver identities are monotonic; worker copies of stale receiver objects do not resurrect native resources.") (:p "At most256 live queued/delivering packets per receiver and4096 per session are accepted; each is at most1MiB. Full queues reject with NATIVE-ERROR. Count reservations retire when native packets are deleted, including discarded or unhandled packets. There is no automatic coalescing or guaranteed delivery. FIFO follows serialized native posting order to one receiver, not wall-clock order between concurrent producers. Existing " (:code "delete-pending-events") " can discard packets; deletion and wx pending-handler unregistration serialize with posts.") (:p "Session shutdown closes ingress before binding/receiver/native cleanup. A post already inside the queue critical section completes before shutdown proceeds; later posts reject without entering wx. Workers need not call GUI APIs to stop posting and no worker termination is awaited under the ingress mutex. The application still owns thread termination/joining. Posting after session cleanup is safe and rejects; native shutdown does not silently launch another session.") (:heading 2 "Verification scope") (:p "The example/tests use real SBCL/CCL threads to post Unicode/NUL text and verify GUI-only callback delivery and immutable copies. Native fixtures cover count and byte limits, invalid UTF-8, unbound delivery, pending deletion, target-destruction and shutdown races, and stale posts after cleanup. No physical input, external network or system clipboard transfer is involved.") (:p "See " (:ref "example/examples/thread-events.lisp" "thread event example") ", " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") " and " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred UI actions") ".") (:heading 2 "Pinned native lock audit") (:p "The internal ingress mutex serializes posting, receiver retirement/destruction and pending-event deletion. It is never held while invoking Lisp or running a native Destroy body. Refused/throwing Destroy restores the endpoint only while the same weak-tracked receiver survives. Packet accounting uses atomics so discard/destruction never takes the ingress mutex under a wx pending-event lock.") (:p "Pinned " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/common/appbase.cpp#L563" "wxAppConsoleBase::ProcessPendingEvents") " releases its global pending-handler lock before calling a receiver. " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/common/event.cpp#L1382" "wxEvtHandler::ProcessPendingEvents") " releases the receiver pending lock before calling its event handlers. Therefore GUI callbacks can retire a receiver without reversing the posting lock order. The native DeletePendingEvents operation itself lacks that lock; the bridge serializes deletion plus pending-handler unregistration against worker posts. Re-audit these rules before widening to a different native lock implementation. Arbitrary allocator failure inside wx's own critical sections is outside the recovery guarantee; normal invalid/full/stale/shutdown errors occur before wx."))))
(:entry "guide/docs/TIME-PICKER.md" :names ("docs/TIME-PICKER.md") :kind :guide :kind-name "Guide" :summary "docs/TIME-PICKER.md" :sections (("Guide" (:heading 1 "Time-of-day pickers for forms") (:p "ABI53 adds native-backed " (:code "time-picker") ", generic " (:code "make-time-picker") ", generic " (:code "clock-time") "/SETF and read-only " (:code "event-time") ". Times are copied proper lists " (:code "(hour minute second)") ": hours 0..23 and minutes/seconds 0..59. NIL, incomplete or longer lists, fractions, negative values, 24:00 and leap second 60 reject before native mutation. Precision is whole seconds.") (:code-block "lisp" "(defparameter picker
  (wxlambda:make-time-picker parent :time '(9 30 0)))
(wxlambda:clock-time picker) ; fresh (9 30 0)
(setf (wxlambda:clock-time picker) '(23 59 59)) ; silent
(setf (wxlambda:clock-time picker :notify t) '(0 0 0)) ; midnight") (:p "The required " (:code ":parent") " is a WINDOW; " (:code ":time") " defaults to " (:code "(0 0 0)") ", not the current time. Native style is wxTP_DEFAULT. Editor/spin presentation, locale formatting, 12/24-hour display and accessibility follow the native port. The value adapter always uses 24-hour tuple components, independent of display format. There is no style, range, free editor text, nullable time, fractional second or scheduling API in this slice.") (:p (:code "time-picker") " inherits WINDOW. Direct MAKE-INSTANCE subclasses support slot initargs, " (:code ":default-initargs") ", native-ready AFTER hooks and managed failure/root rollback. " (:code "make-time-picker") " is a thin generic factory with validated " (:code ":class") " and forwarded initargs. Lisp subclassing does not add native C++ virtual methods.") (:code-block "lisp" "(defclass start-time (wxlambda:time-picker)
  ((record-id :initarg :record-id))
  (:default-initargs :time '(9 30 0)))
(make-instance 'start-time :parent parent :record-id 42)") (:heading 2 "Wall-clock values without a date or timezone API") (:p (:code "clock-time") " returns a fresh tuple of native committed time components. Input lists are copied; SETF returns the supplied list. It does not parse intermediate editor text for the app. Native getters with no supported valid committed time signal NATIVE-ERROR. Native construction and writes verify component readback.") (:p "wxWidgets uses wxDateTime internally even for time-only controls. The bridge constructs values on fixed local 2012-01-01, matching wxTimePickerCtrl::SetTime's approach, so it does not use today's potentially discontinuous DST date. Native construction must round-trip the requested time components or signals NATIVE-ERROR. This is not a guarantee about every historical timezone rule. Changing the process timezone during a GUI session is outside supported scope. The native date portion and milliseconds are not exposed or interpreted as application data. No timezone, offset, DST fold selection, UTC/Unix/Common Lisp universal-time conversion or date-plus-time scheduling is implied. Applications must separately decide how to combine a " (:ref "guide/docs/DATE-PICKER.md" "calendar date") " and time into an actual instant.") (:heading 2 "Change snapshots and safe updates") (:p "Bind " (:code ":time-change") " using " (:code "bind-event") ". Programmatic writes are silent by default. " (:code ":notify t") " emits exactly one native wxDateEvent of wxEVT_TIME_CHANGED after committed readback, even for an unchanged time. Physical editor/spin input retains native event timing/count/order. Time-change is command family and cannot veto.") (:code-block "lisp" "(wxlambda:bind-event picker :time-change
  (lambda (event)
    (format t \"Time components: ~S~%\" (wxlambda:event-time event))))") (:p (:code "event-time") " reads the captured native payload, independently of the current picker value. It returns a fresh tuple, including " (:code "(0 0 0)") " at midnight. Invalid native payloads and non-time snapshots yield NIL. Snapshot values survive the callback/window/session. A " (:code ":with-context t") " borrowed context reads the current native time payload and obeys current-innermost context isolation and expiry; non-time contexts reject EVENT-TIME. The event date portion is ignored, including dates outside the separate calendar-picker range. EVENT-DATE returns NIL for time snapshots and rejects time contexts. EVENT-TIMESTAMP and raw command integer/ text metadata are not time-of-day encodings. Snapshot EVENT-TEXT is NIL. There is no EVENT-TIME SETF, owned/synthetic time event or detached time clone.") (:p "Actual time origins, propagation and composite-child TEXT callbacks use the shared Input guards. Same-picker writes and source/ancestor destroy/close reject; nested GUI/RUN/pumps, modal/clipboard entry and safe-idle delivery are guarded. Silent cross-picker synchronization is supported. Creation, early managed Destroy and native-base teardown suppress relevant input callbacks; native Destroy refusal/exception restores the guard if the object survives. Original callback conditions re-signal after the native notifying setter returns without rolling back committed time. Use owner-bound " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") " for structural work from callbacks. The example's Reset start time button uses that path.") (:heading 2 "Build and verification scope") (:p "Link wxWidgets core/base/adv and require wxUSE_TIMEPICKCTRL=1 and wxUSE_DATETIME=1; CMake rejects missing support. This reuses the existing date-picker component. macOS packaging bundles transitive native dependencies. There is no native wxDateTime resource exposed; existing date/time adapters remain bounded subsets. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ", " (:ref "example/examples/time-picker.lisp" "time-picker.lisp") " and " (:ref "guide/docs/DOCSET.md" "Cadre docset installation") ".") (:p "Deterministic tests cover midnight/last second, fixed-date construction, invalid components, CLOS rollback, copied values/snapshots, silence/explicit notify, native-origin/propagated/composite callbacks, context separation and teardown. Physical editor/spin input, locale/AM-PM display, accessibility, historical and DST timezone combinations, hosted Windows/Linux/Qt and graphical Cadre remain unverified. Early composite teardown is an injected native probe on macOS, not a hosted generic GUI claim. Tests never read or overwrite system clipboard contents.") (:p "Native references: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/timectrl.h" "time picker") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/dateevt.h" "date/time events") "."))))
(:entry "guide/docs/TOGGLE-BUTTONS.md" :names ("docs/TOGGLE-BUTTONS.md" "TOGGLE-BUTTONS") :kind :guide :kind-name "Guide" :summary "docs/TOGGLE-BUTTONS.md" :sections (("Guide" (:heading 1 "Persistent toggle buttons") (:p "ABI47 adds native-backed " (:code "toggle-button") ", a WINDOW subclass for a push button that stays pressed until toggled again. Each button is independent; this is not a radio group or toolbar tool. Required " (:code ":parent") " is a window, " (:code ":label") " defaults to an empty string and " (:code ":checked") " defaults to NIL. Any non-NIL checked value means pressed. Labels reject embedded NUL; empty/Unicode/mnemonic labels are supported within native display conventions. Build requirement: wxUSE_TOGGLEBTN. Baseline: wxWidgets3.2.12.") (:code-block "lisp" "(let ((preview (make-instance 'wxlambda:toggle-button :parent panel
                              :label \"Live preview\" :checked t)))
  (setf (wxlambda:checked-p preview) nil)           ; silent
  (setf (wxlambda:checked-p preview :notify t) t)   ; one update
  (setf (wxlambda:label-text preview) \"Preview λ\"))") (:p (:code "make-toggle-button") " is a thin generic factory with validated " (:code ":class") " and forwarded subclass initargs. Direct subclasses support slot/default initargs and native properties in AFTER hooks; invalid mixed native ancestry rejects and managed initialization failures clean up widgets and callback roots. Lisp subclassing does not implement native C++ virtual overrides. See " (:ref "guide/docs/CLOS-API.md" "CLOS API") ".") (:heading 2 "Checked state and label properties") (:p "Generic " (:code "checked-p") " returns T/NIL; the reader ignores its shared " (:code ":notify") " keyword. SETF accepts a generalized boolean and returns the supplied value. Writes are silent by default. " (:code ":notify t") " commits then emits exactly one native-class wxCommandEvent, even if the state is unchanged. Escaping callback conditions are contained/re-signaled at the Lisp boundary; committed state is not rolled back. Physical native delivery is not generated by silent writes.") (:p "Generic " (:code "label-text") " reads native label text into an independent Lisp string. Its SETF validates a NUL-free string and updates silently, preserving checked state. Native mnemonic rendering/best-size behavior is port-specific; explicit layout/size adjustment may be needed after changing text. No bitmap-toggle, alignment/style, three-state, grouping or default-button behavior is exposed.") (:heading 2 "Native toggle events and lifetime safety") (:p "Use " (:code "bind-event") " with " (:code ":toggle-button-change") ", optionally " (:code ":with-context t") ". This is a distinct command kind from checkbox " (:code ":toggle") ". " (:code "event-checked-p") " provides copied/current checked metadata; " (:code "event-integer") " is the raw native integer. " (:code "event-text") " copies the native payload, normally empty, and does not infer the label. Explicit notifications also use empty text. " (:code "event-selection") " is NIL. Native command propagation supports frame observers; default observers Skip automatically. There are no toggle-button ON-TOGGLE/OFF-TOGGLE convenience methods; their existing checkbox methods retain their scope.") (:p "Immutable snapshots survive source destruction and session cleanup; borrowed contexts require their innermost current callback and expire on return. EVENT-CHECKED-P SETF is not supported for this kind. Raw current integer/text metadata edits are observational, do not call the control setter, and do not provide veto/rollback. Numeric/radio/toggle inputs share tracked-source guards: same-button checked/label writes reject during its callback/operation, source and ancestor destruction/close defer, and modal/clipboard/RUN/pump/nested safe-idle entry reject until return. Silent writes to other buttons are supported. Actual native-origin and propagated callbacks receive these guards, not just explicit notifying setters. Creation/failure/base teardown suppress relevant callbacks. Origins are matched by live registered identities/composite children, without unchecked event-object pointer casts or dereferences.") (:p "Owned/synthetic construction, detached clone and queue/process-event injection of this kind reject. No raw native pointer adoption, bitmap toggle subclass or full native event/control parity is claimed. Existing CHECKBOX behavior is not widened to the new resource by receiver fallback.") (:heading 2 "Example and verification") (:p (:ref "example/examples/toggle-buttons.lisp" "examples/toggle-buttons.lisp") " keeps a preview option pressed and updates feedback from checked snapshots. START is interactive; EXERCISE uses silent and explicit notified writes, including unchanged values.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/toggle-buttons.lisp --eval '(wxlambda-toggle-buttons:start)'
sbcl --noinform --non-interactive --load ci/setup.lisp --load tests/toggle-buttons.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/toggle-buttons.lisp") (:p "Lisp checks include CLOS construction/defaults/AFTER/rollback, Unicode label properties, truthy values, safe callbacks, original condition identity and committed state on callback errors, expired contexts/stale handles and post-session snapshot reads. Native probes dispatch actual wxEVT_TOGGLEBUTTON events outside setter operations, including parent propagation and both checked states; verify source/ancestor/mutation/GUI-entry guards, cross-button updates and clone refusal. These probes do not simulate physical mouse/key input. Runtime evidence is macOS wxWidgets3.2.12; OSX/GTK/MSW/Qt native paths were source-reviewed. Hosted platform GUI, physical input/accessibility and graphical Cadre remain unverified. Automatic clipboard tests do not read/replace system contents. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/TOOLTIPS.md" :names ("docs/TOOLTIPS.md" "TOOLTIPS") :kind :guide :kind-name "Guide" :summary "docs/TOOLTIPS.md" :sections (("Guide" (:heading 1 "Window tooltips for form guidance") (:p "ABI51 adds generic " (:code "tooltip-text") " and its SETF writer on public WINDOW wrappers. The native window owns its tooltip; Lisp receives copied text, never a tooltip pointer or separately disposable resource. Baseline wxWidgets 3.2.12 requires wxUSE_TOOLTIPS=1 at build time (CMake rejects disabled support).") (:code-block "lisp" "(setf (wxlambda:tooltip-text name-field) \"Enter your display name — λ is welcome.\")
(wxlambda:tooltip-text name-field) ; fresh native text string
(setf (wxlambda:tooltip-text name-field) \"\") ; attached empty tooltip
(setf (wxlambda:tooltip-text name-field) nil) ; remove native tooltip") (:p "The reader returns NIL when no tooltip is attached and a fresh string otherwise, including the empty string. The writer returns its supplied value. Strings are copied into native storage, accept 0..4096 UTF-8 bytes and reject embedded NUL; this byte limit is not a Lisp character count. Invalid inputs leave existing text intact. Newlines are accepted; native normalization/rendering and hover popup eligibility, timing, placement, wrapping and composite-control behavior remain port-specific. Readback reports native text rather than a Lisp shadow. A successful setter does not promise that a tooltip is visible or will appear. Tooltips complement visible labels and validation feedback.") (:p "Both operations require a live window in the active main-thread session. Hidden or disabled windows may store/read tooltip text. Reads are allowed in callbacks; writes (including removal) reject callbacks. Queue an owner-bound action:") (:code-block "lisp" "(wxlambda:on-click guidance-button
  (lambda ()
    (wxlambda:defer-ui-action
      (lambda () (setf (wxlambda:tooltip-text name-field) nil)) :owner name-field)))") (:p "Synchronous writes protect the receiver and ancestors from bridge destroy/close and reject recursive tooltip writes and same-window operations using the shared Input guard. Nested GUI/RUN/pumps, modal/clipboard entry and safe-idle delivery are also blocked during the operation. Native callback conditions re-signal at the Lisp boundary without rolling native state back. Windows invalidate normally on owner destruction; no Lisp tooltip root needs cleanup. Native-ready subclass AFTER hooks may set tooltips, and existing CLOS rollback cleans the native window if a later initializer fails. There is no common tooltip constructor initarg.") (:p "This slice exposes no native wxToolTip class/adoption, global enable/delay/width, rich tooltip, per-item tooltip or tooltip event API. See the " (:ref "example/examples/tooltips.lisp" "example") ", " (:ref "guide/docs/CLOS-API.md" "CLOS API") ", " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") ". The example's EXERCISE checks text and deferred remove/restore without hover simulation. Physical hover, accessibility, native popup presentation, hosted Windows/Linux/Qt and graphical Cadre require separate interactive verification.") (:p "Native reference: " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/interface/wx/window.h#L3142" "wxWindow tooltip declarations") "."))))
(:entry "guide/docs/TREE-NAVIGATION.md" :names ("docs/TREE-NAVIGATION.md" "TREE-NAVIGATION") :kind :guide :kind-name "Guide" :summary "docs/TREE-NAVIGATION.md" :sections (("Guide" (:heading 1 "Trees and managed item views") (:p "ABI39 adds a visible-root, single-selection " (:code "tree-control") " and borrowed " (:code "tree-item") " views. Items use checked bridge tokens, never user-provided raw " (:code "wxTreeItemId") " pointers. Native token entries retain owner/parent/child relationships; Lisp views are canonical within the session:") (:code-block "lisp" "(let* ((tree (wxlambda:make-tree-control parent))
       (root (wxlambda:add-tree-root tree \"Workspace λ\"))
       (folder (wxlambda:append-tree-item root \"Documents\"))
       (file (wxlambda:append-tree-item folder \"日本語 😀.txt\")))
  (setf (wxlambda:tree-item-expanded-p root) t)
  (setf (wxlambda:tree-item-expanded-p folder) t)
  (setf (wxlambda:selection tree :notify t) file))") (:p "TREE-CONTROL uses native-backed CLOS construction, required " (:code ":parent") ", validated " (:code ":class") " factory support and subclass/default-initarg/AFTER-hook rollback. Fixed styles provide a visible root, branch buttons/root lines and single selection. TREE-ITEM is a borrowed resource view, not a window or directly constructible class; obtain it from creation, traversal, selection or event APIs. The wxQt tree backend is unavailable: construction signals " (:code "native-error") " before allocation because its asynchronous raw-item events need generation-safe translation. This slice targets the reviewed synchronous generic/macOS, GTK and MSW paths; hosted GTK/MSW still need runtime verification. No item subclass factory, raw adoption, native item data, images, sorting, label editing, drag/drop, hidden root, multiselect, lazy/virtual loading or arbitrary styles are exposed.") (:heading 2 "Ownership and traversal") (:p (:code "add-tree-root") " requires an empty tree; " (:code "append-tree-item") " accepts a live managed parent and appends in native order. Both take a string and return a TREE-ITEM view. Empty/duplicate labels are valid. Explicit UTF-8 lengths reject NUL. " (:code "tree-root") " returns the root view or NIL. " (:code "tree-item-parent") " returns its canonical parent or NIL for root; " (:code "tree-item-children") " returns a fresh ordered list of canonical views. Repeated queries return EQ views. Native insertion blocks supported selection events until the token and Lisp view can be published; failed Lisp publication deletes the new native item. No structural edit is allowed on the same tree during its selection callback. Edits from separate button callbacks or quiescent evaluations are supported.") (:code-block "lisp" "(wxlambda:tree-item-text item) ; independent string
(setf (wxlambda:tree-item-text item) \"Renamed λ\")
(wxlambda:tree-item-expanded-p item)
(setf (wxlambda:tree-item-expanded-p item) t)
(wxlambda:tree-item-alive-p item)
(wxlambda:delete-tree-item item) ; T; deletes the entire subtree") (:p "Mutable properties use generic SETF and return the supplied value. Expansion is a native request; a leaf may not become expanded, so query actual state if needed. All native item operations validate token and owner before accessing the opaque native ID. Cross-tree selection, deleted items and invalid receivers reject. " (:code "tree-item-alive-p") " returns NIL for invalidated/deleting-owner items within an active session; it signals outside the session like other native queries.") (:p "Subtree deletion invalidates every descendant before native deletion. Native delete notifications and early control-destructor cleanup also invalidate tokens. Native ID/address reuse cannot revive a stale view. The session cache is revision-pruned after deletion/normal event boundaries and cleared at session cleanup; managed initialization rollback prunes invalid views too. Retaining a view keeps its Lisp owner reference, not the deleted native item. Native tree/ancestor destruction invalidates all items, including views held in user data or snapshots.") (:heading 2 "Selection policy") (:p (:code "selection") " returns a TREE-ITEM view or NIL, not an integer index. Root creation silently selects the new root; append preserves current selection. A nonempty tree selection writer requires a live item from that same tree. NIL is accepted only for an empty tree as a no-op. This avoids generic wx tree idle auto-selection after native deselection. Public mutations normalize selection synchronously under native event blockers so idle processing cannot introduce delayed wrapper-induced changes:") (:list (:item (:p "Deleting a subtree preserves an outside selection, or selects the surviving parent/root."))) (:list (:item (:p "Deleting the root leaves an empty, unselected tree."))) (:list (:item (:p "Collapsing a branch containing selection promotes selection to that branch."))) (:list (:item (:p "Other expansion changes preserve current selection."))) (:p "Text, insertion, deletion and expansion operations suppress supported selection events. Default selection SETF is silent. " (:code ":notify t") " uses native " (:code "SelectItem") ", with native changing/changed behavior and veto; same-item event counts are port-dependent. The writer returns its requested item even if vetoed; query actual selection. Physical user interaction follows the native port's navigation behavior.") (:heading 2 "Native events and lifetimes") (:p (:code ":tree-selection-changing") " and " (:code ":tree-selection-changed") " are derived wxTreeEvent notify events. Bind them through " (:code "bind-event") ", using a current context for veto:") (:code-block "lisp" "(wxlambda:bind-event tree :tree-selection-changing
  (lambda (event context)
    (let ((item (wxlambda:event-tree-item event)))
      (when (and item application-blocks-navigation-p)
        (setf (wxlambda:event-vetoed-p context) t))))
  :with-context t)") (:p (:code "event-tree-item") " reads the associated canonical view from a snapshot or exact live tree context, or NIL when no managed item is associated. It does not expose an old item or native pointer. Non-tree contexts reject; non-tree snapshots return NIL. There is no owned-event method or setter. " (:code "event-selection") " remains integer metadata for other controls and returns NIL for tree events. Only CHANGING veto prevents navigation; CHANGED is already complete. Source/origin, Skip/propagation, per-binding Lisp data and contained error behavior follow existing context contracts. No tree convenience " (:code "on-selection") " method is added; use generic bindings.") (:p "Snapshots freeze " (:b "view identity") ", not item contents or validity. A saved event may return an invalidated TREE-ITEM after deletion. Check liveness before using it, and copy " (:code "tree-item-text") " while live if a frozen label is needed. Snapshot access itself needs no session; dereferencing a view still requires one. Native event item metadata can be absent, and no unmanaged native item is adopted automatically.") (:p "Tree operation and actual/propagated callback guards protect the tree and ancestors. Same-tree writes (including item edits/selection), widget destruction/close, event pumping, synchronous modal entry and clipboard entry must wait until callbacks return. Reads and veto are allowed. Native teardown callbacks are suppressed even inside the native base destructor. Callback conditions re-signal after native return; completed native mutations are not rolled back. Derived tree events cannot be synthesized, queued as owned events, detached or contextually cloned in this slice. The appended ABI snapshot token field requires the matching ABI39 bridge/FFI pair.") (:heading 2 "Example and checks") (:p (:code "examples/tree-navigation.lisp") " builds an expandable document tree, a navigation veto checkbox and buttons to append/delete subtrees outside selection callbacks. START is interactive; bounded EXERCISE verifies native veto, canonical navigation and subtree invalidation:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/tree-navigation.lisp --eval '(wxlambda-tree-navigation:start)'
sbcl --load ~/quicklisp/setup.lisp --load examples/tree-navigation.lisp --eval '(wxlambda:with-application () (wxlambda-tree-navigation:exercise))'") (:p "Lisp tests check CLOS/defaults/rollback, views/text, ownership, post-idle collapse/ delete normalization, snapshots after deletion, cache pruning, veto/errors and stale or cross-tree operations. Native probes dispatch real derived events outside bridge selection setters and through parent propagation, then check mutation/lifetime/ nested-loop guards, raw inputs, native deletion, token reuse protection and base teardown suppression with zero wx assertions. Physical mouse/keyboard navigation, large/deep/virtual trees, accessibility, hosted Windows/Linux, graphical Cadre and a complete file/tree manager remain separate verification. See " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") ", " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/UI-TIMERS.md" :names ("docs/UI-TIMERS.md" "UI-TIMERS") :kind :guide :kind-name "Guide" :summary "docs/UI-TIMERS.md" :sections (("Guide" (:heading 1 "Bounded UI timers") (:p "ABI44 adds main-thread periodic and one-shot UI work with opaque " (:code "ui-timer") " tickets. It uses the same safe idle phase as deferred UI actions, rather than calling Lisp inside native wxTimer::Notify.") (:code-block "lisp" "(let ((timer nil) (updates 0))
  (setf timer
        (wxlambda:start-ui-timer
          (lambda ()
            (incf updates)
            (setf (wxlambda:status-text status) (format nil \"Update ~D\" updates))
            (when (= updates 10) (wxlambda:cancel-ui-timer timer)))
          250 :owner frame)))

(wxlambda:start-ui-timer (lambda () (setf (wxlambda:status-text status) \"Once\"))
                        1000 :owner frame :one-shot t)") (:p "FUNCTION takes no arguments; MILLISECONDS is an integer from 1 through 86400000 (one day). Default mode is periodic; non-NIL " (:code ":one-shot") " selects one delivery. At most256 live timer registrations are supported. Construction returns a new immutable ticket and never calls the function inline. Restart, interval mutation, raw native IDs/owners, wxTimer event receivers and timer-event snapshots are not exposed. To change an interval, cancel and create a new ticket. " (:code "ui-timer-p") " is a pure type predicate and remains true after retirement, including outside a session. No public ticket constructor or token accessor exists; this is a scheduler identity, not a CLOS wxTimer/event-handler wrapper or public native Notify override.") (:heading 2 "Delivery, coalescing and ordering") (:p "A native notification marks at most one due tick. Repeated expirations before delivery coalesce; there is no missed-tick count or elapsed-interval catch-up. The safe scheduler merges due timers and ordinary deferred actions by their first due/enqueue sequence, delivering at most one item per native idle iteration. This avoids starvation from a continuously due timer or an action backlog. Timer due work is separate from the1024-action queue, so a full action queue cannot silently discard a one-shot tick. Expired-owner cleanup can retire records before ordinary work; it invokes no user function.") (:p "RUN/full " (:code "process-events") " drives delivery. A full poll can perform several idle iterations; " (:code "process-pending-events") " does not run timer functions or guarantee OS timer notification processing. Functions wait while a modal/dialog/clipboard or guarded callback/native operation is active, while another safe UI function runs, during shutdown or while a callback error is pending. Native ticks may accumulate one due notification during those waits. A timer function can open a modal, but that modal cannot deliver another timer/deferred function recursively. Use END-MODAL in the current dialog callback; a waiting timer function cannot dismiss an already active modal.") (:p "Functions run on the GUI thread in the safe structural phase: status/control updates, modal/clipboard work, window destruction and structural operations are available subject to normal ownership checks. Newly nested event callbacks retain their guards. Recursive RUN/pumps/session finish reject; STOP may leave RUN. Return values are ignored. Long functions block GUI progress; these are not worker threads, high-resolution clocks, deadlines or real-time scheduling. Native resolution, event-loop load and coalescing can delay updates. A monotonic initial lower bound filters stale early notifications assigned to a newly started timer after native ID reuse; no strict cadence or per-interval timing guarantee.") (:heading 2 "Activity, ownership, cancellation and errors") (:p (:code "ui-timer-active-p") " queries the logical live registration. A stopped native one-shot remains active while its due function awaits safe delivery; its identity and queue root retire before invocation, so it is inactive inside its function. A periodic timer remains active inside its function until canceled/owner expiry. " (:code "cancel-ui-timer") " stops native notifications, removes due work and releases the Lisp closure root, returning T once and NIL if already removed. It is safe to cancel the current periodic timer or another timer from a function/callback. Cancel cannot interrupt the current function. The executing function remains locally rooted even if its registration is removed while a nested modal runs.") (:p "Optional " (:code ":owner") " is a checked native weak window reference. Native pending owner/ ancestor deletion counts as expiry. Observed expiry stops/retires the timer without running the function; queries/reaping/safe idle release native storage and Lisp roots. Notify can stop/mark an expired owner but never deletes itself. Expiry is observed, not a synchronous Lisp call from a widget destructor. The function may capture other values/widgets; an owner does not keep native widgets alive or protect arbitrary captured identities. Without an owner, the timer belongs to the application session and can outlive individual frames/RUN returns.") (:p "Both active/cancel operations require the current main-thread session. Session finish stops/deletes all native timers before window/toolkit teardown and clears Lisp roots on exit. Failed native start removes its prepared closure root. Managed widget initialization rollback also reaps timers owned by the failed widget. Do not process GUI events before managed construction has completed.") (:p "An escaping periodic function error cancels that timer to avoid repeated failures; errors/nonlocal exits use the existing contained safe-work error boundary and re-signal at outer RUN/full poll. Other pending work pauses until recovery within the session. One-shot identity was already removed. Locally handled errors can return normally and leave a periodic registration active. Cancellation is not transactional rollback of completed UI/IO effects. Capture event snapshots/values, not expired borrowed event contexts.") (:heading 2 "Backend scope and example") (:p "The baseline and verified runtime is wxWidgets3.2.12; CMake requires wxUSE_TIMER=1. On macOS timer creation currently accepts " (:b "only wxWidgets3.2.12") ", not arbitrary newer versions. The audited Cocoa cancellation path checks an invalidated queued CFRunLoopTimer before touching its old data. Official3.3.0/3.3.1 branches lack that check, so numeric version ordering is not a safety test. Unverified versions reject start with NATIVE-ERROR; other bindings retain their own existing version policy. Other timer backends are source-reviewed but hosted Windows/Linux GUI runs remain outstanding. Re-audit native cancellation before widening the macOS gate.") (:p "Native timers internally run continuously. The bridge ignores stale early first notifications, then stops logical one-shots at their first valid notification and retires them at delivery. It does not expose native IsOneShot or native timer event semantics. Native cancellation/source review uses " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/osx/core/timer.cpp" "3.2.12 Cocoa timer") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.3.1/src/osx/core/timer.cpp" "3.3.1 Cocoa timer") ", " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/gtk/timer.cpp" "GTK timer") " and " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/src/msw/timer.cpp" "MSW timer") ".") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/periodic-status.lisp --eval '(wxlambda-periodic-status:start)'") (:p "The example updates a label/status bar periodically and supports Pause/Resume by canceling/creating registrations. EXERCISE uses real native timers and self-cancels after two updates. Tests cover real one-shot/periodic delivery, modal exclusion, self-cancel, RUN, roots/owner/rollback/error/nonlocal/shutdown on both Lisps. Native probes independently force coalescing/ordering, first-tick filtering, due one-shot activity, expiry cleanup, capacity and worker rejection. Physical input, timer precision/deadline metrics, hosted OS GUI, OS clipboard interoperability, allocation race injection and graphical Cadre remain unverified. No system clipboard text is read/replaced by these automatic tests.") (:p "See " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") ", " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/WEB-VIEW.md" :names ("docs/WEB-VIEW.md") :kind :guide :kind-name "Guide" :summary "docs/WEB-VIEW.md" :sections (("Guide" (:heading 1 "Interactive WebView for editor development") (:p "ABI56 adds " (:code "web-view") ", a native-backed WINDOW container owning a private wxWebView browser. The initial backend is explicitly gated to macOS, wxWidgets3.2.12 and WKWebView. Other ports/versions reject construction until their asynchronous lifetime and native UI paths are audited. Building requires the wxWidgets " (:code "webview") " component; macOS also compiles an Objective-C++ adapter and links the system WebKit framework. JavaScript is enabled.") (:code-block "lisp" "(defparameter preview (wxlambda:make-web-view parent))
(wxlambda:bind-event preview :web-message
  (lambda (event) (format t \"Page sent JSON: ~A~%\" (wxlambda:event-text event))))
(wxlambda:bind-event preview :web-script-result
  (lambda (event)
    (format t \"Request ~D, success ~D: ~A~%\"
      (wxlambda:event-extra-long event) (wxlambda:event-integer event)
      (wxlambda:event-text event))))
(setf (wxlambda:web-view-url preview) \"http://localhost:3000/\")
;; After the application reports readiness:
(wxlambda:run-web-script preview \"({title:document.title, passed:2+2===4})\")") (:p "From JavaScript, send JSON-compatible data back to Lisp:") (:code-block "javascript" "window.webkit.messageHandlers.wxlambda.postMessage({type: \"test-result\", passed: true});") (:p "Messages are data. The binding does not parse JSON into Lisp objects or evaluate received strings as Lisp code. Use an application JSON library and explicit message handling. All frames/origins can send messages: receipt does not authenticate the sender. This is a trusted development preview, not a browser security sandbox or a full browser automation/DevTools protocol.") (:heading 2 "Construction and page loading") (:p (:code "make-web-view") " requires a live WINDOW parent and accepts validated " (:code ":class") " and subclass initargs. Direct " (:code "make-instance") " supports slots/default initargs, native properties in AFTER hooks and managed construction/root rollback. The initial page is " (:code "about:blank") ". Lisp ancestry is WINDOW, not PANEL. Existing row/column layout accepts the view with " (:code ":proportion 1 :expand t") "; the private browser child and its own sizer are not exposed. Managed handler stacks reject.") (:p (:code "web-view-url") " reads the native current URL; SETF requests asynchronous navigation and returns its supplied string. It need not immediately read back that URL. Input must be a nonempty absolute " (:code "http") ", " (:code "https") " or " (:code "file") " URL, or exactly " (:code "about:blank") ". URL inputs are at most8192 UTF-8 bytes, NUL-free and reject whitespace/control characters and malformed percent escapes. HTTP(S) requires a host. Encode URL spaces as " (:code "%20") "; use " (:code "run-web-script") " for JavaScript rather than " (:code "javascript:") " navigation.") (:p (:code "set-web-page") " takes HTML and optional " (:code ":base-url") " (default " (:code "\"about:blank\"") "), returns the supplied HTML string and requests asynchronous loading. HTML is NUL-free and at most2MiB UTF-8; the base follows the same URL rules. Input strings are copied natively. Accepted requests are not successful-load guarantees. Loading uses an Objective-C exception boundary so malformed URLs become NATIVE-ERROR instead of unwinding through Lisp. Redirects, page-driven links and subresources follow WebKit; the initial URL validator is not a navigation sandbox.") (:p (:code "web-view-title") " returns a fresh native title string. " (:code "web-view-busy-p") ", " (:code "web-view-can-go-back-p") " and " (:code "web-view-can-go-forward-p") " return native booleans. " (:code "web-view-go-back") ", " (:code "web-view-go-forward") ", " (:code "web-view-reload") " and " (:code "web-view-stop") " return the view after requesting their native operation; unavailable history directions reject. Stop does not roll back a page or cancel outstanding script evaluations. Network, local-server, certificate and WebKit policies remain native.") (:heading 2 "Asynchronous JavaScript and events") (:p (:code "run-web-script") " accepts a NUL-free script of at most1MiB UTF-8 and immediately returns a positive request ticket. It never spins a nested synchronous browser loop. At most64 requests can be outstanding per view, including results queued for delivery. Tickets increase monotonically and are bounded to2147483647.") (:p "Use " (:code "bind-event") " on the view or its ancestors:") (:table :header (("Kind") ((:code "event-text")) ("Other payload")) :rows ((((:code ":web-message")) ("JSON serialization of the posted message body") ("no authenticated origin/frame metadata")) (((:code ":web-script-result")) ("JSON result on success; native error text on failure") ((:code "event-extra-long") ": ticket; " (:code "event-integer") ":1 success,0 failure")) (((:code ":web-loaded")) ("Native reported URL") ("may occur for native loads before application readiness")) (((:code ":web-error")) ("Native load error description") ("does not imply a script request failed")))) (:p "JSON fragments are supported: strings are quoted, arrays/objects/numbers and booleans serialize normally; undefined/nil becomes " (:code "null") ". Nonserializable native results and JavaScript exceptions produce error results. Promise objects are not awaited; use page messaging from asynchronous application code. Result JSON is at most1MiB; an oversized result becomes an error result. Incoming messages over1MiB or beyond256 queued messages per view are discarded. Avoid flooding the bridge. Native load notifications are informational, not an application test readiness protocol. Use an explicit ready message or application predicate.") (:p "Events carry copied immutable snapshots and optional current-innermost borrowed contexts. Text/integer/extra-LONG payload SETF rejects for these kinds; Skip and propagation remain supported. No owned/synthetic/cloned web events are exposed. Scripts and messages may finish after navigation: tickets identify requests, not document generations. Correlate application/page IDs in your own messages.") (:p "Native callbacks only enqueue copied wx events. Lisp delivery occurs through normal event dispatch with receiver/ancestor lifetime protection. Script completion blocks retain numeric owner/ticket IDs, never raw C++ window pointers. Owner/session destruction clears requests, removes the message handler and drops late results. A view is not kept alive by an outstanding JavaScript request.") (:p "All calls require the GUI thread and live session. Page/navigation/script writes reject event callbacks; use owner-bound " (:code "defer-ui-action") ". Reads are callback-safe. Nested pumps/modal/clipboard entry and receiver/ancestor destruction reject during web callbacks. Run the normal native loop (" (:code "run") " or the interactive REPL loop), or full " (:code "process-events") " polling; pending-event dispatch alone is not a browser run loop. The example's bounded tests use " (:code "run") " with a UI timer.") (:heading 2 "Native UI policy and tested scope") (:p "The WK adapter acknowledges alert, returns false for confirm and null for prompt, cancels file upload panels, blocks new windows, disables context menus and suppresses the pinned native printing hook. Supported media/geolocation requests are denied through SDK-gated delegate methods. The injected wx fullscreen script/message handler is removed. These measures prevent known unguarded wx modal paths; they do not claim complete WebKit permissions/security policy. Native browser keyboard/clipboard interactions follow WebKit and are separate from the library's explicit clipboard APIs. Automation does not transfer system clipboard content.") (:p (:ref "example/examples/webview.lisp" "The runnable editor preview") " provides a JavaScript text area, Run button, live browser and JSON result output. Tests load only embedded offline HTML, run actual JavaScript, exchange Unicode JSON, contain alert/confirm/prompt, check malformed URLs, callback propagation/metadata guards, subclass rollback and pending-result disposal. Native regressions add raw bounds, thread/queue limits and late-result rejection. Physical browser input, arbitrary network/auth/certificate flows, file-upload gestures, every OS permission path, DevTools integration, hosted platforms and graphical Cadre remain unverified.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/webview.lisp \\
  --eval '(wxlambda-webview:start)'") (:p "See " (:ref "guide/docs/GRID.md" "grid") ", " (:ref "guide/docs/CLOS-API.md" "CLOS API") ", " (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "deferred actions") " and " (:ref "guide/docs/DOCSET.md" "Cadre installation") "."))))
(:entry "guide/docs/WINDOW-HANDLER-STACKS.md" :names ("docs/WINDOW-HANDLER-STACKS.md" "WINDOW-HANDLER-STACKS") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-HANDLER-STACKS.md" :sections (("Guide" (:heading 1 "Managed window event-handler stacks") (:p "ABI 31 adds WINDOW-EVENT-HANDLER, PUSH-EVENT-HANDLER, POP-EVENT-HANDLER, REMOVE-EVENT-HANDLER, PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY. The wxWidgets 3.2.12 mapping supports bridge-managed windows and session-owned standalone handlers, including Lisp subclasses. It adds no external handler adoption, arbitrary SetEventHandler, raw pointer or native virtual Lisp callback.") (:heading 2 "Stack ownership and identity") (:p "WINDOW-EVENT-HANDLER returns the top managed pushed handler as its canonical Lisp wrapper. An empty managed stack returns the same window object passed to the reader, matching native GetEventHandler's default self identity. The reader checks that the native stack is known to the bridge; it does not wrap or adopt an unknown native handler. It is read-only and may run during callbacks while the window remains valid and is not being deleted.") (:p "PUSH-EVENT-HANDLER takes a live window and an unlinked session-owned standalone handler, returns the handler, and places it above the prior top. Last pushed is first in native stack traversal. Already attached or linked handlers reject; window/application objects cannot be pushed as peers. Pushing does not move the native unique ownership registry entry: the bridge session still owns the handler and strongly roots its canonical wrapper. The window does not become its deleting owner merely because it appears on the native event stack.") (:code-block "lisp" "(wxlambda:push-event-handler window handler)
(assert (eq handler (wxlambda:window-event-handler window)))
(wxlambda:pop-event-handler window) ; handler stays alive and unlinked") (:p "POP-EVENT-HANDLER without DELETE detaches and returns the top handler, alive and unlinked. With " (:code ":delete t") ", bridge ownership is released, native PopEventHandler performs deletion, Lisp canonical roots/bindings are cleared, and NIL is returned. The former wrapper is no longer live; native access and repeated destruction reject. Popping an empty stack is an error, including with DELETE true.") (:p "REMOVE-EVENT-HANDLER detaches a specified live managed handler without deletion, returning T if it belonged to that window and NIL otherwise. A live detached handler or one attached to another window is a safe nonmember probe: no native assertion is triggered and no stack changes. Wrong borrowed peers and destroyed handlers reject instead of being treated as absent. Removal preserves other stack entries, the native owned registry and the handler's own pending queue.") (:p "All structural stack operations require an active main-thread session at a non-dispatch boundary. Callback, native pump and RUN use reject before mutation. This includes pop/remove attempts that would be empty or absent. General NEXT-HANDLER/PREVIOUS-HANDLER peer reads and SETF, and UNLINK-EVENT-HANDLER, reject attached nodes so the standalone protocol cannot expose or edit the borrowed window tail. Use the window stack API to inspect/detach them. HANDLER-UNLINKED-P is the exception: it can read attached owned nodes and returns NIL.") (:heading 2 "Window destruction and explicit handler destruction") (:p "All supported concrete native window kinds, including text/choice dialogs, use an internal managed destructor that pops managed handlers with native deletion disabled before wxWindowBase teardown. Deleting a window or an ancestor therefore detaches pushed handlers; they remain alive, unlinked and session-owned. Their own pending queues remain with them and can deliver after the window is gone; window teardown does not cancel those queues. This cleanup does not depend on a destroy-event observer, its Skip choice or HANDLER-ENABLED-P. These internal native subclasses do not add public CLOS classes or expose native virtual overrides.") (:p "This policy matters because the native window destructor requires pushed handlers to have been removed; it does not act as their deleting owner. The bridge also detaches managed stacks before application session window cleanup. A requested asynchronous window destruction may leave the stack attached until actual native teardown; do not equate a destruction request with completed handler detachment.") (:p "DESTROY-EVENT-HANDLER on an attached handler removes it from its window before native deletion when called outside callbacks. During callbacks, linked/attached handler destruction rejects so an active traversal is not structurally edited. Unlinked handler callback disposal retains its prior deferral behavior. Constructor rollback removes/deletes a failed owned handler even if its AFTER hook attached it; a failed window's eventual native destruction detaches pushed handlers. Resource rollback is not arbitrary restoration of external stack/graph edits made by user hooks. No GC finalizer or cross-session reuse is introduced.") (:heading 2 "Explicit window routing") (:p "PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY take a window and a live OWNED-EVENT, process an independent detached copy, and return handled-p and final-vetoed-p from that copy. The source owned event stays alive/unchanged and can be destroyed during callbacks. Copy origin is the window, while a pushed handler's callback snapshot source is that handler's canonical Lisp wrapper. No payload override keywords are accepted.") (:p "PROCESS-WINDOW-EVENT enters native GetEventHandler routing and can continue from the stack through the window and normal parent/application fallback. PROCESS-WINDOW-EVENT-LOCALLY searches this window and its pushed handlers, including applicable native validators/local pre-processing, without normal upward window propagation. Native local static/default handlers may still run, including frame-close behavior; local routing is not observer-only. Observer Skip/consumption and nearer callback-error boundaries retain their existing meaning; a callback can run while handled is NIL, and veto is independent of handled.") (:p "Existing PROCESS-EVENT, PROCESS-EVENT-LOCALLY and queued/post/transfer operations on a window deliberately retain wxEvtHandler receiver semantics and bypass its pushed stack. Use the explicit synchronous window operations when that stack must participate. They do not change where native pending objects are queued, move pending events between nodes, install Lisp callback chains or promise callback order within a node. Native window input routing still follows its own wxWidgets entry paths.") (:heading 2 "Session and payload restrictions") (:p "Synthetic query/end-session delivery and session bindings are not allowed on attached pushed handlers. PUSH rejects a handler with active session bindings or queued session events before attachment. Native standalone session tracking is cleared when those events are processed or deleted; it introduces no worker posting or Lisp native virtual hook. These restrictions prevent the borrowed window tail from becoming a route to process-exiting wxApp session defaults. Native app session delivery remains separately unverified.") (:p "The owned-event copied-dispatch and lazy wxEVT_TEXT/text-entry receiver guards also apply to the explicit window operations. No native class replacement, arbitrary tag mutation, borrowed client/userData ownership or retained origin pointer is added. Window SetEventHandler and adoption of external native stack entries remain unbound.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-handler-stacks.lisp --eval '(wxlambda-window-handler-stacks:start)'") (:p "The original eight-widget focused regression covers stack-aware explicit routing versus generic window bypass, pop/remove/deleting-pop lifetime, nonmember/stale probes, all eight widget destructors, parent-cascade detachment with window event processing disabled, pending delivery after pop/window deletion, session guards and rollback in both construction directions. wxEVT_DESTROY is not publicly bindable, so consuming a real destroy notification is not directly tested; teardown independence is structural/native review rather than a claimed destroy-callback test. A destroy request still differs from actual native detachment. Local checks do not establish hosted Windows/Linux GUI or graphical Cadre behavior. Remaining C1 work includes external/native stack adoption, arbitrary SetEventHandler, origin retention, arbitrary native client/userData ownership, timer events and worker dispatch. Bounded idle scheduling and Lisp-rooted handler/binding data are now supported.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/HANDLER-CHAINS.md" "standalone chains") ", " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. General native event/client/item pointer ownership remains unbound; per-binding Lisp USER-DATA is separately supported.") (:heading 2 "Safe deferred structural boundary (ABI43)") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " run after native callbacks and operations return. Their outer action body is an explicit safe structural boundary even under RUN/full polling; the quiescent structural operations in this guide can run there. Nested event callbacks retain their existing guards, and nested RUN/pumps/finish remain forbidden. Optional owner/cancel/error rules are documented in that guide."))))
(:entry "guide/docs/WINDOW-METADATA.md" :names ("docs/WINDOW-METADATA.md" "WINDOW-METADATA") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-METADATA.md" :sections (("Guide" (:heading 1 "Window names and frame titles") (:p "This coverage slice adds logical window names and mutable frame titles. These are CLOS generic functions; names work with every currently bound window/control. Title operations accept frames; other top-level window types remain future work.") (:heading 2 "Logical names") (:code-block "lisp" "(setf (wxlambda:window-name window) \"search-input\") ; returns the supplied string
(wxlambda:window-name window)                    ; independent string") (:p "A name is a logical string property, separate from a control's displayed label, its text value, a frame's title and the native integer ID. Names need not be unique. Changing a name does not synthesize a command event or change the label. Unicode, empty names and embedded NUL characters are preserved using explicit UTF-8 byte counts across the bridge. A setter copies its input; changing the Lisp string afterwards does not change the native name. A getter returns an independent Lisp string that survives later queries and window destruction.") (:heading 2 "Frame titles") (:code-block "lisp" "(wxlambda:frame-title frame)                     ; includes initial make-frame title
(setf (wxlambda:frame-title frame) \"Results — λ\")  ; returns the supplied string") (:p "Title setters update the existing frame, and getters return independent strings. Empty titles and Unicode are accepted. Display and platform normalization follow wxWidgets and the native window system. A frame's logical name is unaffected. These operations expose " (:code "wxTopLevelWindow::GetTitle") " and " (:code "SetTitle") " for the currently bound " (:code "wxFrame") " type; passing a panel or control signals a Lisp dispatch error.") (:p "All four functions require a live window in an active main-thread GUI session. Invalid/destroyed handles and inactive sessions signal " (:code "native-error") "; wrong Lisp argument types signal Lisp conditions. Empty successful results are strings, not failure sentinels. No parent ownership or handler lifetime rules change.") (:heading 2 "Example and checks") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp \\
  --eval '(wxlambda-window-metadata:start)'") (:p "The example constructs a subclass directly with " (:code "make-instance") " and counts title updates using an " (:code ":after") " method on " (:code "(setf frame-title)") ". Click the button to update both the frame name and its Unicode title. Close the frame to exit. The example's reusable " (:code "exercise") " queues that same callback, checks the resulting properties and subclass hook, explicitly unbinds it and destroys the frame. See " (:ref "guide/docs/CLOS-API.md" "the CLOS API guide") " for the dispatch and subclassing contract. The automated test runs this example, checks names on all seven widget types, independent labels/text, Unicode/empty/NUL names, saved string lifetime, non-frame title errors, invalid native pointers and destroyed/inactive handles:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-metadata.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-metadata.lisp") (:p "Native ABI 9 adds length-aware metadata strings. Rebuild the bridge with the updated Lisp bindings. Getter pointers are borrowed until the next name/title query on the same thread; the public Lisp getters copy them immediately. Existing text and label getter buffers retain their previous lifetime contracts."))))
(:entry "guide/docs/WINDOW-STATE.md" :names ("docs/WINDOW-STATE.md" "WINDOW-STATE") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-STATE.md" :sections (("Guide" (:heading 1 "Window visibility and input state") (:p "The first coverage slice completes the " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()") " operations for all currently bound windows. Hiding through " (:code "show-window") " with NIL also covers " (:code "Hide()") "; disabling through " (:code "enable-window") " with NIL covers " (:code "Disable()") ", preserving their changed-state results as second values. It builds on the existing handle/lifecycle support; the rest of the window API and C1 foundation inventory remain open.") (:heading 2 "Showing and hiding") (:code-block "lisp" "(wxlambda:show-window window)       ; show, preserving the existing API
(wxlambda:show-window window nil)   ; hide
(wxlambda:shown-p window)           ; own shown flag") (:p (:code "show-window") " returns the window as its primary value, so existing callers retain their result. Its second value is true when wxWidgets changed the shown state and false for an unchanged request. SHOW is a generalized boolean.") (:p (:code "shown-p") " reads the window's own shown flag. A child can have this flag true while a parent is hidden; this query does not promise it is visible on screen. Frames initially have their shown flag false; child controls normally start true. Use " (:code "layout-window") " on the parent after hiding/showing a sizer child when the layout should reclaim or restore its space.") (:heading 2 "Enabling and disabling input") (:code-block "lisp" "(wxlambda:enable-window window nil) ; disable user input
(wxlambda:enable-window window)     ; enable it again
(wxlambda:enabled-p window)         ; effective state, including ancestors") (:p (:code "enable-window") " returns the window and the native changed-state boolean as two values. ENABLE is a generalized boolean. " (:code "enabled-p") " includes disabled ancestors: a child is effectively disabled while a parent is disabled. A child explicitly disabled before disabling its parent stays disabled after the parent is enabled.") (:p "These functions require a live window in the active main-thread session. Invalid or destroyed native handles signal " (:code "native-error") "; false query results and unchanged setters are ordinary results. Setters do not synthesize command events. Hiding/disabling a control retains its handlers and ownership; explicitly unbind handlers before destroying it under the existing lifecycle contract.") (:heading 2 "Example and verification") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp \\
  --eval '(wxlambda-window-state:start)'") (:p "The example has separate buttons that toggle text visibility and input. Close the frame to exit. Its " (:code "exercise") " function queues the actual callbacks twice, verifies both state transitions, unbinds handlers and destroys the window. The focused test runs this example and checks setter return values, repeated requests, ancestor semantics and destroyed/inactive handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-state.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-state.lisp") (:p "Native ABI 8 introduces distinct boolean/error results (" (:code "0") "/" (:code "1") " versus " (:code "-1") "). Rebuild the native bridge with the Lisp changes. The old C " (:code "wxl_show") " status contract remains available; the Lisp wrapper uses " (:code "wxl_show_state") " to expose its second value. This does not implement " (:code "IsShownOnScreen") ", intrinsic " (:code "IsThisEnabled") ", general event bindings or window subclassing."))))
(:entry "guide/docs/WXWIDGETS-COVERAGE.md" :names ("docs/WXWIDGETS-COVERAGE.md" "WXWIDGETS-COVERAGE") :kind :guide :kind-name "Guide" :summary "docs/WXWIDGETS-COVERAGE.md" :sections (("Guide" (:heading 1 "wxWidgets coverage plan") (:p "The goal is " (:b "broad GUI coverage with selective depth") ": useful, reliable Lisp desktop applications rather than a literal wrapper for every wxWidgets API. This supersedes the earlier exhaustive-parity objective. The pinned native inventory remains factual: unbound/partial APIs stay visible even when deferred, served by Lisp-native alternatives or unnecessary for a selected milestone.") (:p "C1–C7 are " (:b "inventory categories, not a delivery sequence") ". Select feature work from the priorities below and implement its actual prerequisites. Exhausting C1 is not required before everyday controls, menus, dialogs or navigation. Historical checkpoint notes retain their former goal language, explicitly superseded here.") (:heading 2 "Scope and inventory") (:p "Target: the published wxWidgets " (:b "3.2.12") " API, the version recorded by the project's existing local verification. CMake currently accepts 3.2 or newer; this inventory does not claim to cover APIs added after 3.2.12. When advancing the coverage target, regenerate and review the inventory delta explicitly.") (:p "The authoritative inventory is upstream's " (:link "https://github.com/wxWidgets/wxWidgets/tree/v3.2.12/interface/wx" "`v3.2.12/interface/wx`") ", not just the linked " (:code "core") ", " (:code "base") ", " (:code "adv") ", " (:code "webview") ", " (:code "stc") " and " (:code "aui") " components. Extracted declarations retain the upstream " (:code "wxWindows Library Licence (coverage/UPSTREAM-LICENCE.txt)") " and its " (:code "GNU Library GPL terms (coverage/UPSTREAM-LGPL.txt)") ". The checked-in " (:code "manifest (coverage/manifest.json)") " records every header's SHA-256, phase and entry count. The " (:ref "guide/docs/coverage/README.md" "generated coverage summary") " gives current implemented, partial and pending counts by phase and header. The " (:code "class/widget index (coverage/classes.md)") " lists every class/struct definition found there. Each C-phase links to the full source checklist: methods, constructors, destructors, overloads, operators, free functions, callback types, enums, constants, macros, templates, and documented style/event table entries. Supporting source chunks are retained conservatively as context without checkboxes; entry counts are " (:b "not counts of distinct functions") ". No platform branch is preprocessed away. Each entry links to its upstream source line.") (:p "This is a complete inventory of the pinned " (:b "interface headers") ", not proof that these documentation headers contain every public symbol in the full wxWidgets source tree. Reconcile additional documented public APIs, generated declarations, port headers and inherited interfaces when they affect selected features or any claim of native completeness. Undocumented implementation internals are not binding requirements. Deprecated public APIs remain visible; any decision to omit an API must be recorded explicitly rather than checked off as implemented. Selected platform/optional features need explicit build selection, feature detection and unavailable-feature behavior; unselected ports/components are not automatic release requirements.") (:heading 2 "Status rules") (:list (:item (:p (:code "[x]") " in the baseline below means the " (:b "named, bounded operation") " exists in the"))) (:p "current native bridge, FFI and exported Lisp API. It does not mean the whole upstream class or every constructor option is supported, or that all platforms passed.") (:list (:item (:p "In generated checklists, " (:code "[x]") " means the declaration's operation is implemented"))) (:p "with its stated Lisp mapping, " (:code "[~]") " means partial support with the supported arguments/receivers and remaining limits stated inline, and " (:code "[ ]") " means pending. Class records remain partial for the managed application, handler, window, menu, layout and drawing adapters; none claims complete native class coverage. Applications have lifecycle functions and a borrowed application-handler view; native application construction and subclass hooks remain unbound. Constructors with fixed IDs/styles remain partial.") (:list (:item (:p (:code "status.json (coverage/status.json)") " is the persistent source of declaration and"))) (:p "class statuses, Lisp exports, native ABI names and supported scopes. Exact header/line/signature matching prevents silently transferring a mark to the wrong overload. The generator rejects missing/stale or duplicate mappings, unknown Lisp/native names, and overlapping phase assignments.") (:list (:item (:p "Conditional directives, includes, include guards and inline implementation"))) (:p "statements are labeled " (:b "Context") " without checkboxes. Public macro definitions and constants remain API tasks. Context is retained for platform interpretation and is counted separately in the manifest.") (:list (:item (:p "The baseline is based on " (:code "native/wxlambda.{h,cpp}") " plus modular native includes and " (:code "lisp/*.lisp")))) (:p "and existing tests. Current local verification is recorded in the MVP acceptance report; historical results remain in the implementation plan. Hosted platforms remain unverified.") (:list (:item (:p "For each binding, record the Lisp name, native ABI entry, supported arguments,"))) (:p "return values, receiver types, ownership, events, platform availability and focused verification before closing its full declaration. One mapping can implement several overloads when all semantics remain expressible.") (:list (:item (:p "C++ conveniences may map to Lisp strings, numbers, sequences, conditions or"))) (:p "scoped resource forms instead of literal C++ wrappers. Such equivalences require an explicit mapping, including Unicode, range and lifetime behavior.") (:heading 2 "Native status and GUI milestone acceptance") (:p "Use the " (:ref "guide/docs/coverage/README.md" "generated phase/header backlog") " for counts and the linked C1–C7 checklists for exact declarations. " (:code "[ ]") " means no public binding is recorded; " (:code "[~]") " means only the annotated scope exists. Remaining native scope is scheduled by feature priority, not automatically required for a release. A class marked partial is not complete because its constructor works. Context, class-definition and declaration counts must not be interpreted as percentages of distinct wxWidgets APIs.") (:p "The accepted ABI55 baseline covers everyday controls, navigation, actions, dialogs, deferred/timed work and bounded retained drawing, with a deeply tested managed lifetime/event layer. The finite automated local macOS MVP is accepted against form/editor, manager and drawing/monitoring workflows. See " (:ref "guide/docs/MVP-ACCEPTANCE.md" "MVP acceptance") " for current evidence and explicit boundaries; this is not full native class parity or hosted platform certification. The wxQt tree construction gate remains in force. ABI58 adds bounded copied " (:ref "guide/docs/THREAD-EVENTS.md" "worker thread events") " to existing GUI receivers. Other operations retain their GUI-thread and selected-feature scope.") (:p "A milestone is accepted against its selected GUI scope and representative workflows, not declaration totals or completion of every pending native entry.") (:heading 3 "Feature policy and priorities") (:table :header (("Policy") ("Selection rule")) :rows ((("Core") ("Reliable ownership/invalidation, events/callbacks, main-thread rules, CLOS construction/SETF, and documentation/examples/tests for every delivered API. Keep basic windows/controls/layout reliable.")) (("Planned") ("Everyday controls and layouts, menus/actions/toolbars/status bars, standard dialogs, navigation/notebooks, list/tree views, timers/idle, clipboard, drawing and necessary value adapters.")) (("On-demand") ("Specialized grid/data-view models, printing/document frameworks, AUI/ribbon, rich text/STC, web/media/OpenGL and platform integration when an application needs them.")) (("Lisp-native") ("Prefer Lisp strings, sequences, pathnames, hash tables, conditions, streams/configuration and utility libraries where literal native wrappers add no GUI value; document semantic differences.")) (("Deferred") ("Unused overloads/styles, deprecated/duplicate APIs, arbitrary pointer adoption, broad native virtual overrides and optional components without a current consumer. Revisit with demonstrated demand.")))) (:p "These are feature-level priorities, not native checkbox states. Do not bulk-mark status.json to represent deferral or assume a Lisp equivalent without checking its required semantics. A class can stay native-partial while its selected GUI feature scope is accepted. Native missing APIs are not automatic release blockers.") (:p (:b "Current vertical slice:") " the persistent form now composes menus, toolbar/status feedback, configured keyboard shortcuts and owner-bound deferred actions with generic modal dialogs and Lisp-native open/save IO. Text clipboard Copy/Paste now extends the form/editor; multiline text primitives now support editor UI construction. Notebook navigation now adds fixed editor/settings pages. Single-selection list boxes and checked tree navigation now extend the tree/list-manager slice. Fixed splitter panes now provide the two-pane manager slice. Toolbar/status-bar actions now extend the application shell; copied keyboard accelerator tables now route shared model actions. Do not drain native ownership/utilities first.") (:heading 3 "Representative application acceptance") (:list (:item (:p (:b "Form/editor:") " common controls and validation, flexible layouts, menu/action"))) (:p "and toolbar/status feedback, standard open/save/message dialogs, clipboard and keyboard/navigation basics. The persistent form verifies a bounded version; a full multiline editor and complete native/platform action semantics remain outside it.") (:list (:item (:p (:b "Tree/list manager:") " useful tree/list selection and item/model adapters,"))) (:p "contextual/menu actions, navigation, dialogs and clipboard. Pick model depth needed by the application before literal native container/document parity.") (:list (:item (:p (:b "Drawing/monitoring tool:") " canvas, bitmap/text/geometry/font/colour adapters,"))) (:p "practical resize/DPI behavior and bounded timer/idle updates. Every renderer or print backend is not a prerequisite for a usable first drawing workflow.") (:p "For selected feature scopes, verify end-to-end examples, Unicode/bounds, callback errors, destruction/cleanup and packaging where applicable. Maintain complete public-export reference coverage and zero docset checker problems. Automated reader lookup remains separate from graphical Cadre verification.") (:p "Cross-platform checks stay explicit: local Apple Silicon macOS SBCL/CCL results are recorded per batch; Linux/Windows Lisp/GUI/packaging work remains open until actual reports pass. A milestone may be scoped to verified targets, but must not advertise untested platforms or infer native parity from one backend. Record unavailable runners and feature gates rather than treating every port as complete.") (:p "All entries here are checked only for the behavior stated. No wrapped widget class has complete wxWidgets coverage yet.") (:heading 3 "C1: Application and bridge") (:list (:item (:p "[x] Native loading: " (:code "load-native-library") "; explicit-path packaged loading."))) (:list (:item (:p "[x] Application initialization/cleanup: " (:code "call-with-application") ", " (:code "with-application") "."))) (:list (:item (:p "[x] Main loop and stopping: " (:code "run") ", " (:code "stop") "."))) (:list (:item (:p "[x] Nonblocking event polling: " (:code "process-events") "."))) (:list (:item (:p "[x] Active-application main-loop/queued-event state: " (:code "main-loop-running-p") ","))) (:p (:code "pending-events-p") "; explicit wx pending dispatch: " (:code "process-pending-events") ". These do not complete arbitrary wxApp/event-loop bindings. All dispatch entries reject pump/callback reentrancy; see " (:ref "guide/docs/APPLICATION-EVENTS.md" "application events") ".") (:list (:item (:p "[x] Interactive application loop and debugger return: " (:code "with-repl-application") ","))) (:p (:code "return-to-application-repl") " (SBCL/CCL; one GUI session per process).") (:list (:item (:p "[x] Native-backed standalone " (:code "event-handler") " ownership, borrowed window base"))) (:p "identities, " (:code "handler-alive-p") ", " (:code "handler-enabled-p") " and its generic SETF writer, plus " (:code "destroy-event-handler") " for standalone objects. Weak window tracking prevents stale pointer access when destroy-event delivery is disabled. Arbitrary event types and pushed-handler ownership remain open; see " (:ref "guide/docs/EVENT-HANDLERS.md" "event-handler scope") ".") (:list (:item (:p "[x] Independent " (:code "bind-event") "/" (:code "unbind-event") " and " (:code "binding-active-p") ", with"))) (:p "four-kind command observers, exact IDs/ranges, safe self/peer removal, and " (:code "queue-event") " on standalone/window handlers. " (:code "event-id") " is a copied native ID; " (:code "event-source") " is the registered receiver, including on parent observers. Observers Skip automatically; optional contextual bindings now explicitly control Skip and propagation. Arbitrary event families and veto remain open; see " (:ref "guide/docs/EVENT-BINDINGS.md" "supported binding scope") ".") (:list (:item (:p "[x] Borrowed " (:code "event-context") " values from " (:code "bind-event :with-context t") ", with"))) (:p (:code "event-skipped-p") " SETF, " (:code "event-propagates-p") ", stop/resume actions, nested callback isolation and stale-context checks. " (:code "event-native-type") " copies runtime IDs; " (:code "event-type") " looks up four supported tags. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped context limits") "; close-veto is now scoped and CanVeto-guarded.") (:list (:item (:p "[x] " (:code ":close") " / wxCloseEvent family, immutable " (:code "event-family") " and close flags,"))) (:p "scoped " (:code "event-can-veto-p") " / " (:code "event-vetoed-p") " with generic SETF, copied close queues and frame-only " (:code "close-window") " requests. " (:code "event-type") " replaces the old command-only lookup. Notify/session events and arbitrary families remain open; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close-event limits") ".") (:list (:item (:p "[x] " (:code "register-event-type") " for unique session command/notify names, copied"))) (:p (:code "event-integer") "/text metadata, scoped notify Veto/Allow and " (:code "process-event") " with native handled plus final-veto results. No unregister or type-declaration rollback; session-event routing remains open. See " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify limits") ".") (:list (:item (:p "[x] Borrowed " (:code "application-handler") " identity via " (:code "current-application-handler") ", with inherited binding/dispatch/state and rejected construction/destruction. Native application hooks and session routing remain open."))) (:list (:item (:p "[x] Query/end-session tags, current/saved " (:code "event-logging-off-p") ", scoped SETF, application bindings and isolated owned-handler synthetic queues/dispatch. Real OS delivery and native shutdown policy validation remain open."))) (:list (:item (:p "[x] Copied/current event timestamp and native command classification, bounded native LONG timestamp SETF and close-family CanVeto SETF. Snapshot immutability and scoped lifetime remain enforced."))) (:list (:item (:p "[x] Current event-ID reads and SETF with signed bounds, unchanged snapshots and verified later parent exact/range/wildcard matching."))) (:list (:item (:p "[x] Current native type reads and captured/current opaque origin IDs for registered bridge objects. Native origin/type writers, general wxObject wrappers and ownership remain open."))) (:list (:item (:p "[x] Saved/current event category and compiled :UI/:USER-INPUT/:SOCKET/:TIMER/:THREAD/:ALL mask lookup. ALL includes actual native bits; category-specific families and YieldFor remain open."))) (:list (:item (:p "[x] Registered same-family event-native-type SETF with actual native class checks; built-in/session/unknown tags reject. Origin retention and arbitrary tag mutation remain open."))) (:list (:item (:p "[x] OWNED-EVENT construction/cloning/disposal/liveness, generic command text/integer SETF and copy-based native dispatch. Exact native classes and detached origins only; arbitrary classes, retained origin, source transfer and client/userData ownership remain open."))) (:list (:item (:p "[x] GUI POST-EVENT copies, consuming TRANSFER-EVENT handoff, PROCESS-EVENT-LOCALLY copies and non-application DELETE-PENDING-EVENTS with pending-list synchronization. Worker posting, app-wide deletion and per-handler pending processing remain open."))) (:list (:item (:p "[x] Standalone handler NEXT/PREVIOUS peer readers and reciprocal SETF, HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER. Strong canonical roots preserve wrapper identity; dispatch-time edits and borrowed window/app chains reject. Native Push/Pop/Remove remain open."))) (:list (:item (:p "[x] Managed window Get/Push/Pop/RemoveEventHandler and explicit ProcessWindowEvent/Locally copies. Push preserves bridge ownership; actual native window destruction detaches handlers. External stack adoption/SetEventHandler remain open."))) (:list (:item (:p "[x] Native extra LONG and raw IsSelection metadata, kind-specific live checked/selection SETF and clear-only compatible registered origin detachment. Retained/new origins and full derived-class payload semantics remain open."))) (:list (:item (:p "[x] Managed EVENT-HANDLER-CLIENT-DATA EQ Lisp storage through typed native root-token adapters, with foreign typed/untyped rejection. Generic wxClientData/container, untyped/event/item/userData ownership remain open."))) (:list (:item (:p "[x] BIND-EVENT :USER-DATA and read-only EVENT-USER-DATA saved/current association access through native wxObject token adapters. Active self-unbind and snapshot lifetime are retained; arbitrary native userData/client/item pointers and association mutation remain open."))) (:list (:item (:p "[x] :IDLE snapshots/current/owned resources, RequestMore, session-restored IDLE-MODE, own-window idle opt-in and GUI-thread wake scheduling. Explicit synthetic delivery is distinct from automatic policy; this does not imply full native idle/worker parity."))) (:list (:item (:p "[x] Native errors translated to Lisp " (:code "native-error") " conditions."))) (:list (:item (:p "[x] Event snapshots: " (:code "event") ", " (:code "event-p") ", " (:code "event-kind") ", " (:code "event-source") ","))) (:p (:code "event-text") ", " (:code "event-checked-p") ", " (:code "event-selection") " and family-specific payloads across supported command/notify/close/idle families; :MENU joins five command kinds.") (:heading 3 "C2: Windows, controls and layout") (:list (:item (:p "[x] " (:code "wxFrame") ": " (:code "make-frame") " with title, width and height."))) (:list (:item (:p "[x] " (:code "wxPanel") ": " (:code "make-panel") " with parent."))) (:list (:item (:p "[x] " (:code "wxButton") ": " (:code "make-button") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxTextCtrl") ": " (:code "make-text") " with parent and initial value."))) (:list (:item (:p "[x] " (:code "wxStaticText") ": " (:code "make-label") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxCheckBox") ": " (:code "make-checkbox") " with parent, label and initial boolean value."))) (:list (:item (:p "[x] " (:code "wxChoice") ": " (:code "make-choice") " with copied item strings and initial selection."))) (:list (:item (:p "[x] Static-text label get/set: " (:code "label-text") ", " (:code "(setf label-text)") " (not all controls)."))) (:list (:item (:p "[x] Text value get/set: " (:code "text") ", " (:code "(setf text)") "; silent " (:code "ChangeValue") " versus"))) (:p "notifying " (:code "SetValue") " for " (:code "wxTextCtrl") ".") (:list (:item (:p "[x] Checkbox boolean get/set: " (:code "checked-p") ", " (:code "(setf checked-p)") ", optional notification."))) (:list (:item (:p "[x] Progress gauges: native-backed " (:code "gauge") " construction, " (:code "make-gauge") ","))) (:p (:code "gauge-value") ", " (:code "gauge-range") ", " (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ". Both numeric properties have generic SETF writers; range reductions clamp progress.") (:list (:item (:p "[x] Choice index get/set: " (:code "selection") ", " (:code "(setf selection)") ", optional notification;"))) (:p "Lisp NIL means no selection. Item mutation and three-state checkboxes remain open.") (:list (:item (:p "[x] Parent-owned horizontal/vertical " (:code "wxBoxSizer") ": " (:code "make-row") ", " (:code "make-column") "."))) (:list (:item (:p "[x] Add window children: " (:code "add-child") " with proportion, uniform border, expand and"))) (:p "minor-axis alignment; nested standalone sizers and full flags remain open.") (:list (:item (:p "[x] Fixed/stretch spacing: " (:code "add-spacer") ", " (:code "add-stretch") "."))) (:list (:item (:p "[x] Relayout and geometry queries: " (:code "layout-window") ", " (:code "window-position") ", " (:code "window-size") "."))) (:list (:item (:p "[x] Logical name get/set: " (:code "window-name") ", " (:code "(setf window-name)") ", with copied Unicode"))) (:p "strings and explicit byte lengths preserving empty and embedded-NUL names.") (:list (:item (:p "[x] Frame title get/set: " (:code "frame-title") ", " (:code "(setf frame-title)") "; other top-level"))) (:p "receiver types remain unbound and their declarations are marked partial.") (:list (:item (:p "[x] Show/hide: " (:code "show-window") " accepts an optional boolean and returns the window"))) (:p "plus the native changed-state boolean; " (:code "shown-p") " queries its own shown flag.") (:list (:item (:p "[x] Enable/disable input: " (:code "enable-window") " returns the window plus changed-state"))) (:p "boolean; " (:code "enabled-p") " includes disabled ancestors.") (:list (:item (:p "[x] Destruction requests: " (:code "destroy-window") "; destruction notifications remain open."))) (:list (:item (:p "[x] Button bind/unbind/post: " (:code "on-click") ", " (:code "off-click") ", " (:code "queue-click") "."))) (:list (:item (:p "[x] Text-change bind/unbind: " (:code "on-text-change") ", " (:code "off-text-change") "."))) (:list (:item (:p "[x] Checkbox toggle bind/unbind: " (:code "on-toggle") ", " (:code "off-toggle") "."))) (:list (:item (:p "[x] Choice selection bind/unbind: " (:code "on-selection") ", " (:code "off-selection") "."))) (:list (:item (:p "[x] Handler replacement and callback condition containment for those events;"))) (:p "explicit unbinding of control-specific callbacks before window destruction is still required; generic registrations use weak invalidation and boundary pruning.") (:p "C3 includes bounded managed menus and standard/generic dialogs. Other source categories remain selected feature work; internal conversions/types alone are not full public class coverage.") (:p "The window-facing Lisp API has twenty-six wrapper classes (two abstract) plus the public event-handler base, direct native construction and generic operations/SETF; see " (:ref "guide/docs/CLOS-API.md" "CLOS API") ". This establishes Lisp dispatch and method combination, not native C++ subclass/virtual-callback coverage.") (:heading 2 "Native inventory categories and feature selection") (:p "All 398 pinned headers remain in these source-linked categories. This is a native discovery/status index, not delivery order or a promise to bind every entry. Work across categories when selected GUI features need them; implement necessary value/lifetime prerequisites without wrapping every utility first.") (:heading 3 "C1: Foundation, values, application, events, and base utilities") (:p (:code "Complete C1 source inventory (coverage/phase-c1.md)") ". Core event/lifetime/main-thread contracts support delivered features. Idle/timers and numeric adapters are implemented within documented bounds; filesystem/network/regex/container utilities normally use Lisp-native libraries unless native integration needs a bridge. Broad pointer adoption and virtual overrides remain on-demand/deferred.") (:heading 3 "C2: Windows, layout, basic controls, and input") (:p (:code "Complete C2 source inventory (coverage/phase-c2.md)") ". Radio groups, list boxes and bounded sliders/spinners are implemented. Toggle buttons are delivered. Editable combo boxes are delivered. Scrolling panels are delivered. Plan useful layouts, focus/keyboard and practical font/colour/DPI support. Deepen the existing window/control families as workflows need; not every constructor option or inherited overload must precede the next useful control.") (:heading 3 "C3: Dialogs, navigation, menus, and application services") (:p (:code "Complete C3 source inventory (coverage/phase-c3.md)") ". Menus/actions, toolbar/status feedback, standard dialogs, books/notebooks and clipboard are everyday priorities. Drag/drop and specialized platform/help/wizard services follow concrete demand. Frame-owned normal/check/separator menus and ID-routed actions are implemented within their verified scope. Modal text-entry/single-choice dialogs extend the selected workflow. Generic message/file workflows are verified; native OS cancellation remains deferred; popup/submenu/radio and full native menu overload depth stay in the inventory.") (:heading 3 "C4: Models, complex controls, and document frameworks") (:p (:code "Complete C4 source inventory (coverage/phase-c4.md)") ". Prioritize practical list/tree views and Lisp item/model adapters for the manager workflow. Full grid/data-view, native document/undo and persistence frameworks are on-demand; Lisp-native models may fit better than literal native containers.") (:heading 3 "C5: Drawing, images, graphics, and printing") (:p (:code "Complete C5 source inventory (coverage/phase-c5.md)") ". The " (:ref "guide/docs/DRAWING-CANVAS.md" "retained drawing canvas") " provides bounded geometry, text/font, RGB colour/bitmap and PNG output adapters for the monitoring workflow. Raw resource/DC ownership, other backends, metafiles and printing remain on-demand.") (:p (:ref "guide/docs/GRID.md" "Grid") " adds a bounded owned editable string table on explicit application demand; " (:ref "guide/docs/GRID-EDITING.md" "native editing") " adds selected native events, attributes and dimension changes.") (:heading 3 "C6: Optional libraries, rich content, and integration") (:p (:code "Complete C6 source inventory (coverage/phase-c6.md)") ". Select AUI/ribbon/property-grid, HTML/rich text/STC, web/media/OpenGL or XML/XRC when an application needs them. The requested " (:ref "guide/docs/WEB-VIEW.md" "interactive WebView") " now adds a guarded macOS WKWebView preview with asynchronous JavaScript and JSON messaging. Other backends remain gated. Chosen components require explicit build/availability behavior; unselected optional libraries do not block an everyday-GUI milestone.") (:heading 3 "C7: Platform extensions and portability reconciliation") (:p (:code "Complete C7 source inventory (coverage/phase-c7.md)") ". Verify platforms/backends claimed by selected features and reconcile interface/implementation discrepancies that affect them. Native Windows embedding/DDE/power and other port extensions are on-demand. Preserve unbound facts without requiring every platform declaration before a core GUI release or claiming unsupported native completeness.") (:heading 2 "Completion and maintenance") (:p "Focused generator/inventory verification (using the same extracted sources):") (:code-block "sh" "python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "Each selected feature scope closes when its chosen bindings have public Lisp exports, native/FFI mappings and matching documentation, required runnable examples, docset updates, and focused positive/error/lifetime/ event checks. Follow the " (:code "project implementation rule (../AGENTS.md)") " for every implementation change: build the Cadre-format version 1 docset in " (:code "docs/docset/") " (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "), containing the indexed reference for every implemented public wxlambda export, project guides and explained example sources together. Run the relevant examples, require zero problems from " (:code "docset:check-docset") ", and verify export coverage, links and Cadre discovery, symbol lookup and guide/example navigation. The docset is the primary documentation deliverable. The initial Phase 7 build prerequisite is implemented in " (:ref "guide/docs/DOCSET.md" "the docset tooling") "; maintain the generated artifact with each implementation change. Platform-only work must be verified on its supported platform before advertising that support; local macOS success cannot close Linux/Windows verification work. Existing Phase 3 hosted checks remain pending.") (:p "To reproduce the baseline inventory, extract the pinned release's " (:code "interface/") " directory and run:") (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "The generator is documentation-only and does not require an installed wxWidgets build. Multiline preprocessor directives are kept together so their parentheses do not swallow following classes or function declarations. It preserves source declarations rather than attempting C++ semantic resolution; declaration fragments and helper tokens intentionally remain visible. Compare the resulting header hashes with the committed manifest when verifying the same source version. Update " (:code "docs/coverage/status.json") " when implementing bindings; regeneration preserves those marks in the function lists and class index. Do not edit generated checkboxes directly. A new upstream version requires reviewing and migrating the exact declaration mappings before regeneration.") (:p "Native pending-list synchronization uses an implementation-header management method absent from the pinned documentation interface and remains a C7 reconciliation dependency; target cancellation does not close app-wide deletion.") (:p "Paired NIL standalone edge-detach semantics follow native implementation/Unlink behavior although the pinned setter prose forbids NULL; retain that discrepancy for C7 reconciliation.") (:p "Native window teardown requires pushed handlers to be removed; managed native widget destructors pop without deleting bridge-owned handlers before base teardown.") (:p "Raw IsSelection reports extra-LONG action metadata, not event kind or choice-index validity; origin mutation remains NIL-only and never retains a native object.") (:p "Protected wxEvtHandler storage-mode inspection avoids typed/untyped native assertions; it remains an implementation-header C7 dependency, not a public field/mode API.") (:p "The ABI 31 idle batch passes all 48 local GUI scenarios on both Lisps, five package checks and the zero-assert native regression; independent reviews pass. Automatic idle policy is separate from explicit synthetic delivery and own-window opt-in is not an effective eligibility predicate.") (:p "The verified ABI 32 menu batch adds managed native menu hierarchies and :MENU commands; " (:ref "guide/docs/MENUS.md" "MENUS.md") " defines its selected scope and completed checks. Bounded modal text/choice dialogs extend that scope; native menu gaps do not automatically block that GUI feature.") (:p "The ABI33 modal base/text-entry/single-choice batch passes its documented local suites, native regression, package and docset/export checks. " (:ref "guide/docs/STANDARD-DIALOGS.md" "STANDARD-DIALOGS.md") " distinguishes raw modal results from native validation/data transfer and stored-value/cache timing. Platform-native message/file backends remain deferred after a macOS cancellation probe hang; arbitrary native modal families are not claimed. Continue selected GUI features without requiring all native ownership/event declarations first.") (:p "ABI34 generic message/file support passes final verification. " (:ref "guide/docs/MESSAGE-FILE-DIALOGS.md" "MESSAGE-FILE-DIALOGS.md") " defines explicit generic backend, internal prompt cancellation and current-versus-accepted file state. Native OS backends remain unbound. Generic implementation headers/eager message creation, modal-hook overrides and file style-bit restoration are bounded C7 reconciliation dependencies, not public native class/virtual coverage.") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent document form") " now composes those operations with Lisp-native UTF-8 IO, dirty baselines, canceled/failed-save protection and close veto. This adds no bindings: wxDocument/wxDocManager/native streams stay unbound. Its 52-scenario suite and 234-entry docset verification pass; see IMPLEMENTATION.md for evidence. The example is a form, not a multiline editor, and does not provide locking, crash durability or external-change detection. Next add text clipboard support (delivered below) for the form/editor.") (:p "ABI35 adds " (:ref "guide/docs/CLIPBOARD.md" "text clipboard") ": standard-clipboard generic text SETF, availability and best-effort persistence, with scoped locking/PRIMARY restoration and contained callback conditions. Form Edit Copy/Paste uses whole-field names; control selection editing, Cut, binary/image/file data, async formats, PRIMARY and native clipboard/data-object wrappers remain unbound. wxClipboard/wxTextDataObject stay partial in the regenerated C3 inventory, including private adapters/prerequisites; no class-completeness claim follows from these three public names. Automatic tests use isolated transfer doubles and a live availability-only query; actual system writes/interoperability/exit persistence remain unverified. The 53-scenario, 239-entry docset and package checks pass; evidence is recorded in IMPLEMENTATION.md. Multiline text-control construction/editing now extends the editor primitives (below).") (:p "ABI36 adds " (:ref "guide/docs/TEXT-EDITING.md" "multiline text/basic editing") ": native-backed construction styles, user editability, native selection/caret/end offsets and notifying Replace. Existing text values now cross an explicit-length UTF-8 ABI with NUL write rejection. The regenerated C2 inventory keeps wxTextCtrl partial and other wxTextEntry receivers unbound. Offsets are native units, not Lisp string indices; GetRange, selection clipboard, undo/redo, rich text, arbitrary styles and native text file IO stay gaps. The example demonstrates primitives rather than claiming a full multiline document application. The 54-scenario/247-entry docset/package checks pass; evidence is recorded in IMPLEMENTATION.md. Notebook navigation is delivered below; selection/undo depth remains demand-driven.") (:p "ABI37 adds " (:ref "guide/docs/NOTEBOOK.md" "notebook navigation") ": native-backed fixed panel pages, canonical identity, native captions and silent/notifying page selection. Two derived notify events support immutable snapshots/borrowed contexts with native selection metadata and CHANGING veto. Operation and actual native/propagated callback guards protect ownership/reentry, deferring modal/clipboard transfers. wxNotebook, wxBookCtrlBase and wxBookCtrlEvent remain partial in the C3 inventory. Other books, page removal/reorder/reparent/icons, old-selection, owned/synthetic/clone events and full native class parity remain gaps. The 55-scenario/255-entry docset/package checks pass; evidence is recorded in IMPLEMENTATION.md. Next broaden tree/list-manager controls with single-selection list boxes.") (:p "ABI38 adds " (:ref "guide/docs/LIST-BOX.md" "single-selection list boxes") ": unsorted text items, silent append/rename/delete/clear with deterministic selection adjustment, selection/activation command events and owned/synthetic payloads. Actual list-origin callbacks protect receiver/ancestor lifetime and defer modal/clipboard entry while permitting item edits. wxListBox/wxItemContainer/wxItemContainerImmutable stay partial in regenerated C2 inventory, with existing CHOICE selection mappings preserved. Multi-selection, sorting, per-item client data, virtual/data-view models and native stable IDs remain gaps. The 56-scenario/264-entry docset/package checks pass; evidence is recorded in IMPLEMENTATION.md. Next broaden tree/list-manager coverage with bounded tree navigation and managed item ownership.") (:p "ABI39 adds " (:ref "guide/docs/TREE-NAVIGATION.md" "tree navigation and item ownership") ": a visible-root single-selection tree, checked canonical item views, root/child creation, ordered traversal, label/expansion, subtree invalidation and native selection/veto events. Snapshots retain possibly-invalidated views, not frozen text/native ownership. Native idle selection is normalized silently for structural edits. Tree-control, item-ID and event classes stay partial in regenerated C4 inventory; raw pointers, multiselect/hidden root, item data/images, label edit/drag/drop, virtual models, old-item and other/owned tree events remain gaps. The bounded 57-scenario/279-entry docset/ final package checks pass; evidence is recorded in IMPLEMENTATION.md. Next add splitter windows for a two-pane tree/list-manager workflow.") (:p "The wxQt tree backend is explicitly unavailable pending generation-safe async item-event translation; constructor rejection is part of this bounded scope.") (:heading 2 "Fixed splitter panes") (:p "The bounded splitter batch adds native-backed " (:code "splitter-window") ", persistent panel panes and guarded sash notifications. See " (:ref "guide/docs/SPLITTER.md" "supported scope and example") ". Dynamic pane replacement/removal and complete splitter parity remain deferred.") (:p "Both Lisps pass all 58 GUI scenarios for the splitter batch. Native probe, 13 coverage checks, 16 Python checks, 291-entry zero-problem docset, both-Lisp export lookup and isolated Cadre discovery/install checks pass. Five package checks pass. See IMPLEMENTATION.md for evidence and remaining platform/manual limitations. Toolbar/status-bar actions are now implemented; deeper native splitter APIs defer.") (:heading 2 "Frame toolbar/status actions") (:p "Native-backed " (:code "toolbar") " and " (:code "status-bar") " add a bounded application-shell slice: fixed normal/check/separator tools with stock art and :menu action routing, silent tool state and application-owned indexed status fields. See " (:ref "guide/docs/FRAME-ACTIONS.md" "supported scope, backend policy and example") ". Native Cocoa toolbar chrome, dynamic tools and status widths/stacks remain deferred.") (:p "The frame-actions batch adds a complete example of shared menu/tool action IDs and status feedback within this bounded slice, preserving deferred native APIs in the generated inventory. Copied frame keyboard tables now route shared application actions. Physical interaction and hosted Windows/Linux GUI remain unverified; no full toolbar class or native Cocoa chrome parity claim.") (:heading 2 "Keyboard accelerator action tables") (:p (:ref "guide/docs/KEYBOARD-ACCELERATORS.md" "Keyboard accelerators") " add bounded copied frame tables, modified ASCII keys/F1..F12 and shared Lisp model actions. Native command metadata/menu-state handling varies by port; all MENU callbacks conservatively guard installed frame subtrees. No physical keyboard/layout/platform completeness claim. Native arbitrary key/parser/resource and global hotkey APIs remain pending. Deferred UI actions now provide safe modal/clipboard/destructive work after menu/tool/accelerator callbacks; file IO remains composed by the Lisp application.") (:heading 2 "Deferred UI actions") (:p (:ref "guide/docs/DEFERRED-UI-ACTIONS.md" "Deferred UI actions") " add a bounded session FIFO, opaque tickets, optional weak owner, cancellation, safe idle delivery and error/root lifecycle. The managed App::ProcessIdle override is an internal prerequisite verified against native headers, omitted by the pinned interface inventory; wxWakeUpIdle and the partial wxApp mapping record the implemented scope. No CallAfter, timer, worker-thread, transaction or public native virtual-hook parity claim. The persistent form now integrates these requests with toolbar/accelerator entry points.") (:heading 2 "Deferred document-form application shell") (:p "The " (:ref "guide/docs/DOCUMENT-FORM.md" "persistent form") " now routes menus/tools/configured shortcut commands through one coalesced owner-bound request, with status feedback and deferred save/discard/cancel close replay. This is Lisp application composition using ABI43; no native declaration is newly implemented or marked complete. Generated coverage remains the factual native backlog and is regenerated/checked for this batch. Native OS panels/document frameworks/deep editor APIs remain deferred. Physical input, hosted OS GUI and clipboard interoperability are unrun. Bounded UI timers now provide periodic/one-shot status updates with owner/session lifetime and cancellation for monitoring applications.") (:heading 2 "Bounded UI timers") (:p (:ref "guide/docs/UI-TIMERS.md" "UI timers") " add coalesced periodic/one-shot safe-idle functions, opaque scheduler tickets, fair action ordering, weak owner/session lifetime, cancellation and error/root cleanup. Native wxTimer is partial: no public event receiver/native pointer adoption, restart/style/interval mutation or timing parity. OSX exact verified3.2.12 gate is explicit; hosted Windows/Linux GUI/timing remain unrun. Regenerated native checklist records only the actual private adapter scope. Bounded slider/spin numeric input now extends everyday forms; native timer/event/ clock parity remains deferred.") (:heading 2 "Bounded numeric input") (:p (:ref "guide/docs/NUMERIC-INPUT.md" "Sliders/integer spin controls") " add native-backed CLOS widgets, signed value/range properties, silent clamp and bounded native numeric update snapshots. Raw spin edits are prevalidated before native getters; text callbacks retain numeric lifetime guards. Class/declaration statuses remain partial, with styles, double-spin, raw numeric event resources and complete scroll families unbound. Physical input and hosted GTK/MSW/Qt GUI remain unverified. Bounded radio groups are delivered below.") (:heading 2 "Bounded mutually exclusive choices") (:p (:ref "guide/docs/RADIO-GROUPS.md" "Radio groups") " add wxRadioBox ownership, fixed choices, valid selection, silent/notifying generic SETF and native command snapshots/contexts. Standalone radio-button groups, item mutation/per-item state and broad styles remain unbound; inventory records only partial wxRadioBox support. Physical input and hosted platform GUI remain unverified. Bounded toggle buttons are delivered below.") (:heading 2 "Persistent toggle buttons") (:p (:ref "guide/docs/TOGGLE-BUTTONS.md" "Toggle buttons") " add native-backed independent pressed state, generic checked/label properties and guarded native command observation. Native wxToggleButton remains partial; bitmap toggles, styles and grouping stay unbound. Editable combo boxes are delivered below. Physical input and hosted platform GUI remain unverified.") (:heading 2 "Editable combo boxes") (:p (:ref "guide/docs/COMBO-BOXES.md" "Combo boxes") " add fixed preset choices plus single-line custom text, explicit text/selection properties and guarded native COMBO/TEXT events. Native combo/text-entry classes remain partial; sorted/read-only/style, mutable items and full editing APIs stay unbound. Physical input and hosted GUI remain unverified. Bounded scrolling panels are delivered below.") (:heading 2 "Scrolling panels for larger forms") (:p (:ref "guide/docs/SCROLLING-PANELS.md" "Scrolling panels") " add a wxScrolled<wxPanel> specialization, sizer fit, current pixel extent and rate/view-unit properties. Private helper ownership and native synchronous repaint are guarded; managed stack APIs reject. Drawing/target/coordinate and scroll-event depth stay unbound. Next selected slice: bounded focus navigation for keyboard-driven forms. Physical input, painting fidelity and hosted platform GUI remain unverified.") (:heading 2 "Scalable report views and tree interaction") (:p (:ref "guide/docs/REPORT-TREE-VIEWS.md" "Report and tree views") " add bounded native wxListCtrl report and LC_VIRTUAL text-hook adapters, columns/cell/count/selection/cache/activation metadata, checked native tree interactions and simple decorations. Native classes remain partial; no DataView parity or editor/file model is implied. Virtual hooks are pure synchronous queries with copied replies and audited bounded container ancestry. The subsequent image/bitmap/canvas and audited grid editing/dynamic shape slices are delivered below. Native pending APIs remain factual on-demand backlog.") (:heading 2 "Public image resources and native display geometry") (:p (:ref "guide/docs/IMAGES-DISPLAYS.md" "Images and displays") " add bounded session-owned wxImage/wxBitmap values, copied RGB/alpha/pixels, PNG-only stream IO, scaling, native static bitmap displays and read-only native display/window coordinate/scale queries. Retained canvas scenes support copied RGBA composition. Bitmap backing/logical/DIP size and scale remain distinct; no raw buffer/adoption, arbitrary image format, display mode switching or capture coverage is implied. These native classes remain partial. The selected grid dependency is implemented by " (:ref "guide/docs/GRID-EDITING.md" "native grid editing") ": scoped native validation/selection events, explicit editor methods, cell attributes and dynamic owned-string-table dimensions. Custom models/editors remain unbound.") (:heading 2 "Native grid editing and dynamic dimensions") (:p "ABI61 " (:ref "guide/docs/GRID-EDITING.md" "grid editing") " completes the selected bounded grid slice. Native CHANGING/CHANGED proposed/old text differs from copied current-cell values. Save, Hide, Disable and active-editor Reset retain native behavior; range/hidden veto is observational and Hide can later commit. Owned string-table axes can become empty and be restored within0..256/16384cells. Native inventory classes stay partial; custom models, renderers and editor ownership remain on-demand backlog. Independent review and verification are recorded in the handoff."))))
(:entry "guide/docs/coverage/README.md" :names ("docs/coverage/README.md" "README") :kind :guide :kind-name "Guide" :summary "docs/coverage/README.md" :sections (("Guide" (:heading 1 "wxWidgets coverage summary") (:p "Generated by " (:code "tools/coverage_inventory.py") " from wxWidgets 3.2.12 interface headers and " (:code "status.json (status.json)") ". " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "Coverage goal and status rules") ".") (:p "The goal is broad GUI coverage with selective depth. C1–C7 are inventory categories, not a delivery sequence. Native pending/partial status records factual gaps, not automatic release blockers. Core/planned/on-demand/Lisp-native/deferred feature priorities and representative-app acceptance live in the linked plan.") (:p "Counts are source-inventory tasks, including declarations, overloads, classes, styles and event tables; they are not distinct API counts or percent completion. Context is excluded from tasks. Class-definition counts overlap declaration tasks and must not be added to them. Reconcile additional native public interfaces and verify platforms when selected features or completeness claims require it.") (:heading 2 "Inventory categories") (:table :header (("Category") ("Headers") ("Tasks") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "C1: Foundation, values, application, events, and base utilities (phase-c1.md)")) ("119") ("5292") ("7") ("144") ("5141") ("26")) (((:code "C2: Windows, layout, basic controls, and input (phase-c2.md)")) ("82") ("2862") ("28") ("234") ("2600") ("0")) (((:code "C3: Dialogs, navigation, menus, and application services (phase-c3.md)")) ("57") ("1875") ("0") ("126") ("1749") ("0")) (((:code "C4: Models, complex controls, and document frameworks (phase-c4.md)")) ("20") ("2328") ("0") ("118") ("2210") ("4")) (((:code "C5: Drawing, images, graphics, and printing (phase-c5.md)")) ("52") ("2245") ("0") ("47") ("2198") ("0")) (((:code "C6: Optional libraries, rich content, and integration (phase-c6.md)")) ("57") ("8912") ("0") ("198") ("8714") ("380")) (((:code "C7: Platform extensions and remaining portability APIs (phase-c7.md)")) ("11") ("279") ("0") ("0") ("279") ("3")) (("Total") ("398") ("23793") ("35") ("867") ("22891") ("413")))) (:heading 2 "Classes and widgets") (:p "1016 class/struct definitions: 0 complete; 91 partial; 925 pending.") (:p "See the " (:code "complete class/widget index (classes.md)") " for partial scopes and missing types. An implemented constructor does not complete a class or its inherited API.") (:heading 2 "Header backlog") (:p "Use each linked header section to see the exact missing and partial declarations. A zero pending count alone cannot close a header with partial entries or unreviewed inherited/platform behavior.") (:heading 3 "C1: Foundation, values, application, events, and base utilities") (:table :header (("Header") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "wx/any.h (phase-c1.md#wxanyh)")) ("0") ("0") ("62") ("0")) (((:code "wx/app.h (phase-c1.md#wxapph)")) ("0") ("14") ("90") ("0")) (((:code "wx/appprogress.h (phase-c1.md#wxappprogressh)")) ("0") ("0") ("7") ("0")) (((:code "wx/apptrait.h (phase-c1.md#wxapptraith)")) ("0") ("0") ("15") ("0")) (((:code "wx/archive.h (phase-c1.md#wxarchiveh)")) ("0") ("0") ("55") ("0")) (((:code "wx/arrstr.h (phase-c1.md#wxarrstrh)")) ("0") ("0") ("49") ("0")) (((:code "wx/atomic.h (phase-c1.md#wxatomich)")) ("0") ("0") ("2") ("0")) (((:code "wx/base64.h (phase-c1.md#wxbase64h)")) ("0") ("0") ("11") ("0")) (((:code "wx/buffer.h (phase-c1.md#wxbufferh)")) ("0") ("0") ("59") ("0")) (((:code "wx/chartype.h (phase-c1.md#wxchartypeh)")) ("0") ("0") ("8") ("0")) (((:code "wx/clntdata.h (phase-c1.md#wxclntdatah)")) ("0") ("3") ("17") ("0")) (((:code "wx/cmdline.h (phase-c1.md#wxcmdlineh)")) ("0") ("0") ("70") ("0")) (((:code "wx/config.h (phase-c1.md#wxconfigh)")) ("0") ("0") ("70") ("0")) (((:code "wx/convauto.h (phase-c1.md#wxconvautoh)")) (