(:entry "api/stc-text" :names ("stc-text" "(setf stc-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read full native document or replace whole range through canonical SETF; embedded NUL preserved. Read-only control rejects writes." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stc-text control)")) ("Arguments" (:p "Control; SETF valid UTF-8 string fitting64MiB document bound.")) ("Returns" (:p "Fresh complete text string; writer returns supplied string.")) ("Description" (:p "Read full native document or replace whole range through canonical SETF; embedded NUL preserved. Read-only control rejects writes.")) ("Errors and scope" (:p "Active GUI thread/session and checked native STYLED-TEXT-CONTROL lifetime. UTF-8 byte offsets, never Lisp string indices; position arguments must be codepoint boundaries. Initial/replacement UTF-8 text supports embedded NUL and total<=64MiB; font/assist strings are NUL-free<=1MiB. Integer/index domains are bounded by the adapter. Mutations reject callbacks except same-control StartStyling/SetStyling/SetStyleBytes in the exact innermost native STYLENEEDED callback. Native synchronous events and source/ancestor lifetime/native-entry guards apply; use owner-bound deferred actions for other writes. No raw SendMsg, pointer/document adoption, lexer/resource ownership, worker calls or application editor abstractions. Requires wxUSE_STC and stc component. See docs/STYLED-TEXT.md.")) ("wxWidgets" (:p "wxStyledTextCtrl::GetTextRangeRaw/ReplaceTargetRaw, wxWidgets3.2.12.")) ("SETF" (:code-block "lisp" "(setf (wxlambda:stc-text control) value)") (:p "Return supplied value; copied native mutation with lifetime/domain/callback guards."))))
(:entry "api/stc-text-range" :names ("stc-text-range") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copied explicit-length native raw-text range." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stc-text-range control start end)")) ("Arguments" (:p "Control and ordered START/END UTF-8 byte boundaries within document.")) ("Returns" (:p "Fresh string for half-open byte range, preserving embedded NUL.")) ("Description" (:p "Copied explicit-length native raw-text range.")) ("Errors and scope" (:p "Active GUI thread/session and checked native STYLED-TEXT-CONTROL lifetime. UTF-8 byte offsets, never Lisp string indices; position arguments must be codepoint boundaries. Initial/replacement UTF-8 text supports embedded NUL and total<=64MiB; font/assist strings are NUL-free<=1MiB. Integer/index domains are bounded by the adapter. Mutations reject callbacks except same-control StartStyling/SetStyling/SetStyleBytes in the exact innermost native STYLENEEDED callback. Native synchronous events and source/ancestor lifetime/native-entry guards apply; use owner-bound deferred actions for other writes. No raw SendMsg, pointer/document adoption, lexer/resource ownership, worker calls or application editor abstractions. Requires wxUSE_STC and stc component. See docs/STYLED-TEXT.md.")) ("wxWidgets" (:p "wxStyledTextCtrl::GetTextRangeRaw, wxWidgets3.2.12."))))
