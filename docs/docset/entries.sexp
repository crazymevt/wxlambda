(:entry "example/examples/application-events.lisp" :names ("examples/application-events.lisp" "application-events") :kind :example :kind-name "Example" :summary "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows." :sections (("Usage" (:p "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp --eval '(wxlambda-application-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-application-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-application-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-application-events)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Application event dispatch\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label \"Waiting for an event\"))
         (button (wxlambda:make-button panel :label \"Inspect dispatch state\"))
         (clicks 0)
         (loop-running nil)
         (callback (lambda ()
                     (incf clicks)
                     (setf loop-running (wxlambda:main-loop-running-p))
                     (setf (wxlambda:label-text caption)
                           (format nil \"Event ~D; native main loop: ~S\"
                                   clicks loop-running)))))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel caption)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button callback)
    (wxlambda:show-window frame)
    (values frame button callback (lambda () (list clicks loop-running)))))

(defun exercise ()
  \"Run the same callback through explicit pending dispatch and the main loop.\"
  (multiple-value-bind (frame button callback state) (open-window)
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:queue-click button)
    (assert (wxlambda:pending-events-p))
    (wxlambda:process-pending-events)
    (assert (equal '(1 nil) (funcall state)))
    (wxlambda:on-click button (lambda () (funcall callback) (wxlambda:stop)))
    (wxlambda:queue-click button)
    (wxlambda:run)
    (assert (equal '(2 t) (funcall state)))
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/application-handler.lisp" :names ("examples/application-handler.lisp") :kind :example :kind-name "Example" :summary "Borrow the cached application event-handler view, queue a registered command, verify delivery and release the binding without destroying wxApp." :sections (("Usage" (:p "Borrow the cached application event-handler view, queue a registered command, verify delivery and release the binding without destroying wxApp.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-handler.lisp --eval '(wxlambda-application-handler:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-application-handler:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-application-handler
  (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-application-handler)

(defun exercise ()
  \"Dispatch an application-level message and release only its binding.\"
  (wxlambda:register-event-type :application-message :family :command)
  (let* ((app (wxlambda:current-application-handler))
         (received nil)
         (binding (wxlambda:bind-event app :application-message
                    (lambda (event) (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (wxlambda:queue-event app :application-message :text \"Application message\")
           (wxlambda:process-pending-events)
           (assert (equal received '(\"Application message\")))
           (assert (eq app (wxlambda:current-application-handler)))
           app)
      (wxlambda:unbind-event binding))))

(defun start ()
  (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/close-events.lisp" :names ("examples/close-events.lisp" "close-events") :kind :example :kind-name "Example" :summary "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup." :sections (("Usage" (:p "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/close-events.lisp --eval '(wxlambda-close-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-close-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-close-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-close-events)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Veto-capable close events\"))
         (panel (wxlambda:make-panel frame))
         (allow (wxlambda:make-checkbox panel :label \"Allow closing\"))
         (request (wxlambda:make-button panel :label \"Request close\"))
         (caption (wxlambda:make-label panel :label \"Closing is currently blocked\"))
         (blocked 0)
         (binding
           (wxlambda:bind-event frame :close
             (lambda (snapshot context)
               (assert (eq :close (wxlambda:event-family snapshot)))
               (if (and (wxlambda:event-can-veto-p context) (not (wxlambda:checked-p allow)))
                   (progn
                     (setf (wxlambda:event-vetoed-p context) t)
                     (incf blocked)
                     (setf (wxlambda:label-text caption) (format nil \"Blocked ~D close requests\" blocked)))
                   (progn
                     ;; Release the convenience callback before native default closing.
                     (wxlambda:off-click request)
                     (setf (wxlambda:event-skipped-p context) t))))
             :with-context t)))
    (wxlambda:make-column panel)
    (dolist (child (list allow request caption)) (wxlambda:add-child panel child))
    (wxlambda:on-click request (lambda () (wxlambda:close-window frame)))
    (wxlambda:show-window frame)
    (values frame allow request binding (lambda () blocked))))

(defun exercise ()
  (multiple-value-bind (frame allow request binding blocked) (open-window)
    (wxlambda:queue-click request)
    (wxlambda:process-events)
    (assert (= 1 (funcall blocked)))
    (assert (wxlambda:handler-alive-p frame))
    (setf (wxlambda:checked-p allow) t)
    (wxlambda:queue-click request)
    (wxlambda:process-events)
    (assert (not (wxlambda:handler-alive-p frame)))
    (assert (not (wxlambda:binding-active-p binding)))))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/command-event-payloads.lisp" :names ("examples/command-event-payloads.lisp" "command-event-payloads") :kind :example :kind-name "Example" :summary "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin." :sections (("Usage" (:p "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/command-event-payloads.lisp --eval '(wxlambda-command-event-payloads:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-command-event-payloads:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-command-event-payloads (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-command-event-payloads)
(defun exercise ()
  (wxlambda:register-event-type :payload-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :payload-message :extra-long 9))
         (before nil) (clone nil)
         (binding (wxlambda:bind-event receiver :payload-message
                    (lambda (event context)
                      (setf before event)
                      (assert (wxlambda:event-selection-p event))
                      (setf (wxlambda:event-extra-long context) 0
                            (wxlambda:event-origin-id context) nil)
                      (assert (null (wxlambda:event-origin-id context)))
                      (setf clone (wxlambda:clone-event context))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver message)
           (assert (= 9 (wxlambda:event-extra-long before) (wxlambda:event-extra-long message)))
           (assert (zerop (wxlambda:event-extra-long clone)))
           (assert (not (wxlambda:event-selection-p clone)))
           (assert (wxlambda:event-origin-id before)))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-bindings.lisp" :names ("examples/event-bindings.lisp" "event-bindings") :kind :example :kind-name "Example" :summary "Two independent ID-filtered command observers receive queued notifications on a standalone handler. A window button queues notifications; the exercise removes one observer without affecting the other and verifies cleanup." :sections (("Usage" (:p "Two independent ID-filtered command observers receive queued notifications on a standalone handler. A window button queues notifications; the exercise removes one observer without affecting the other and verifies cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-bindings.lisp --eval '(wxlambda-event-bindings:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-bindings:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-bindings
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-bindings)

(defun open-window ()
  (let* ((handler (wxlambda:make-event-handler))
         (frame (wxlambda:make-frame :title \"Independent event bindings\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label \"No queued notifications\"))
         (button (wxlambda:make-button panel :label \"Queue notification 42\"))
         (calls 0)
         (callback (lambda (event)
                     (assert (eq handler (wxlambda:event-source event)))
                     (incf calls)
                     (setf (wxlambda:label-text caption)
                           (format nil \"Observer calls: ~D; event ID: ~D\" calls (wxlambda:event-id event)))))
         (all (wxlambda:bind-event handler :click callback))
         (exact (wxlambda:bind-event handler :click callback :id 42)))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel caption)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button (lambda () (wxlambda:queue-event handler :click :id 42)))
    (wxlambda:show-window frame)
    (values frame handler button all exact (lambda () calls))))

(defun exercise ()
  (multiple-value-bind (frame handler button all exact calls) (open-window)
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (= 2 (funcall calls)))
    (assert (wxlambda:unbind-event exact))
    (assert (not (wxlambda:unbind-event exact)))
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (= 3 (funcall calls)))
    (wxlambda:unbind-event all)
    (wxlambda:off-click button)
    (wxlambda:destroy-event-handler handler)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-categories.lisp" :names ("examples/event-categories.lisp" "event-categories") :kind :example :kind-name "Example" :summary "Compare current/saved native category for a synthetic registered command and test USER_INPUT membership; no selective pumping or OS events." :sections (("Usage" (:p "Compare current/saved native category for a synthetic registered command and test USER_INPUT membership; no selective pumping or OS events.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-categories.lisp --eval '(wxlambda-event-categories:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-categories:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-categories (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-categories)
(defun exercise ()
  (wxlambda:register-event-type :category-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler)) (saved nil)
         (binding (wxlambda:bind-event receiver :category-message
                    (lambda (event context)
                      (setf saved event)
                      (assert (= (wxlambda:event-category event) (wxlambda:event-category context)))
                      (assert (logtest (wxlambda:event-category-mask :user-input) (wxlambda:event-category event))))
                    :with-context t)))
    (unwind-protect
         (progn (wxlambda:process-event receiver :category-message)
                (assert (= (wxlambda:event-category-mask :user-input) (wxlambda:event-category saved)))
                saved)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-contexts.lisp" :names ("examples/event-contexts.lisp" "event-contexts") :kind :example :kind-name "Example" :summary "A contextual button binding conditionally forwards commands to a parent observer. A checkbox controls Skip; the reusable exercise checks consumption, forwarding, native-type snapshots and expiration after callback return." :sections (("Usage" (:p "A contextual button binding conditionally forwards commands to a parent observer. A checkbox controls Skip; the reusable exercise checks consumption, forwarding, native-type snapshots and expiration after callback return.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-contexts.lisp --eval '(wxlambda-event-contexts:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-contexts:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-contexts
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-contexts)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Scoped event contexts\"))
         (panel (wxlambda:make-panel frame))
         (forward (wxlambda:make-checkbox panel :label \"Forward button commands\" :checked t))
         (button (wxlambda:make-button panel :label \"Dispatch a command\"))
         (caption (wxlambda:make-label panel :label \"No commands\"))
         (local 0) (parent 0) saved-context saved-event
         (display (lambda ()
                    (setf (wxlambda:label-text caption)
                          (format nil \"Local: ~D; parent: ~D\" local parent))))
         (child-binding
           (wxlambda:bind-event button :click
             (lambda (event context)
               (incf local)
               (setf saved-context context saved-event event)
               (assert (wxlambda:event-context-active-p context))
               (setf (wxlambda:event-skipped-p context) (wxlambda:checked-p forward))
               (funcall display))
             :with-context t))
         (parent-binding
           (wxlambda:bind-event frame :click
             (lambda (event) (declare (ignore event)) (incf parent) (funcall display)))))
    (wxlambda:make-column panel)
    (dolist (child (list forward button caption)) (wxlambda:add-child panel child))
    (wxlambda:show-window frame)
    (values frame forward button (list child-binding parent-binding)
            (lambda () (values local parent saved-event saved-context)))))

(defun exercise ()
  (multiple-value-bind (frame forward button bindings state) (open-window)
    (wxlambda:queue-click button)
    (wxlambda:process-pending-events)
    (multiple-value-bind (local parent event context) (funcall state)
      (assert (= 1 local parent))
      (assert (= (wxlambda:event-type :click) (wxlambda:event-native-type event)))
      (assert (not (wxlambda:event-context-active-p context))))
    (setf (wxlambda:checked-p forward) nil)
    (wxlambda:queue-click button)
    (wxlambda:process-pending-events)
    (multiple-value-bind (local parent) (funcall state)
      (assert (= 2 local)) (assert (= 1 parent)))
    (dolist (binding bindings) (wxlambda:unbind-event binding))
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-handlers.lisp" :names ("examples/event-handlers.lisp" "event-handlers") :kind :example :kind-name "Example" :summary "A standalone EVENT-HANDLER subclass reads native state in an AFTER hook. Separate window callbacks toggle event-handler processing without disabling window input. The exercise verifies queued callback gating and explicit owned-handler cleanup." :sections (("Usage" (:p "A standalone EVENT-HANDLER subclass reads native state in an AFTER hook. Separate window callbacks toggle event-handler processing without disabling window input. The exercise verifies queued callback gating and explicit owned-handler cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-handlers.lisp --eval '(wxlambda-event-handlers:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-handlers:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-handlers
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-handlers)

(defclass named-handler (wxlambda:event-handler)
  ((name :initarg :name :reader name)
   (initially-enabled :reader initially-enabled))
  (:default-initargs :name \"application-owned handler\"))
(defmethod initialize-instance :after ((handler named-handler) &key)
  (setf (slot-value handler 'initially-enabled) (wxlambda:handler-enabled-p handler)))

(defun open-window ()
  (let* ((handler (wxlambda:make-event-handler :class 'named-handler))
         (frame (wxlambda:make-frame :title \"Event handler ownership\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label (name handler)))
         (target (wxlambda:make-button panel :label \"Count events\"))
         (toggle (wxlambda:make-button panel :label \"Toggle target handler\"))
         (clicks 0))
    (wxlambda:make-column panel)
    (dolist (child (list caption target toggle)) (wxlambda:add-child panel child))
    (wxlambda:on-click target
      (lambda () (incf clicks) (setf (wxlambda:label-text caption) (format nil \"Events: ~D\" clicks))))
    (wxlambda:on-click toggle
      (lambda ()
        (setf (wxlambda:handler-enabled-p target) (not (wxlambda:handler-enabled-p target)))))
    (wxlambda:show-window frame)
    ;; HANDLER is an independently owned object, not a pushed window handler.
    (values frame handler target toggle (lambda () clicks))))

(defun exercise ()
  (multiple-value-bind (frame handler target toggle clicks) (open-window)
    (assert (initially-enabled handler))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (assert (not (wxlambda:handler-enabled-p target)))
    (assert (wxlambda:enabled-p target))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 2 (funcall clicks)))
    (wxlambda:off-click target)
    (wxlambda:off-click toggle)
    (wxlambda:destroy-event-handler handler)
    (assert (not (wxlambda:handler-alive-p handler)))
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-metadata.lisp" :names ("examples/event-metadata.lisp" "event-metadata") :kind :example :kind-name "Example" :summary "A synthetic close callback changes native CanVeto and timestamp metadata, applies checked veto and verifies the earlier snapshot remains unchanged. No real OS event is generated." :sections (("Usage" (:p "A synthetic close callback changes native CanVeto and timestamp metadata, applies checked veto and verifies the earlier snapshot remains unchanged. No real OS event is generated.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-metadata.lisp --eval '(wxlambda-event-metadata:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-metadata:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-metadata (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-metadata)
(defun exercise ()
  \"Inspect and alter a synthetic close event; snapshots remain unchanged.\"
  (let* ((receiver (wxlambda:make-event-handler))
         (captured nil)
         (binding (wxlambda:bind-event receiver :close
                    (lambda (event context)
                      (setf captured event)
                      (assert (not (wxlambda:event-command-p context)))
                      (assert (not (wxlambda:event-can-veto-p context)))
                      ;; This explicitly changes native metadata; it is not an OS guarantee.
                      (setf (wxlambda:event-can-veto-p context) t
                            (wxlambda:event-timestamp context) 123
                            (wxlambda:event-vetoed-p context) t)
                      (assert (= 123 (wxlambda:event-timestamp context)))) :with-context t)))
    (unwind-protect
         (progn
           (assert (equal '(t t) (multiple-value-list
                     (wxlambda:process-event receiver :close :can-veto-p nil))))
           (assert (not (wxlambda:event-can-veto-p captured)))
           (assert (zerop (wxlambda:event-timestamp captured))))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-origins.lisp" :names ("examples/event-origins.lisp" "event-origins") :kind :example :kind-name "Example" :summary "Compare child and parent native origin identities while binding receivers differ; check current/saved native type and release resources." :sections (("Usage" (:p "Compare child and parent native origin identities while binding receivers differ; check current/saved native type and release resources.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-origins.lisp --eval '(wxlambda-event-origins:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-origins:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-origins (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-origins)
(defun exercise ()
  (wxlambda:register-event-type :origin-message :family :command)
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel)) (child-origin nil) (parent-origin nil)
         (child-binding (wxlambda:bind-event child :origin-message
                          (lambda (e c)
                            (setf child-origin (wxlambda:event-origin-id e))
                            (assert (= (wxlambda:event-native-type e) (wxlambda:event-native-type c)))
                            (setf (wxlambda:event-skipped-p c) t)) :with-context t))
         (parent-binding (wxlambda:bind-event panel :origin-message
                           (lambda (e)
                             (assert (eq panel (wxlambda:event-source e)))
                             (setf parent-origin (wxlambda:event-origin-id e))))))
    (unwind-protect
         (progn (wxlambda:process-event child :origin-message)
                (assert (and child-origin (= child-origin parent-origin)))
                parent-origin)
      (wxlambda:unbind-event parent-binding)
      (wxlambda:unbind-event child-binding)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-routing.lisp" :names ("examples/event-routing.lisp" "event-routing") :kind :example :kind-name "Example" :summary "Rewrite a child command ID before parent delivery, verifying original and forwarded snapshot IDs and cleaning up bindings/windows." :sections (("Usage" (:p "Rewrite a child command ID before parent delivery, verifying original and forwarded snapshot IDs and cleaning up bindings/windows.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-routing.lisp --eval '(wxlambda-event-routing:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-routing:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-routing (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-routing)
(defun exercise ()
  \"Rewrite a command ID before parent delivery; the child's snapshot stays unchanged.\"
  (wxlambda:register-event-type :routed-command :family :command)
  (let* ((frame (wxlambda:make-frame))
         (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel))
         (before nil) (after nil)
         (parent-binding (wxlambda:bind-event panel :routed-command
                           (lambda (event) (setf after event)) :id 42))
         (child-binding (wxlambda:bind-event child :routed-command
                          (lambda (event context)
                            (setf before event)
                            (setf (wxlambda:event-id context) 42
                                  (wxlambda:event-skipped-p context) t)) :id 10 :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event child :routed-command :id 10)
           (assert (= 10 (wxlambda:event-id before)))
           (assert (= 42 (wxlambda:event-id after)))
           (assert (eq panel (wxlambda:event-source after))))
      (wxlambda:unbind-event child-binding)
      (wxlambda:unbind-event parent-binding)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-tags.lisp" :names ("examples/event-tags.lisp" "event-tags") :kind :example :kind-name "Example" :summary "Translate a registered command tag in a child callback, then verify payload-preserving parent delivery for synchronous and queued dispatch; clean up all resources." :sections (("Usage" (:p "Translate a registered command tag in a child callback, then verify payload-preserving parent delivery for synchronous and queued dispatch; clean up all resources.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-tags.lisp --eval '(wxlambda-event-tags:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-tags:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-tags (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-tags)
(defun exercise ()
  (wxlambda:register-event-type :raw-tag :family :command)
  (wxlambda:register-event-type :translated-tag :family :command)
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel)) (before nil) (after nil)
         (parent (wxlambda:bind-event panel :translated-tag (lambda (e) (setf after e))))
         (binding (wxlambda:bind-event child :raw-tag
                    (lambda (e c)
                      (setf before e)
                      (setf (wxlambda:event-native-type c) (wxlambda:event-type :translated-tag)
                            (wxlambda:event-skipped-p c) t)) :with-context t)))
    (unwind-protect
         (progn (wxlambda:process-event child :raw-tag :text \"copied payload\" :integer 42)
                (assert (eq :raw-tag (wxlambda:event-kind before)))
                (assert (eq :translated-tag (wxlambda:event-kind after)))
                (assert (= 42 (wxlambda:event-integer after)))
                (assert (string= \"copied payload\" (wxlambda:event-text after)))
                (setf after nil)
                (wxlambda:queue-event child :raw-tag :text \"copied payload\" :integer 42)
                (wxlambda:process-pending-events)
                (assert (eq :translated-tag (wxlambda:event-kind after))))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event parent)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/form-app.lisp" :names ("examples/form-app.lisp" "form-app") :kind :example :kind-name "Example" :summary "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically." :sections (("Usage" (:p "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form-app.lisp --eval '(wxlambda-form:start)'")) ("Source" (:code-block "lisp" ";;; Reusable form application. FORM.LISP launches it; START-LIVE enables editing.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-form
  (:use #:cl)
  (:export #:start #:start-live #:open-window #:close-window #:unbind-handlers
           #:submit-form #:set-submit-action #:*name* #:*greeting* #:*style*
           #:*status* #:*submit* #:*reopen*))
(in-package #:wxlambda-form)

(defvar *frame* nil)
(defvar *root* nil)
(defvar *name* nil)
(defvar *greeting* nil)
(defvar *style* nil)
(defvar *status* nil)
(defvar *submit* nil)
(defvar *reopen* nil)
(defvar *name-value* \"Ada\")
(defvar *greeting-value* t)
(defvar *style-value* 0)

(defun remember-input ()
  ;; Cleanup can also run after only part of the form was constructed.
  (when (and *name* *greeting* *style*)
    (setf *name-value* (wxlambda:text *name*)
          *greeting-value* (wxlambda:checked-p *greeting*)
          *style-value* (wxlambda:selection *style*))))

(defun edited ()
  (remember-input)
  (setf (wxlambda:label-text *status*) \"Edited; submit to preview\")
  (wxlambda:layout-window *root*))

(defun submit-form ()
  (remember-input)
  (setf (wxlambda:label-text *status*) (format nil (cond ((not *greeting-value*) \"Name: ~A\")
                      ((eql *style-value* 1) \"Good day, ~A.\")
                      (t \"Hello, ~A!\"))
            *name-value*))
  (wxlambda:layout-window *root*))

(defun set-submit-action (&optional (action 'submit-form))
  \"Replace the current submit handler. Symbol actions pick up function redefinitions.\"
  (wxlambda:on-click *submit* (lambda () (funcall action))))

(defun unbind-handlers ()
  \"Release all registered closures before destroying this form.\"
  (loop for (control unbind) in
        (list (list *name* #'wxlambda:off-text-change)
              (list *greeting* #'wxlambda:off-toggle)
              (list *style* #'wxlambda:off-selection)
              (list *submit* #'wxlambda:off-click)
              (list *reopen* #'wxlambda:off-click))
        when control do
          ;; If the user already closed the native frame, stale handles cannot
          ;; be unbound. Those closures remain rooted until session cleanup.
          (handler-case (funcall unbind control)
            (wxlambda:native-error () nil))))

(defun close-window ()
  (when *frame*
    (handler-case (remember-input)
      (wxlambda:native-error () nil))
    (unbind-handlers)
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *root* nil *name* nil *greeting* nil *style* nil
          *status* nil *submit* nil *reopen* nil)))

(defun open-window ()
  \"Recreate the form within the current session, retaining its input values.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"A Lisp form\" :width 560 :height 400)
        *root* (wxlambda:make-panel *frame*))
  (let* ((name-row (wxlambda:make-panel *root*))
         (name-label (wxlambda:make-label name-row :label \"Name\"))
         (style-row (wxlambda:make-panel *root*))
         (style-label (wxlambda:make-label style-row :label \"Style\"))
         (actions (wxlambda:make-panel *root*)))
    (setf *name* (wxlambda:make-text name-row :value *name-value*)
          *greeting* (wxlambda:make-checkbox *root* :label \"Include a greeting\"
                                           :checked *greeting-value*)
          *style* (wxlambda:make-choice style-row :items '(\"Friendly\" \"Formal\")
                                      :selection *style-value*)
          *status* (wxlambda:make-label *root* :label \"Ready\")
          *submit* (wxlambda:make-button actions :label \"Submit\")
          *reopen* (wxlambda:make-button actions :label \"Reopen form\"))
    (wxlambda:make-column *frame*)
    (wxlambda:add-child *frame* *root* :border 0 :proportion 1)
    (wxlambda:make-column *root*)
    (wxlambda:make-row name-row)
    (wxlambda:add-child name-row name-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer name-row 12)
    (wxlambda:add-child name-row *name* :border 0 :proportion 1)
    (wxlambda:make-row style-row)
    (wxlambda:add-child style-row style-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer style-row 12)
    (wxlambda:add-child style-row *style* :border 0 :proportion 1)
    (wxlambda:make-row actions)
    (wxlambda:add-stretch actions)
    (wxlambda:add-child actions *reopen* :border 0 :expand nil)
    (wxlambda:add-spacer actions 12)
    (wxlambda:add-child actions *submit* :border 0 :expand nil)
    (dolist (child (list name-row *greeting* style-row *status*))
      (wxlambda:add-child *root* child :border 12))
    (wxlambda:add-stretch *root*)
    (wxlambda:add-child *root* actions :border 12)
    (wxlambda:on-text-change *name* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-toggle *greeting* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-selection *style* (lambda (event) (declare (ignore event)) (edited)))
    (set-submit-action)
    (wxlambda:on-click *reopen* (lambda () (open-window)))
    (wxlambda:show-window *frame*)))

(defun start ()
  \"Run normally until the last frame closes. Restart Lisp for another session.\"
  (wxlambda:with-application ()
    (unwind-protect (progn (open-window) (wxlambda:run))
      (close-window))))

(defun start-live (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter the terminal application REPL. STOP/EOF ends this one GUI session.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/form.lisp" :names ("examples/form.lisp" "form") :kind :example :kind-name "Example" :summary "Run the representative form with text, checkbox and choice updates. Close the frame to exit." :sections (("Usage" (:p "Run the representative form with text, checkbox and choice updates. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp")) ("Source" (:code-block "lisp" ";;; Ordinary startup: load this file to run the form until its window closes.
(load (merge-pathnames \"form-app.lisp\" *load-truename*))
(wxlambda-form:start)
"))))
(:entry "example/examples/gauge.lisp" :names ("examples/gauge.lisp") :kind :example :kind-name "Example" :summary "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up." :sections (("Usage" (:p "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp --eval '(wxlambda-gauge:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-gauge:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-gauge
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-gauge)

(defclass progress (wxlambda:gauge)
  ((step :initarg :step :reader step-size)
   (completed :initform 0 :accessor completed))
  (:default-initargs :range 100 :step 25))

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Progress gauge\"))
         (panel (wxlambda:make-panel frame))
         (gauge (make-instance 'progress :parent panel))
         (advance (wxlambda:make-button panel :label \"Advance / restart\"))
         (pulse (wxlambda:make-button panel :label \"Indeterminate pulse\")))
    (wxlambda:make-column panel)
    (dolist (child (list gauge advance pulse)) (wxlambda:add-child panel child))
    (wxlambda:on-click advance
      (lambda ()
        ;; Pulse readings are animation state on some ports, not completed work.
        (setf (completed gauge)
              (if (>= (completed gauge) (wxlambda:gauge-range gauge))
                  0
                  (min (wxlambda:gauge-range gauge)
                       (+ (completed gauge) (step-size gauge)))))
        (setf (wxlambda:gauge-value gauge) (completed gauge))))
    (wxlambda:on-click pulse (lambda () (wxlambda:pulse-gauge gauge)))
    (wxlambda:show-window frame)
    (values frame gauge advance pulse)))

(defun exercise ()
  \"Run both interactive callbacks, restore determinate progress, and clean up.\"
  (multiple-value-bind (frame gauge advance pulse) (open-window)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 25 (wxlambda:gauge-value gauge)))
    (wxlambda:queue-click pulse)
    (wxlambda:process-events)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 50 (wxlambda:gauge-value gauge)))
    (dotimes (i 3)
      (wxlambda:queue-click advance)
      (wxlambda:process-events))
    (assert (zerop (wxlambda:gauge-value gauge)))
    (wxlambda:off-click advance)
    (wxlambda:off-click pulse)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/handler-chains.lisp" :names ("examples/handler-chains.lisp" "handler-chains") :kind :example :kind-name "Example" :summary "Build reciprocal standalone handler links, observe native chain delivery and detach/splice handlers without changing native ownership." :sections (("Usage" (:p "Build reciprocal standalone handler links, observe native chain delivery and detach/splice handlers without changing native ownership.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-chains.lisp --eval '(wxlambda-handler-chains:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-handler-chains:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-handler-chains (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-handler-chains)
(defun exercise ()
  (wxlambda:register-event-type :chain-message :family :command)
  (let* ((head (wxlambda:make-event-handler)) (tail (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :chain-message :text \"Through a chain\"))
         (received nil)
         (binding (wxlambda:bind-event tail :chain-message
                    (lambda (event)
                      (assert (eq tail (wxlambda:event-source event)))
                      (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (setf (wxlambda:next-handler head) tail)
           (assert (eq head (wxlambda:previous-handler tail)))
           (wxlambda:process-event-locally head source)
           (assert (equal '(\"Through a chain\") received))
           (wxlambda:unlink-event-handler tail)
           (assert (wxlambda:handler-unlinked-p head)))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler tail)
      (wxlambda:destroy-event-handler head))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/handler-client-data.lisp" :names ("examples/handler-client-data.lisp" "handler-client-data") :kind :example :kind-name "Example" :summary "Attach EQ-preserved Lisp state to a managed handler, read it through callback receiver identity and clear it before cleanup without exposing Lisp/native pointers." :sections (("Usage" (:p "Attach EQ-preserved Lisp state to a managed handler, read it through callback receiver identity and clear it before cleanup without exposing Lisp/native pointers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-client-data.lisp --eval '(wxlambda-handler-client-data:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-handler-client-data:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-handler-client-data (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-handler-client-data)

(defun exercise ()
  (let* ((handler (wxlambda:make-event-handler))
         (state (list :clicks 0))
         (binding nil))
    (unwind-protect
         (progn
           (setf (wxlambda:event-handler-client-data handler) state)
           (setf binding
                 (wxlambda:bind-event handler :click
                   (lambda (event)
                     (let ((data (wxlambda:event-handler-client-data
                                  (wxlambda:event-source event))))
                       (incf (getf data :clicks))))))
           (wxlambda:process-event handler :click)
           (assert (eq state (wxlambda:event-handler-client-data handler)))
           (assert (= 1 (getf state :clicks)))
           (setf (wxlambda:event-handler-client-data handler) nil)
           (assert (null (wxlambda:event-handler-client-data handler)))
           t)
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-event-handler handler))))

(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/hello.lisp" :names ("examples/hello.lisp" "hello") :kind :example :kind-name "Example" :summary "Editable Unicode text and button callbacks with copied event payloads. Close the frame to exit." :sections (("Usage" (:p "Editable Unicode text and button callbacks with copied event payloads. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Hello from Common Lisp\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hello, wxWidgets — λ\"))
         (button (wxlambda:make-button panel :label \"Click me\"))
         (clicks 0))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text)
    (wxlambda:add-child panel button)
    (wxlambda:on-text-change text
      (lambda (event)
        (format t \"Text edited: ~A~%\" (wxlambda:event-text event))))
    (wxlambda:on-click button
      (lambda (event)
        (assert (eq button (wxlambda:event-source event)))
        (format t \"Text before click: ~A~%\" (wxlambda:text text))
        (setf (wxlambda:text text :notify t) (format nil \"Clicked ~D times\" (incf clicks))))
      :with-event t)
    (wxlambda:show-window frame)
    (wxlambda:run)))
"))))
(:entry "example/examples/layout.lisp" :names ("examples/layout.lisp" "layout") :kind :example :kind-name "Example" :summary "Nested panel rows and columns with spacing and alignment. Close the frame to exit." :sections (("Usage" (:p "Nested panel rows and columns with spacing and alignment. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Rows, columns, and spacing\" :width 640 :height 360))
         (root (wxlambda:make-panel frame))
         (input-row (wxlambda:make-panel root))
         (footer (wxlambda:make-panel root))
         (input (wxlambda:make-text input-row :value \"Edit this text\"))
         (apply-button (wxlambda:make-button input-row :label \"Apply\"))
         (output (wxlambda:make-text root :value \"Click Apply to copy the input here\"))
         (close-button (wxlambda:make-button footer :label \"Close\")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame root :border 0 :proportion 1)
    (wxlambda:make-column root)
    (wxlambda:make-row input-row)
    (wxlambda:add-child input-row input :border 0 :proportion 1)
    (wxlambda:add-spacer input-row 12)
    (wxlambda:add-child input-row apply-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root input-row :border 12)
    (wxlambda:add-child root output :border 12)
    (wxlambda:add-stretch root)
    (wxlambda:make-row footer)
    (wxlambda:add-stretch footer)
    (wxlambda:add-child footer close-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root footer :border 12)
    (wxlambda:on-click apply-button
      (lambda () (setf (wxlambda:text output) (wxlambda:text input))))
    (wxlambda:on-click close-button (lambda () (wxlambda:destroy-window frame)))
    (wxlambda:show-window frame)
    (wxlambda:run)))
"))))
(:entry "example/examples/live.lisp" :names ("examples/live.lisp" "live") :kind :example :kind-name "Example" :summary "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit." :sections (("Usage" (:p "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/live.lisp --eval '(wxlambda-live:start)'")) ("Source" (:code-block "lisp" ";;; Load this file, then call (wxlambda-live:start) from a terminal REPL.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-live
  (:use #:cl)
  (:export #:start #:open-window #:close-window #:clicked #:*text* #:*button*))
(in-package #:wxlambda-live)

(defvar *frame* nil)
(defvar *text* nil)
(defvar *button* nil)
(defvar *clicks* 0)

(defun clicked ()
  (setf (wxlambda:text *text*) (format nil \"Clicked ~D times\" (incf *clicks*))))

(defun close-window ()
  \"Release registered closures before destroying the controls they reference.\"
  (when *frame*
    ;; A user may already have closed the native window. Its stale handles
    ;; cannot be unbound; session cleanup releases those retained closures.
    (handler-case (wxlambda:off-click *button*)
      (wxlambda:native-error () nil))
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *text* nil *button* nil)))

(defun open-window ()
  \"Replace the current window within the active session.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"Live Lisp development\")
        *text* (wxlambda:make-text *frame* :value \"Redefine WXLAMBDA-LIVE:CLICKED\")
        *button* (wxlambda:make-button *frame* :label \"Run current CLICKED\"))
  (wxlambda:make-column *frame*)
  (wxlambda:add-child *frame* *text*)
  (wxlambda:add-child *frame* *button*)
  ;; Resolve the function on each click so DEFUN changes take effect live.
  (wxlambda:on-click *button* (lambda () (clicked)))
  (wxlambda:show-window *frame*))

(defun start (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter one GUI session. Use WXLAMBDA:STOP or EOF; restart Lisp for another.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/notify-events.lisp" :names ("examples/notify-events.lisp" "notify-events") :kind :example :kind-name "Example" :summary "A registered notify event validates a proposed change synchronously before applying it. A checkbox selects Veto or Allow; the reusable exercise verifies blocked and accepted changes, both callback paths and cleanup." :sections (("Usage" (:p "A registered notify event validates a proposed change synchronously before applying it. A checkbox selects Veto or Allow; the reusable exercise verifies blocked and accepted changes, both callback paths and cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notify-events.lisp --eval '(wxlambda-notify-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-notify-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-notify-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-notify-events)

(defun open-window ()
  (wxlambda:register-event-type :before-apply :family :notify)
  (let* ((frame (wxlambda:make-frame :title \"Synchronous notify policy\"))
         (panel (wxlambda:make-panel frame))
         (receiver (wxlambda:make-event-handler))
         (reject (wxlambda:make-checkbox panel :label \"Reject changes\" :checked t))
         (apply (wxlambda:make-button panel :label \"Validate then apply\"))
         (caption (wxlambda:make-label panel :label \"No change applied\"))
         (applied 0)
         (binding (wxlambda:bind-event receiver :before-apply
                    (lambda (event context)
                      (assert (eq :notify (wxlambda:event-family event)))
                      (setf (wxlambda:event-vetoed-p context) (wxlambda:checked-p reject)))
                    :with-context t)))
    (wxlambda:make-column panel)
    (dolist (child (list reject apply caption)) (wxlambda:add-child panel child))
    (wxlambda:on-click apply
      (lambda ()
        (multiple-value-bind (handled vetoed)
            (wxlambda:process-event receiver :before-apply :text \"Apply change\" :integer (1+ applied))
          (if (and handled (not vetoed))
              (progn (incf applied) (setf (wxlambda:label-text caption) (format nil \"Applied ~D\" applied)))
              (setf (wxlambda:label-text caption) \"Change rejected\")))))
    (wxlambda:show-window frame)
    (values frame receiver reject apply binding (lambda () applied))))

(defun exercise ()
  (multiple-value-bind (frame receiver reject apply binding applied) (open-window)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (zerop (funcall applied)))
    (setf (wxlambda:checked-p reject) nil)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (= 1 (funcall applied)))
    (wxlambda:off-click apply)
    (wxlambda:unbind-event binding)
    (wxlambda:destroy-event-handler receiver)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/owned-events.lisp" :names ("examples/owned-events.lisp" "owned-events") :kind :example :kind-name "Example" :summary "Construct a reusable native message, mutate only a dispatch copy, retain a detached context clone, queue an independent copy and destroy its source before delivery." :sections (("Usage" (:p "Construct a reusable native message, mutate only a dispatch copy, retain a detached context clone, queue an independent copy and destroy its source before delivery.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/owned-events.lisp --eval '(wxlambda-owned-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-owned-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-owned-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-owned-events)
(defun exercise ()
  (wxlambda:register-event-type :reusable-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :reusable-message :text \"original\" :integer 1))
         (captured nil) (clone nil)
         (binding (wxlambda:bind-event receiver :reusable-message
                    (lambda (event context)
                      (setf captured event)
                      (setf (wxlambda:event-text context) \"changed live copy\"
                            (wxlambda:event-integer context) 7)
                      (setf clone (wxlambda:clone-event context))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver message)
           (assert (string= \"original\" (wxlambda:event-text message)))
           (assert (string= \"original\" (wxlambda:event-text captured)))
           (assert (string= \"changed live copy\" (wxlambda:event-text clone)))
           (assert (= 7 (wxlambda:event-integer clone)))
           (assert (null (wxlambda:event-origin-id clone)))
           (wxlambda:unbind-event binding)
           (setf binding (wxlambda:bind-event receiver :reusable-message (lambda (e) (setf captured e))))
           (wxlambda:queue-event receiver clone)
           (wxlambda:destroy-event clone) (setf clone nil)
           (wxlambda:process-pending-events)
           (assert (string= \"changed live copy\" (wxlambda:event-text captured))))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/pending-events.lisp" :names ("examples/pending-events.lisp" "pending-events") :kind :example :kind-name "Example" :summary "Compare posted copies, consumed transfer inputs, local synchronous processing and handler-specific pending cancellation using owned events." :sections (("Usage" (:p "Compare posted copies, consumed transfer inputs, local synchronous processing and handler-specific pending cancellation using owned events.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/pending-events.lisp --eval '(wxlambda-pending-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-pending-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-pending-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-pending-events)
(defun exercise ()
  (wxlambda:register-event-type :pending-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :pending-message :text \"posted\"))
         (received nil)
         (binding (wxlambda:bind-event receiver :pending-message
                    (lambda (event) (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (wxlambda:post-event receiver source)
           (setf (wxlambda:event-text source) \"transferred\")
           (wxlambda:transfer-event receiver source)
           (assert (not (wxlambda:event-alive-p source)))
           (wxlambda:process-pending-events)
           (assert (equal '(\"transferred\" \"posted\") received))
           (let ((discarded (wxlambda:make-event :kind :pending-message :text \"discarded\")))
             (wxlambda:transfer-event receiver discarded)
             (wxlambda:delete-pending-events receiver)
             (wxlambda:process-pending-events)
             (assert (= 2 (length received)))))
      (when (wxlambda:event-alive-p source) (wxlambda:destroy-event source))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/session-events.lisp" :names ("examples/session-events.lisp" "session-events") :kind :example :kind-name "Example" :summary "Isolated standalone query-end-session policy with logging-off metadata and checked veto. Never dispatches synthetic session events to wxApp or triggers real OS logout/shutdown." :sections (("Usage" (:p "Isolated standalone query-end-session policy with logging-off metadata and checked veto. Never dispatches synthetic session events to wxApp or triggers real OS logout/shutdown.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/session-events.lisp --eval '(wxlambda-session-events:start)'")) ("Source" (:code-block "lisp" ";;; Synthetic policy exercise only: never emits OS session events on wxApp.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-session-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-session-events)
(defun exercise ()
  (let* ((receiver (wxlambda:make-event-handler))
         (binding (wxlambda:bind-event receiver :query-end-session
                    (lambda (event context)
                      (assert (wxlambda:event-logging-off-p event))
                      (when (wxlambda:event-can-veto-p context)
                        (setf (wxlambda:event-vetoed-p context) t))) :with-context t)))
    (unwind-protect
         (assert (equal '(t t) (multiple-value-list
                   (wxlambda:process-event receiver :query-end-session :logging-off-p t))))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/window-handler-stacks.lisp" :names ("examples/window-handler-stacks.lisp" "window-handler-stacks") :kind :example :kind-name "Example" :summary "Push managed standalone handlers on a window, compare explicit stack-aware and generic bypass routing, then pop/remove without transferring native ownership." :sections (("Usage" (:p "Push managed standalone handlers on a window, compare explicit stack-aware and generic bypass routing, then pop/remove without transferring native ownership.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-handler-stacks.lisp --eval '(wxlambda-window-handler-stacks:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-window-handler-stacks:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-window-handler-stacks (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-window-handler-stacks)
(defun exercise ()
  (wxlambda:register-event-type :stack-message :family :command)
  (let* ((frame (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :stack-message :text \"Window stack\"))
         (calls 0)
         (binding (wxlambda:bind-event handler :stack-message
                    (lambda (event) (assert (eq handler (wxlambda:event-source event))) (incf calls)))))
    (unwind-protect
         (progn
           (wxlambda:push-event-handler frame handler)
           (assert (eq handler (wxlambda:window-event-handler frame)))
           (wxlambda:process-window-event frame message)
           (assert (= 1 calls))
           (assert (eq handler (wxlambda:pop-event-handler frame)))
           (assert (eq frame (wxlambda:window-event-handler frame)))
           (wxlambda:push-event-handler frame handler)
           (wxlambda:destroy-window frame)
           (wxlambda:process-events)
           (assert (wxlambda:handler-alive-p handler))
           (assert (wxlambda:handler-unlinked-p handler)))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler handler)
      (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame)))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/window-metadata.lisp" :names ("examples/window-metadata.lisp" "window-metadata") :kind :example :kind-name "Example" :summary "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup." :sections (("Usage" (:p "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp --eval '(wxlambda-window-metadata:start)'")) ("Source" (:code-block "lisp" ";;; Load this file and call (wxlambda-window-metadata:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-metadata
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-metadata)

(defclass tracking-frame (wxlambda:frame)
  ((title-updates :initform 0 :accessor title-updates)))

(defmethod (setf wxlambda:frame-title) :after (value (frame tracking-frame))
  (declare (ignore value))
  (incf (title-updates frame)))

(defun open-window ()
  (let* ((frame (make-instance 'tracking-frame :title \"Window metadata\"))
         (panel (wxlambda:make-panel frame))
         (button (wxlambda:make-button panel :label \"Rename window and update title\"))
         (changes 0))
    (setf (wxlambda:window-name frame) \"metadata-example\")
    (wxlambda:make-column panel)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda ()
        (incf changes)
        (setf (wxlambda:window-name frame) (format nil \"metadata-~D\" changes))
        (setf (wxlambda:frame-title frame) (format nil \"Updated ~D — λ 日本語 😀\" changes))))
    (wxlambda:show-window frame)
    (values frame button)))

(defun exercise ()
  \"Exercise the same callback as the interactive example, then clean up.\"
  (multiple-value-bind (frame button) (open-window)
    (assert (string= \"metadata-example\" (wxlambda:window-name frame)))
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (string= \"metadata-1\" (wxlambda:window-name frame)))
    (assert (string= \"Updated 1 — λ 日本語 😀\" (wxlambda:frame-title frame)))
    (assert (= 1 (title-updates frame)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
(:entry "example/examples/window-state.lisp" :names ("examples/window-state.lisp" "window-state") :kind :example :kind-name "Example" :summary "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input." :sections (("Usage" (:p "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp --eval '(wxlambda-window-state:start)'")) ("Source" (:code-block "lisp" ";;; Reusable state example. Run (wxlambda-window-state:start), or use the
;;; noninteractive exercise called by tests/window-state.lisp.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-state
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-state)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Window state\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hide/show and disable/enable me\"))
         (visibility (wxlambda:make-button panel :label \"Toggle text visibility\"))
         (input (wxlambda:make-button panel :label \"Toggle text input\")))
    (wxlambda:make-column panel)
    (dolist (child (list text visibility input)) (wxlambda:add-child panel child))
    (wxlambda:on-click visibility
      (lambda ()
        (wxlambda:show-window text (not (wxlambda:shown-p text)))
        (wxlambda:layout-window panel)))
    (wxlambda:on-click input
      (lambda () (wxlambda:enable-window text (not (wxlambda:enabled-p text)))))
    (wxlambda:show-window frame)
    (values frame panel text visibility input)))

(defun exercise ()
  \"Run the example's actual callbacks, then release handlers and close it.\"
  (multiple-value-bind (frame panel text visibility input) (open-window)
    (declare (ignore panel))
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (not (wxlambda:shown-p text)))
    (assert (not (wxlambda:enabled-p text)))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:off-click visibility)
    (wxlambda:off-click input)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
