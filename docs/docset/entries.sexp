(:entry "example/examples/activity-indicator.lisp" :names ("examples/activity-indicator.lisp") :kind :example :kind-name "Example" :summary "Native busy feedback toggled through owner-bound deferred button commands; EXERCISE checks state/labels, not animation pixels or background work." :sections (("Usage" (:p "Native busy feedback toggled through owner-bound deferred button commands; EXERCISE checks state/labels, not animation pixels or background work.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/activity-indicator.lisp --eval '(wxlambda-activity-indicator:start)'")) ("Source" (:code-block "lisp" ";;; A busy indicator with owner-bound deferred state changes.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-activity-indicator (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-activity-indicator)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Busy feedback λ\" :width 400 :height 210))
         (panel (wxlambda:make-panel frame))
         (indicator (wxlambda:make-activity-indicator panel))
         (feedback (wxlambda:make-label panel :label \"Idle\"))
         (toggle (wxlambda:make-button panel :label \"Toggle busy state\")))
    (wxlambda:make-column panel)
    (dolist (child (list indicator feedback toggle)) (wxlambda:add-child panel child :border 8))
    (wxlambda:on-click toggle
      (lambda ()
        (wxlambda:defer-ui-action
          (lambda ()
            (setf (wxlambda:activity-running-p indicator) (not (wxlambda:activity-running-p indicator))
                  (wxlambda:label-text feedback) (if (wxlambda:activity-running-p indicator) \"Busy — animation only\" \"Idle\")))
          :owner indicator)))
    (values frame indicator feedback toggle)))
(defun exercise ()
  (multiple-value-bind (frame indicator feedback toggle) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (not (wxlambda:activity-running-p indicator)))
           (wxlambda:queue-click toggle)
           (loop repeat 30 until (wxlambda:activity-running-p indicator) do (wxlambda:process-events))
           (assert (wxlambda:activity-running-p indicator))
           (assert (string= \"Busy — animation only\" (wxlambda:label-text feedback)))
           (wxlambda:queue-click toggle)
           (loop repeat 30 while (wxlambda:activity-running-p indicator) do (wxlambda:process-events))
           (assert (not (wxlambda:activity-running-p indicator)))
           (assert (string= \"Idle\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/application-events.lisp" :names ("examples/application-events.lisp" "application-events") :kind :example :kind-name "Example" :summary "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows." :sections (("Usage" (:p "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp --eval '(wxlambda-application-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-application-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-application-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-application-events)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Application event dispatch\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label \"Waiting for an event\"))
         (button (wxlambda:make-button panel :label \"Inspect dispatch state\"))
         (clicks 0)
         (loop-running nil)
         (callback (lambda ()
                     (incf clicks)
                     (setf loop-running (wxlambda:main-loop-running-p))
                     (setf (wxlambda:label-text caption)
                           (format nil \"Event ~D; native main loop: ~S\"
                                   clicks loop-running)))))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel caption)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button callback)
    (wxlambda:show-window frame)
    (values frame button callback (lambda () (list clicks loop-running)))))

(defun exercise ()
  \"Run the same callback through explicit pending dispatch and the main loop.\"
  (multiple-value-bind (frame button callback state) (open-window)
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:queue-click button)
    (assert (wxlambda:pending-events-p))
    (wxlambda:process-pending-events)
    (assert (equal '(1 nil) (funcall state)))
    (wxlambda:on-click button (lambda () (funcall callback) (wxlambda:stop)))
    (wxlambda:queue-click button)
    (wxlambda:run)
    (assert (equal '(2 t) (funcall state)))
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/application-handler.lisp" :names ("examples/application-handler.lisp") :kind :example :kind-name "Example" :summary "Borrow the cached application event-handler view, queue a registered command, verify delivery and release the binding without destroying wxApp." :sections (("Usage" (:p "Borrow the cached application event-handler view, queue a registered command, verify delivery and release the binding without destroying wxApp.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-handler.lisp --eval '(wxlambda-application-handler:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-application-handler:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-application-handler
  (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-application-handler)

(defun exercise ()
  \"Dispatch an application-level message and release only its binding.\"
  (wxlambda:register-event-type :application-message :family :command)
  (let* ((app (wxlambda:current-application-handler))
         (received nil)
         (binding (wxlambda:bind-event app :application-message
                    (lambda (event) (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (wxlambda:queue-event app :application-message :text \"Application message\")
           (wxlambda:process-pending-events)
           (assert (equal received '(\"Application message\")))
           (assert (eq app (wxlambda:current-application-handler)))
           app)
      (wxlambda:unbind-event binding))))

(defun start ()
  (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/aui-notebook.lisp" :names ("examples/aui-notebook.lisp") :kind :example :kind-name "Example" :summary "General dynamic panel workspace inside a splitter with deferred Add/Delete/Move/Split actions. Programmatic native tab groups preserve page ownership; mouse reorder is limited to one group. No editor abstraction." :sections (("Usage" (:p "General dynamic panel workspace inside a splitter with deferred Add/Delete/Move/Split actions. Programmatic native tab groups preserve page ownership; mouse reorder is limited to one group. No editor abstraction.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/aui-notebook.lisp --eval '(wxlambda-aui-notebook:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-aui-notebook (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-aui-notebook)
(defun add-page (book label)
  (let ((page (wxlambda:make-panel book)))
    (wxlambda:make-column page)
    (wxlambda:add-child page (wxlambda:make-label page :label label) :border 12)
    (wxlambda:add-notebook-page book page :label label :select t)))
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Dynamic window workspace λ\" :width 850 :height 500))
         (splitter (wxlambda:make-splitter-window frame :sash-position 180))
         (sidebar (wxlambda:make-panel splitter)) (workspace (wxlambda:make-panel splitter))
         (book (wxlambda:make-aui-notebook workspace))
         (add (wxlambda:make-button sidebar :label \"Add page\"))
         (close (wxlambda:make-button sidebar :label \"Delete selected\"))
         (move (wxlambda:make-button sidebar :label \"Move last to first\"))
         (split (wxlambda:make-button sidebar :label \"Split selected right\")) (counter 1))
    (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :expand t)
    (wxlambda:make-column sidebar)
    (dolist (button (list add close move split)) (wxlambda:add-child sidebar button :border 8))
    (wxlambda:make-column workspace) (wxlambda:add-child workspace book :proportion 1 :expand t)
    (wxlambda:initialize-splitter splitter sidebar)
    (wxlambda:resplit-window splitter workspace)
    (add-page book \"First λ\")
    (wxlambda:on-click add (lambda ()
      (wxlambda:defer-ui-action (lambda () (add-page book (format nil \"Page ~D\" (incf counter)))) :owner book)))
    (wxlambda:on-click close (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (let ((index (wxlambda:selection book))) (when index (wxlambda:delete-notebook-page book index)))) :owner book)))
    (wxlambda:on-click move (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (let ((count (wxlambda:notebook-page-count book)))
          (when (> count 1) (wxlambda:move-notebook-page book (1- count) 0)))) :owner book)))
    (wxlambda:on-click split (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (when (> (wxlambda:notebook-page-count book) 1)
          (wxlambda:split-notebook-page book (wxlambda:selection book) :right))) :owner book)))
    (values frame book add close move splitter)))
(defun exercise ()
  (multiple-value-bind (frame book add close move splitter) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (let ((sidebar (wxlambda:splitter-pane splitter 0))
                 (workspace (wxlambda:splitter-pane splitter 1)))
             (assert (eq sidebar (wxlambda:unsplit-window splitter :remove 0)))
             (assert (eq workspace (wxlambda:splitter-pane splitter 0)))
             (assert (eq workspace (wxlambda:replace-splitter-pane splitter 0 sidebar)))
             (wxlambda:resplit-window splitter workspace)
             (setf (wxlambda:splitter-orientation splitter) :horizontal)
             (assert (eq :horizontal (wxlambda:splitter-orientation splitter)))
             (setf (wxlambda:splitter-orientation splitter) :vertical)
             (assert (eq sidebar (wxlambda:splitter-pane splitter 0)))
             (assert (eq workspace (wxlambda:splitter-pane splitter 1))))
           (wxlambda:queue-click add)
           (loop repeat 40 until (= 2 (wxlambda:notebook-page-count book)) do (wxlambda:process-events))
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (wxlambda:split-notebook-page book 1 :right)
           (let ((last (wxlambda:notebook-page book 1)))
             (wxlambda:queue-click move)
             (loop repeat 40 until (eq last (wxlambda:notebook-page book 0)) do (wxlambda:process-events))
             (assert (eq last (wxlambda:notebook-page book 0))))
           (wxlambda:queue-click close)
           (loop repeat 40 until (= 1 (wxlambda:notebook-page-count book)) do (wxlambda:process-events))
           (assert (= 1 (wxlambda:notebook-page-count book))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/binding-user-data.lisp" :names ("examples/binding-user-data.lisp" "binding-user-data") :kind :example :kind-name "Example" :summary "Associate EQ Lisp state per binding, read it through snapshots/current contexts and preserve active data across unbinding without exposing native pointers." :sections (("Usage" (:p "Associate EQ Lisp state per binding, read it through snapshots/current contexts and preserve active data across unbinding without exposing native pointers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/binding-user-data.lisp --eval '(wxlambda-binding-user-data:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-binding-user-data:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-binding-user-data (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-binding-user-data)

(defun exercise ()
  (let* ((receiver (wxlambda:make-event-handler))
         (state (list :count 0))
         (saved nil) (binding nil))
    (unwind-protect
         (progn
           (setf binding
                 (wxlambda:bind-event receiver :click
                   (lambda (event context)
                     (setf saved event)
                     (let ((data (wxlambda:event-user-data context)))
                       (incf (getf data :count)))
                     (wxlambda:unbind-event binding)
                     ;; The active callback retains its datum after unbinding.
                     (assert (eq state (wxlambda:event-user-data context))))
                   :with-context t :user-data state))
           (wxlambda:process-event receiver :click)
           (assert (= 1 (getf state :count)))
           (assert (eq state (wxlambda:event-user-data saved)))
           t)
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-event-handler receiver))))

(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/clipboard.lisp" :names ("examples/clipboard.lisp" "clipboard") :kind :example :kind-name "Example" :summary "Interactive START copies/replaces a whole single-line field through the standard text clipboard with best-effort flush; automatic EXERCISE only queries availability and never reads/replaces system clipboard content." :sections (("Usage" (:p "Interactive START copies/replaces a whole single-line field through the standard text clipboard with best-effort flush; automatic EXERCISE only queries availability and never reads/replaces system clipboard content.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/clipboard.lisp --eval '(wxlambda:with-application () (wxlambda-clipboard:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive. EXERCISE only queries clipboard availability.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-clipboard (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-clipboard)

(defun exercise ()
  ;; Do not read or replace clipboard contents during an automatic example run.
  (assert (typep (wxlambda:clipboard-text-available-p) 'boolean))
  t)

(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title \"Text clipboard\"))
           (panel (wxlambda:make-panel frame))
           (text (wxlambda:make-text panel :value \"Copy this name\"))
           (copy (wxlambda:make-button panel :label \"Copy whole field\"))
           (paste (wxlambda:make-button panel :label \"Replace field from clipboard\"))
           (status (wxlambda:make-label panel :label \"Ready\")))
      (labels ((report (function)
                 (handler-case (funcall function)
                   (error (condition) (setf (wxlambda:label-text status) (princ-to-string condition))))))
        (wxlambda:make-column frame)
        (wxlambda:add-child frame panel :proportion 1 :border 0)
        (wxlambda:make-column panel)
        (dolist (child (list text copy paste status)) (wxlambda:add-child panel child))
        (wxlambda:on-click copy
          (lambda ()
            (report (lambda ()
                      (setf (wxlambda:clipboard-text) (wxlambda:text text))
                      (setf (wxlambda:label-text status)
                            (if (wxlambda:flush-clipboard) \"Copied\" \"Copied; persistence unavailable\"))))))
        (wxlambda:on-click paste
          (lambda ()
            (report (lambda ()
                      (let ((value (wxlambda:clipboard-text)))
                        (cond ((null value) (setf (wxlambda:label-text status) \"No clipboard text\"))
                              ((find-if (lambda (char) (find char '(#\\Newline #\\Return))) value)
                               (error \"This field accepts a single line.\"))
                              (t (setf (wxlambda:text text) value
                                       (wxlambda:label-text status) \"Pasted\"))))))))
        (unwind-protect
             (progn (wxlambda:show-window frame) (wxlambda:run))
          (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
          (wxlambda:process-events))))))
"))))
(:entry "example/examples/close-events.lisp" :names ("examples/close-events.lisp" "close-events") :kind :example :kind-name "Example" :summary "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup." :sections (("Usage" (:p "A contextual close callback vetoes while a checkbox blocks closing, then releases the convenience callback and delegates to native frame closing. The exercise runs real queued-button requests, checks rejection/liveness and accepted closing cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/close-events.lisp --eval '(wxlambda-close-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-close-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-close-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-close-events)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Veto-capable close events\"))
         (panel (wxlambda:make-panel frame))
         (allow (wxlambda:make-checkbox panel :label \"Allow closing\"))
         (request (wxlambda:make-button panel :label \"Request close\"))
         (caption (wxlambda:make-label panel :label \"Closing is currently blocked\"))
         (blocked 0)
         (binding
           (wxlambda:bind-event frame :close
             (lambda (snapshot context)
               (assert (eq :close (wxlambda:event-family snapshot)))
               (if (and (wxlambda:event-can-veto-p context) (not (wxlambda:checked-p allow)))
                   (progn
                     (setf (wxlambda:event-vetoed-p context) t)
                     (incf blocked)
                     (setf (wxlambda:label-text caption) (format nil \"Blocked ~D close requests\" blocked)))
                   (progn
                     ;; Release the convenience callback before native default closing.
                     (wxlambda:off-click request)
                     (setf (wxlambda:event-skipped-p context) t))))
             :with-context t)))
    (wxlambda:make-column panel)
    (dolist (child (list allow request caption)) (wxlambda:add-child panel child))
    (wxlambda:on-click request (lambda () (wxlambda:close-window frame)))
    (wxlambda:show-window frame)
    (values frame allow request binding (lambda () blocked))))

(defun exercise ()
  (multiple-value-bind (frame allow request binding blocked) (open-window)
    (wxlambda:queue-click request)
    (wxlambda:process-events)
    (assert (= 1 (funcall blocked)))
    (assert (wxlambda:handler-alive-p frame))
    (setf (wxlambda:checked-p allow) t)
    (wxlambda:queue-click request)
    (wxlambda:process-events)
    (assert (not (wxlambda:handler-alive-p frame)))
    (assert (not (wxlambda:binding-active-p binding)))))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/combo-boxes.lisp" :names ("examples/combo-boxes.lisp" "combo-boxes") :kind :example :kind-name "Example" :summary "Choose a fixed destination preset or type a custom value. EXERCISE checks silent/explicit selection and text notifications, UTF-8 and NIL clearing; no physical input simulation." :sections (("Usage" (:p "Choose a fixed destination preset or type a custom value. EXERCISE checks silent/explicit selection and text notifications, UTF-8 and NIL clearing; no physical input simulation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/combo-boxes.lisp --eval '(wxlambda-combo-boxes:start)'")) ("Source" (:code-block "lisp" ";;; Select a preset or type a custom destination. START interactive, EXERCISE automatic.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-combo-boxes (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-combo-boxes)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Destination\" :width 460 :height 230))
         (panel (wxlambda:make-panel frame))
         (combo (wxlambda:make-combo-box panel :items '(\"Inbox\" \"Archive\" \"Review λ\") :selection 0))
         (feedback (wxlambda:make-label panel :label \"Destination: Inbox\")) (changes 0))
    (flet ((update (event)
             (incf changes)
             (setf (wxlambda:label-text feedback) (format nil \"Destination: ~A\" (wxlambda:event-text event)))))
      (wxlambda:bind-event combo :combo-selection #'update)
      (wxlambda:bind-event combo :text-change #'update))
    (wxlambda:make-column panel)
    (dolist (child (list combo feedback)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame combo feedback (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame combo feedback changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (= 0 (wxlambda:selection combo))) (assert (string= \"Inbox\" (wxlambda:text combo)))
           (setf (wxlambda:selection combo) 1) (assert (zerop (funcall changes)))
           (setf (wxlambda:selection combo :notify t) 2)
           (assert (string= \"Destination: Review λ\" (wxlambda:label-text feedback)))
           (setf (wxlambda:text combo :notify t) \"Custom λ\")
           (assert (string= \"Destination: Custom λ\" (wxlambda:label-text feedback)))
           (assert (= 2 (funcall changes)))
           (setf (wxlambda:selection combo) nil)
           (assert (and (null (wxlambda:selection combo)) (string= \"\" (wxlambda:text combo)))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/command-event-payloads.lisp" :names ("examples/command-event-payloads.lisp" "command-event-payloads") :kind :example :kind-name "Example" :summary "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin." :sections (("Usage" (:p "Compare semantic toggle/selection views with raw extra-LONG action metadata, mutate live owned/context payloads and safely detach a registered command origin.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/command-event-payloads.lisp --eval '(wxlambda-command-event-payloads:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-command-event-payloads:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-command-event-payloads (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-command-event-payloads)
(defun exercise ()
  (wxlambda:register-event-type :payload-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :payload-message :extra-long 9))
         (before nil) (clone nil)
         (binding (wxlambda:bind-event receiver :payload-message
                    (lambda (event context)
                      (setf before event)
                      (assert (wxlambda:event-selection-p event))
                      (setf (wxlambda:event-extra-long context) 0
                            (wxlambda:event-origin-id context) nil)
                      (assert (null (wxlambda:event-origin-id context)))
                      (setf clone (wxlambda:clone-event context))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver message)
           (assert (= 9 (wxlambda:event-extra-long before) (wxlambda:event-extra-long message)))
           (assert (zerop (wxlambda:event-extra-long clone)))
           (assert (not (wxlambda:event-selection-p clone)))
           (assert (wxlambda:event-origin-id before)))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/date-picker.lisp" :names ("examples/date-picker.lisp") :kind :example :kind-name "Example" :summary "Required due date with leap-day initialization, copied native change snapshots and an owner-bound deferred Reset action. EXERCISE checks explicit-notify label updates and reset without simulating physical date input." :sections (("Usage" (:p "Required due date with leap-day initialization, copied native change snapshots and an owner-bound deferred Reset action. EXERCISE checks explicit-notify label updates and reset without simulating physical date input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/date-picker.lisp --eval '(wxlambda-date-picker:start)'")) ("Source" (:code-block "lisp" ";;; A required due date with a copied calendar tuple and native change snapshots.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-date-picker (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-date-picker)
(defun date-label (date)
  (if date (format nil \"Due: ~4,'0D-~2,'0D-~2,'0D\" (first date) (second date) (third date)) \"No supported event date\"))
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Due date λ\" :width 440 :height 230))
         (panel (wxlambda:make-panel frame))
         (picker (wxlambda:make-date-picker panel :date '(2028 2 29)))
         (feedback (wxlambda:make-label panel :label (date-label (wxlambda:calendar-date picker))))
         (reset (wxlambda:make-button panel :label \"Reset due date\")))
    (wxlambda:make-column panel)
    (dolist (child (list picker feedback reset)) (wxlambda:add-child panel child :border 8))
    (setf (wxlambda:tooltip-text picker) \"Choose a due date between 1900 and 2100.\")
    (wxlambda:bind-event picker :date-change
      (lambda (event) (setf (wxlambda:label-text feedback) (date-label (wxlambda:event-date event)))))
    (wxlambda:on-click reset
      (lambda () (wxlambda:defer-ui-action
                   (lambda () (setf (wxlambda:calendar-date picker :notify t) '(2028 2 29))) :owner picker)))
    (values frame picker feedback reset)))
(defun exercise ()
  (multiple-value-bind (frame picker feedback reset) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:calendar-date picker :notify t) '(2030 12 31))
           (assert (string= \"Due: 2030-12-31\" (wxlambda:label-text feedback)))
           (wxlambda:queue-click reset)
           (loop repeat 30 until (equal '(2028 2 29) (wxlambda:calendar-date picker)) do (wxlambda:process-events))
           (assert (equal '(2028 2 29) (wxlambda:calendar-date picker)))
           (assert (string= \"Due: 2028-02-29\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/deferred-actions.lisp" :names ("examples/deferred-actions.lisp" "deferred-actions") :kind :example :kind-name "Example" :summary "Queue shared menu/tool/keyboard requests for choosing a path, copying editor text and confirmed close. START interactive; EXERCISE injects deterministic chooser/clipboard/confirmation functions without touching system clipboard text." :sections (("Usage" (:p "Queue shared menu/tool/keyboard requests for choosing a path, copying editor text and confirmed close. START interactive; EXERCISE injects deterministic chooser/clipboard/confirmation functions without touching system clipboard text.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/deferred-actions.lisp --eval '(wxlambda-deferred-actions:start)'")) ("Source" (:code-block "lisp" ";;; Safe menu/tool/keyboard requests. EXERCISE uses injected file/clipboard/confirmation functions.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-deferred-actions (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-deferred-actions)
(defun pick-file (frame)
  (let ((dialog (wxlambda:make-file-dialog :parent frame :title \"Choose a file\")))
    (unwind-protect
         (when (eq :ok (wxlambda:show-modal dialog)) (wxlambda:file-dialog-path dialog))
      (wxlambda:destroy-window dialog))))
(defun confirm-close (frame)
  (let ((dialog (wxlambda:make-message-dialog :parent frame :message \"Close this example?\" :buttons :yes-no)))
    (unwind-protect (eq :yes (wxlambda:show-modal dialog)) (wxlambda:destroy-window dialog))))
(defun build-window (&key (choose #'pick-file) (copy-text (lambda (text) (setf (wxlambda:clipboard-text) text)))
                          (confirm #'confirm-close))
  (let* ((frame (wxlambda:make-frame :title \"Deferred UI actions λ\" :width 660 :height 400
                                  :accelerators '((#\\o 32101 :ctrl) (#\\c 32102 :ctrl :shift) (#\\w 32103 :ctrl))))
         (toolbar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame))
         (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label \"&Actions\"))
         (panel (wxlambda:make-panel frame))
         (editor (wxlambda:make-text panel :multiline t :value \"Copy this text λ 日本語 😀\"))
         (latest nil))
    (loop for id in '(32101 32102 32103) for label in '(\"Choose file\" \"Copy text\" \"Close\")
          for art in '(:open :copy :quit) do
            (wxlambda:make-menu-item menu :id id :label label)
            (wxlambda:add-toolbar-tool toolbar id label :art art))
    (wxlambda:realize-toolbar toolbar)
    (wxlambda:make-column panel) (wxlambda:add-child panel editor :proportion 1 :expand t :border 8)
    (setf (wxlambda:status-text status) \"Ready — choose file, copy text or close\")
    (labels ((request (event context)
               (declare (ignore context))
               (let ((id (wxlambda:event-id event)))
                 (setf latest
                       (wxlambda:defer-ui-action
                         (lambda ()
                           (case id
                             (32101 (let ((path (funcall choose frame)))
                                      (setf (wxlambda:status-text status) (or path \"File selection canceled\"))))
                             (32102 (funcall copy-text (wxlambda:text editor))
                                    (setf (wxlambda:status-text status) \"Text copied\"))
                             (32103 (if (funcall confirm frame) (wxlambda:close-window frame)
                                        (setf (wxlambda:status-text status) \"Close canceled\")))))
                         :owner frame)))))
      ;; Consume toolbar commands before frame propagation; each request queues once.
      (wxlambda:bind-event toolbar :menu #'request :id 32101 :last-id 32103 :with-context t)
      (wxlambda:bind-event frame :menu #'request :id 32101 :last-id 32103 :with-context t))
    (values frame toolbar status (lambda () latest))))
(defun drain (ticket)
  (loop repeat 30 while (wxlambda:ui-action-pending-p ticket) do (wxlambda:process-events))
  (assert (not (wxlambda:ui-action-pending-p ticket))))
(defun exercise ()
  (let ((chosen 0) (copied nil) (permit-close nil))
    (multiple-value-bind (frame toolbar status latest)
        (build-window :choose (lambda (frame) (declare (ignore frame)) (incf chosen) \"/example/notes λ.txt\")
                      :copy-text (lambda (text) (setf copied text))
                      :confirm (lambda (frame) (declare (ignore frame)) permit-close))
      (unwind-protect
           (progn
             (wxlambda:show-window frame)
             (wxlambda:process-event frame :menu :id 32101)
             (assert (zerop chosen)) ; scheduling is never inline
             (wxlambda:process-pending-events)
             (assert (zerop chosen)) ; pending-only dispatch does not run the idle queue
             (drain (funcall latest))
             (assert (= 1 chosen))
             (assert (string= \"/example/notes λ.txt\" (wxlambda:status-text status)))
             (wxlambda:activate-toolbar-tool toolbar 32102)
             (assert (null copied)) (drain (funcall latest))
             (assert (string= \"Copy this text λ 日本語 😀\" copied))
             (wxlambda:process-event frame :menu :id 32103) (drain (funcall latest))
             (assert (string= \"Close canceled\" (wxlambda:status-text status)))
             (setf permit-close t)
             (wxlambda:process-event frame :menu :id 32103) (drain (funcall latest))
             t)
        (ignore-errors (wxlambda:destroy-window frame)) (wxlambda:process-events)))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/document-form.lisp" :names ("examples/document-form.lisp" "document-form") :kind :example :kind-name "Example" :summary "Persistent UTF-8 form with deferred shared Open/Save/Save As/Copy/Paste/close actions via menus, toolbar and portable keyboard IDs; status feedback, first-request coalescing, delivery-time state, save/discard/cancel and scoped close replay. EXERCISE uses a canceled scripted toolbar Save. Clipboard tests isolate system content; native OS panels, physical shortcuts and multiline editing remain outside this example." :sections (("Usage" (:p "Persistent UTF-8 form with deferred shared Open/Save/Save As/Copy/Paste/close actions via menus, toolbar and portable keyboard IDs; status feedback, first-request coalescing, delivery-time state, save/discard/cancel and scoped close replay. EXERCISE uses a canceled scripted toolbar Save. Clipboard tests isolate system content; native OS panels, physical shortcuts and multiline editing remain outside this example.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/document-form.lisp --eval '(wxlambda:with-application () (wxlambda-document-form:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE runs with an already active application.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-document-form
  (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-document-form)

(defstruct document-form
  frame name greeting style status path baseline busy
  choose-path confirm-changes report-error items toolbar pending-action action-active close-approved disposed)

(defun form-values (form)
  (list (wxlambda:text (document-form-name form))
        (not (null (wxlambda:checked-p (document-form-greeting form))))
        (wxlambda:selection (document-form-style form))))

(defun dirty-p (form)
  (not (equal (form-values form) (document-form-baseline form))))

(defun native-basename (path)
  (uiop:native-namestring (make-pathname :host nil :device nil :directory nil :defaults path)))

(defun refresh (form)
  (setf (wxlambda:frame-title (document-form-frame form))
        (format nil \"~A~A — Lisp form\"
                (if (dirty-p form) \"* \" \"\")
                (if (document-form-path form)
                    (native-basename (document-form-path form)) \"Untitled\"))))

(defun install-values (form values path)
  ;; Non-notifying setters avoid treating a loaded document as a user edit.
  (setf (wxlambda:text (document-form-name form)) (first values)
        (wxlambda:checked-p (document-form-greeting form)) (second values)
        (wxlambda:selection (document-form-style form)) (third values)
        (document-form-path form) path
        (document-form-baseline form) (copy-tree values))
  (refresh form))

(defun read-document (path)
  ;; Deliberately no Lisp reader: files are data, never executable forms.
  (with-open-file (stream path :external-format :utf-8)
    (let ((header (read-line stream nil nil))
          (name (read-line stream nil nil))
          (greeting (read-line stream nil nil))
          (style (read-line stream nil nil)))
      (unless (and (equal header \"WXLAMBDA-FORM-1\") name
                   (not (find-if (lambda (char) (find char '(#\\Newline #\\Return))) name))
                   (member greeting '(\"yes\" \"no\") :test #'equal)
                   (member style '(\"friendly\" \"formal\") :test #'equal)
                   (eq :eof (read-line stream nil :eof)))
        (error \"Invalid form document: ~A\" path))
      (list name (equal greeting \"yes\") (if (equal style \"formal\") 1 0)))))

(defun write-document (path values)
  ;; Finish writing a unique sibling before replacing the target. No durability,
  ;; metadata-preservation or cross-platform atomic-replacement guarantee.
  (when (find-if (lambda (char) (find char '(#\\Newline #\\Return))) (first values))
    (error \"A form name must fit on one line.\"))
  (let ((temporary nil) (stream nil))
    (unwind-protect
         (progn
           (loop repeat 100
                 for candidate = (make-pathname :name (format nil \".wxlambda-~36R\" (random (expt 36 12)))
                                                :type \"tmp\" :defaults path)
                 do (setf stream (open candidate :direction :output :external-format :utf-8
                                      :if-exists nil :if-does-not-exist :create))
                 when stream do (setf temporary candidate) (return))
           (unless stream (error \"Unable to create a temporary sibling of ~A\" path))
           (format stream \"WXLAMBDA-FORM-1~%~A~%~A~%~A~%\" (first values)
                   (if (second values) \"yes\" \"no\") (if (= 1 (third values)) \"formal\" \"friendly\"))
           (close stream)
           (setf stream nil)
           (uiop:rename-file-overwriting-target temporary path)
           (setf temporary nil)
           t)
      (when stream (close stream :abort t))
      (when (and temporary (probe-file temporary)) (delete-file temporary)))))

(defun choose-path (form mode)
  (let* ((old (document-form-path form))
         (dialog (wxlambda:make-file-dialog
                  :parent (document-form-frame form) :mode mode
                  :directory (if old (uiop:pathname-directory-pathname old) \"\")
                  :filename (if old (native-basename old) \"\")
                  :wildcard \"Lisp form documents|*.wxform|All files|*\")))
    (unwind-protect
         (when (eq :ok (wxlambda:show-modal dialog))
           (uiop:parse-native-namestring (wxlambda:file-dialog-path dialog)))
      (wxlambda:destroy-window dialog))))

(defun confirm-changes (form)
  (let ((dialog (wxlambda:make-message-dialog
                 :parent (document-form-frame form) :title \"Unsaved changes\"
                 :message \"Save changes first? Yes saves, No discards, Cancel keeps this form.\"
                 :buttons :yes-no-cancel :icon :question)))
    (unwind-protect (wxlambda:show-modal dialog)
      (wxlambda:destroy-window dialog))))

(defun report-error (form condition)
  (let ((dialog (wxlambda:make-message-dialog :parent (document-form-frame form)
                 :title \"Document operation failed\" :message (princ-to-string condition) :icon :error)))
    (unwind-protect (wxlambda:show-modal dialog)
      (wxlambda:destroy-window dialog))))

(defun save-document (form &optional save-as)
  (let ((path (if (and (not save-as) (document-form-path form))
                  (document-form-path form)
                  (funcall (document-form-choose-path form) form :save)))
        (values (form-values form)))
    (when path
      (setf path (merge-pathnames path))
      (write-document path values)
      (setf (document-form-path form) path
            (document-form-baseline form) (copy-tree values)
            (wxlambda:status-text (document-form-status form)) \"Saved\")
      (refresh form)
      t)))

(defun may-discard-p (form)
  (or (not (dirty-p form))
      (case (funcall (document-form-confirm-changes form) form)
        (:yes (save-document form)) (:no t) (otherwise nil))))

(defun perform-command (form command)
  ;; Nested native loops can deliver other commands. A second command must not
  ;; replace the document underneath a modal action already in progress.
  (unless (document-form-busy form)
    (setf (document-form-busy form) t)
    (unwind-protect
         (handler-case
             (ecase command
               (:copy-name
                (setf (wxlambda:clipboard-text) (wxlambda:text (document-form-name form)))
                (setf (wxlambda:status-text (document-form-status form))
                      (if (wxlambda:flush-clipboard) \"Copied name\" \"Copied name; persistence unavailable\"))
                t)
               (:paste-name
                (let ((value (wxlambda:clipboard-text)))
                  (when value
                    (when (find-if (lambda (char) (find char '(#\\Newline #\\Return))) value)
                      (error \"The form name must fit on one line.\"))
                    (setf (wxlambda:text (document-form-name form)) value)
                    (refresh form)
                    (setf (wxlambda:status-text (document-form-status form)) \"Pasted name\")
                    t)))
               (:save (save-document form))
               (:save-as (save-document form t))
               (:open
                (when (may-discard-p form)
                  (let ((path (funcall (document-form-choose-path form) form :open)))
                    (when path
                      (setf path (merge-pathnames path))
                      (let ((values (read-document path)))
                        (install-values form values path)
                        (setf (wxlambda:status-text (document-form-status form)) \"Opened\")
                        t)))))
               (:close (may-discard-p form)))
           (error (condition)
             (funcall (document-form-report-error form) form condition)
             nil))
      (setf (document-form-busy form) nil))))

(defparameter +form-commands+
  '((12101 :open \"&Open…\" :open \"Open document (Ctrl/Command+O)\")
    (12102 :save \"&Save\" :save \"Save (Ctrl/Command+S)\")
    (12103 :save-as \"Save &As…\" :save \"Save As (Ctrl/Command+Shift+S)\")
    (12104 :close \"&Close\" :quit \"Close (Ctrl/Command+W)\")
    (12105 :copy-name \"Copy name\" :copy \"Copy whole name (Ctrl/Command+Shift+C)\")
    (12106 :paste-name \"Paste name\" :paste \"Paste whole name (Ctrl/Command+Shift+V)\")))

(defun cancel-request (form)
  (when (document-form-pending-action form)
    (wxlambda:cancel-ui-action (document-form-pending-action form))
    (setf (document-form-pending-action form) nil)))

(defun command-views-enabled (form enabled)
  (when (wxlambda:handler-alive-p (document-form-frame form))
    (dolist (item (document-form-items form)) (setf (wxlambda:enabled-p item) enabled))
    (dolist (entry +form-commands+)
      (setf (wxlambda:tool-enabled-p (document-form-toolbar form) (first entry)) enabled))))

(defun close-approved-form (form)
  ;; Approval applies only to this synchronous replay, not future close requests.
  (unwind-protect
       (progn (setf (document-form-close-approved form) t)
              (wxlambda:close-window (document-form-frame form)))
    (setf (document-form-close-approved form) nil)))

(defun request-command (form command)
  ;; First request wins until delivery completes. Coalesce even different commands
  ;; while pending/active, including those arriving from nested modal callbacks.
  (unless (or (document-form-disposed form) (document-form-busy form)
              (document-form-action-active form)
              (not (wxlambda:handler-alive-p (document-form-frame form))))
    (let ((pending (document-form-pending-action form)))
      (when (and pending (wxlambda:ui-action-pending-p pending))
        (return-from request-command nil)))
    (setf (document-form-pending-action form)
          (wxlambda:defer-ui-action
            (lambda ()
              (setf (document-form-pending-action form) nil
                    (document-form-action-active form) t)
              (unwind-protect
                   (progn
                     (command-views-enabled form nil)
                     (when (perform-command form command)
                       (when (eq command :close) (close-approved-form form))))
                (setf (document-form-action-active form) nil)
                (command-views-enabled form t)))
            :owner (document-form-frame form)))))

(defun drain-form-action (form)
  ;; Bounded exercise/test helper; interactive delivery is driven by RUN.
  (loop repeat 40
        while (and (document-form-pending-action form)
                   (wxlambda:ui-action-pending-p (document-form-pending-action form)))
        do (wxlambda:process-events))
  (let ((pending (document-form-pending-action form)))
    (assert (or (null pending) (not (wxlambda:ui-action-pending-p pending))))))

(defun open-form (&key (choose-path #'choose-path) (confirm-changes #'confirm-changes)
                       (report-error #'report-error))
  (let* ((frame (wxlambda:make-frame :title \"Untitled — Lisp form\" :width 640 :height 360
                                     :accelerators '((#\\o 12101 :ctrl) (#\\s 12102 :ctrl)
                                                     (#\\s 12103 :ctrl :shift) (#\\w 12104 :ctrl)
                                                     (#\\c 12105 :ctrl :shift) (#\\v 12106 :ctrl :shift))))
         (form (make-document-form :frame frame :choose-path choose-path
                                  :confirm-changes confirm-changes :report-error report-error)))
    (handler-case
        (let* ((panel (wxlambda:make-panel frame))
               (bar (wxlambda:make-menu-bar frame))
               (menu (wxlambda:make-menu bar :label \"&File\"))
               (edit (wxlambda:make-menu bar :label \"&Edit\")))
          (setf (document-form-name form) (wxlambda:make-text panel :value \"Ada\")
                (document-form-greeting form) (wxlambda:make-checkbox panel :label \"Include greeting\" :checked t)
                (document-form-style form) (wxlambda:make-choice panel :items '(\"Friendly\" \"Formal\") :selection 0)
                (document-form-status form) (wxlambda:make-status-bar frame)
                (document-form-toolbar form) (wxlambda:make-toolbar frame)
                (document-form-items form)
                (loop for entry in +form-commands+ for index from 0
                      collect (wxlambda:make-menu-item (if (< index 4) menu edit)
                                :id (first entry) :label (third entry))))
          (let ((toolbar (document-form-toolbar form)))
            (dolist (index '(0 1 2 :separator 4 5 :separator 3))
              (if (eq index :separator) (wxlambda:add-toolbar-separator toolbar)
                  (destructuring-bind (id command label art help) (nth index +form-commands+)
                    (declare (ignore command))
                    (wxlambda:add-toolbar-tool toolbar id (remove #\\& label) :art art :help help))))
            (wxlambda:realize-toolbar toolbar))
          (setf (wxlambda:status-text (document-form-status form)) \"Ready\")
          (wxlambda:make-column frame)
          (wxlambda:add-child frame panel :proportion 1 :border 0)
          (wxlambda:make-column panel)
          (dolist (child (list (document-form-name form) (document-form-greeting form)
                              (document-form-style form)))
            (wxlambda:add-child panel child :border 12))
          (setf (document-form-baseline form) (form-values form))
          (wxlambda:on-text-change (document-form-name form) (lambda (event) (declare (ignore event)) (refresh form)))
          (wxlambda:on-toggle (document-form-greeting form) (lambda (event) (declare (ignore event)) (refresh form)))
          (wxlambda:on-selection (document-form-style form) (lambda (event) (declare (ignore event)) (refresh form)))
          (labels ((request (event context)
                     (declare (ignore context))
                     (let ((entry (assoc (wxlambda:event-id event) +form-commands+)))
                       (when entry (request-command form (second entry))))))
            ;; Consume at the toolbar before propagation; keyboard/menu commands
            ;; share the frame receiver and portable action IDs.
            (wxlambda:bind-event (document-form-toolbar form) :menu #'request
              :id 12101 :last-id 12106 :with-context t)
            (wxlambda:bind-event frame :menu #'request :id 12101 :last-id 12106 :with-context t))
          (wxlambda:bind-event frame :close
            (lambda (event context)
              (cond
                ;; Forced/non-vetoable close cannot promise a save opportunity.
                ((not (wxlambda:event-can-veto-p event))
                 (cancel-request form) (setf (wxlambda:event-skipped-p context) t))
                ((wxlambda:event-vetoed-p context)
                 ;; A preceding handler may veto and still propagate. Do not
                 ;; let native default destruction override that decision.
                 (setf (wxlambda:event-skipped-p context) nil))
                ((document-form-close-approved form)
                 (setf (document-form-close-approved form) nil
                       (wxlambda:event-skipped-p context) t))
                (t
                 (setf (wxlambda:event-vetoed-p context) t)
                 (request-command form :close))))
            :with-context t)
          (wxlambda:show-window frame)
          form)
      (error (condition) (wxlambda:destroy-window frame) (error condition)))))

(defun dispose-form (form)
  (setf (document-form-disposed form) t)
  (cancel-request form)
  (when (wxlambda:handler-alive-p (document-form-frame form))
    (wxlambda:destroy-window (document-form-frame form)))
  (wxlambda:process-events))

(defun exercise ()
  (let ((form (open-form :choose-path (lambda (form mode) (declare (ignore form mode)) nil))))
    (unwind-protect
         (progn
           (assert (not (dirty-p form)))
           (setf (wxlambda:text (document-form-name form) :notify t) \"Grace λ\")
           (assert (dirty-p form))
           (assert (wxlambda:activate-toolbar-tool (document-form-toolbar form) 12102))
           (assert (document-form-pending-action form))
           (drain-form-action form)
           (assert (dirty-p form))
           t)
      (dispose-form form))))

(defun start ()
  (wxlambda:with-application ()
    (let ((form (open-form)))
      (unwind-protect (wxlambda:run) (dispose-form form)))))
"))))
(:entry "example/examples/drawing-monitor.lisp" :names ("examples/drawing-monitor.lisp" "drawing-monitor") :kind :example :kind-name "Example" :summary "Retained native canvas with bounded geometry, Unicode text/font/RGB/bitmap adapters, activity animation and owner-bound periodic UI updates. EXERCISE self-stops after three real timer ticks, exports PNG and resumes; data is simulated, not background work." :sections (("Usage" (:p "Retained native canvas with bounded geometry, Unicode text/font/RGB/bitmap adapters, activity animation and owner-bound periodic UI updates. EXERCISE self-stops after three real timer ticks, exports PNG and resumes; data is simulated, not background work.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/drawing-monitor.lisp --eval '(wxlambda-drawing-monitor:start)'")) ("Source" (:code-block "lisp" ";;; Retained drawing, native activity, and bounded safe-idle timer monitoring.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-drawing-monitor (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-drawing-monitor)
(defun badge-pixels ()
  (let ((pixels (make-array (* 16 16 4) :element-type '(unsigned-byte 8))))
    (dotimes (i 256 pixels)
      (let ((colour (if (evenp (+ (floor (floor i 16) 4) (floor (mod i 16) 4))) '(77 225 193) '(255 197 92))))
        (loop for byte in colour for j from 0 do (setf (aref pixels (+ (* i 4) j)) byte))
        (setf (aref pixels (+ (* i 4) 3)) (if (or (zerop (mod i 16)) (zerop (floor i 16))) 0 220))))))
(defun monitor-scene (tick width height)
  (let* ((width (max 320 (min width 1200))) (height (max 180 (min height 700)))
         (bottom (- height 30)) (graph-height (- bottom 78)) (span (- width 50))
         (items (list (list :text 20 14 \"Signal monitor λ\" 18 '(238 244 255))
                      (list :text 20 43 (format nil \"Simulated samples / update ~D\" tick) 10 '(160 178 203))
                      (list :rgba-bitmap (- width 40) 18 16 16 (badge-pixels))
                      (list :line 20 bottom (- width 20) bottom '(87 109 138) 1))))
    (dotimes (i 5)
      (let ((y (+ 78 (round (* i (/ graph-height 4))))))
        (push (list :line 20 y (- width 20) y '(37 51 72) 1) items)))
    (dotimes (i 32)
      (let* ((amplitude (+ 0.12d0 (* 0.82d0 (/ (+ 1d0 (sin (+ (* i 0.24d0) (* tick 0.20d0)))) 2d0))))
             (bar-height (max 1 (round (* amplitude graph-height))))
             (x (+ 24 (round (* i (/ span 32))))))
        (push (list :rect x (- bottom bar-height) (max 2 (- (floor span 32) 4)) bar-height '(77 225 193)) items)))
    (push (list :ellipse (- width 28) (- height 23) 8 8 '(255 197 92)) items)
    (list :background '(18 24 38) :items (nreverse items))))
(defun build-window (&key (interval 180) max-ticks)
  (let* ((frame (wxlambda:make-frame :title \"Drawing / monitoring workflow\" :width 680 :height 420))
         (panel (wxlambda:make-panel frame))
         (canvas (wxlambda:make-drawing-canvas panel))
         (indicator (wxlambda:make-activity-indicator panel))
         (toggle (wxlambda:make-button panel :label \"Pause / Resume\"))
         (feedback (wxlambda:make-label panel :label \"Waiting for a native timer tick\"))
         (timer nil) (count 0))
    (labels ((redraw ()
               (destructuring-bind (width height) (wxlambda:canvas-client-size canvas)
                 (setf (wxlambda:canvas-content canvas) (monitor-scene count width height))))
             (stop-monitor ()
               (when timer (wxlambda:cancel-ui-timer timer))
               (setf (wxlambda:activity-running-p indicator) nil
                     (wxlambda:label-text feedback) (format nil \"Paused after ~D updates\" count)))
             (begin ()
               (setf (wxlambda:activity-running-p indicator) t)
               (setf timer (wxlambda:start-ui-timer
                 (lambda ()
                   (incf count) (redraw)
                   (setf (wxlambda:label-text feedback) (format nil \"Update ~D — retained scene, no paint callback\" count))
                   (when (and max-ticks (>= count max-ticks)) (stop-monitor))) interval :owner frame))))
      (wxlambda:make-column panel)
      (wxlambda:add-child panel canvas :proportion 1 :expand t :border 10)
      (dolist (child (list indicator toggle feedback)) (wxlambda:add-child panel child :border 6))
      (redraw)
      (wxlambda:on-click toggle
        (lambda () (wxlambda:defer-ui-action
          (lambda () (if (and timer (wxlambda:ui-timer-active-p timer)) (stop-monitor) (begin))) :owner frame)))
      (begin))
    (values frame canvas indicator (lambda () timer) (lambda () count) toggle)))
(defun exercise (&key export-path)
  (multiple-value-bind (frame canvas indicator ticket count toggle) (build-window :interval 10 :max-ticks 3)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (loop repeat 300 while (wxlambda:ui-timer-active-p (funcall ticket)) do (wxlambda:process-events) (sleep 0.005))
           (assert (= 3 (funcall count))) (assert (not (wxlambda:activity-running-p indicator)))
           (setf (wxlambda:canvas-content canvas) (monitor-scene (funcall count) 640 300))
           (wxlambda:save-canvas-image canvas (or export-path (format nil \"/private/tmp/wxl-monitor-~A.png\" (lisp-implementation-type))) :width 640 :height 300)
           (wxlambda:queue-click toggle)
           (loop repeat 30 until (wxlambda:ui-timer-active-p (funcall ticket)) do (wxlambda:process-events))
           (assert (wxlambda:ui-timer-active-p (funcall ticket)))
           (assert (wxlambda:activity-running-p indicator)) t)
      (wxlambda:cancel-ui-timer (funcall ticket))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/event-bindings.lisp" :names ("examples/event-bindings.lisp" "event-bindings") :kind :example :kind-name "Example" :summary "Two independent ID-filtered command observers receive queued notifications on a standalone handler. A window button queues notifications; the exercise removes one observer without affecting the other and verifies cleanup." :sections (("Usage" (:p "Two independent ID-filtered command observers receive queued notifications on a standalone handler. A window button queues notifications; the exercise removes one observer without affecting the other and verifies cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-bindings.lisp --eval '(wxlambda-event-bindings:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-bindings:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-bindings
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-bindings)

(defun open-window ()
  (let* ((handler (wxlambda:make-event-handler))
         (frame (wxlambda:make-frame :title \"Independent event bindings\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label \"No queued notifications\"))
         (button (wxlambda:make-button panel :label \"Queue notification 42\"))
         (calls 0)
         (callback (lambda (event)
                     (assert (eq handler (wxlambda:event-source event)))
                     (incf calls)
                     (setf (wxlambda:label-text caption)
                           (format nil \"Observer calls: ~D; event ID: ~D\" calls (wxlambda:event-id event)))))
         (all (wxlambda:bind-event handler :click callback))
         (exact (wxlambda:bind-event handler :click callback :id 42)))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel caption)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button (lambda () (wxlambda:queue-event handler :click :id 42)))
    (wxlambda:show-window frame)
    (values frame handler button all exact (lambda () calls))))

(defun exercise ()
  (multiple-value-bind (frame handler button all exact calls) (open-window)
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (= 2 (funcall calls)))
    (assert (wxlambda:unbind-event exact))
    (assert (not (wxlambda:unbind-event exact)))
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (= 3 (funcall calls)))
    (wxlambda:unbind-event all)
    (wxlambda:off-click button)
    (wxlambda:destroy-event-handler handler)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-categories.lisp" :names ("examples/event-categories.lisp" "event-categories") :kind :example :kind-name "Example" :summary "Compare current/saved native category for a synthetic registered command and test USER_INPUT membership; no selective pumping or OS events." :sections (("Usage" (:p "Compare current/saved native category for a synthetic registered command and test USER_INPUT membership; no selective pumping or OS events.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-categories.lisp --eval '(wxlambda-event-categories:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-categories:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-categories (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-categories)
(defun exercise ()
  (wxlambda:register-event-type :category-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler)) (saved nil)
         (binding (wxlambda:bind-event receiver :category-message
                    (lambda (event context)
                      (setf saved event)
                      (assert (= (wxlambda:event-category event) (wxlambda:event-category context)))
                      (assert (logtest (wxlambda:event-category-mask :user-input) (wxlambda:event-category event))))
                    :with-context t)))
    (unwind-protect
         (progn (wxlambda:process-event receiver :category-message)
                (assert (= (wxlambda:event-category-mask :user-input) (wxlambda:event-category saved)))
                saved)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-contexts.lisp" :names ("examples/event-contexts.lisp" "event-contexts") :kind :example :kind-name "Example" :summary "A contextual button binding conditionally forwards commands to a parent observer. A checkbox controls Skip; the reusable exercise checks consumption, forwarding, native-type snapshots and expiration after callback return." :sections (("Usage" (:p "A contextual button binding conditionally forwards commands to a parent observer. A checkbox controls Skip; the reusable exercise checks consumption, forwarding, native-type snapshots and expiration after callback return.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-contexts.lisp --eval '(wxlambda-event-contexts:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-contexts:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-contexts
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-contexts)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Scoped event contexts\"))
         (panel (wxlambda:make-panel frame))
         (forward (wxlambda:make-checkbox panel :label \"Forward button commands\" :checked t))
         (button (wxlambda:make-button panel :label \"Dispatch a command\"))
         (caption (wxlambda:make-label panel :label \"No commands\"))
         (local 0) (parent 0) saved-context saved-event
         (display (lambda ()
                    (setf (wxlambda:label-text caption)
                          (format nil \"Local: ~D; parent: ~D\" local parent))))
         (child-binding
           (wxlambda:bind-event button :click
             (lambda (event context)
               (incf local)
               (setf saved-context context saved-event event)
               (assert (wxlambda:event-context-active-p context))
               (setf (wxlambda:event-skipped-p context) (wxlambda:checked-p forward))
               (funcall display))
             :with-context t))
         (parent-binding
           (wxlambda:bind-event frame :click
             (lambda (event) (declare (ignore event)) (incf parent) (funcall display)))))
    (wxlambda:make-column panel)
    (dolist (child (list forward button caption)) (wxlambda:add-child panel child))
    (wxlambda:show-window frame)
    (values frame forward button (list child-binding parent-binding)
            (lambda () (values local parent saved-event saved-context)))))

(defun exercise ()
  (multiple-value-bind (frame forward button bindings state) (open-window)
    (wxlambda:queue-click button)
    (wxlambda:process-pending-events)
    (multiple-value-bind (local parent event context) (funcall state)
      (assert (= 1 local parent))
      (assert (= (wxlambda:event-type :click) (wxlambda:event-native-type event)))
      (assert (not (wxlambda:event-context-active-p context))))
    (setf (wxlambda:checked-p forward) nil)
    (wxlambda:queue-click button)
    (wxlambda:process-pending-events)
    (multiple-value-bind (local parent) (funcall state)
      (assert (= 2 local)) (assert (= 1 parent)))
    (dolist (binding bindings) (wxlambda:unbind-event binding))
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-handlers.lisp" :names ("examples/event-handlers.lisp" "event-handlers") :kind :example :kind-name "Example" :summary "A standalone EVENT-HANDLER subclass reads native state in an AFTER hook. Separate window callbacks toggle event-handler processing without disabling window input. The exercise verifies queued callback gating and explicit owned-handler cleanup." :sections (("Usage" (:p "A standalone EVENT-HANDLER subclass reads native state in an AFTER hook. Separate window callbacks toggle event-handler processing without disabling window input. The exercise verifies queued callback gating and explicit owned-handler cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-handlers.lisp --eval '(wxlambda-event-handlers:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-handlers:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-handlers
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-handlers)

(defclass named-handler (wxlambda:event-handler)
  ((name :initarg :name :reader name)
   (initially-enabled :reader initially-enabled))
  (:default-initargs :name \"application-owned handler\"))
(defmethod initialize-instance :after ((handler named-handler) &key)
  (setf (slot-value handler 'initially-enabled) (wxlambda:handler-enabled-p handler)))

(defun open-window ()
  (let* ((handler (wxlambda:make-event-handler :class 'named-handler))
         (frame (wxlambda:make-frame :title \"Event handler ownership\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label (name handler)))
         (target (wxlambda:make-button panel :label \"Count events\"))
         (toggle (wxlambda:make-button panel :label \"Toggle target handler\"))
         (clicks 0))
    (wxlambda:make-column panel)
    (dolist (child (list caption target toggle)) (wxlambda:add-child panel child))
    (wxlambda:on-click target
      (lambda () (incf clicks) (setf (wxlambda:label-text caption) (format nil \"Events: ~D\" clicks))))
    (wxlambda:on-click toggle
      (lambda ()
        (setf (wxlambda:handler-enabled-p target) (not (wxlambda:handler-enabled-p target)))))
    (wxlambda:show-window frame)
    ;; HANDLER is an independently owned object, not a pushed window handler.
    (values frame handler target toggle (lambda () clicks))))

(defun exercise ()
  (multiple-value-bind (frame handler target toggle clicks) (open-window)
    (assert (initially-enabled handler))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (assert (not (wxlambda:handler-enabled-p target)))
    (assert (wxlambda:enabled-p target))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 2 (funcall clicks)))
    (wxlambda:off-click target)
    (wxlambda:off-click toggle)
    (wxlambda:destroy-event-handler handler)
    (assert (not (wxlambda:handler-alive-p handler)))
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/event-metadata.lisp" :names ("examples/event-metadata.lisp" "event-metadata") :kind :example :kind-name "Example" :summary "A synthetic close callback changes native CanVeto and timestamp metadata, applies checked veto and verifies the earlier snapshot remains unchanged. No real OS event is generated." :sections (("Usage" (:p "A synthetic close callback changes native CanVeto and timestamp metadata, applies checked veto and verifies the earlier snapshot remains unchanged. No real OS event is generated.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-metadata.lisp --eval '(wxlambda-event-metadata:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-metadata:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-metadata (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-metadata)
(defun exercise ()
  \"Inspect and alter a synthetic close event; snapshots remain unchanged.\"
  (let* ((receiver (wxlambda:make-event-handler))
         (captured nil)
         (binding (wxlambda:bind-event receiver :close
                    (lambda (event context)
                      (setf captured event)
                      (assert (not (wxlambda:event-command-p context)))
                      (assert (not (wxlambda:event-can-veto-p context)))
                      ;; This explicitly changes native metadata; it is not an OS guarantee.
                      (setf (wxlambda:event-can-veto-p context) t
                            (wxlambda:event-timestamp context) 123
                            (wxlambda:event-vetoed-p context) t)
                      (assert (= 123 (wxlambda:event-timestamp context)))) :with-context t)))
    (unwind-protect
         (progn
           (assert (equal '(t t) (multiple-value-list
                     (wxlambda:process-event receiver :close :can-veto-p nil))))
           (assert (not (wxlambda:event-can-veto-p captured)))
           (assert (zerop (wxlambda:event-timestamp captured))))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-origins.lisp" :names ("examples/event-origins.lisp" "event-origins") :kind :example :kind-name "Example" :summary "Compare child and parent native origin identities while binding receivers differ; check current/saved native type and release resources." :sections (("Usage" (:p "Compare child and parent native origin identities while binding receivers differ; check current/saved native type and release resources.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-origins.lisp --eval '(wxlambda-event-origins:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-origins:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-origins (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-origins)
(defun exercise ()
  (wxlambda:register-event-type :origin-message :family :command)
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel)) (child-origin nil) (parent-origin nil)
         (child-binding (wxlambda:bind-event child :origin-message
                          (lambda (e c)
                            (setf child-origin (wxlambda:event-origin-id e))
                            (assert (= (wxlambda:event-native-type e) (wxlambda:event-native-type c)))
                            (setf (wxlambda:event-skipped-p c) t)) :with-context t))
         (parent-binding (wxlambda:bind-event panel :origin-message
                           (lambda (e)
                             (assert (eq panel (wxlambda:event-source e)))
                             (setf parent-origin (wxlambda:event-origin-id e))))))
    (unwind-protect
         (progn (wxlambda:process-event child :origin-message)
                (assert (and child-origin (= child-origin parent-origin)))
                parent-origin)
      (wxlambda:unbind-event parent-binding)
      (wxlambda:unbind-event child-binding)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-routing.lisp" :names ("examples/event-routing.lisp" "event-routing") :kind :example :kind-name "Example" :summary "Rewrite a child command ID before parent delivery, verifying original and forwarded snapshot IDs and cleaning up bindings/windows." :sections (("Usage" (:p "Rewrite a child command ID before parent delivery, verifying original and forwarded snapshot IDs and cleaning up bindings/windows.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-routing.lisp --eval '(wxlambda-event-routing:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-routing:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-routing (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-routing)
(defun exercise ()
  \"Rewrite a command ID before parent delivery; the child's snapshot stays unchanged.\"
  (wxlambda:register-event-type :routed-command :family :command)
  (let* ((frame (wxlambda:make-frame))
         (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel))
         (before nil) (after nil)
         (parent-binding (wxlambda:bind-event panel :routed-command
                           (lambda (event) (setf after event)) :id 42))
         (child-binding (wxlambda:bind-event child :routed-command
                          (lambda (event context)
                            (setf before event)
                            (setf (wxlambda:event-id context) 42
                                  (wxlambda:event-skipped-p context) t)) :id 10 :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event child :routed-command :id 10)
           (assert (= 10 (wxlambda:event-id before)))
           (assert (= 42 (wxlambda:event-id after)))
           (assert (eq panel (wxlambda:event-source after))))
      (wxlambda:unbind-event child-binding)
      (wxlambda:unbind-event parent-binding)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/event-tags.lisp" :names ("examples/event-tags.lisp" "event-tags") :kind :example :kind-name "Example" :summary "Translate a registered command tag in a child callback, then verify payload-preserving parent delivery for synchronous and queued dispatch; clean up all resources." :sections (("Usage" (:p "Translate a registered command tag in a child callback, then verify payload-preserving parent delivery for synchronous and queued dispatch; clean up all resources.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-tags.lisp --eval '(wxlambda-event-tags:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-event-tags:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-event-tags (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-event-tags)
(defun exercise ()
  (wxlambda:register-event-type :raw-tag :family :command)
  (wxlambda:register-event-type :translated-tag :family :command)
  (let* ((frame (wxlambda:make-frame)) (panel (wxlambda:make-panel frame))
         (child (wxlambda:make-button panel)) (before nil) (after nil)
         (parent (wxlambda:bind-event panel :translated-tag (lambda (e) (setf after e))))
         (binding (wxlambda:bind-event child :raw-tag
                    (lambda (e c)
                      (setf before e)
                      (setf (wxlambda:event-native-type c) (wxlambda:event-type :translated-tag)
                            (wxlambda:event-skipped-p c) t)) :with-context t)))
    (unwind-protect
         (progn (wxlambda:process-event child :raw-tag :text \"copied payload\" :integer 42)
                (assert (eq :raw-tag (wxlambda:event-kind before)))
                (assert (eq :translated-tag (wxlambda:event-kind after)))
                (assert (= 42 (wxlambda:event-integer after)))
                (assert (string= \"copied payload\" (wxlambda:event-text after)))
                (setf after nil)
                (wxlambda:queue-event child :raw-tag :text \"copied payload\" :integer 42)
                (wxlambda:process-pending-events)
                (assert (eq :translated-tag (wxlambda:event-kind after))))
      (wxlambda:unbind-event binding) (wxlambda:unbind-event parent)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/focus-navigation.lisp" :names ("examples/focus-navigation.lisp" "focus-navigation") :kind :example :kind-name "Example" :summary "Keyboard form with a deferred Return to name action. EXERCISE issues focus/traversal requests without simulating physical keys or asserting OS focus identity." :sections (("Usage" (:p "Keyboard form with a deferred Return to name action. EXERCISE issues focus/traversal requests without simulating physical keys or asserting OS focus identity.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/focus-navigation.lisp --eval '(wxlambda-focus-navigation:start)'")) ("Source" (:code-block "lisp" ";;; Focus a form field after a command returns to the safe idle phase.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-focus-navigation (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-focus-navigation)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Keyboard form λ\" :width 420 :height 230))
         (panel (wxlambda:make-panel frame))
         (name (wxlambda:make-text panel :value \"Name λ\"))
         (address (wxlambda:make-text panel :value \"Address\"))
         (button (wxlambda:make-button panel :label \"Return to name\")))
    (wxlambda:make-column panel)
    (dolist (child (list name address button)) (wxlambda:add-child panel child :border 8))
    (wxlambda:on-click button
      (lambda () (wxlambda:defer-ui-action
                   (lambda () (wxlambda:focus-window name :from-keyboard t)) :owner name)))
    (values frame name address button)))
(defun exercise ()
  (multiple-value-bind (frame name address button) (build-window)
    (declare (ignore address))
    (unwind-protect
         (progn (wxlambda:show-window frame) (wxlambda:process-events)
                (assert (eq name (wxlambda:focus-window name)))
                (wxlambda:navigate-focus name)
                (wxlambda:navigate-focus name :forward nil)
                (wxlambda:queue-click button)
                (dotimes (i 8) (wxlambda:process-events)) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame name) (build-window)
      (wxlambda:show-window frame) (wxlambda:focus-window name) (wxlambda:run))))
"))))
(:entry "example/examples/form-app.lisp" :names ("examples/form-app.lisp" "form-app") :kind :example :kind-name "Example" :summary "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically." :sections (("Usage" (:p "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form-app.lisp --eval '(wxlambda-form:start)'")) ("Source" (:code-block "lisp" ";;; Reusable form application. FORM.LISP launches it; START-LIVE enables editing.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-form
  (:use #:cl)
  (:export #:start #:start-live #:open-window #:close-window #:unbind-handlers
           #:submit-form #:set-submit-action #:*name* #:*greeting* #:*style*
           #:*status* #:*submit* #:*reopen*))
(in-package #:wxlambda-form)

(defvar *frame* nil)
(defvar *root* nil)
(defvar *name* nil)
(defvar *greeting* nil)
(defvar *style* nil)
(defvar *status* nil)
(defvar *submit* nil)
(defvar *reopen* nil)
(defvar *name-value* \"Ada\")
(defvar *greeting-value* t)
(defvar *style-value* 0)

(defun remember-input ()
  ;; Cleanup can also run after only part of the form was constructed.
  (when (and *name* *greeting* *style*)
    (setf *name-value* (wxlambda:text *name*)
          *greeting-value* (wxlambda:checked-p *greeting*)
          *style-value* (wxlambda:selection *style*))))

(defun edited ()
  (remember-input)
  (setf (wxlambda:label-text *status*) \"Edited; submit to preview\")
  (wxlambda:layout-window *root*))

(defun submit-form ()
  (remember-input)
  (setf (wxlambda:label-text *status*) (format nil (cond ((not *greeting-value*) \"Name: ~A\")
                      ((eql *style-value* 1) \"Good day, ~A.\")
                      (t \"Hello, ~A!\"))
            *name-value*))
  (wxlambda:layout-window *root*))

(defun set-submit-action (&optional (action 'submit-form))
  \"Replace the current submit handler. Symbol actions pick up function redefinitions.\"
  (wxlambda:on-click *submit* (lambda () (funcall action))))

(defun unbind-handlers ()
  \"Release all registered closures before destroying this form.\"
  (loop for (control unbind) in
        (list (list *name* #'wxlambda:off-text-change)
              (list *greeting* #'wxlambda:off-toggle)
              (list *style* #'wxlambda:off-selection)
              (list *submit* #'wxlambda:off-click)
              (list *reopen* #'wxlambda:off-click))
        when control do
          ;; If the user already closed the native frame, stale handles cannot
          ;; be unbound. Those closures remain rooted until session cleanup.
          (handler-case (funcall unbind control)
            (wxlambda:native-error () nil))))

(defun close-window ()
  (when *frame*
    (handler-case (remember-input)
      (wxlambda:native-error () nil))
    (unbind-handlers)
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *root* nil *name* nil *greeting* nil *style* nil
          *status* nil *submit* nil *reopen* nil)))

(defun open-window ()
  \"Recreate the form within the current session, retaining its input values.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"A Lisp form\" :width 560 :height 400)
        *root* (wxlambda:make-panel *frame*))
  (let* ((name-row (wxlambda:make-panel *root*))
         (name-label (wxlambda:make-label name-row :label \"Name\"))
         (style-row (wxlambda:make-panel *root*))
         (style-label (wxlambda:make-label style-row :label \"Style\"))
         (actions (wxlambda:make-panel *root*)))
    (setf *name* (wxlambda:make-text name-row :value *name-value*)
          *greeting* (wxlambda:make-checkbox *root* :label \"Include a greeting\"
                                           :checked *greeting-value*)
          *style* (wxlambda:make-choice style-row :items '(\"Friendly\" \"Formal\")
                                      :selection *style-value*)
          *status* (wxlambda:make-label *root* :label \"Ready\")
          *submit* (wxlambda:make-button actions :label \"Submit\")
          *reopen* (wxlambda:make-button actions :label \"Reopen form\"))
    (wxlambda:make-column *frame*)
    (wxlambda:add-child *frame* *root* :border 0 :proportion 1)
    (wxlambda:make-column *root*)
    (wxlambda:make-row name-row)
    (wxlambda:add-child name-row name-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer name-row 12)
    (wxlambda:add-child name-row *name* :border 0 :proportion 1)
    (wxlambda:make-row style-row)
    (wxlambda:add-child style-row style-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer style-row 12)
    (wxlambda:add-child style-row *style* :border 0 :proportion 1)
    (wxlambda:make-row actions)
    (wxlambda:add-stretch actions)
    (wxlambda:add-child actions *reopen* :border 0 :expand nil)
    (wxlambda:add-spacer actions 12)
    (wxlambda:add-child actions *submit* :border 0 :expand nil)
    (dolist (child (list name-row *greeting* style-row *status*))
      (wxlambda:add-child *root* child :border 12))
    (wxlambda:add-stretch *root*)
    (wxlambda:add-child *root* actions :border 12)
    (wxlambda:on-text-change *name* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-toggle *greeting* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-selection *style* (lambda (event) (declare (ignore event)) (edited)))
    (set-submit-action)
    (wxlambda:on-click *reopen* (lambda () (open-window)))
    (wxlambda:show-window *frame*)))

(defun start ()
  \"Run normally until the last frame closes. Restart Lisp for another session.\"
  (wxlambda:with-application ()
    (unwind-protect (progn (open-window) (wxlambda:run))
      (close-window))))

(defun start-live (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter the terminal application REPL. STOP/EOF ends this one GUI session.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/form.lisp" :names ("examples/form.lisp" "form") :kind :example :kind-name "Example" :summary "Run the representative form with text, checkbox and choice updates. Close the frame to exit." :sections (("Usage" (:p "Run the representative form with text, checkbox and choice updates. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp")) ("Source" (:code-block "lisp" ";;; Ordinary startup: load this file to run the form until its window closes.
(load (merge-pathnames \"form-app.lisp\" *load-truename*))
(wxlambda-form:start)
"))))
(:entry "example/examples/frame-actions.lisp" :names ("examples/frame-actions.lisp" "frame-actions") :kind :example :kind-name "Example" :summary "Shared menu/toolbar actions, check-state synchronization, disabled activation and application-owned status fields. START interactive; EXERCISE runs in an active application session." :sections (("Usage" (:p "Shared menu/toolbar actions, check-state synchronization, disabled activation and application-owned status fields. START interactive; EXERCISE runs in an active application session.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/frame-actions.lisp --eval '(wxlambda-frame-actions:start)'")) ("Source" (:code-block "lisp" ";;; Shared menu/toolbar action IDs with application-owned status text.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-frame-actions (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-frame-actions)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Frame actions λ\" :width 640 :height 360))
         (bar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame :fields 2))
         (menus (wxlambda:make-menu-bar frame))
         (actions (wxlambda:make-menu menus :label \"&Actions\"))
         (new (wxlambda:make-menu-item actions :id 2101 :label \"&New\"))
         (details (wxlambda:make-menu-item actions :id 2102 :label \"&Details\" :kind :check))
         (content (wxlambda:make-panel frame))
         (label (wxlambda:make-label content :label \"Use New or Details in the toolbar or menu.\"))
         (count 0))
    (wxlambda:add-toolbar-tool bar 2101 \"New\" :art :new :help \"Create an in-memory entry\")
    (wxlambda:add-toolbar-separator bar)
    (wxlambda:add-toolbar-tool bar 2102 \"Details\" :art :information :kind :check)
    (wxlambda:realize-toolbar bar)
    (wxlambda:make-column content)
    (wxlambda:add-child content label :border 16)
    (setf (wxlambda:status-text status) \"Ready λ\" (wxlambda:status-text status 1) \"Details off\")
    (labels ((dispatch-action (event from-toolbar)
               (case (wxlambda:event-id event)
                 (2101 (incf count) (setf (wxlambda:status-text status) (format nil \"Created ~D\" count)))
                 (2102
                  (let ((checked (wxlambda:event-checked-p event)))
                    (setf (wxlambda:checked-p details) checked)
                    ;; Native tools toggle before dispatch. Menu actions must
                    ;; synchronize tool state; same-toolbar callback writes defer.
                    (unless from-toolbar (setf (wxlambda:tool-checked-p bar 2102) checked))
                    (setf (wxlambda:status-text status 1) (if checked \"Details on\" \"Details off\")))))))
      (wxlambda:bind-event bar :menu
        (lambda (event context) (declare (ignore context)) (dispatch-action event t))
        :id 2101 :last-id 2102 :with-context t) ; consume before frame propagation
      (wxlambda:bind-event frame :menu (lambda (event) (dispatch-action event nil))
        :id 2101 :last-id 2102))
    (values frame bar status new details)))

(defun exercise ()
  (multiple-value-bind (frame bar status new details) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (wxlambda:process-events)
           (assert (wxlambda:activate-toolbar-tool bar 2101))
           (assert (string= \"Created 1\" (wxlambda:status-text status)))
           (wxlambda:activate-menu-item new)
           (assert (string= \"Created 2\" (wxlambda:status-text status)))
           (wxlambda:activate-toolbar-tool bar 2102)
           (assert (wxlambda:checked-p details))
           (assert (string= \"Details on\" (wxlambda:status-text status 1)))
           (wxlambda:activate-menu-item details)
           (assert (not (wxlambda:tool-checked-p bar 2102)))
           (assert (string= \"Details off\" (wxlambda:status-text status 1)))
           (setf (wxlambda:tool-enabled-p bar 2101) nil)
           (assert (not (wxlambda:activate-toolbar-tool bar 2101)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/gauge.lisp" :names ("examples/gauge.lisp") :kind :example :kind-name "Example" :summary "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up." :sections (("Usage" (:p "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp --eval '(wxlambda-gauge:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-gauge:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-gauge
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-gauge)

(defclass progress (wxlambda:gauge)
  ((step :initarg :step :reader step-size)
   (completed :initform 0 :accessor completed))
  (:default-initargs :range 100 :step 25))

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Progress gauge\"))
         (panel (wxlambda:make-panel frame))
         (gauge (make-instance 'progress :parent panel))
         (advance (wxlambda:make-button panel :label \"Advance / restart\"))
         (pulse (wxlambda:make-button panel :label \"Indeterminate pulse\")))
    (wxlambda:make-column panel)
    (dolist (child (list gauge advance pulse)) (wxlambda:add-child panel child))
    (wxlambda:on-click advance
      (lambda ()
        ;; Pulse readings are animation state on some ports, not completed work.
        (setf (completed gauge)
              (if (>= (completed gauge) (wxlambda:gauge-range gauge))
                  0
                  (min (wxlambda:gauge-range gauge)
                       (+ (completed gauge) (step-size gauge)))))
        (setf (wxlambda:gauge-value gauge) (completed gauge))))
    (wxlambda:on-click pulse (lambda () (wxlambda:pulse-gauge gauge)))
    (wxlambda:show-window frame)
    (values frame gauge advance pulse)))

(defun exercise ()
  \"Run both interactive callbacks, restore determinate progress, and clean up.\"
  (multiple-value-bind (frame gauge advance pulse) (open-window)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 25 (wxlambda:gauge-value gauge)))
    (wxlambda:queue-click pulse)
    (wxlambda:process-events)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 50 (wxlambda:gauge-value gauge)))
    (dotimes (i 3)
      (wxlambda:queue-click advance)
      (wxlambda:process-events))
    (assert (zerop (wxlambda:gauge-value gauge)))
    (wxlambda:off-click advance)
    (wxlambda:off-click pulse)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/grid-editing.lisp" :names ("examples/grid-editing.lisp" "grid-editing") :kind :example :kind-name "Example" :summary "Owned native grid editor validation/veto, honest Reset/Save/Hide/Disable distinctions, read-only cell attributes and deferred row changes." :sections (("Usage" (:p "Owned native grid editor validation/veto, honest Reset/Save/Hide/Disable distinctions, read-only cell attributes and deferred row changes.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/grid-editing.lisp --eval \"(wxlambda-grid-editing:start)\"")) ("Source" (:code-block "lisp" "(require :asdf)
(asdf:load-asd (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-grid-editing (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-grid-editing)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Native grid validation\" :width 650 :height 400))
         (panel (wxlambda:make-panel frame))
         (grid (wxlambda:make-grid panel :rows 4 :columns 3))
         (add (wxlambda:make-button panel :label \"Append row\"))
         (remove (wxlambda:make-button panel :label \"Delete last row\"))
         (reset (wxlambda:make-button panel :label \"Reset active editor, then disable\"))
         (status (wxlambda:make-status-bar frame)))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel grid :proportion 1 :expand t :border 8)
    (dolist (button (list add remove reset)) (wxlambda:add-child panel button :expand t :border 4))
    (setf (wxlambda:grid-column-label grid 0) \"Required name\"
          (wxlambda:grid-column-label grid 1) \"Notes\"
          (wxlambda:grid-column-label grid 2) \"Read only\"
          (wxlambda:grid-cell-text grid 0 0) \"Edit this λ\"
          (wxlambda:grid-cell-text grid 0 2) \"Protected\"
          (wxlambda:grid-cell-read-only-p grid 0 2) t
          (wxlambda:grid-cell-background grid 0 2) #xeeeeee)
    (wxlambda:bind-event grid :grid-cell-changing
      (lambda (event context)
        (when (and (zerop (wxlambda:event-grid-column event))
                   (zerop (length (wxlambda:event-text event))))
          (setf (wxlambda:event-vetoed-p context) t
                (wxlambda:status-text status) \"Name cannot be empty.\"))
        (setf (wxlambda:event-skipped-p context) t)) :with-context t)
    (wxlambda:bind-event grid :grid-cell-changed
      (lambda (event)
        (setf (wxlambda:status-text status)
          (format nil \"(~D,~D): ~S → ~S\" (wxlambda:event-grid-row event)
            (wxlambda:event-grid-column event) (wxlambda:event-text event)
            (wxlambda:event-grid-cell-value event)))))
    (wxlambda:on-click add
      (lambda () (wxlambda:defer-ui-action
        (lambda () (unless (wxlambda:grid-editing-p grid) (wxlambda:append-grid-rows grid))) :owner grid)))
    (wxlambda:on-click remove
      (lambda () (wxlambda:defer-ui-action
        (lambda () (when (and (not (wxlambda:grid-editing-p grid)) (plusp (wxlambda:grid-rows grid)))
                     (wxlambda:delete-grid-rows grid (1- (wxlambda:grid-rows grid))))) :owner grid)))
    (wxlambda:on-click reset
      (lambda () (wxlambda:defer-ui-action
        (lambda () (when (wxlambda:grid-editing-p grid)
                     (wxlambda:reset-grid-cell-editor grid)
                     (wxlambda:disable-grid-cell-edit-control grid))) :owner grid)))
    (setf (wxlambda:status-text status) \"Double-click to edit. Reset restores the native editor baseline.\")
    (values frame grid add remove)))
(defun exercise ()
  (multiple-value-bind (frame grid add remove) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:layout-window frame)
           (wxlambda:queue-click add)
           (loop repeat 30 until (= 5 (wxlambda:grid-rows grid)) do (wxlambda:process-events))
           (assert (= 5 (wxlambda:grid-rows grid)))
           (wxlambda:queue-click remove)
           (loop repeat 30 until (= 4 (wxlambda:grid-rows grid)) do (wxlambda:process-events))
           (assert (= 4 (wxlambda:grid-rows grid)))
           (assert (wxlambda:grid-cell-read-only-p grid 0 2)) t)
      (wxlambda:destroy-window frame))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/grid.lisp" :names ("examples/grid.lisp") :kind :example :kind-name "Example" :summary "Fixed-shape inventory string grid with native editing, copied Unicode cells/labels and deferred committed-value readback; EXERCISE validates automated model behavior." :sections (("Usage" (:p "Fixed-shape inventory string grid with native editing, copied Unicode cells/labels and deferred committed-value readback; EXERCISE validates automated model behavior.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/grid.lisp --eval '(wxlambda-grid:start)'")) ("Source" (:code-block "lisp" ";;; Fixed-shape editable string table; no spreadsheet evaluation or custom table.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-grid (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-grid)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Inventory grid λ\" :width 700 :height 430))
         (panel (wxlambda:make-panel frame))
         (grid (wxlambda:make-grid panel :rows 6 :columns 3))
         (feedback (wxlambda:make-label panel :label \"Edit a cell, then finish the edit before reading.\"))
         (read (wxlambda:make-button panel :label \"Read first item\")))
    (loop for name in '(\"Item\" \"Quantity\" \"Notes\") for column from 0
          do (setf (wxlambda:grid-column-label grid column) name))
    (loop for row below 6
          for item in '(\"Keyboard\" \"Display\" \"Cable λ\" \"Mouse\" \"Adapter\" \"Headset\")
          do (setf (wxlambda:grid-cell-text grid row 0) item
                   (wxlambda:grid-cell-text grid row 1) (write-to-string (1+ row))))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel grid :proportion 1 :expand t :border 8)
    (wxlambda:add-child panel feedback :border 8)
    (wxlambda:add-child panel read :border 8)
    (wxlambda:on-click read
      (lambda ()
        (wxlambda:defer-ui-action
          (lambda ()
            (setf (wxlambda:label-text feedback)
                  (format nil \"Committed first item: ~A~A\" (wxlambda:grid-cell-text grid 0 0)
                          (if (wxlambda:grid-editing-p grid) \" (edit still active)\" \"\"))))
          :owner grid)))
    (values frame grid feedback read)))
(defun exercise ()
  (multiple-value-bind (frame grid feedback read) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (= 6 (wxlambda:grid-rows grid)))
           (assert (string= \"Cable λ\" (wxlambda:grid-cell-text grid 2 0)))
           (setf (wxlambda:grid-cell-text grid 0 0) \"Updated λ\")
           (wxlambda:queue-click read)
           (loop repeat 30 until (search \"Updated λ\" (wxlambda:label-text feedback)) do (wxlambda:process-events))
           (assert (search \"Updated λ\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/handler-chains.lisp" :names ("examples/handler-chains.lisp" "handler-chains") :kind :example :kind-name "Example" :summary "Build reciprocal standalone handler links, observe native chain delivery and detach/splice handlers without changing native ownership." :sections (("Usage" (:p "Build reciprocal standalone handler links, observe native chain delivery and detach/splice handlers without changing native ownership.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-chains.lisp --eval '(wxlambda-handler-chains:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-handler-chains:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-handler-chains (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-handler-chains)
(defun exercise ()
  (wxlambda:register-event-type :chain-message :family :command)
  (let* ((head (wxlambda:make-event-handler)) (tail (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :chain-message :text \"Through a chain\"))
         (received nil)
         (binding (wxlambda:bind-event tail :chain-message
                    (lambda (event)
                      (assert (eq tail (wxlambda:event-source event)))
                      (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (setf (wxlambda:next-handler head) tail)
           (assert (eq head (wxlambda:previous-handler tail)))
           (wxlambda:process-event-locally head source)
           (assert (equal '(\"Through a chain\") received))
           (wxlambda:unlink-event-handler tail)
           (assert (wxlambda:handler-unlinked-p head)))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event source)
      (wxlambda:destroy-event-handler tail)
      (wxlambda:destroy-event-handler head))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/handler-client-data.lisp" :names ("examples/handler-client-data.lisp" "handler-client-data") :kind :example :kind-name "Example" :summary "Attach EQ-preserved Lisp state to a managed handler, read it through callback receiver identity and clear it before cleanup without exposing Lisp/native pointers." :sections (("Usage" (:p "Attach EQ-preserved Lisp state to a managed handler, read it through callback receiver identity and clear it before cleanup without exposing Lisp/native pointers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-client-data.lisp --eval '(wxlambda-handler-client-data:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-handler-client-data:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-handler-client-data (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-handler-client-data)

(defun exercise ()
  (let* ((handler (wxlambda:make-event-handler))
         (state (list :clicks 0))
         (binding nil))
    (unwind-protect
         (progn
           (setf (wxlambda:event-handler-client-data handler) state)
           (setf binding
                 (wxlambda:bind-event handler :click
                   (lambda (event)
                     (let ((data (wxlambda:event-handler-client-data
                                  (wxlambda:event-source event))))
                       (incf (getf data :clicks))))))
           (wxlambda:process-event handler :click)
           (assert (eq state (wxlambda:event-handler-client-data handler)))
           (assert (= 1 (getf state :clicks)))
           (setf (wxlambda:event-handler-client-data handler) nil)
           (assert (null (wxlambda:event-handler-client-data handler)))
           t)
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-event-handler handler))))

(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/hello.lisp" :names ("examples/hello.lisp" "hello") :kind :example :kind-name "Example" :summary "Editable Unicode text and button callbacks using the WX package nickname, with copied event payloads. Close the frame to exit." :sections (("Usage" (:p "Editable Unicode text and button callbacks using the WX package nickname, with copied event payloads. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wx:with-application ()
  (let* ((frame (wx:make-frame :title \"Hello from Common Lisp\"))
         (panel (wx:make-panel frame))
         (text (wx:make-text panel :value \"Hello, wxWidgets — λ\"))
         (button (wx:make-button panel :label \"Click me\"))
         (clicks 0))
    (wx:make-column panel)
    (wx:add-child panel text)
    (wx:add-child panel button)
    (wx:on-text-change text
      (lambda (event)
        (format t \"Text edited: ~A~%\" (wx:event-text event))))
    (wx:on-click button
      (lambda (event)
        (assert (eq button (wx:event-source event)))
        (format t \"Text before click: ~A~%\" (wx:text text))
        (setf (wx:text text :notify t) (format nil \"Clicked ~D times\" (incf clicks))))
      :with-event t)
    (wx:show-window frame)
    (wx:run)))
"))))
(:entry "example/examples/idle-events.lisp" :names ("examples/idle-events.lisp" "idle-events") :kind :example :kind-name "Example" :summary "Process a finite work list through native application idle callbacks, bound RequestMore, restore idle policy and dispose the window without inline wake pumping." :sections (("Usage" (:p "Process a finite work list through native application idle callbacks, bound RequestMore, restore idle policy and dispose the window without inline wake pumping.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/idle-events.lisp --eval '(wxlambda-idle-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-idle-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-idle-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-idle-events)

(defun exercise ()
  (let* ((previous-mode (wxlambda:idle-mode))
         (window (wxlambda:make-frame :title \"Bounded idle work\"))
         (remaining (list :first :second))
         (completed 0) (binding nil))
    (unwind-protect
         (progn
           (setf (wxlambda:idle-mode) :specified
                 (wxlambda:window-process-idle-p window) t)
           (setf binding
                 (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                   (lambda (snapshot context)
                     (declare (ignore snapshot))
                     ;; Do one small chunk, then yield control to the GUI.
                     (when remaining (pop remaining) (incf completed))
                     (setf (wxlambda:event-more-requested-p context)
                           (not (null remaining))))
                   :with-context t))
           (wxlambda:wake-up-idle)
           (loop repeat 4 while remaining do (wxlambda:process-events))
           (assert (= 2 completed))
           t)
      (when binding (wxlambda:unbind-event binding))
      (setf (wxlambda:idle-mode) previous-mode)
      (wxlambda:destroy-window window)
      (wxlambda:process-events))))

(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/image-viewer.lisp" :names ("examples/image-viewer.lisp" "image-viewer") :kind :example :kind-name "Example" :summary "Compose native PNG/RGB/alpha/scaling/bitmap/static display and mouse events; pixel inspection behavior is application code." :sections (("Usage" (:p "Compose native PNG/RGB/alpha/scaling/bitmap/static display and mouse events; pixel inspection behavior is application code.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/image-viewer.lisp --eval \"(wxlambda-image-viewer:start)\"")) ("Source" (:code-block "lisp" "(require :asdf)
(asdf:load-asd (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-image-viewer (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-image-viewer)
(defun build-window ()
  ;; This pixel-inspection behavior is application code; wxLambda exposes resources.
  (let* ((rgb (make-array (* 32 32 3) :element-type '(unsigned-byte 8)))
         (alpha (make-array (* 32 32) :element-type '(unsigned-byte 8)))
         (frame (wxlambda:make-frame :title \"Native image resources\" :width 420 :height 390))
         (panel (wxlambda:make-panel frame))
         (status (wxlambda:make-status-bar frame)))
    (dotimes (y 32)
      (dotimes (x 32)
        (let ((pixel (+ x (* y 32))))
          (setf (aref rgb (* pixel 3)) (* x 8)
                (aref rgb (+ 1 (* pixel 3))) (* y 8)
                (aref rgb (+ 2 (* pixel 3))) 180
                (aref alpha pixel) (if (< x 8) 64 255)))))
    (let* ((source (wxlambda:make-image :width 32 :height 32 :rgb rgb :alpha alpha))
           (scaled (wxlambda:scale-image source 256 256 :quality :nearest))
           (bitmap (wxlambda:make-bitmap :image scaled))
           (view (wxlambda:make-static-bitmap panel bitmap)))
      (wxlambda:make-column panel) (wxlambda:add-child panel view :border 16)
      (wxlambda:bind-event view :mouse-motion
        (lambda (event)
          (destructuring-bind (x y) (wxlambda:event-position event)
            (when (and (<= 0 x 255) (<= 0 y 255))
              (setf (wxlambda:status-text status)
                (format nil \"Pixel (~D,~D): ~S\" x y (wxlambda:image-pixel scaled x y)))))))
      (values frame source scaled bitmap view))))
(defun release (frame source scaled bitmap)
  (wxlambda:destroy-window frame)
  (wxlambda:destroy-bitmap bitmap) (wxlambda:destroy-image scaled) (wxlambda:destroy-image source))
(defun exercise ()
  (multiple-value-bind (frame source scaled bitmap view) (build-window)
    (unwind-protect
         (progn
           (assert (equal '(32 32) (wxlambda:image-size source)))
           (assert (equal '(256 256) (wxlambda:bitmap-size bitmap)))
           (assert (equal '(0 0 180 64) (wxlambda:image-pixel scaled 0 0)))
           (wxlambda:show-window frame) (wxlambda:process-events)
           (let ((copy (wxlambda:bitmap-value view)))
             (unwind-protect
                  (assert (equal '(256 256) (wxlambda:bitmap-logical-size copy)))
               (wxlambda:destroy-bitmap copy))) t)
      (release frame source scaled bitmap))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame source scaled bitmap) (build-window)
      (declare (ignore source scaled bitmap))
      (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/input-events.lisp" :names ("examples/input-events.lisp" "input-events") :kind :example :kind-name "Example" :summary "Native input observer shows key/character/pointer/focus metadata while preserving native text editing through automatic Skip. EXERCISE observes native size delivery; deterministic native fixtures cover payloads/consumption, not physical input or IME." :sections (("Usage" (:p "Native input observer shows key/character/pointer/focus metadata while preserving native text editing through automatic Skip. EXERCISE observes native size delivery; deterministic native fixtures cover payloads/consumption, not physical input or IME.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/input-events.lisp --eval '(wxlambda-input-events:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(asdf:load-asd (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-input-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-input-events)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Input observer — native editing preserved\" :width 620 :height 360))
         (panel (wxlambda:make-panel frame))
         (input (wxlambda:make-text panel :multiline t :value \"Type, select text and scroll here. λ 😀\"))
         (status (wxlambda:make-status-bar frame)) (seen nil))
    (wxlambda:make-column panel) (wxlambda:add-child panel input :proportion 1 :expand t :border 12)
    (dolist (kind '(:key-down :key-up :char :char-hook :mouse-motion :mouse-wheel
                    :left-down :left-up :context-menu :focus-gained :focus-lost))
      (wxlambda:bind-event input kind
        (lambda (event)
          (push event seen)
          (when (> (length seen) 64) (setf seen (subseq seen 0 64)))
          (setf (wxlambda:status-text status)
            (case (wxlambda:event-kind event)
              ((:key-down :key-up :char :char-hook)
               (format nil \"~A key=~D unicode=~S modifiers=~D command=~S raw-control=~S\"
                 (wxlambda:event-kind event) (wxlambda:event-key-code event)
                 (wxlambda:event-unicode-key event) (wxlambda:event-modifiers event)
                 (wxlambda:event-cmd-down-p event) (wxlambda:event-raw-control-down-p event)))
              ((:focus-gained :focus-lost) (format nil \"~A\" (wxlambda:event-kind event)))
              (otherwise (format nil \"~A ~S\" (wxlambda:event-kind event) (wxlambda:event-position event))))))))
    (wxlambda:bind-event frame :size
      (lambda (event)
        (push event seen)
        (when (> (length seen) 64) (setf seen (subseq seen 0 64)))))
    (values frame input (lambda () seen))))
(defun exercise ()
  (multiple-value-bind (frame input seen) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (wxlambda:layout-window frame)
           (loop repeat 8 do (wxlambda:process-events))
           (let ((sizes (remove-if-not (lambda (event) (eq :size (wxlambda:event-kind event))) (funcall seen))))
             (assert sizes)
             (dolist (event sizes)
               (assert (eq :base (wxlambda:event-family event)))
               (assert (= 2 (length (wxlambda:event-size event))))))
           (assert (search \"λ\" (wxlambda:text input))) t)
      (wxlambda:destroy-window frame))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame input) (build-window)
      (declare (ignore input)) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/keyboard-actions.lisp" :names ("examples/keyboard-actions.lisp" "keyboard-actions") :kind :example :kind-name "Example" :summary "Shared model actions reached by menu, toolbar and frame accelerator IDs; enable/check policy ignores platform-specific native metadata. EXERCISE uses synthetic action commands, separate native tests verify actual key translation." :sections (("Usage" (:p "Shared model actions reached by menu, toolbar and frame accelerator IDs; enable/check policy ignores platform-specific native metadata. EXERCISE uses synthetic action commands, separate native tests verify actual key translation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/keyboard-actions.lisp --eval '(wxlambda-keyboard-actions:start)'")) ("Source" (:code-block "lisp" ";;; Shared model actions, independent of native menu/tool/key checked metadata.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-keyboard-actions (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-keyboard-actions)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Keyboard actions λ\" :width 640 :height 360
                                  :accelerators '((#\\n 3101 :ctrl) (#\\d 3102 :ctrl) (:f1 3103))))
         (toolbar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame :fields 2))
         (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label \"&Actions\"))
         (new (wxlambda:make-menu-item menu :id 3101 :label \"&New\"))
         (details (wxlambda:make-menu-item menu :id 3102 :label \"&Details\" :kind :check))
         (panel (wxlambda:make-panel frame))
         (label (wxlambda:make-label panel :label \"Ctrl/Command+N: New; Ctrl/Command+D: Details; F1: Help\"))
         (count 0) (details-p nil) (new-enabled t))
    (wxlambda:add-toolbar-tool toolbar 3101 \"New\" :art :new)
    (wxlambda:add-toolbar-tool toolbar 3102 \"Details\" :kind :check)
    (wxlambda:realize-toolbar toolbar)
    (wxlambda:make-column panel) (wxlambda:add-child panel label :border 12)
    (setf (wxlambda:status-text status) \"Ready λ\" (wxlambda:status-text status 1) \"Details off\")
    (labels ((action (event from-toolbar)
               ;; Accelerator metadata/menu state vary by port. The model owns
               ;; state; both native pre-toggles and direct key commands converge.
               (case (wxlambda:event-id event)
                 (3101 (when new-enabled (incf count) (setf (wxlambda:status-text status) (format nil \"Created ~D\" count))))
                 (3102 (setf details-p (not details-p) (wxlambda:checked-p details) details-p)
                       (unless from-toolbar (setf (wxlambda:tool-checked-p toolbar 3102) details-p))
                       (setf (wxlambda:status-text status 1) (if details-p \"Details on\" \"Details off\")))
                 (3103 (setf (wxlambda:status-text status) \"Ctrl means Command on macOS\")))))
      (wxlambda:bind-event toolbar :menu
        (lambda (event context) (declare (ignore context)) (action event t))
        :id 3101 :last-id 3103 :with-context t)
      (wxlambda:bind-event frame :menu
        (lambda (event context) (declare (ignore context)) (action event nil))
        :id 3101 :last-id 3103 :with-context t)) ; consume: avoid native button fallback
    (values frame toolbar status new details
            (lambda (value)
              (setf new-enabled value (wxlambda:enabled-p new) value
                    (wxlambda:tool-enabled-p toolbar 3101) value)))))
(defun exercise ()
  (multiple-value-bind (frame toolbar status new details enable-new) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (wxlambda:activate-menu-item new)
           (wxlambda:activate-toolbar-tool toolbar 3101)
           ;; Synthetic command verifies shared Lisp action logic, not a keypress.
           (wxlambda:process-event frame :menu :id 3101)
           (assert (string= \"Created 3\" (wxlambda:status-text status)))
           (wxlambda:process-event frame :menu :id 3102)
           (assert (wxlambda:checked-p details))
           (assert (wxlambda:tool-checked-p toolbar 3102))
           (wxlambda:activate-menu-item details)
           (assert (not (wxlambda:tool-checked-p toolbar 3102)))
           (wxlambda:activate-toolbar-tool toolbar 3102)
           (assert (wxlambda:checked-p details))
           (funcall enable-new nil)
           (wxlambda:process-event frame :menu :id 3101)
           (assert (not (wxlambda:activate-toolbar-tool toolbar 3101)))
           (assert (string= \"Created 3\" (wxlambda:status-text status)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/layout.lisp" :names ("examples/layout.lisp" "layout") :kind :example :kind-name "Example" :summary "Nested panel rows and columns with spacing and alignment. Close the frame to exit." :sections (("Usage" (:p "Nested panel rows and columns with spacing and alignment. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Rows, columns, and spacing\" :width 640 :height 360))
         (root (wxlambda:make-panel frame))
         (input-row (wxlambda:make-panel root))
         (footer (wxlambda:make-panel root))
         (input (wxlambda:make-text input-row :value \"Edit this text\"))
         (apply-button (wxlambda:make-button input-row :label \"Apply\"))
         (output (wxlambda:make-text root :value \"Click Apply to copy the input here\"))
         (close-button (wxlambda:make-button footer :label \"Close\")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame root :border 0 :proportion 1)
    (wxlambda:make-column root)
    (wxlambda:make-row input-row)
    (wxlambda:add-child input-row input :border 0 :proportion 1)
    (wxlambda:add-spacer input-row 12)
    (wxlambda:add-child input-row apply-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root input-row :border 12)
    (wxlambda:add-child root output :border 12)
    (wxlambda:add-stretch root)
    (wxlambda:make-row footer)
    (wxlambda:add-stretch footer)
    (wxlambda:add-child footer close-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root footer :border 12)
    (wxlambda:on-click apply-button
      (lambda () (setf (wxlambda:text output) (wxlambda:text input))))
    (wxlambda:on-click close-button (lambda () (wxlambda:destroy-window frame)))
    (wxlambda:show-window frame)
    (wxlambda:run)))
"))))
(:entry "example/examples/list-manager.lisp" :names ("examples/list-manager.lisp" "list-manager") :kind :example :kind-name "Example" :summary "Unsorted single-selection list manager with Append/Rename/Delete/Clear actions, native selection and activation feedback. Bounded EXERCISE tests silent item edits and selected-index adjustment without physical input." :sections (("Usage" (:p "Unsorted single-selection list manager with Append/Rename/Delete/Clear actions, native selection and activation feedback. Bounded EXERCISE tests silent item edits and selected-index adjustment without physical input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/list-manager.lisp --eval '(wxlambda:with-application () (wxlambda-list-manager:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE uses an existing application session.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-list-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-list-manager)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Single-selection list manager\" :width 580 :height 460))
         (panel (wxlambda:make-panel frame))
         (items (wxlambda:make-list-box panel :items '(\"Ada\" \"Grace λ\" \"日本語 😀\")))
         (entry (wxlambda:make-text panel :value \"New item\"))
         (add (wxlambda:make-button panel :label \"Append\"))
         (rename (wxlambda:make-button panel :label \"Rename selected\"))
         (remove (wxlambda:make-button panel :label \"Delete selected\"))
         (clear (wxlambda:make-button panel :label \"Clear all\"))
         (status (wxlambda:make-label panel :label \"Select one item\")))
    (labels ((refresh ()
               (setf (wxlambda:label-text status)
                     (format nil \"~D items; selection ~S\" (wxlambda:item-count items) (wxlambda:selection items)))))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame panel :proportion 1 :border 0)
      (wxlambda:make-column panel)
      (wxlambda:add-child panel items :proportion 1)
      (dolist (child (list entry add rename remove clear status)) (wxlambda:add-child panel child))
      (wxlambda:on-selection items
        (lambda (event)
          (when (wxlambda:event-selection event)
            (setf (wxlambda:text entry) (wxlambda:event-text event)))
          (refresh)))
      (wxlambda:bind-event items :listbox-double-click
        (lambda (event)
          (setf (wxlambda:label-text status) (format nil \"Activated ~S\" (wxlambda:event-text event)))))
      (wxlambda:on-click add
        (lambda ()
          (setf (wxlambda:selection items :notify t)
                (wxlambda:append-item items (wxlambda:text entry)))))
      (wxlambda:on-click rename
        (lambda ()
          (let ((index (wxlambda:selection items)))
            (when index (setf (wxlambda:item-text items index) (wxlambda:text entry))))
          (refresh)))
      (wxlambda:on-click remove
        (lambda ()
          (let ((index (wxlambda:selection items))) (when index (wxlambda:delete-item items index)))
          (refresh)))
      (wxlambda:on-click clear (lambda () (wxlambda:clear-items items) (refresh)))
      (values frame items entry (list add rename remove clear)))))

(defun exercise ()
  (multiple-value-bind (frame items entry buttons) (build-window)
    (declare (ignore buttons))
    (unwind-protect
         (progn
           (assert (null (wxlambda:selection items)))
           (setf (wxlambda:selection items :notify t) 1)
           (assert (string= \"Grace λ\" (wxlambda:text entry)))
           (assert (= 3 (wxlambda:append-item items \"Another λ\")))
           (wxlambda:delete-item items 0)
           (assert (= 0 (wxlambda:selection items)))
           (assert (string= \"Grace λ\" (wxlambda:item-text items 0)))
           (wxlambda:delete-item items 0)
           (assert (null (wxlambda:selection items)))
           (wxlambda:clear-items items)
           (assert (zerop (wxlambda:item-count items)))
           t)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame items) (build-window)
      (declare (ignore items))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
"))))
(:entry "example/examples/live.lisp" :names ("examples/live.lisp" "live") :kind :example :kind-name "Example" :summary "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit." :sections (("Usage" (:p "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/live.lisp --eval '(wxlambda-live:start)'")) ("Source" (:code-block "lisp" ";;; Load this file, then call (wxlambda-live:start) from a terminal REPL.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-live
  (:use #:cl)
  (:export #:start #:open-window #:close-window #:clicked #:*text* #:*button*))
(in-package #:wxlambda-live)

(defvar *frame* nil)
(defvar *text* nil)
(defvar *button* nil)
(defvar *clicks* 0)

(defun clicked ()
  (setf (wxlambda:text *text*) (format nil \"Clicked ~D times\" (incf *clicks*))))

(defun close-window ()
  \"Release registered closures before destroying the controls they reference.\"
  (when *frame*
    ;; A user may already have closed the native window. Its stale handles
    ;; cannot be unbound; session cleanup releases those retained closures.
    (handler-case (wxlambda:off-click *button*)
      (wxlambda:native-error () nil))
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *text* nil *button* nil)))

(defun open-window ()
  \"Replace the current window within the active session.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"Live Lisp development\")
        *text* (wxlambda:make-text *frame* :value \"Redefine WXLAMBDA-LIVE:CLICKED\")
        *button* (wxlambda:make-button *frame* :label \"Run current CLICKED\"))
  (wxlambda:make-column *frame*)
  (wxlambda:add-child *frame* *text*)
  (wxlambda:add-child *frame* *button*)
  ;; Resolve the function on each click so DEFUN changes take effect live.
  (wxlambda:on-click *button* (lambda () (clicked)))
  (wxlambda:show-window *frame*))

(defun start (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter one GUI session. Use WXLAMBDA:STOP or EOF; restart Lisp for another.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/menus.lisp" :names ("examples/menus.lisp" "menus") :kind :example :kind-name "Example" :summary "Frame-owned menu bar, normal/check/separator items, ID-routed menu callbacks, mutable resource state and hierarchical invalidation. Programmatic exercise; graphical OS menu selection is separate verification." :sections (("Usage" (:p "Frame-owned menu bar, normal/check/separator items, ID-routed menu callbacks, mutable resource state and hierarchical invalidation. Programmatic exercise; graphical OS menu selection is separate verification.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/menus.lisp --eval '(wxlambda-menus:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-menus:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-menus (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-menus)

(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title \"Menu actions\"))
         (bar (wxlambda:make-menu-bar frame))
         (file (wxlambda:make-menu bar :label \"&File\"))
         (save (wxlambda:make-menu-item file :id 1001 :label (format nil \"&Save~CCtrl+S\" #\\Tab)
                                            :help \"Save the current document\"))
         (separator (wxlambda:make-menu-item file :kind :separator))
         (autosave (wxlambda:make-menu-item file :id 1002 :kind :check :label \"&Autosave\"))
         (state (list :saves 0 :autosave nil)) (binding nil))
    (declare (ignore separator))
    (unwind-protect
         (progn
           (setf binding
                 (wxlambda:bind-event frame :menu
                   (lambda (event context)
                     (declare (ignore context))
                     (let ((data (wxlambda:event-user-data event)))
                       (case (wxlambda:event-id event)
                         (1001 (incf (getf data :saves)))
                         (1002 (setf (getf data :autosave) (wxlambda:checked-p autosave))))))
                   :id 1001 :last-id 1002 :with-context t :user-data state))
           (assert (wxlambda:activate-menu-item save))
           (assert (wxlambda:activate-menu-item autosave))
           (assert (= 1 (getf state :saves)))
           (assert (getf state :autosave))
           (setf (wxlambda:enabled-p save) nil)
           (assert (not (wxlambda:activate-menu-item save)))
           (assert (= 3 (wxlambda:menu-item-count file)))
           t)
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/message-file-dialogs.lisp" :names ("examples/message-file-dialogs.lisp" "message-file-dialogs") :kind :example :kind-name "Example" :summary "Interactive START asks whether to choose a file and prints accepted selection without reading content. Active-session EXERCISE checks message buttons/file mode and cancels actual generic message/file loops from native idle, including a message without visible Cancel. Native OS alerts/panels remain unbound." :sections (("Usage" (:p "Interactive START asks whether to choose a file and prints accepted selection without reading content. Active-session EXERCISE checks message buttons/file mode and cancels actual generic message/file loops from native idle, including a message without visible Cancel. Native OS alerts/panels remain unbound.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/message-file-dialogs.lisp --eval '(wxlambda:with-application () (wxlambda-message-file-dialogs:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE runs bounded automatic cancellation in a session.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-message-file-dialogs (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-message-file-dialogs)

(defun start ()
  (wxlambda:with-application ()
    (let ((question (wxlambda:make-message-dialog :title \"Open a document\"
                      :message \"Choose a file to open?\" :buttons :yes-no-cancel :icon :question)))
      (unwind-protect
           (when (eq :yes (wxlambda:show-modal question))
             (let ((picker (wxlambda:make-file-dialog :mode :open :title \"Open a document\")))
               (unwind-protect
                    (when (eq :ok (wxlambda:show-modal picker))
                      (format t \"Selected: ~A~%\" (wxlambda:file-dialog-path picker)))
                 (wxlambda:destroy-window picker))))
        (wxlambda:destroy-window question)
        (wxlambda:process-events)))))

(defun cancel-in-idle (dialog)
  (let ((binding nil) (cancelled nil))
    (unwind-protect
         (progn
           (setf binding
                 (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                   (lambda (event)
                     (declare (ignore event))
                     (when (and (not cancelled) (wxlambda:dialog-modal-p dialog))
                       (setf cancelled t)
                       (wxlambda:end-modal dialog :cancel)))))
           (assert (eq :cancel (wxlambda:show-modal dialog)))
           (assert cancelled)
           t)
      (when binding (wxlambda:unbind-event binding)))))

(defun exercise ()
  (let ((message (wxlambda:make-message-dialog :message \"Cancellation is available even without a Cancel button.\"
                                             :buttons :yes-no))
        (file (wxlambda:make-file-dialog :mode :open :directory (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (assert (eq :yes-no (wxlambda:message-dialog-buttons message)))
           (assert (eq :open (wxlambda:file-dialog-mode file)))
           (cancel-in-idle message)
           (cancel-in-idle file)
           t)
      (wxlambda:destroy-window message)
      (wxlambda:destroy-window file)
      (wxlambda:process-events))))
"))))
(:entry "example/examples/notebook.lisp" :names ("examples/notebook.lisp") :kind :example :kind-name "Example" :summary "Editor/settings notebook with fixed panel pages, canonical lookup, native silent/notifying selection and contextual navigation veto. Bounded EXERCISE drives selection/veto; physical tab/keyboard interaction remains separate." :sections (("Usage" (:p "Editor/settings notebook with fixed panel pages, canonical lookup, native silent/notifying selection and contextual navigation veto. Bounded EXERCISE drives selection/veto; physical tab/keyboard interaction remains separate.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notebook.lisp --eval '(wxlambda:with-application () (wxlambda-notebook:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE runs inside an existing session.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-notebook (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-notebook)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Notebook navigation\" :width 620 :height 440))
         (book (wxlambda:make-notebook frame))
         (editor (wxlambda:make-panel book))
         (settings (wxlambda:make-panel book))
         (text (wxlambda:make-text editor :multiline t :value (format nil \"Editor page λ~%日本語 😀\")))
         (allow (wxlambda:make-checkbox editor :label \"Allow leaving this page\" :checked t))
         (info (wxlambda:make-label settings :label \"Settings page\"))
         (back (wxlambda:make-button settings :label \"Back to editor\")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame book :proportion 1 :border 0)
    (wxlambda:make-column editor)
    (wxlambda:add-child editor text :proportion 1)
    (wxlambda:add-child editor allow)
    (wxlambda:make-column settings)
    (wxlambda:add-child settings info)
    (wxlambda:add-child settings back)
    (wxlambda:add-notebook-page book editor :label \"Editor λ\")
    (wxlambda:add-notebook-page book settings :label \"Settings\")
    (wxlambda:bind-event book :notebook-page-changing
      (lambda (event context)
        (declare (ignore event))
        (when (not (wxlambda:checked-p allow))
          (setf (wxlambda:event-vetoed-p context) t)))
      :with-context t)
    (wxlambda:bind-event book :notebook-page-changed
      (lambda (event)
        (setf (wxlambda:frame-title frame)
              (format nil \"Notebook — page ~D\" (wxlambda:event-selection event)))))
    (wxlambda:on-click back (lambda () (setf (wxlambda:selection book :notify t) 0)))
    (values frame book editor settings allow)))

(defun exercise ()
  (multiple-value-bind (frame book editor settings allow) (build-window)
    (unwind-protect
         (progn
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (assert (eq editor (wxlambda:notebook-page book 0)))
           (assert (eq settings (wxlambda:notebook-page book 1)))
           (setf (wxlambda:selection book) 0 (wxlambda:checked-p allow) nil)
           (setf (wxlambda:selection book :notify t) 1)
           (assert (= 0 (wxlambda:selection book)))
           (setf (wxlambda:checked-p allow) t)
           (setf (wxlambda:selection book :notify t) 1)
           (assert (= 1 (wxlambda:selection book)))
           t)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame book) (build-window)
      (declare (ignore book))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
"))))
(:entry "example/examples/notify-events.lisp" :names ("examples/notify-events.lisp" "notify-events") :kind :example :kind-name "Example" :summary "A registered notify event validates a proposed change synchronously before applying it. A checkbox selects Veto or Allow; the reusable exercise verifies blocked and accepted changes, both callback paths and cleanup." :sections (("Usage" (:p "A registered notify event validates a proposed change synchronously before applying it. A checkbox selects Veto or Allow; the reusable exercise verifies blocked and accepted changes, both callback paths and cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notify-events.lisp --eval '(wxlambda-notify-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-notify-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-notify-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-notify-events)

(defun open-window ()
  (wxlambda:register-event-type :before-apply :family :notify)
  (let* ((frame (wxlambda:make-frame :title \"Synchronous notify policy\"))
         (panel (wxlambda:make-panel frame))
         (receiver (wxlambda:make-event-handler))
         (reject (wxlambda:make-checkbox panel :label \"Reject changes\" :checked t))
         (apply (wxlambda:make-button panel :label \"Validate then apply\"))
         (caption (wxlambda:make-label panel :label \"No change applied\"))
         (applied 0)
         (binding (wxlambda:bind-event receiver :before-apply
                    (lambda (event context)
                      (assert (eq :notify (wxlambda:event-family event)))
                      (setf (wxlambda:event-vetoed-p context) (wxlambda:checked-p reject)))
                    :with-context t)))
    (wxlambda:make-column panel)
    (dolist (child (list reject apply caption)) (wxlambda:add-child panel child))
    (wxlambda:on-click apply
      (lambda ()
        (multiple-value-bind (handled vetoed)
            (wxlambda:process-event receiver :before-apply :text \"Apply change\" :integer (1+ applied))
          (if (and handled (not vetoed))
              (progn (incf applied) (setf (wxlambda:label-text caption) (format nil \"Applied ~D\" applied)))
              (setf (wxlambda:label-text caption) \"Change rejected\")))))
    (wxlambda:show-window frame)
    (values frame receiver reject apply binding (lambda () applied))))

(defun exercise ()
  (multiple-value-bind (frame receiver reject apply binding applied) (open-window)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (zerop (funcall applied)))
    (setf (wxlambda:checked-p reject) nil)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (= 1 (funcall applied)))
    (wxlambda:off-click apply)
    (wxlambda:unbind-event binding)
    (wxlambda:destroy-event-handler receiver)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/numeric-input.lisp" :names ("examples/numeric-input.lisp" "numeric-input") :kind :example :kind-name "Example" :summary "Signed slider/integer spin synchronization through numeric snapshots with silent cross-control writes and range-clamping button. EXERCISE uses explicit notified setters, not hardware interaction." :sections (("Usage" (:p "Signed slider/integer spin synchronization through numeric snapshots with silent cross-control writes and range-clamping button. EXERCISE uses explicit notified setters, not hardware interaction.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/numeric-input.lisp --eval '(wxlambda-numeric-input:start)'")) ("Source" (:code-block "lisp" ";;; START interactive. EXERCISE synchronizes through explicit numeric notifications.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-numeric-input (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-numeric-input)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Numeric input λ\" :width 560 :height 300))
         (panel (wxlambda:make-panel frame))
         (slider (wxlambda:make-slider panel :minimum -100 :maximum 100 :value 25))
         (spin (wxlambda:make-spin-control panel :minimum -100 :maximum 100 :value 25))
         (label (wxlambda:make-label panel :label \"Value: 25\"))
         (narrow (wxlambda:make-button panel :label \"Use range 0..10\"))
         (changes 0))
    (labels ((update (event target)
               (incf changes)
               ;; Silent cross-control writes avoid recursive update callbacks.
               (let ((value (wxlambda:event-numeric-value event)))
                 (setf (wxlambda:numeric-value target) value
                       (wxlambda:label-text label) (format nil \"Value: ~D\" value)))))
      (wxlambda:bind-event slider :slider-change (lambda (event) (update event spin)))
      (wxlambda:bind-event spin :spin-change (lambda (event) (update event slider))))
    (wxlambda:on-click narrow
      (lambda ()
        (setf (wxlambda:numeric-range slider) '(0 10) (wxlambda:numeric-range spin) '(0 10)
              (wxlambda:label-text label) (format nil \"Value: ~D\" (wxlambda:numeric-value slider)))))
    (wxlambda:make-column panel)
    (dolist (child (list slider spin label narrow)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame slider spin label (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame slider spin label changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:numeric-value slider :notify t) 40)
           (assert (= 40 (wxlambda:numeric-value spin)))
           (setf (wxlambda:numeric-value spin :notify t) -30)
           (assert (= -30 (wxlambda:numeric-value slider)))
           (assert (= 2 (funcall changes)))
           (assert (string= \"Value: -30\" (wxlambda:label-text label)))
           (setf (wxlambda:numeric-range slider) '(0 10) (wxlambda:numeric-range spin) '(0 10))
           (assert (= 0 (wxlambda:numeric-value slider) (wxlambda:numeric-value spin)))
           (assert (= 2 (funcall changes))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/owned-events.lisp" :names ("examples/owned-events.lisp" "owned-events") :kind :example :kind-name "Example" :summary "Construct a reusable native message, mutate only a dispatch copy, retain a detached context clone, queue an independent copy and destroy its source before delivery." :sections (("Usage" (:p "Construct a reusable native message, mutate only a dispatch copy, retain a detached context clone, queue an independent copy and destroy its source before delivery.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/owned-events.lisp --eval '(wxlambda-owned-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-owned-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-owned-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-owned-events)
(defun exercise ()
  (wxlambda:register-event-type :reusable-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :reusable-message :text \"original\" :integer 1))
         (captured nil) (clone nil)
         (binding (wxlambda:bind-event receiver :reusable-message
                    (lambda (event context)
                      (setf captured event)
                      (setf (wxlambda:event-text context) \"changed live copy\"
                            (wxlambda:event-integer context) 7)
                      (setf clone (wxlambda:clone-event context))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver message)
           (assert (string= \"original\" (wxlambda:event-text message)))
           (assert (string= \"original\" (wxlambda:event-text captured)))
           (assert (string= \"changed live copy\" (wxlambda:event-text clone)))
           (assert (= 7 (wxlambda:event-integer clone)))
           (assert (null (wxlambda:event-origin-id clone)))
           (wxlambda:unbind-event binding)
           (setf binding (wxlambda:bind-event receiver :reusable-message (lambda (e) (setf captured e))))
           (wxlambda:queue-event receiver clone)
           (wxlambda:destroy-event clone) (setf clone nil)
           (wxlambda:process-pending-events)
           (assert (string= \"changed live copy\" (wxlambda:event-text captured))))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/pending-events.lisp" :names ("examples/pending-events.lisp" "pending-events") :kind :example :kind-name "Example" :summary "Compare posted copies, consumed transfer inputs, local synchronous processing and handler-specific pending cancellation using owned events." :sections (("Usage" (:p "Compare posted copies, consumed transfer inputs, local synchronous processing and handler-specific pending cancellation using owned events.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/pending-events.lisp --eval '(wxlambda-pending-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-pending-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-pending-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-pending-events)
(defun exercise ()
  (wxlambda:register-event-type :pending-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (source (wxlambda:make-event :kind :pending-message :text \"posted\"))
         (received nil)
         (binding (wxlambda:bind-event receiver :pending-message
                    (lambda (event) (push (wxlambda:event-text event) received)))))
    (unwind-protect
         (progn
           (wxlambda:post-event receiver source)
           (setf (wxlambda:event-text source) \"transferred\")
           (wxlambda:transfer-event receiver source)
           (assert (not (wxlambda:event-alive-p source)))
           (wxlambda:process-pending-events)
           (assert (equal '(\"transferred\" \"posted\") received))
           (let ((discarded (wxlambda:make-event :kind :pending-message :text \"discarded\")))
             (wxlambda:transfer-event receiver discarded)
             (wxlambda:delete-pending-events receiver)
             (wxlambda:process-pending-events)
             (assert (= 2 (length received)))))
      (when (wxlambda:event-alive-p source) (wxlambda:destroy-event source))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/periodic-status.lisp" :names ("examples/periodic-status.lisp" "periodic-status") :kind :example :kind-name "Example" :summary "Real native periodic UI timer updates label/status text; Pause/Resume cancels/creates tickets. Active-session EXERCISE self-cancels after two real updates, without system clipboard transfers." :sections (("Usage" (:p "Real native periodic UI timer updates label/status text; Pause/Resume cancels/creates tickets. Active-session EXERCISE self-cancels after two real updates, without system clipboard transfers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/periodic-status.lisp --eval '(wxlambda-periodic-status:start)'")) ("Source" (:code-block "lisp" ";;; A bounded periodic status update; START is interactive, EXERCISE cancels after two ticks.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-periodic-status (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-periodic-status)
(defun build-window (&key (interval 250) max-ticks)
  (let* ((frame (wxlambda:make-frame :title \"Periodic UI status λ\" :width 500 :height 240))
         (panel (wxlambda:make-panel frame))
         (label (wxlambda:make-label panel :label \"Waiting for a timer tick\"))
         (toggle (wxlambda:make-button panel :label \"Pause / Resume\"))
         (status (wxlambda:make-status-bar frame))
         (count 0) (timer nil))
    (labels ((begin ()
               (setf timer
                     (wxlambda:start-ui-timer
                       (lambda ()
                         (incf count)
                         (setf (wxlambda:label-text label) (format nil \"Update ~D — λ\" count)
                               (wxlambda:status-text status) \"Periodic UI update\")
                         (when (and max-ticks (>= count max-ticks))
                           (wxlambda:cancel-ui-timer timer)
                           (setf (wxlambda:status-text status) \"Stopped after bounded updates\")))
                       interval :owner frame))))
      (wxlambda:make-column panel)
      (wxlambda:add-child panel label :border 12)
      (wxlambda:add-child panel toggle :border 12)
      (wxlambda:on-click toggle
        (lambda ()
          (if (and timer (wxlambda:ui-timer-active-p timer))
              (progn (wxlambda:cancel-ui-timer timer) (setf (wxlambda:status-text status) \"Paused\"))
              (begin))))
      (begin))
    (values frame (lambda () timer) (lambda () count))))
(defun exercise ()
  (multiple-value-bind (frame ticket count) (build-window :interval 10 :max-ticks 2)
    (unwind-protect
         (progn
           (assert (zerop (funcall count)))
           (wxlambda:show-window frame)
           (loop repeat 300 while (wxlambda:ui-timer-active-p (funcall ticket))
                 do (wxlambda:process-events) (sleep 0.005))
           (assert (= 2 (funcall count)))
           (assert (not (wxlambda:ui-timer-active-p (funcall ticket))))
           (assert (not (wxlambda:cancel-ui-timer (funcall ticket)))) t)
      (wxlambda:cancel-ui-timer (funcall ticket))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/radio-groups.lisp" :names ("examples/radio-groups.lisp" "radio-groups") :kind :example :kind-name "Example" :summary "Explicitly owned fixed radio choices select export format and update feedback. EXERCISE verifies silent and explicit notifying updates; no physical input simulation." :sections (("Usage" (:p "Explicitly owned fixed radio choices select export format and update feedback. EXERCISE verifies silent and explicit notifying updates; no physical input simulation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/radio-groups.lisp --eval '(wxlambda-radio-groups:start)'")) ("Source" (:code-block "lisp" ";;; Fixed mutually exclusive choices; START interactive, EXERCISE deterministic.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-radio-groups (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-radio-groups)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Export options\" :width 440 :height 260))
         (panel (wxlambda:make-panel frame))
         (format-choice (wxlambda:make-radio-box panel :label \"Format\" :items '(\"Text\" \"HTML\" \"Markdown\")))
         (feedback (wxlambda:make-label panel :label \"Format: Text\"))
         (changes 0))
    (wxlambda:bind-event format-choice :radio-selection
      (lambda (event)
        (incf changes)
        (setf (wxlambda:label-text feedback)
              (format nil \"Format: ~A\" (wxlambda:item-text format-choice (wxlambda:event-selection event))))))
    (wxlambda:make-column panel)
    (dolist (child (list format-choice feedback)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame format-choice feedback (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame choice feedback changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (= 0 (wxlambda:selection choice)))
           (setf (wxlambda:selection choice) 1)
           (assert (zerop (funcall changes)))
           (setf (wxlambda:selection choice :notify t) 2)
           (assert (= 1 (funcall changes)))
           (assert (string= \"Format: Markdown\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/record-manager.lisp" :names ("examples/record-manager.lisp" "record-manager") :kind :example :kind-name "Example" :summary "Cohesive in-memory tree/list record manager with stable IDs, search/category filtering, notebook details, shared menu/tool/key actions, deferred CRUD/dialogs and clipboard adapters. EXERCISE and tests use deterministic prompt/confirm/copy functions without system clipboard transfers." :sections (("Usage" (:p "Cohesive in-memory tree/list record manager with stable IDs, search/category filtering, notebook details, shared menu/tool/key actions, deferred CRUD/dialogs and clipboard adapters. EXERCISE and tests use deterministic prompt/confirm/copy functions without system clipboard transfers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/record-manager.lisp --eval '(wxlambda-record-manager:start)'")) ("Source" (:code-block "lisp" ";;; Cohesive tree/list manager: stable model identities, deferred actions and adapters.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-record-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-record-manager)

(defconstant +new+ 32201)
(defconstant +edit+ 32202)
(defconstant +delete+ 32203)
(defconstant +copy+ 32204)
(defconstant +details+ 32205)
(defstruct record id category title note)
(defstruct manager frame tree categories query listing book details status toolbar menu-items
  records visible-ids selected-id category (next-id 4) pending refresh-ticket refresh-clear-p active disposed prompt confirm copy-text)

(defun prompt-field (frame message value)
  (let ((dialog (wxlambda:make-text-entry-dialog :parent frame :message message :value value)))
    (unwind-protect
         (when (eq :ok (wxlambda:show-modal dialog)) (values (wxlambda:dialog-value dialog) t))
      (wxlambda:destroy-window dialog))))
(defun prompt-record (frame operation current)
  (multiple-value-bind (title accepted)
      (prompt-field frame (if (eq operation :new) \"Record title:\" \"Rename record:\")
                    (if current (record-title current) \"Untitled\"))
    (when accepted
      (multiple-value-bind (note note-accepted)
          (prompt-field frame \"Record note:\" (if current (record-note current) \"\"))
        (values title note note-accepted)))))
(defun confirm-delete (frame record)
  (let ((dialog (wxlambda:make-message-dialog :parent frame :title \"Delete record\"
                 :message (format nil \"Delete ~A?\" (record-title record)) :buttons :yes-no :icon :question)))
    (unwind-protect (eq :yes (wxlambda:show-modal dialog)) (wxlambda:destroy-window dialog))))
(defun find-record (manager id) (find id (manager-records manager) :key #'record-id))
(defun selected-record (manager) (find-record manager (manager-selected-id manager)))
(defun status (manager message)
  (setf (wxlambda:status-text (manager-status manager)) message))
(defun update-details (manager)
  (let ((record (selected-record manager)))
    (setf (wxlambda:text (manager-details manager))
          (if record (format nil \"~A~%Category: ~A~%ID: ~D~%~%~A\"
                             (record-title record) (record-category record) (record-id record) (record-note record))
              \"Select a record to inspect it.\"))
    (dolist (id (list +edit+ +delete+ +copy+ +details+))
      (setf (wxlambda:enabled-p (cdr (assoc id (manager-menu-items manager)))) (not (null record))
            (wxlambda:tool-enabled-p (manager-toolbar manager) id) (not (null record))))))
(defun refresh-records (manager)
  (let* ((query (wxlambda:text (manager-query manager)))
         (category (manager-category manager))
         (matches (remove-if-not
                    (lambda (record)
                      (and (or (null category) (eq category (record-category record)))
                           (search query (record-title record) :test #'char-equal)))
                    (manager-records manager)))
         (selected (manager-selected-id manager)))
    (setf (manager-visible-ids manager) (mapcar #'record-id matches))
    (wxlambda:clear-items (manager-listing manager))
    (dolist (record matches) (wxlambda:append-item (manager-listing manager) (record-title record)))
    (let ((index (position selected (manager-visible-ids manager))))
      (setf (manager-selected-id manager) (and index selected)
            (wxlambda:selection (manager-listing manager)) index))
    (setf (wxlambda:status-text (manager-status manager) 1)
          (format nil \"~D visible / ~D records\" (length matches) (length (manager-records manager))))
    (update-details manager)))
(defun request-refresh (manager &optional clear-p)
  (when (and clear-p (not (manager-disposed manager))) (setf (manager-refresh-clear-p manager) t))
  (unless (or (manager-disposed manager) (manager-refresh-ticket manager))
    (setf (manager-refresh-ticket manager)
          (wxlambda:defer-ui-action
            (lambda ()
              (let ((clear (manager-refresh-clear-p manager)))
                (setf (manager-refresh-ticket manager) nil (manager-refresh-clear-p manager) nil)
                (unless (manager-disposed manager)
                  (when clear (setf (wxlambda:text (manager-query manager)) \"\"))
                  (refresh-records manager)))) :owner (manager-frame manager)))))
(defun valid-fields-p (title note)
  (and (stringp title) (plusp (length title)) (stringp note)
       (notany (lambda (character) (find character title)) (list #\\Null #\\Return #\\Newline))
       (not (find #\\Null note))))
(defun perform-action (manager operation target-id category)
  (let ((record (find-record manager target-id)))
    (case operation
      ((:new :edit)
       (when (or (eq operation :new) record)
         (multiple-value-bind (title note accepted)
             (funcall (manager-prompt manager) (manager-frame manager) operation (and (eq operation :edit) record))
           (cond ((not accepted) (status manager \"Edit canceled\"))
                 ((not (valid-fields-p title note)) (status manager \"Title must be nonempty single-line text; NUL is not allowed\"))
                 (t
                  (if (eq operation :new)
                      (let ((created (make-record :id (manager-next-id manager) :category (or category :documents)
                                                  :title (copy-seq title) :note (copy-seq note))))
                        (incf (manager-next-id manager))
                        (setf (manager-records manager) (append (manager-records manager) (list created))
                              (manager-selected-id manager) (record-id created)))
                      (setf (record-title record) (copy-seq title) (record-note record) (copy-seq note)))
                  (refresh-records manager)
                  (status manager (if (eq operation :new) \"Record created\" \"Record updated\")))))))
      (:delete
       (when record
         (if (funcall (manager-confirm manager) (manager-frame manager) record)
             (progn
               (setf (manager-records manager) (remove (record-id record) (manager-records manager) :key #'record-id))
               (when (eql (manager-selected-id manager) (record-id record))
                 (setf (manager-selected-id manager) nil))
               (refresh-records manager) (status manager \"Record deleted\"))
             (status manager \"Delete canceled\"))))
      (:copy
       (when record
         (funcall (manager-copy-text manager) (format nil \"~A~%~A\" (record-title record) (record-note record)))
         (status manager \"Record copied\")))
      (:details
       (when record
         (let ((index (position (record-id record) (manager-visible-ids manager))))
           (if index
               (progn
                 (setf (manager-selected-id manager) (record-id record)
                       (wxlambda:selection (manager-listing manager)) index)
                 (update-details manager)
                 (setf (wxlambda:selection (manager-book manager)) 1))
               (status manager \"Requested record is no longer visible\"))))))))
(defun request-action (manager operation)
  ;; First request wins. Stable model IDs, not row indices or borrowed tree views,
  ;; identify action targets while the idle phase is pending.
  (unless (or (manager-disposed manager) (manager-pending manager) (manager-active manager))
    (let ((target-id (manager-selected-id manager)) (category (manager-category manager)))
      (setf (manager-pending manager)
            (wxlambda:defer-ui-action
              (lambda ()
                (setf (manager-pending manager) nil)
                (unless (manager-disposed manager)
                  (setf (manager-active manager) t)
                  (unwind-protect (perform-action manager operation target-id category)
                    (setf (manager-active manager) nil)))) :owner (manager-frame manager))))))
(defun dispose-manager (manager)
  (unless (manager-disposed manager)
    (setf (manager-disposed manager) t)
    (dolist (ticket (list (manager-pending manager) (manager-refresh-ticket manager)))
      (when ticket (wxlambda:cancel-ui-action ticket)))
    (setf (manager-pending manager) nil (manager-refresh-ticket manager) nil)
    (when (wxlambda:handler-alive-p (manager-frame manager)) (wxlambda:destroy-window (manager-frame manager)))))

(defun build-manager (&key (prompt #'prompt-record) (confirm #'confirm-delete)
                           (copy-text (lambda (text) (setf (wxlambda:clipboard-text) text))))
  (let* ((frame (wxlambda:make-frame :title \"Record manager λ\" :width 900 :height 560
                                  :accelerators '((#\\n 32201 :ctrl) (#\\e 32202 :ctrl) (#\\c 32204 :ctrl :shift) (:f1 32205))))
         (toolbar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame :fields 2))
         (bar (wxlambda:make-menu-bar frame)) (menu (wxlambda:make-menu bar :label \"&Records\"))
         (splitter (wxlambda:make-splitter-window frame :sash-position 220 :minimum-pane-size 80))
         (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
         (tree (wxlambda:make-tree-control left)) (root (wxlambda:add-tree-root tree \"All records\"))
         (documents (wxlambda:append-tree-item root \"Documents\"))
         (images (wxlambda:append-tree-item root \"Images\"))
         (book (wxlambda:make-notebook right))
         (records-page (wxlambda:make-panel book)) (details-page (wxlambda:make-panel book))
         (query (wxlambda:make-search-control records-page :hint \"Filter record titles\"))
         (listing (wxlambda:make-list-box records-page))
         (details (wxlambda:make-text details-page :multiline t :editable-p nil))
         (manager (make-manager :frame frame :tree tree :categories (list (cons root nil) (cons documents :documents) (cons images :images))
                     :query query :listing listing :book book :details details :status status :toolbar toolbar
                     :prompt prompt :confirm confirm :copy-text copy-text
                     :records (list (make-record :id 1 :category :documents :title \"Notes λ\" :note \"Initial document\")
                                    (make-record :id 2 :category :documents :title \"日本語 😀\" :note \"Unicode record\")
                                    (make-record :id 3 :category :images :title \"Diagram\" :note \"Retained scene reference\")))))
    (loop for id in (list +new+ +edit+ +delete+ +copy+ +details+)
          for label in '(\"&New\" \"&Edit\" \"&Delete\" \"&Copy record\" \"&Details\")
          for art in '(:new :open :information :copy :information)
          do (push (cons id (wxlambda:make-menu-item menu :id id :label label)) (manager-menu-items manager))
             (wxlambda:add-toolbar-tool toolbar id label :art art))
    (wxlambda:realize-toolbar toolbar)
    (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :border 0)
    (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :border 0)
    (wxlambda:make-column right) (wxlambda:add-child right book :proportion 1 :border 0)
    (wxlambda:make-column records-page) (wxlambda:add-child records-page query :border 8)
    (wxlambda:add-child records-page listing :proportion 1 :expand t :border 8)
    (wxlambda:make-column details-page) (wxlambda:add-child details-page details :proportion 1 :expand t :border 8)
    (wxlambda:add-notebook-page book records-page :label \"Records\")
    (wxlambda:add-notebook-page book details-page :label \"Details\")
    (wxlambda:split-window splitter left right)
    (setf (wxlambda:tree-item-expanded-p root) t (wxlambda:selection tree) root)
    (status manager \"Ready — model changes stay in memory\")
    (refresh-records manager)
    (wxlambda:bind-event tree :tree-selection-changed
      (lambda (event)
        (setf (manager-category manager) (cdr (assoc (wxlambda:event-tree-item event) (manager-categories manager) :test #'eq)))
        (request-refresh manager)))
    (dolist (kind '(:text-change :search))
      (wxlambda:bind-event query kind (lambda (event) (declare (ignore event)) (request-refresh manager))))
    (wxlambda:bind-event query :search-cancel (lambda (event) (declare (ignore event)) (request-refresh manager t)))
    (wxlambda:on-selection listing
      (lambda (event)
        (let ((index (wxlambda:event-selection event)))
          (setf (manager-selected-id manager) (and index (nth index (manager-visible-ids manager)))))
        (update-details manager)))
    (wxlambda:bind-event listing :listbox-double-click (lambda (event) (declare (ignore event)) (request-action manager :details)))
    (labels ((command (event context)
               (declare (ignore context))
               (let ((operation (cdr (assoc (wxlambda:event-id event)
                                     (list (cons +new+ :new) (cons +edit+ :edit) (cons +delete+ :delete)
                                           (cons +copy+ :copy) (cons +details+ :details))))))
                 (when operation (request-action manager operation)))))
      (wxlambda:bind-event toolbar :menu #'command :id +new+ :last-id +details+ :with-context t)
      (wxlambda:bind-event frame :menu #'command :id +new+ :last-id +details+ :with-context t))
    manager))
(defun drain-manager (manager)
  (loop repeat 80 while (or (manager-pending manager) (manager-refresh-ticket manager)) do (wxlambda:process-events))
  (assert (not (or (manager-pending manager) (manager-refresh-ticket manager)))))
(defun exercise ()
  (let ((replies (list (list \"Created λ\" \"New note\" t) (list \"Renamed λ\" (format nil \"Line 1~%Line 2\") t)
                       (list nil nil nil) (list \"\" \"invalid\" t)))
        (copied nil) (confirm nil) (prompt-count 0))
    (let ((manager (build-manager :prompt (lambda (frame operation current)
                                          (declare (ignore frame operation current))
                                          (incf prompt-count) (values-list (pop replies)))
                                 :confirm (lambda (frame record) (declare (ignore frame record)) confirm)
                                 :copy-text (lambda (text) (setf copied text)))))
      (unwind-protect
           (progn
             (wxlambda:show-window (manager-frame manager)) (wxlambda:process-events)
             (assert (= 3 (wxlambda:item-count (manager-listing manager))))
             (setf (wxlambda:selection (manager-tree manager) :notify t) (car (second (manager-categories manager))))
             (drain-manager manager) (assert (= 2 (wxlambda:item-count (manager-listing manager))))
             (setf (wxlambda:text (manager-query manager) :notify t) \"λ\")
             (drain-manager manager) (assert (equal '(1) (manager-visible-ids manager)))
             (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
             (wxlambda:activate-toolbar-tool (manager-toolbar manager) +copy+)
             (assert (null copied)) (drain-manager manager)
             (assert (string= (format nil \"Notes λ~%Initial document\") copied))
             (setf (wxlambda:text (manager-query manager) :notify t) \"\") (drain-manager manager)
             (wxlambda:process-event (manager-frame manager) :menu :id +new+)
             (wxlambda:process-event (manager-frame manager) :menu :id +new+) ; first request wins
             (assert (zerop prompt-count)) (drain-manager manager)
             (assert (= 1 prompt-count)) (assert (= 4 (length (manager-records manager))))
             (assert (= 4 (manager-selected-id manager)))
             (assert (eq :documents (record-category (find-record manager 4))))
             (wxlambda:activate-menu-item (cdr (assoc +edit+ (manager-menu-items manager))))
             (drain-manager manager)
             (assert (string= \"Renamed λ\" (record-title (find-record manager 4))))
             (assert (search \"Line 2\" (wxlambda:text (manager-details manager))))
             (wxlambda:process-event (manager-frame manager) :menu :id +details+) (drain-manager manager)
             (assert (= 1 (wxlambda:selection (manager-book manager))))
             (request-action manager :edit) (drain-manager manager) ; cancel preserves model
             (assert (string= \"Renamed λ\" (record-title (find-record manager 4))))
             (request-action manager :new) (drain-manager manager) ; invalid title preserves model
             (assert (= 4 (length (manager-records manager))))
             (request-action manager :delete) (drain-manager manager)
             (assert (find-record manager 4))
             (setf confirm t) (request-action manager :delete) (drain-manager manager)
             (assert (not (find-record manager 4)))
             (assert (null (manager-selected-id manager)))
             (assert (not (wxlambda:tool-enabled-p (manager-toolbar manager) +edit+)))
             ;; Stable ID targeting survives row/filter changes between request/delivery.
             (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
             (request-action manager :copy)
             (setf (wxlambda:text (manager-query manager) :notify t) \"日本語\")
             (drain-manager manager)
             (assert (string= (format nil \"Notes λ~%Initial document\") copied))
             (assert (equal '(2) (manager-visible-ids manager)))
             t)
        (dispose-manager manager) (wxlambda:process-events)))))
(defun start ()
  (wxlambda:with-application ()
    (let ((manager (build-manager)))
      (unwind-protect (progn (wxlambda:show-window (manager-frame manager)) (wxlambda:run))
        (dispose-manager manager) (wxlambda:process-events)))))
"))))
(:entry "example/examples/report-views.lisp" :names ("examples/report-views.lisp" "report-views") :kind :example :kind-name "Example" :summary "Million-row native virtual report using a CLOS OnGetItemText override, checked decorated tree sidebar and deferred activation actions." :sections (("Usage" (:p "Million-row native virtual report using a CLOS OnGetItemText override, checked decorated tree sidebar and deferred activation actions.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/report-views.lisp --eval '(wxlambda-report-views:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-report-views (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-report-views)
(defclass generated-report (wxlambda:list-control)
 ((prefix :initarg :prefix :reader prefix))
 (:default-initargs :virtual-p t :prefix \"Generated λ\"))
(defmethod wxlambda:list-item-text ((control generated-report) row column)
 (if (zerop column) (format nil \"~A ~D\" (prefix control) row) (format nil \"~D\" (* row row))))
(defun build-window ()
 (let* ((frame (wxlambda:make-frame :title \"Native report and tree views\" :width 900 :height 500))
        (splitter (wxlambda:make-splitter-window frame :sash-position 220))
        (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
        (tree (wxlambda:make-tree-control left))
        (report (wxlambda:make-list-control right :class 'generated-report))
        (feedback (wxlambda:make-label right :label \"Activate a row or tree item\")))
  (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :expand t)
  (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :expand t)
  (wxlambda:make-column right) (wxlambda:add-child right report :proportion 1 :expand t)
  (wxlambda:add-child right feedback :border 8)
  (wxlambda:split-window splitter left right)
  (wxlambda:insert-list-column report 0 \"Generated row\" :width 260)
  (wxlambda:insert-list-column report 1 \"Square\" :width 180)
  (setf (wxlambda:item-count report) 1000000)
  (let* ((root (wxlambda:add-tree-root tree \"Views λ\"))
         (child (wxlambda:append-tree-item root \"One million virtual rows\")))
   (setf (wxlambda:tree-item-bold-p root) t
         (wxlambda:tree-item-foreground child) #x28558a
         (wxlambda:tree-item-expanded-p root) t))
  (wxlambda:bind-event report :list-item-activated
   (lambda (event)
    (let ((row (wxlambda:event-list-index event)))
     (wxlambda:defer-ui-action
      (lambda () (setf (wxlambda:label-text feedback) (if row (wxlambda:list-item-text report row 0) \"No native row\"))) :owner report))))
  (wxlambda:bind-event tree :tree-item-activated
   (lambda (event)
    (let ((item (wxlambda:event-tree-item event)))
     (wxlambda:defer-ui-action
      (lambda () (when (and item (wxlambda:tree-item-alive-p item))
                   (setf (wxlambda:label-text feedback) (wxlambda:tree-item-text item)))) :owner tree))))
  (values frame report tree)))
(defun exercise ()
 (multiple-value-bind (frame report tree) (build-window)
  (unwind-protect
   (progn
    (wxlambda:show-window frame) (wxlambda:process-events)
    (assert (= 1000000 (wxlambda:item-count report)))
    (assert (string= \"Generated λ 999999\" (wxlambda:list-item-text report 999999 0)))
    (assert (string= \"998001\" (wxlambda:list-item-text report 999 1)))
    (setf (wxlambda:selection report) 500000)
    (assert (= 500000 (wxlambda:selection report)))
    (assert (wxlambda:tree-item-bold-p (wxlambda:tree-root tree))) t)
   (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
 (wxlambda:with-application ()
  (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/scrolling-panels.lisp" :names ("examples/scrolling-panels.lisp" "scrolling-panels") :kind :example :kind-name "Example" :summary "24-field form in a scrolling viewport with an owner-bound deferred Back to top action. EXERCISE checks extent, native movement and safe return without physical input simulation." :sections (("Usage" (:p "24-field form in a scrolling viewport with an owner-bound deferred Back to top action. EXERCISE checks extent, native movement and safe return without physical input simulation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/scrolling-panels.lisp --eval '(wxlambda-scrolling-panels:start)'")) ("Source" (:code-block "lisp" ";;; Larger form with a scrolling viewport and owner-bound deferred navigation.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-scrolling-panels (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-scrolling-panels)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Scrollable form λ\" :width 480 :height 300))
         (outer (wxlambda:make-panel frame))
         (top (wxlambda:make-button outer :label \"Back to top\"))
         (viewport (wxlambda:make-scrolled-panel outer :scroll-rate '(0 16))))
    (wxlambda:make-column outer)
    (wxlambda:add-child outer top :border 8)
    (wxlambda:add-child outer viewport :proportion 1 :expand t :border 8)
    (wxlambda:make-column viewport)
    (dotimes (index 24)
      (wxlambda:add-child viewport
        (wxlambda:make-text viewport :value (format nil \"Field ~D — λ\" (1+ index))) :border 8))
    (wxlambda:fit-scroll-content viewport)
    (wxlambda:on-click top
      (lambda ()
        (wxlambda:defer-ui-action (lambda () (setf (wxlambda:scroll-position viewport) '(0 0))) :owner viewport)))
    (values frame viewport top)))
(defun exercise ()
  (multiple-value-bind (frame viewport top) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (wxlambda:fit-scroll-content viewport)
           (assert (> (second (wxlambda:scroll-extent viewport)) 600))
           (setf (wxlambda:scroll-position viewport) '(0 12))
           (assert (plusp (second (wxlambda:scroll-position viewport))))
           (wxlambda:queue-click top)
           (loop repeat 30 until (equal '(0 0) (wxlambda:scroll-position viewport))
                 do (wxlambda:process-events))
           (assert (equal '(0 0) (wxlambda:scroll-position viewport))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/search-controls.lisp" :names ("examples/search-controls.lisp" "search-controls") :kind :example :kind-name "Example" :summary "Native query and Lisp-native list filtering with deferred TEXT/search handling and explicit deferred cancel/clear policy. EXERCISE uses explicit TEXT notification and a Clear filter command; native search/cancel gestures are tested separately without physical input simulation." :sections (("Usage" (:p "Native query and Lisp-native list filtering with deferred TEXT/search handling and explicit deferred cancel/clear policy. EXERCISE uses explicit TEXT notification and a Clear filter command; native search/cancel gestures are tested separately without physical input simulation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/search-controls.lisp --eval '(wxlambda-search-controls:start)'")) ("Source" (:code-block "lisp" ";;; Native search input with Lisp-native filtering and deferred cancel policy.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-search-controls (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-search-controls)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Search records λ\" :width 480 :height 330))
         (panel (wxlambda:make-panel frame))
         (query (wxlambda:make-search-control panel :hint \"Filter records — λ\"))
         (records '(\"Alpha\" \"Lambda λ\" \"Lisp notes\" \"Calendar\"))
         (results (wxlambda:make-list-box panel :items records))
         (feedback (wxlambda:make-label panel :label \"4 results\"))
         (clear (wxlambda:make-button panel :label \"Clear filter\")))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel query :border 8)
    (wxlambda:add-child panel results :proportion 1 :expand t :border 8)
    (wxlambda:add-child panel feedback :border 8)
    (wxlambda:add-child panel clear :border 8)
    (labels ((filter-records ()
               (let* ((text (wxlambda:text query))
                      (matches (remove-if-not (lambda (record) (search text record :test #'char-equal)) records)))
                 (wxlambda:clear-items results)
                 (dolist (record matches) (wxlambda:append-item results record))
                 (setf (wxlambda:label-text feedback) (format nil \"~D results\" (length matches)))))
             (request-filter (&optional clear-p)
               (wxlambda:defer-ui-action
                 (lambda ()
                   (when clear-p (setf (wxlambda:text query) \"\"))
                   (filter-records)) :owner query)))
      (dolist (kind '(:text-change :search))
        (wxlambda:bind-event query kind (lambda (event) (declare (ignore event)) (request-filter))))
      (wxlambda:bind-event query :search-cancel
        (lambda (event) (declare (ignore event)) (request-filter t)))
      (wxlambda:on-click clear (lambda () (request-filter t))))
    (values frame query results clear feedback)))
(defun exercise ()
  (multiple-value-bind (frame query results clear feedback) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:text query :notify t) \"λ\")
           (loop repeat 30 until (= 1 (wxlambda:item-count results)) do (wxlambda:process-events))
           (assert (= 1 (wxlambda:item-count results)))
           (assert (string= \"Lambda λ\" (wxlambda:item-text results 0)))
           (wxlambda:queue-click clear)
           (loop repeat 30 until (= 4 (wxlambda:item-count results)) do (wxlambda:process-events))
           (assert (string= \"\" (wxlambda:text query)))
           (assert (= 4 (wxlambda:item-count results)))
           (assert (string= \"4 results\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/session-events.lisp" :names ("examples/session-events.lisp" "session-events") :kind :example :kind-name "Example" :summary "Isolated standalone query-end-session policy with logging-off metadata and checked veto. Never dispatches synthetic session events to wxApp or triggers real OS logout/shutdown." :sections (("Usage" (:p "Isolated standalone query-end-session policy with logging-off metadata and checked veto. Never dispatches synthetic session events to wxApp or triggers real OS logout/shutdown.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/session-events.lisp --eval '(wxlambda-session-events:start)'")) ("Source" (:code-block "lisp" ";;; Synthetic policy exercise only: never emits OS session events on wxApp.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-session-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-session-events)
(defun exercise ()
  (let* ((receiver (wxlambda:make-event-handler))
         (binding (wxlambda:bind-event receiver :query-end-session
                    (lambda (event context)
                      (assert (wxlambda:event-logging-off-p event))
                      (when (wxlambda:event-can-veto-p context)
                        (setf (wxlambda:event-vetoed-p context) t))) :with-context t)))
    (unwind-protect
         (assert (equal '(t t) (multiple-value-list
                   (wxlambda:process-event receiver :query-end-session :logging-off-p t))))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/splitter-manager.lisp" :names ("examples/splitter-manager.lisp" "splitter-manager") :kind :example :kind-name "Example" :summary "Fixed two-pane in-memory tree/list manager with canonical panes, model-driven navigation and guarded sash observations." :sections (("Usage" (:p "Fixed two-pane in-memory tree/list manager with canonical panes, model-driven navigation and guarded sash observations.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/splitter-manager.lisp --eval '(wxlambda-splitter-manager:start)'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE runs inside an active GUI session.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-splitter-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-splitter-manager)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Two-pane tree/list manager\" :width 760 :height 460))
         (splitter (wxlambda:make-splitter-window frame :sash-position 220 :minimum-pane-size 80 :sash-gravity 0.3d0))
         (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
         (tree (wxlambda:make-tree-control left))
         (root (wxlambda:add-tree-root tree \"Workspace λ\"))
         (documents (wxlambda:append-tree-item root \"Documents\"))
         (images (wxlambda:append-tree-item root \"Images\"))
         (items (wxlambda:make-list-box right))
         (status (wxlambda:make-label right :label \"Select a folder\"))
         (model (list (cons root '(\"All documents\" \"All images\"))
                      (cons documents '(\"notes.txt\" \"日本語 😀.txt\"))
                      (cons images '(\"diagram.png\" \"photo.jpg\")))))
    (labels ((refresh (item)
               (wxlambda:clear-items items)
               (dolist (value (cdr (assoc item model :test #'eq))) (wxlambda:append-item items value))
               (setf (wxlambda:label-text status) (if item (wxlambda:tree-item-text item) \"No folder\"))))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame splitter :proportion 1 :border 0)
      (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :border 0)
      (wxlambda:make-column right) (wxlambda:add-child right items :proportion 1)
      (wxlambda:add-child right status)
      (wxlambda:split-window splitter left right)
      (setf (wxlambda:tree-item-expanded-p root) t)
      (refresh root)
      (wxlambda:bind-event tree :tree-selection-changed (lambda (event) (refresh (wxlambda:event-tree-item event))))
      (wxlambda:on-selection items (lambda (event) (setf (wxlambda:label-text status) (wxlambda:event-text event))))
      (wxlambda:bind-event splitter :splitter-sash-changed
        (lambda (event) (setf (wxlambda:frame-title frame)
                             (format nil \"Two-pane manager — sash ~D\" (wxlambda:event-sash-position event)))))
      (values frame splitter left right tree documents images items))))

(defun exercise ()
  (multiple-value-bind (frame splitter left right tree documents images items) (build-window)
    (unwind-protect
         (progn
           (assert (wxlambda:splitter-split-p splitter))
           (assert (eq left (wxlambda:splitter-pane splitter 0)))
           (assert (eq right (wxlambda:splitter-pane splitter 1)))
           (setf (wxlambda:selection tree :notify t) documents)
           (assert (string= \"日本語 😀.txt\" (wxlambda:item-text items 1)))
           (setf (wxlambda:selection tree :notify t) images)
           (assert (string= \"photo.jpg\" (wxlambda:item-text items 1)))
           (setf (wxlambda:splitter-sash-position splitter) 240)
           (wxlambda:process-events)
           (assert (plusp (wxlambda:splitter-sash-position splitter)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame splitter) (build-window)
      (declare (ignore splitter))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
"))))
(:entry "example/examples/standard-dialogs.lisp" :names ("examples/standard-dialogs.lisp" "standard-dialogs") :kind :example :kind-name "Example" :summary "Interactive START opens a native text prompt; EXERCISE within an active session deterministically cancels a real modal loop from native idle. Generic message/file dialogs are demonstrated separately; platform-native backends remain deferred." :sections (("Usage" (:p "Interactive START opens a native text prompt; EXERCISE within an active session deterministically cancels a real modal loop from native idle. Generic message/file dialogs are demonstrated separately; platform-native backends remain deferred.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/standard-dialogs.lisp --eval '(wxlambda-standard-dialogs:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-standard-dialogs:start) for an interactive prompt.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-standard-dialogs (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-standard-dialogs)

(defun start ()
  (wxlambda:with-application ()
    (let ((dialog (wxlambda:make-text-entry-dialog :message \"Document name:\" :value \"Untitled\")))
      (unwind-protect
           (when (eq :ok (wxlambda:show-modal dialog))
             (format t \"Document name: ~A~%\" (wxlambda:dialog-value dialog)))
        (wxlambda:destroy-window dialog)
        (wxlambda:process-events)))))

(defun exercise ()
  ;; A deterministic cancellation example: real native modal loop, no user input.
  (let* ((dialog (wxlambda:make-text-entry-dialog :message \"Bounded modal example\" :value \"Draft\"))
         (binding nil) (closed nil))
    (unwind-protect
         (progn
           (setf binding
                 (wxlambda:bind-event (wxlambda:current-application-handler) :idle
                   (lambda (event)
                     (declare (ignore event))
                     (when (and (not closed) (wxlambda:dialog-modal-p dialog))
                       (setf closed t)
                       (wxlambda:end-modal dialog :cancel)))))
           (assert (eq :cancel (wxlambda:show-modal dialog)))
           (assert closed)
           (assert (string= \"Draft\" (wxlambda:dialog-value dialog)))
           t)
      (when binding (wxlambda:unbind-event binding))
      (wxlambda:destroy-window dialog)
      (wxlambda:process-events))))
"))))
(:entry "example/examples/styled-text.lisp" :names ("examples/styled-text.lisp" "styled-text") :kind :example :kind-name "Example" :summary "General native Scintilla text control with copied Unicode text, styling, margins, indicators, markers, grouped undo, multiple selections, autocomplete/call tip and synchronous same-control container styling; no application editor model." :sections (("Usage" (:p "General native Scintilla text control with copied Unicode text, styling, margins, indicators, markers, grouped undo, multiple selections, autocomplete/call tip and synchronous same-control container styling; no application editor model.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/styled-text.lisp --eval '(wxlambda-styled-text:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-styled-text (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-styled-text)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Native styled text\" :width 700 :height 420))
         (control (wxlambda:make-styled-text-control frame :value (format nil \"alpha λ~%beta 😀~%\"))))
    ;; These styling decisions are application code, not a wxlambda language service.
    (setf (wxlambda:stc-margin-type control 0) 1
          (wxlambda:stc-margin-width control 0) 48
          (wxlambda:stc-style-foreground control 1) #x3366cc
          (wxlambda:stc-style-bold-p control 1) t)
    (wxlambda:start-stc-styling control 0)
    (wxlambda:set-stc-style-bytes control (make-array 5 :element-type '(unsigned-byte 8) :initial-element 1))
    (assert (>= (wxlambda:stc-end-styled control) 5))
    (wxlambda:define-stc-marker control 0 2) (wxlambda:add-stc-marker control 0 0)
    (setf (wxlambda:stc-indicator-style control 0) 1
          (wxlambda:stc-indicator-foreground control 0) #xe09020
          (wxlambda:stc-current-indicator control) 0)
    (wxlambda:fill-stc-indicator-range control 6 2)
    (wxlambda:bind-event control :stc-style-needed
      (lambda (event)
        (let* ((end (wxlambda:event-stc-position event)) (prefix (min 5 end)))
          (wxlambda:start-stc-styling control 0)
          (wxlambda:set-stc-styling control prefix 1)
          (wxlambda:set-stc-styling control (- end prefix) 0))))
    (wxlambda:show-window frame) (values frame control)))
(defun exercise ()
  (multiple-value-bind (frame control) (build-window)
    (unwind-protect
         (progn
           (assert (= 1 (wxlambda:stc-style-at control 0)))
           (assert (= #x3366cc (wxlambda:stc-style-foreground control 1)))
           (assert (logbitp 0 (wxlambda:stc-markers-at-line control 0)))
           (wxlambda:begin-stc-undo-action control)
           (unwind-protect
                (progn (wxlambda:replace-stc-range control 0 5 \"first\")
                       (wxlambda:replace-stc-range control 9 13 \"next\"))
             (wxlambda:end-stc-undo-action control))
           (wxlambda:stc-undo control)
           (assert (string= (format nil \"alpha λ~%beta 😀~%\") (wxlambda:stc-text control)))
           t)
      (wxlambda:destroy-window frame))))
(defun start () (wxlambda:with-application () (build-window) (wxlambda:run)))
"))))
(:entry "example/examples/text-editor.lisp" :names ("examples/text-editor.lisp" "text-editor") :kind :example :kind-name "Example" :summary "Multiline text controls with native selection/replacement/end offsets, append-at-end and user-editability toggle. Bounded EXERCISE replaces Unicode multiline text and checks notifications/read-only state; no document IO or selection clipboard APIs." :sections (("Usage" (:p "Multiline text controls with native selection/replacement/end offsets, append-at-end and user-editability toggle. Bounded EXERCISE replaces Unicode multiline text and checks notifications/read-only state; no document IO or selection clipboard APIs.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/text-editor.lisp --eval '(wxlambda:with-application () (wxlambda-text-editor:exercise))'")) ("Source" (:code-block "lisp" ";;; Bounded multiline editor primitives; document IO remains Lisp application code.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-text-editor (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-text-editor)

(defun exercise ()
  (let* ((frame (wxlambda:make-frame))
         (text (wxlambda:make-text frame :multiline t :value (format nil \"First λ~%Second 日本語 😀\")))
         (changes 0))
    (unwind-protect
         (progn
           (assert (wxlambda:text-multiline-p text))
           (wxlambda:on-text-change text (lambda (event) (declare (ignore event)) (incf changes)))
           (setf (wxlambda:text-selection text) (list 0 (wxlambda:text-last-position text)))
           (multiple-value-bind (from to) (wxlambda:text-selection text)
             (wxlambda:replace-text text from to (format nil \"Replaced λ~%Still multiline\")))
           (assert (plusp changes))
           (assert (string= (wxlambda:text text) (format nil \"Replaced λ~%Still multiline\")))
           (setf (wxlambda:text-editable-p text) nil)
           (assert (not (wxlambda:text-editable-p text)))
           t)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title \"Multiline Lisp editor\" :width 640 :height 480))
           (panel (wxlambda:make-panel frame))
           (text (wxlambda:make-text panel :multiline t :value (format nil \"Edit this text.~%Unicode: λ 日本語 😀\")))
           (append (wxlambda:make-button panel :label \"Append a line\"))
           (replace (wxlambda:make-button panel :label \"Replace selection with λ\"))
           (editable (wxlambda:make-checkbox panel :label \"Allow typing\" :checked t))
           (status (wxlambda:make-label panel :label \"Ready\")))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame panel :border 0 :proportion 1)
      (wxlambda:make-column panel)
      (wxlambda:add-child panel text :proportion 1)
      (dolist (child (list append replace editable status)) (wxlambda:add-child panel child))
      (wxlambda:on-text-change text
        (lambda (event)
          (declare (ignore event))
          (setf (wxlambda:label-text status)
                (format nil \"Changed; native end offset ~D\" (wxlambda:text-last-position text)))))
      ;; Read-only controls still accept these explicit programmatic changes.
      (wxlambda:on-click append
        (lambda () (let ((end (wxlambda:text-last-position text)))
                     (wxlambda:replace-text text end end (format nil \"~%Appended λ\")))))
      (wxlambda:on-click replace
        (lambda () (multiple-value-bind (from to) (wxlambda:text-selection text)
                     (wxlambda:replace-text text from to \"λ\"))))
      (wxlambda:on-toggle editable
        (lambda (event) (setf (wxlambda:text-editable-p text) (wxlambda:event-checked-p event))))
      (unwind-protect
           (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
"))))
(:entry "example/examples/thread-events.lisp" :names ("examples/thread-events.lisp" "thread-events") :kind :example :kind-name "Example" :summary "Existing GUI receiver gets copied Unicode/NUL payload from an actual SBCL/CCL worker thread; callback delivery remains on the GUI thread. No native worker closures, editor jobs, network or system clipboard transfers." :sections (("Usage" (:p "Existing GUI receiver gets copied Unicode/NUL payload from an actual SBCL/CCL worker thread; callback delivery remains on the GUI thread. No native worker closures, editor jobs, network or system clipboard transfers.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/thread-events.lisp --eval '(wxlambda-thread-events:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(asdf:load-asd (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-thread-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-thread-events)
(defun current-thread () #+sbcl sb-thread:*current-thread* #+ccl ccl:*current-process*)
(defun launch-worker (function)
  #+sbcl (sb-thread:make-thread function :name \"wx copied-event worker\")
  #+ccl (ccl:process-run-function \"wx copied-event worker\" function)
  #-(or sbcl ccl) (error \"This example has thread adapters for SBCL/CCL\"))
(defun join-worker (thread)
  #+sbcl (sb-thread:join-thread thread)
  #+ccl (ccl:join-process thread))
(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title \"Worker event delivery\"))
         (gui (current-thread)) (received nil) (worker nil)
         (payload (concatenate 'string \"Worker λ\" (string #\\Null) \"😀\")))
    (unwind-protect
         (progn
           (wxlambda:bind-event frame :thread
             (lambda (event)
               (assert (eq gui (current-thread)))
               (assert (eq :base (wxlambda:event-family event)))
               (push (wxlambda:event-text event) received)))
           (wxlambda:show-window frame)
           (setf worker (launch-worker (lambda () (wxlambda:queue-thread-event frame payload))))
           (join-worker worker) (setf worker nil)
           (let ((expected (copy-seq payload)))
             (setf (char payload 0) #\\X)
             (loop repeat 100 until received do (wxlambda:process-events) (sleep .005))
             (assert (equal (list expected) received))) t)
      (when worker (join-worker worker))
      (wxlambda:destroy-window frame))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title \"Thread event example\" :width 500 :height 180))
           (panel (wxlambda:make-panel frame))
           (status (wxlambda:make-label panel :label \"Waiting for worker\"))
           (worker nil))
      (wxlambda:make-column panel) (wxlambda:add-child panel status :border 16)
      (wxlambda:bind-event frame :thread
        (lambda (event) (setf (wxlambda:label-text status) (wxlambda:event-text event))))
      (unwind-protect
           (progn
             (wxlambda:show-window frame)
             (setf worker (launch-worker (lambda () (wxlambda:queue-thread-event frame \"Copied worker result λ 😀\"))))
             (wxlambda:run))
        (when worker (join-worker worker))))))
"))))
(:entry "example/examples/time-picker.lisp" :names ("examples/time-picker.lisp") :kind :example :kind-name "Example" :summary "Time-of-day start form with native snapshot feedback and an owner-bound deferred Reset action. EXERCISE checks explicit-notify feedback and reset without simulating physical time input or scheduling anything." :sections (("Usage" (:p "Time-of-day start form with native snapshot feedback and an owner-bound deferred Reset action. EXERCISE checks explicit-notify feedback and reset without simulating physical time input or scheduling anything.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/time-picker.lisp --eval '(wxlambda-time-picker:start)'")) ("Source" (:code-block "lisp" ";;; Time-of-day form values, not a scheduling or timezone API.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-time-picker (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-time-picker)
(defun time-label (time)
  (if time (format nil \"Start time: ~2,'0D:~2,'0D:~2,'0D\" (first time) (second time) (third time)) \"No supported event time\"))
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Start time λ\" :width 440 :height 230))
         (panel (wxlambda:make-panel frame))
         (picker (wxlambda:make-time-picker panel :time '(9 30 0)))
         (feedback (wxlambda:make-label panel :label (time-label (wxlambda:clock-time picker))))
         (reset (wxlambda:make-button panel :label \"Reset start time\")))
    (wxlambda:make-column panel)
    (dolist (child (list picker feedback reset)) (wxlambda:add-child panel child :border 8))
    (setf (wxlambda:tooltip-text picker) \"Choose a start time; no timezone or date is attached.\")
    (wxlambda:bind-event picker :time-change
      (lambda (event) (setf (wxlambda:label-text feedback) (time-label (wxlambda:event-time event)))))
    (wxlambda:on-click reset
      (lambda () (wxlambda:defer-ui-action
                   (lambda () (setf (wxlambda:clock-time picker :notify t) '(9 30 0))) :owner picker)))
    (values frame picker feedback reset)))
(defun exercise ()
  (multiple-value-bind (frame picker feedback reset) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:clock-time picker :notify t) '(23 59 59))
           (assert (string= \"Start time: 23:59:59\" (wxlambda:label-text feedback)))
           (wxlambda:queue-click reset)
           (loop repeat 30 until (equal '(9 30 0) (wxlambda:clock-time picker)) do (wxlambda:process-events))
           (assert (equal '(9 30 0) (wxlambda:clock-time picker)))
           (assert (string= \"Start time: 09:30:00\" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/toggle-buttons.lisp" :names ("examples/toggle-buttons.lisp" "toggle-buttons") :kind :example :kind-name "Example" :summary "Persistent preview option with native toggle-button checked snapshots and feedback; EXERCISE verifies silent/explicit notify behavior without hardware input." :sections (("Usage" (:p "Persistent preview option with native toggle-button checked snapshots and feedback; EXERCISE verifies silent/explicit notify behavior without hardware input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/toggle-buttons.lisp --eval '(wxlambda-toggle-buttons:start)'")) ("Source" (:code-block "lisp" ";;; Persistent preview option. START interactive; EXERCISE uses notified writes.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-toggle-buttons (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-toggle-buttons)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Preview option\" :width 400 :height 220))
         (panel (wxlambda:make-panel frame))
         (toggle (wxlambda:make-toggle-button panel :label \"Live preview\" :checked t))
         (status (wxlambda:make-label panel :label \"Preview enabled\")) (changes 0))
    (wxlambda:bind-event toggle :toggle-button-change
      (lambda (event)
        (incf changes)
        (setf (wxlambda:label-text status)
              (if (wxlambda:event-checked-p event) \"Preview enabled\" \"Preview paused\"))))
    (wxlambda:make-column panel)
    (dolist (child (list toggle status)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame toggle status (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame toggle status changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (wxlambda:checked-p toggle))
           (setf (wxlambda:checked-p toggle) nil)
           (assert (zerop (funcall changes)))
           (setf (wxlambda:checked-p toggle :notify t) nil)
           (assert (string= \"Preview paused\" (wxlambda:label-text status)))
           (setf (wxlambda:checked-p toggle :notify t) t)
           (assert (= 2 (funcall changes)))
           (assert (string= \"Preview enabled\" (wxlambda:label-text status))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/tooltips.lisp" :names ("examples/tooltips.lisp" "tooltips") :kind :example :kind-name "Example" :summary "Form name guidance with a deferred Toggle guidance action. EXERCISE verifies Unicode text and remove/restore via queued commands without simulating hover or asserting popup presentation." :sections (("Usage" (:p "Form name guidance with a deferred Toggle guidance action. EXERCISE verifies Unicode text and remove/restore via queued commands without simulating hover or asserting popup presentation.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/tooltips.lisp --eval '(wxlambda-tooltips:start)'")) ("Source" (:code-block "lisp" ";;; Contextual form guidance with owner-bound deferred tooltip changes.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-tooltips (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-tooltips)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Form guidance λ\" :width 440 :height 230))
         (panel (wxlambda:make-panel frame))
         (name (wxlambda:make-text panel :value \"\"))
         (button (wxlambda:make-button panel :label \"Toggle guidance\"))
         (guidance \"Enter your display name — λ is welcome.\"))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel (wxlambda:make-label panel :label \"Display name\") :border 8)
    (wxlambda:add-child panel name :border 8)
    (wxlambda:add-child panel button :border 8)
    (setf (wxlambda:tooltip-text name) guidance
          (wxlambda:tooltip-text button) \"Show or remove the name field's hover guidance.\")
    (wxlambda:on-click button
      (lambda ()
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:tooltip-text name)
                           (unless (wxlambda:tooltip-text name) guidance))) :owner name)))
    (values frame name button)))
(defun exercise ()
  (multiple-value-bind (frame name button) (build-window)
    (unwind-protect
         (progn
           (assert (search \"λ\" (wxlambda:tooltip-text name)))
           (wxlambda:show-window frame) (wxlambda:process-events)
           (wxlambda:queue-click button)
           (loop repeat 30 while (wxlambda:tooltip-text name) do (wxlambda:process-events))
           (assert (null (wxlambda:tooltip-text name)))
           (wxlambda:queue-click button)
           (loop repeat 30 until (wxlambda:tooltip-text name) do (wxlambda:process-events))
           (assert (search \"λ\" (wxlambda:tooltip-text name))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
"))))
(:entry "example/examples/tree-navigation.lisp" :names ("examples/tree-navigation.lisp" "tree-navigation") :kind :example :kind-name "Example" :summary "Visible-root single-selection managed tree, canonical item views, expand/collapse, native navigation veto and append/delete buttons. Bounded EXERCISE checks token ownership/subtree invalidation without physical input." :sections (("Usage" (:p "Visible-root single-selection managed tree, canonical item views, expand/collapse, native navigation veto and append/delete buttons. Bounded EXERCISE checks token ownership/subtree invalidation without physical input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/tree-navigation.lisp --eval '(wxlambda:with-application () (wxlambda-tree-navigation:exercise))'")) ("Source" (:code-block "lisp" ";;; START is interactive; EXERCISE runs within an active application session.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-tree-navigation (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-tree-navigation)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Managed tree navigation\" :width 620 :height 460))
         (panel (wxlambda:make-panel frame)) (tree (wxlambda:make-tree-control panel))
         (root (wxlambda:add-tree-root tree \"Workspace λ\"))
         (folder (wxlambda:append-tree-item root \"Documents\"))
         (file (wxlambda:append-tree-item folder \"日本語 😀.txt\"))
         (allow (wxlambda:make-checkbox panel :label \"Allow navigation\" :checked t))
         (add (wxlambda:make-button panel :label \"Append child to selection/root\"))
         (remove (wxlambda:make-button panel :label \"Delete selected subtree\"))
         (status (wxlambda:make-label panel :label \"Select an item\")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame panel :proportion 1 :border 0)
    (wxlambda:make-column panel)
    (wxlambda:add-child panel tree :proportion 1)
    (dolist (child (list allow add remove status)) (wxlambda:add-child panel child))
    (setf (wxlambda:tree-item-expanded-p root) t (wxlambda:tree-item-expanded-p folder) t)
    (wxlambda:bind-event tree :tree-selection-changing
      (lambda (event context)
        (declare (ignore event))
        (unless (wxlambda:checked-p allow) (setf (wxlambda:event-vetoed-p context) t)))
      :with-context t)
    (wxlambda:bind-event tree :tree-selection-changed
      (lambda (event)
        (let ((item (wxlambda:event-tree-item event)))
          (setf (wxlambda:label-text status) (if item (wxlambda:tree-item-text item) \"No selection\")))))
    ;; Button callbacks run outside tree selection callbacks, so structural edits are safe.
    (wxlambda:on-click add
      (lambda ()
        (let* ((parent (or (wxlambda:selection tree) (wxlambda:tree-root tree)))
               (item (if parent (wxlambda:append-tree-item parent \"New item\")
                         (wxlambda:add-tree-root tree \"Workspace λ\"))))
          (when parent (setf (wxlambda:tree-item-expanded-p parent) t))
          (setf (wxlambda:selection tree :notify t) item))))
    (wxlambda:on-click remove
      (lambda ()
        (let ((item (wxlambda:selection tree)))
          (when item (wxlambda:delete-tree-item item)
                (setf (wxlambda:label-text status) \"Subtree deleted\")))))
    (values frame tree root folder file allow)))

(defun exercise ()
  (multiple-value-bind (frame tree root folder file allow) (build-window)
    (unwind-protect
         (progn
           (assert (eq root (wxlambda:tree-root tree)))
           (assert (eq folder (first (wxlambda:tree-item-children root))))
           (assert (eq folder (wxlambda:tree-item-parent file)))
           (setf (wxlambda:tree-item-text file) \"Edited 日本語 😀\")
           (assert (string= \"Edited 日本語 😀\" (wxlambda:tree-item-text file)))
           (setf (wxlambda:selection tree) root (wxlambda:checked-p allow) nil)
           (setf (wxlambda:selection tree :notify t) file)
           (assert (eq root (wxlambda:selection tree)))
           (setf (wxlambda:checked-p allow) t)
           (setf (wxlambda:selection tree :notify t) file)
           (assert (eq file (wxlambda:selection tree)))
           (wxlambda:delete-tree-item folder)
           (assert (not (wxlambda:tree-item-alive-p folder)))
           (assert (not (wxlambda:tree-item-alive-p file)))
           (assert (wxlambda:tree-item-alive-p root))
           (assert (eq root (wxlambda:selection tree)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame tree) (build-window)
      (declare (ignore tree))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
"))))
(:entry "example/examples/webview.lisp" :names ("examples/webview.lisp" "webview") :kind :example :kind-name "Example" :summary "Interactive trusted-development HTML/JavaScript WebView with asynchronous script tickets and JSON message bridge; no external network required by deterministic exercise. Known native popup/dialog/upload paths are suppressed; this is not a general security sandbox." :sections (("Usage" (:p "Interactive trusted-development HTML/JavaScript WebView with asynchronous script tickets and JSON message bridge; no external network required by deterministic exercise. Known native popup/dialog/upload paths are suppressed; this is not a general security sandbox.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/webview.lisp --eval '(wxlambda-webview:start)'")) ("Source" (:code-block "lisp" "(require :asdf)
(asdf:load-asd (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-webview (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-webview)
(defparameter *page*
  \"<!doctype html><meta charset='utf-8'><title>Development λ</title>
<style>body{font:18px system-ui;background:#172033;color:#e4edf8;padding:24px}button{padding:12px}</style>
<h1>Editor web preview λ</h1><p id='output'>JavaScript is enabled.</p>
<button onclick=\\\"window.webkit.messageHandlers.wxlambda.postMessage({type:'click',value:document.title})\\\">Send a result to Lisp</button>
<script>window.webkit.messageHandlers.wxlambda.postMessage({type:'ready',value:'λ 😀'});</script>\")
(defun wait-for (predicate)
  ;; Keep native dispatch active while waiting for asynchronous application readiness.
  (unless (funcall predicate)
    (let ((deadline (+ (get-internal-real-time) (* 12 internal-time-units-per-second)))
          (timer nil))
      (unwind-protect
           (progn
             (setf timer (wxlambda:start-ui-timer
               (lambda ()
                 (cond ((funcall predicate) (wxlambda:stop))
                       ((> (get-internal-real-time) deadline) (error \"Timed out waiting for WebKit\")))) 10))
             (wxlambda:run))
        (when timer (wxlambda:cancel-ui-timer timer)))))
  (assert (funcall predicate)))
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title \"Editor web development\" :width 900 :height 650))
         (panel (wxlambda:make-panel frame))
         (code (wxlambda:make-text panel :multiline t
                 :value \"document.getElementById('output').textContent = 'Changed from Lisp λ'; ({passed:true, count:3})\"))
         (run (wxlambda:make-button panel :label \"Run JavaScript\"))
         (view (wxlambda:make-web-view panel))
         (result (wxlambda:make-text panel :multiline t :editable-p nil)))
    (wxlambda:make-column panel) (wxlambda:add-child panel code :expand t)
    (wxlambda:add-child panel run) (wxlambda:add-child panel view :proportion 1 :expand t)
    (wxlambda:add-child panel result :expand t)
    (wxlambda:on-click run
      (lambda () (wxlambda:defer-ui-action
        (lambda () (wxlambda:run-web-script view (wxlambda:text code))) :owner view)))
    (dolist (kind '(:web-message :web-script-result :web-error))
      (wxlambda:bind-event view kind
        (lambda (event) (setf (wxlambda:text result)
          (format nil \"~A request=~D success=~D~%~A\"
            (wxlambda:event-kind event) (wxlambda:event-extra-long event)
            (wxlambda:event-integer event) (wxlambda:event-text event))))))
    (wxlambda:set-web-page view *page*) (wxlambda:show-window frame)
    (values frame view)))
(defun exercise ()
  (multiple-value-bind (frame view) (build-window)
    (let ((messages nil) (results nil) (loaded nil))
      (unwind-protect
           (progn
             (wxlambda:bind-event view :web-message (lambda (event) (push event messages)))
             (wxlambda:bind-event view :web-loaded (lambda (event) (declare (ignore event))
               (setf loaded t)))
             (wxlambda:bind-event view :web-script-result (lambda (event) (push event results)))
             (wait-for (lambda () (and loaded messages (string= \"Development λ\" (wxlambda:web-view-title view)) (not (wxlambda:web-view-busy-p view)))))
             (let ((ticket (wxlambda:run-web-script view \"({sum:2+3,unicode:'λ 😀'})\")))
               (wait-for (lambda () (find ticket results :key #'wxlambda:event-extra-long)))
               (let ((event (find ticket results :key #'wxlambda:event-extra-long)))
                 (assert (= 1 (wxlambda:event-integer event)))
                 (assert (search \"sum\" (wxlambda:event-text event)))
                 (assert (search \"5\" (wxlambda:event-text event)))))
             (assert (search \"ready\" (wxlambda:event-text (first messages))))
             t)
        (wxlambda:destroy-window frame)))))
(defun start () (wxlambda:with-application () (build-window) (wxlambda:run)))
"))))
(:entry "example/examples/window-handler-stacks.lisp" :names ("examples/window-handler-stacks.lisp" "window-handler-stacks") :kind :example :kind-name "Example" :summary "Push managed standalone handlers on a window, compare explicit stack-aware and generic bypass routing, then pop/remove without transferring native ownership." :sections (("Usage" (:p "Push managed standalone handlers on a window, compare explicit stack-aware and generic bypass routing, then pop/remove without transferring native ownership.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-handler-stacks.lisp --eval '(wxlambda-window-handler-stacks:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-window-handler-stacks:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-window-handler-stacks (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-window-handler-stacks)
(defun exercise ()
  (wxlambda:register-event-type :stack-message :family :command)
  (let* ((frame (wxlambda:make-frame)) (handler (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :stack-message :text \"Window stack\"))
         (calls 0)
         (binding (wxlambda:bind-event handler :stack-message
                    (lambda (event) (assert (eq handler (wxlambda:event-source event))) (incf calls)))))
    (unwind-protect
         (progn
           (wxlambda:push-event-handler frame handler)
           (assert (eq handler (wxlambda:window-event-handler frame)))
           (wxlambda:process-window-event frame message)
           (assert (= 1 calls))
           (assert (eq handler (wxlambda:pop-event-handler frame)))
           (assert (eq frame (wxlambda:window-event-handler frame)))
           (wxlambda:push-event-handler frame handler)
           (wxlambda:destroy-window frame)
           (wxlambda:process-events)
           (assert (wxlambda:handler-alive-p handler))
           (assert (wxlambda:handler-unlinked-p handler)))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler handler)
      (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame)))))
(defun start () (wxlambda:with-application () (exercise)))
"))))
(:entry "example/examples/window-metadata.lisp" :names ("examples/window-metadata.lisp" "window-metadata") :kind :example :kind-name "Example" :summary "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup." :sections (("Usage" (:p "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp --eval '(wxlambda-window-metadata:start)'")) ("Source" (:code-block "lisp" ";;; Load this file and call (wxlambda-window-metadata:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-metadata
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-metadata)

(defclass tracking-frame (wxlambda:frame)
  ((title-updates :initform 0 :accessor title-updates)))

(defmethod (setf wxlambda:frame-title) :after (value (frame tracking-frame))
  (declare (ignore value))
  (incf (title-updates frame)))

(defun open-window ()
  (let* ((frame (make-instance 'tracking-frame :title \"Window metadata\"))
         (panel (wxlambda:make-panel frame))
         (button (wxlambda:make-button panel :label \"Rename window and update title\"))
         (changes 0))
    (setf (wxlambda:window-name frame) \"metadata-example\")
    (wxlambda:make-column panel)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda ()
        (incf changes)
        (setf (wxlambda:window-name frame) (format nil \"metadata-~D\" changes))
        (setf (wxlambda:frame-title frame) (format nil \"Updated ~D — λ 日本語 😀\" changes))))
    (wxlambda:show-window frame)
    (values frame button)))

(defun exercise ()
  \"Exercise the same callback as the interactive example, then clean up.\"
  (multiple-value-bind (frame button) (open-window)
    (assert (string= \"metadata-example\" (wxlambda:window-name frame)))
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (string= \"metadata-1\" (wxlambda:window-name frame)))
    (assert (string= \"Updated 1 — λ 日本語 😀\" (wxlambda:frame-title frame)))
    (assert (= 1 (title-updates frame)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
(:entry "example/examples/window-state.lisp" :names ("examples/window-state.lisp" "window-state") :kind :example :kind-name "Example" :summary "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input." :sections (("Usage" (:p "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp --eval '(wxlambda-window-state:start)'")) ("Source" (:code-block "lisp" ";;; Reusable state example. Run (wxlambda-window-state:start), or use the
;;; noninteractive exercise called by tests/window-state.lisp.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-state
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-state)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Window state\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hide/show and disable/enable me\"))
         (visibility (wxlambda:make-button panel :label \"Toggle text visibility\"))
         (input (wxlambda:make-button panel :label \"Toggle text input\")))
    (wxlambda:make-column panel)
    (dolist (child (list text visibility input)) (wxlambda:add-child panel child))
    (wxlambda:on-click visibility
      (lambda ()
        (wxlambda:show-window text (not (wxlambda:shown-p text)))
        (wxlambda:layout-window panel)))
    (wxlambda:on-click input
      (lambda () (wxlambda:enable-window text (not (wxlambda:enabled-p text)))))
    (wxlambda:show-window frame)
    (values frame panel text visibility input)))

(defun exercise ()
  \"Run the example's actual callbacks, then release handlers and close it.\"
  (multiple-value-bind (frame panel text visibility input) (open-window)
    (declare (ignore panel))
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (not (wxlambda:shown-p text)))
    (assert (not (wxlambda:enabled-p text)))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:off-click visibility)
    (wxlambda:off-click input)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
