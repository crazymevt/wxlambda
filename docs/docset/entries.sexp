) (((:code "wx/sound.h (phase-c6.md#wxsoundh)")) ("0") ("0") ("15") ("0")) (((:code "wx/stc/stc.h (phase-c6.md#wxstcstch)")) ("0") ("0") ("3090") ("0")) (((:code "wx/webview.h (phase-c6.md#wxwebviewh)")) ("0") ("0") ("138") ("0")) (((:code "wx/webviewarchivehandler.h (phase-c6.md#wxwebviewarchivehandlerh)")) ("0") ("0") ("3") ("0")) (((:code "wx/webviewfshandler.h (phase-c6.md#wxwebviewfshandlerh)")) ("0") ("0") ("3") ("0")) (((:code "wx/xml/xml.h (phase-c6.md#wxxmlxmlh)")) ("0") ("0") ("90") ("0")) (((:code "wx/xrc/xh_sizer.h (phase-c6.md#wxxrcxh_sizerh)")) ("0") ("0") ("6") ("0")) (((:code "wx/xrc/xmlres.h (phase-c6.md#wxxrcxmlresh)")) ("0") ("0") ("102") ("0")))) (:heading 3 "C7: Platform extensions and remaining portability APIs") (:table :header (("Header") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "wx/dde.h (phase-c7.md#wxddeh)")) ("0") ("0") ("37") ("0")) (((:code "wx/dialup.h (phase-c7.md#wxdialuph)")) ("0") ("0") ("22") ("0")) (((:code "wx/joystick.h (phase-c7.md#wxjoystickh)")) ("0") ("0") ("45") ("0")) (((:code "wx/msw/ole/activex.h (phase-c7.md#wxmswoleactivexh)")) ("0") ("0") ("11") ("0")) (((:code "wx/msw/ole/automtn.h (phase-c7.md#wxmswoleautomtnh)")) ("0") ("0") ("22") ("0")) (((:code "wx/msw/ole/oleutils.h (phase-c7.md#wxmswoleoleutilsh)")) ("0") ("0") ("30") ("1")) (((:code "wx/msw/ole/safearray.h (phase-c7.md#wxmswolesafearrayh)")) ("0") ("0") ("21") ("1")) (((:code "wx/msw/regconf.h (phase-c7.md#wxmswregconfh)")) ("0") ("0") ("2") ("0")) (((:code "wx/msw/registry.h (phase-c7.md#wxmswregistryh)")) ("0") ("0") ("58") ("1")) (((:code "wx/nativewin.h (phase-c7.md#wxnativewinh)")) ("0") ("0") ("5") ("0")) (((:code "wx/power.h (phase-c7.md#wxpowerh)")) ("0") ("0") ("26") ("0")))) (:heading 2 "Regenerate and verify") (:p "Use the pinned release interface directory; verify its hashes against " (:code "manifest.json (manifest.json)") ". Update status.json before regeneration, rather than editing generated counts or checkboxes. Example commands:") (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
