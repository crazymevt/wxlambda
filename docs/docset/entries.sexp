(:entry "api/off-toggle" :names ("off-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-toggle checkbox)")) ("Arguments" (:p "CHECKBOX is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/on-click" :names ("on-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-click button function &key with-event)")) ("Arguments" (:p "BUTTON and FUNCTION; WITH-EVENT true makes FUNCTION accept one EVENT; otherwise no arguments.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-selection" :names ("on-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-selection choice function)")) ("Arguments" (:p "CHOICE and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-text-change" :names ("on-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-text-change control function)")) ("Arguments" (:p "CONTROL (wxTextCtrl) and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-toggle" :names ("on-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-toggle checkbox function)")) ("Arguments" (:p "CHECKBOX and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/panel" :names ("panel") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a child wxPanel." :sections (("Syntax" (:code-block "lisp" "wxlambda:panel")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for a child wxPanel.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxPanel (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:panel :parent parent)") (:p "PARENT is a live window and is required. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/pending-events-p" :names ("pending-events-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks." :sections (("Syntax" (:code-block "lisp" "(wxlambda:pending-events-p )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "T if wxWidgets has queued pending events, otherwise NIL.")) ("Description" (:p "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances.")) ("wxWidgets" (:p "wxAppConsole::HasPendingEvents (wxWidgets 3.2.12 baseline)."))))
(:entry "api/process-events" :names ("process-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-events )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL.")) ("Description" (:p "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling.")) ("Errors and scope" (:p "Requires an active main-thread GUI session. Forbidden inside RUN, either event pump or any native-to-Lisp callback (NATIVE-ERROR), and inside the application REPL debugger (Lisp error). Existing synchronous notifying setters remain supported.")) ("wxWidgets" (:p "wxAppConsole::Yield(true) and ProcessIdle"))))
(:entry "api/process-pending-events" :names ("process-pending-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-pending-events )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL after successful dispatch.")) ("Description" (:p "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances. Forbidden inside RUN, either pump or any native-to-Lisp callback (NATIVE-ERROR), and inside the application REPL debugger (Lisp error). Dispatch guards recover on callback failure. Synchronous notifying setters remain supported.")) ("wxWidgets" (:p "wxAppConsole::ProcessPendingEvents (wxWidgets 3.2.12 baseline)."))))
(:entry "api/pulse-gauge" :names ("pulse-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode." :sections (("Syntax" (:code-block "lisp" "(wxlambda:pulse-gauge gauge)")) ("Arguments" (:p "GAUGE is a live gauge.")) ("Returns" (:p "The supplied gauge.")) ("Description" (:p "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::Pulse (wxWidgets 3.2.12 baseline)."))))
(:entry "api/queue-click" :names ("queue-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement." :sections (("Syntax" (:code-block "lisp" "(wxlambda:queue-click button)")) ("Arguments" (:p "BUTTON is a live button.")) ("Returns" (:p "T.")) ("Description" (:p "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxPostEvent / wxEVT_BUTTON"))))
(:entry "api/return-to-application-repl" :names ("return-to-application-repl") :kind :restart :kind-name "Restart" :package "WXLAMBDA" :summary "Abandon the failing REPL evaluation or callback operation using the active debugger restart." :sections (("Syntax" (:code-block "lisp" "(invoke-restart 'wxlambda:return-to-application-repl)")) ("Arguments" (:p "No arguments; invoke this restart from the application REPL debugger.")) ("Returns" (:p "Control returns to the application REPL.")) ("Description" (:p "Abandon the failing REPL evaluation or callback operation using the active debugger restart.")) ("Errors and scope" (:p "This is an exported restart name, not a callable function. Available only while the application REPL debugger establishes it.")) ("wxWidgets" (:p "Lisp-only debugger recovery."))))
(:entry "api/run" :names ("run") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code." :sections (("Syntax" (:code-block "lisp" "(wxlambda:run )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL after the event loop returns.")) ("Description" (:p "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code.")) ("Errors and scope" (:p "Requires an active main-thread GUI session and at least one frame. Forbidden inside RUN, either pump, any native-to-Lisp callback, and the application REPL. Native failures and callback conditions propagate.")) ("wxWidgets" (:p "wxAppConsole::OnRun"))))
(:entry "api/selection" :names ("selection" "(setf selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read selected index; NIL represents native no selection." :sections (("Syntax" (:code-block "lisp" "(wxlambda:selection choice &key notify)")) ("Arguments" (:p "CHOICE is a live dropdown choice. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "Zero-based index or NIL.")) ("Description" (:p "Read selected index; NIL represents native no selection.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxChoice::GetSelection")) ("SETF" (:code-block "lisp" "(setf (wxlambda:selection choice :notify notify) new-value)") (:p "Store an in-range zero-based index or NIL. :NOTIFY T emits a synchronous selection event, including unchanged assignments. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :sections (("Syntax" (:code-block "lisp" "(wxlambda:show-window window &optional (show t))")) ("Arguments" (:p "WINDOW is live; optional SHOW is a generalized boolean (default T).")) ("Returns" (:p "WINDOW, then a boolean indicating whether its shown state changed.")) ("Description" (:p "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Show(bool) / Hide() equivalent (wxWidgets 3.2)."))))
(:entry "api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :sections (("Syntax" (:code-block "lisp" "(wxlambda:shown-p window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::IsShown (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:shown-p window) new-value)") (:p "Assign the own shown flag; return the supplied value and a second native changed-state flag. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stop )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL in the application REPL; T after stopping a native RUN loop.")) ("Description" (:p "Leave RUN or end the application REPL. Stopping the loop does not destroy windows.")) ("Errors and scope" (:p "Outside the application REPL, a running native event loop is required; otherwise NATIVE-ERROR.")) ("wxWidgets" (:p "wxAppConsole::ExitMainLoop"))))
(:entry "api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text control &key notify)")) ("Arguments" (:p "CONTROL is a live text control. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the current UTF-8 text; returned storage survives later native calls.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTextEntry::GetValue (wxTextCtrl only)")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text control :notify notify) new-value)") (:p "Text replacement is silent by default. :NOTIFY T emits text-change events synchronously; callback conditions return to the writer caller. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:text-control")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxTextCtrl with text-change handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxTextCtrl (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:text-control :parent parent :value \"\")") (:p "PARENT is required; VALUE defaults to an empty string. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Base CLOS class of the bound window wrappers; common window operations specialize on it." :sections (("Syntax" (:code-block "lisp" "wxlambda:window")) ("Arguments" (:p "Superclass: STANDARD-OBJECT.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "Base CLOS class of the bound window wrappers; common window operations specialize on it.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxWindow (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:frame)") (:p "WINDOW is abstract. Instantiate a concrete class or its subclass; mixins are allowed, but a class must represent exactly one native widget kind."))))
(:entry "api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-name window)")) ("Arguments" (:p "WINDOW is any live bound window or control.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetName (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:window-name window) new-value)") (:p "Copy the logical name, preserving Unicode, empty strings and embedded NULs. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-position window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: X and Y.")) ("Description" (:p "Query position relative to parent; frame coordinates are screen-relative.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetPosition"))))
(:entry "api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-size window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: WIDTH and HEIGHT.")) ("Description" (:p "Query outer window dimensions in wxWidgets coordinates.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetSize"))))
(:entry "api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-application () &body body)")) ("Arguments" (:p "Empty options list, followed by BODY forms.")) ("Returns" (:p "The values of the last BODY form.")) ("Description" (:p "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process.")) ("wxWidgets" (:p "wxEntryStart / wxEntryCleanup"))))
(:entry "api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-repl-application (&key (input '*standard-input*)
                                     (output '*standard-output*)
                                     (on-error :debug)) &body body)")) ("Arguments" (:p "Options INPUT, OUTPUT and ON-ERROR (:DEBUG or :REPORT), then BODY setup forms.")) ("Returns" (:p "NIL when the cooperative REPL exits.")) ("Description" (:p "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events.")) ("Errors and scope" (:p "Main-thread, one-session contract. Setup conditions propagate. :DEBUG preserves restarts; :REPORT prints recovery diagnostics.")) ("wxWidgets" (:p "wxApp event polling; SBCL/CCL terminal integration."))))
(:entry "guide/README.md" :names ("README.md" "README") :kind :guide :kind-name "Guide" :summary "README.md" :sections (("Guide" (:heading 1 "wxlambda") (:p "Common Lisp bindings for wxWidgets, using CFFI and a small C++ bridge with a versioned C ABI. This is an application lifecycle prototype, not a complete wxWidgets binding.") (:p "Implemented: application startup/shutdown, frames, panels, buttons, editable text, static labels, two-state checkboxes, dropdown choices, progress gauges, row/column layouts, spacers, text/state access, removable click/text/toggle/selection handlers, copied event payloads, queued clicks, and window visibility/input state. Lisp objects wrap checked integer handles; native pointers never escape the bridge.") (:p "First-release lifecycle limits: " (:b "one GUI session per process") ". Closing a window does not release its registered Lisp handlers; unbind them before destruction, or they remain rooted until session cleanup. Restart Lisp for a new GUI session.") (:p "The " (:ref "guide/docs/CLOS-API.md" "CLOS widget API") " provides direct native-backed " (:code "make-instance") " construction, subclass initargs/defaults/hooks and ten generic " (:code "setf") " accessors. The " (:code "make-*") " conveniences forward to " (:code "make-instance") " with " (:code ":class") " support. The ground-up API has 39 named generic widget operations plus ten generic property writers. Native C++ virtual callbacks remain separate work.") (:p "Progress controls support range/value properties, orientation and indeterminate pulsing; see " (:ref "guide/docs/GAUGE.md" "the gauge guide") " and runnable " (:ref "example/examples/gauge.lisp" "example") ".") (:p "The " (:ref "guide/docs/APPLICATION-EVENTS.md" "application event guide") " explains native main-loop and pending-event queries, explicit queued-event dispatch and the callback reentrancy boundary.") (:heading 2 "Documentation and examples") (:p "The " (:ref "guide/docs/DOCSET.md" "Cadre docset") " includes the public API reference, project guides and example sources in one searchable artifact under " (:code "docs/docset/") ". Use " (:code "python3 tools/docset.py build") ", " (:code "check") ", or " (:code "install") "; the docset library checkout is a build-tool dependency, separate from the GUI runtime. Read " (:ref "guide/docs/WINDOW-STATE.md" "window state") " for the first coverage implementation slice: " (:code "show-window") " now accepts an optional boolean for showing/hiding, while " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " query/control visibility and input. The runnable " (:ref "example/examples/window-state.lisp" "window-state example") " demonstrates these operations through button callbacks. The next slice adds " (:ref "guide/docs/WINDOW-METADATA.md" "window names and frame titles") ": " (:code "window-name") " and " (:code "frame-title") " with their generic " (:code "setf") " writers, with a " (:ref "example/examples/window-metadata.lisp" "metadata callback example") " and copied Unicode string results.") (:heading 2 "Build") (:p "Requirements: a C++17 compiler, CMake 3.16+, wxWidgets 3.2+, Common Lisp, ASDF, and CFFI. Install CFFI using your preferred dependency manager, for example " (:code "(ql:quickload :cffi)") " with Quicklisp.") (:p "On macOS with Homebrew:") (:code-block "sh" "brew install cmake wxwidgets@3.2
cmake -S . -B build \\
  -DwxWidgets_CONFIG_EXECUTABLE=\"$(brew --prefix wxwidgets@3.2)/bin/wx-config-3.2\"
cmake --build build") (:p "On Linux with wxWidgets development packages and " (:code "wx-config") " on PATH:") (:code-block "sh" "cmake -S . -B build
cmake --build build") (:p "Windows uses the same CMake project. Supply a wxWidgets installation compatible with your compiler using CMake's FindwxWidgets settings. Multi-configuration builds may put " (:code "wxlambda.dll") " under " (:code "build/Release/") "; load it explicitly before starting the application with " (:code "(wxlambda:load-native-library #P\"C:/path/to/wxlambda.dll\")") ". Dependent wxWidgets DLLs must also be discoverable by the OS loader.") (:p "The bridge normally loads from " (:code "build/") ", then falls back to the system library search path. The Lisp/native ABI version (currently 11) is checked on load; rebuild the bridge after updating the bindings. Installing the bridge with CMake does not install the ASDF system.") (:heading 2 "Run") (:p "From this directory, assuming Quicklisp is installed in " (:code "~/quicklisp") ":") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Or with Clozure CL:") (:code-block "sh" "ccl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Click the button to update the text; close the window to return to Lisp. Run each example in a fresh process: this prototype supports one application session per process.") (:p "For an existing image, load " (:code "wxlambda.asd") ", then " (:code "(asdf:load-system \"wxlambda\")") ". The basic API is:") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Hello\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hello, λ\"))
         (button (wxlambda:make-button panel :label \"Click\")))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda () (setf (wxlambda:text text) \"Hello from Lisp!\")))
    (wxlambda:show-window frame)
    (wxlambda:run)))") (:heading 2 "Labels and checkboxes") (:p (:code "make-label") " creates non-editable static text. " (:code "label-text") " returns an independent Lisp string and " (:code "(setf label-text)") " updates it. These accessors take a label created by " (:code "make-label") "; raw strings use wxWidgets' label/mnemonic syntax. After changing a label's preferred size, call " (:code "layout-window") " on its parent to reflow the layout.") (:p (:code "make-checkbox") " creates a two-state checkbox, unchecked by default. " (:code "checked-p") " returns " (:code "t") " or " (:code "nil") ". The " (:code ":checked") " constructor keyword and " (:code "(setf checked-p)") " accept generalized booleans: " (:code "nil") " means unchecked, any other value means checked. " (:code "(setf checked-p)") " returns the supplied value; the predicate reads it normalized to " (:code "t") " or " (:code "nil") "; a handler may change the live state again before the setter returns.") (:code-block "lisp" "(let ((caption (wxlambda:make-label panel :label \"Preferences\"))
      (box (wxlambda:make-checkbox panel :label \"Include a greeting\" :checked t)))
  (wxlambda:add-child panel caption)
  (wxlambda:add-child panel box :expand nil)
  (wxlambda:on-toggle box
    (lambda (event)
      (setf (wxlambda:label-text caption) (if (wxlambda:event-checked-p event) \"Greeting enabled\" \"Greeting disabled\"))
      (wxlambda:layout-window panel)))
  (setf (wxlambda:checked-p box) nil)            ; silent
  (setf (wxlambda:checked-p box :notify t) t)    ; synchronous toggle event
  (wxlambda:off-toggle box))") (:p (:code "on-toggle") " takes a function accepting one event, with kind " (:code ":toggle") ", the original checkbox as its source, and a boolean " (:code "event-checked-p") " snapshot. Native user interaction emits events. " (:code "(setf checked-p)") " is silent by default; " (:code ":notify t") " emits one synchronous event, including when the value is unchanged. The snapshot survives nested changes to the control and later window destruction. Replacing a handler releases its registered closure; " (:code "off-toggle") " releases it and is idempotent for a live checkbox, including from inside the handler. Setter errors follow the same recoverable boundary as text-change handlers.") (:p "Run " (:ref "example/examples/form.lisp" "examples/form.lisp") " for a form using labels, text input, a checkbox, a greeting-style dropdown, row/column layouts, and submit/reopen buttons:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp") (:p "The reusable application lives in " (:code "examples/form-app.lisp") ". For live development, load that file and evaluate " (:code "(wxlambda-form:start-live)") " from a terminal REPL:") (:code-block "lisp" "(load \"examples/form-app.lisp\")
(wxlambda-form:start-live)
;; Evaluate these inside the application REPL:
(setf (wxlambda:text wxlambda-form:*name* :notify t) \"Ada λ\")
(setf (wxlambda:selection wxlambda-form:*style* :notify t) 1)
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action
  (lambda () (setf (wxlambda:label-text wxlambda-form:*status*) \"Custom submit\")))
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action) ; restore the named SUBMIT-FORM action
(wxlambda-form:close-window)      ; unbind every handler before destruction
(wxlambda-form:open-window)       ; recreate with retained input values
(wxlambda:stop)") (:p "The “Reopen form” button performs the same explicit unbinding and recreation within a GUI callback. The default submit action resolves " (:code "submit-form") " by name, so redefining that function also takes effect live. The application uses public bindings throughout; no new native operations were needed. It retains the one-session-per-process limit. If the user closes the native frame before explicit unbinding, its stale handles cannot release the registered closures; those remain rooted until session cleanup. Normal startup exits with the last window; the application REPL remains available after closing it.") (:heading 2 "Layout") (:p "Use " (:code "make-column") " for vertical layout and " (:code "make-row") " for horizontal layout. A window has one sizer. To nest orientations, create a child panel, give it its own row or column, then add that panel to its parent's layout. " (:code "add-child") " requires the child's native parent to be the layout's window.") (:code-block "lisp" "(wxlambda:make-row panel)
(wxlambda:add-child panel text :proportion 1 :border 0)
(wxlambda:add-spacer panel 12)
(wxlambda:add-child panel button :border 0 :expand nil :align :center)") (:p (:code "add-child") " accepts these layout options:") (:table :header (("Keyword") ("Default") ("Meaning")) :rows ((((:code ":proportion")) ((:code "0")) ("Nonnegative weight along the layout axis; zero keeps the item's preferred extent")) (((:code ":border")) ((:code "8")) ("Nonnegative spacing on each of the four sides")) (((:code ":expand")) ((:code "t")) ("Fill the available space across the layout axis")) (((:code ":align")) ((:code ":start")) ("With " (:code ":expand nil") ", place at " (:code ":start") ", " (:code ":center") ", or " (:code ":end") " across the axis")))) (:p "In a row, alignment controls vertical placement; in a column, it controls horizontal placement. " (:code ":expand t") " with " (:code ":align :center") " or " (:code ":end") " is rejected. Proportions and stretch allocation remain subject to native minimum sizes. The defaults preserve the original " (:code "add-child") " behavior.") (:p (:code "(add-spacer panel size)") " inserts fixed space along the layout axis. " (:code "(add-stretch panel :proportion 1)") " inserts flexible space with a positive weight, sharing available room with other proportional items. Both return the panel. Invalid sizes, proportions, parent relationships, and duplicate insertions signal errors before the sizer is modified.") (:p (:code "layout-window") " recomputes a window's layout. " (:code "add-child") ", " (:code "add-spacer") ", and " (:code "add-stretch") " also lay out their parent immediately. Layouts participate in wxWidgets' normal resize handling. " (:code "window-position") " returns X and Y as two values, relative to the parent's client area (screen coordinates for top-level frames). " (:code "window-size") " returns outer width and height as two values. Dimensions and spacing use wxWidgets window coordinates, not framebuffer pixel counts; native minimum sizes and display scaling remain wxWidgets' responsibility.") (:p "Run " (:ref "example/examples/layout.lisp" "examples/layout.lisp") " to try nested rows and columns, a text field that takes the available width, and a footer with flexible spacing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp") (:heading 2 "Events") (:p "Existing " (:code "(on-click button (lambda () ...))") " handlers still take no arguments. Opt into an event argument with " (:code ":with-event t") ":") (:code-block "lisp" "(wxlambda:on-click button
  (lambda (event)
    (format t \"Clicked ~S~%\" (wxlambda:event-source event)))
  :with-event t)

(wxlambda:on-text-change text
  (lambda (event)
    (format t \"New text: ~A~%\" (wxlambda:event-text event))))

(setf (wxlambda:text text) \"Silent update\")
(setf (wxlambda:text text :notify t) \"Notify the handler\")
(wxlambda:off-text-change text)") (:p (:code "event-p") " recognizes event snapshots. Their read-only slots are exposed through:") (:table :header (("Accessor") ("Click event") ("Text-change event") ("Toggle event")) :rows ((((:code "event-kind")) ((:code ":click")) ((:code ":text-change")) ((:code ":toggle"))) (((:code "event-source")) ("Original button") ("Original text control") ("Original checkbox")) (((:code "event-text")) ((:code "nil")) ("Copied string, including " (:code "\"\"") " for empty text") ((:code "nil"))) (((:code "event-checked-p")) ((:code "nil")) ((:code "nil")) ("Copied " (:code "t") " or " (:code "nil") " state")))) (:p "Text-change handlers always take one event argument. Typing into the native text field emits events. " (:code "(setf text)") " stays silent by default to avoid update loops; " (:code ":notify t") " uses wxWidgets' notifying setter and may call the handler immediately, before the setter returns. Handlers can therefore run before " (:code "run") " starts.") (:p "The text payload describes that event, rather than a later read of the control. It remains valid across nested updates, handler unbinding, and window destruction. Event text is an independent Lisp string; callers can retain or modify their copy. The source wrapper remains available, but native operations on it fail after its window is destroyed. Event slots do not expose any borrowed native pointers.") (:p "Use " (:code "off-click") ", " (:code "off-text-change") ", or " (:code "off-toggle") " to release a handler. Registering again replaces and releases the previous closure. Both removals are idempotent for a live control of the correct type and may be called inside the handler itself.") (:heading 2 "Dropdown choices") (:code-block "lisp" "(let ((choice (wxlambda:make-choice panel
                :items '(\"Small\" \"Medium\" \"Large λ\") :selection 1)))
  (wxlambda:on-selection choice
    (lambda (event)
      (format t \"Selected index: ~S~%\" (wxlambda:event-selection event))))
  (setf (wxlambda:selection choice) 2)           ; silent
  (setf (wxlambda:selection choice :notify t) 0) ; synchronous notification
  (wxlambda:selection choice))               ; => 0") (:p (:code "make-choice") " copies a list of strings in the supplied order. Items are fixed for the life of the control. Selection indices are zero-based; " (:code "nil") " means no selection and is the default, including for a nonempty list. Empty lists are supported. An out-of-range index signals an error without changing the selection. The dropdown participates in layouts and parent ownership like other controls.") (:p "User selection and " (:code "(setf selection)") " with " (:code ":notify t") " deliver one " (:code ":selection") " event. " (:code "event-selection") " is an immutable index snapshot (or " (:code "nil") "), independent of later selection changes. Other event kinds have a " (:code "nil") " selection slot. " (:code "(setf selection)") " returns the requested index even if a handler changes it again; explicit notification also fires for an unchanged index. Handler errors are re-signaled at the setter boundary. " (:code "on-selection") " replaces the previous handler; " (:code "off-selection") " releases it and is idempotent for a live choice, including inside its callback. As with other strings, embedded NUL characters are unsupported.") (:heading 2 "Lifecycle contract") (:list (:item (:p (:code "with-application") " initializes the toolkit and cleans up on normal return or a"))) (:p "Lisp error. Call " (:code "run") " explicitly to enter the blocking GUI loop.") (:list (:item (:p "GUI calls must run on the main thread. On macOS, the SBCL command-line main"))) (:p "thread works directly. CCL uses a small implementation adapter to execute the application body on its initial process, synchronously. Caller thread dynamic bindings are not transferred by that adapter; establish needed bindings inside the application body. Starting from an SBCL worker/SLIME thread is rejected.") (:list (:item (:p "Native GUI code assumes masked floating-point traps. The SBCL adapter masks"))) (:p "them for the application session and restores the caller's state afterward.") (:list (:item (:p "Parents own their children. Closing/destroying a parent invalidates child"))) (:p "handles. Lisp wrapper objects may survive, but subsequent operations signal " (:code "native-error") ". Destruction can be deferred by wxWidgets until event processing.") (:list (:item (:p "Click handlers take zero arguments by default, or one event with"))) (:p (:code ":with-event t") ". Text-change and toggle handlers take one event. Handler replacement or explicit unbinding releases the registered closure. Queued clicks use the handler present when they are dispatched, so unbinding suppresses queued clicks and rebinding redirects them to the new handler. Closures for destroyed controls remain rooted until session cleanup unless explicitly unbound before destruction. There are no GC-driven native destructors.") (:list (:item (:p "Errors in synchronous text-change or toggle callbacks are saved until the notifying"))) (:p "setter returns to Lisp, then re-signaled so its caller can handle them without stopping the loop. Errors escaping the outer event callback request a loop stop and are re-signaled after the event loop returns. This also covers notifying setters called before the event loop starts. Errors escaping the application body trigger cleanup. Do not use " (:code "throw") ", " (:code "return-from") ", or other nonlocal exits across a callback's foreign boundary. Handle expected conditions inside the handler or around the notifying setter.") (:list (:item (:p (:code "text") " returns an independent Lisp string containing the current text;"))) (:p (:code "(setf text)") " updates it. Both use UTF-8. The native " (:code "wxl_get_text") " buffer is borrowed until the next getter call on that thread and is copied immediately by Lisp. A null pointer reports failure; an empty string is a successful empty value. Strings containing embedded NUL characters are not supported by this interface.") (:list (:item (:p "One GUI session per process; no application restart, background-thread GUI"))) (:p "scheduling, or virtual-method overrides yet.") (:heading 2 "REPL development") (:p "From a main-thread terminal Lisp REPL, initialize an application and enter its cooperative REPL (do not call " (:code "run") " in the setup body):") (:code-block "lisp" "(defvar *frame*)
(defvar *text*)
(wxlambda:with-repl-application ()
  (setf *frame* (wxlambda:make-frame :title \"Live development\")
        *text* (wxlambda:make-text *frame* :value \"Edit me\"))
  (wxlambda:show-window *frame*))") (:p "Then evaluate " (:code "(setf (wxlambda:text *text*) \"Updated live\")") ", redefine functions used by callbacks, or replace handlers without closing the application. Evaluate " (:code "(wxlambda:stop)") " or send EOF to leave and clean up. Closing the last window keeps this REPL available so you can create another frame in the same session. " (:code "run") " signals an error inside this REPL because events are already being processed. Errors enter the host Lisp debugger by default (" (:code ":on-error :debug") "). Evaluation conditions reach it before unwinding, preserving their local restarts. Choose " (:code "wxlambda:return-to-application-repl") " to abandon the current operation and keep the session, or use an available evaluation restart to resume the form. Debugger I/O uses the host's " (:code "*debug-io*") "; " (:code ":input") " and " (:code ":output") " configure only application REPL I/O. Setup-body errors propagate to the caller and clean up the session.") (:p "For scripts or a host with debugging disabled, use " (:code "(wxlambda:with-repl-application (:on-error :report) ...)") ". This prints the condition type/message and up to 20 backtrace frames on SBCL/CCL before abandoning the operation and continuing. Other Lisps report that a backtrace is unavailable; they are not validated platforms. The debugger policy respects the host's debugger hooks and batch-mode restrictions; it does not override them.") (:p "Callback errors are delivered to this policy only after returning safely from the native callback. Their original condition is preserved, but callback-local restarts and callback stack frames have already unwound. Debugger backtraces for these errors show their Lisp delivery boundary. This small REPL prints all returned values; it does not provide the host REPL's history variables or editor integration. Optional " (:code ":input") " and " (:code ":output") " streams default to standard I/O.") (:p "Events are pumped while waiting for input. Incomplete forms, long evaluations, and debugger stops pause GUI processing. " (:code "process-events") " is rejected while the application REPL's debugger is active; queued events resume after recovery. During long evaluations outside the debugger, call " (:code "process-events") " explicitly when useful. The main-thread requirements above still apply. Editor REPLs such as SLIME and SLY are unsupported by this helper; use a terminal Lisp REPL. In particular, SBCL worker-thread startup is rejected. After leaving, start a fresh Lisp process for another session.") (:p "For a complete live-development example, load " (:code "examples/live.lisp") " and call " (:code "(wxlambda-live:start)") " from a terminal REPL. While it runs, try:") (:code-block "lisp" "(setf (wxlambda:text wxlambda-live:*text*) \"Changed live\")
(defun wxlambda-live:clicked ()
  (setf (wxlambda:text wxlambda-live:*text*) \"New callback implementation\"))
(wxlambda:queue-click wxlambda-live:*button*)
(wxlambda-live:close-window) ; explicitly unbinds before destroying the frame
(wxlambda-live:open-window)  ; another frame, within the same session
(wxlambda:stop)") (:p "The registered callback resolves " (:code "clicked") " on each invocation, so redefining it takes effect without replacing the handler. " (:code "close-window") " releases the handler before destroying its controls. If the user has already closed the native window, its handles are stale and that handler remains rooted until session cleanup. Prefer " (:code "close-window") " during repeated development cycles.") (:p "Editor integration is explicitly deferred for the first release. Local Swank 2.32 wire probes on Apple Silicon macOS found:") (:table :header (("Probe") ("Observed execution")) :rows ((("SBCL 2.6.9, " (:code "nil") " / " (:code ":fd-handler") " styles") ("Evaluation, application body, and callback on the launch thread")) (("SBCL 2.6.9, " (:code ":spawn") " control") ("Worker GUI startup rejected by the native main-thread check")) (("CCL 1.13, " (:code ":spawn")) ("Caller on worker; application body and callback on initial process; caller dynamic binding absent")))) (:p "These probes execute one RPC containing a complete GUI session. They do not demonstrate an editor workflow with a persistent session, GUI responsiveness between requests, evaluation interruption, or debugger transport. The terminal application REPL is the first-release workflow. No editor adapter or background scheduler is selected; their ordering, values, conditions, shutdown, and reentrancy contracts must be established before future implementation.") (:p "To reproduce these optional experiments with an existing Quicklisp installation containing Swank, run:") (:code-block "sh" "python3 tests/editor-probe.py nil sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :fd-handler sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "These are optional local experiments using Swank internals and loopback sockets, separate from pinned CI dependencies. " (:code ":spawn") " probes use a persistent listener to keep Swank's accept loop off the launching thread. Their process and listener are shut down after the request. They are not supported editor configurations.") (:p "The bridge catches native exceptions at exported operation boundaries and exposes error text through " (:code "wxl_last_error") ". Its text is borrowed until the next bridge operation on the same thread. See " (:code "native/wxlambda.h") " for the C interface.") (:heading 2 "Standalone application (macOS SBCL)") (:p "The form has a standalone packaging recipe, locally verified on Apple Silicon macOS with SBCL 2.6.9. It uses " (:link "https://www.sbcl.org/manual/index.html#Saving-a-Core-Image" "SBCL's saved-core support") " and ships its own runtime. Python, Quicklisp, Lisp sources, and a system SBCL installation are not needed to run the result.") (:p "Build the native bridge first using the instructions above. Packaging also requires Python 3 and the macOS command-line developer tools (" (:code "otool") ", " (:code "lipo") ", " (:code "install_name_tool") ", and " (:code "codesign") "):") (:code-block "sh" "python3 ci/fetch-deps.py
python3 packaging/build-form.py
python3 tests/package.py --report evidence/packaging/my-run
./dist/wxlambda-form/wxlambda-form") (:p "The builder refuses to overwrite an existing output directory. Use " (:code "--output /absolute/path/to/a/new-package") " for another build; the verifier takes that directory as its positional argument. Its " (:code "--report") " directory must also be new. " (:code "--sbcl /path/to/sbcl") " and " (:code "--bridge /path/to/libwxlambda.dylib") " select build inputs explicitly. The recipe is repeatable, not a promise of byte-identical cores or locked native package versions. " (:code "manifest.json") " records SBCL's version and source/staged native-file hashes to identify the inputs and results.") (:p "Copy the entire output directory to another location and run its " (:code "wxlambda-form") " launcher from any working directory. " (:code "--repl") " selects the terminal application REPL; " (:code "--self-test") " exercises queued callbacks, Unicode values, window recreation, and clean exit automatically. Each launch is a fresh process and one GUI session. The package contains:") (:code-block "text" "wxlambda-form        shell launcher
runtime/sbcl        copied SBCL runtime
app.core            saved application and Lisp dependencies
lib/*.dylib         bridge and recursive non-system native dependencies
manifest.json       versions, origins, and hashes
licenses/           available installed native/runtime notices") (:p "No wxWidgets application or native bridge is initialized before saving. The delivered image has no Quicklisp package or registered wxlambda ASDF system. At startup it loads the bridge relative to the running packaged runtime using the public explicit-path loader, which no longer consults ASDF for that path. The staged native load commands use " (:code "@loader_path") "; this includes SBCL's own dependencies, such as zstd, and wxWidgets' image-library dependencies. System frameworks remain provided by macOS. Modified native files receive ad-hoc signatures. This is a command-line package, not a notarized Finder " (:code ".app") ".") (:p (:code "tests/package.py") " copies the package to a temporary path containing spaces, uses a different working directory and empty HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads with " (:code "sandbox-exec") ". A denied-read control verifies that isolation is active. Both the GUI self-test and packaged REPL pass there; removing either the staged bridge or wxWidgets core must report the expected load failure instead of falling back to development libraries. The test retains its manifest, sandbox profile, logs, and summary. Local evidence is in " (:code "evidence/packaging/macos-sbcl-isolated/") ".") (:p "The recipe requires matching macOS architectures and was tested only on this Apple Silicon host. Linux/Windows packaging is not implemented; Intel macOS, other macOS versions, and distribution/signing behavior on another machine are not validated. These local packaging results do not close Phase 3's hosted platform checks. Release preparation remains open.") (:heading 2 "Verification") (:p "These tests briefly open real windows, queue a button event, then exit. They need an interactive graphical session (or a suitable display server on Linux). The 26 scenarios each run in a fresh process with a 30-second timeout: The window-state scenario exercises the documented example, native changed-state results, ancestor semantics and stale/inactive handles. The window-metadata scenario exercises its callback example, Unicode/empty/NUL names, copied-string lifetime, title receiver checks and invalid/stale/inactive use. The CLOS scenario checks public classes, generic dispatch, method combination and callback identity across Lisp subclass changes.") (:code-block "sh" "python3 tests/run.py
python3 tests/run.py ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "A separate preflight loads the native bridge, checks its ABI, and prints actual Lisp/OS/architecture and CFFI source metadata before any GUI scenario. To retain evidence, set " (:code "WXLAMBDA_TEST_REPORT") " to a new directory before running the suite:") (:code-block "sh" "WXLAMBDA_TEST_REPORT=test-results python3 tests/run.py sbcl --noinform \\
  --no-sysinit --no-userinit --non-interactive --load ci/setup.lisp") (:p "The runner records per-process logs and " (:code "summary.json") " with the source commit, working-tree status, command, platform, scenario results, durations, and exit codes. It preserves partial timeout output, stops at the first failure, and returns a failing exit code. Preflight is separate from the 26 GUI scenarios; a load failure cannot count as GUI coverage. An existing report directory is rejected to avoid mixing old and new evidence. Reporter checks can be run with " (:code "python3 -m unittest discover -s tests -p test_runner.py") ".") (:p "Retained local Phase 3 reports live in " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") ". The ignored " (:code "evidence/") " directory is separate from the disposable " (:code ".ci-deps/") " cache; keep evidence there when retaining local runs across dependency-cache cleanup. The newer 23-scenario Phase 4 runs are retained in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") "; the Phase 3 records retain their original 21-scenario count.") (:p "Choice tests cover selection bounds, empty/Unicode item lists, nested selection snapshots, handler replacement/removal, callback errors, and stale handles.") (:p "Coverage: callback dispatch and replacement, empty/long/Unicode text round trips, independent text copies, explicit closure release, queued click suppression, rebinding and self-unbinding, parent/child invalidation, wrong-type handles, duplicate sizer insertion, cleanup on setup and callback errors, and rejection of a second session. Event tests cover source/kind metadata, copied Unicode and empty text payloads, nested updates, silent versus notifying setters, self-unbinding, and text-handler errors before and during the loop, including caught errors that must leave the loop running. Layout tests verify actual child geometry for rows, columns, proportional allocation, fixed/flexible spacing, borders, and alignment, plus invalid options and stale handles. Control tests cover label text copies, checked-state access, nested toggle snapshots, handler replacement/unbinding, and caught/uncaught toggle errors. A timed Gray input stream tests delayed whitespace/CRLF, GUI callback dispatch while input is unavailable, separate evaluation/callback error recovery, and delayed EOF cleanup on SBCL and CCL. This simulates delayed terminal input; it does not validate an actual terminal or editor transport. Debugger tests verify original condition identity, live evaluation restarts, abandon-form recovery, safe delivery of callback errors, and paused GUI dispatch. They install automated debugger hooks on the GUI thread. A separate SBCL pseudo-terminal check entered the debugger, selected the application REPL restart, evaluated another form, and stopped cleanly. CCL terminal debugger I/O has not been verified. Unicode rendering, manual mouse/keyboard input, and user-generated toggle events have not been visually verified; automated text and toggle events use notifying setters.") (:p "The live-development example test exercises text updates, callback function redefinition, 50 explicit bind/unbind cycles with registry-release checks, unbinding before destruction, stale handles, and frame recreation in one session. Two representative-form scenarios exercise ordinary blocking startup and the application REPL, including Unicode input, checkbox/dropdown state, queued handler replacement, named action redefinition, unbinding all event kinds, and state-preserving window recreation from Lisp and a GUI callback. These use queued/notifying events; manual input and visual layout have not been checked.") (:p "Locally tested and intended combinations are distinct:") (:table :header (("Platform") ("Lisp") ("Validation")) :rows ((("Apple Silicon macOS, wxWidgets 3.2.12") ("SBCL 2.6.9, CCL 1.13") ("Local preflight and 26-scenario GUI suites; dependency cache switching verified separately")) (("Linux") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("macOS hosted runner") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("Windows x64") ("SBCL 2.6.9 intended, not validated") ("Native build, preflight, and GUI suite configured; no runtime results")))) (:heading 2 "Continuous integration") (:p (:code ".github/workflows/ci.yml") " runs on pushes, pull requests, and manual dispatch. The configured jobs are:") (:table :header (("Runner") ("Native build") ("Lisp GUI tests")) :rows ((("Ubuntu 24.04") ("Distribution wxWidgets 3.2, GCC") ("SBCL, 26 scenarios under Xvfb")) (("macOS 15") ("Homebrew wxWidgets 3.2, Clang") ("SBCL, 26 scenarios")) (("Windows Server 2022 x64") ("wxWidgets 3.2.12 from source, MSVC") ("Pinned SBCL 2.6.9, preflight and 26 scenarios; unexecuted")))) (:p "These are configured checks, not a claim that hosted jobs have passed. No hosted results have been recorded. This checkout currently has no Git remote, so a GitHub repository association is needed to dispatch or inspect the relevant runs. CCL remains locally tested on macOS, outside this CI matrix.") (:p "All jobs run reporting checks, native loading/ABI preflight, and the GUI suite (including Unicode copies, callbacks, controls, cleanup, and REPL recovery). An " (:code "always()") " upload step retains generated " (:code "test-results/") " logs and JSON reports for 30 days, even after test failures. A job that fails before tests start may have no test report; inspect its Actions logs as well as its conclusion. Hosted Windows, Linux, and macOS execution remains required before claiming validation.") (:p "The Windows build follows the upstream " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/docs/msw/install.md" "MSVC makefile instructions") ". It builds wxWidgets release DLLs from a pinned commit, then passes explicit " (:code "wxWidgets_ROOT_DIR") ", " (:code "wxWidgets_LIB_DIR") ", and " (:code "wxWidgets_CONFIGURATION=mswu") " settings to CMake. System package versions on Linux/macOS follow their package repositories; these native dependencies are not locked to an exact patch release.") (:p (:code "ci/install-sbcl.ps1") " downloads the official " (:link "https://sourceforge.net/projects/sbcl/files/sbcl/2.6.9/" "SBCL 2.6.9 Windows x64 MSI") ", verifies its pinned SHA256, and extracts it into the job's temporary directory. The bridge is emitted as " (:code "build/wxlambda.dll") ", where the Lisp loader expects it; the wxWidgets DLL directory is added to the test process's " (:code "PATH") ". Python runs in UTF-8 mode. This Windows setup has been statically reviewed, not executed on this macOS host; neither MSI execution nor PowerShell runtime behavior is locally verified. The full Windows job must pass to establish DLL loading and GUI behavior.") (:p "CI uses the exact CFFI, Babel, Alexandria, and trivial-features commits in " (:code "ci/lisp-dependencies.json") ", fetched over HTTPS into ignored " (:code ".ci-deps/") " checkouts. " (:code "ci/setup.lisp") " isolates ASDF's source registry from user installations and stores compiled output in " (:code ".ci-deps/fasl/") ", separated by Lisp implementation. This keeps pinned CFFI callbacks separate from Quicklisp's compiled-file cache. This path requires Git and Python 3, and does not install or modify Quicklisp. To reproduce the CI Lisp environment locally after building the bridge:") (:code-block "sh" "python3 ci/fetch-deps.py
python3 tests/run.py sbcl --noinform --no-sysinit --no-userinit \\
  --non-interactive --load ci/setup.lisp") (:p "On Linux, prefix the test command with " (:code "xvfb-run -a") " if no display is available. CCL can use the same dependencies with:") (:code-block "sh" "python3 tests/run.py ccl --no-init --batch --load ci/setup.lisp") (:p "For the separate dependency-cache regression, run:") (:code-block "sh" "python3 tests/cache-switch.py
python3 tests/cache-switch.py ccl --no-init --batch") (:p "Each command runs the callback/handler API scenario with pinned dependencies, then Quicklisp, then pinned dependencies again in fresh processes. It checks CFFI source locations and the compiled output destination as well as actual native callback dispatch. Quicklisp must already be installed; set " (:code "QUICKLISP_SETUP") " if its setup file is not " (:code "~/quicklisp/setup.lisp") ". These three-process regressions are separate from the 26-scenario GUI suite and are local checks, not configured hosted jobs.") (:p "The fetcher verifies existing checkouts and refuses modified or mismatched ones. After deliberately changing a locked revision, remove the corresponding generated " (:code ".ci-deps/<name>/") " directory before fetching again. Fresh compilation of the pinned Babel revision emits a warning about " (:code "HANDLE-ERROR") " in its Korean codec; the UTF-8 paths exercised by these tests pass on both local Lisps.") (:p "The " (:ref "guide/IMPLEMENTATION.md" "implementation roadmap") " now includes the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "full wxWidgets coverage plan") " as Phase 6; release preparation moves to Phase 7. The coverage plan checks off existing operations and groups remaining widgets and API declarations into coverage phases C1–C7. Hosted platform validation (including the configured Windows Lisp/GUI tests), packaging on additional platforms, and richer interactive development support remain open as described in the roadmap."))))
(:entry "guide/IMPLEMENTATION.md" :names ("IMPLEMENTATION.md" "IMPLEMENTATION") :kind :guide :kind-name "Guide" :summary "IMPLEMENTATION.md" :sections (("Guide" (:heading 1 "Implementation plan") (:p "The final goal is complete wxWidgets coverage across C1–C7, including supported platforms, optional components and documented public interfaces. A usable first release with existing controls, reliable REPL-driven development and standalone packaging is an intermediate milestone. Phase 6 inventories the full scope; partial C1/C2 implementation is underway and does not complete that goal. This is a plan; unchecked steps are not claims of implemented or verified behavior.") (:heading 2 "Session handoff: full coverage work") (:p "The user has confirmed that " (:b "complete wxWidgets coverage is the final goal") ". Keep every required missing/partial API open; a bounded release, working example, local test result or explicitly unsupported decision cannot close the final goal. Use the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage overview") ", generated " (:ref "guide/docs/coverage/README.md" "phase/header backlog") ", class index and exact C1–C7 declaration checklists together. The pinned inventory is wxWidgets 3.2.12; C7 must reconcile additional documented public interfaces beyond those headers.") (:heading 3 "Completed implementation checkpoints") (:list (:item (:p (:code "6f6312e") ": progress gauges, generic SETF properties, subclass example and"))) (:p "pulse-to-determinate regression; independent review finding resolved.") (:list (:item (:p (:code "ed3ca87") ": C1 application state and pending-event dispatch, callback/pump/"))) (:p "cleanup reentrancy guards and fresh-load inactive-session regression; independent review finding resolved.") (:list (:item (:p "Current bridge ABI: 11. Public API: 68 exports, nine window wrapper classes"))) (:p "(eight concrete widget kinds), 39 named generics and ten generic SETF writers. No public application wrapper or generic event-handler binding exists yet.") (:list (:item (:p "Latest implementation verification: 28 GUI scenarios and native preflight"))) (:p "pass on local Apple Silicon macOS SBCL 2.6.9 and CCL 1.13. Final reports: " (:code "evidence/application-events/{sbcl,ccl}-review-fix-20261028/") ". Five package checks pass in " (:code "evidence/packaging/application-events-reviewed-20261028/") ". Hosted Linux/Windows GUI behavior and the graphical Cadre viewer remain open.") (:heading 3 "Next dependency and working order") (:list (:item (:p "Continue " (:b "C1") ", before adding further C2 widget families. Application dispatch"))) (:p "boundaries are established only for the bridge-owned session.") (:list (:item (:p "Define native event-handler ownership, borrowed window handlers, invalidation,"))) (:p "callback roots and teardown. Review how standalone handlers and window-backed handlers fit native-backed CLOS construction without allocating a second native object. Preserve existing subclass initargs, defaults, AFTER hooks and rollback.") (:list (:item (:p "Implement the required event-handler base and generic binding/unbinding with"))) (:p "positive, error, lifetime and callback tests. Account for multiple bindings, event/source/ID identity and safe unbinding during dispatch; the current control-specific single-handler slots are not full generic binding support.") (:list (:item (:p "Build timer/idle, event propagation/skip/veto and worker-to-GUI dispatch on"))) (:p "those contracts, adding prerequisite value types before their consumers. Existing immutable event snapshots do not provide mutable native event access or native virtual overrides. Do not mark those capabilities complete.") (:list (:item (:p "Continue all remaining C1 groups, then C2–C7, reviewing dependencies and"))) (:p "supported platform/build variants rather than treating the current slice ordering as an exhaustive design for the rest of the project.") (:heading 3 "Resume and verification checklist") (:list (:item (:p "Inspect " (:code "git status") " and the latest log first; preserve unrelated changes."))) (:p "Read " (:code "AGENTS.md") ", this handoff and the relevant coverage declarations.") (:list (:item (:p "Use the required quiet-command wrapper for builds, tests and batch commands."))) (:list (:item (:p "Treat " (:code "docs/coverage/status.json") " as the source of status truth. Update exact"))) (:p "header/line/signature mappings and scopes, then regenerate all checklists, the class index and backlog. Never hand-edit generated marks or totals.") (:list (:item (:p "Obtain the pinned upstream " (:code "interface/") " tree if the previous temporary cache"))) (:p "is gone; verify its header hashes against " (:code "docs/coverage/manifest.json") ". " (:code "../docset") " (or " (:code "WXLAMBDA_DOCSET_SOURCE") ") supplies the shared docset reader; " (:code ".ci-deps/") " contains the pinned test dependencies, fetched through the CI tool.") (:list (:item (:p "Reproduction examples (replace the source placeholder):"))) (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 -m unittest discover -s tests -p 'test_*.py'
python3 tools/docset.py build
python3 tools/docset.py check") (:list (:item (:p "Every implementation slice needs matching reference/guides, runnable example"))) (:p "sources, docset updates and relevant behavior/error/lifetime tests. Run affected examples; verify actual-package export and SETF coverage with " (:code "tests/docset.lisp") " on both Lisps, plus shared-reader discovery and guide/example access. The generated coverage summary is also included in the docset.") (:list (:item (:p "Follow the established workflow: finish a bounded dependency-building slice,"))) (:p "obtain independent review, resolve findings, rerun affected checks, regenerate docs, commit, and record the result and next dependency here. Keep evidence directories fresh; the GUI runner rejects reused report directories.") (:list (:item (:p "Distinguish local checks from hosted platform and graphical-viewer validation."))) (:p "For documentation-only changes, verify regeneration/links/docset; do not claim GUI suites were rerun. Only close a phase when all its required scope and verification are complete.") (:list (:item (:p "For isolated docset installation checks, use a dedicated discovery parent such"))) (:p "as " (:code "/path/to/isolated-docsets/wxlambda") ", with only one copy of this docset ID. The reader deduplicates IDs across siblings; old test copies under a shared temporary parent can otherwise select a previous artifact. A shared-parent install check exposed that collision during the coverage-summary update; repeat with a dedicated root rather than weakening content comparisons.") (:heading 2 "Implementation rule: documentation, examples, and docset") (:p "Every implementation change must include matching documentation, examples, and docset updates, as required by " (:code "AGENTS.md (AGENTS.md)") ". The docset is the primary documentation deliverable: use Cadre's " (:code "docset") " library format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). Standard content means the indexed reference for every implemented public wxlambda export; include project guides and explained, runnable example sources in the same docset. Verify these deliverables alongside implementation; examples are required rather than optional. The initial docset build and artifact are implemented in Phase 7 below; release-wide platform and graphical-viewer verification remain open.") (:heading 2 "Phase 1: Establish the release baseline") (:list (:item (:p "[x] Correct README coverage and CI counts to match the GUI runner."))) (:list (:item (:p "[x] Record tested and intended OS/Lisp combinations separately."))) (:list (:item (:p "[x] Run the pinned-dependency suite and cache-switch regression checks."))) (:p "Verified locally on 2026-10-28 on Apple Silicon macOS with wxWidgets 3.2.12, SBCL 2.6.9, and CCL 1.13. The dependency fetcher verified all four pinned checkouts. Both Lisps passed all 19 GUI scenarios and the separate three-process pinned → Quicklisp → pinned callback regression. The runner previously had 18 scenarios; the delayed-input test below adds the nineteenth. Cache-switch checks are not included in that count. Reproduction commands are in README.md. Hosted-platform validation remains Phase 3 work.") (:p (:b "Acceptance:") " Documented commands reproduce the baseline without unexplained failures.") (:heading 2 "Phase 2: Finish REPL-driven development") (:list (:item (:p "[x] Add delayed-input tests for whitespace, CRLF, EOF, error recovery, and GUI"))) (:p "responsiveness.") (:p (:code "tests/repl-delayed.lisp") " uses a timed Gray stream on SBCL/CCL. It verifies callback dispatch while input is unavailable, separate evaluation/callback error recovery under the explicit " (:code ":on-error :report") " policy, and EOF cleanup. It rejects blocking reads during whitespace-only waits. Actual terminal/editor transport still needs broader validation.") (:list (:item (:p "[x] Replace message-only error handling for interactive use with a debugger"))) (:p "policy. Preserve the original condition and its available restarts; provide a restart that abandons the current form and returns to the application REPL. Investigate a backtrace fallback where debugger integration is unavailable.") (:list (:item (:p "[x] Define GUI processing as paused while the debugger is active, resuming"))) (:p "after recovery. Never unwind through a foreign callback.") (:list (:item (:p "[x] Test recovery from evaluation errors and callback errors separately."))) (:p "Verified locally on 2026-10-28: both pinned-dependency SBCL/CCL suites pass all 20 scenarios. " (:code "tests/repl-debugger.lisp") " checks original condition identity, live evaluation restarts, abandonment without losing the session, callback delivery after returning through the foreign boundary, and paused/resumed GUI dispatch. Callback-local restarts cannot survive that safe boundary; this is documented. The " (:code ":report") " fallback prints bounded SBCL/CCL backtraces before unwinding; tests confirm real stack output. A live SBCL pseudo-terminal check entered the debugger, selected " (:code "RETURN-TO-APPLICATION-REPL") ", evaluated another form, and stopped cleanly. CCL terminal debugger I/O remains unverified; its tests install hooks on the initial process because the adapter does not transfer dynamic bindings. Editor integration is explicitly deferred as recorded below.") (:list (:item (:p "[x] Prototype SBCL Swank with " (:code ":communication-style nil") " and " (:code ":fd-handler") ","))) (:p "checking where forms actually execute. These are candidates requiring verification, not supported configurations yet.") (:list (:item (:p "[x] Prototype CCL integration using its initial-process adapter."))) (:list (:item (:p "[x] Review the prototypes and select a demonstrated editor workflow or"))) (:p "explicitly defer editor support. If none works reliably, use the documented terminal REPL workflow as the release criterion and keep editor REPLs unsupported.") (:list (:item (:p "[x] If scheduling is needed, define execution order, returned values, condition"))) (:p "delivery, shutdown, and GUI-thread reentrancy before implementing it.") (:p "Not applicable to the selected terminal workflow: editor scheduling is deferred with editor support. These contracts remain prerequisites for future work; no scheduler has been implemented or advertised.") (:list (:item (:p "[x] Implement and verify the selected editor adapter if a prototype succeeds."))) (:p "Not applicable after explicit deferral: no editor workflow or adapter was selected. The thread probes below are not successful end-to-end editor prototypes and do not establish editor support.") (:list (:item (:p "[x] Retain and prominently document one GUI session per process for the first"))) (:p "release.") (:list (:item (:p "[x] Retain and prominently document the current rule that handlers for"))) (:p "destroyed controls remain rooted until unbound or session cleanup.") (:list (:item (:p "[x] Demonstrate explicit unbinding before destruction and verify that repeated"))) (:p "bind/unbind cycles release registered closures.") (:list (:item (:p "[x] Add a live-development example that updates controls and redefines callback"))) (:p "functions within one session.") (:p "Verified locally on 2026-10-28: both pinned SBCL/CCL suites pass 21 scenarios. The new " (:code "examples/live.lisp") " is exercised by " (:code "tests/live.lisp") ": text updates, callback redefinition, 50 bind/unbind cycles with registry-release checks, explicit unbinding before destruction, and frame recreation within one session. The smoke test also verifies handler retention after native destruction and release at session cleanup, plus rejection of a second application session.") (:p "Optional Swank (SLIME 2.32) loopback RPC probes passed for SBCL " (:code "nil") ", " (:code ":fd-handler") ", and a " (:code ":spawn") " rejection control, plus CCL " (:code ":spawn") ". SBCL's first two styles execute evaluation/body/callback on the launch thread. Its worker control rejects GUI startup. CCL evaluates on a worker and runs the application body/callback on the initial process without transferring caller dynamic bindings. Reproduction commands and limits are in README.md. These experiments cover one request containing one complete session, not persistent editing, interruption, or editor debugger transport. SLIME/SLY support is explicitly deferred; the terminal application REPL meets the first-release workflow gate.") (:p (:b "Acceptance:") " The terminal workflow supports live updates, useful error diagnosis, and recovery without losing the session. Debugger behavior and lifecycle limits are documented and tested. Editor support is either demonstrated or explicitly deferred.") (:heading 2 "Phase 3: Validate supported platforms") (:list (:item (:p "[ ] Execute macOS, Linux, and Windows hosted jobs and preserve results."))) (:list (:item (:p "[ ] Extend Windows checks to Lisp loading, callbacks, controls, and cleanup;"))) (:p "mark complete only after the configured hosted Windows job passes.") (:list (:item (:p "[ ] Check Unicode and REPL behavior on advertised combinations."))) (:p "Windows CI now stages SHA256-pinned SBCL 2.6.9, places the bridge where the Lisp loader expects it, exposes dependent wxWidgets DLLs, and runs native loading/ABI preflight plus the full GUI suite. All hosted jobs retain per-process logs and JSON summaries for 30 days with an " (:code "always()") " artifact upload. Configuration is not runtime evidence: the Windows setup and PowerShell installer are unexecuted on this macOS host.") (:p "Local evidence recorded on 2026-10-28: both SBCL 2.6.9 and CCL 1.13 pass preflight and 21 GUI scenarios, including Unicode and REPL tests. Logs and JSON summaries are retained in dedicated ignored " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") " directories, separate from the disposable dependency cache. The reports identify the source commit and mark the working tree dirty because they verify the uncommitted Phase 3 changes. Workflow lint and reporter checks also pass. The downloaded Windows MSI's SHA256 matches the configured pin; it was not executed locally.") (:p (:b "External dependencies:") " this checkout has no Git remote. GitHub authentication is available, but no repository association or hosted run URL has been provided. There is no local Windows runtime, PowerShell, Linux display server, or container runner. Hosted macOS/Linux/Windows execution and Unicode/REPL evidence on those runners remain pending; Phase 3 is not complete. Commands and the distinction between configured and validated platforms are documented in README.md.") (:p (:b "Acceptance:") " Runtime evidence supports every advertised platform. Missing repository access or runners remain explicit external dependencies.") (:heading 2 "Phase 4: Complete a representative application") (:list (:item (:p "[x] Extend an example using the existing controls and layouts."))) (:list (:item (:p "[x] Include handler replacement, explicit unbinding, and window recreation"))) (:p "within the same session.") (:list (:item (:p "[x] Identify concrete gaps exposed by the example and add controls or"))) (:p "operations only where needed.") (:p (:code "examples/form.lisp") " retains its ordinary load-and-run entry point. Its reusable " (:code "examples/form-app.lisp") " application combines labels, Unicode text input, a checkbox, a style dropdown, and row/column layouts. " (:code "start-live") " enters the terminal application REPL; submit actions can be replaced or redefined by name. Explicit close/reopen functions and a GUI reopen button unbind handlers before destruction and recreate the window with retained input values. Both entry points use only public bindings. The application exposed a need for reusable example lifecycle functions, not new native controls or operations; the binding API and ABI remain unchanged.") (:p "Verified locally on 2026-10-28 with pinned dependencies: SBCL 2.6.9 and CCL 1.13 each pass native preflight and all 23 GUI scenarios. " (:code "tests/form.lisp") " adds normal and live modes covering startup, controls, Unicode values, queued handler replacement, named function redefinition, explicit unbinding, stale handles, state retention, callback-driven recreation, and cleanup. An initial assertion incorrectly expected deferred destruction to finish inside the recreation callback; it was corrected to check after the appropriate event/cleanup boundary and both modes pass. The six reporter tests also pass. Reports and logs are retained separately from dependencies in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") ".") (:p "Accepted lifecycle limits remain visible in the README: one session per process, and closures for user-destroyed windows remain rooted until session cleanup if they were not explicitly unbound first. Manual input and visual layout have not been verified. Phase 3's hosted-platform checks remain pending; these local application results do not complete platform validation.") (:p (:b "Acceptance:") " Ordinary startup and live development work through public APIs, with the accepted lifecycle limits visible.") (:heading 2 "Phase 5: Implement standalone packaging") (:list (:item (:p "[x] Create a reproducible SBCL packaging example."))) (:list (:item (:p "[x] Resolve native libraries relative to the packaged application."))) (:list (:item (:p "[x] Stage required runtime libraries."))) (:list (:item (:p "[x] Test outside the checkout, from another working directory and without a"))) (:p "development Quicklisp installation.") (:p "The completed example is scoped to macOS SBCL, locally verified on Apple Silicon with SBCL 2.6.9. " (:code "packaging/build-form.py") " saves the form and pinned Lisp dependencies without initializing wxWidgets, copies the SBCL runtime, and stages the bridge plus recursive non-system dylibs. It rewrites native paths relative to each image, audits their resolution, and ad-hoc signs the copied images. This host's package contains 10 native objects, including the runtime, wxWidgets, its image dependencies, and zstd. Native inputs/hashes are recorded in a manifest; the recipe is repeatable, not a byte-identical or fully native-version-locked build. Linux/Windows packaging is not implemented, and Intel macOS is unvalidated.") (:p "The public explicit-path native loader no longer consults ASDF. The delivered core deliberately has no registered wxlambda ASDF system or Quicklisp package, and resolves its bridge beside the packaged runtime. A launcher supports normal startup, " (:code "--repl") ", and " (:code "--self-test") ". Interactive mode restores SBCL's debugger after the non-interactive image build.") (:p "Verified locally on 2026-10-28: build and five packaging checks pass. The verifier copies the package outside the checkout to a path with spaces, uses an unrelated working directory and empty HOME/SBCL_HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads. A denied-read control proves the sandbox is active. Packaged Unicode callbacks, window recreation, cleanup, and REPL startup/recreation/exit pass. Withholding the staged bridge or wxWidgets core produces the expected explicit load error and exit 1; those expected failures are not application passes or unexpected failed checks. Evidence is retained in " (:code "evidence/packaging/macos-sbcl-isolated/") ". Both regular pinned SBCL/CCL suites also pass preflight and 23 GUI scenarios after the loader change, with reports in " (:code "evidence/phase5/{sbcl,ccl}-20261028/") ".") (:p "The result is a command-line directory package, not a notarized Finder " (:code ".app") ". Other machines/OS versions and manual UI input remain unvalidated. Phase 3's hosted checks and Phase 7's release preparation remain open; this local sample does not establish release-wide platform support.") (:p (:b "Acceptance:") " The sample launches, processes events, and exits without relying on development paths or Quicklisp.") (:heading 2 "Phase 6: Create the full wxWidgets coverage plan") (:list (:item (:p "[x] Inventory the pinned wxWidgets API, including widgets, functions, overloads,"))) (:p "events, styles, optional components and platform-specific declarations.") (:list (:item (:p "[x] Mark implemented and partial operations in the detailed lists and class"))) (:p "index, preserving their scopes and Lisp/native mappings across regeneration.") (:list (:item (:p "[x] Group the remaining inventory into coverage implementation phases with"))) (:p "dependencies, verification requirements and completion rules.") (:list (:item (:p "[x] Preserve release preparation as Phase 7 and link the new coverage plan."))) (:p "The " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "wxWidgets coverage plan") " records the implemented baseline and coverage phases C1–C7. Its class index and per-header declaration checklists cover all 398 wxWidgets 3.2.12 interface headers, with source links and a hash manifest. A persistent status ledger retains checked/partial entries; compiler scaffolding is context rather than binding tasks. These are source-inventory entries, not a count of distinct functions or a claim of full binding coverage. Final source/documentation and inherited-API reconciliation is an explicit remaining coverage task.") (:p (:b "Acceptance:") " Every pinned interface header has phased, source-linked work items; existing support is distinguished from complete class/API coverage. The inventory-plan deliverable is complete. C1/C2 implementation is underway; all remaining pending/partial scope across C1–C7 remains required for the final goal.") (:heading 2 "Phase 7: Prepare the release") (:p "The docset build prerequisite was established before the first coverage slice. Continue using it for subsequent implementation work, including Phase 3 fixes and C1–C7 bindings, so required docset updates can be built and verified.") (:list (:item (:p "[x] Establish a reproducible Cadre-format docset build and update workflow for"))) (:p "implementation changes, with documented build/check/install commands. Generate format version 1 in " (:code "docs/docset/") " with " (:code "manifest.sexp") ", " (:code "index.sexp") " and " (:code "entries.sexp") ", docset ID " (:code "wxlambda") ", and package " (:code "WXLAMBDA") ".") (:list (:item (:p "[ ] Review exports, documentation, examples, ABI compatibility, and limitations."))) (:list (:item (:p "[ ] Run supported-platform and packaged-application checks."))) (:list (:item (:p "[ ] Align ASDF and CMake release versions."))) (:list (:item (:p "[ ] Prepare release notes and installation, development, debugging, and"))) (:p "packaging instructions.") (:list (:item (:p "[x] Produce the docset containing an indexed reference for every implemented"))) (:p "public wxlambda export, project guides/limitations, and example sources with explanations and run commands, all accessible through its index and contents.") (:list (:item (:p "[ ] Require zero problems from " (:code "docset:check-docset") "; verify public-export"))) (:p "coverage and links, run the included examples, and verify Cadre discovery, symbol lookup and navigation to guides/examples using documented installation.") (:p (:b "Acceptance:") " A new user can follow the documented installation-to-packaging workflow. Documentation and runnable examples match the implemented interfaces; the built docset uses Cadre's format version 1 and includes the public wxlambda reference, project guides and example sources together. All three files are present; " (:code "docset:check-docset") " reports zero problems; export coverage, links, example execution and Cadre discovery/lookup/navigation checks pass.") (:heading 2 "Coverage implementation: first slice") (:list (:item (:p "[x] Establish and verify the Cadre-format docset build before expanding bindings."))) (:list (:item (:p "[x] Complete " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()")))) (:p "through the native bridge, FFI and public Lisp exports, preserving setter results and recording the equivalent " (:code "Hide()") "/" (:code "Disable()") " mappings.") (:list (:item (:p "[x] Add runnable window-state callbacks, focused tests and documentation, and"))) (:p "update the persistent coverage ledger.") (:p "This bounded C2 slice builds on existing window handles; the C1 foundation inventory and the rest of C2–C7 remain open. " (:code "show-window") " retains its window primary value and adds an optional show/hide argument and changed-state second value. " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " expose own visibility and effective input state. Native ABI 8 distinguishes false from native errors.") (:p "The initial " (:ref "guide/docs/DOCSET.md" "docset workflow") " delivered three committed files containing the then-current 53 public exports, project guides and six example sources with usage notes. Later slices extend that artifact. It requires Python 3, SBCL and the shared " (:code "docset") " library; no GUI is needed to build/read the docs. Its checker, shared-reader discovery/search/lookup and indexed guide/example reading pass, including an isolated installation. The graphical Cadre viewer has not been manually exercised.") (:p "The " (:code "window-state test (tests/window-state.lisp)") " runs the actual example callbacks, checks repeated setters, returned state-change flags, ancestor behavior and invalid/stale session use. Both local Apple Silicon macOS suites pass native preflight and all 24 GUI scenarios with wxWidgets 3.2.12, SBCL 2.6.9 and CCL 1.13; reports are retained in " (:code "evidence/coverage-first/{sbcl,ccl}-20261028/") ". Reproduction commands are in " (:ref "guide/docs/WINDOW-STATE.md" "the window-state guide") ". This does not close Phase 3 hosted checks or Phase 7 release-wide acceptance.") (:heading 2 "Coverage implementation: window metadata and CLOS API") (:list (:item (:p "[x] Add " (:code "window-name") ", " (:code "(setf window-name)") ", " (:code "frame-title") " and " (:code "(setf frame-title)")))) (:p "with native/FFI mappings and length-aware UTF-8 string ownership.") (:list (:item (:p "[x] Add a runnable callback example, a user guide and public API reference"))) (:p "records; track full name support and frame-only title support in the ledger.") (:list (:item (:p "[x] Fix multiline preprocessor handling in the inventory generator so following"))) (:p "classes and methods remain individually visible, with a regression check.") (:list (:item (:p "[x] Establish 40 widget-facing CLOS generic functions and export all eight"))) (:p "existing wrapper classes, preserving valid-call signatures and results.") (:list (:item (:p "[x] Add portable CLOS tests and an example of wrapper subclassing/method hooks;"))) (:p "record the CLOS implementation rule and update the reference generator.") (:p "This C2 slice supports logical names on all seven bound widget types, including empty/Unicode/embedded-NUL names. Frame titles are exposed only for " (:code "wxFrame") "; other " (:code "wxTopLevelWindow") " receivers and the broader C1/C2 inventories stay open. Getter strings remain valid after later queries and destruction; setters copy inputs. Native ABI 9 adds explicit byte lengths without changing earlier bridge string-buffer contracts.") (:p "The " (:ref "guide/docs/WINDOW-METADATA.md" "metadata guide") " documents usage and focused checks. At that checkpoint the docset covered 65 public exports, including eight wrapper classes and 40 named generic functions, plus guides and seven example sources. The user explicitly requested establishing CLOS before further widget-family expansion; keyword-only factories, lifecycle functions, immutable event snapshots and the FFI retain their existing roles. Native virtual overrides remain future work. Both local macOS SBCL/CCL suites pass native preflight and all 26 GUI scenarios, including the CLOS and metadata scenarios. Reports are retained in " (:code "evidence/coverage-clos/{sbcl,ccl}-20261028/") ". The earlier 25-scenario metadata reports in " (:code "evidence/coverage-metadata/") " predate the CLOS migration.") (:p "The macOS SBCL standalone form was rebuilt as " (:code "dist/wxlambda-form-clos") " and passes all five isolation/relocation/REPL/missing-library checks, with evidence in " (:code "evidence/packaging/coverage-clos-20261028/") ". The docset checker reports zero problems; actual-package export coverage passes on both Lisps. Python and inventory regressions cover method-signature rendering, stale-docset detection, agent-content exclusion and multiline macro parsing. Graphical Cadre and hosted platform verification remain release work; shared-reader checks are separate from graphical-viewer testing.") (:heading 2 "CLOS construction and properties: revision 3") (:list (:item (:p "[x] Make " (:code "make-instance") " construct every concrete native widget from initargs,"))) (:p "with ordinary subclass defaults/slots and native-backed AFTER initialization.") (:list (:item (:p "[x] Make factories thin MAKE-INSTANCE wrappers with validated " (:code ":class") " and"))) (:p "forwarded subclass initargs, and reject abstract/invalid construction clearly.") (:list (:item (:p "[x] Roll back native allocations and callback roots on managed initializer"))) (:p "failure, preserving the original condition or nonlocal exit.") (:list (:item (:p "[x] Establish eight canonical generic SETF writers and migrate examples,"))) (:p "tests, REPL scripts, packaging and documentation to them.") (:p "The user's later ground-up direction explicitly removes backward compatibility as a requirement. It supersedes the earlier factory/CHANGE-CLASS construction convention and the review's request to retain setter aliases. Six separate setter aliases and receiver-compatibility fallback methods were removed; unsupported receiver types now use CLOS dispatch errors. The native ABI remains 9; native handle/type and callback/lifetime checks are retained.") (:p "The public API has 59 exported symbols, including eight classes, 34 named widget generic functions and eight generic SETF functions using the getter symbols. Class docset pages include Construction sections; mutable-property pages include SETF syntax and indexed compound writer names. The current docset has 73 entries covering the API, guides and seven executable example sources.") (:p "Locally verified on Apple Silicon macOS with SBCL 2.6.9 and CCL 1.13: native preflight and all 26 GUI scenarios pass, including direct construction of all seven native kinds, subclass defaults/slots, factory class validation, initializer rollback, property writers, notification recovery and method combination. The initial SBCL run caught an obsolete native-error expectation for a wrong receiver in the events test; the expectation now checks CLOS dispatch failure, and the full rerun passes. Both reports are retained under " (:code "evidence/clos-construction/") " (" (:code "sbcl-rerun-20261028") ", " (:code "ccl-20261028") "); the original failed " (:code "sbcl-20261028") " report remains intact.") (:p "The rebuilt macOS SBCL form in " (:code "dist/wxlambda-form-native-clos") " passes all five packaging checks, recorded in " (:code "evidence/packaging/native-clos-construction-20261028/") ". Docset validation on both Lisps verifies all 59 exports and the construction and SETF sections; Python/inventory regressions pass. Hosted-platform checks and the Cadre graphical viewer remain unvalidated.") (:heading 2 "Property accessor names: revision 4") (:list (:item (:p "[x] Rename the text readers and generic SETF writers to " (:code "text") " and"))) (:p (:code "label-text") ", with no aliases for the former reader names.") (:list (:item (:p "[x] Update callers, embedded REPL/package scripts, examples, API reference"))) (:p "records, docset indexes and persistent coverage mappings.") (:list (:item (:p "[x] Record property-style naming in the project rules and add regression"))) (:p "assertions that obsolete readers/writers are absent.") (:p "The CLOS construction and SETF protocol is unchanged. Public export count remains 59 and the docset remains 73 entries; the property names and index IDs now use natural accessor names. The private CFFI/native getter names remain internal implementation details, so no native ABI change is needed.") (:p "Both local macOS SBCL/CCL suites pass preflight and all 26 scenarios, with reports in " (:code "evidence/property-names/{sbcl,ccl}-20261028/") ". The rebuilt standalone form passes five packaging checks in " (:code "evidence/packaging/property-names-20261028/") ". The Python/inventory checks and both actual-package docset checks pass, including indexed SETF forms under the new names. Hosted platforms and the graphical Cadre viewer remain unvalidated.") (:heading 2 "Coverage implementation: progress gauges") (:list (:item (:p "[x] Add native-backed " (:code "gauge") " construction and the thin " (:code "make-gauge") " factory,"))) (:p "including subclass defaults, slot initargs and native access in AFTER hooks.") (:list (:item (:p "[x] Add generic " (:code "gauge-value") "/" (:code "gauge-range") " readers and SETF writers,"))) (:p (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ", with checked native handles and arguments.") (:list (:item (:p "[x] Add a runnable subclass/callback example, focused GUI scenario, guide,"))) (:p "reference entries and persistent declaration/class/style coverage mappings.") (:list (:item (:p "[x] Prevent guide/example stem aliases from shadowing public symbols in Cadre"))) (:p "lookup, with a regression test and stricter build/check lookup assertions.") (:p "This bounded C2 slice exposes " (:code "wxGauge") " progress, positive ranges, horizontal or vertical construction and indeterminate pulsing. Range assignment clamps the current native value and restores determinate mode. Pulse animation/value readings remain platform-dependent. Custom constructor IDs, geometry, validators, names and additional styles, two-step creation and the remaining inherited API stay open. Native ABI 10 requires rebuilding the bridge with these bindings. The API now has 65 exports, nine wrapper classes, 39 named generic functions and ten generic SETF writers. The docset contains 81 entries across API, guides and eight example sources; installation instructions remain in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ".") (:p "Local Apple Silicon macOS verification passes native preflight and all 27 GUI scenarios on SBCL 2.6.9 and CCL 1.13. Evidence is retained in " (:code "evidence/gauge/sbcl-20261028.log") " and " (:code "evidence/gauge/ccl-20261028/") "; a focused rerun on both Lisps also passes after the final helper refactor. The sandboxed initial SBCL gauge process stalled on macOS window-service access and was terminated; GUI verification passed with window-service access outside the agent sandbox. Reporter/inventory tests initially caught obsolete scenario and class counts, which were updated and pass on rerun. Actual-package docset validation caught colliding guide/example aliases for GAUGE; the alias fix and regression now pass, with zero " (:code "docset:check-docset") " problems, complete export and SETF lookup coverage, links, discovery and indexed guide/example access on both Lisps. An isolated install under a temporary docset root passes discovery and indexed reading. Python and pinned-upstream inventory regressions pass.") (:p "The rebuilt " (:code "dist/wxlambda-form-gauge") " passes all five packaging isolation, relocation, REPL and missing-library checks, with reports in " (:code "evidence/packaging/gauge-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. This slice does not complete C1 or C2. Independent static review found that the example resumed determinate progress from platform-dependent pulse readings. The example now stores completed work in Lisp and tests pulse-to-advance directly; the revised focused scenario passes on both Lisps. The reviewer verified the fix and reported no remaining actionable findings. The user has directed that unfinished C1 foundations take priority before further C2 widget expansion; finish and review this gauge slice, then return to C1.") (:heading 2 "C1 foundation: application event dispatch") (:list (:item (:p "[x] Expose " (:code "main-loop-running-p") ", " (:code "pending-events-p") " and"))) (:p (:code "process-pending-events") " for the active bridge application, distinguishing wx pending events from GUI/OS polling and idle processing.") (:list (:item (:p "[x] Guard RUN, both event pumps and native cleanup against callback/pump"))) (:p "reentrancy, including synchronous notifying setters before RUN starts.") (:list (:item (:p "[x] Add the runnable application-events example, focused regression scenario,"))) (:p "guide, API reference and pinned C1 declaration mappings.") (:p "This is an application-dispatch prerequisite within C1, not completion of the application or event-handler inventory. The next dependency is event-handler ownership and generic binding, followed by timer/idle/propagation and worker-to-GUI dispatch, with required value/ownership contracts before consumers. All new APIs require an active main-thread session. Queries return T/NIL; pending-only dispatch returns NIL and re-signals contained callback conditions after returning from native code. Existing synchronous notifications and the cooperative application REPL remain supported. Native ABI 11 adds these entry points and the dispatch boundary; rebuild the bridge alongside the bindings.") (:p "Local Apple Silicon macOS verification passes native preflight and all 28 GUI scenarios on SBCL 2.6.9 and CCL 1.13, including the example, loop/queue queries, pending dispatch, raw/native callback guards, notifying-setter boundaries, debugger pauses, inactive sessions and recovery after callback failure. The initial focused test used an incorrect zero-argument text callback; it was corrected to accept the event snapshot and both Lisp reruns pass. Full reports are retained in " (:code "evidence/application-events/{sbcl,ccl}-20261028/") ". Independent review found that fresh-ASDF-load calls initially raised an FFI lookup error instead of NATIVE-ERROR before bridge loading. All three new public functions now check the active session before calling the FFI. The fresh-load regression verifies NATIVE-ERROR without loading the bridge, then checks raw native pre-session errors. The reviewer independently verified this fix and reported no remaining actionable findings. Both full 28-scenario suites pass after the fix; final reports are under " (:code "evidence/application-events/{sbcl,ccl}-review-fix-20261028/") ".") (:p "Python reporter/docset regressions and all pinned-upstream inventory checks pass. The docset contains 86 entries and covers all 68 public exports, guides and nine example sources. Build/check and actual-package export/SETF lookup verification pass on both Lisps with zero " (:code "docset:check-docset") " problems; indexed reading, links, shared-reader discovery and an isolated temporary installation are verified. Installation instructions are in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ". The rebuilt " (:code "dist/wxlambda-form-application-events-reviewed") " passes all five packaging isolation, relocation, REPL and missing-library checks; evidence is in " (:code "evidence/packaging/application-events-reviewed-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. The C1 inventory remains open, and no further C2 widget families were added.") (:heading 2 "Decisions") (:list (:item (:p "D1 Keep a bounded first release as an intermediate milestone. The user has"))) (:p "clarified that the final goal is complete wxWidgets coverage through C1–C7; the first release and individual slices do not satisfy final acceptance.") (:list (:item (:p "D2 Gate editor support on prototype evidence because main-thread integration"))) (:p "remains unproven; rejected: making release completion depend indefinitely on SLIME/SLY.") (:list (:item (:p "D3 Accept both existing lifecycle limits for the first release because restart"))) (:p "support and destruction notifications require separate lifecycle designs; rejected: silently expanding their scope.") (:list (:item (:p "D4 Pause GUI processing during debugging because nested event dispatch adds"))) (:p "reentrancy risks; rejected: implicitly pumping events inside the debugger.") (:list (:item (:p "D5 Default the application REPL to the host debugger and require explicit"))) (:p (:code ":on-error :report") " for automatic recovery because interactive diagnosis needs live evaluation restarts; rejected: silently discarding restarts by default.") (:list (:item (:p "D6 Defer editor integration and scheduling for the first release because thread"))) (:p "probes do not establish a persistent editor/debugger workflow; rejected: advertising SLIME/SLY support from single-request thread checks.") (:list (:item (:p "D7 Ship the packaging example as a separate SBCL runtime/core with sibling"))) (:p "native libraries because relocation can patch/sign the runtime without modifying an appended Lisp core; rejected: a single Mach-O/core executable for this first packaging example.") (:list (:item (:p "D8 Use public CLOS wrapper classes and generic widget operations because the"))) (:p "user requested Lisp dispatch and specialization before further expansion; rejected: continuing ordinary functions with native-only type dispatch.") (:list (:item (:p "D9 Use native-backed INITIALIZE-INSTANCE construction and canonical SETF"))) (:p "properties because the user requested a ground-up CLOS API without backward compatibility; rejected: factory-then-CHANGE-CLASS construction and legacy setter/receiver compatibility scaffolding.") (:list (:item (:p "D10 Name the mutable properties " (:code "text") " and " (:code "label-text") " because the same"))) (:p "names read naturally for reads and SETF writes; rejected: get-prefixed readers and compatibility aliases during ground-up API development.") (:p "Implement these as separate reviewable changes, beginning with baseline corrections and REPL regression tests. Platform work can proceed alongside local development when runners become available."))))
(:entry "guide/docs/APPLICATION-EVENTS.md" :names ("docs/APPLICATION-EVENTS.md" "APPLICATION-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/APPLICATION-EVENTS.md" :sections (("Guide" (:heading 1 "Application event dispatch") (:p "This C1 foundation slice defines dispatch entry and observation for the existing bridge application. It precedes broader event-handler, timer and worker-dispatch bindings. It does not introduce arbitrary application or event-loop objects.") (:p "All operations require the active GUI session on its process main thread. Inactive-session calls signal " (:code "native-error") ", including boolean queries. The three new APIs enforce this before any FFI call, so it also holds immediately after loading the Lisp system, before loading the native bridge.") (:heading 2 "Observe the application") (:code-block "lisp" "(wxlambda:main-loop-running-p) ; T while the native blocking main loop runs
(wxlambda:pending-events-p)    ; T if wxWidgets has queued pending events") (:p (:code "main-loop-running-p") " maps to " (:code "wxAppConsole::IsMainLoopRunning") ". It is false during standalone " (:code "process-events") ", " (:code "process-pending-events") " and the cooperative application REPL. Those modes can still invoke callbacks; a false query does not mean it is safe to enter another pump. Inside a " (:code "run") " callback, the query reports the native main-loop state.") (:p (:code "pending-events-p") " maps to " (:code "wxAppConsole::HasPendingEvents") ". It observes the application's wx pending-event handlers, including events queued by " (:code "queue-click") ". It does not inspect OS input, idle work or timers that have not queued events. Its result is an observation rather than a promise about subsequent dispatch. Both queries return T/NIL and are safe to call from callbacks.") (:heading 2 "Dispatch queued wx events") (:code-block "lisp" "(wxlambda:queue-click button)
(assert (wxlambda:pending-events-p))
(wxlambda:process-pending-events) ; returns NIL") (:p (:code "process-pending-events") " maps to " (:code "wxAppConsole::ProcessPendingEvents") " across all pending handlers in the bridge application. It dispatches queued wx events, without yielding to OS input or running " (:code "ProcessIdle") ". It does not wait for new events, but callbacks and continuously requeued work can delay its return. It is not a replacement for the GUI loop needed to keep an application responsive.") (:p "Use " (:code "process-events") " to yield to GUI events and process idle work, or " (:code "run") " to enter the blocking native main loop. " (:code "stop") " exits that loop; in the cooperative application REPL it instead ends the REPL. Pending-only dispatch does not create a native main loop, so " (:code "stop") " outside RUN/REPL still signals " (:code "native-error") ".") (:heading 2 "Callback and pump boundaries") (:p (:code "run") ", " (:code "process-events") " and " (:code "process-pending-events") " reject entry while RUN, either pump, or any native-to-Lisp callback is active. These failures signal " (:code "native-error") "; the same protection applies to raw bridge calls. This includes synchronous command callbacks invoked by a notifying SETF writer before any main loop starts. Native cleanup is also forbidden from pumps and callbacks. RAII guards restore dispatch state after native exceptions and callback failures.") (:p "Property reads, queries, ordinary window operations, handler replacement and synchronous notifying setters retain their existing callback behavior. This boundary prevents recursive event pumping; it does not disable synchronous command notifications or provide native virtual-method callbacks.") (:p "Both pump functions reject dispatch in the application REPL debugger, keeping the documented pause while debugging. Callback conditions never unwind through C++; they are recorded and re-signaled when the native operation returns. Handled boundary failures allow the callback to continue; an escaping condition uses the existing callback-error recovery rules. A subsequent pump remains usable.") (:p "The native bridge is ABI 11. Rebuild it alongside the Lisp bindings. This uses the wxWidgets 3.2.12 inventory baseline; application traits, arbitrary event-loop objects, generic event binding, pending-event suspension/deletion, filters, propagation, idle handlers, timers and worker dispatch remain open C1 work.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/application-events.lisp" "application-events example") " displays main-loop state from a button callback:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp \\
  --eval '(wxlambda-application-events:start)'") (:p "The reusable " (:code "exercise") " invokes that same callback once through explicit pending dispatch and once through RUN, verifying the different loop states and cleaning up handlers/windows. The focused scenario also tests reentrancy from pending, GUI-poll and blocking-loop callbacks, synchronous text notifications, inactive sessions, debugger pauses and recovery after an escaping callback error:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/application-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/application-events.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete GUI runner includes this scenario. " (:ref "guide/docs/DOCSET.md" "Install the Cadre docset") " with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") to browse these APIs, this guide and the example together."))))
(:entry "guide/docs/CLOS-API.md" :names ("docs/CLOS-API.md" "CLOS-API") :kind :guide :kind-name "Guide" :summary "docs/CLOS-API.md" :sections (("Guide" (:heading 1 "CLOS widget API") (:p "Widgets are native-backed CLOS instances. The public classes are " (:code "window") ", " (:code "frame") ", " (:code "panel") ", " (:code "button") ", " (:code "text-control") ", " (:code "label") ", " (:code "checkbox") ", " (:code "choice") " and " (:code "gauge") ". " (:code "window") " is abstract. Every concrete wrapper inherits from it and represents one native widget kind. Native handles remain private and validated.") (:heading 2 "Construction") (:p "Use " (:code "make-instance") " directly, including for your own subclasses:") (:code-block "lisp" "(defclass document-frame (wxlambda:frame)
  ((project :initarg :project :reader project)
   (title-changes :initform 0 :accessor title-changes))
  (:default-initargs :title \"Document\"))

(defmethod initialize-instance :after ((frame document-frame) &key)
  ;; Inherited initialization has already created the native widget.
  (setf (wxlambda:window-name frame) (project frame)))

(defmethod (setf wxlambda:frame-title) :after (value (frame document-frame))
  (declare (ignore value))
  (incf (title-changes frame)))

(wxlambda:with-application ()
  (let ((frame (make-instance 'document-frame :project \"example\")))
    (setf (wxlambda:frame-title frame) \"Document — λ\")
    (assert (= 1 (title-changes frame)))
    (assert (string= \"example\" (wxlambda:window-name frame)))
    (wxlambda:destroy-window frame)))") (:p "Concrete native initargs are:") (:list (:item (:p (:code "frame") ": " (:code ":title") " (default \"wxlambda\"), " (:code ":width") " (480), " (:code ":height") " (240)."))) (:list (:item (:p (:code "panel") ": required " (:code ":parent") " window."))) (:list (:item (:p (:code "button") ": required " (:code ":parent") ", " (:code ":label") " (\"Button\")."))) (:list (:item (:p (:code "text-control") ": required " (:code ":parent") ", " (:code ":value") " (empty string)."))) (:list (:item (:p (:code "label") ": required " (:code ":parent") ", " (:code ":label") " (empty string)."))) (:list (:item (:p (:code "checkbox") ": required " (:code ":parent") ", " (:code ":label") " (empty string), " (:code ":checked") " (NIL)."))) (:list (:item (:p (:code "gauge") ": required " (:code ":parent") ", " (:code ":range") " (100), " (:code ":value") " (0), " (:code ":orientation")))) (:p "(" (:code ":horizontal") " or " (:code ":vertical") "). See " (:ref "guide/docs/GAUGE.md" "gauge behavior") ".") (:list (:item (:p (:code "choice") ": required " (:code ":parent") ", " (:code ":items") " (NIL), " (:code ":selection") " (NIL)."))) (:p "Construction requires an active main-thread application session. Inherited " (:code "initialize-instance") " methods allocate exactly one native widget. Subclass " (:code ":default-initargs") ", slot initargs and ordinary " (:code ":after") " hooks work normally; these hooks can read/write native properties. An overriding primary initializer must call its inherited method. Unsupported abstract classes, missing parents, unknown initargs, repeated initialization and multiple native widget bases are rejected with clear errors. Supplying a raw " (:code ":handle") " is unsupported.") (:p "Failures during inherited initialization and subclass " (:code ":before") "/" (:code ":after") " hooks roll back native widgets created through this protocol in that initialization, including nested construction, and remove their callback roots. Cleanup preserves the original condition or nonlocal exit. Custom outer " (:code ":around") " methods remain responsible for failures they introduce after the inherited initialization has completed.") (:heading 2 "Factory conveniences") (:p "The " (:code "make-*") " functions are thin wrappers around " (:code "make-instance") ". Each accepts " (:code ":class") " as a class name or class object and forwards additional initargs:") (:code-block "lisp" "(wxlambda:make-frame :class 'document-frame :project \"example\")
(wxlambda:make-button parent :class 'wxlambda:button :label \"Run\")") (:p "A factory validates that " (:code ":class") " is a subclass of its corresponding concrete widget class. Child factories dispatch on their parent; methods extending a factory should accept " (:code "&rest") "/" (:code "&allow-other-keys") " to forward subclass initargs. " (:code "make-frame") " remains an ordinary function because it has no required dispatch argument. Application lifecycle functions/macros and immutable event snapshots keep their separate roles.") (:heading 2 "Generic properties") (:p "Use these ten generic " (:code "setf") " accessors:") (:code-block "lisp" "(setf (wxlambda:text input) \"Text\")
(setf (wxlambda:label-text caption) \"Ready\")
(setf (wxlambda:checked-p checkbox) t)
(setf (wxlambda:selection choice) 0)
(setf (wxlambda:window-name window) \"logical-name\")
(setf (wxlambda:frame-title frame) \"Title\")
(setf (wxlambda:shown-p window) nil)
(setf (wxlambda:enabled-p window) t)
(setf (wxlambda:gauge-value gauge) 25)
(setf (wxlambda:gauge-range gauge) 100)") (:p "A writer's method lambda list starts with the new value, followed by the receiver. Specialize " (:code "(setf accessor)") " with primary, " (:code ":around") ", " (:code ":before") " or " (:code ":after") " methods; " (:code "call-next-method") " retains inherited behavior. Assignment returns the supplied value. Boolean reads normalize generalized booleans to T/NIL. The shown/enabled writers also return a native changed-state flag as a second value; " (:code "show-window") "/" (:code "enable-window") " are action conveniences returning the window and that flag.") (:p "Text, checkbox and selection writes are silent by default. Use " (:code ":notify t") " on the place for synchronous command events:") (:code-block "lisp" "(setf (wxlambda:text input :notify t) \"Changed\")
(setf (wxlambda:checked-p checkbox :notify t) t)
(incf (wxlambda:selection choice :notify t))") (:p "The corresponding readers accept and ignore " (:code ":notify") ", so modifying macros can read the same place. Callback conditions are re-signaled at the writer's Lisp boundary. Reads of " (:code "shown-p") " use the own shown flag; reads of " (:code "enabled-p") " include disabled ancestors, while its writer requests the own enabled state.") (:p "This project is establishing its API from the ground up: the six separate " (:code "set-*") " property aliases and compatibility-only wrong-receiver methods have been removed. Unsupported receiver types signal standard Lisp dispatch errors; native handle/state failures still signal " (:code "native-error") ".") (:heading 2 "Scope and verification") (:p "The " (:ref "example/examples/window-metadata.lisp" "metadata example") " uses direct subclass construction and a generic writer hook. Lisp subclassing extends the wrapper; it does not change the native C++ class or provide native virtual callbacks. Native ownership, main-thread restrictions and explicit handler unbinding before destruction still apply. Start a fresh Lisp when changing these class definitions.") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/clos.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/clos.lisp") (:p "The CLOS test covers direct native construction for the original seven concrete types, subclass slots/defaults/hooks, all factory " (:code ":class") " paths, invalid construction, initializer rollback of nested native objects and callback roots, eight generic writers, method combination and native handle protection. Those checks exercise the original 34 named generic functions and eight generic SETF functions. The docset includes construction instructions on class pages and indexed SETF forms on property pages.") (:p "The gauge scenario additionally verifies direct and factory subclass construction, subclass AFTER access, rollback, and the two gauge SETF writers. Across the public API there are now 39 named generic functions and ten generic SETF functions."))))
(:entry "guide/docs/DOCSET.md" :names ("docs/DOCSET.md" "DOCSET") :kind :guide :kind-name "Guide" :summary "docs/DOCSET.md" :sections (("Guide" (:heading 1 "Cadre docset") (:p "The primary documentation artifact is " (:code "docs/docset/") ". It contains the public wxlambda API reference, guides and explained example sources together, in the " (:code "docset") " library's format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). The generated files are committed so readers can use them without building the bridge or opening a GUI.") (:heading 2 "Build and check") (:p "Requirements: Python 3, SBCL and the shared " (:link "https://github.com/crazymevt/docset" "docset library") ". The baseline used here is commit " (:code "481f57e7222925c3157e41a7e3deaeb628ecc9a7") " (format version 1). Check it out beside wxlambda as " (:code "../docset") ", or set " (:code "WXLAMBDA_DOCSET_SOURCE") " to its directory. The library has no runtime dependencies; it is a documentation tool dependency, not a wxlambda runtime dependency.") (:code-block "sh" "python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper when running these in an agent session. " (:code "--library /path/to/docset") " overrides the library location and " (:code "--lisp") " selects the SBCL executable. Builds do not load the native bridge or start a GUI.") (:p "The build requires one authored reference record per public export, derives function, macro and generic-function lambda lists from the implementation (including method defaults while omitting specializers), converts README, the implementation roadmap and " (:code "docs/*.md") " guides and the generated " (:code "docs/coverage/README.md") " coverage summary into docset blocks, and embeds every " (:code "examples/*.lisp") " source with usage notes. Agent instruction files (" (:code "AGENTS.md") " and " (:code "CLAUDE.md") ") are excluded from the guide list. Bundled guides and examples must not contain machine-specific paths. Update " (:code "docs/api-reference.json") " and " (:code "docs/example-reference.json") " with implementation changes. API entries must state arguments, returns, behavior, errors/scope and the related wxWidgets APIs. Class pages include Construction sections; mutable-property pages include SETF sections and searchable compound function names such as " (:code "(setf frame-title)") ". Bordered Markdown pipe tables with a separator row become format-v1 " (:code ":table") " blocks, retaining headers, rows and inline code/links. Escaped pipes and pipes inside inline code stay within their cell; inconsistent column counts are rejected. The generated coverage summary exercises this conversion for phase totals and all 398 header rows, so the backlog stays readable in Cadre. Guide/example filename stems that coincide with public symbols are omitted as aliases, so symbol lookup stays unambiguous. Their source paths remain indexed. Build/check requires exactly one matching API record for each symbol and SETF name.") (:p "Both commands run " (:code "docset:check-docset") " and require zero problems, then exercise the same discovery, symbol lookup and indexed entry reader used by Cadre. Every API entry and guide/example entry is read back and compared with source content; " (:code "check") " also rejects stale generated content. Cadre's graphical viewer is a separate manual integration check; shared-reader success alone is not a claim that the viewer was manually tested.") (:heading 2 "Install for Cadre") (:code-block "sh" "python3 tools/docset.py install") (:p "This verifies the build, copies the three files into " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "), and verifies discovery and reading there. Use " (:code "--destination /path/to/wxlambda") " for an isolated installation. Only the three generated files are overwritten. The install command does not alter Cadre's source or its bundled Common Lisp docs.") (:p "Open Cadre after installation, or restart it if it already cached its docsets. In Lisp source, use Look Up in Docs/HyperSpec on " (:code "wxlambda:make-frame") " to open its API entry. Search for " (:code "README") " or an example filename such as " (:code "hello.lisp") " to open guides and example source. Use the docset table of contents for the API reference, Guides and Examples groups.") (:heading 2 "Maintaining the artifact") (:p "Run examples affected by a change, build the docset, and run " (:code "check") ". Commit all three generated files alongside source/reference changes. The generator uses only the tracked reference, guides and examples. It adds no build timestamps or machine-specific output paths; source text is preserved. A repeated build from identical sources produces identical bytes. The checker verifies internal references and index positions; external guide links still require ordinary documentation review. Links between bundled guides and examples become docset references. Links to repository files that are not bundled are shown as source paths, without broken relative hyperlinks."))))
(:entry "guide/docs/GAUGE.md" :names ("docs/GAUGE.md") :kind :guide :kind-name "Guide" :summary "docs/GAUGE.md" :sections (("Guide" (:heading 1 "Progress gauges") (:p (:code "gauge") " is a native-backed CLOS " (:code "window") " subclass for " (:code "wxGauge") ", using the wxWidgets 3.2.12 coverage baseline. Construct it directly or through the thin " (:code "make-gauge") " factory:") (:code-block "lisp" "(defclass progress (wxlambda:gauge)
  ((job :initarg :job :reader job))
  (:default-initargs :range 100 :value 0))

(defvar progress
  (wxlambda:make-gauge panel :class 'progress :job :download
                       :orientation :horizontal))
(setf (wxlambda:gauge-value progress) 25)
(setf (wxlambda:gauge-range progress) 200)
(wxlambda:gauge-value progress)       ; 25
(wxlambda:gauge-range progress)       ; 200
(wxlambda:gauge-vertical-p progress)  ; NIL") (:p "PARENT is required. RANGE defaults to 100 and must be a positive signed 32-bit integer. VALUE defaults to zero and must be between zero and RANGE, inclusive. ORIENTATION defaults to " (:code ":horizontal") "; " (:code ":vertical") " is also supported, with no orientation writer. These restrictions are checked before passing invalid values to wxWidgets. Lisp type/range checks signal " (:code "type-error") "; a value above the current range signals " (:code "native-error") ". Invalid assignments preserve state.") (:p "The canonical writers are generic " (:code "(setf gauge-value)") " and " (:code "(setf gauge-range)") "; both return the supplied integer. Reducing a range clamps existing progress to the new maximum. Increasing it preserves progress. Range assignment calls " (:code "SetRange") " followed by " (:code "SetValue") " to restore determinate mode consistently. This explicit clamping policy is part of the Lisp binding contract.") (:p "For work with an unknown completion fraction:") (:code-block "lisp" "(wxlambda:pulse-gauge progress) ; returns PROGRESS
;; Call periodically while processing GUI events.
(setf (wxlambda:gauge-value progress) 50) ; resume determinate progress") (:p (:code "pulse-gauge") " maps to " (:code "wxGauge::Pulse") "; animation and progress readings while pulsing are platform-dependent. Neither reading the value nor changing the range after a pulse measures completed work. Assign an explicit value to resume measured progress. Pulsing does not provide a timer or thread dispatch, and it does not make blocking work responsive. Gauges emit no command events here.") (:p "The inherited layout, visibility, enabled state, logical name and destruction operations work on gauges. Native ownership stays with the parent; destroyed handles are invalid. All operations require an active main-thread GUI session. Subclass slot initargs, defaults and AFTER hooks work as described in the " (:ref "guide/docs/CLOS-API.md" "CLOS guide") ", including rollback when initialization fails.") (:p "This slice binds " (:code "wxGauge") " construction, " (:code "GetValue") ", " (:code "SetValue") ", " (:code "GetRange") ", " (:code "SetRange") ", " (:code "IsVertical") " and " (:code "Pulse") ". The constructor fixes ID to " (:code "wxID_ANY") ", position/size to native defaults and validator/name to native defaults; styles are limited to horizontal/vertical. Two-step creation, custom IDs, additional styles such as taskbar progress, and the remaining inherited API stay open. Gauge support was introduced in native ABI 10. Application dispatch now requires ABI 11; rebuild the bridge alongside the current Lisp bindings.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/gauge.lisp" "gauge example") " uses a subclass with a custom step slot. It keeps completed work in a Lisp slot so the advance button resumes from measured progress after a pulse, independent of native animation readings. Buttons advance/restart progress and request indeterminate pulsing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp \\
  --eval '(wxlambda-gauge:start)'") (:p "Its " (:code "exercise") " runs those same callbacks, restores determinate mode and cleans up handlers and windows. The focused test runs it and verifies orientations, factory/subclass initargs, range clamping, invalid arguments, native type checks, initialization rollback, inherited operations and stale/session handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/gauge.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/gauge.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete scenario runner also includes " (:code "gauge") ". See " (:ref "guide/docs/DOCSET.md" "docset installation") " to install the API, this guide and the example under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre."))))
(:entry "guide/docs/WINDOW-METADATA.md" :names ("docs/WINDOW-METADATA.md" "WINDOW-METADATA") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-METADATA.md" :sections (("Guide" (:heading 1 "Window names and frame titles") (:p "This coverage slice adds logical window names and mutable frame titles. These are CLOS generic functions; names work with every currently bound window/control. Title operations accept frames; other top-level window types remain future work.") (:heading 2 "Logical names") (:code-block "lisp" "(setf (wxlambda:window-name window) \"search-input\") ; returns the supplied string
(wxlambda:window-name window)                    ; independent string") (:p "A name is a logical string property, separate from a control's displayed label, its text value, a frame's title and the native integer ID. Names need not be unique. Changing a name does not synthesize a command event or change the label. Unicode, empty names and embedded NUL characters are preserved using explicit UTF-8 byte counts across the bridge. A setter copies its input; changing the Lisp string afterwards does not change the native name. A getter returns an independent Lisp string that survives later queries and window destruction.") (:heading 2 "Frame titles") (:code-block "lisp" "(wxlambda:frame-title frame)                     ; includes initial make-frame title
(setf (wxlambda:frame-title frame) \"Results — λ\")  ; returns the supplied string") (:p "Title setters update the existing frame, and getters return independent strings. Empty titles and Unicode are accepted. Display and platform normalization follow wxWidgets and the native window system. A frame's logical name is unaffected. These operations expose " (:code "wxTopLevelWindow::GetTitle") " and " (:code "SetTitle") " for the currently bound " (:code "wxFrame") " type; passing a panel or control signals a Lisp dispatch error.") (:p "All four functions require a live window in an active main-thread GUI session. Invalid/destroyed handles and inactive sessions signal " (:code "native-error") "; wrong Lisp argument types signal Lisp conditions. Empty successful results are strings, not failure sentinels. No parent ownership or handler lifetime rules change.") (:heading 2 "Example and checks") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp \\
  --eval '(wxlambda-window-metadata:start)'") (:p "The example constructs a subclass directly with " (:code "make-instance") " and counts title updates using an " (:code ":after") " method on " (:code "(setf frame-title)") ". Click the button to update both the frame name and its Unicode title. Close the frame to exit. The example's reusable " (:code "exercise") " queues that same callback, checks the resulting properties and subclass hook, explicitly unbinds it and destroys the frame. See " (:ref "guide/docs/CLOS-API.md" "the CLOS API guide") " for the dispatch and subclassing contract. The automated test runs this example, checks names on all seven widget types, independent labels/text, Unicode/empty/NUL names, saved string lifetime, non-frame title errors, invalid native pointers and destroyed/inactive handles:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-metadata.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-metadata.lisp") (:p "Native ABI 9 adds length-aware metadata strings. Rebuild the bridge with the updated Lisp bindings. Getter pointers are borrowed until the next name/title query on the same thread; the public Lisp getters copy them immediately. Existing text and label getter buffers retain their previous lifetime contracts."))))
(:entry "guide/docs/WINDOW-STATE.md" :names ("docs/WINDOW-STATE.md" "WINDOW-STATE") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-STATE.md" :sections (("Guide" (:heading 1 "Window visibility and input state") (:p "The first coverage slice completes the " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()") " operations for all currently bound windows. Hiding through " (:code "show-window") " with NIL also covers " (:code "Hide()") "; disabling through " (:code "enable-window") " with NIL covers " (:code "Disable()") ", preserving their changed-state results as second values. It builds on the existing handle/lifecycle support; the rest of the window API and C1 foundation inventory remain open.") (:heading 2 "Showing and hiding") (:code-block "lisp" "(wxlambda:show-window window)       ; show, preserving the existing API
(wxlambda:show-window window nil)   ; hide
(wxlambda:shown-p window)           ; own shown flag") (:p (:code "show-window") " returns the window as its primary value, so existing callers retain their result. Its second value is true when wxWidgets changed the shown state and false for an unchanged request. SHOW is a generalized boolean.") (:p (:code "shown-p") " reads the window's own shown flag. A child can have this flag true while a parent is hidden; this query does not promise it is visible on screen. Frames initially have their shown flag false; child controls normally start true. Use " (:code "layout-window") " on the parent after hiding/showing a sizer child when the layout should reclaim or restore its space.") (:heading 2 "Enabling and disabling input") (:code-block "lisp" "(wxlambda:enable-window window nil) ; disable user input
(wxlambda:enable-window window)     ; enable it again
(wxlambda:enabled-p window)         ; effective state, including ancestors") (:p (:code "enable-window") " returns the window and the native changed-state boolean as two values. ENABLE is a generalized boolean. " (:code "enabled-p") " includes disabled ancestors: a child is effectively disabled while a parent is disabled. A child explicitly disabled before disabling its parent stays disabled after the parent is enabled.") (:p "These functions require a live window in the active main-thread session. Invalid or destroyed native handles signal " (:code "native-error") "; false query results and unchanged setters are ordinary results. Setters do not synthesize command events. Hiding/disabling a control retains its handlers and ownership; explicitly unbind handlers before destroying it under the existing lifecycle contract.") (:heading 2 "Example and verification") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp \\
  --eval '(wxlambda-window-state:start)'") (:p "The example has separate buttons that toggle text visibility and input. Close the frame to exit. Its " (:code "exercise") " function queues the actual callbacks twice, verifies both state transitions, unbinds handlers and destroys the window. The focused test runs this example and checks setter return values, repeated requests, ancestor semantics and destroyed/inactive handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-state.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-state.lisp") (:p "Native ABI 8 introduces distinct boolean/error results (" (:code "0") "/" (:code "1") " versus " (:code "-1") "). Rebuild the native bridge with the Lisp changes. The old C " (:code "wxl_show") " status contract remains available; the Lisp wrapper uses " (:code "wxl_show_state") " to expose its second value. This does not implement " (:code "IsShownOnScreen") ", intrinsic " (:code "IsThisEnabled") ", general event bindings or window subclassing."))))
(:entry "guide/docs/WXWIDGETS-COVERAGE.md" :names ("docs/WXWIDGETS-COVERAGE.md" "WXWIDGETS-COVERAGE") :kind :guide :kind-name "Guide" :summary "docs/WXWIDGETS-COVERAGE.md" :sections (("Guide" (:heading 1 "wxWidgets coverage plan") (:p "This is the deliverable for implementation " (:b "Phase 6") ". The former release preparation phase is now " (:b "Phase 7") " in " (:ref "guide/IMPLEMENTATION.md" "IMPLEMENTATION.md") ". The final goal is " (:b "complete wxWidgets coverage") ". A bounded first release is an intermediate milestone; neither the plan nor individual implemented slices satisfy final acceptance. All required missing and partial APIs remain work. Coverage implementation has its own phases " (:b "C1–C7") " below, distinct from release roadmap numbering.") (:heading 2 "Scope and inventory") (:p "Target: the published wxWidgets " (:b "3.2.12") " API, the version recorded by the project's existing local verification. CMake currently accepts 3.2 or newer; this inventory does not claim to cover APIs added after 3.2.12. When advancing the coverage target, regenerate and review the inventory delta explicitly.") (:p "The authoritative inventory is upstream's " (:link "https://github.com/wxWidgets/wxWidgets/tree/v3.2.12/interface/wx" "`v3.2.12/interface/wx`") ", not just the " (:code "core") " and " (:code "base") " components currently linked by this bridge. Extracted declarations retain the upstream " (:code "wxWindows Library Licence (coverage/UPSTREAM-LICENCE.txt)") " and its " (:code "GNU Library GPL terms (coverage/UPSTREAM-LGPL.txt)") ". The checked-in " (:code "manifest (coverage/manifest.json)") " records every header's SHA-256, phase and entry count. The " (:ref "guide/docs/coverage/README.md" "generated coverage summary") " gives current implemented, partial and pending counts by phase and header. The " (:code "class/widget index (coverage/classes.md)") " lists every class/struct definition found there. Each C-phase links to the full source checklist: methods, constructors, destructors, overloads, operators, free functions, callback types, enums, constants, macros, templates, and documented style/event table entries. Supporting source chunks are retained conservatively as context without checkboxes; entry counts are " (:b "not counts of distinct functions") ". No platform branch is preprocessed away. Each entry links to its upstream source line.") (:p "This is a complete inventory of the pinned " (:b "interface headers") ", not proof that these documentation headers contain every public symbol in the full wxWidgets source tree. The final reconciliation task below must resolve any additional documented public API, generated declarations, port headers and inherited interfaces before claiming full wxWidgets support. Undocumented implementation internals are not binding requirements. Deprecated public APIs remain visible; any decision to omit an API must be recorded explicitly rather than checked off as implemented. APIs unavailable on a particular port remain required on their supported ports. Optional components need selectable builds, feature detection and clear unavailable-feature errors.") (:heading 2 "Status rules") (:list (:item (:p (:code "[x]") " in the baseline below means the " (:b "named, bounded operation") " exists in the"))) (:p "current native bridge, FFI and exported Lisp API. It does not mean the whole upstream class or every constructor option is supported, or that all platforms passed.") (:list (:item (:p "In generated checklists, " (:code "[x]") " means the declaration's operation is implemented"))) (:p "with its stated Lisp mapping, " (:code "[~]") " means partial support with the supported arguments/receivers and remaining limits stated inline, and " (:code "[ ]") " means pending. The class index uses " (:code "[~]") " for the managed " (:code "wxAppConsole") "/" (:code "wxApp") " interfaces, eight bound widgets, " (:code "wxBoxSizer") ", " (:code "wxWindow") " and " (:code "wxTopLevelWindow") "; none has complete class coverage. Applications have lifecycle functions, not public application wrapper classes. Constructors with fixed IDs/styles remain partial.") (:list (:item (:p (:code "status.json (coverage/status.json)") " is the persistent source of declaration and"))) (:p "class statuses, Lisp exports, native ABI names and supported scopes. Exact header/line/signature matching prevents silently transferring a mark to the wrong overload. The generator rejects missing/stale or duplicate mappings, unknown Lisp/native names, and overlapping phase assignments.") (:list (:item (:p "Conditional directives, includes, include guards and inline implementation"))) (:p "statements are labeled " (:b "Context") " without checkboxes. Public macro definitions and constants remain API tasks. Context is retained for platform interpretation and is counted separately in the manifest.") (:list (:item (:p "The baseline is based on " (:code "native/wxlambda.{h,cpp}") ", " (:code "lisp/{ffi,api,package}.lisp")))) (:p "and existing tests. Historical test results remain in the implementation plan; no GUI or hosted-platform checks were rerun for this documentation change.") (:list (:item (:p "For each binding, record the Lisp name, native ABI entry, supported arguments,"))) (:p "return values, receiver types, ownership, events, platform availability and focused verification before closing its full declaration. One mapping can implement several overloads when all semantics remain expressible.") (:list (:item (:p "C++ conveniences may map to Lisp strings, numbers, sequences, conditions or"))) (:p "scoped resource forms instead of literal C++ wrappers. Such equivalences require an explicit mapping, including Unicode, range and lifetime behavior.") (:heading 2 "Current gaps and final acceptance") (:p "Use the " (:ref "guide/docs/coverage/README.md" "generated phase/header backlog") " for counts and the linked C1–C7 checklists for exact declarations. " (:code "[ ]") " means no public binding is recorded; " (:code "[~]") " means only the annotated scope exists, and its missing portion remains required. A class marked partial is not complete because its constructor works. Context, class-definition and declaration counts must not be interpreted as percentages of distinct wxWidgets APIs.") (:p "Current implementation is limited to managed application/event-dispatch APIs and eight concrete widget kinds with a subset of inherited/layout/control APIs. C1 remains the active priority: event-handler ownership and generic binding, then timer/idle/propagation and worker dispatch, with required value and lifetime contracts first. C2 remains partial; C3–C7 have no public bindings recorded. See the " (:code "C1 details (coverage/phase-c1.md)") ", " (:code "C2 details (coverage/phase-c2.md)") " and " (:code "class index (coverage/classes.md)") " for the remaining work within bound families.") (:p "The current bridge is ABI 11, with 68 public Lisp exports. The latest code passes 28 GUI scenarios on both local Apple Silicon macOS SBCL/CCL configurations and five packaging checks. These are local results retained under " (:code "evidence/application-events/") " and " (:code "evidence/packaging/application-events-reviewed-20261028/") "; they do not validate Linux/Windows or the graphical Cadre viewer. This coverage documentation update does not rerun GUI suites.") (:p "Full coverage is finished only when:") (:list (:item (:p "All required C1–C7 declarations, constructor options, overloads, styles/events,"))) (:p "inherited APIs and native subclass/virtual-callback behavior are implemented or covered by documented, verified equivalent Lisp mappings.") (:list (:item (:p "No required API remains pending, partial or explicitly unsupported. An"))) (:p "unsupported decision records a gap; it does not close one.") (:list (:item (:p "C7 reconciliation covers documented public APIs beyond these interface headers,"))) (:p "including generated declarations, port headers and optional build components.") (:list (:item (:p "Applicable platform/Lisp/backend combinations pass behavior, lifetime, callback,"))) (:p "Unicode and packaging checks; unavailable local runners do not close port work.") (:list (:item (:p "Public reference, guides, runnable examples and the Cadre docset match the"))) (:p "complete implementation, with zero docset checker problems and verified viewer discovery, symbol lookup and guide/example navigation.") (:heading 2 "Already implemented: bounded baseline") (:p "All entries here are checked only for the behavior stated. None of the eight widget classes has complete wxWidgets coverage yet.") (:heading 3 "C1: Application and bridge") (:list (:item (:p "[x] Native loading: " (:code "load-native-library") "; explicit-path packaged loading."))) (:list (:item (:p "[x] Application initialization/cleanup: " (:code "call-with-application") ", " (:code "with-application") "."))) (:list (:item (:p "[x] Main loop and stopping: " (:code "run") ", " (:code "stop") "."))) (:list (:item (:p "[x] Nonblocking event polling: " (:code "process-events") "."))) (:list (:item (:p "[x] Active-application main-loop/queued-event state: " (:code "main-loop-running-p") ","))) (:p (:code "pending-events-p") "; explicit wx pending dispatch: " (:code "process-pending-events") ". These do not complete arbitrary wxApp/event-loop bindings. All dispatch entries reject pump/callback reentrancy; see " (:ref "guide/docs/APPLICATION-EVENTS.md" "application events") ".") (:list (:item (:p "[x] Interactive application loop and debugger return: " (:code "with-repl-application") ","))) (:p (:code "return-to-application-repl") " (SBCL/CCL; one GUI session per process).") (:list (:item (:p "[x] Native errors translated to Lisp " (:code "native-error") " conditions."))) (:list (:item (:p "[x] Event snapshots: " (:code "event") ", " (:code "event-p") ", " (:code "event-kind") ", " (:code "event-source") ","))) (:p (:code "event-text") ", " (:code "event-checked-p") ", " (:code "event-selection") " for the four bound event kinds.") (:heading 3 "C2: Windows, controls and layout") (:list (:item (:p "[x] " (:code "wxFrame") ": " (:code "make-frame") " with title, width and height."))) (:list (:item (:p "[x] " (:code "wxPanel") ": " (:code "make-panel") " with parent."))) (:list (:item (:p "[x] " (:code "wxButton") ": " (:code "make-button") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxTextCtrl") ": " (:code "make-text") " with parent and initial value."))) (:list (:item (:p "[x] " (:code "wxStaticText") ": " (:code "make-label") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxCheckBox") ": " (:code "make-checkbox") " with parent, label and initial boolean value."))) (:list (:item (:p "[x] " (:code "wxChoice") ": " (:code "make-choice") " with copied item strings and initial selection."))) (:list (:item (:p "[x] Static-text label get/set: " (:code "label-text") ", " (:code "(setf label-text)") " (not all controls)."))) (:list (:item (:p "[x] Text value get/set: " (:code "text") ", " (:code "(setf text)") "; silent " (:code "ChangeValue") " versus"))) (:p "notifying " (:code "SetValue") " for " (:code "wxTextCtrl") ".") (:list (:item (:p "[x] Checkbox boolean get/set: " (:code "checked-p") ", " (:code "(setf checked-p)") ", optional notification."))) (:list (:item (:p "[x] Progress gauges: native-backed " (:code "gauge") " construction, " (:code "make-gauge") ","))) (:p (:code "gauge-value") ", " (:code "gauge-range") ", " (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ". Both numeric properties have generic SETF writers; range reductions clamp progress.") (:list (:item (:p "[x] Choice index get/set: " (:code "selection") ", " (:code "(setf selection)") ", optional notification;"))) (:p "Lisp NIL means no selection. Item mutation and three-state checkboxes remain open.") (:list (:item (:p "[x] Parent-owned horizontal/vertical " (:code "wxBoxSizer") ": " (:code "make-row") ", " (:code "make-column") "."))) (:list (:item (:p "[x] Add window children: " (:code "add-child") " with proportion, uniform border, expand and"))) (:p "minor-axis alignment; nested standalone sizers and full flags remain open.") (:list (:item (:p "[x] Fixed/stretch spacing: " (:code "add-spacer") ", " (:code "add-stretch") "."))) (:list (:item (:p "[x] Relayout and geometry queries: " (:code "layout-window") ", " (:code "window-position") ", " (:code "window-size") "."))) (:list (:item (:p "[x] Logical name get/set: " (:code "window-name") ", " (:code "(setf window-name)") ", with copied Unicode"))) (:p "strings and explicit byte lengths preserving empty and embedded-NUL names.") (:list (:item (:p "[x] Frame title get/set: " (:code "frame-title") ", " (:code "(setf frame-title)") "; other top-level"))) (:p "receiver types remain unbound and their declarations are marked partial.") (:list (:item (:p "[x] Show/hide: " (:code "show-window") " accepts an optional boolean and returns the window"))) (:p "plus the native changed-state boolean; " (:code "shown-p") " queries its own shown flag.") (:list (:item (:p "[x] Enable/disable input: " (:code "enable-window") " returns the window plus changed-state"))) (:p "boolean; " (:code "enabled-p") " includes disabled ancestors.") (:list (:item (:p "[x] Destruction requests: " (:code "destroy-window") "; destruction notifications remain open."))) (:list (:item (:p "[x] Button bind/unbind/post: " (:code "on-click") ", " (:code "off-click") ", " (:code "queue-click") "."))) (:list (:item (:p "[x] Text-change bind/unbind: " (:code "on-text-change") ", " (:code "off-text-change") "."))) (:list (:item (:p "[x] Checkbox toggle bind/unbind: " (:code "on-toggle") ", " (:code "off-toggle") "."))) (:list (:item (:p "[x] Choice selection bind/unbind: " (:code "on-selection") ", " (:code "off-selection") "."))) (:list (:item (:p "[x] Handler replacement and callback condition containment for those events;"))) (:p "handler unbinding before window destruction is still required.") (:p "No APIs in C3–C7 currently have public bindings. Using wxWidgets types internally for conversions or implementation is not public API coverage.") (:p "The widget-facing Lisp API has nine public CLOS wrapper classes, direct native construction, 39 named generic functions and ten SETF generic functions; see " (:ref "guide/docs/CLOS-API.md" "CLOS API") ". This establishes Lisp dispatch and method combination, not native C++ subclass/virtual-callback coverage.") (:heading 2 "Coverage implementation phases") (:p "These phases group " (:b "all") " headers in the manifest; the linked lists are the individual widget/function work items, not examples of an unspecified larger set. Within a phase, implement prerequisite value types and base classes before their consumers. A cross-phase dependency can be pulled forward without marking the entire dependent phase complete.") (:heading 3 "C1: Foundation, values, application, events, and base utilities") (:p (:code "Full C1 declaration checklist (coverage/phase-c1.md)")) (:p "The next dependency chain starts with application dispatch boundaries (now implemented for the bridge session), then event-handler ownership and generic binding, then timer/idle/propagation support and worker-to-GUI dispatch. Prerequisite value and ownership contracts must precede each consumer. Application dispatch does not close the broader application or event checklist.") (:list (:item (:p "[ ] Complete application traits, initialization, event loops, generic"))) (:p (:code "wxEvtHandler") " binding/unbinding, event filters, event classes, propagation, veto/skip, idle processing, timers and thread-to-GUI dispatch.") (:list (:item (:p "[ ] Complete object/type information, client data, strings/encodings, buffers,"))) (:p "arrays/containers, variants/any, numeric/date/time types and conversions.") (:list (:item (:p "[ ] Complete base utilities: files/directories/paths, streams, archives and"))) (:p "compression, configuration, persistence prerequisites, logging/debugging, processes, dynamic libraries, environment/system utilities and command lines.") (:list (:item (:p "[ ] Complete networking, protocols, web requests, IPC, threading/synchronization,"))) (:p "translation/locales, regular expressions, security/secret storage and platform info.") (:list (:item (:p "[ ] Define ownership, borrowed values, invalidation, subclass/virtual dispatch,"))) (:p "callback lifetimes, thread restrictions and ABI compatibility for expanded APIs.") (:heading 3 "C2: Windows, layout, basic controls, and input") (:p (:code "Full C2 declaration checklist (coverage/phase-c2.md)")) (:list (:item (:p "[ ] Finish existing eight widget classes, all constructor options and inherited APIs."))) (:list (:item (:p "[ ] Complete window/top-level/control bases: parenting, IDs, focus, capture,"))) (:p "enable/show/hide, sizing/positioning, scrolling, styles, colours/fonts, DPI, tooltips, accessibility hooks and lifecycle notifications.") (:list (:item (:p "[x] Add bounded wxGauge construction, range/value properties, orientation query"))) (:p "and indeterminate pulsing; see " (:ref "guide/docs/GAUGE.md" "the gauge guide") ". Advanced gauge constructor options and inherited interfaces remain open.") (:list (:item (:p "[ ] Bind every remaining C2 widget in the class index: bitmap/command-link/toggle"))) (:p "buttons, radio controls, combos, list/checklist boxes, sliders, spin controls, pickers, date/time/calendar, search, static controls and other controls.") (:list (:item (:p "[ ] Complete all sizer families/items/flags, nested layouts, splitters,"))) (:p "scrolled/virtual windows, validators, keyboard/mouse and control-specific events.") (:heading 3 "C3: Dialogs, navigation, menus, and application services") (:p (:code "Full C3 declaration checklist (coverage/phase-c3.md)")) (:list (:item (:p "[ ] Complete modal/modeless and standard dialogs, custom file-dialog controls,"))) (:p "wizards, preferences and help APIs.") (:list (:item (:p "[ ] Complete menus/items, toolbars/status bars, books/notebooks, popups,"))) (:p "mini/MDI windows, notifications/taskbar and splash windows.") (:list (:item (:p "[ ] Complete clipboard/data formats, drag/drop, art/stock resources,"))) (:p "display/settings, accessibility and UI action simulation.") (:heading 3 "C4: Models, complex controls, and document frameworks") (:p (:code "Full C4 declaration checklist (coverage/phase-c4.md)")) (:list (:item (:p "[ ] Complete list/tree/tree-list/data-view/grid controls and all related models,"))) (:p "renderers, editors, selection, sorting, virtual data and event classes.") (:list (:item (:p "[ ] Complete headers/columns, image lists and item attributes."))) (:list (:item (:p "[ ] Complete document/view, document MDI, command/undo and persistent-object APIs."))) (:heading 3 "C5: Drawing, images, graphics, and printing") (:p (:code "Full C5 declaration checklist (coverage/phase-c5.md)")) (:list (:item (:p "[ ] Complete geometry/transforms, colours, pens/brushes/fonts, cursors/regions,"))) (:p "bitmap bundles/icons/images, image handlers, animation and raw pixel access.") (:list (:item (:p "[ ] Complete every DC/backend, graphics contexts/paths, overlays, native renderer,"))) (:p "text metrics, paint events and buffered drawing with scoped resource ownership.") (:list (:item (:p "[ ] Complete print/page setup/preview, print data and platform print integration."))) (:heading 3 "C6: Optional libraries, rich content, and integration") (:p (:code "Full C6 declaration checklist (coverage/phase-c6.md)")) (:list (:item (:p "[ ] Complete AUI docking, ribbons, property grids and related managers/events."))) (:list (:item (:p "[ ] Complete HTML, rich text and Styled Text Control, including editing models,"))) (:p "commands, styles, printing and callbacks.") (:list (:item (:p "[ ] Complete XML/XRC resource loading and custom handlers."))) (:list (:item (:p "[ ] Complete web views/handlers, media/sound, OpenGL contexts and rich tooltips."))) (:list (:item (:p "[ ] Extend component selection/builds beyond current " (:code "core") "/" (:code "base") ", and document"))) (:p "native dependencies, backend availability and packaging for each optional library.") (:heading 3 "C7: Platform extensions and remaining portability APIs") (:p (:code "Full C7 declaration checklist (coverage/phase-c7.md)")) (:list (:item (:p "[ ] Complete Windows-specific interface declarations, native-window embedding,"))) (:p "DDE, dial-up, joystick and power APIs on their applicable platforms.") (:list (:item (:p "[ ] Reconcile the interface-header inventory against upstream public headers,"))) (:p "generated API documentation, event/style tables and build options; inventory and phase any additional public widgets/functions discovered before closure.") (:list (:item (:p "[ ] Audit inherited APIs and all overloads, enum values, style combinations,"))) (:p "virtual overrides, callback signatures and ownership across every class.") (:list (:item (:p "[ ] Run binding, GUI, Unicode, callback/lifetime and packaged-application checks"))) (:p "on supported OS/Lisp combinations; record feature-specific skips and reasons.") (:list (:item (:p "[ ] Publish the supported API/feature matrix and resolve every remaining item"))) (:p "as implemented, equivalent Lisp mapping, or explicitly unsupported. Unsupported required APIs prevent claiming full coverage; they are not completed bindings.") (:heading 2 "Completion and maintenance") (:p "Focused generator/inventory verification (using the same extracted sources):") (:code-block "sh" "python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "Each phase closes only when its detailed inventory is reviewed and its required bindings have public Lisp exports, native/FFI mappings, matching documentation, required runnable examples, docset updates, and focused positive/error/lifetime/ event checks. Follow the " (:code "project implementation rule (../AGENTS.md)") " for every implementation change: build the Cadre-format version 1 docset in " (:code "docs/docset/") " (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "), containing the indexed reference for every implemented public wxlambda export, project guides and explained example sources together. Run the relevant examples, require zero problems from " (:code "docset:check-docset") ", and verify export coverage, links and Cadre discovery, symbol lookup and guide/example navigation. The docset is the primary documentation deliverable. The initial Phase 7 build prerequisite is implemented in " (:ref "guide/docs/DOCSET.md" "the docset tooling") "; maintain the generated artifact with each implementation change. Platform-only work must be verified on its supported platform; local macOS success cannot close Linux/Windows work. Existing Phase 3 hosted checks remain pending.") (:p "To reproduce the baseline inventory, extract the pinned release's " (:code "interface/") " directory and run:") (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "The generator is documentation-only and does not require an installed wxWidgets build. Multiline preprocessor directives are kept together so their parentheses do not swallow following classes or function declarations. It preserves source declarations rather than attempting C++ semantic resolution; declaration fragments and helper tokens intentionally remain visible. Compare the resulting header hashes with the committed manifest when verifying the same source version. Update " (:code "docs/coverage/status.json") " when implementing bindings; regeneration preserves those marks in the function lists and class index. Do not edit generated checkboxes directly. A new upstream version requires reviewing and migrating the exact declaration mappings before regeneration."))))
(:entry "guide/docs/coverage/README.md" :names ("docs/coverage/README.md" "README") :kind :guide :kind-name "Guide" :summary "docs/coverage/README.md" :sections (("Guide" (:heading 1 "wxWidgets coverage summary") (:p "Generated by " (:code "tools/coverage_inventory.py") " from wxWidgets 3.2.12 interface headers and " (:code "status.json (status.json)") ". " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "Coverage goal and status rules") ".") (:p "The goal is complete wxWidgets coverage. Every pending entry and the unsupported portion of every partial entry remains required work. A bounded release or a completed slice does not complete this inventory. Required APIs recorded as unsupported still prevent a full-coverage claim.") (:p "Counts are source-inventory tasks, including declarations, overloads, classes, styles and event tables; they are not distinct API counts or percent completion. Context is excluded from tasks. Class-definition counts overlap declaration tasks and must not be added to them. Full coverage also requires the upstream public-header/documentation reconciliation and platform verification in C7.") (:heading 2 "Phases") (:table :header (("Phase") ("Headers") ("Tasks") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "C1: Foundation, values, application, events, and base utilities (phase-c1.md)")) ("119") ("5292") ("0") ("8") ("5284") ("26")) (((:code "C2: Windows, layout, basic controls, and input (phase-c2.md)")) ("82") ("2862") ("23") ("39") ("2800") ("0")) (((:code "C3: Dialogs, navigation, menus, and application services (phase-c3.md)")) ("57") ("1875") ("0") ("0") ("1875") ("0")) (((:code "C4: Models, complex controls, and document frameworks (phase-c4.md)")) ("20") ("2328") ("0") ("0") ("2328") ("4")) (((:code "C5: Drawing, images, graphics, and printing (phase-c5.md)")) ("52") ("2245") ("0") ("0") ("2245") ("0")) (((:code "C6: Optional libraries, rich content, and integration (phase-c6.md)")) ("57") ("8912") ("0") ("0") ("8912")