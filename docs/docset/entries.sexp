(:entry "example/examples/application-events.lisp" :names ("examples/application-events.lisp" "application-events") :kind :example :kind-name "Example" :summary "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows." :sections (("Usage" (:p "The same button callback reports native main-loop state when dispatched through the pending wx event queue and through RUN. The reusable exercise asserts both modes and cleans up handlers/windows.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp --eval '(wxlambda-application-events:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-application-events:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-application-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-application-events)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Application event dispatch\"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label \"Waiting for an event\"))
         (button (wxlambda:make-button panel :label \"Inspect dispatch state\"))
         (clicks 0)
         (loop-running nil)
         (callback (lambda ()
                     (incf clicks)
                     (setf loop-running (wxlambda:main-loop-running-p))
                     (setf (wxlambda:label-text caption)
                           (format nil \"Event ~D; native main loop: ~S\"
                                   clicks loop-running)))))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel caption)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button callback)
    (wxlambda:show-window frame)
    (values frame button callback (lambda () (list clicks loop-running)))))

(defun exercise ()
  \"Run the same callback through explicit pending dispatch and the main loop.\"
  (multiple-value-bind (frame button callback state) (open-window)
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:queue-click button)
    (assert (wxlambda:pending-events-p))
    (wxlambda:process-pending-events)
    (assert (equal '(1 nil) (funcall state)))
    (wxlambda:on-click button (lambda () (funcall callback) (wxlambda:stop)))
    (wxlambda:queue-click button)
    (wxlambda:run)
    (assert (equal '(2 t) (funcall state)))
    (assert (not (wxlambda:main-loop-running-p)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/form-app.lisp" :names ("examples/form-app.lisp" "form-app") :kind :example :kind-name "Example" :summary "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically." :sections (("Usage" (:p "Reusable form implementation; load it then call WXLAMBDA-FORM:START. The form.lisp launcher does this automatically.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form-app.lisp --eval '(wxlambda-form:start)'")) ("Source" (:code-block "lisp" ";;; Reusable form application. FORM.LISP launches it; START-LIVE enables editing.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-form
  (:use #:cl)
  (:export #:start #:start-live #:open-window #:close-window #:unbind-handlers
           #:submit-form #:set-submit-action #:*name* #:*greeting* #:*style*
           #:*status* #:*submit* #:*reopen*))
(in-package #:wxlambda-form)

(defvar *frame* nil)
(defvar *root* nil)
(defvar *name* nil)
(defvar *greeting* nil)
(defvar *style* nil)
(defvar *status* nil)
(defvar *submit* nil)
(defvar *reopen* nil)
(defvar *name-value* \"Ada\")
(defvar *greeting-value* t)
(defvar *style-value* 0)

(defun remember-input ()
  ;; Cleanup can also run after only part of the form was constructed.
  (when (and *name* *greeting* *style*)
    (setf *name-value* (wxlambda:text *name*)
          *greeting-value* (wxlambda:checked-p *greeting*)
          *style-value* (wxlambda:selection *style*))))

(defun edited ()
  (remember-input)
  (setf (wxlambda:label-text *status*) \"Edited; submit to preview\")
  (wxlambda:layout-window *root*))

(defun submit-form ()
  (remember-input)
  (setf (wxlambda:label-text *status*) (format nil (cond ((not *greeting-value*) \"Name: ~A\")
                      ((eql *style-value* 1) \"Good day, ~A.\")
                      (t \"Hello, ~A!\"))
            *name-value*))
  (wxlambda:layout-window *root*))

(defun set-submit-action (&optional (action 'submit-form))
  \"Replace the current submit handler. Symbol actions pick up function redefinitions.\"
  (wxlambda:on-click *submit* (lambda () (funcall action))))

(defun unbind-handlers ()
  \"Release all registered closures before destroying this form.\"
  (loop for (control unbind) in
        (list (list *name* #'wxlambda:off-text-change)
              (list *greeting* #'wxlambda:off-toggle)
              (list *style* #'wxlambda:off-selection)
              (list *submit* #'wxlambda:off-click)
              (list *reopen* #'wxlambda:off-click))
        when control do
          ;; If the user already closed the native frame, stale handles cannot
          ;; be unbound. Those closures remain rooted until session cleanup.
          (handler-case (funcall unbind control)
            (wxlambda:native-error () nil))))

(defun close-window ()
  (when *frame*
    (handler-case (remember-input)
      (wxlambda:native-error () nil))
    (unbind-handlers)
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *root* nil *name* nil *greeting* nil *style* nil
          *status* nil *submit* nil *reopen* nil)))

(defun open-window ()
  \"Recreate the form within the current session, retaining its input values.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"A Lisp form\" :width 560 :height 400)
        *root* (wxlambda:make-panel *frame*))
  (let* ((name-row (wxlambda:make-panel *root*))
         (name-label (wxlambda:make-label name-row :label \"Name\"))
         (style-row (wxlambda:make-panel *root*))
         (style-label (wxlambda:make-label style-row :label \"Style\"))
         (actions (wxlambda:make-panel *root*)))
    (setf *name* (wxlambda:make-text name-row :value *name-value*)
          *greeting* (wxlambda:make-checkbox *root* :label \"Include a greeting\"
                                           :checked *greeting-value*)
          *style* (wxlambda:make-choice style-row :items '(\"Friendly\" \"Formal\")
                                      :selection *style-value*)
          *status* (wxlambda:make-label *root* :label \"Ready\")
          *submit* (wxlambda:make-button actions :label \"Submit\")
          *reopen* (wxlambda:make-button actions :label \"Reopen form\"))
    (wxlambda:make-column *frame*)
    (wxlambda:add-child *frame* *root* :border 0 :proportion 1)
    (wxlambda:make-column *root*)
    (wxlambda:make-row name-row)
    (wxlambda:add-child name-row name-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer name-row 12)
    (wxlambda:add-child name-row *name* :border 0 :proportion 1)
    (wxlambda:make-row style-row)
    (wxlambda:add-child style-row style-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer style-row 12)
    (wxlambda:add-child style-row *style* :border 0 :proportion 1)
    (wxlambda:make-row actions)
    (wxlambda:add-stretch actions)
    (wxlambda:add-child actions *reopen* :border 0 :expand nil)
    (wxlambda:add-spacer actions 12)
    (wxlambda:add-child actions *submit* :border 0 :expand nil)
    (dolist (child (list name-row *greeting* style-row *status*))
      (wxlambda:add-child *root* child :border 12))
    (wxlambda:add-stretch *root*)
    (wxlambda:add-child *root* actions :border 12)
    (wxlambda:on-text-change *name* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-toggle *greeting* (lambda (event) (declare (ignore event)) (edited)))
    (wxlambda:on-selection *style* (lambda (event) (declare (ignore event)) (edited)))
    (set-submit-action)
    (wxlambda:on-click *reopen* (lambda () (open-window)))
    (wxlambda:show-window *frame*)))

(defun start ()
  \"Run normally until the last frame closes. Restart Lisp for another session.\"
  (wxlambda:with-application ()
    (unwind-protect (progn (open-window) (wxlambda:run))
      (close-window))))

(defun start-live (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter the terminal application REPL. STOP/EOF ends this one GUI session.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/form.lisp" :names ("examples/form.lisp" "form") :kind :example :kind-name "Example" :summary "Run the representative form with text, checkbox and choice updates. Close the frame to exit." :sections (("Usage" (:p "Run the representative form with text, checkbox and choice updates. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp")) ("Source" (:code-block "lisp" ";;; Ordinary startup: load this file to run the form until its window closes.
(load (merge-pathnames \"form-app.lisp\" *load-truename*))
(wxlambda-form:start)
"))))
(:entry "example/examples/gauge.lisp" :names ("examples/gauge.lisp") :kind :example :kind-name "Example" :summary "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up." :sections (("Usage" (:p "A GAUGE subclass with default initargs and a custom step slot; buttons advance determinate progress or request indeterminate pulsing. The exercise runs both callbacks and cleans up.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp --eval '(wxlambda-gauge:start)'")) ("Source" (:code-block "lisp" ";;; Load and call (wxlambda-gauge:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")
(defpackage #:wxlambda-gauge
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-gauge)

(defclass progress (wxlambda:gauge)
  ((step :initarg :step :reader step-size)
   (completed :initform 0 :accessor completed))
  (:default-initargs :range 100 :step 25))

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Progress gauge\"))
         (panel (wxlambda:make-panel frame))
         (gauge (make-instance 'progress :parent panel))
         (advance (wxlambda:make-button panel :label \"Advance / restart\"))
         (pulse (wxlambda:make-button panel :label \"Indeterminate pulse\")))
    (wxlambda:make-column panel)
    (dolist (child (list gauge advance pulse)) (wxlambda:add-child panel child))
    (wxlambda:on-click advance
      (lambda ()
        ;; Pulse readings are animation state on some ports, not completed work.
        (setf (completed gauge)
              (if (>= (completed gauge) (wxlambda:gauge-range gauge))
                  0
                  (min (wxlambda:gauge-range gauge)
                       (+ (completed gauge) (step-size gauge)))))
        (setf (wxlambda:gauge-value gauge) (completed gauge))))
    (wxlambda:on-click pulse (lambda () (wxlambda:pulse-gauge gauge)))
    (wxlambda:show-window frame)
    (values frame gauge advance pulse)))

(defun exercise ()
  \"Run both interactive callbacks, restore determinate progress, and clean up.\"
  (multiple-value-bind (frame gauge advance pulse) (open-window)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 25 (wxlambda:gauge-value gauge)))
    (wxlambda:queue-click pulse)
    (wxlambda:process-events)
    (wxlambda:queue-click advance)
    (wxlambda:process-events)
    (assert (= 50 (wxlambda:gauge-value gauge)))
    (dotimes (i 3)
      (wxlambda:queue-click advance)
      (wxlambda:process-events))
    (assert (zerop (wxlambda:gauge-value gauge)))
    (wxlambda:off-click advance)
    (wxlambda:off-click pulse)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
"))))
(:entry "example/examples/hello.lisp" :names ("examples/hello.lisp" "hello") :kind :example :kind-name "Example" :summary "Editable Unicode text and button callbacks with copied event payloads. Close the frame to exit." :sections (("Usage" (:p "Editable Unicode text and button callbacks with copied event payloads. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Hello from Common Lisp\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hello, wxWidgets — λ\"))
         (button (wxlambda:make-button panel :label \"Click me\"))
         (clicks 0))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text)
    (wxlambda:add-child panel button)
    (wxlambda:on-text-change text
      (lambda (event)
        (format t \"Text edited: ~A~%\" (wxlambda:event-text event))))
    (wxlambda:on-click button
      (lambda (event)
        (assert (eq button (wxlambda:event-source event)))
        (format t \"Text before click: ~A~%\" (wxlambda:text text))
        (setf (wxlambda:text text :notify t) (format nil \"Clicked ~D times\" (incf clicks))))
      :with-event t)
    (wxlambda:show-window frame)
    (wxlambda:run)))
"))))
(:entry "example/examples/layout.lisp" :names ("examples/layout.lisp" "layout") :kind :example :kind-name "Example" :summary "Nested panel rows and columns with spacing and alignment. Close the frame to exit." :sections (("Usage" (:p "Nested panel rows and columns with spacing and alignment. Close the frame to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp")) ("Source" (:code-block "lisp" "(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Rows, columns, and spacing\" :width 640 :height 360))
         (root (wxlambda:make-panel frame))
         (input-row (wxlambda:make-panel root))
         (footer (wxlambda:make-panel root))
         (input (wxlambda:make-text input-row :value \"Edit this text\"))
         (apply-button (wxlambda:make-button input-row :label \"Apply\"))
         (output (wxlambda:make-text root :value \"Click Apply to copy the input here\"))
         (close-button (wxlambda:make-button footer :label \"Close\")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame root :border 0 :proportion 1)
    (wxlambda:make-column root)
    (wxlambda:make-row input-row)
    (wxlambda:add-child input-row input :border 0 :proportion 1)
    (wxlambda:add-spacer input-row 12)
    (wxlambda:add-child input-row apply-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root input-row :border 12)
    (wxlambda:add-child root output :border 12)
    (wxlambda:add-stretch root)
    (wxlambda:make-row footer)
    (wxlambda:add-stretch footer)
    (wxlambda:add-child footer close-button :border 0 :expand nil :align :center)
    (wxlambda:add-child root footer :border 12)
    (wxlambda:on-click apply-button
      (lambda () (setf (wxlambda:text output) (wxlambda:text input))))
    (wxlambda:on-click close-button (lambda () (wxlambda:destroy-window frame)))
    (wxlambda:show-window frame)
    (wxlambda:run)))
"))))
(:entry "example/examples/live.lisp" :names ("examples/live.lisp" "live") :kind :example :kind-name "Example" :summary "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit." :sections (("Usage" (:p "Enter the cooperative application REPL with window replacement and live callback redefinition. Use (wxlambda:stop) or EOF to exit.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/live.lisp --eval '(wxlambda-live:start)'")) ("Source" (:code-block "lisp" ";;; Load this file, then call (wxlambda-live:start) from a terminal REPL.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-live
  (:use #:cl)
  (:export #:start #:open-window #:close-window #:clicked #:*text* #:*button*))
(in-package #:wxlambda-live)

(defvar *frame* nil)
(defvar *text* nil)
(defvar *button* nil)
(defvar *clicks* 0)

(defun clicked ()
  (setf (wxlambda:text *text*) (format nil \"Clicked ~D times\" (incf *clicks*))))

(defun close-window ()
  \"Release registered closures before destroying the controls they reference.\"
  (when *frame*
    ;; A user may already have closed the native window. Its stale handles
    ;; cannot be unbound; session cleanup releases those retained closures.
    (handler-case (wxlambda:off-click *button*)
      (wxlambda:native-error () nil))
    (handler-case (wxlambda:destroy-window *frame*)
      (wxlambda:native-error () nil))
    (setf *frame* nil *text* nil *button* nil)))

(defun open-window ()
  \"Replace the current window within the active session.\"
  (close-window)
  (setf *frame* (wxlambda:make-frame :title \"Live Lisp development\")
        *text* (wxlambda:make-text *frame* :value \"Redefine WXLAMBDA-LIVE:CLICKED\")
        *button* (wxlambda:make-button *frame* :label \"Run current CLICKED\"))
  (wxlambda:make-column *frame*)
  (wxlambda:add-child *frame* *text*)
  (wxlambda:add-child *frame* *button*)
  ;; Resolve the function on each click so DEFUN changes take effect live.
  (wxlambda:on-click *button* (lambda () (clicked)))
  (wxlambda:show-window *frame*))

(defun start (&key (input *standard-input*) (output *standard-output*) (on-error :debug))
  \"Enter one GUI session. Use WXLAMBDA:STOP or EOF; restart Lisp for another.\"
  (wxlambda:with-repl-application (:input input :output output :on-error on-error)
    (open-window)))
"))))
(:entry "example/examples/window-metadata.lisp" :names ("examples/window-metadata.lisp" "window-metadata") :kind :example :kind-name "Example" :summary "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup." :sections (("Usage" (:p "Direct MAKE-INSTANCE construction of a FRAME subclass. A generic SETF AFTER method counts title changes while a button callback updates the logical name and Unicode title; the exercise verifies state, method dispatch and cleanup.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp --eval '(wxlambda-window-metadata:start)'")) ("Source" (:code-block "lisp" ";;; Load this file and call (wxlambda-window-metadata:start).
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-metadata
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-metadata)

(defclass tracking-frame (wxlambda:frame)
  ((title-updates :initform 0 :accessor title-updates)))

(defmethod (setf wxlambda:frame-title) :after (value (frame tracking-frame))
  (declare (ignore value))
  (incf (title-updates frame)))

(defun open-window ()
  (let* ((frame (make-instance 'tracking-frame :title \"Window metadata\"))
         (panel (wxlambda:make-panel frame))
         (button (wxlambda:make-button panel :label \"Rename window and update title\"))
         (changes 0))
    (setf (wxlambda:window-name frame) \"metadata-example\")
    (wxlambda:make-column panel)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda ()
        (incf changes)
        (setf (wxlambda:window-name frame) (format nil \"metadata-~D\" changes))
        (setf (wxlambda:frame-title frame) (format nil \"Updated ~D — λ 日本語 😀\" changes))))
    (wxlambda:show-window frame)
    (values frame button)))

(defun exercise ()
  \"Exercise the same callback as the interactive example, then clean up.\"
  (multiple-value-bind (frame button) (open-window)
    (assert (string= \"metadata-example\" (wxlambda:window-name frame)))
    (wxlambda:queue-click button)
    (wxlambda:process-events)
    (assert (string= \"metadata-1\" (wxlambda:window-name frame)))
    (assert (string= \"Updated 1 — λ 日本語 😀\" (wxlambda:frame-title frame)))
    (assert (= 1 (title-updates frame)))
    (wxlambda:off-click button)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
(:entry "example/examples/window-state.lisp" :names ("examples/window-state.lisp" "window-state") :kind :example :kind-name "Example" :summary "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input." :sections (("Usage" (:p "Toggle text visibility and input using actual button callbacks. The reusable exercise runs the same callbacks without waiting for manual input.") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp --eval '(wxlambda-window-state:start)'")) ("Source" (:code-block "lisp" ";;; Reusable state example. Run (wxlambda-window-state:start), or use the
;;; noninteractive exercise called by tests/window-state.lisp.
(require :asdf)
(load (merge-pathnames \"../wxlambda.asd\" *load-truename*))
(asdf:load-system \"wxlambda\")

(defpackage #:wxlambda-window-state
  (:use #:cl)
  (:export #:start #:open-window #:exercise))
(in-package #:wxlambda-window-state)

(defun open-window ()
  (let* ((frame (wxlambda:make-frame :title \"Window state\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hide/show and disable/enable me\"))
         (visibility (wxlambda:make-button panel :label \"Toggle text visibility\"))
         (input (wxlambda:make-button panel :label \"Toggle text input\")))
    (wxlambda:make-column panel)
    (dolist (child (list text visibility input)) (wxlambda:add-child panel child))
    (wxlambda:on-click visibility
      (lambda ()
        (wxlambda:show-window text (not (wxlambda:shown-p text)))
        (wxlambda:layout-window panel)))
    (wxlambda:on-click input
      (lambda () (wxlambda:enable-window text (not (wxlambda:enabled-p text)))))
    (wxlambda:show-window frame)
    (values frame panel text visibility input)))

(defun exercise ()
  \"Run the example's actual callbacks, then release handlers and close it.\"
  (multiple-value-bind (frame panel text visibility input) (open-window)
    (declare (ignore panel))
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (not (wxlambda:shown-p text)))
    (assert (not (wxlambda:enabled-p text)))
    (wxlambda:queue-click visibility)
    (wxlambda:queue-click input)
    (wxlambda:process-events)
    (assert (wxlambda:shown-p text))
    (assert (wxlambda:enabled-p text))
    (wxlambda:off-click visibility)
    (wxlambda:off-click input)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application ()
    (open-window)
    (wxlambda:run)))
"))))
