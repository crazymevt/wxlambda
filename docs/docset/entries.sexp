(:entry "api/make-text" :names ("make-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-text parent &rest initargs &key (class 'wxlambda:text-control) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional initial VALUE string. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTextCtrl constructor (wxWidgets 3.2)."))))
(:entry "api/native-error" :names ("native-error") :kind :condition :kind-name "Condition" :package "WXLAMBDA" :summary "Signals native bridge failures instead of exposing C++ exceptions or native pointers." :sections (("Syntax" (:code-block "lisp" "(handler-case form (wxlambda:native-error (condition) ...))")) ("Arguments" (:p "Condition class; native diagnostic text is available through its printed report.")) ("Returns" (:p "A Lisp ERROR condition.")) ("Description" (:p "Signals native bridge failures instead of exposing C++ exceptions or native pointers.")) ("Errors and scope" (:p "Catch with HANDLER-CASE or HANDLER-BIND. Lisp argument and callback conditions retain their own condition types.")) ("wxWidgets" (:p "Bridge exception translation."))))
(:entry "api/off-click" :names ("off-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-click button)")) ("Arguments" (:p "BUTTON is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/off-selection" :names ("off-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-selection choice)")) ("Arguments" (:p "CHOICE is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
