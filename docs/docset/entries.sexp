(:entry "api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-child parent child &key (proportion 0) (border 8) (expand t) (align :start))")) ("Arguments" (:p "PARENT has a row/column; CHILD belongs to it; PROPORTION >= 0, BORDER >= 0, EXPAND boolean, ALIGN :START/:CENTER/:END.")) ("Returns" (:p "CHILD.")) ("Description" (:p "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxSizer::Add"))))
(:entry "api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-spacer parent size)")) ("Arguments" (:p "PARENT has a row/column; SIZE is nonnegative.")) ("Returns" (:p "PARENT.")) ("Description" (:p "Add fixed layout-axis spacing and relayout the parent.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxBoxSizer::AddSpacer"))))
(:entry "api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-stretch parent &key (proportion 1))")) ("Arguments" (:p "PARENT has a row/column; PROPORTION is positive (default 1).")) ("Returns" (:p "PARENT.")) ("Description" (:p "Add flexible layout-axis spacing and relayout the parent.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxSizer::AddStretchSpacer"))))
(:entry "api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:button")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxButton with click handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxButton (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:button :parent parent :label \"Button\")") (:p "PARENT is required; LABEL defaults to Button. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :sections (("Syntax" (:code-block "lisp" "(wxlambda:call-with-application function)")) ("Arguments" (:p "FUNCTION is a zero-argument function.")) ("Returns" (:p "The values returned by FUNCTION.")) ("Description" (:p "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit.")) ("Errors and scope" (:p "The Lisp must run on its initial/main thread; nested or repeated application sessions are rejected. Setup/native failures signal NATIVE-ERROR; body conditions propagate.")) ("wxWidgets" (:p "wxEntryStart / wxEntryCleanup"))))
(:entry "api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :sections (("Syntax" (:code-block "lisp" "wxlambda:checkbox")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for a two-state wxCheckBox.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxCheckBox (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:checkbox :parent parent :label \"\" :checked nil)") (:p "PARENT is required; LABEL defaults to empty, CHECKED to NIL. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the boolean checkbox state." :sections (("Syntax" (:code-block "lisp" "(wxlambda:checked-p checkbox &key notify)")) ("Arguments" (:p "CHECKBOX is a live two-state checkbox. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read the boolean checkbox state.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxCheckBox::GetValue")) ("SETF" (:code-block "lisp" "(setf (wxlambda:checked-p checkbox :notify notify) new-value)") (:p "Store generalized boolean state; reads normalize it to T/NIL, while SETF returns the supplied value. :NOTIFY T emits a synchronous toggle event. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:choice")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxChoice with selection handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxChoice (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:choice :parent parent :items nil :selection nil)") (:p "PARENT is required; ITEMS defaults to NIL, SELECTION to NIL. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs." :sections (("Syntax" (:code-block "lisp" "(wxlambda:destroy-window window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T after the destruction request.")) ("Description" (:p "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Destroy"))))
(:entry "api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :sections (("Syntax" (:code-block "lisp" "(wxlambda:enable-window window &optional (enable t))")) ("Arguments" (:p "WINDOW is live; optional ENABLE is a generalized boolean (default T).")) ("Returns" (:p "WINDOW, then a boolean indicating whether its native enabled state changed.")) ("Description" (:p "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Enable(bool) / Disable() equivalent (wxWidgets 3.2)."))))
(:entry "api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable." :sections (("Syntax" (:code-block "lisp" "(wxlambda:enabled-p window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::IsEnabled (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:enabled-p window) new-value)") (:p "Assign the input-enabled state; return the supplied value and a second native changed-state flag. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, source, text, checked state and selection. Snapshot strings survive later callbacks and window destruction." :sections (("Syntax" (:code-block "lisp" "wxlambda:event")) ("Arguments" (:p "Snapshot type created by callbacks, without a public constructor.")) ("Returns" (:p "Lisp-owned event value.")) ("Description" (:p "Read-only event snapshot: kind, source, text, checked state and selection. Snapshot strings survive later callbacks and window destruction.")) ("Errors and scope" (:p "Use only the exported predicate/accessors; native event objects do not escape callbacks.")) ("wxWidgets" (:p "wxCommandEvent snapshot."))))
(:entry "api/event-checked-p" :names ("event-checked-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read toggle state; NIL also applies to non-toggle events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-checked-p event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read toggle state; NIL also applies to non-toggle events.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-kind" :names ("event-kind") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the event kind." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-kind event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p ":CLICK, :TEXT-CHANGE, :TOGGLE or :SELECTION.")) ("Description" (:p "Read the event kind.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-p object)")) ("Arguments" (:p "OBJECT is any Lisp value.")) ("Returns" (:p "T for an EVENT, otherwise NIL.")) ("Description" (:p "Test whether an object is a Lisp-owned event snapshot.")) ("Errors and scope" (:p "No GUI session required.")) ("wxWidgets" (:p "Lisp snapshot predicate."))))
(:entry "api/event-selection" :names ("event-selection") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read choice selection; NIL means no selection or a non-selection event." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-selection event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p "Zero-based index or NIL.")) ("Description" (:p "Read choice selection; NIL means no selection or a non-selection event.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the source object; its native handle may subsequently be destroyed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-source event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p "The original source Lisp control object.")) ("Description" (:p "Read the source object; its native handle may subsequently be destroyed.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-text" :names ("event-text") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the copied text payload." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-text event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p "Independent string for text-change events; otherwise NIL.")) ("Description" (:p "Read the copied text payload.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :sections (("Syntax" (:code-block "lisp" "wxlambda:frame")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxFrame, including frame-specific title methods.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxFrame (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:frame)") (:p "TITLE string, WIDTH 480 and HEIGHT 240; default title is wxlambda. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :sections (("Syntax" (:code-block "lisp" "(wxlambda:frame-title frame)")) ("Arguments" (:p "FRAME is a live frame.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Only wxFrame receivers are currently exposed; panels and other controls signal NATIVE-ERROR. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTopLevelWindow::GetTitle (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:frame-title frame) new-value)") (:p "Update the frame title. Other top-level receiver types remain future work. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :sections (("Syntax" (:code-block "lisp" "wxlambda:gauge")) ("Arguments" (:p "Native-backed WINDOW subclass. Required :PARENT; :RANGE defaults to 100, :VALUE to 0, :ORIENTATION to :HORIZONTAL.")) ("Returns" (:p "A gauge wrapper or Lisp subclass instance.")) ("Description" (:p "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge constructor (wxWidgets 3.2.12 baseline).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:gauge :parent parent :range 100 :value 0 :orientation :horizontal)") (:p "Subclass slot initargs and :DEFAULT-INITARGS are supported. Native properties are ready in subclass AFTER hooks. Failed managed initialization rolls back native allocation. Orientation is :HORIZONTAL or :VERTICAL and cannot be changed after construction."))))
(:entry "api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-range gauge)")) ("Arguments" (:p "GAUGE is a live gauge; SETF VALUE is an integer in [1, 2147483647].")) ("Returns" (:p "Positive integer maximum; SETF returns the supplied integer.")) ("Description" (:p "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::GetRange / SetRange / SetValue (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:gauge-range gauge) value)") (:p "A positive signed 32-bit integer. Progress becomes MIN(old native value, new range); no events. Zero ranges are intentionally unsupported."))))
(:entry "api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-value gauge)")) ("Arguments" (:p "GAUGE is a live gauge; SETF VALUE is an integer from 0 through GAUGE-RANGE.")) ("Returns" (:p "Integer progress; SETF returns the supplied integer.")) ("Description" (:p "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::GetValue / SetValue (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:gauge-value gauge) value)") (:p "VALUE must be an integer in [0, range]. Invalid updates preserve existing progress. No notification option."))))
(:entry "api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-vertical-p gauge)")) ("Arguments" (:p "GAUGE is a live gauge.")) ("Returns" (:p "T for vertical, NIL for horizontal.")) ("Description" (:p "Query construction orientation; this property has no writer.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::IsVertical (wxWidgets 3.2.12 baseline)."))))
(:entry "api/label" :names ("label") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxStaticText; label operations specialize on this class." :sections (("Syntax" (:code-block "lisp" "wxlambda:label")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxStaticText; label operations specialize on this class.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxStaticText (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:label :parent parent :label \"\")") (:p "PARENT is required; LABEL defaults to an empty string. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic syntax. Other control types are not accepted." :sections (("Syntax" (:code-block "lisp" "(wxlambda:label-text label)")) ("Arguments" (:p "LABEL is live static text.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read raw label text including mnemonic syntax. Other control types are not accepted.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxControl::GetLabel (wxStaticText only)")) ("SETF" (:code-block "lisp" "(setf (wxlambda:label-text label) new-value)") (:p "Assign static text and relayout its parent if necessary. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/layout-window" :names ("layout-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:layout-window window)")) ("Arguments" (:p "WINDOW is a live window.")) ("Returns" (:p "WINDOW.")) ("Description" (:p "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Layout"))))
(:entry "api/load-native-library" :names ("load-native-library") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF." :sections (("Syntax" (:code-block "lisp" "(wxlambda:load-native-library &optional path)")) ("Arguments" (:p "Optional PATH names the bridge; default searches build/ and then the system loader.")) ("Returns" (:p "T after successful load and ABI verification.")) ("Description" (:p "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF.")) ("Errors and scope" (:p "May be used before a GUI session. Loader and ABI failures signal Lisp errors.")) ("wxWidgets" (:p "Bridge-specific ABI loader."))))
(:entry "api/main-loop-running-p" :names ("main-loop-running-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate." :sections (("Syntax" (:code-block "lisp" "(wxlambda:main-loop-running-p )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "T while the native main loop runs, otherwise NIL.")) ("Description" (:p "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances.")) ("wxWidgets" (:p "wxAppConsole::IsMainLoopRunning (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-button" :names ("make-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-button parent &rest initargs &key (class 'wxlambda:button) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional LABEL string (default Button). :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxButton constructor (wxWidgets 3.2)."))))
(:entry "api/make-checkbox" :names ("make-checkbox") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-checkbox parent &rest initargs &key (class 'wxlambda:checkbox) &allow-other-keys)")) ("Arguments" (:p "PARENT; LABEL string and CHECKED generalized boolean. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxCheckBox constructor (wxWidgets 3.2)."))))
(:entry "api/make-choice" :names ("make-choice") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-choice parent &rest initargs &key (class 'wxlambda:choice) &allow-other-keys)")) ("Arguments" (:p "PARENT; ITEMS list of strings; SELECTION zero-based index or NIL. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxChoice constructor (wxWidgets 3.2)."))))
(:entry "api/make-column" :names ("make-column") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-column parent)")) ("Arguments" (:p "PARENT is a live window without a sizer.")) ("Returns" (:p "PARENT.")) ("Description" (:p "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxBoxSizer / wxWindow::SetSizer"))))
(:entry "api/make-frame" :names ("make-frame") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-frame &rest initargs &key (class 'wxlambda:frame) &allow-other-keys)")) ("Arguments" (:p "TITLE string; positive WIDTH and HEIGHT (defaults 480 and 240). :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process.")) ("wxWidgets" (:p "wxFrame constructor (wxWidgets 3.2)."))))
(:entry "api/make-gauge" :names ("make-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-gauge parent &rest initargs &key (class 'gauge) &allow-other-keys)")) ("Arguments" (:p "PARENT is a WINDOW; :CLASS defaults to GAUGE. :RANGE, :VALUE, :ORIENTATION and subclass initargs are forwarded.")) ("Returns" (:p "A new GAUGE instance of CLASS.")) ("Description" (:p "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge constructor (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-label" :names ("make-label") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-label parent &rest initargs &key (class 'wxlambda:label) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional LABEL string. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxStaticText constructor (wxWidgets 3.2)."))))
(:entry "api/make-panel" :names ("make-panel") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-panel parent &rest initargs &key (class 'wxlambda:panel) &allow-other-keys)")) ("Arguments" (:p "PARENT is a live window. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxPanel constructor (wxWidgets 3.2)."))))
