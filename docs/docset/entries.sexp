(:entry "api/add-child" :names ("add-child") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-child parent child &key (proportion 0) (border 8) (expand t) (align :start))")) ("Arguments" (:p "PARENT has a row/column; CHILD belongs to it; PROPORTION >= 0, BORDER >= 0, EXPAND boolean, ALIGN :START/:CENTER/:END.")) ("Returns" (:p "CHILD.")) ("Description" (:p "Add a child window to the layout. Non-start minor-axis alignment requires EXPAND NIL. Borders apply uniformly on four sides.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxSizer::Add"))))
(:entry "api/add-spacer" :names ("add-spacer") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add fixed layout-axis spacing and relayout the parent." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-spacer parent size)")) ("Arguments" (:p "PARENT has a row/column; SIZE is nonnegative.")) ("Returns" (:p "PARENT.")) ("Description" (:p "Add fixed layout-axis spacing and relayout the parent.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxBoxSizer::AddSpacer"))))
(:entry "api/add-stretch" :names ("add-stretch") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Add flexible layout-axis spacing and relayout the parent." :sections (("Syntax" (:code-block "lisp" "(wxlambda:add-stretch parent &key (proportion 1))")) ("Arguments" (:p "PARENT has a row/column; PROPORTION is positive (default 1).")) ("Returns" (:p "PARENT.")) ("Description" (:p "Add flexible layout-axis spacing and relayout the parent.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxSizer::AddStretchSpacer"))))
(:entry "api/application-handler" :names ("application-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Borrowed native identity with inherited binding, dispatch, liveness and enabled state. Direct construction and subclass construction are rejected; explicit destruction signals NATIVE-ERROR. Session cleanup owns the native wxApp." :sections (("Syntax" (:code-block "lisp" "wxlambda:application-handler")) ("Arguments" (:p "No public constructor; obtain the session view with CURRENT-APPLICATION-HANDLER.")) ("Returns" (:p "An EVENT-HANDLER subclass representing the managed wxApp.")) ("Description" (:p "Borrowed native identity with inherited binding, dispatch, liveness and enabled state. Direct construction and subclass construction are rejected; explicit destruction signals NATIVE-ERROR. Session cleanup owns the native wxApp.")) ("Errors and scope" (:p "One cached view in the active main-thread session. No native wxApp subclassing, replacement or ownership transfer; native session bindings exist but OS delivery remains unverified. Saved views reject native access outside the session.")) ("wxWidgets" (:p "wxApp / wxAppConsole::GetInstance and wxTheApp, managed instance only (wxWidgets 3.2.12 baseline).")) ("Construction" (:code-block "lisp" "(wxlambda:current-application-handler)") (:p "Obtain the cached borrowed application view. Direct MAKE-INSTANCE, subclass construction and MAKE-EVENT-HANDLER construction are forbidden; only session cleanup owns native wxApp destruction."))))
(:entry "api/bind-event" :names ("bind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors." :sections (("Syntax" (:code-block "lisp" "(wxlambda:bind-event source kind function &key id last-id with-context)")) ("Arguments" (:p "HANDLER is an EVENT-HANDLER/window; KIND is :CLICK, :TEXT-CHANGE, :TOGGLE, :SELECTION, :CLOSE, :QUERY-END-SESSION, :END-SESSION or a registered command/notify name. FUNCTION takes one immutable EVENT. ID defaults NIL (any); LAST-ID defaults NIL (exact ID when ID is given). WITH-CONTEXT defaults NIL; when true FUNCTION takes (EVENT CONTEXT) instead of just EVENT.")) ("Returns" (:p "A new independent EVENT-BINDING.")) ("Description" (:p "Register an observer without replacing any existing generic or control-specific registration. Signed 32-bit IDs are supported except -1 (reserved as native wxID_ANY; use NIL). LAST-ID requires ID and an ordered inclusive range. Observer bindings automatically Skip; contextual bindings start unskipped and control native Skip explicitly; relative callback order follows wxWidgets and is not a Lisp API guarantee. Failed registration releases temporary roots. Contextual access is limited to the innermost callback and expires at return, including on errors.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, userData, pushed handlers and worker-thread dispatch remain unbound. Session bindings accept only the borrowed application view or an isolated owned handler; windows reject. Real OS delivery remains unverified. Skipped application END_SESSION callbacks can reach process-exiting defaults. Session bindings on attached pushed handlers reject so a window tail cannot route them to app defaults.")) ("wxWidgets" (:p "wxEvtHandler::Bind member-method overload with a wxEvent base receiver; built-ins and registered command/notify tags, no userData."))))
(:entry "api/binding-active-p" :names ("binding-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract." :sections (("Syntax" (:code-block "lisp" "(wxlambda:binding-active-p binding)")) ("Arguments" (:p "BINDING is an EVENT-BINDING.")) ("Returns" (:p "T if still registered on a live receiver, NIL after unbinding or receiver destruction/requested disposal.")) ("Description" (:p "Query active-session registration and reap stale generic callback roots. Root pruning also runs at returned RUN/pump/notifying-setter boundaries and after explicit destruction. During a blocking RUN, native window closure may retain roots until a Lisp boundary or explicit unbinding. This does not change the control-specific callback-root contract.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, userData, pushed handlers and worker-thread dispatch remain unbound.")) ("wxWidgets" (:p "Bridge registration/weak-lifetime predicate for wxEvtHandler bindings."))))
(:entry "api/button" :names ("button") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxButton with click handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:button")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxButton with click handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxButton (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:button :parent parent :label \"Button\")") (:p "PARENT is required; LABEL defaults to Button. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/call-with-application" :names ("call-with-application") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit." :sections (("Syntax" (:code-block "lisp" "(wxlambda:call-with-application function)")) ("Arguments" (:p "FUNCTION is a zero-argument function.")) ("Returns" (:p "The values returned by FUNCTION.")) ("Description" (:p "Initialize a main-thread GUI session, call FUNCTION, and clean up on normal return or unwinding. RUN is explicit.")) ("Errors and scope" (:p "The Lisp must run on its initial/main thread; nested or repeated application sessions are rejected. Setup/native failures signal NATIVE-ERROR; body conditions propagate.")) ("wxWidgets" (:p "wxEntryStart / wxEntryCleanup"))))
(:entry "api/checkbox" :names ("checkbox") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a two-state wxCheckBox." :sections (("Syntax" (:code-block "lisp" "wxlambda:checkbox")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for a two-state wxCheckBox.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxCheckBox (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:checkbox :parent parent :label \"\" :checked nil)") (:p "PARENT is required; LABEL defaults to empty, CHECKED to NIL. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/checked-p" :names ("checked-p" "(setf checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the boolean checkbox state." :sections (("Syntax" (:code-block "lisp" "(wxlambda:checked-p checkbox &key notify)")) ("Arguments" (:p "CHECKBOX is a live two-state checkbox. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read the boolean checkbox state.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxCheckBox::GetValue")) ("SETF" (:code-block "lisp" "(setf (wxlambda:checked-p checkbox :notify notify) new-value)") (:p "Store generalized boolean state; reads normalize it to T/NIL, while SETF returns the supplied value. :NOTIFY T emits a synchronous toggle event. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/choice" :names ("choice") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxChoice with selection handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:choice")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxChoice with selection handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxChoice (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:choice :parent parent :items nil :selection nil)") (:p "PARENT is required; ITEMS defaults to NIL, SELECTION to NIL. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/clone-event" :names ("clone-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Call native Clone for exact wxCommandEvent/wxNotifyEvent/wxCloseEvent with supported tags, clear native origin, preserve supported values and reject borrowed userdata/client pointers. Source and clone are independently mutable/disposable. Capture effective command GetString before clearing origin, so lazy wxEVT_TEXT payload becomes detached value data." :sections (("Syntax" (:code-block "lisp" "(wxlambda:clone-event context &rest initargs &key class &allow-other-keys)")) ("Arguments" (:p "EVENT is a live OWNED-EVENT or current innermost EVENT-CONTEXT. CLASS and subclass slot initargs are forwarded; payload overrides reject.")) ("Returns" (:p "A new detached OWNED-EVENT or subclass.")) ("Description" (:p "Call native Clone for exact wxCommandEvent/wxNotifyEvent/wxCloseEvent with supported tags, clear native origin, preserve supported values and reject borrowed userdata/client pointers. Source and clone are independently mutable/disposable. Capture effective command GetString before clearing origin, so lazy wxEVT_TEXT payload becomes detached value data.")) ("Errors and scope" (:p "Active main-thread session. Expired/suspended contexts and unsupported native classes reject. Snapshots have no method. No origin retention, arbitrary native ownership or source transfer.")) ("wxWidgets" (:p "wxEvent::Clone with bounded detached ownership (wxWidgets 3.2.12 baseline)."))))
(:entry "api/close-window" :names ("close-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction. A callback can explicitly mutate CanVeto through SETF EVENT-CAN-VETO-P; FORCE is not an immutable capability limit." :sections (("Syntax" (:code-block "lisp" "(wxlambda:close-window frame &key force)")) ("Arguments" (:p "FRAME is a live FRAME. Optional FORCE defaults NIL; true initializes native CanVeto false.")) ("Returns" (:p "Native close acceptance as T/NIL; not a destruction/liveness guarantee.")) ("Description" (:p "Synchronously generate the frame close request via wxWindow::Close(force). A vetoed request returns NIL. A consuming contextual callback may return acceptance T without deleting anything, even for FORCE. Set Skip true to delegate to native default closing when appropriate. Callback conditions re-signal at this Lisp boundary; a handled nested condition does not stop RUN. Use DESTROY-WINDOW for explicit destruction. A callback can explicitly mutate CanVeto through SETF EVENT-CAN-VETO-P; FORCE is not an immutable capability limit.")) ("Errors and scope" (:p "Active main-thread session required for native context or frame operations. Expired/suspended contexts and invalid/deleting frames signal NATIVE-ERROR. Saved snapshots need no session. Close and registered notify families permit checked veto. Native control-specific notify subclasses, validated OS session delivery and arbitrary event classes remain open.")) ("wxWidgets" (:p "wxWindow::Close(bool), wxFrame receivers only (wxWidgets 3.2.12 baseline)."))))
(:entry "api/current-application-handler" :names ("current-application-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups." :sections (("Syntax" (:code-block "lisp" "(wxlambda:current-application-handler )")) ("Arguments" (:p "None.")) ("Returns" (:p "The EQ-identical APPLICATION-HANDLER view for the current session.")) ("Description" (:p "Borrow the bridge application event handler without constructing or taking ownership of wxApp. Native main-thread/session validation runs on every lookup, including cached lookups.")) ("Errors and scope" (:p "Active main-thread session required; otherwise NATIVE-ERROR. One session per process. No external application adoption; native session bindings exist but OS delivery remains unverified.")) ("wxWidgets" (:p "wxAppConsole::GetInstance / wxTheApp, bridge-managed application only (wxWidgets 3.2.12 baseline)."))))
(:entry "api/delete-pending-events" :names ("delete-pending-events") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Delete queued native events without invoking callbacks; bindings and other handler queues remain intact. Synchronize wxApp pending-handler membership after deletion. Transferred input wrappers remain consumed; later queueing/posting still works." :sections (("Syntax" (:code-block "lisp" "(wxlambda:delete-pending-events handler)")) ("Arguments" (:p "HANDLER is a live non-application EVENT-HANDLER/window.")) ("Returns" (:p "T after deleting the target queue, including an empty queue.")) ("Description" (:p "Delete queued native events without invoking callbacks; bindings and other handler queues remain intact. Synchronize wxApp pending-handler membership after deletion. Transferred input wrappers remain consumed; later queueing/posting still works.")) ("Errors and scope" (:p "Active main-thread GUI session at a non-dispatch boundary required. Borrowed APPLICATION-HANDLER, RUN/pump/callback use and invalid/stale receivers reject. No application-wide deletion, count, cancellation rollback or per-handler pending query/processing is supplied.")) ("wxWidgets" (:p "wxEvtHandler::DeletePendingEvents plus native pending-handler-list synchronization (wxWidgets 3.2.12 baseline)."))))
(:entry "api/destroy-event" :names ("destroy-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Release this independent native event. Copies already queued/processing remain valid; repeated destruction rejects. Session cleanup releases undisposed owned events, even if the Lisp wrapper was collected." :sections (("Syntax" (:code-block "lisp" "(wxlambda:destroy-event event)")) ("Arguments" (:p "EVENT is a live OWNED-EVENT.")) ("Returns" (:p "T after immediate native deletion.")) ("Description" (:p "Release this independent native event. Copies already queued/processing remain valid; repeated destruction rejects. Session cleanup releases undisposed owned events, even if the Lisp wrapper was collected.")) ("Errors and scope" (:p "Active main-thread session required; dead/invalid native resource or failed wrapper signals NATIVE-ERROR. No snapshot/context destruction or transfer of an event already owned by wxWidgets. A source consumed by TRANSFER-EVENT is no longer bridge-owned and cannot be destroyed through its former wrapper.")) ("wxWidgets" (:p "Bridge unique ownership of supported wxEvent instances (wxWidgets 3.2.12 baseline)."))))
(:entry "api/destroy-event-handler" :names ("destroy-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window and application identities are borrowed and reject this operation; use DESTROY-WINDOW for windows. Only session cleanup destroys the application. Destroying a linked standalone handler during a callback now rejects; outside callbacks native destruction splices reciprocal neighbors. Unlinked callback destruction retains existing deferral. Attached handlers are removed from their managed window before outside-callback deletion; linked/attached callback destruction rejects." :sections (("Syntax" (:code-block "lisp" "(wxlambda:destroy-event-handler handler)")) ("Arguments" (:p "HANDLER is an owned standalone EVENT-HANDLER.")) ("Returns" (:p "T after successful native deletion.")) ("Description" (:p "Destroy an owned standalone native handler. Outside callbacks deletion is immediate; during callbacks identity becomes invalid immediately and deletion is queued on the application after the current native dispatch stack. Repeated destruction is an error. Window and application identities are borrowed and reject this operation; use DESTROY-WINDOW for windows. Only session cleanup destroys the application. Destroying a linked standalone handler during a callback now rejects; outside callbacks native destruction splices reciprocal neighbors. Unlinked callback destruction retains existing deferral. Attached handlers are removed from their managed window before outside-callback deletion; linked/attached callback destruction rejects.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR, including after cleanup. Invalid/stale native handles signal NATIVE-ERROR except HANDLER-ALIVE-P, which returns NIL for destroyed/unknown IDs during an active session. Unsupported Lisp receivers use CLOS dispatch errors. Generic observer/contextual bindings cover built-ins and registered command/notify names, including on the borrowed application view. Arbitrary native classes, validated OS session delivery, pushed handler chains and native virtual overrides remain unbound. Explicit destruction removes the canonical standalone wrapper root after successful native request.")) ("wxWidgets" (:p "wxEvtHandler::~wxEvtHandler (wxWidgets 3.2.12 baseline), owned standalone handlers only."))))
(:entry "api/destroy-window" :names ("destroy-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup." :sections (("Syntax" (:code-block "lisp" "(wxlambda:destroy-window window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T after the destruction request.")) ("Description" (:p "Request destruction; first explicitly unbind handlers to release Lisp closures. Child handles become invalid when native destruction occurs. During native-to-Lisp callbacks the target becomes invalid immediately and native destruction is deferred using application CallAfter so dispatch/setter stacks can return safely. Generic bindings are reaped at Lisp boundaries; control-specific closures still require explicit unbinding or session cleanup.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Destroy"))))
(:entry "api/enable-window" :names ("enable-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively." :sections (("Syntax" (:code-block "lisp" "(wxlambda:enable-window window &optional (enable t))")) ("Arguments" (:p "WINDOW is live; optional ENABLE is a generalized boolean (default T).")) ("Returns" (:p "WINDOW, then a boolean indicating whether its native enabled state changed.")) ("Description" (:p "Enable or disable user input. Repeated requests are harmless; a disabled parent also disables its children effectively.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Enable(bool) / Disable() equivalent (wxWidgets 3.2)."))))
(:entry "api/enabled-p" :names ("enabled-p" "(setf enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable." :sections (("Syntax" (:code-block "lisp" "(wxlambda:enabled-p window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read effective enabled state, including disabled ancestors. A child's own disabled state survives parent disable/re-enable.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::IsEnabled (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:enabled-p window) new-value)") (:p "Assign the input-enabled state; return the supplied value and a second native changed-state flag. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/event" :names ("event") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation. Registered names and family/integer data remain available in saved snapshots after session cleanup. Notify snapshots capture pre-callback veto capability/state independently of later Veto/Allow. Timestamp and native IsCommandEvent are copied before each callback; saved reads need no active session." :sections (("Syntax" (:code-block "lisp" "wxlambda:event")) ("Arguments" (:p "Snapshot type created by callbacks, without a public constructor.")) ("Returns" (:p "Lisp-owned event value.")) ("Description" (:p "Read-only event snapshot: kind, receiving source handler/control, native event ID and process-local native type, copied text, checked state and selection. Data survives later callbacks and source destruction. Close snapshots capture CanVeto and GetVeto before this callback; they never reflect later context mutation. Registered names and family/integer data remain available in saved snapshots after session cleanup. Notify snapshots capture pre-callback veto capability/state independently of later Veto/Allow. Timestamp and native IsCommandEvent are copied before each callback; saved reads need no active session.")) ("Errors and scope" (:p "Use only the exported predicate/accessors; native event objects do not escape callbacks.")) ("wxWidgets" (:p "wxCommandEvent snapshot."))))
(:entry "api/event-alive-p" :names ("event-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query the independent owned-event registry. Failed/uninitialized wrappers have no native handle and signal NATIVE-ERROR. This is not context activity or native origin liveness. TRANSFER-EVENT consumes the source registry handle; queued copies from POST-EVENT/QUEUE-EVENT do not." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-alive-p event)")) ("Arguments" (:p "EVENT is an OWNED-EVENT wrapper.")) ("Returns" (:p "T for a live native owned resource; NIL for explicitly destroyed or transferred IDs during the active session.")) ("Description" (:p "Query the independent owned-event registry. Failed/uninitialized wrappers have no native handle and signal NATIVE-ERROR. This is not context activity or native origin liveness. TRANSFER-EVENT consumes the source registry handle; queued copies from POST-EVENT/QUEUE-EVENT do not.")) ("Errors and scope" (:p "Active main-thread session required, including for dead-ID queries. After session cleanup native access signals NATIVE-ERROR. No GC finalization or cross-session reuse.")) ("wxWidgets" (:p "Bridge-owned wxEvent registry predicate (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-binding" :names ("event-binding") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped." :sections (("Syntax" (:code-block "lisp" "wxlambda:event-binding")) ("Arguments" (:p "Opaque read-only structure returned by BIND-EVENT; no public constructor.")) ("Returns" (:p "An independent binding identity.")) ("Description" (:p "Keep the returned object to query or remove exactly this registration. A binding records its receiving Lisp object and kind but not the callback function; active callback roots are held by the session registry. Native registration is session-scoped.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, userData, pushed handlers and worker-thread dispatch remain unbound.")) ("wxWidgets" (:p "Bridge identity for wxEvtHandler::Bind/Unbind (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-binding-p" :names ("event-binding-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; does not query native registration and needs no active session." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-binding-p object)")) ("Arguments" (:p "OBJECT is any Lisp value.")) ("Returns" (:p "T for EVENT-BINDING structures, NIL otherwise.")) ("Description" (:p "Type predicate only; does not query native registration and needs no active session.")) ("Errors and scope" (:p "No native session required. This predicate says nothing about whether a binding remains active.")) ("wxWidgets" (:p "Lisp-only binding identity predicate."))))
(:entry "api/event-can-veto-p" :names ("event-can-veto-p" "(setf event-can-veto-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots read copied capability without a session. Current close contexts use CanVeto; current notify contexts always support Veto/Allow. Plain command contexts return NIL. Scope validation remains required for native access. Context SETF maps native SetCanVeto directly, including false to true. GetVeto hides a stored veto when CanVeto is false and reveals it again if re-enabled. Forced close starts false but explicit metadata mutation can affect native closing results; OS veto acceptance is not guaranteed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-can-veto-p context)")) ("Arguments" (:p "EVENT is a saved snapshot or current event context. SETF requires a current close-family context; VALUE is a generalized boolean. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "T for veto-capable captured/current close or notify events; NIL otherwise.")) ("Description" (:p "Snapshots read copied capability without a session. Current close contexts use CanVeto; current notify contexts always support Veto/Allow. Plain command contexts return NIL. Scope validation remains required for native access. Context SETF maps native SetCanVeto directly, including false to true. GetVeto hides a stored veto when CanVeto is false and reveals it again if re-enabled. Forced close starts false but explicit metadata mutation can affect native closing results; OS veto acceptance is not guaranteed.")) ("Errors and scope" (:p "Active main-thread session required for native context or frame operations. Expired/suspended contexts and invalid/deleting frames signal NATIVE-ERROR. Saved snapshots need no session. Close and registered notify families permit checked veto. Native control-specific notify subclasses, validated OS session delivery and arbitrary event classes remain open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxCloseEvent::CanVeto / SetCanVeto; intrinsic wxNotifyEvent capability is read-only (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-can-veto-p event-or-context) value)") (:p "Assign current wxCloseEvent capability, returning VALUE. Snapshot, command and notify writers reject; stale/suspended contexts reject native access. Does not clear the native stored veto bit or guarantee OS policy. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-category" :names ("event-category") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read virtual GetEventCategory: current supported command/notify-derived classes report USER_INPUT and close-family events report UI. Values are category flags, not event types/IDs/families; synthetic USER_INPUT is not proof of real user input. Snapshot values are captured before the callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-category context)")) ("Arguments" (:p "EVENT is an immutable snapshot or current innermost event context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Captured/current native wxEventCategory integer flags.")) ("Description" (:p "Read virtual GetEventCategory: current supported command/notify-derived classes report USER_INPUT and close-family events report UI. Values are category flags, not event types/IDs/families; synthetic USER_INPUT is not proof of real user input. Snapshot values are captured before the callback.")) ("Errors and scope" (:p "Saved snapshots need no native session. Context reads require active main-thread session and innermost callback; stale/suspended contexts signal NATIVE-ERROR. No category setter, native virtual override, selective YieldFor or socket/timer/thread event binding is supplied. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::GetEventCategory; native wxCommandEvent override includes notify-derived events (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-category-mask" :names ("event-category-mask") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the bridge and return its compiled wxEventCategory constant without initializing a GUI session. Combine with LOGIOR/test with LOGTEST. ALL can include implementation category bits and is not restricted to the public five-bit union." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-category-mask category)")) ("Arguments" (:p "CATEGORY is :UI, :USER-INPUT, :SOCKET, :TIMER, :THREAD or :ALL.")) ("Returns" (:p "Compiled native category bit/mask integer.")) ("Description" (:p "Load the bridge and return its compiled wxEventCategory constant without initializing a GUI session. Combine with LOGIOR/test with LOGTEST. ALL can include implementation category bits and is not restricted to the public five-bit union.")) ("Errors and scope" (:p "No active GUI session required; normal native library/ABI load errors apply. Unknown names signal a Lisp error before FFI. No event pumping or event-family construction. Pinned interface ALL31 differs from local3.2.12 compiled ALL127; preserve actual compiled value.")) ("wxWidgets" (:p "wxEVT_CATEGORY_UI, USER_INPUT, SOCKET, TIMER, THREAD and ALL (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-checked-p" :names ("event-checked-p" "(setf event-checked-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the kind-limited checked interpretation of native command integer. Live SETF writes SetInt(0/1) only for :TOGGLE without calling a control setter. Raw EVENT-INTEGER can supply other nonzero checked values; earlier snapshots stay unchanged. Later native/user handlers can react to changed metadata; the entire dispatch is not guaranteed to leave controls unchanged." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-checked-p event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT. SETF requires native :TOGGLE kind and accepts a generalized boolean.")) ("Returns" (:p "T/NIL for :TOGGLE checked state; NIL for other kinds. SETF returns VALUE.")) ("Description" (:p "Read the kind-limited checked interpretation of native command integer. Live SETF writes SetInt(0/1) only for :TOGGLE without calling a control setter. Raw EVENT-INTEGER can supply other nonzero checked values; earlier snapshots stay unchanged. Later native/user handlers can react to changed metadata; the entire dispatch is not guaranteed to leave controls unchanged.")) ("Errors and scope" (:p "Saved snapshot reads need no session. Live operations require active main-thread session and valid owned/innermost-context lifetime. Wrong-kind live writes reject; no snapshot writer or direct checkbox-control setter.")) ("wxWidgets" (:p "Bounded wxCommandEvent::IsChecked view and SetInt(0/1), :TOGGLE only (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-checked-p event-or-context) value)") (:p "Assign native :TOGGLE command integer as0/1 and return the generalized boolean. No other-kind or snapshot writer; does not alter a checkbox control."))))
(:entry "api/event-command-p" :names ("event-command-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current native IsCommandEvent classification. No mutable classification or event replacement. Saved values remain independent of source lifetime." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-command-p context)")) ("Arguments" (:p "EVENT is an immutable snapshot or current event context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "T for native command/notify-derived events; NIL for close-family events.")) ("Description" (:p "Read captured/current native IsCommandEvent classification. No mutable classification or event replacement. Saved values remain independent of source lifetime.")) ("Errors and scope" (:p "Saved snapshots need no session. Current-context access requires an active main-thread session and the innermost callback; stale/suspended contexts signal NATIVE-ERROR. No SETF writer. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::IsCommandEvent copied or borrowed (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-context" :names ("event-context") :kind :type :kind-name "Type" :package "WXLAMBDA" :summary "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state." :sections (("Syntax" (:code-block "lisp" "wxlambda:event-context")) ("Arguments" (:p "Opaque read-only token value passed as the second argument by BIND-EVENT :WITH-CONTEXT T. No public constructor.")) ("Returns" (:p "A borrowed callback-scoped native wxEvent view.")) ("Description" (:p "The context token is immutable; operations mutate the live native event only during its exact innermost callback. Nested contextual callbacks suspend outer access; nested observer/control callbacks also deny outer access. The outer context becomes usable again after nesting returns. Unbinding or deferred receiver disposal does not prematurely expire the running callback context. :CLOSE contexts allow checked veto access; command contexts do not have close-veto state.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open.")) ("wxWidgets" (:p "Borrowed wxEvent base view, four wxCommandEvent tags (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-context-active-p" :names ("event-context-active-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-context-active-p context)")) ("Arguments" (:p "CONTEXT is an EVENT-CONTEXT value.")) ("Returns" (:p "T only for the current innermost native callback context; NIL for expired/suspended contexts in an active session.")) ("Description" (:p "Check scoped usability without dereferencing an expired pointer. Observer/control callbacks do not gain access to an enclosing context. The predicate does not assert receiver liveness and remains T during deferred receiver disposal until callback return.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open.")) ("wxWidgets" (:p "Bridge scope/depth validation of borrowed wxEvent access."))))
(:entry "api/event-context-p" :names ("event-context-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-context-p object)")) ("Arguments" (:p "OBJECT is any Lisp value.")) ("Returns" (:p "T for EVENT-CONTEXT values, NIL otherwise.")) ("Description" (:p "Type predicate only; a saved expired context still satisfies it. No native access or active session is needed.")) ("Errors and scope" (:p "No active native session required. Use EVENT-CONTEXT-ACTIVE-P for current callback usability.")) ("wxWidgets" (:p "Lisp-only context type predicate."))))
(:entry "api/event-extra-long" :names ("event-extra-long" "(setf event-extra-long)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetExtraLong or set native command/notify extra metadata. It is separate from signed32 EVENT-INTEGER and item indices. Raw EVENT-SELECTION-P reflects whether this field is nonzero. Snapshots preserve pre-callback values." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-extra-long event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT. SETF VALUE must fit signed native C LONG for command/notify events.")) ("Returns" (:p "Captured/current extra LONG integer; zero for close-family reads. SETF returns VALUE.")) ("Description" (:p "Read GetExtraLong or set native command/notify extra metadata. It is separate from signed32 EVENT-INTEGER and item indices. Raw EVENT-SELECTION-P reflects whether this field is nonzero. Snapshots preserve pre-callback values.")) ("Errors and scope" (:p "Saved reads need no session; live access requires active main-thread session and valid owned/innermost-context lifetime. Close-family writes reject. Native LONG width/range are platform dependent; no snapshot writer or derived-control state update. Non-integer/out-of-range values signal TYPE-ERROR.")) ("wxWidgets" (:p "wxCommandEvent::GetExtraLong / SetExtraLong, including notify-derived events (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-extra-long event-or-context) value)") (:p "Assign signed native LONG extra metadata and return VALUE. Changes raw IsSelection but not kind/index/control state. Close-family and snapshot writes reject."))))
(:entry "api/event-family" :names ("event-family") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read captured/current supported native classification :COMMAND/:NOTIFY/:CLOSE, including owned event values and saved snapshots after registry cleanup. It is bounded class metadata, not arbitrary native RTTI." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-family event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT.")) ("Returns" (:p "The portable family keyword :COMMAND, :CLOSE or :NOTIFY.")) ("Description" (:p "Read captured/current supported native classification :COMMAND/:NOTIFY/:CLOSE, including owned event values and saved snapshots after registry cleanup. It is bounded class metadata, not arbitrary native RTTI.")) ("Errors and scope" (:p "Saved snapshots need no session. Owned/current reads require active main-thread session and valid native lifetime; contexts require the innermost callback.")) ("wxWidgets" (:p "Portable classification of supported wxCommandEvent/wxCloseEvent/wxNotifyEvent tags (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-handler" :names ("event-handler") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles. Standalone wrappers are now strongly canonicalized by session identity for EQ chain peer lookup; no new native ownership or finalizer is introduced. Managed window push leaves native ownership/session rooting unchanged; window destruction detaches handlers rather than deleting them." :sections (("Syntax" (:code-block "lisp" "wxlambda:event-handler")) ("Arguments" (:p "Superclass STANDARD-OBJECT. No native initargs; subclasses may add slot initargs and defaults.")) ("Returns" (:p "A native-backed owned standalone handler, or the base identity of an existing window subclass.")) ("Description" (:p "Concrete standalone wxEvtHandler wrapper and superclass of WINDOW. Standalone native objects are owned by the application session, explicitly destroyed or automatically freed at session cleanup, without a Lisp GC finalizer. Windows borrow their own native wxWindow base identity and retain window/parent lifetime. Neither case exposes an arbitrary GetEventHandler chain or permits user-supplied native handles. Standalone wrappers are now strongly canonicalized by session identity for EQ chain peer lookup; no new native ownership or finalizer is introduced. Managed window push leaves native ownership/session rooting unchanged; window destruction detaches handlers rather than deleting them.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR, including after cleanup. Invalid/stale native handles signal NATIVE-ERROR except HANDLER-ALIVE-P, which returns NIL for destroyed/unknown IDs during an active session. Unsupported Lisp receivers use CLOS dispatch errors. Generic observer/contextual bindings cover built-ins and registered command/notify names, including on the borrowed application view. Arbitrary native classes, validated OS session delivery, pushed handler chains and native virtual overrides remain unbound. Construction rollback releases created resources/roots but does not undo arbitrary external chain edits; native destruction splices survivors around the failed node.")) ("wxWidgets" (:p "wxEvtHandler constructor/destructor (wxWidgets 3.2.12 baseline); window identity uses wxWindow inheritance.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:event-handler)") (:p "Subclass slot initargs and :DEFAULT-INITARGS are forwarded. Native state exists in subclass AFTER hooks. Failed managed initialization rolls back nested handlers/windows and callback roots through the shared construction context. WINDOW stays abstract; concrete windows allocate only their native widget."))))
(:entry "api/event-handler-client-data" :names ("event-handler-client-data" "(setf event-handler-client-data)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Store a session-root token in a bridge wxClientData adapter; the Lisp table retains the actual object. No Lisp pointer, serialization or native ownership of the Lisp object. Replacement/clear releases old association through cleanup; an ordinary returned Lisp reference remains valid. No constructor initarg: native-backed subclass AFTER hooks may SETF." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-handler-client-data handler)")) ("Arguments" (:p "HANDLER is a live managed EVENT-HANDLER, window/control or APPLICATION-HANDLER. SETF VALUE is any Lisp object; NIL clears.")) ("Returns" (:p "The same retained Lisp object by EQ, or NIL for no bridge datum. SETF returns VALUE.")) ("Description" (:p "Store a session-root token in a bridge wxClientData adapter; the Lisp table retains the actual object. No Lisp pointer, serialization or native ownership of the Lisp object. Replacement/clear releases old association through cleanup; an ordinary returned Lisp reference remains valid. No constructor initarg: native-backed subclass AFTER hooks may SETF.")) ("Errors and scope" (:p "Active main-thread session and live managed receiver required. Foreign non-null typed objects and all native untyped/Void modes, including NULL-pointer Void slots, reject untouched before typed access. Fresh None/typed-NULL slots read NIL. Roots reap during access/generic cleanup/rollback or after native session finish; asynchronous destruction may retain them until a later boundary. No untyped, event/client/userData, per-item or arbitrary native container binding.")) ("wxWidgets" (:p "wxEvtHandler::GetClientObject / SetClientObject with bridge wxClientData token adapter; protected native mode inspection is a private C7 reconciliation dependency (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-handler-client-data handler) value)") (:p "Retain VALUE by EQ or clear for NIL, returning VALUE. Foreign storage rejects without replacement. Candidate Lisp roots roll back on failed native write; old roots release at cleanup. Does not pump events or change native handler ownership."))))
(:entry "api/event-id" :names ("event-id" "(setf event-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read a saved pre-callback ID or current native GetId. Context SETF changes event metadata and later native ID matching, not the source window ID or binding filters. Earlier snapshots stay unchanged. No dispatch restart or callback-order guarantee." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-id context)")) ("Arguments" (:p "EVENT is an immutable snapshot or current innermost context. SETF VALUE is a signed 32-bit integer, including -1. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Captured/current native integer ID; SETF returns VALUE.")) ("Description" (:p "Read a saved pre-callback ID or current native GetId. Context SETF changes event metadata and later native ID matching, not the source window ID or binding filters. Earlier snapshots stay unchanged. No dispatch restart or callback-order guarantee.")) ("Errors and scope" (:p "Saved snapshots need no native session. Current reads/writes require an active main-thread session and innermost callback; stale/suspended contexts signal NATIVE-ERROR. Invalid SETF values signal TYPE-ERROR. Context SetId permits -1; binding filters/synthetic initial IDs still reserve it. Native types/origin mutation remain unbound. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::GetId / SetId, signed native int (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-id event-or-context) value)") (:p "Assign current native ID and return VALUE. Later exact/range matching uses the changed ID; -1 remains literal event metadata and unfiltered bindings still match. No snapshot writer. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-integer" :names ("event-integer" "(setf event-integer)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read GetInt or change the native command payload with SETF. Built-in toggle/selection interpretations can reflect this underlying value. Earlier snapshots remain unchanged. Raw values can affect semantic checked/selection views; negative indices other than -1 remain visible through EVENT-SELECTION after raw writes. It does not alter EXTRA-LONG or raw IsSelection." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-integer event)")) ("Arguments" (:p "EVENT is a snapshot, current context or live OWNED-EVENT. SETF VALUE is signed32 and requires command/notify state.")) ("Returns" (:p "Captured/current native command integer; zero for close-family reads. SETF returns VALUE.")) ("Description" (:p "Read GetInt or change the native command payload with SETF. Built-in toggle/selection interpretations can reflect this underlying value. Earlier snapshots remain unchanged. Raw values can affect semantic checked/selection views; negative indices other than -1 remain visible through EVENT-SELECTION after raw writes. It does not alter EXTRA-LONG or raw IsSelection.")) ("Errors and scope" (:p "Saved reads need no session. Live access requires active main-thread session and valid owned/innermost-context lifetime. Close-family writes reject; malformed/out-of-range values signal TYPE-ERROR.")) ("wxWidgets" (:p "wxCommandEvent::GetInt / SetInt, including wxNotifyEvent (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-integer event-or-context) value)") (:p "Assign a signed32 native command/notify payload and return VALUE. No snapshot writer; stale contexts and destroyed resources reject."))))
(:entry "api/event-kind" :names ("event-kind") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the event kind. The captured kind reflects the actual supported native tag at callback entry, even if an earlier callback changed it; binding registration identity does not change." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-kind event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT.")) ("Returns" (:p ":CLICK, :TEXT-CHANGE, :TOGGLE, :SELECTION, :CLOSE, :QUERY-END-SESSION, :END-SESSION or a registered command/notify keyword name.")) ("Description" (:p "Read the event kind. The captured kind reflects the actual supported native tag at callback entry, even if an earlier callback changed it; binding registration identity does not change.")) ("Errors and scope" (:p "Saved snapshots need no session. Owned/current native reads require the active main-thread session; contexts must be innermost. Registered names expire with the session for native resources; saved copied keywords remain readable.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-logging-off-p" :names ("event-logging-off-p" "(setf event-logging-off-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied or current wxCloseEvent logging-off metadata for :QUERY-END-SESSION/:END-SESSION. Context SETF changes native metadata only, not OS policy. Snapshots retain pre-callback state and have no SETF method." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-logging-off-p context)")) ("Arguments" (:p "EVENT is a saved session-event snapshot or current innermost session-event context. SETF VALUE is a generalized boolean. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "T for logging off, NIL for system shutdown; SETF returns VALUE.")) ("Description" (:p "Read copied or current wxCloseEvent logging-off metadata for :QUERY-END-SESSION/:END-SESSION. Context SETF changes native metadata only, not OS policy. Snapshots retain pre-callback state and have no SETF method.")) ("Errors and scope" (:p "Saved session snapshots require no session. Non-session snapshots signal Lisp errors; non-session, stale or suspended contexts signal NATIVE-ERROR. Native access requires an active main-thread session. OS session delivery is not validated by isolated synthetic tests. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxCloseEvent::GetLoggingOff / SetLoggingOff (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-logging-off-p event-or-context) value)") (:p "Assign the current native session flag, returning the generalized boolean. No snapshot writer; no OS logout/shutdown action is performed. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-native-type" :names ("event-native-type" "(setf event-native-type)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current GetEventType. Saved values remain data after callback/source/session cleanup. Compare to EVENT-TYPE in the same active session; numeric tags are not stable serialized IDs or native cast authority. Context SETF accepts only registered same-family source/target tags and validates actual native command/notify class before SetEventType. Earlier snapshots and registration identities remain unchanged; later snapshots report the current native tag. No dispatch restart or local delivery-order guarantee." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-native-type context)")) ("Arguments" (:p "EVENT is an immutable snapshot or current innermost event context. SETF VALUE is a signed32 native type returned by EVENT-TYPE for a registered name. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Captured/current process-local native wxEventType integer.")) ("Description" (:p "Read copied/current GetEventType. Saved values remain data after callback/source/session cleanup. Compare to EVENT-TYPE in the same active session; numeric tags are not stable serialized IDs or native cast authority. Context SETF accepts only registered same-family source/target tags and validates actual native command/notify class before SetEventType. Earlier snapshots and registration identities remain unchanged; later snapshots report the current native tag. No dispatch restart or local delivery-order guarantee.")) ("Errors and scope" (:p "Saved snapshots need no session. Current reads/writes require active main-thread session and innermost callback; stale/suspended contexts signal NATIVE-ERROR. SETF rejects built-in/session/unknown/cross-family types before mutation. Malformed integers signal TYPE-ERROR. Arbitrary tag mutation, class replacement and native ownership remain unbound. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::GetEventType / bounded SetEventType for registered same-family tags (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-native-type event-or-context) value)") (:p "Assign a registered same-family native type after actual-class checks; return VALUE. Built-in/session sources or targets reject. No snapshot writer, rebind, dispatch restart or local callback-order guarantee. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-origin-id" :names ("event-origin-id" "(setf event-origin-id)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Copy/read GetEventObject identity only when it matches a registered application, owned handler or tracked window. This differs from EVENT-SOURCE (binding receiver) and EVENT-ID (routing metadata). Pointer identity is compared without dereferencing the origin; no native pointer or wrapper reconstruction is exposed. Clear-only live SETF accepts NIL. Owned events are already detached; non-null current origins can clear only for registered command/notify tags matching actual native class. No origin object is retained or destroyed; EVENT-SOURCE and earlier snapshots stay unchanged." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-origin-id event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current innermost context or live OWNED-EVENT. SETF accepts only NIL on live state under the bounded detachment rules.")) ("Returns" (:p "Positive opaque bridge identity, or NIL for null/untracked native origin.")) ("Description" (:p "Copy/read GetEventObject identity only when it matches a registered application, owned handler or tracked window. This differs from EVENT-SOURCE (binding receiver) and EVENT-ID (routing metadata). Pointer identity is compared without dereferencing the origin; no native pointer or wrapper reconstruction is exposed. Clear-only live SETF accepts NIL. Owned events are already detached; non-null current origins can clear only for registered command/notify tags matching actual native class. No origin object is retained or destroyed; EVENT-SOURCE and earlier snapshots stay unchanged.")) ("Errors and scope" (:p "Saved values need no native session and imply no current liveness. Context reads require active main-thread session and innermost callback; expired/suspended contexts signal NATIVE-ERROR. Null and untracked origins both map to NIL. Registry lookup is at capture/read time, not a historical pointer-lifetime guarantee. No new-origin writer, generic wxObject wrapper, origin retention or native ownership transfer. Live owned-event reads validate the resource and return NIL because every owned event is detached; no new-origin setter/retention protocol is supplied. Non-NIL origin SETF signals TYPE-ERROR after session validation.")) ("wxWidgets" (:p "wxEvent::GetEventObject, bounded bridge-identity mapping (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-origin-id event-or-context) nil)") (:p "Drop only the native event-origin pointer. Non-NIL values reject. Actual-null live origins are no-op; non-null contexts require registered compatible command/notify native class. Built-in/nonregistered non-null origins reject. Reader NIL may also mean untracked and does not prove actual-null state."))))
(:entry "api/event-p" :names ("event-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Test whether an object is a Lisp-owned event snapshot." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-p object)")) ("Arguments" (:p "OBJECT is any Lisp value.")) ("Returns" (:p "T for an EVENT, otherwise NIL.")) ("Description" (:p "Test whether an object is a Lisp-owned event snapshot.")) ("Errors and scope" (:p "No GUI session required.")) ("wxWidgets" (:p "Lisp snapshot predicate."))))
(:entry "api/event-propagates-p" :names ("event-propagates-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-propagates-p context)")) ("Arguments" (:p "CONTEXT is the current event context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "T when the native propagation level is positive, otherwise NIL.")) ("Description" (:p "Observe native ShouldPropagate, independently of Skip. A positive level alone does not forward a consumed event.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::ShouldPropagate (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-selection" :names ("event-selection" "(setf event-selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read a kind-limited native GetSelection value. SETF writes NIL as -1 or a nonnegative index without calling control setters or validating item lists. Raw EVENT-INTEGER can expose other negative values; the reader preserves them. This is independent of raw EVENT-SELECTION-P/EXTRA-LONG. Later handlers may react and change controls." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-selection event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT. SETF requires native :SELECTION kind and VALUE NIL or a nonnegative signed32 index.")) ("Returns" (:p "Native :SELECTION integer, with -1 mapped to NIL; NIL for other kinds. SETF returns VALUE.")) ("Description" (:p "Read a kind-limited native GetSelection value. SETF writes NIL as -1 or a nonnegative index without calling control setters or validating item lists. Raw EVENT-INTEGER can expose other negative values; the reader preserves them. This is independent of raw EVENT-SELECTION-P/EXTRA-LONG. Later handlers may react and change controls.")) ("Errors and scope" (:p "Saved reads need no session. Live operations require active main-thread session and valid owned/innermost-context lifetime. Wrong-kind writes and malformed/range-invalid semantic indices reject; no snapshot writer or control-item validation.")) ("wxWidgets" (:p "Bounded wxCommandEvent::GetSelection and SetInt, :SELECTION only (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-selection event-or-context) value)") (:p "Store NIL as-1 or a nonnegative signed32 index and return VALUE. Only live :SELECTION accepts writes; other negative values require raw EVENT-INTEGER access. Literal -1 is rejected by this semantic writer; use NIL. Raw EVENT-INTEGER still accepts -1."))))
(:entry "api/event-selection-p" :names ("event-selection-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read whether command extra LONG is nonzero. This is not a :SELECTION-kind predicate or index-validity test: normal choice metadata can have a valid index while this flag is NIL. Use EVENT-EXTRA-LONG to change the underlying field." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-selection-p event)")) ("Arguments" (:p "EVENT is an immutable snapshot, current context or live OWNED-EVENT.")) ("Returns" (:p "Raw native IsSelection as T/NIL for command/notify events; NIL for close-family reads.")) ("Description" (:p "Read whether command extra LONG is nonzero. This is not a :SELECTION-kind predicate or index-validity test: normal choice metadata can have a valid index while this flag is NIL. Use EVENT-EXTRA-LONG to change the underlying field.")) ("Errors and scope" (:p "Saved reads need no session. Live access requires active main-thread session and valid owned/innermost-context lifetime. No direct SETF, arbitrary derived event class or control-state operation is provided.")) ("wxWidgets" (:p "wxCommandEvent::IsSelection (m_extraLong !=0), including notify-derived events (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-skipped-p" :names ("event-skipped-p" "(setf event-skipped-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-skipped-p context)")) ("Arguments" (:p "CONTEXT is the current event context. SETF VALUE is a generalized boolean. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Native Skip flag as T/NIL; SETF returns the supplied value.")) ("Description" (:p "Contextual bindings begin with Skip false. Assign true to continue to later native handlers and normal parent routing; false consumes the command at this handler. This is distinct from propagation level. Mutation is not rolled back on callback errors. Observer bindings without a context retain automatic Skip.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::GetSkipped / Skip (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-skipped-p event-or-context) value)") (:p "Set the native Skip flag only while CONTEXT is current. A true value continues dispatch; returning from a contextual callback does not automatically override the flag. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-source" :names ("event-source") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. EVENT-ORIGIN-ID separately reports a known native origin bridge identity without wrapping arbitrary wxObjects; EVENT-ID remains event routing metadata. Saved receiver wrappers may outlive their native object." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-source event)")) ("Arguments" (:p "EVENT is an event snapshot.")) ("Returns" (:p "The Lisp handler/control on which this callback was registered.")) ("Description" (:p "Read the binding receiver. For parent-propagated command events this can differ from the native originating child. EVENT-ORIGIN-ID separately reports a known native origin bridge identity without wrapping arbitrary wxObjects; EVENT-ID remains event routing metadata. Saved receiver wrappers may outlive their native object.")) ("Errors and scope" (:p "No active GUI session required for saved snapshots. Wrong argument types signal Lisp type errors.")) ("wxWidgets" (:p "Lisp-owned wxCommandEvent snapshot."))))
(:entry "api/event-text" :names ("event-text" "(setf event-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or copy native command string payload. Context/owned SETF uses explicit UTF-8 byte lengths, preserving embedded NULs. Saved snapshots stay immutable and retain their prior kind-specific payload interpretation." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-text event)")) ("Arguments" (:p "EVENT is a snapshot, current context or live OWNED-EVENT. SETF VALUE is a string and requires native command/notify state.")) ("Returns" (:p "Snapshot kind-specific copied string/NIL; live command/notify string (possibly empty), or NIL for close-family reads. SETF returns VALUE.")) ("Description" (:p "Read or copy native command string payload. Context/owned SETF uses explicit UTF-8 byte lengths, preserving embedded NULs. Saved snapshots stay immutable and retain their prior kind-specific payload interpretation.")) ("Errors and scope" (:p "Saved reads need no session. Live access requires active main-thread session and valid owned/innermost-context lifetime. Text writes to close-family events reject; non-string values signal TYPE-ERROR. Native wxEVT_TEXT with a tracked text-entry origin rejects context string SETF; unknown origins reject too. The control is not changed. Detached context clones freeze effective GetString before clearing origin.")) ("wxWidgets" (:p "wxCommandEvent::GetString / SetString, including wxNotifyEvent (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-text event-or-context) value)") (:p "Assign a command/notify native string, returning VALUE. Owned values are persistent; context writes affect the current dispatch copy. No snapshot writer."))))
(:entry "api/event-timestamp" :names ("event-timestamp" "(setf event-timestamp)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read copied/current native timestamp, not necessarily Unix time. Negative values including -1 are valid. Synthetic events start at zero. Context SETF changes metadata only, not scheduling. Snapshots stay immutable and preserve pre-callback values." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-timestamp context)")) ("Arguments" (:p "EVENT is an immutable snapshot or current event context. SETF VALUE must fit signed native C long. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Native millisecond timestamp as a Lisp integer; SETF returns VALUE.")) ("Description" (:p "Read copied/current native timestamp, not necessarily Unix time. Negative values including -1 are valid. Synthetic events start at zero. Context SETF changes metadata only, not scheduling. Snapshots stay immutable and preserve pre-callback values.")) ("Errors and scope" (:p "Saved snapshot reads need no native session. Context access requires an active main-thread session and the innermost callback; expired/suspended contexts signal NATIVE-ERROR. Malformed/out-of-range SETF values signal TYPE-ERROR. Native LONG width is platform-specific; mouse/key events are not yet bound. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::GetTimestamp / SetTimestamp, native signed long widened to int64_t at the ABI (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-timestamp event-or-context) value)") (:p "Assign a signed native LONG timestamp to the current event. No snapshot writer or synthetic-constructor timestamp keyword. No Unix-epoch or scheduling meaning is implied. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/event-type" :names ("event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Look up a process-local native type ID. Seven built-in kinds plus registered command/notify names are supported. Registry names are session-scoped; saved snapshot native IDs remain plain data after cleanup. Borrowed application handler access is supported; arbitrary native event-class binding and OS session delivery remains unverified." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-type kind)")) ("Arguments" (:p "KIND is a built-in event keyword or a name registered in this active session.")) ("Returns" (:p "The corresponding process-local native wxEventType integer.")) ("Description" (:p "Look up a process-local native type ID. Seven built-in kinds plus registered command/notify names are supported. Registry names are session-scoped; saved snapshot native IDs remain plain data after cleanup. Borrowed application handler access is supported; arbitrary native event-class binding and OS session delivery remains unverified.")) ("Errors and scope" (:p "Active main-thread session required; inactive calls signal NATIVE-ERROR before native-library lookup. Native IDs are process-local and may change between runs.")) ("wxWidgets" (:p "wxEVT_BUTTON / wxEVT_TEXT / wxEVT_CHECKBOX / wxEVT_CHOICE / wxEVT_CLOSE_WINDOW / wxEVT_QUERY_END_SESSION / wxEVT_END_SESSION; wxNewEventType for registered command/notify names (wxWidgets 3.2.12 baseline)."))))
(:entry "api/event-vetoed-p" :names ("event-vetoed-p" "(setf event-vetoed-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Snapshots retain pre-callback state. Close contexts use GetVeto / checked Veto(bool); notify contexts use NOT IsAllowed, Veto() for true, and Allow() for NIL. A close initialized non-vetoable rejects writes unless its current CanVeto flag was explicitly enabled through SETF EVENT-CAN-VETO-P. Plain command contexts reject live veto-state access. Snapshots stay immutable. Native GetVeto is CanVeto AND the stored veto bit; disabling capability hides the bit without clearing it." :sections (("Syntax" (:code-block "lisp" "(wxlambda:event-vetoed-p context)")) ("Arguments" (:p "EVENT is a saved snapshot or current close/notify context. SETF requires a current veto-capable context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Copied/current veto state as T/NIL; SETF returns the supplied generalized boolean.")) ("Description" (:p "Snapshots retain pre-callback state. Close contexts use GetVeto / checked Veto(bool); notify contexts use NOT IsAllowed, Veto() for true, and Allow() for NIL. A close initialized non-vetoable rejects writes unless its current CanVeto flag was explicitly enabled through SETF EVENT-CAN-VETO-P. Plain command contexts reject live veto-state access. Snapshots stay immutable. Native GetVeto is CanVeto AND the stored veto bit; disabling capability hides the bit without clearing it.")) ("Errors and scope" (:p "Active main-thread session required for native context or frame operations. Expired/suspended contexts and invalid/deleting frames signal NATIVE-ERROR. Saved snapshots need no session. Close and registered notify families permit checked veto. Native control-specific notify subclasses, validated OS session delivery and arbitrary event classes remain open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxCloseEvent::GetVeto / Veto(bool); wxNotifyEvent::IsAllowed / Veto / Allow. (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:event-vetoed-p event-or-context) value)") (:p "Close contexts require CanVeto true before either assignment. Notify true invokes Veto and NIL invokes Allow. Plain command contexts and stale/suspended contexts reject access; snapshots have no SETF method. Also accepts a live OWNED-EVENT under the same field/family restrictions; owned writes change the reusable resource, not copies already dispatched."))))
(:entry "api/frame" :names ("frame") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxFrame, including frame-specific title methods." :sections (("Syntax" (:code-block "lisp" "wxlambda:frame")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxFrame, including frame-specific title methods.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxFrame (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:frame)") (:p "TITLE string, WIDTH 480 and HEIGHT 240; default title is wxlambda. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/frame-title" :names ("frame-title" "(setf frame-title)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction." :sections (("Syntax" (:code-block "lisp" "(wxlambda:frame-title frame)")) ("Arguments" (:p "FRAME is a live frame.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the frame title, including the title initially supplied to MAKE-FRAME. Returned strings survive later metadata queries and destruction.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Only wxFrame receivers are currently exposed; panels and other controls signal NATIVE-ERROR. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTopLevelWindow::GetTitle (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:frame-title frame) new-value)") (:p "Update the frame title. Other top-level receiver types remain future work. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/gauge" :names ("gauge") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound." :sections (("Syntax" (:code-block "lisp" "wxlambda:gauge")) ("Arguments" (:p "Native-backed WINDOW subclass. Required :PARENT; :RANGE defaults to 100, :VALUE to 0, :ORIENTATION to :HORIZONTAL.")) ("Returns" (:p "A gauge wrapper or Lisp subclass instance.")) ("Description" (:p "Parent-owned progress indicator; supports inherited window operations. Positive range, value from zero through range, horizontal or vertical orientation. IDs, position, size, validator and native name use wxWidgets defaults; custom styles, taskbar progress and two-step creation remain unbound.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge constructor (wxWidgets 3.2.12 baseline).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:gauge :parent parent :range 100 :value 0 :orientation :horizontal)") (:p "Subclass slot initargs and :DEFAULT-INITARGS are supported. Native properties are ready in subclass AFTER hooks. Failed managed initialization rolls back native allocation. Orientation is :HORIZONTAL or :VERTICAL and cannot be changed after construction."))))
(:entry "api/gauge-range" :names ("gauge-range" "(setf gauge-range)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-range gauge)")) ("Arguments" (:p "GAUGE is a live gauge; SETF VALUE is an integer in [1, 2147483647].")) ("Returns" (:p "Positive integer maximum; SETF returns the supplied integer.")) ("Description" (:p "Read or assign the maximum progress. Assignment clamps the current native value to the new range and restores determinate mode by calling SetRange followed by SetValue. After a pulse the preserved value is platform-dependent; explicitly set GAUGE-VALUE when resuming measured work.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::GetRange / SetRange / SetValue (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:gauge-range gauge) value)") (:p "A positive signed 32-bit integer. Progress becomes MIN(old native value, new range); no events. Zero ranges are intentionally unsupported."))))
(:entry "api/gauge-value" :names ("gauge-value" "(setf gauge-value)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-value gauge)")) ("Arguments" (:p "GAUGE is a live gauge; SETF VALUE is an integer from 0 through GAUGE-RANGE.")) ("Returns" (:p "Integer progress; SETF returns the supplied integer.")) ("Description" (:p "Read determinate progress. After PULSE-GAUGE the reading is platform-dependent; do not interpret it as completed work. Assigning a value restores determinate mode without events.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::GetValue / SetValue (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:gauge-value gauge) value)") (:p "VALUE must be an integer in [0, range]. Invalid updates preserve existing progress. No notification option."))))
(:entry "api/gauge-vertical-p" :names ("gauge-vertical-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query construction orientation; this property has no writer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:gauge-vertical-p gauge)")) ("Arguments" (:p "GAUGE is a live gauge.")) ("Returns" (:p "T for vertical, NIL for horizontal.")) ("Description" (:p "Query construction orientation; this property has no writer.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::IsVertical (wxWidgets 3.2.12 baseline)."))))
(:entry "api/handler-alive-p" :names ("handler-alive-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR." :sections (("Syntax" (:code-block "lisp" "(wxlambda:handler-alive-p handler)")) ("Arguments" (:p "HANDLER is an EVENT-HANDLER or a WINDOW subclass.")) ("Returns" (:p "T if native identity exists and is not being deleted; NIL for stale/destroyed identity during an active session.")) ("Description" (:p "Observe native lifetime without dereferencing dead windows. Native weak tracking makes window destruction safe even with event processing disabled. A failed/uninitialized Lisp wrapper has no handle and signals NATIVE-ERROR. Session cleanup invalidates every identity; outside a session this query signals NATIVE-ERROR.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR, including after cleanup. Invalid/stale native handles signal NATIVE-ERROR except HANDLER-ALIVE-P, which returns NIL for destroyed/unknown IDs during an active session. Unsupported Lisp receivers use CLOS dispatch errors. Generic observer/contextual bindings cover built-ins and registered command/notify names, including on the borrowed application view. Arbitrary native classes, validated OS session delivery, pushed handler chains and native virtual overrides remain unbound.")) ("wxWidgets" (:p "Bridge lifetime predicate using native registries and wxWeakRef<wxWindow>/IsBeingDeleted; no standalone public wxWeakRef wrapper."))))
(:entry "api/handler-enabled-p" :names ("handler-enabled-p" "(setf handler-enabled-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Scoped contexts support Skip/propagation and checked close/notify veto; arbitrary pushed handlers remain unbound. In standalone chains this affects only the node itself, not processing by following nodes." :sections (("Syntax" (:code-block "lisp" "(wxlambda:handler-enabled-p handler)")) ("Arguments" (:p "HANDLER is an EVENT-HANDLER or WINDOW subclass; SETF VALUE is a generalized boolean.")) ("Returns" (:p "T/NIL for the own native handler flag; SETF returns the supplied value.")) ("Description" (:p "Read or write the native wxEvtHandler event-processing flag. Separate from window ENABLED-P/input state: disabled handlers can skip callbacks without greying the control. Native propagation rules still apply. Scoped contexts support Skip/propagation and checked close/notify veto; arbitrary pushed handlers remain unbound. In standalone chains this affects only the node itself, not processing by following nodes.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR, including after cleanup. Invalid/stale native handles signal NATIVE-ERROR except HANDLER-ALIVE-P, which returns NIL for destroyed/unknown IDs during an active session. Unsupported Lisp receivers use CLOS dispatch errors. Generic observer/contextual bindings cover built-ins and registered command/notify names, including on the borrowed application view. Arbitrary native classes, validated OS session delivery, pushed handler chains and native virtual overrides remain unbound. On APPLICATION-HANDLER this is the real wxApp flag; disabling can delay app-queued work and deferred disposal until restoration or cleanup.")) ("wxWidgets" (:p "wxEvtHandler::GetEvtHandlerEnabled / SetEvtHandlerEnabled (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:handler-enabled-p handler) value)") (:p "Normalize a generalized boolean to the native flag and return the original supplied value. No command event is synthesized."))))
(:entry "api/handler-unlinked-p" :names ("handler-unlinked-p") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native IsUnlinked without changing native ownership or queue membership. An unlinked wrapper remains strongly registered and its native object remains session-owned until explicit destruction or cleanup." :sections (("Syntax" (:code-block "lisp" "(wxlambda:handler-unlinked-p handler)")) ("Arguments" (:p "HANDLER is a live owned standalone EVENT-HANDLER/subclass.")) ("Returns" (:p "T when both native next/previous links are NIL; otherwise NIL.")) ("Description" (:p "Read native IsUnlinked without changing native ownership or queue membership. An unlinked wrapper remains strongly registered and its native object remains session-owned until explicit destruction or cleanup.")) ("Errors and scope" (:p "Active main-thread session and valid owned standalone handle; reads may run inside callbacks. Borrowed window/application and stale/pending handles reject. No borrowed native stack or pointer access. Attached owned pushed handlers are supported by this query and return NIL; generic peer operations remain excluded.")) ("wxWidgets" (:p "wxEvtHandler::IsUnlinked (wxWidgets 3.2.12 baseline)."))))
(:entry "api/label" :names ("label") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxStaticText; label operations specialize on this class." :sections (("Syntax" (:code-block "lisp" "wxlambda:label")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxStaticText; label operations specialize on this class.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxStaticText (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:label :parent parent :label \"\")") (:p "PARENT is required; LABEL defaults to an empty string. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/label-text" :names ("label-text" "(setf label-text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read raw label text including mnemonic syntax. Other control types are not accepted." :sections (("Syntax" (:code-block "lisp" "(wxlambda:label-text label)")) ("Arguments" (:p "LABEL is live static text.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read raw label text including mnemonic syntax. Other control types are not accepted.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxControl::GetLabel (wxStaticText only)")) ("SETF" (:code-block "lisp" "(setf (wxlambda:label-text label) new-value)") (:p "Assign static text and relayout its parent if necessary. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/layout-window" :names ("layout-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:layout-window window)")) ("Arguments" (:p "WINDOW is a live window.")) ("Returns" (:p "WINDOW.")) ("Description" (:p "Recompute the window sizer layout, including after batching label changes. Native success boolean is not exposed.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Layout"))))
(:entry "api/load-native-library" :names ("load-native-library") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF." :sections (("Syntax" (:code-block "lisp" "(wxlambda:load-native-library &optional path)")) ("Arguments" (:p "Optional PATH names the bridge; default searches build/ and then the system loader.")) ("Returns" (:p "T after successful load and ABI verification.")) ("Description" (:p "Load the native bridge once. An explicit path supports packaged applications without consulting ASDF.")) ("Errors and scope" (:p "May be used before a GUI session. Loader and ABI failures signal Lisp errors.")) ("wxWidgets" (:p "Bridge-specific ABI loader."))))
(:entry "api/main-loop-running-p" :names ("main-loop-running-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate." :sections (("Syntax" (:code-block "lisp" "(wxlambda:main-loop-running-p )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "T while the native main loop runs, otherwise NIL.")) ("Description" (:p "Query wxAppConsole::IsMainLoopRunning. False during standalone pending dispatch, standalone GUI polling and the cooperative application REPL; those modes can still deliver callbacks. This is a main-loop query, not a callback-safety predicate.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances.")) ("wxWidgets" (:p "wxAppConsole::IsMainLoopRunning (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-button" :names ("make-button") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-button parent &rest initargs &key (class 'wxlambda:button) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional LABEL string (default Button). :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a text button with replaceable click handler support.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxButton constructor (wxWidgets 3.2)."))))
(:entry "api/make-checkbox" :names ("make-checkbox") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-checkbox parent &rest initargs &key (class 'wxlambda:checkbox) &allow-other-keys)")) ("Arguments" (:p "PARENT; LABEL string and CHECKED generalized boolean. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a two-state checkbox with initial boolean state.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxCheckBox constructor (wxWidgets 3.2)."))))
(:entry "api/make-choice" :names ("make-choice") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-choice parent &rest initargs &key (class 'wxlambda:choice) &allow-other-keys)")) ("Arguments" (:p "PARENT; ITEMS list of strings; SELECTION zero-based index or NIL. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a dropdown with copied item strings; NIL means no selection.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxChoice constructor (wxWidgets 3.2)."))))
(:entry "api/make-column" :names ("make-column") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-column parent)")) ("Arguments" (:p "PARENT is a live window without a sizer.")) ("Returns" (:p "PARENT.")) ("Description" (:p "Attach a parent-owned vertical box sizer. Standalone nested sizer objects are not exposed.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxBoxSizer / wxWindow::SetSizer"))))
(:entry "api/make-event" :names ("make-event") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin class-validating CLOS factory with forwarded subclass initargs. Initial ID -1 remains reserved. Clone construction detaches origin and preserves native source state; factories reject explicit payload overrides while inherited defaults do not replace cloned values." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-event &rest initargs &key (class 'owned-event) &allow-other-keys)")) ("Arguments" (:p "Keyword initargs: CLASS defaults OWNED-EVENT; KIND defaults :CLICK. ID/TEXT/INTEGER/CHECKED-P/SELECTION/CAN-VETO-P/VETOED-P/LOGGING-OFF-P match synthetic payload rules. Optional CLONE-FROM accepts a live owned event/current context. Optional EXTRA-LONG accepts signed native LONG only for command/notify construction; explicit clone overrides reject.")) ("Returns" (:p "A new OWNED-EVENT or validated subclass.")) ("Description" (:p "Thin class-validating CLOS factory with forwarded subclass initargs. Initial ID -1 remains reserved. Clone construction detaches origin and preserves native source state; factories reject explicit payload overrides while inherited defaults do not replace cloned values.")) ("Errors and scope" (:p "Active main-thread session required. Unknown/wrong-family options and invalid class construction reject. No arbitrary native class or raw handle. Explicit DESTROY-EVENT or session cleanup owns native lifetime.")) ("wxWidgets" (:p "Bounded native event constructors / wxEvent::Clone (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-event-handler" :names ("make-event-handler") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory. Rejects WINDOW subclasses and non-handler classes before construction; no parent or native-enabled initarg is provided." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-event-handler &rest initargs &key (class 'event-handler) &allow-other-keys)")) ("Arguments" (:p "Keyword :CLASS is an EVENT-HANDLER subclass symbol or class object, default EVENT-HANDLER. Additional initargs are forwarded.")) ("Returns" (:p "A new owned standalone handler instance of CLASS.")) ("Description" (:p "Thin MAKE-INSTANCE factory. Rejects WINDOW subclasses and non-handler classes before construction; no parent or native-enabled initarg is provided.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR, including after cleanup. Invalid/stale native handles signal NATIVE-ERROR except HANDLER-ALIVE-P, which returns NIL for destroyed/unknown IDs during an active session. Unsupported Lisp receivers use CLOS dispatch errors. Generic observer/contextual bindings cover built-ins and registered command/notify names, including on the borrowed application view. Arbitrary native classes, validated OS session delivery, pushed handler chains and native virtual overrides remain unbound.")) ("wxWidgets" (:p "wxEvtHandler::wxEvtHandler (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-frame" :names ("make-frame") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-frame &rest initargs &key (class 'wxlambda:frame) &allow-other-keys)")) ("Arguments" (:p "TITLE string; positive WIDTH and HEIGHT (defaults 480 and 240). :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a top-level frame; native ID and style options use defaults.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process.")) ("wxWidgets" (:p "wxFrame constructor (wxWidgets 3.2)."))))
(:entry "api/make-gauge" :names ("make-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-gauge parent &rest initargs &key (class 'gauge) &allow-other-keys)")) ("Arguments" (:p "PARENT is a WINDOW; :CLASS defaults to GAUGE. :RANGE, :VALUE, :ORIENTATION and subclass initargs are forwarded.")) ("Returns" (:p "A new GAUGE instance of CLASS.")) ("Description" (:p "Thin MAKE-INSTANCE factory with validated GAUGE subclass support. Same construction defaults and restrictions as GAUGE.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge constructor (wxWidgets 3.2.12 baseline)."))))
(:entry "api/make-label" :names ("make-label") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-label parent &rest initargs &key (class 'wxlambda:label) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional LABEL string. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create static text; wxWidgets label/mnemonic syntax is retained.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxStaticText constructor (wxWidgets 3.2)."))))
(:entry "api/make-panel" :names ("make-panel") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-panel parent &rest initargs &key (class 'wxlambda:panel) &allow-other-keys)")) ("Arguments" (:p "PARENT is a live window. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a child panel.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxPanel constructor (wxWidgets 3.2)."))))
(:entry "api/make-row" :names ("make-row") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Attach a parent-owned horizontal box sizer. Standalone nested sizer objects are not exposed." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-row parent)")) ("Arguments" (:p "PARENT is a live window without a sizer.")) ("Returns" (:p "PARENT.")) ("Description" (:p "Attach a parent-owned horizontal box sizer. Standalone nested sizer objects are not exposed.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxBoxSizer / wxWindow::SetSizer"))))
(:entry "api/make-text" :names ("make-text") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control." :sections (("Syntax" (:code-block "lisp" "(wxlambda:make-text parent &rest initargs &key (class 'wxlambda:text-control) &allow-other-keys)")) ("Arguments" (:p "PARENT; optional initial VALUE string. :CLASS selects the corresponding concrete wrapper class or a subclass (symbol or class object). Additional initargs are forwarded to MAKE-INSTANCE.")) ("Returns" (:p "A new Lisp object wrapping the native window handle.")) ("Description" (:p "Thin factory over MAKE-INSTANCE; validates :CLASS against the factory's widget kind and forwards initargs. Create a single-line editable text control.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTextCtrl constructor (wxWidgets 3.2)."))))
(:entry "api/native-error" :names ("native-error") :kind :condition :kind-name "Condition" :package "WXLAMBDA" :summary "Signals native bridge failures instead of exposing C++ exceptions or native pointers." :sections (("Syntax" (:code-block "lisp" "(handler-case form (wxlambda:native-error (condition) ...))")) ("Arguments" (:p "Condition class; native diagnostic text is available through its printed report.")) ("Returns" (:p "A Lisp ERROR condition.")) ("Description" (:p "Signals native bridge failures instead of exposing C++ exceptions or native pointers.")) ("Errors and scope" (:p "Catch with HANDLER-CASE or HANDLER-BIND. Lisp argument and callback conditions retain their own condition types.")) ("wxWidgets" (:p "Bridge exception translation."))))
(:entry "api/next-handler" :names ("next-handler" "(setf next-handler)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the native next link through the session canonical wrapper map. SETF joins reciprocal vacant source-next/peer-previous endpoints, including existing segments, or detaches one reciprocal edge for NIL. Repeating an existing pair is idempotent; self/cycle/conflicting occupied endpoints reject before mutation." :sections (("Syntax" (:code-block "lisp" "(wxlambda:next-handler handler)")) ("Arguments" (:p "HANDLER is a live owned standalone EVENT-HANDLER/subclass. SETF PEER is another owned standalone handler or NIL.")) ("Returns" (:p "The EQ canonical managed next wrapper or NIL; SETF returns PEER.")) ("Description" (:p "Read the native next link through the session canonical wrapper map. SETF joins reciprocal vacant source-next/peer-previous endpoints, including existing segments, or detaches one reciprocal edge for NIL. Repeating an existing pair is idempotent; self/cycle/conflicting occupied endpoints reject before mutation.")) ("Errors and scope" (:p "Active main-thread session and valid standalone handles required. Reads are permitted in callbacks; SETF rejects RUN/pump/callback use. Window/application sources and peers reject. Wrappers are strongly rooted until destruction/rollback/session end; no ownership transfer, raw pointer or GC finalizer. Attached pushed nodes reject both peer reads and writes; use WINDOW-EVENT-HANDLER/POP/REMOVE so the standalone protocol cannot expose the borrowed window tail.")) ("wxWidgets" (:p "wxEvtHandler::GetNextHandler / SetNextHandler with managed reciprocal SetPreviousHandler (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:next-handler handler) peer-or-nil)") (:p "Join vacant reciprocal endpoints after cycle/ownership validation, or split one edge for NIL. Return supplied peer/NIL. Does not destroy handlers, reparent native ownership or permit in-dispatch structural edits."))))
(:entry "api/off-click" :names ("off-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-click button)")) ("Arguments" (:p "BUTTON is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/off-selection" :names ("off-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-selection choice)")) ("Arguments" (:p "CHOICE is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/off-text-change" :names ("off-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-text-change control)")) ("Arguments" (:p "CONTROL (wxTextCtrl) is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/off-toggle" :names ("off-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback." :sections (("Syntax" (:code-block "lisp" "(wxlambda:off-toggle checkbox)")) ("Arguments" (:p "CHECKBOX is a live source control.")) ("Returns" (:p "The source control.")) ("Description" (:p "Remove the handler and release its closure. Repeated removal is harmless for a live control, including inside its callback.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Unbind before destruction; unbinding a destroyed handle is an error. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets event bridge unbinding"))))
(:entry "api/on-click" :names ("on-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-click button function &key with-event)")) ("Arguments" (:p "BUTTON and FUNCTION; WITH-EVENT true makes FUNCTION accept one EVENT; otherwise no arguments.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :CLICK snapshots with no payload. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-selection" :names ("on-selection") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-selection choice function)")) ("Arguments" (:p "CHOICE and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :SELECTION snapshots with selected index or NIL. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-text-change" :names ("on-text-change") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-text-change control function)")) ("Arguments" (:p "CONTROL (wxTextCtrl) and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :TEXT-CHANGE snapshots with copied text. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/on-toggle" :names ("on-toggle") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached." :sections (("Syntax" (:code-block "lisp" "(wxlambda:on-toggle checkbox function)")) ("Arguments" (:p "CHECKBOX and FUNCTION; FUNCTION receives one EVENT.")) ("Returns" (:p "The source control.")) ("Description" (:p "Replace and release any prior handler. Receive :TOGGLE snapshots with boolean state. Callback conditions never unwind through C++; they are re-signaled at a Lisp boundary. Command callbacks are observers: the bridge calls Skip after delivery so remaining native bindings/parent routing can proceed. Generic subscriptions coexist with this one replacement slot. Optional contextual generic bindings can consume commands before later native handlers are reached.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Handler closures stay rooted until explicit unbinding or session cleanup. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWidgets command event binding"))))
(:entry "api/owned-event" :names ("owned-event") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Native-backed CLOS construction supports subclasses, slot initargs, defaults and AFTER hooks. Native origin is NIL. Mixed ancestry with EVENT-HANDLER/window is invalid. Explicit destruction or session cleanup owns deletion; there is no GC finalizer." :sections (("Syntax" (:code-block "lisp" "wxlambda:owned-event")) ("Arguments" (:p "Construct with MAKE-INSTANCE or MAKE-EVENT; KIND/payload options match supported synthetic events. CLONE-FROM accepts an owned event/current context.")) ("Returns" (:p "A detached session-owned native event resource, not a snapshot or borrowed context.")) ("Description" (:p "Native-backed CLOS construction supports subclasses, slot initargs, defaults and AFTER hooks. Native origin is NIL. Mixed ancestry with EVENT-HANDLER/window is invalid. Explicit destruction or session cleanup owns deletion; there is no GC finalizer.")) ("Errors and scope" (:p "Exact supported command/notify/close native classes only; one active main-thread session. No native handle initarg, arbitrary derived event class, origin retention or userdata/client ownership. TRANSFER-EVENT supports bounded native ownership handoff of this resource; copy APIs preserve it.")) ("wxWidgets" (:p "wxCommandEvent / wxNotifyEvent / wxCloseEvent construction and wxEvent::Clone (wxWidgets 3.2.12 baseline).")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:owned-event :kind :click)
(wxlambda:make-event :kind registered-name :text \"payload\" :integer 1)") (:p "Inherited native initialization runs before subclass AFTER hooks; managed failures roll back mixed native resources. Direct MAKE-INSTANCE :CLONE-FROM preserves source native state and ignores payload initargs/defaults. Factories reject explicit clone payload overrides. EXTRA-LONG initargs follow command/notify-only native LONG validation; inherited clone defaults never replace source values."))))
(:entry "api/panel" :names ("panel") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for a child wxPanel." :sections (("Syntax" (:code-block "lisp" "wxlambda:panel")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for a child wxPanel.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxPanel (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:panel :parent parent)") (:p "PARENT is a live window and is required. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/pending-events-p" :names ("pending-events-p") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks." :sections (("Syntax" (:code-block "lisp" "(wxlambda:pending-events-p )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "T if wxWidgets has queued pending events, otherwise NIL.")) ("Description" (:p "Query wxAppConsole::HasPendingEvents across the current application. Does not report OS input, idle work or timers that have not queued an event. It is an observation, not a guarantee about the next dispatch. Safe to query during callbacks.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances.")) ("wxWidgets" (:p "wxAppConsole::HasPendingEvents (wxWidgets 3.2.12 baseline)."))))
(:entry "api/pop-event-handler" :names ("pop-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Detach the top entry. Default preserves native owned registry/root; DELETE true releases bridge ownership before native PopEventHandler deletion and clears canonical roots/bindings. Empty stacks reject instead of invoking native assertions." :sections (("Syntax" (:code-block "lisp" "(wxlambda:pop-event-handler window &key delete)")) ("Arguments" (:p "WINDOW is bridge-managed with a nonempty managed stack. DELETE defaults NIL; true requests native deletion.")) ("Returns" (:p "Popped canonical handler, alive/unlinked, or NIL when DELETE is true.")) ("Description" (:p "Detach the top entry. Default preserves native owned registry/root; DELETE true releases bridge ownership before native PopEventHandler deletion and clears canonical roots/bindings. Empty stacks reject instead of invoking native assertions.")) ("Errors and scope" (:p "Active main-thread non-dispatch boundary; RUN/pump/callback use rejects. Consumed/deleted wrappers reject later native access. No deletion of the base window or arbitrary native stack entry.")) ("wxWidgets" (:p "wxWindow::PopEventHandler(bool) (wxWidgets 3.2.12 baseline)."))))
(:entry "api/post-event" :names ("post-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post an independent detached copy with wxPostEvent/AddPendingEvent; attach the receiver as copy origin. Input stays live/unchanged and may be destroyed or changed immediately. Delivery is asynchronous in the managed GUI session." :sections (("Syntax" (:code-block "lisp" "(wxlambda:post-event handler event)")) ("Arguments" (:p "HANDLER is a live EVENT-HANDLER/window, EVENT is a live OWNED-EVENT. No synthetic payload overrides.")) ("Returns" (:p "HANDLER after successful GUI posting.")) ("Description" (:p "Post an independent detached copy with wxPostEvent/AddPendingEvent; attach the receiver as copy origin. Input stays live/unchanged and may be destroyed or changed immediately. Delivery is asynchronous in the managed GUI session.")) ("Errors and scope" (:p "Active main-thread GUI session required. Existing session-isolated receiver and lazy text-entry-origin restrictions apply before emission. No non-GUI immediate dispatch, worker posting or ownership transfer. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer.")) ("wxWidgets" (:p "wxPostEvent / wxEvtHandler::AddPendingEvent, bounded GUI copy mapping (wxWidgets 3.2.12 baseline)."))))
(:entry "api/previous-handler" :names ("previous-handler" "(setf previous-handler)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the native previous link. SETF mirrors NEXT-HANDLER, joining vacant source-previous/peer-next endpoints reciprocally or detaching one edge for NIL. Self/cycle/conflicting occupied endpoints reject before mutation; an existing reciprocal pair is idempotent." :sections (("Syntax" (:code-block "lisp" "(wxlambda:previous-handler handler)")) ("Arguments" (:p "HANDLER is a live owned standalone EVENT-HANDLER/subclass. SETF PEER is another owned standalone handler or NIL.")) ("Returns" (:p "The EQ canonical managed previous wrapper or NIL; SETF returns PEER.")) ("Description" (:p "Read the native previous link. SETF mirrors NEXT-HANDLER, joining vacant source-previous/peer-next endpoints reciprocally or detaching one edge for NIL. Self/cycle/conflicting occupied endpoints reject before mutation; an existing reciprocal pair is idempotent.")) ("Errors and scope" (:p "Active main-thread session and valid owned standalone handles. Reads are permitted during callbacks; SETF rejects RUN/pump/callback use. Borrowed window/application sources and peers reject. Strong canonical roots preserve wrapper/subclass identity, not new native ownership. Attached pushed nodes reject both peer reads and writes; use WINDOW-EVENT-HANDLER/POP/REMOVE so the standalone protocol cannot expose the borrowed window tail.")) ("wxWidgets" (:p "wxEvtHandler::GetPreviousHandler / SetPreviousHandler with managed reciprocal SetNextHandler (wxWidgets 3.2.12 baseline).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:previous-handler handler) peer-or-nil)") (:p "Join or split a reciprocal previous edge at a non-dispatch boundary; return PEER/NIL. Same lifetime, cycle and endpoint validation as NEXT-HANDLER."))))
(:entry "api/process-event" :names ("process-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously dispatch a fresh owned synthetic event through ProcessEvent, copy final veto state and then delete the event. Observer callbacks may run while handled-p is NIL because they Skip; native consumption/default handling determines the first result. Final veto is independent of handled-p and may be true from initial VETOED-P even without a matching handler. Close dispatch can run frame defaults. Callback errors re-signal at the nearer Lisp boundary; handled nested errors do not stop RUN. No final values are returned when a condition escapes, and earlier callback mutations are not rolled back. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-event handler event &rest options &key &allow-other-keys)")) ("Arguments" (:p "HANDLER is a live EVENT-HANDLER/window. KIND and keyword payloads match QUEUE-EVENT. LOGGING-OFF-P defaults NIL and is accepted only for :QUERY-END-SESSION/:END-SESSION; CAN-VETO-P applies to all close-family kinds. The second positional argument may instead be a live OWNED-EVENT, with no payload keyword overrides.")) ("Returns" (:p "Two values: native handled-p and final vetoed-p.")) ("Description" (:p "Synchronously dispatch a fresh owned synthetic event through ProcessEvent, copy final veto state and then delete the event. Observer callbacks may run while handled-p is NIL because they Skip; native consumption/default handling determines the first result. Final veto is independent of handled-p and may be true from initial VETOED-P even without a matching handler. Close dispatch can run frame defaults. Callback errors re-signal at the nearer Lisp boundary; handled nested errors do not stop RUN. No final values are returned when a condition escapes, and earlier callback mutations are not rolled back. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin.")) ("Errors and scope" (:p "Active main-thread session required for registration/dispatch and scoped native access; inactive calls signal NATIVE-ERROR before FFI. Wrong receiver types use CLOS dispatch errors. Registry metadata lasts until session cleanup; snapshot data is immutable. Borrowed application dispatch is supported; no worker dispatch, validated OS session delivery or arbitrary native class construction is provided. Synthetic session kinds require isolated owned standalone handlers; application/window receivers reject before emission. Standalone session fallback to wxApp is suppressed even for skipped, disabled or unmatched delivery. Native application session bindings are distinct from synthetic probes. Owned session event copies retain isolated standalone-receiver guards. Copies carrying borrowed userdata/client pointers or unsupported exact native classes reject. Copied owned :TEXT-CHANGE delivery to text-entry receivers rejects before emission, preventing lazy GetString from shadowing the owned payload. Keyword synthetic behavior is unchanged. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer.")) ("wxWidgets" (:p "wxEvtHandler::ProcessEvent; wxCloseEvent::GetVeto or NOT wxNotifyEvent::IsAllowed after dispatch. (wxWidgets 3.2.12 baseline)."))))
(:entry "api/process-event-locally" :names ("process-event-locally") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Synchronously process an independent detached copy with ProcessEventLocally, including local pre-processing and native chained handlers, without normal outer global-filter/parent/application fallback. Source remains live/unchanged. Observer delivery can return handled NIL; final veto is independent. Native local static/default handlers may still execute, including frame-close behavior; local processing is not observer-only or a no-default-action mode." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-event-locally handler event)")) ("Arguments" (:p "HANDLER is a live EVENT-HANDLER/window; EVENT is a live OWNED-EVENT. No payload overrides.")) ("Returns" (:p "Two values: native handled-p and final-vetoed-p of the processing copy.")) ("Description" (:p "Synchronously process an independent detached copy with ProcessEventLocally, including local pre-processing and native chained handlers, without normal outer global-filter/parent/application fallback. Source remains live/unchanged. Observer delivery can return handled NIL; final veto is independent. Native local static/default handlers may still execute, including frame-close behavior; local processing is not observer-only or a no-default-action mode.")) ("Errors and scope" (:p "Active main-thread GUI session required. Existing supported-class, session-isolation, text-entry receiver and callback/context protections apply. Callback conditions re-signal at the nearer Lisp boundary. No pending queue pump, pushed-handler API or native virtual override is added. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer.")) ("wxWidgets" (:p "wxEvtHandler::ProcessEventLocally on a supported detached copy (wxWidgets 3.2.12 baseline)."))))
(:entry "api/process-events" :names ("process-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-events )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL.")) ("Description" (:p "Yield to GUI events and process idle work without waiting for new input; re-signal callback errors after returning from native polling.")) ("Errors and scope" (:p "Requires an active main-thread GUI session. Forbidden inside RUN, either event pump or any native-to-Lisp callback (NATIVE-ERROR), and inside the application REPL debugger (Lisp error). Existing synchronous notifying setters remain supported.")) ("wxWidgets" (:p "wxAppConsole::Yield(true) and ProcessIdle"))))
(:entry "api/process-pending-events" :names ("process-pending-events") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-pending-events )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL after successful dispatch.")) ("Description" (:p "Dispatch queued wx events for all pending handlers of the bridge application via ProcessPendingEvents. Does not yield to OS input or run ProcessIdle. Does not wait for new events; callback duration and continuously requeued work may delay return. Callback conditions are contained at the native boundary and re-signaled afterwards.")) ("Errors and scope" (:p "Requires an active main-thread GUI session; use before startup or after cleanup signals NATIVE-ERROR. This API is scoped to the bridge application, not arbitrary wxApp instances. Forbidden inside RUN, either pump or any native-to-Lisp callback (NATIVE-ERROR), and inside the application REPL debugger (Lisp error). Dispatch guards recover on callback failure. Synchronous notifying setters remain supported.")) ("wxWidgets" (:p "wxAppConsole::ProcessPendingEvents (wxWidgets 3.2.12 baseline)."))))
(:entry "api/process-window-event" :names ("process-window-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Process a detached copy through native GetEventHandler stack routing, window and normal parent/application fallback. Source remains alive/unchanged; copy origin is WINDOW and callback source can be a pushed handler. Callback conditions re-signal at the nearer Lisp boundary." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-window-event window event)")) ("Arguments" (:p "WINDOW is bridge-managed; EVENT is a live supported OWNED-EVENT. No payload overrides.")) ("Returns" (:p "Two values: native handled-p and final-vetoed-p of an independent copy.")) ("Description" (:p "Process a detached copy through native GetEventHandler stack routing, window and normal parent/application fallback. Source remains alive/unchanged; copy origin is WINDOW and callback source can be a pushed handler. Callback conditions re-signal at the nearer Lisp boundary.")) ("Errors and scope" (:p "Active main-thread session with copied-event exact-class/session/lazy-text guards. Synthetic session delivery rejects; no origin retention or native class replacement. Generic PROCESS-EVENT and queued window operations still bypass pushed handlers.")) ("wxWidgets" (:p "wxWindow::ProcessWindowEvent on an independent owned-event copy (wxWidgets 3.2.12 baseline)."))))
(:entry "api/process-window-event-locally" :names ("process-window-event-locally") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Search the window and its pushed handlers with local pre-processing/validators, without normal upward window propagation. Process an independent detached copy with receiver-window origin and unchanged source. Observer delivery may still return handled NIL. Native local static/default handlers can still run, including frame-close behavior; local routing is not observer-only." :sections (("Syntax" (:code-block "lisp" "(wxlambda:process-window-event-locally window event)")) ("Arguments" (:p "WINDOW is bridge-managed; EVENT is a live supported OWNED-EVENT. No payload overrides.")) ("Returns" (:p "Two values: native handled-p and final-vetoed-p of the local copy.")) ("Description" (:p "Search the window and its pushed handlers with local pre-processing/validators, without normal upward window propagation. Process an independent detached copy with receiver-window origin and unchanged source. Observer delivery may still return handled NIL. Native local static/default handlers can still run, including frame-close behavior; local routing is not observer-only.")) ("Errors and scope" (:p "Active main-thread session and existing copied-event/session/lazy-text guards. Current contexts stay innermost-scoped; callback errors re-signal at the nearer boundary. No pending pump, external native chain adoption or native virtual Lisp hooks.")) ("wxWidgets" (:p "wxWindow::ProcessWindowEventLocally on an independent copy (wxWidgets 3.2.12 baseline)."))))
(:entry "api/pulse-gauge" :names ("pulse-gauge") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode." :sections (("Syntax" (:code-block "lisp" "(wxlambda:pulse-gauge gauge)")) ("Arguments" (:p "GAUGE is a live gauge.")) ("Returns" (:p "The supplied gauge.")) ("Description" (:p "Request platform-native indeterminate progress. Call periodically while keeping the GUI event loop responsive. Visual animation and value readings vary by platform; no timer, worker dispatch or completion event is provided. SETF GAUGE-VALUE restores determinate mode.")) ("Errors and scope" (:p "Requires a live gauge in an active main-thread GUI session. Stale/destroyed handles, native type errors and values above the range signal NATIVE-ERROR; wrong Lisp receivers use CLOS dispatch errors. Numeric arguments must fit signed 32-bit integers; invalid Lisp types/ranges signal TYPE-ERROR. No command events or native virtual overrides.")) ("wxWidgets" (:p "wxGauge::Pulse (wxWidgets 3.2.12 baseline)."))))
(:entry "api/push-event-handler" :names ("push-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Push above the existing stack top while keeping native ownership in the bridge registry. Reject linked/attached or borrowed window/app peers, active session bindings and queued session events before mutation." :sections (("Syntax" (:code-block "lisp" "(wxlambda:push-event-handler window handler)")) ("Arguments" (:p "WINDOW is bridge-managed; HANDLER is a live unlinked standalone owned EVENT-HANDLER/subclass, not already attached.")) ("Returns" (:p "HANDLER after managed push.")) ("Description" (:p "Push above the existing stack top while keeping native ownership in the bridge registry. Reject linked/attached or borrowed window/app peers, active session bindings and queued session events before mutation.")) ("Errors and scope" (:p "Active main-thread non-dispatch boundary; RUN/pump/callback use rejects. Canonical wrapper rooting continues. No raw native adoption or window ownership transfer.")) ("wxWidgets" (:p "wxWindow::PushEventHandler with managed ownership/session guards (wxWidgets 3.2.12 baseline)."))))
(:entry "api/queue-click" :names ("queue-click") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement." :sections (("Syntax" (:code-block "lisp" "(wxlambda:queue-click button)")) ("Arguments" (:p "BUTTON is a live button.")) ("Returns" (:p "T.")) ("Description" (:p "Post a button click for later dispatch. It uses the handler registered at dispatch time, including any replacement.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxPostEvent / wxEVT_BUTTON"))))
(:entry "api/queue-event" :names ("queue-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Queue a copied synthetic event: wxCommandEvent for four command kinds, wxCloseEvent for :CLOSE. Ordinary control properties are not changed directly. A queued close on a frame may run its native default closing action; use CLOSE-WINDOW for a synchronous acceptance result. Explicit UTF-8 lengths preserve text. Close events take no command payload, may be vetoable or non-vetoable, and do not normally propagate to parents. Registry types create wxCommandEvent or wxNotifyEvent according to their declared family. Initial veto applies only to custom notify types. Queuing offers no final veto/handled result; use PROCESS-EVENT when a synchronous decision is required. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin." :sections (("Syntax" (:code-block "lisp" "(wxlambda:queue-event handler event &rest options &key &allow-other-keys)")) ("Arguments" (:p "HANDLER is live; KIND is a built-in keyword or registered name. ID defaults 0; TEXT defaults empty. CHECKED-P is toggle-only; SELECTION is NIL/nonnegative index for selection. CAN-VETO-P is close-family-only (default T). Registered types accept signed INTEGER (default 0) and copied TEXT; registered notify types accept initial VETOED-P (default NIL). LOGGING-OFF-P defaults NIL and is accepted only for :QUERY-END-SESSION/:END-SESSION; CAN-VETO-P applies to all close-family kinds. The second positional argument may instead be a live OWNED-EVENT, with no payload keyword overrides.")) ("Returns" (:p "The supplied handler.")) ("Description" (:p "Queue a copied synthetic event: wxCommandEvent for four command kinds, wxCloseEvent for :CLOSE. Ordinary control properties are not changed directly. A queued close on a frame may run its native default closing action; use CLOSE-WINDOW for a synchronous acceptance result. Explicit UTF-8 lengths preserve text. Close events take no command payload, may be vetoable or non-vetoable, and do not normally propagate to parents. Registry types create wxCommandEvent or wxNotifyEvent according to their declared family. Initial veto applies only to custom notify types. Queuing offers no final veto/handled result; use PROCESS-EVENT when a synchronous decision is required. Owned-event dispatch always clones, attaches the receiver as copy origin and never consumes or mutates the source. The original can be destroyed after queueing or inside callbacks. Processing returns final state from its copy; contextual CLONE-EVENT can retain changed state detached from origin.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, userData, pushed handlers and worker-thread dispatch remain unbound. Synthetic session kinds require isolated owned standalone handlers; application/window receivers reject before emission. Standalone session fallback to wxApp is suppressed even for skipped, disabled or unmatched delivery. Native application session bindings are distinct from synthetic probes. Owned session event copies retain isolated standalone-receiver guards. Copies carrying borrowed userdata/client pointers or unsupported exact native classes reject. Copied owned :TEXT-CHANGE delivery to text-entry receivers rejects before emission, preventing lazy GetString from shadowing the owned payload. Keyword synthetic behavior is unchanged. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer.")) ("wxWidgets" (:p "wxEvtHandler::QueueEvent; wxCommandEvent or wxCloseEvent construction, SetCanVeto at close-event creation only."))))
(:entry "api/register-event-type" :names ("register-event-type") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Allocate a process-local native event type and map NAME in the active session. Duplicate names, built-ins and unsupported families are rejected before registration. Names cannot be unregistered or replaced during this session. Registrations are session-wide metadata, not rolled back when an unrelated resource initializer fails. Native type IDs are not stable across processes." :sections (("Syntax" (:code-block "lisp" "(wxlambda:register-event-type name &key (family :notify))")) ("Arguments" (:p "NAME is a unique keyword not reserved by a built-in kind. FAMILY is :NOTIFY (default) or :COMMAND.")) ("Returns" (:p "The supplied NAME keyword.")) ("Description" (:p "Allocate a process-local native event type and map NAME in the active session. Duplicate names, built-ins and unsupported families are rejected before registration. Names cannot be unregistered or replaced during this session. Registrations are session-wide metadata, not rolled back when an unrelated resource initializer fails. Native type IDs are not stable across processes.")) ("Errors and scope" (:p "Active main-thread session required for registration/dispatch and scoped native access; inactive calls signal NATIVE-ERROR before FFI. Wrong receiver types use CLOS dispatch errors. Registry metadata lasts until session cleanup; snapshot data is immutable. Borrowed application dispatch is supported; no worker dispatch, validated OS session delivery or arbitrary native class construction is provided.")) ("wxWidgets" (:p "wxNewEventType; synthetic wxCommandEvent/wxNotifyEvent family registration (wxWidgets 3.2.12 baseline)."))))
(:entry "api/remove-event-handler" :names ("remove-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Preflight membership and detach without deletion. A live detached handler or handler belonging to another window returns NIL unchanged; only present entries reach native RemoveEventHandler, avoiding its absent-entry assertion." :sections (("Syntax" (:code-block "lisp" "(wxlambda:remove-event-handler window handler)")) ("Arguments" (:p "WINDOW is bridge-managed; HANDLER is a live owned standalone handler.")) ("Returns" (:p "T if removed from this window; NIL for a valid nonmember.")) ("Description" (:p "Preflight membership and detach without deletion. A live detached handler or handler belonging to another window returns NIL unchanged; only present entries reach native RemoveEventHandler, avoiding its absent-entry assertion.")) ("Errors and scope" (:p "Active main-thread non-dispatch boundary; RUN/pump/callback use, stale peers and borrowed window/application peers reject. Own pending queue and native ownership survive; other stack entries remain intact.")) ("wxWidgets" (:p "wxWindow::RemoveEventHandler with safe managed membership probe (wxWidgets 3.2.12 baseline)."))))
(:entry "api/resume-event-propagation" :names ("resume-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Restore the native propagation level without changing Skip. Zero is allowed and keeps propagation stopped. Invalid LEVEL signals TYPE-ERROR; expired contexts reject native access." :sections (("Syntax" (:code-block "lisp" "(wxlambda:resume-event-propagation event level)")) ("Arguments" (:p "CONTEXT is current; LEVEL is an integer from 0 through 2147483647, commonly returned by STOP-EVENT-PROPAGATION. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "The supplied context.")) ("Description" (:p "Restore the native propagation level without changing Skip. Zero is allowed and keeps propagation stopped. Invalid LEVEL signals TYPE-ERROR; expired contexts reject native access.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::ResumePropagation (wxWidgets 3.2.12 baseline)."))))
(:entry "api/return-to-application-repl" :names ("return-to-application-repl") :kind :restart :kind-name "Restart" :package "WXLAMBDA" :summary "Abandon the failing REPL evaluation or callback operation using the active debugger restart." :sections (("Syntax" (:code-block "lisp" "(invoke-restart 'wxlambda:return-to-application-repl)")) ("Arguments" (:p "No arguments; invoke this restart from the application REPL debugger.")) ("Returns" (:p "Control returns to the application REPL.")) ("Description" (:p "Abandon the failing REPL evaluation or callback operation using the active debugger restart.")) ("Errors and scope" (:p "This is an exported restart name, not a callable function. Available only while the application REPL debugger establishes it.")) ("wxWidgets" (:p "Lisp-only debugger recovery."))))
(:entry "api/run" :names ("run") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code." :sections (("Syntax" (:code-block "lisp" "(wxlambda:run )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL after the event loop returns.")) ("Description" (:p "Block until STOP or the last top-level frame closes. Callback errors are re-signaled after returning from native code.")) ("Errors and scope" (:p "Requires an active main-thread GUI session and at least one frame. Forbidden inside RUN, either pump, any native-to-Lisp callback, and the application REPL. Native failures and callback conditions propagate.")) ("wxWidgets" (:p "wxAppConsole::OnRun"))))
(:entry "api/selection" :names ("selection" "(setf selection)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read selected index; NIL represents native no selection." :sections (("Syntax" (:code-block "lisp" "(wxlambda:selection choice &key notify)")) ("Arguments" (:p "CHOICE is a live dropdown choice. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "Zero-based index or NIL.")) ("Description" (:p "Read selected index; NIL represents native no selection.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxChoice::GetSelection")) ("SETF" (:code-block "lisp" "(setf (wxlambda:selection choice :notify notify) new-value)") (:p "Store an in-range zero-based index or NIL. :NOTIFY T emits a synchronous selection event, including unchanged assignments. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/show-window" :names ("show-window") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value." :sections (("Syntax" (:code-block "lisp" "(wxlambda:show-window window &optional (show t))")) ("Arguments" (:p "WINDOW is live; optional SHOW is a generalized boolean (default T).")) ("Returns" (:p "WINDOW, then a boolean indicating whether its shown state changed.")) ("Description" (:p "Show with true SHOW, hide with NIL. Existing one-argument calls still show the window and return it as their primary value.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::Show(bool) / Hide() equivalent (wxWidgets 3.2)."))))
(:entry "api/shown-p" :names ("shown-p" "(setf shown-p)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility." :sections (("Syntax" (:code-block "lisp" "(wxlambda:shown-p window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "T or NIL.")) ("Description" (:p "Read the window's own shown flag. A hidden ancestor does not change this flag; it does not report effective screen visibility.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::IsShown (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:shown-p window) new-value)") (:p "Assign the own shown flag; return the supplied value and a second native changed-state flag. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/stop" :names ("stop") :kind :function :kind-name "Function" :package "WXLAMBDA" :summary "Leave RUN or end the application REPL. Stopping the loop does not destroy windows." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stop )")) ("Arguments" (:p "No arguments.")) ("Returns" (:p "NIL in the application REPL; T after stopping a native RUN loop.")) ("Description" (:p "Leave RUN or end the application REPL. Stopping the loop does not destroy windows.")) ("Errors and scope" (:p "Outside the application REPL, a running native event loop is required; otherwise NATIVE-ERROR.")) ("wxWidgets" (:p "wxAppConsole::ExitMainLoop"))))
(:entry "api/stop-event-propagation" :names ("stop-event-propagation") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION." :sections (("Syntax" (:code-block "lisp" "(wxlambda:stop-event-propagation event)")) ("Arguments" (:p "CONTEXT is the current event context. A live OWNED-EVENT is also accepted for applicable operations.")) ("Returns" (:p "Previous nonnegative native propagation level.")) ("Description" (:p "Set propagation level to zero. It does not set Skip; set Skip true when other local observers should continue without propagating to parents. Save the returned level for RESUME-EVENT-PROPAGATION.")) ("Errors and scope" (:p "Requires an active main-thread session and the innermost currently executing contextual callback. Expired or outer contexts in nested callbacks signal NATIVE-ERROR for native access. Activity queries return NIL for those contexts during a session; outside a session they signal NATIVE-ERROR. No raw native event pointer escapes. Built-ins and registered command/notify types. Veto applies only to actual wxCloseEvent/wxNotifyEvent contexts; arbitrary event types, general event construction/cloning and native control-specific subclasses and validated OS session delivery remains open. Live OWNED-EVENT receivers are also supported under the same native field/family validation. They require an active main-thread session and remain mutable until destroyed; snapshots stay immutable.")) ("wxWidgets" (:p "wxEvent::StopPropagation (wxWidgets 3.2.12 baseline)."))))
(:entry "api/text" :names ("text" "(setf text)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the current UTF-8 text; returned storage survives later native calls." :sections (("Syntax" (:code-block "lisp" "(wxlambda:text control &key notify)")) ("Arguments" (:p "CONTROL is a live text control. Optional NOTIFY affects writes and is ignored by reads.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the current UTF-8 text; returned storage survives later native calls.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxTextEntry::GetValue (wxTextCtrl only)")) ("SETF" (:code-block "lisp" "(setf (wxlambda:text control :notify notify) new-value)") (:p "Text replacement is silent by default. :NOTIFY T emits text-change events synchronously; callback conditions return to the writer caller. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/text-control" :names ("text-control") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "CLOS wrapper for wxTextCtrl with text-change handler support." :sections (("Syntax" (:code-block "lisp" "wxlambda:text-control")) ("Arguments" (:p "Superclass: WXLAMBDA:WINDOW.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "CLOS wrapper for wxTextCtrl with text-change handler support.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxTextCtrl (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:text-control :parent parent :value \"\")") (:p "PARENT is required; VALUE defaults to an empty string. Class :DEFAULT-INITARGS and custom slot initargs are honored; native creation precedes subclass AFTER hooks."))))
(:entry "api/transfer-event" :names ("transfer-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it." :sections (("Syntax" (:code-block "lisp" "(wxlambda:transfer-event handler event)")) ("Arguments" (:p "HANDLER is a live EVENT-HANDLER/window; EVENT is a live OWNED-EVENT to consume. No payload overrides.")) ("Returns" (:p "HANDLER after native handoff.")) ("Description" (:p "Validate before consuming, then remove the actual event from the owned registry, attach receiver origin and hand it to wxQueueEvent. Input becomes non-live and cannot be accessed, cloned or destroyed by its former owner. Destination deletion or pending-event cancellation does not restore it.")) ("Errors and scope" (:p "Active main-thread GUI session required. Preflight failures leave the owned input live; no rollback or delivery guarantee after handoff, including a post-handoff error. Existing session/text-entry receiver restrictions apply before consumption. No raw pointer or arbitrary native class transfer. Managed standalone chains participate in native traversal; linking does not change pending queue ownership or introduce window/app pushed chains. Window receivers retain wxEvtHandler semantics and bypass pushed stacks; explicit PROCESS-WINDOW-EVENT/LOCALLY provide stack-aware synchronous routing. Synthetic session delivery to attached pushed handlers rejects before emission/transfer.")) ("wxWidgets" (:p "wxQueueEvent / wxEvtHandler::QueueEvent native ownership handoff for supported owned events (wxWidgets 3.2.12 baseline)."))))
(:entry "api/unbind-event" :names ("unbind-event") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns." :sections (("Syntax" (:code-block "lisp" "(wxlambda:unbind-event binding)")) ("Arguments" (:p "BINDING is an EVENT-BINDING.")) ("Returns" (:p "T if this active registration was removed; NIL if already unbound or receiver expired.")) ("Description" (:p "Remove exactly one registration, including from inside itself or another callback. The current callback may finish; later deliveries cannot invoke the removed function. Releases generic callback roots. A live native binding object is retained until an active callback returns.")) ("Errors and scope" (:p "Active main-thread GUI session required; otherwise NATIVE-ERROR. Stale/deleting receivers reject registration/queuing. Invalid event kinds, IDs and payload options signal Lisp errors; wrong receiver types use CLOS dispatch errors. Built-ins and registered command/notify types. Contexts support scoped Skip/propagation and checked close/notify veto. Arbitrary native events, native control-specific notify subclasses, userData, pushed handlers and worker-thread dispatch remain unbound.")) ("wxWidgets" (:p "wxEvtHandler::Unbind member-method overload, exact receiver/type/ID-range/native binding identity (wxWidgets 3.2.12 baseline)."))))
(:entry "api/unlink-event-handler" :names ("unlink-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only." :sections (("Syntax" (:code-block "lisp" "(wxlambda:unlink-event-handler handler)")) ("Arguments" (:p "HANDLER is a live owned standalone EVENT-HANDLER/subclass.")) ("Returns" (:p "HANDLER, detached and still alive.")) ("Description" (:p "Splice the native previous/next neighbors together, then detach both source edges. Does not destroy the handler, transfer ownership or move its pending queue. Already unlinked input is harmless. This differs from SETF NIL, which detaches one edge only.")) ("Errors and scope" (:p "Active main-thread non-dispatch boundary required. RUN/pump/callback use and borrowed window/application sources reject before mutation. Linked callback-time destruction also rejects; outside callbacks native destruction can unlink/splice normally. Attached nodes reject: use POP-EVENT-HANDLER or REMOVE-EVENT-HANDLER to detach from a window first.")) ("wxWidgets" (:p "wxEvtHandler::Unlink for managed standalone chains (wxWidgets 3.2.12 baseline)."))))
(:entry "api/window" :names ("window") :kind :class :kind-name "Class" :package "WXLAMBDA" :summary "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler." :sections (("Syntax" (:code-block "lisp" "wxlambda:window")) ("Arguments" (:p "Superclass: WXLAMBDA:EVENT-HANDLER. WINDOW is abstract.")) ("Returns" (:p "A native-backed instance of this class or a subclass (WINDOW itself is abstract).")) ("Description" (:p "Abstract CLOS base of the bound window wrappers. Reuses its wxWindow as a borrowed wxEvtHandler; construction creates one native widget, not a second handler.")) ("Errors and scope" (:p "Construction requires an active main-thread application session. Concrete classes create their native widgets in inherited INITIALIZE-INSTANCE methods; subclass AFTER hooks can use them. Native handles cannot be supplied as initargs. Lisp subclassing does not imply native C++ virtual callbacks.")) ("wxWidgets" (:p "wxWindow (wxWidgets 3.2); this is a Lisp wrapper, not a native subclass.")) ("Construction" (:code-block "lisp" "(make-instance 'wxlambda:frame)") (:p "WINDOW is abstract. Instantiate a concrete class or its subclass; mixins are allowed, but a class must represent exactly one native widget kind."))))
(:entry "api/window-event-handler" :names ("window-event-handler") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-event-handler window)")) ("Arguments" (:p "WINDOW is a valid bridge-managed window/subclass.")) ("Returns" (:p "Canonical top pushed handler wrapper, or the identical WINDOW when no managed handler is pushed.")) ("Description" (:p "Read native GetEventHandler through the bridge managed-stack identity map. It does not reconstruct or adopt unknown native handlers and has no SETF writer.")) ("Errors and scope" (:p "Active main-thread session; reads allowed in callbacks while window is valid/non-deleting. No arbitrary SetEventHandler, external native stack adoption or raw pointer access.")) ("wxWidgets" (:p "wxWindow::GetEventHandler, managed stack only (wxWidgets 3.2.12 baseline)."))))
(:entry "api/window-name" :names ("window-name" "(setf window-name)") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-name window)")) ("Arguments" (:p "WINDOW is any live bound window or control.")) ("Returns" (:p "An independent Lisp string.")) ("Description" (:p "Read the logical window name, independent of displayed labels, text, title and native ID. Names need not be unique; Unicode, empty strings and embedded NULs are preserved.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetName (wxWidgets 3.2).")) ("SETF" (:code-block "lisp" "(setf (wxlambda:window-name window) new-value)") (:p "Copy the logical name, preserving Unicode, empty strings and embedded NULs. Writers are generic functions with VALUE first, followed by the receiver."))))
(:entry "api/window-position" :names ("window-position") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query position relative to parent; frame coordinates are screen-relative." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-position window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: X and Y.")) ("Description" (:p "Query position relative to parent; frame coordinates are screen-relative.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetPosition"))))
(:entry "api/window-size" :names ("window-size") :kind :generic-function :kind-name "Generic Function" :package "WXLAMBDA" :summary "Query outer window dimensions in wxWidgets coordinates." :sections (("Syntax" (:code-block "lisp" "(wxlambda:window-size window)")) ("Arguments" (:p "WINDOW is live.")) ("Returns" (:p "Two integer values: WIDTH and HEIGHT.")) ("Description" (:p "Query outer window dimensions in wxWidgets coordinates.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process. Widget behavior uses CLOS generic dispatch. Wrong receiver types signal Lisp dispatch conditions; native handle/state failures signal NATIVE-ERROR.")) ("wxWidgets" (:p "wxWindow::GetSize"))))
(:entry "api/with-application" :names ("with-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-application () &body body)")) ("Arguments" (:p "Empty options list, followed by BODY forms.")) ("Returns" (:p "The values of the last BODY form.")) ("Description" (:p "Evaluate BODY within CALL-WITH-APPLICATION with guaranteed cleanup.")) ("Errors and scope" (:p "Requires an active GUI session on the process main thread. Invalid/destroyed handles or unsupported native arguments signal NATIVE-ERROR; Lisp argument/type errors remain Lisp conditions. One GUI session per process.")) ("wxWidgets" (:p "wxEntryStart / wxEntryCleanup"))))
(:entry "api/with-repl-application" :names ("with-repl-application") :kind :macro :kind-name "Macro" :package "WXLAMBDA" :summary "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events." :sections (("Syntax" (:code-block "lisp" "(wxlambda:with-repl-application (&key (input '*standard-input*)
                                     (output '*standard-output*)
                                     (on-error :debug)) &body body)")) ("Arguments" (:p "Options INPUT, OUTPUT and ON-ERROR (:DEBUG or :REPORT), then BODY setup forms.")) ("Returns" (:p "NIL when the cooperative REPL exits.")) ("Description" (:p "Run setup, then evaluate terminal input while polling GUI events. STOP or EOF exits; incomplete input and debugging pause GUI events.")) ("Errors and scope" (:p "Main-thread, one-session contract. Setup conditions propagate. :DEBUG preserves restarts; :REPORT prints recovery diagnostics.")) ("wxWidgets" (:p "wxApp event polling; SBCL/CCL terminal integration."))))
(:entry "guide/README.md" :names ("README.md" "README") :kind :guide :kind-name "Guide" :summary "README.md" :sections (("Guide" (:heading 1 "wxlambda") (:p "Common Lisp bindings for wxWidgets, using CFFI and a small C++ bridge with a versioned C ABI. This is an application lifecycle prototype, not a complete wxWidgets binding.") (:p "Implemented: application startup/shutdown, frames, panels, buttons, editable text, static labels, two-state checkboxes, dropdown choices, progress gauges, row/column layouts, spacers, text/state access, removable click/text/toggle/selection handlers, copied event payloads, queued clicks, and window visibility/input state. Lisp objects wrap checked integer handles; native pointers never escape the bridge.") (:p "First-release lifecycle limits: " (:b "one GUI session per process") ". Closing a window does not release its registered Lisp handlers; unbind them before destruction, or they remain rooted until session cleanup. Restart Lisp for a new GUI session.") (:p "The " (:ref "guide/docs/CLOS-API.md" "CLOS widget API") " provides direct native-backed " (:code "make-instance") " construction, subclass initargs/defaults/hooks and thirteen generic " (:code "setf") " accessors. The " (:code "make-*") " conveniences forward to " (:code "make-instance") " with " (:code ":class") " support. The ground-up API has 55 named generic operations plus thirteen generic property writers. Native C++ virtual callbacks remain separate work.") (:p "Progress controls support range/value properties, orientation and indeterminate pulsing; see " (:ref "guide/docs/GAUGE.md" "the gauge guide") " and runnable " (:ref "example/examples/gauge.lisp" "example") ".") (:p "The " (:ref "guide/docs/APPLICATION-EVENTS.md" "application event guide") " explains native main-loop and pending-event queries, explicit queued-event dispatch and the callback reentrancy boundary.") (:p "The " (:ref "guide/docs/EVENT-HANDLERS.md" "event-handler foundation") " adds session-owned standalone handlers, borrowed window identities, liveness checks and a generic event-processing flag. Independent multi-event/ID observer bindings now cover the four current command kinds; see " (:ref "guide/docs/EVENT-BINDINGS.md" "binding and queue scope") ". Optional " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") " now control native Skip and propagation while snapshots stay immutable. The " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") " adds scoped veto, immutable close flags and frame close requests. " (:code "event-type") " replaces the command-only lookup name. Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "command/notify types") " now support copied payloads and synchronous validation before applying a change. OS session routing needs an application handler view; native notify subclasses remain open C1 work.") (:heading 2 "Documentation and examples") (:p "The " (:ref "guide/docs/DOCSET.md" "Cadre docset") " includes the public API reference, project guides and example sources in one searchable artifact under " (:code "docs/docset/") ". Use " (:code "python3 tools/docset.py build") ", " (:code "check") ", or " (:code "install") "; the docset library checkout is a build-tool dependency, separate from the GUI runtime. Read " (:ref "guide/docs/WINDOW-STATE.md" "window state") " for the first coverage implementation slice: " (:code "show-window") " now accepts an optional boolean for showing/hiding, while " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " query/control visibility and input. The runnable " (:ref "example/examples/window-state.lisp" "window-state example") " demonstrates these operations through button callbacks. The next slice adds " (:ref "guide/docs/WINDOW-METADATA.md" "window names and frame titles") ": " (:code "window-name") " and " (:code "frame-title") " with their generic " (:code "setf") " writers, with a " (:ref "example/examples/window-metadata.lisp" "metadata callback example") " and copied Unicode string results.") (:heading 2 "Build") (:p "Requirements: a C++17 compiler, CMake 3.16+, wxWidgets 3.2+, Common Lisp, ASDF, and CFFI. Install CFFI using your preferred dependency manager, for example " (:code "(ql:quickload :cffi)") " with Quicklisp.") (:p "On macOS with Homebrew:") (:code-block "sh" "brew install cmake wxwidgets@3.2
cmake -S . -B build \\
  -DwxWidgets_CONFIG_EXECUTABLE=\"$(brew --prefix wxwidgets@3.2)/bin/wx-config-3.2\"
cmake --build build") (:p "On Linux with wxWidgets development packages and " (:code "wx-config") " on PATH:") (:code-block "sh" "cmake -S . -B build
cmake --build build") (:p "Windows uses the same CMake project. Supply a wxWidgets installation compatible with your compiler using CMake's FindwxWidgets settings. Multi-configuration builds may put " (:code "wxlambda.dll") " under " (:code "build/Release/") "; load it explicitly before starting the application with " (:code "(wxlambda:load-native-library #P\"C:/path/to/wxlambda.dll\")") ". Dependent wxWidgets DLLs must also be discoverable by the OS loader.") (:p "The bridge normally loads from " (:code "build/") ", then falls back to the system library search path. The Lisp/native ABI version (currently 29) is checked on load; rebuild the bridge after updating the bindings. Installing the bridge with CMake does not install the ASDF system.") (:heading 2 "Run") (:p "From this directory, assuming Quicklisp is installed in " (:code "~/quicklisp") ":") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Or with Clozure CL:") (:code-block "sh" "ccl --load ~/quicklisp/setup.lisp --load examples/hello.lisp") (:p "Click the button to update the text; close the window to return to Lisp. Run each example in a fresh process: this prototype supports one application session per process.") (:p "For an existing image, load " (:code "wxlambda.asd") ", then " (:code "(asdf:load-system \"wxlambda\")") ". The basic API is:") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title \"Hello\"))
         (panel (wxlambda:make-panel frame))
         (text (wxlambda:make-text panel :value \"Hello, λ\"))
         (button (wxlambda:make-button panel :label \"Click\")))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel text)
    (wxlambda:add-child panel button)
    (wxlambda:on-click button
      (lambda () (setf (wxlambda:text text) \"Hello from Lisp!\")))
    (wxlambda:show-window frame)
    (wxlambda:run)))") (:heading 2 "Labels and checkboxes") (:p (:code "make-label") " creates non-editable static text. " (:code "label-text") " returns an independent Lisp string and " (:code "(setf label-text)") " updates it. These accessors take a label created by " (:code "make-label") "; raw strings use wxWidgets' label/mnemonic syntax. After changing a label's preferred size, call " (:code "layout-window") " on its parent to reflow the layout.") (:p (:code "make-checkbox") " creates a two-state checkbox, unchecked by default. " (:code "checked-p") " returns " (:code "t") " or " (:code "nil") ". The " (:code ":checked") " constructor keyword and " (:code "(setf checked-p)") " accept generalized booleans: " (:code "nil") " means unchecked, any other value means checked. " (:code "(setf checked-p)") " returns the supplied value; the predicate reads it normalized to " (:code "t") " or " (:code "nil") "; a handler may change the live state again before the setter returns.") (:code-block "lisp" "(let ((caption (wxlambda:make-label panel :label \"Preferences\"))
      (box (wxlambda:make-checkbox panel :label \"Include a greeting\" :checked t)))
  (wxlambda:add-child panel caption)
  (wxlambda:add-child panel box :expand nil)
  (wxlambda:on-toggle box
    (lambda (event)
      (setf (wxlambda:label-text caption) (if (wxlambda:event-checked-p event) \"Greeting enabled\" \"Greeting disabled\"))
      (wxlambda:layout-window panel)))
  (setf (wxlambda:checked-p box) nil)            ; silent
  (setf (wxlambda:checked-p box :notify t) t)    ; synchronous toggle event
  (wxlambda:off-toggle box))") (:p (:code "on-toggle") " takes a function accepting one event, with kind " (:code ":toggle") ", the original checkbox as its source, and a boolean " (:code "event-checked-p") " snapshot. Native user interaction emits events. " (:code "(setf checked-p)") " is silent by default; " (:code ":notify t") " emits one synchronous event, including when the value is unchanged. The snapshot survives nested changes to the control and later window destruction. Replacing a handler releases its registered closure; " (:code "off-toggle") " releases it and is idempotent for a live checkbox, including from inside the handler. Setter errors follow the same recoverable boundary as text-change handlers.") (:p "Run " (:ref "example/examples/form.lisp" "examples/form.lisp") " for a form using labels, text input, a checkbox, a greeting-style dropdown, row/column layouts, and submit/reopen buttons:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/form.lisp") (:p "The reusable application lives in " (:code "examples/form-app.lisp") ". For live development, load that file and evaluate " (:code "(wxlambda-form:start-live)") " from a terminal REPL:") (:code-block "lisp" "(load \"examples/form-app.lisp\")
(wxlambda-form:start-live)
;; Evaluate these inside the application REPL:
(setf (wxlambda:text wxlambda-form:*name* :notify t) \"Ada λ\")
(setf (wxlambda:selection wxlambda-form:*style* :notify t) 1)
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action
  (lambda () (setf (wxlambda:label-text wxlambda-form:*status*) \"Custom submit\")))
(wxlambda:queue-click wxlambda-form:*submit*)
(wxlambda-form:set-submit-action) ; restore the named SUBMIT-FORM action
(wxlambda-form:close-window)      ; unbind every handler before destruction
(wxlambda-form:open-window)       ; recreate with retained input values
(wxlambda:stop)") (:p "The “Reopen form” button performs the same explicit unbinding and recreation within a GUI callback. The default submit action resolves " (:code "submit-form") " by name, so redefining that function also takes effect live. The application uses public bindings throughout; no new native operations were needed. It retains the one-session-per-process limit. If the user closes the native frame before explicit unbinding, its stale handles cannot release the registered closures; those remain rooted until session cleanup. Normal startup exits with the last window; the application REPL remains available after closing it.") (:heading 2 "Layout") (:p "Use " (:code "make-column") " for vertical layout and " (:code "make-row") " for horizontal layout. A window has one sizer. To nest orientations, create a child panel, give it its own row or column, then add that panel to its parent's layout. " (:code "add-child") " requires the child's native parent to be the layout's window.") (:code-block "lisp" "(wxlambda:make-row panel)
(wxlambda:add-child panel text :proportion 1 :border 0)
(wxlambda:add-spacer panel 12)
(wxlambda:add-child panel button :border 0 :expand nil :align :center)") (:p (:code "add-child") " accepts these layout options:") (:table :header (("Keyword") ("Default") ("Meaning")) :rows ((((:code ":proportion")) ((:code "0")) ("Nonnegative weight along the layout axis; zero keeps the item's preferred extent")) (((:code ":border")) ((:code "8")) ("Nonnegative spacing on each of the four sides")) (((:code ":expand")) ((:code "t")) ("Fill the available space across the layout axis")) (((:code ":align")) ((:code ":start")) ("With " (:code ":expand nil") ", place at " (:code ":start") ", " (:code ":center") ", or " (:code ":end") " across the axis")))) (:p "In a row, alignment controls vertical placement; in a column, it controls horizontal placement. " (:code ":expand t") " with " (:code ":align :center") " or " (:code ":end") " is rejected. Proportions and stretch allocation remain subject to native minimum sizes. The defaults preserve the original " (:code "add-child") " behavior.") (:p (:code "(add-spacer panel size)") " inserts fixed space along the layout axis. " (:code "(add-stretch panel :proportion 1)") " inserts flexible space with a positive weight, sharing available room with other proportional items. Both return the panel. Invalid sizes, proportions, parent relationships, and duplicate insertions signal errors before the sizer is modified.") (:p (:code "layout-window") " recomputes a window's layout. " (:code "add-child") ", " (:code "add-spacer") ", and " (:code "add-stretch") " also lay out their parent immediately. Layouts participate in wxWidgets' normal resize handling. " (:code "window-position") " returns X and Y as two values, relative to the parent's client area (screen coordinates for top-level frames). " (:code "window-size") " returns outer width and height as two values. Dimensions and spacing use wxWidgets window coordinates, not framebuffer pixel counts; native minimum sizes and display scaling remain wxWidgets' responsibility.") (:p "Run " (:ref "example/examples/layout.lisp" "examples/layout.lisp") " to try nested rows and columns, a text field that takes the available width, and a footer with flexible spacing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/layout.lisp") (:heading 2 "Events") (:p "Existing " (:code "(on-click button (lambda () ...))") " handlers still take no arguments. Opt into an event argument with " (:code ":with-event t") ":") (:code-block "lisp" "(wxlambda:on-click button
  (lambda (event)
    (format t \"Clicked ~S~%\" (wxlambda:event-source event)))
  :with-event t)

(wxlambda:on-text-change text
  (lambda (event)
    (format t \"New text: ~A~%\" (wxlambda:event-text event))))

(setf (wxlambda:text text) \"Silent update\")
(setf (wxlambda:text text :notify t) \"Notify the handler\")
(wxlambda:off-text-change text)") (:p (:code "event-p") " recognizes event snapshots. Their read-only slots are exposed through:") (:table :header (("Accessor") ("Click event") ("Text-change event") ("Toggle event")) :rows ((((:code "event-kind")) ((:code ":click")) ((:code ":text-change")) ((:code ":toggle"))) (((:code "event-source")) ("Original button") ("Original text control") ("Original checkbox")) (((:code "event-text")) ((:code "nil")) ("Copied string, including " (:code "\"\"") " for empty text") ((:code "nil"))) (((:code "event-checked-p")) ((:code "nil")) ((:code "nil")) ("Copied " (:code "t") " or " (:code "nil") " state")))) (:p "Text-change handlers always take one event argument. Typing into the native text field emits events. " (:code "(setf text)") " stays silent by default to avoid update loops; " (:code ":notify t") " uses wxWidgets' notifying setter and may call the handler immediately, before the setter returns. Handlers can therefore run before " (:code "run") " starts.") (:p "The text payload describes that event, rather than a later read of the control. It remains valid across nested updates, handler unbinding, and window destruction. Event text is an independent Lisp string; callers can retain or modify their copy. The source wrapper remains available, but native operations on it fail after its window is destroyed. Event slots do not expose any borrowed native pointers.") (:p "Use " (:code "off-click") ", " (:code "off-text-change") ", or " (:code "off-toggle") " to release a handler. Registering again replaces and releases the previous closure. Both removals are idempotent for a live control of the correct type and may be called inside the handler itself.") (:heading 2 "Dropdown choices") (:code-block "lisp" "(let ((choice (wxlambda:make-choice panel
                :items '(\"Small\" \"Medium\" \"Large λ\") :selection 1)))
  (wxlambda:on-selection choice
    (lambda (event)
      (format t \"Selected index: ~S~%\" (wxlambda:event-selection event))))
  (setf (wxlambda:selection choice) 2)           ; silent
  (setf (wxlambda:selection choice :notify t) 0) ; synchronous notification
  (wxlambda:selection choice))               ; => 0") (:p (:code "make-choice") " copies a list of strings in the supplied order. Items are fixed for the life of the control. Selection indices are zero-based; " (:code "nil") " means no selection and is the default, including for a nonempty list. Empty lists are supported. An out-of-range index signals an error without changing the selection. The dropdown participates in layouts and parent ownership like other controls.") (:p "User selection and " (:code "(setf selection)") " with " (:code ":notify t") " deliver one " (:code ":selection") " event. " (:code "event-selection") " is an immutable index snapshot (or " (:code "nil") "), independent of later selection changes. Other event kinds have a " (:code "nil") " selection slot. " (:code "(setf selection)") " returns the requested index even if a handler changes it again; explicit notification also fires for an unchanged index. Handler errors are re-signaled at the setter boundary. " (:code "on-selection") " replaces the previous handler; " (:code "off-selection") " releases it and is idempotent for a live choice, including inside its callback. As with other strings, embedded NUL characters are unsupported.") (:heading 2 "Lifecycle contract") (:list (:item (:p (:code "with-application") " initializes the toolkit and cleans up on normal return or a"))) (:p "Lisp error. Call " (:code "run") " explicitly to enter the blocking GUI loop.") (:list (:item (:p "GUI calls must run on the main thread. On macOS, the SBCL command-line main"))) (:p "thread works directly. CCL uses a small implementation adapter to execute the application body on its initial process, synchronously. Caller thread dynamic bindings are not transferred by that adapter; establish needed bindings inside the application body. Starting from an SBCL worker/SLIME thread is rejected.") (:list (:item (:p "Native GUI code assumes masked floating-point traps. The SBCL adapter masks"))) (:p "them for the application session and restores the caller's state afterward.") (:list (:item (:p "Parents own their children. Closing/destroying a parent invalidates child"))) (:p "handles. Lisp wrapper objects may survive, but subsequent operations signal " (:code "native-error") ". Destruction can be deferred by wxWidgets until event processing.") (:list (:item (:p "Click handlers take zero arguments by default, or one event with"))) (:p (:code ":with-event t") ". Text-change and toggle handlers take one event. Handler replacement or explicit unbinding releases the registered closure. Queued clicks use the handler present when they are dispatched, so unbinding suppresses queued clicks and rebinding redirects them to the new handler. Closures for destroyed controls remain rooted until session cleanup unless explicitly unbound before destruction. There are no GC-driven native destructors.") (:list (:item (:p "Errors in synchronous text-change or toggle callbacks are saved until the notifying"))) (:p "setter returns to Lisp, then re-signaled so its caller can handle them without stopping the loop. Errors escaping the outer event callback request a loop stop and are re-signaled after the event loop returns. This also covers notifying setters called before the event loop starts. Errors escaping the application body trigger cleanup. Do not use " (:code "throw") ", " (:code "return-from") ", or other nonlocal exits across a callback's foreign boundary. Handle expected conditions inside the handler or around the notifying setter.") (:list (:item (:p (:code "text") " returns an independent Lisp string containing the current text;"))) (:p (:code "(setf text)") " updates it. Both use UTF-8. The native " (:code "wxl_get_text") " buffer is borrowed until the next getter call on that thread and is copied immediately by Lisp. A null pointer reports failure; an empty string is a successful empty value. Strings containing embedded NUL characters are not supported by this interface.") (:list (:item (:p "One GUI session per process; no application restart, background-thread GUI"))) (:p "scheduling, or virtual-method overrides yet.") (:heading 2 "REPL development") (:p "From a main-thread terminal Lisp REPL, initialize an application and enter its cooperative REPL (do not call " (:code "run") " in the setup body):") (:code-block "lisp" "(defvar *frame*)
(defvar *text*)
(wxlambda:with-repl-application ()
  (setf *frame* (wxlambda:make-frame :title \"Live development\")
        *text* (wxlambda:make-text *frame* :value \"Edit me\"))
  (wxlambda:show-window *frame*))") (:p "Then evaluate " (:code "(setf (wxlambda:text *text*) \"Updated live\")") ", redefine functions used by callbacks, or replace handlers without closing the application. Evaluate " (:code "(wxlambda:stop)") " or send EOF to leave and clean up. Closing the last window keeps this REPL available so you can create another frame in the same session. " (:code "run") " signals an error inside this REPL because events are already being processed. Errors enter the host Lisp debugger by default (" (:code ":on-error :debug") "). Evaluation conditions reach it before unwinding, preserving their local restarts. Choose " (:code "wxlambda:return-to-application-repl") " to abandon the current operation and keep the session, or use an available evaluation restart to resume the form. Debugger I/O uses the host's " (:code "*debug-io*") "; " (:code ":input") " and " (:code ":output") " configure only application REPL I/O. Setup-body errors propagate to the caller and clean up the session.") (:p "For scripts or a host with debugging disabled, use " (:code "(wxlambda:with-repl-application (:on-error :report) ...)") ". This prints the condition type/message and up to 20 backtrace frames on SBCL/CCL before abandoning the operation and continuing. Other Lisps report that a backtrace is unavailable; they are not validated platforms. The debugger policy respects the host's debugger hooks and batch-mode restrictions; it does not override them.") (:p "Callback errors are delivered to this policy only after returning safely from the native callback. Their original condition is preserved, but callback-local restarts and callback stack frames have already unwound. Debugger backtraces for these errors show their Lisp delivery boundary. This small REPL prints all returned values; it does not provide the host REPL's history variables or editor integration. Optional " (:code ":input") " and " (:code ":output") " streams default to standard I/O.") (:p "Events are pumped while waiting for input. Incomplete forms, long evaluations, and debugger stops pause GUI processing. " (:code "process-events") " is rejected while the application REPL's debugger is active; queued events resume after recovery. During long evaluations outside the debugger, call " (:code "process-events") " explicitly when useful. The main-thread requirements above still apply. Editor REPLs such as SLIME and SLY are unsupported by this helper; use a terminal Lisp REPL. In particular, SBCL worker-thread startup is rejected. After leaving, start a fresh Lisp process for another session.") (:p "For a complete live-development example, load " (:code "examples/live.lisp") " and call " (:code "(wxlambda-live:start)") " from a terminal REPL. While it runs, try:") (:code-block "lisp" "(setf (wxlambda:text wxlambda-live:*text*) \"Changed live\")
(defun wxlambda-live:clicked ()
  (setf (wxlambda:text wxlambda-live:*text*) \"New callback implementation\"))
(wxlambda:queue-click wxlambda-live:*button*)
(wxlambda-live:close-window) ; explicitly unbinds before destroying the frame
(wxlambda-live:open-window)  ; another frame, within the same session
(wxlambda:stop)") (:p "The registered callback resolves " (:code "clicked") " on each invocation, so redefining it takes effect without replacing the handler. " (:code "close-window") " releases the handler before destroying its controls. If the user has already closed the native window, its handles are stale and that handler remains rooted until session cleanup. Prefer " (:code "close-window") " during repeated development cycles.") (:p "Editor integration is explicitly deferred for the first release. Local Swank 2.32 wire probes on Apple Silicon macOS found:") (:table :header (("Probe") ("Observed execution")) :rows ((("SBCL 2.6.9, " (:code "nil") " / " (:code ":fd-handler") " styles") ("Evaluation, application body, and callback on the launch thread")) (("SBCL 2.6.9, " (:code ":spawn") " control") ("Worker GUI startup rejected by the native main-thread check")) (("CCL 1.13, " (:code ":spawn")) ("Caller on worker; application body and callback on initial process; caller dynamic binding absent")))) (:p "These probes execute one RPC containing a complete GUI session. They do not demonstrate an editor workflow with a persistent session, GUI responsiveness between requests, evaluation interruption, or debugger transport. The terminal application REPL is the first-release workflow. No editor adapter or background scheduler is selected; their ordering, values, conditions, shutdown, and reentrancy contracts must be established before future implementation.") (:p "To reproduce these optional experiments with an existing Quicklisp installation containing Swank, run:") (:code-block "sh" "python3 tests/editor-probe.py nil sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :fd-handler sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn sbcl --noinform --no-sysinit --no-userinit --non-interactive --load ~/quicklisp/setup.lisp
python3 tests/editor-probe.py :spawn ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "These are optional local experiments using Swank internals and loopback sockets, separate from pinned CI dependencies. " (:code ":spawn") " probes use a persistent listener to keep Swank's accept loop off the launching thread. Their process and listener are shut down after the request. They are not supported editor configurations.") (:p "The bridge catches native exceptions at exported operation boundaries and exposes error text through " (:code "wxl_last_error") ". Its text is borrowed until the next bridge operation on the same thread. See " (:code "native/wxlambda.h") " for the C interface.") (:heading 2 "Standalone application (macOS SBCL)") (:p "The form has a standalone packaging recipe, locally verified on Apple Silicon macOS with SBCL 2.6.9. It uses " (:link "https://www.sbcl.org/manual/index.html#Saving-a-Core-Image" "SBCL's saved-core support") " and ships its own runtime. Python, Quicklisp, Lisp sources, and a system SBCL installation are not needed to run the result.") (:p "Build the native bridge first using the instructions above. Packaging also requires Python 3 and the macOS command-line developer tools (" (:code "otool") ", " (:code "lipo") ", " (:code "install_name_tool") ", and " (:code "codesign") "):") (:code-block "sh" "python3 ci/fetch-deps.py
python3 packaging/build-form.py
python3 tests/package.py --report evidence/packaging/my-run
./dist/wxlambda-form/wxlambda-form") (:p "The builder refuses to overwrite an existing output directory. Use " (:code "--output /absolute/path/to/a/new-package") " for another build; the verifier takes that directory as its positional argument. Its " (:code "--report") " directory must also be new. " (:code "--sbcl /path/to/sbcl") " and " (:code "--bridge /path/to/libwxlambda.dylib") " select build inputs explicitly. The recipe is repeatable, not a promise of byte-identical cores or locked native package versions. " (:code "manifest.json") " records SBCL's version and source/staged native-file hashes to identify the inputs and results.") (:p "Copy the entire output directory to another location and run its " (:code "wxlambda-form") " launcher from any working directory. " (:code "--repl") " selects the terminal application REPL; " (:code "--self-test") " exercises queued callbacks, Unicode values, window recreation, and clean exit automatically. Each launch is a fresh process and one GUI session. The package contains:") (:code-block "text" "wxlambda-form        shell launcher
runtime/sbcl        copied SBCL runtime
app.core            saved application and Lisp dependencies
lib/*.dylib         bridge and recursive non-system native dependencies
manifest.json       versions, origins, and hashes
licenses/           available installed native/runtime notices") (:p "No wxWidgets application or native bridge is initialized before saving. The delivered image has no Quicklisp package or registered wxlambda ASDF system. At startup it loads the bridge relative to the running packaged runtime using the public explicit-path loader, which no longer consults ASDF for that path. The staged native load commands use " (:code "@loader_path") "; this includes SBCL's own dependencies, such as zstd, and wxWidgets' image-library dependencies. System frameworks remain provided by macOS. Modified native files receive ad-hoc signatures. This is a command-line package, not a notarized Finder " (:code ".app") ".") (:p (:code "tests/package.py") " copies the package to a temporary path containing spaces, uses a different working directory and empty HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads with " (:code "sandbox-exec") ". A denied-read control verifies that isolation is active. Both the GUI self-test and packaged REPL pass there; removing either the staged bridge or wxWidgets core must report the expected load failure instead of falling back to development libraries. The test retains its manifest, sandbox profile, logs, and summary. Local evidence is in " (:code "evidence/packaging/macos-sbcl-isolated/") ".") (:p "The recipe requires matching macOS architectures and was tested only on this Apple Silicon host. Linux/Windows packaging is not implemented; Intel macOS, other macOS versions, and distribution/signing behavior on another machine are not validated. These local packaging results do not close Phase 3's hosted platform checks. Release preparation remains open.") (:heading 2 "Verification") (:p "These tests briefly open real windows, queue a button event, then exit. They need an interactive graphical session (or a suitable display server on Linux). The 26 scenarios each run in a fresh process with a 30-second timeout: The window-state scenario exercises the documented example, native changed-state results, ancestor semantics and stale/inactive handles. The window-metadata scenario exercises its callback example, Unicode/empty/NUL names, copied-string lifetime, title receiver checks and invalid/stale/inactive use. The CLOS scenario checks public classes, generic dispatch, method combination and callback identity across Lisp subclass changes.") (:code-block "sh" "python3 tests/run.py
python3 tests/run.py ccl --no-init --batch --load ~/quicklisp/setup.lisp") (:p "A separate preflight loads the native bridge, checks its ABI, and prints actual Lisp/OS/architecture and CFFI source metadata before any GUI scenario. To retain evidence, set " (:code "WXLAMBDA_TEST_REPORT") " to a new directory before running the suite:") (:code-block "sh" "WXLAMBDA_TEST_REPORT=test-results python3 tests/run.py sbcl --noinform \\
  --no-sysinit --no-userinit --non-interactive --load ci/setup.lisp") (:p "The runner records per-process logs and " (:code "summary.json") " with the source commit, working-tree status, command, platform, scenario results, durations, and exit codes. It preserves partial timeout output, stops at the first failure, and returns a failing exit code. Preflight is separate from the 26 GUI scenarios; a load failure cannot count as GUI coverage. An existing report directory is rejected to avoid mixing old and new evidence. Reporter checks can be run with " (:code "python3 -m unittest discover -s tests -p test_runner.py") ".") (:p "Retained local Phase 3 reports live in " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") ". The ignored " (:code "evidence/") " directory is separate from the disposable " (:code ".ci-deps/") " cache; keep evidence there when retaining local runs across dependency-cache cleanup. The newer 23-scenario Phase 4 runs are retained in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") "; the Phase 3 records retain their original 21-scenario count.") (:p "Choice tests cover selection bounds, empty/Unicode item lists, nested selection snapshots, handler replacement/removal, callback errors, and stale handles.") (:p "Coverage: callback dispatch and replacement, empty/long/Unicode text round trips, independent text copies, explicit closure release, queued click suppression, rebinding and self-unbinding, parent/child invalidation, wrong-type handles, duplicate sizer insertion, cleanup on setup and callback errors, and rejection of a second session. Event tests cover source/kind metadata, copied Unicode and empty text payloads, nested updates, silent versus notifying setters, self-unbinding, and text-handler errors before and during the loop, including caught errors that must leave the loop running. Layout tests verify actual child geometry for rows, columns, proportional allocation, fixed/flexible spacing, borders, and alignment, plus invalid options and stale handles. Control tests cover label text copies, checked-state access, nested toggle snapshots, handler replacement/unbinding, and caught/uncaught toggle errors. A timed Gray input stream tests delayed whitespace/CRLF, GUI callback dispatch while input is unavailable, separate evaluation/callback error recovery, and delayed EOF cleanup on SBCL and CCL. This simulates delayed terminal input; it does not validate an actual terminal or editor transport. Debugger tests verify original condition identity, live evaluation restarts, abandon-form recovery, safe delivery of callback errors, and paused GUI dispatch. They install automated debugger hooks on the GUI thread. A separate SBCL pseudo-terminal check entered the debugger, selected the application REPL restart, evaluated another form, and stopped cleanly. CCL terminal debugger I/O has not been verified. Unicode rendering, manual mouse/keyboard input, and user-generated toggle events have not been visually verified; automated text and toggle events use notifying setters.") (:p "The live-development example test exercises text updates, callback function redefinition, 50 explicit bind/unbind cycles with registry-release checks, unbinding before destruction, stale handles, and frame recreation in one session. Two representative-form scenarios exercise ordinary blocking startup and the application REPL, including Unicode input, checkbox/dropdown state, queued handler replacement, named action redefinition, unbinding all event kinds, and state-preserving window recreation from Lisp and a GUI callback. These use queued/notifying events; manual input and visual layout have not been checked.") (:p "Locally tested and intended combinations are distinct:") (:table :header (("Platform") ("Lisp") ("Validation")) :rows ((("Apple Silicon macOS, wxWidgets 3.2.12") ("SBCL 2.6.9, CCL 1.13") ("Local preflight and 26-scenario GUI suites; dependency cache switching verified separately")) (("Linux") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("macOS hosted runner") ("SBCL") ("Intended; hosted job configured, no hosted results recorded")) (("Windows x64") ("SBCL 2.6.9 intended, not validated") ("Native build, preflight, and GUI suite configured; no runtime results")))) (:heading 2 "Continuous integration") (:p (:code ".github/workflows/ci.yml") " runs on pushes, pull requests, and manual dispatch. The configured jobs are:") (:table :header (("Runner") ("Native build") ("Lisp GUI tests")) :rows ((("Ubuntu 24.04") ("Distribution wxWidgets 3.2, GCC") ("SBCL, 26 scenarios under Xvfb")) (("macOS 15") ("Homebrew wxWidgets 3.2, Clang") ("SBCL, 26 scenarios")) (("Windows Server 2022 x64") ("wxWidgets 3.2.12 from source, MSVC") ("Pinned SBCL 2.6.9, preflight and 26 scenarios; unexecuted")))) (:p "These are configured checks, not a claim that hosted jobs have passed. No hosted results have been recorded. This checkout currently has no Git remote, so a GitHub repository association is needed to dispatch or inspect the relevant runs. CCL remains locally tested on macOS, outside this CI matrix.") (:p "All jobs run reporting checks, native loading/ABI preflight, and the GUI suite (including Unicode copies, callbacks, controls, cleanup, and REPL recovery). An " (:code "always()") " upload step retains generated " (:code "test-results/") " logs and JSON reports for 30 days, even after test failures. A job that fails before tests start may have no test report; inspect its Actions logs as well as its conclusion. Hosted Windows, Linux, and macOS execution remains required before claiming validation.") (:p "The Windows build follows the upstream " (:link "https://github.com/wxWidgets/wxWidgets/blob/v3.2.12/docs/msw/install.md" "MSVC makefile instructions") ". It builds wxWidgets release DLLs from a pinned commit, then passes explicit " (:code "wxWidgets_ROOT_DIR") ", " (:code "wxWidgets_LIB_DIR") ", and " (:code "wxWidgets_CONFIGURATION=mswu") " settings to CMake. System package versions on Linux/macOS follow their package repositories; these native dependencies are not locked to an exact patch release.") (:p (:code "ci/install-sbcl.ps1") " downloads the official " (:link "https://sourceforge.net/projects/sbcl/files/sbcl/2.6.9/" "SBCL 2.6.9 Windows x64 MSI") ", verifies its pinned SHA256, and extracts it into the job's temporary directory. The bridge is emitted as " (:code "build/wxlambda.dll") ", where the Lisp loader expects it; the wxWidgets DLL directory is added to the test process's " (:code "PATH") ". Python runs in UTF-8 mode. This Windows setup has been statically reviewed, not executed on this macOS host; neither MSI execution nor PowerShell runtime behavior is locally verified. The full Windows job must pass to establish DLL loading and GUI behavior.") (:p "CI uses the exact CFFI, Babel, Alexandria, and trivial-features commits in " (:code "ci/lisp-dependencies.json") ", fetched over HTTPS into ignored " (:code ".ci-deps/") " checkouts. " (:code "ci/setup.lisp") " isolates ASDF's source registry from user installations and stores compiled output in " (:code ".ci-deps/fasl/") ", separated by Lisp implementation. This keeps pinned CFFI callbacks separate from Quicklisp's compiled-file cache. This path requires Git and Python 3, and does not install or modify Quicklisp. To reproduce the CI Lisp environment locally after building the bridge:") (:code-block "sh" "python3 ci/fetch-deps.py
python3 tests/run.py sbcl --noinform --no-sysinit --no-userinit \\
  --non-interactive --load ci/setup.lisp") (:p "On Linux, prefix the test command with " (:code "xvfb-run -a") " if no display is available. CCL can use the same dependencies with:") (:code-block "sh" "python3 tests/run.py ccl --no-init --batch --load ci/setup.lisp") (:p "For the separate dependency-cache regression, run:") (:code-block "sh" "python3 tests/cache-switch.py
python3 tests/cache-switch.py ccl --no-init --batch") (:p "Each command runs the callback/handler API scenario with pinned dependencies, then Quicklisp, then pinned dependencies again in fresh processes. It checks CFFI source locations and the compiled output destination as well as actual native callback dispatch. Quicklisp must already be installed; set " (:code "QUICKLISP_SETUP") " if its setup file is not " (:code "~/quicklisp/setup.lisp") ". These three-process regressions are separate from the 26-scenario GUI suite and are local checks, not configured hosted jobs.") (:p "The fetcher verifies existing checkouts and refuses modified or mismatched ones. After deliberately changing a locked revision, remove the corresponding generated " (:code ".ci-deps/<name>/") " directory before fetching again. Fresh compilation of the pinned Babel revision emits a warning about " (:code "HANDLE-ERROR") " in its Korean codec; the UTF-8 paths exercised by these tests pass on both local Lisps.") (:p "The " (:ref "guide/IMPLEMENTATION.md" "implementation roadmap") " now includes the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "full wxWidgets coverage plan") " as Phase 6; release preparation moves to Phase 7. The coverage plan checks off existing operations and groups remaining widgets and API declarations into coverage phases C1–C7. Hosted platform validation (including the configured Windows Lisp/GUI tests), packaging on additional platforms, and richer interactive development support remain open as described in the roadmap.") (:p "The " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application handler") " supports application-level registered messages without transferring ownership of wxApp.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session-event support") " includes logging-off metadata and isolated synthetic policy probes; real OS delivery remains unverified.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " adds native timestamps, command classification and scoped CanVeto SETF while preserving immutable snapshots.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event-ID routing") " supports context SETF and later native ID matching.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type access") " provides current type reads and bounded opaque origin identities.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event-category metadata") " provides saved/current flags and compiled mask lookup.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " checks native class compatibility before scoped SETF.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned native events") " add reusable CLOS resources, detached clones, payload SETF and copied dispatch without transferring source ownership.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event delivery") " adds GUI posting, native ownership transfer, local processing and target-only queue deletion with explicit semantics.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " add canonical peers, guarded reciprocal linking and unlinking while native ownership stays with the session.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " add guarded Push/Pop/Remove and explicit stack-aware synchronous event processing.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command event payloads") " add extra LONG/action metadata, semantic checked/selection SETF and bounded origin clearing.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " retains EQ state through managed typed native adapters while rejecting foreign storage safely."))))
(:entry "guide/IMPLEMENTATION.md" :names ("IMPLEMENTATION.md" "IMPLEMENTATION") :kind :guide :kind-name "Guide" :summary "IMPLEMENTATION.md" :sections (("Guide" (:heading 1 "Implementation plan") (:p "The final goal is complete wxWidgets coverage across C1–C7, including supported platforms, optional components and documented public interfaces. A usable first release with existing controls, reliable REPL-driven development and standalone packaging is an intermediate milestone. Phase 6 inventories the full scope; partial C1/C2 implementation is underway and does not complete that goal. This is a plan; unchecked steps are not claims of implemented or verified behavior.") (:heading 2 "Session handoff: full coverage work") (:p "The user has confirmed that " (:b "complete wxWidgets coverage is the final goal") ". Keep every required missing/partial API open; a bounded release, working example, local test result or explicitly unsupported decision cannot close the final goal. Use the " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "coverage overview") ", generated " (:ref "guide/docs/coverage/README.md" "phase/header backlog") ", class index and exact C1–C7 declaration checklists together. The pinned inventory is wxWidgets 3.2.12; C7 must reconcile additional documented public interfaces beyond those headers.") (:heading 3 "Completed implementation checkpoints") (:list (:item (:p (:code "6f6312e") ": progress gauges, generic SETF properties, subclass example and"))) (:p "pulse-to-determinate regression; independent review finding resolved.") (:list (:item (:p (:code "ed3ca87") ": C1 application state and pending-event dispatch, callback/pump/"))) (:p "cleanup reentrancy guards and fresh-load inactive-session regression; independent review finding resolved.") (:list (:item (:p "Event-handler ownership milestone: native-backed standalone handlers, borrowed"))) (:p "window base identities, liveness and handler-enabled SETF state, plus weak native window invalidation. See the latest commit and the C1 handler section below.") (:list (:item (:p "Command-observer binding milestone: independent registrations, ID/range filters,"))) (:p "copied standalone queues, self/peer unbinding and deferred callback-time disposal. Four command kinds only; see the latest commit and the binding section below.") (:list (:item (:p "Scoped-event milestone: optional current-callback contexts control native Skip"))) (:p "and propagation, with nested-callback isolation and copied native type IDs. Four command kinds only; veto-capable classes and broader families remain open.") (:list (:item (:p "Close-family milestone: :close snapshots/contexts, CanVeto-guarded SETF veto,"))) (:p "synthetic close queues and frame close requests; acceptance is not destruction. " (:code "event-type") " replaces the command-only lookup without an alias.") (:list (:item (:p "Registered-notify milestone: session keyword declarations for custom command/"))) (:p "notify types, copied text/integer payloads, scoped Veto/Allow and synchronous dispatch with native handled/final-veto results. Session routing remains open.") (:list (:item (:p "Borrowed application milestone: cached application-handler view with inherited"))) (:p "bindings, dispatch and enabled state; no native ownership transfer or construction.") (:list (:item (:p "Session-event milestone: query/end-session tags and scoped logging-off metadata,"))) (:p "native application bindings and isolated owned-handler synthetic probes. Real OS session delivery remains unverified.") (:list (:item (:p "Metadata milestone: copied/current native timestamps and command classification,"))) (:p "timestamp SETF with native LONG bounds and close-family CanVeto SETF.") (:list (:item (:p "Routing milestone: current event-ID reads/SETF, signed32 including native -1,"))) (:p "and parent exact/range/wildcard matching after mutation.") (:list (:item (:p "Origin/type milestone: current native type reads and captured/current opaque"))) (:p "origin IDs for registered bridge objects; no unchecked pointer/class access.") (:list (:item (:p "Category milestone: saved/current virtual category flags and compiled native"))) (:p "keyword mask lookup; selective YieldFor remains open.") (:list (:item (:p "Tag-mutation milestone: registered same-family native type SETF with actual"))) (:p "native class checks; built-in/session tags remain excluded.") (:list (:item (:p "Owned-event batch: detached native-backed event construction, independent clone/"))) (:p "disposal/liveness, mutable command payloads and copy-based queue/process dispatch. Final batch verification and independent review pass; exact classes and detached origins only.") (:list (:item (:p "Pending-delivery batch: GUI posting copies, consuming native transfer, local"))) (:p "synchronous copies and non-application target queue deletion. Final verification and independent review pass.") (:list (:item (:p "Standalone-chain batch: canonical next/previous peers, reciprocal guarded SETF,"))) (:p "unlinked-state query and splice/unlink with unchanged session native ownership. Final verification and independent review pass.") (:list (:item (:p "Window-stack batch: managed Get/Push/Pop/Remove, preserving session-owned"))) (:p "handler lifetime, and explicit stack-aware synchronous copy processing. Final verification and independent review pass.") (:list (:item (:p "Command-payload batch: native extra LONG/raw selection-action metadata, uniform"))) (:p "kind-specific checked/selection SETF and bounded clear-only origin detachment. Independent runtime and documentation review pass; final verification is recorded below.") (:list (:item (:p "Handler-client-data batch: EQ Lisp state via native typed token adapters,"))) (:p "managed foreign-mode protection and session-root cleanup. Independent review and final verification pass.") (:list (:item (:p "Current bridge ABI: 29. Public API: 126 exports, nine window wrapper classes"))) (:p "(eight concrete widget kinds) plus the event-handler base, 88 named generics and twenty-seven generic SETF writers. The application-handler is a borrowed view; no native application construction or arbitrary-event class binding exists yet; built-ins plus registered command/notify names have observer/contextual bindings.") (:list (:item (:p "Latest implementation verification: 46 GUI scenarios and native preflight"))) (:p "pass on local Apple Silicon macOS SBCL 2.6.9 and CCL 1.13. Final reports: " (:code "evidence/handler-client-data/{sbcl,ccl}-20261028/") ". Five package checks pass in " (:code "evidence/packaging/handler-client-data-20261028-final/") ". Hosted Linux/Windows GUI behavior and the graphical Cadre viewer remain open.") (:heading 3 "Next dependency and working order") (:list (:item (:p "Continue " (:b "C1") ", before adding further C2 widget families. Application dispatch"))) (:p "boundaries are established only for the bridge-owned session.") (:list (:item (:p "Reuse the implemented event-handler ownership/state base: standalone objects"))) (:p "are session-owned; windows borrow their existing native identity, with weak tracking independent of destroy-event delivery. There is no pushed-handler ownership transfer; managed window stack APIs preserve session ownership. Standalone dispatch supports command observers and the close family. Preserve native-backed subclass initargs, defaults, AFTER hooks and mixed-resource rollback.") (:list (:item (:p "Generic binding/unbinding supports command and close kinds with ID filters. Optional"))) (:p "borrowed contexts now control Skip/propagation in the innermost callback; saved snapshots carry process-local native type IDs. Close veto and frame request policy are implemented. Registered command/notify types and synchronous dispatch are implemented. The borrowed application handler view and query/end-session metadata/bindings are implemented, as are scoped CanVeto mutation, timestamp and command metadata. Scoped native ID mutation and routing semantics are implemented. Next define retained origin/client/userData lifetime contracts after bounded origin detachment, command payloads, managed stacks and owned/pending events. Bounded registered-tag mutation with actual native class checks is implemented. Category metadata is implemented. Current type reads and bounded origin identities are implemented; arbitrary native tag/origin writers and general wxObject wrappers remain open. Native OS session delivery is unverified. Native session events are wxApp-only, and default END_SESSION handling can exit the process: never synthesize live application end-session events as an ordinary test. Use owned handlers for synthetic family tests and distinguish OS validation from them. Standalone native TryAfter must suppress app fallback for session kinds; ordinary standalone wxEvtHandler dispatch can otherwise reach app defaults. Native control-specific notify subclasses and remaining event ownership stay open. Preserve immutable snapshots and opaque binding/context identities; never expose a native event pointer after callback return. Arbitrary native event classes/userData, session routing and arbitrary borrowed/native stack adoption remains a gap.") (:list (:item (:p "Build timer/idle, event propagation/skip/veto and worker-to-GUI dispatch on"))) (:p "those contracts, adding prerequisite value types before their consumers. Existing immutable event snapshots do not provide mutable native event access or native virtual overrides. Do not mark those capabilities complete.") (:list (:item (:p "Continue all remaining C1 groups, then C2–C7, reviewing dependencies and"))) (:p "supported platform/build variants rather than treating the current slice ordering as an exhaustive design for the rest of the project.") (:heading 3 "Resume and verification checklist") (:list (:item (:p "Inspect " (:code "git status") " and the latest log first; preserve unrelated changes."))) (:p "Read " (:code "AGENTS.md") ", this handoff and the relevant coverage declarations.") (:list (:item (:p "Use the required quiet-command wrapper for builds, tests and batch commands."))) (:list (:item (:p "Treat " (:code "docs/coverage/status.json") " as the source of status truth. Update exact"))) (:p "header/line/signature mappings and scopes, then regenerate all checklists, the class index and backlog. Never hand-edit generated marks or totals.") (:list (:item (:p "Obtain the pinned upstream " (:code "interface/") " tree if the previous temporary cache"))) (:p "is gone; verify its header hashes against " (:code "docs/coverage/manifest.json") ". " (:code "../docset") " (or " (:code "WXLAMBDA_DOCSET_SOURCE") ") supplies the shared docset reader; " (:code ".ci-deps/") " contains the pinned test dependencies, fetched through the CI tool.") (:list (:item (:p "Reproduction examples (replace the source placeholder):"))) (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 -m unittest discover -s tests -p 'test_*.py'
python3 tools/docset.py build
python3 tools/docset.py check") (:list (:item (:p "Every implementation slice needs matching reference/guides, runnable example"))) (:p "sources, docset updates and relevant behavior/error/lifetime tests. Run affected examples; verify actual-package export and SETF coverage with " (:code "tests/docset.lisp") " on both Lisps, plus shared-reader discovery and guide/example access. The generated coverage summary is also included in the docset.") (:list (:item (:p "Follow the established workflow: finish a bounded dependency-building slice,"))) (:p "obtain independent review, resolve findings, rerun affected checks, regenerate docs, commit, and record the result and next dependency here. Keep evidence directories fresh; the GUI runner rejects reused report directories.") (:list (:item (:p "Distinguish local checks from hosted platform and graphical-viewer validation."))) (:p "For documentation-only changes, verify regeneration/links/docset; do not claim GUI suites were rerun. Only close a phase when all its required scope and verification are complete.") (:list (:item (:p "For isolated docset installation checks, use a dedicated discovery parent such"))) (:p "as " (:code "/path/to/isolated-docsets/wxlambda") ", with only one copy of this docset ID. The reader deduplicates IDs across siblings; old test copies under a shared temporary parent can otherwise select a previous artifact. A shared-parent install check exposed that collision during the coverage-summary update; repeat with a dedicated root rather than weakening content comparisons.") (:heading 2 "Implementation rule: documentation, examples, and docset") (:p "Every implementation change must include matching documentation, examples, and docset updates, as required by " (:code "AGENTS.md (AGENTS.md)") ". The docset is the primary documentation deliverable: use Cadre's " (:code "docset") " library format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). Standard content means the indexed reference for every implemented public wxlambda export; include project guides and explained, runnable example sources in the same docset. Verify these deliverables alongside implementation; examples are required rather than optional. The initial docset build and artifact are implemented in Phase 7 below; release-wide platform and graphical-viewer verification remain open.") (:heading 2 "Phase 1: Establish the release baseline") (:list (:item (:p "[x] Correct README coverage and CI counts to match the GUI runner."))) (:list (:item (:p "[x] Record tested and intended OS/Lisp combinations separately."))) (:list (:item (:p "[x] Run the pinned-dependency suite and cache-switch regression checks."))) (:p "Verified locally on 2026-10-28 on Apple Silicon macOS with wxWidgets 3.2.12, SBCL 2.6.9, and CCL 1.13. The dependency fetcher verified all four pinned checkouts. Both Lisps passed all 19 GUI scenarios and the separate three-process pinned → Quicklisp → pinned callback regression. The runner previously had 18 scenarios; the delayed-input test below adds the nineteenth. Cache-switch checks are not included in that count. Reproduction commands are in README.md. Hosted-platform validation remains Phase 3 work.") (:p (:b "Acceptance:") " Documented commands reproduce the baseline without unexplained failures.") (:heading 2 "Phase 2: Finish REPL-driven development") (:list (:item (:p "[x] Add delayed-input tests for whitespace, CRLF, EOF, error recovery, and GUI"))) (:p "responsiveness.") (:p (:code "tests/repl-delayed.lisp") " uses a timed Gray stream on SBCL/CCL. It verifies callback dispatch while input is unavailable, separate evaluation/callback error recovery under the explicit " (:code ":on-error :report") " policy, and EOF cleanup. It rejects blocking reads during whitespace-only waits. Actual terminal/editor transport still needs broader validation.") (:list (:item (:p "[x] Replace message-only error handling for interactive use with a debugger"))) (:p "policy. Preserve the original condition and its available restarts; provide a restart that abandons the current form and returns to the application REPL. Investigate a backtrace fallback where debugger integration is unavailable.") (:list (:item (:p "[x] Define GUI processing as paused while the debugger is active, resuming"))) (:p "after recovery. Never unwind through a foreign callback.") (:list (:item (:p "[x] Test recovery from evaluation errors and callback errors separately."))) (:p "Verified locally on 2026-10-28: both pinned-dependency SBCL/CCL suites pass all 20 scenarios. " (:code "tests/repl-debugger.lisp") " checks original condition identity, live evaluation restarts, abandonment without losing the session, callback delivery after returning through the foreign boundary, and paused/resumed GUI dispatch. Callback-local restarts cannot survive that safe boundary; this is documented. The " (:code ":report") " fallback prints bounded SBCL/CCL backtraces before unwinding; tests confirm real stack output. A live SBCL pseudo-terminal check entered the debugger, selected " (:code "RETURN-TO-APPLICATION-REPL") ", evaluated another form, and stopped cleanly. CCL terminal debugger I/O remains unverified; its tests install hooks on the initial process because the adapter does not transfer dynamic bindings. Editor integration is explicitly deferred as recorded below.") (:list (:item (:p "[x] Prototype SBCL Swank with " (:code ":communication-style nil") " and " (:code ":fd-handler") ","))) (:p "checking where forms actually execute. These are candidates requiring verification, not supported configurations yet.") (:list (:item (:p "[x] Prototype CCL integration using its initial-process adapter."))) (:list (:item (:p "[x] Review the prototypes and select a demonstrated editor workflow or"))) (:p "explicitly defer editor support. If none works reliably, use the documented terminal REPL workflow as the release criterion and keep editor REPLs unsupported.") (:list (:item (:p "[x] If scheduling is needed, define execution order, returned values, condition"))) (:p "delivery, shutdown, and GUI-thread reentrancy before implementing it.") (:p "Not applicable to the selected terminal workflow: editor scheduling is deferred with editor support. These contracts remain prerequisites for future work; no scheduler has been implemented or advertised.") (:list (:item (:p "[x] Implement and verify the selected editor adapter if a prototype succeeds."))) (:p "Not applicable after explicit deferral: no editor workflow or adapter was selected. The thread probes below are not successful end-to-end editor prototypes and do not establish editor support.") (:list (:item (:p "[x] Retain and prominently document one GUI session per process for the first"))) (:p "release.") (:list (:item (:p "[x] Retain and prominently document the current rule that handlers for"))) (:p "destroyed controls remain rooted until unbound or session cleanup.") (:list (:item (:p "[x] Demonstrate explicit unbinding before destruction and verify that repeated"))) (:p "bind/unbind cycles release registered closures.") (:list (:item (:p "[x] Add a live-development example that updates controls and redefines callback"))) (:p "functions within one session.") (:p "Verified locally on 2026-10-28: both pinned SBCL/CCL suites pass 21 scenarios. The new " (:code "examples/live.lisp") " is exercised by " (:code "tests/live.lisp") ": text updates, callback redefinition, 50 bind/unbind cycles with registry-release checks, explicit unbinding before destruction, and frame recreation within one session. The smoke test also verifies handler retention after native destruction and release at session cleanup, plus rejection of a second application session.") (:p "Optional Swank (SLIME 2.32) loopback RPC probes passed for SBCL " (:code "nil") ", " (:code ":fd-handler") ", and a " (:code ":spawn") " rejection control, plus CCL " (:code ":spawn") ". SBCL's first two styles execute evaluation/body/callback on the launch thread. Its worker control rejects GUI startup. CCL evaluates on a worker and runs the application body/callback on the initial process without transferring caller dynamic bindings. Reproduction commands and limits are in README.md. These experiments cover one request containing one complete session, not persistent editing, interruption, or editor debugger transport. SLIME/SLY support is explicitly deferred; the terminal application REPL meets the first-release workflow gate.") (:p (:b "Acceptance:") " The terminal workflow supports live updates, useful error diagnosis, and recovery without losing the session. Debugger behavior and lifecycle limits are documented and tested. Editor support is either demonstrated or explicitly deferred.") (:heading 2 "Phase 3: Validate supported platforms") (:list (:item (:p "[ ] Execute macOS, Linux, and Windows hosted jobs and preserve results."))) (:list (:item (:p "[ ] Extend Windows checks to Lisp loading, callbacks, controls, and cleanup;"))) (:p "mark complete only after the configured hosted Windows job passes.") (:list (:item (:p "[ ] Check Unicode and REPL behavior on advertised combinations."))) (:p "Windows CI now stages SHA256-pinned SBCL 2.6.9, places the bridge where the Lisp loader expects it, exposes dependent wxWidgets DLLs, and runs native loading/ABI preflight plus the full GUI suite. All hosted jobs retain per-process logs and JSON summaries for 30 days with an " (:code "always()") " artifact upload. Configuration is not runtime evidence: the Windows setup and PowerShell installer are unexecuted on this macOS host.") (:p "Local evidence recorded on 2026-10-28: both SBCL 2.6.9 and CCL 1.13 pass preflight and 21 GUI scenarios, including Unicode and REPL tests. Logs and JSON summaries are retained in dedicated ignored " (:code "evidence/platform/{sbcl,ccl}-20261028-phase3/") " directories, separate from the disposable dependency cache. The reports identify the source commit and mark the working tree dirty because they verify the uncommitted Phase 3 changes. Workflow lint and reporter checks also pass. The downloaded Windows MSI's SHA256 matches the configured pin; it was not executed locally.") (:p (:b "External dependencies:") " this checkout has no Git remote. GitHub authentication is available, but no repository association or hosted run URL has been provided. There is no local Windows runtime, PowerShell, Linux display server, or container runner. Hosted macOS/Linux/Windows execution and Unicode/REPL evidence on those runners remain pending; Phase 3 is not complete. Commands and the distinction between configured and validated platforms are documented in README.md.") (:p (:b "Acceptance:") " Runtime evidence supports every advertised platform. Missing repository access or runners remain explicit external dependencies.") (:heading 2 "Phase 4: Complete a representative application") (:list (:item (:p "[x] Extend an example using the existing controls and layouts."))) (:list (:item (:p "[x] Include handler replacement, explicit unbinding, and window recreation"))) (:p "within the same session.") (:list (:item (:p "[x] Identify concrete gaps exposed by the example and add controls or"))) (:p "operations only where needed.") (:p (:code "examples/form.lisp") " retains its ordinary load-and-run entry point. Its reusable " (:code "examples/form-app.lisp") " application combines labels, Unicode text input, a checkbox, a style dropdown, and row/column layouts. " (:code "start-live") " enters the terminal application REPL; submit actions can be replaced or redefined by name. Explicit close/reopen functions and a GUI reopen button unbind handlers before destruction and recreate the window with retained input values. Both entry points use only public bindings. The application exposed a need for reusable example lifecycle functions, not new native controls or operations; the binding API and ABI remain unchanged.") (:p "Verified locally on 2026-10-28 with pinned dependencies: SBCL 2.6.9 and CCL 1.13 each pass native preflight and all 23 GUI scenarios. " (:code "tests/form.lisp") " adds normal and live modes covering startup, controls, Unicode values, queued handler replacement, named function redefinition, explicit unbinding, stale handles, state retention, callback-driven recreation, and cleanup. An initial assertion incorrectly expected deferred destruction to finish inside the recreation callback; it was corrected to check after the appropriate event/cleanup boundary and both modes pass. The six reporter tests also pass. Reports and logs are retained separately from dependencies in " (:code "evidence/phase4/{sbcl,ccl}-20261028/") ".") (:p "Accepted lifecycle limits remain visible in the README: one session per process, and closures for user-destroyed windows remain rooted until session cleanup if they were not explicitly unbound first. Manual input and visual layout have not been verified. Phase 3's hosted-platform checks remain pending; these local application results do not complete platform validation.") (:p (:b "Acceptance:") " Ordinary startup and live development work through public APIs, with the accepted lifecycle limits visible.") (:heading 2 "Phase 5: Implement standalone packaging") (:list (:item (:p "[x] Create a reproducible SBCL packaging example."))) (:list (:item (:p "[x] Resolve native libraries relative to the packaged application."))) (:list (:item (:p "[x] Stage required runtime libraries."))) (:list (:item (:p "[x] Test outside the checkout, from another working directory and without a"))) (:p "development Quicklisp installation.") (:p "The completed example is scoped to macOS SBCL, locally verified on Apple Silicon with SBCL 2.6.9. " (:code "packaging/build-form.py") " saves the form and pinned Lisp dependencies without initializing wxWidgets, copies the SBCL runtime, and stages the bridge plus recursive non-system dylibs. It rewrites native paths relative to each image, audits their resolution, and ad-hoc signs the copied images. This host's package contains 10 native objects, including the runtime, wxWidgets, its image dependencies, and zstd. Native inputs/hashes are recorded in a manifest; the recipe is repeatable, not a byte-identical or fully native-version-locked build. Linux/Windows packaging is not implemented, and Intel macOS is unvalidated.") (:p "The public explicit-path native loader no longer consults ASDF. The delivered core deliberately has no registered wxlambda ASDF system or Quicklisp package, and resolves its bridge beside the packaged runtime. A launcher supports normal startup, " (:code "--repl") ", and " (:code "--self-test") ". Interactive mode restores SBCL's debugger after the non-interactive image build.") (:p "Verified locally on 2026-10-28: build and five packaging checks pass. The verifier copies the package outside the checkout to a path with spaces, uses an unrelated working directory and empty HOME/SBCL_HOME, and denies checkout, Quicklisp, compiled-cache, and Homebrew reads. A denied-read control proves the sandbox is active. Packaged Unicode callbacks, window recreation, cleanup, and REPL startup/recreation/exit pass. Withholding the staged bridge or wxWidgets core produces the expected explicit load error and exit 1; those expected failures are not application passes or unexpected failed checks. Evidence is retained in " (:code "evidence/packaging/macos-sbcl-isolated/") ". Both regular pinned SBCL/CCL suites also pass preflight and 23 GUI scenarios after the loader change, with reports in " (:code "evidence/phase5/{sbcl,ccl}-20261028/") ".") (:p "The result is a command-line directory package, not a notarized Finder " (:code ".app") ". Other machines/OS versions and manual UI input remain unvalidated. Phase 3's hosted checks and Phase 7's release preparation remain open; this local sample does not establish release-wide platform support.") (:p (:b "Acceptance:") " The sample launches, processes events, and exits without relying on development paths or Quicklisp.") (:heading 2 "Phase 6: Create the full wxWidgets coverage plan") (:list (:item (:p "[x] Inventory the pinned wxWidgets API, including widgets, functions, overloads,"))) (:p "events, styles, optional components and platform-specific declarations.") (:list (:item (:p "[x] Mark implemented and partial operations in the detailed lists and class"))) (:p "index, preserving their scopes and Lisp/native mappings across regeneration.") (:list (:item (:p "[x] Group the remaining inventory into coverage implementation phases with"))) (:p "dependencies, verification requirements and completion rules.") (:list (:item (:p "[x] Preserve release preparation as Phase 7 and link the new coverage plan."))) (:p "The " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "wxWidgets coverage plan") " records the implemented baseline and coverage phases C1–C7. Its class index and per-header declaration checklists cover all 398 wxWidgets 3.2.12 interface headers, with source links and a hash manifest. A persistent status ledger retains checked/partial entries; compiler scaffolding is context rather than binding tasks. These are source-inventory entries, not a count of distinct functions or a claim of full binding coverage. Final source/documentation and inherited-API reconciliation is an explicit remaining coverage task.") (:p (:b "Acceptance:") " Every pinned interface header has phased, source-linked work items; existing support is distinguished from complete class/API coverage. The inventory-plan deliverable is complete. C1/C2 implementation is underway; all remaining pending/partial scope across C1–C7 remains required for the final goal.") (:heading 2 "Phase 7: Prepare the release") (:p "The docset build prerequisite was established before the first coverage slice. Continue using it for subsequent implementation work, including Phase 3 fixes and C1–C7 bindings, so required docset updates can be built and verified.") (:list (:item (:p "[x] Establish a reproducible Cadre-format docset build and update workflow for"))) (:p "implementation changes, with documented build/check/install commands. Generate format version 1 in " (:code "docs/docset/") " with " (:code "manifest.sexp") ", " (:code "index.sexp") " and " (:code "entries.sexp") ", docset ID " (:code "wxlambda") ", and package " (:code "WXLAMBDA") ".") (:list (:item (:p "[ ] Review exports, documentation, examples, ABI compatibility, and limitations."))) (:list (:item (:p "[ ] Run supported-platform and packaged-application checks."))) (:list (:item (:p "[ ] Align ASDF and CMake release versions."))) (:list (:item (:p "[ ] Prepare release notes and installation, development, debugging, and"))) (:p "packaging instructions.") (:list (:item (:p "[x] Produce the docset containing an indexed reference for every implemented"))) (:p "public wxlambda export, project guides/limitations, and example sources with explanations and run commands, all accessible through its index and contents.") (:list (:item (:p "[ ] Require zero problems from " (:code "docset:check-docset") "; verify public-export"))) (:p "coverage and links, run the included examples, and verify Cadre discovery, symbol lookup and navigation to guides/examples using documented installation.") (:p (:b "Acceptance:") " A new user can follow the documented installation-to-packaging workflow. Documentation and runnable examples match the implemented interfaces; the built docset uses Cadre's format version 1 and includes the public wxlambda reference, project guides and example sources together. All three files are present; " (:code "docset:check-docset") " reports zero problems; export coverage, links, example execution and Cadre discovery/lookup/navigation checks pass.") (:heading 2 "Coverage implementation: first slice") (:list (:item (:p "[x] Establish and verify the Cadre-format docset build before expanding bindings."))) (:list (:item (:p "[x] Complete " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()")))) (:p "through the native bridge, FFI and public Lisp exports, preserving setter results and recording the equivalent " (:code "Hide()") "/" (:code "Disable()") " mappings.") (:list (:item (:p "[x] Add runnable window-state callbacks, focused tests and documentation, and"))) (:p "update the persistent coverage ledger.") (:p "This bounded C2 slice builds on existing window handles; the C1 foundation inventory and the rest of C2–C7 remain open. " (:code "show-window") " retains its window primary value and adds an optional show/hide argument and changed-state second value. " (:code "shown-p") ", " (:code "enable-window") " and " (:code "enabled-p") " expose own visibility and effective input state. Native ABI 8 distinguishes false from native errors.") (:p "The initial " (:ref "guide/docs/DOCSET.md" "docset workflow") " delivered three committed files containing the then-current 53 public exports, project guides and six example sources with usage notes. Later slices extend that artifact. It requires Python 3, SBCL and the shared " (:code "docset") " library; no GUI is needed to build/read the docs. Its checker, shared-reader discovery/search/lookup and indexed guide/example reading pass, including an isolated installation. The graphical Cadre viewer has not been manually exercised.") (:p "The " (:code "window-state test (tests/window-state.lisp)") " runs the actual example callbacks, checks repeated setters, returned state-change flags, ancestor behavior and invalid/stale session use. Both local Apple Silicon macOS suites pass native preflight and all 24 GUI scenarios with wxWidgets 3.2.12, SBCL 2.6.9 and CCL 1.13; reports are retained in " (:code "evidence/coverage-first/{sbcl,ccl}-20261028/") ". Reproduction commands are in " (:ref "guide/docs/WINDOW-STATE.md" "the window-state guide") ". This does not close Phase 3 hosted checks or Phase 7 release-wide acceptance.") (:heading 2 "Coverage implementation: window metadata and CLOS API") (:list (:item (:p "[x] Add " (:code "window-name") ", " (:code "(setf window-name)") ", " (:code "frame-title") " and " (:code "(setf frame-title)")))) (:p "with native/FFI mappings and length-aware UTF-8 string ownership.") (:list (:item (:p "[x] Add a runnable callback example, a user guide and public API reference"))) (:p "records; track full name support and frame-only title support in the ledger.") (:list (:item (:p "[x] Fix multiline preprocessor handling in the inventory generator so following"))) (:p "classes and methods remain individually visible, with a regression check.") (:list (:item (:p "[x] Establish 40 widget-facing CLOS generic functions and export all eight"))) (:p "existing wrapper classes, preserving valid-call signatures and results.") (:list (:item (:p "[x] Add portable CLOS tests and an example of wrapper subclassing/method hooks;"))) (:p "record the CLOS implementation rule and update the reference generator.") (:p "This C2 slice supports logical names on all seven bound widget types, including empty/Unicode/embedded-NUL names. Frame titles are exposed only for " (:code "wxFrame") "; other " (:code "wxTopLevelWindow") " receivers and the broader C1/C2 inventories stay open. Getter strings remain valid after later queries and destruction; setters copy inputs. Native ABI 9 adds explicit byte lengths without changing earlier bridge string-buffer contracts.") (:p "The " (:ref "guide/docs/WINDOW-METADATA.md" "metadata guide") " documents usage and focused checks. At that checkpoint the docset covered 65 public exports, including eight wrapper classes and 40 named generic functions, plus guides and seven example sources. The user explicitly requested establishing CLOS before further widget-family expansion; keyword-only factories, lifecycle functions, immutable event snapshots and the FFI retain their existing roles. Native virtual overrides remain future work. Both local macOS SBCL/CCL suites pass native preflight and all 26 GUI scenarios, including the CLOS and metadata scenarios. Reports are retained in " (:code "evidence/coverage-clos/{sbcl,ccl}-20261028/") ". The earlier 25-scenario metadata reports in " (:code "evidence/coverage-metadata/") " predate the CLOS migration.") (:p "The macOS SBCL standalone form was rebuilt as " (:code "dist/wxlambda-form-clos") " and passes all five isolation/relocation/REPL/missing-library checks, with evidence in " (:code "evidence/packaging/coverage-clos-20261028/") ". The docset checker reports zero problems; actual-package export coverage passes on both Lisps. Python and inventory regressions cover method-signature rendering, stale-docset detection, agent-content exclusion and multiline macro parsing. Graphical Cadre and hosted platform verification remain release work; shared-reader checks are separate from graphical-viewer testing.") (:heading 2 "CLOS construction and properties: revision 3") (:list (:item (:p "[x] Make " (:code "make-instance") " construct every concrete native widget from initargs,"))) (:p "with ordinary subclass defaults/slots and native-backed AFTER initialization.") (:list (:item (:p "[x] Make factories thin MAKE-INSTANCE wrappers with validated " (:code ":class") " and"))) (:p "forwarded subclass initargs, and reject abstract/invalid construction clearly.") (:list (:item (:p "[x] Roll back native allocations and callback roots on managed initializer"))) (:p "failure, preserving the original condition or nonlocal exit.") (:list (:item (:p "[x] Establish eight canonical generic SETF writers and migrate examples,"))) (:p "tests, REPL scripts, packaging and documentation to them.") (:p "The user's later ground-up direction explicitly removes backward compatibility as a requirement. It supersedes the earlier factory/CHANGE-CLASS construction convention and the review's request to retain setter aliases. Six separate setter aliases and receiver-compatibility fallback methods were removed; unsupported receiver types now use CLOS dispatch errors. The native ABI remains 9; native handle/type and callback/lifetime checks are retained.") (:p "The public API has 59 exported symbols, including eight classes, 34 named widget generic functions and eight generic SETF functions using the getter symbols. Class docset pages include Construction sections; mutable-property pages include SETF syntax and indexed compound writer names. The current docset has 73 entries covering the API, guides and seven executable example sources.") (:p "Locally verified on Apple Silicon macOS with SBCL 2.6.9 and CCL 1.13: native preflight and all 26 GUI scenarios pass, including direct construction of all seven native kinds, subclass defaults/slots, factory class validation, initializer rollback, property writers, notification recovery and method combination. The initial SBCL run caught an obsolete native-error expectation for a wrong receiver in the events test; the expectation now checks CLOS dispatch failure, and the full rerun passes. Both reports are retained under " (:code "evidence/clos-construction/") " (" (:code "sbcl-rerun-20261028") ", " (:code "ccl-20261028") "); the original failed " (:code "sbcl-20261028") " report remains intact.") (:p "The rebuilt macOS SBCL form in " (:code "dist/wxlambda-form-native-clos") " passes all five packaging checks, recorded in " (:code "evidence/packaging/native-clos-construction-20261028/") ". Docset validation on both Lisps verifies all 59 exports and the construction and SETF sections; Python/inventory regressions pass. Hosted-platform checks and the Cadre graphical viewer remain unvalidated.") (:heading 2 "Property accessor names: revision 4") (:list (:item (:p "[x] Rename the text readers and generic SETF writers to " (:code "text") " and"))) (:p (:code "label-text") ", with no aliases for the former reader names.") (:list (:item (:p "[x] Update callers, embedded REPL/package scripts, examples, API reference"))) (:p "records, docset indexes and persistent coverage mappings.") (:list (:item (:p "[x] Record property-style naming in the project rules and add regression"))) (:p "assertions that obsolete readers/writers are absent.") (:p "The CLOS construction and SETF protocol is unchanged. Public export count remains 59 and the docset remains 73 entries; the property names and index IDs now use natural accessor names. The private CFFI/native getter names remain internal implementation details, so no native ABI change is needed.") (:p "Both local macOS SBCL/CCL suites pass preflight and all 26 scenarios, with reports in " (:code "evidence/property-names/{sbcl,ccl}-20261028/") ". The rebuilt standalone form passes five packaging checks in " (:code "evidence/packaging/property-names-20261028/") ". The Python/inventory checks and both actual-package docset checks pass, including indexed SETF forms under the new names. Hosted platforms and the graphical Cadre viewer remain unvalidated.") (:heading 2 "Coverage implementation: progress gauges") (:list (:item (:p "[x] Add native-backed " (:code "gauge") " construction and the thin " (:code "make-gauge") " factory,"))) (:p "including subclass defaults, slot initargs and native access in AFTER hooks.") (:list (:item (:p "[x] Add generic " (:code "gauge-value") "/" (:code "gauge-range") " readers and SETF writers,"))) (:p (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ", with checked native handles and arguments.") (:list (:item (:p "[x] Add a runnable subclass/callback example, focused GUI scenario, guide,"))) (:p "reference entries and persistent declaration/class/style coverage mappings.") (:list (:item (:p "[x] Prevent guide/example stem aliases from shadowing public symbols in Cadre"))) (:p "lookup, with a regression test and stricter build/check lookup assertions.") (:p "This bounded C2 slice exposes " (:code "wxGauge") " progress, positive ranges, horizontal or vertical construction and indeterminate pulsing. Range assignment clamps the current native value and restores determinate mode. Pulse animation/value readings remain platform-dependent. Custom constructor IDs, geometry, validators, names and additional styles, two-step creation and the remaining inherited API stay open. Native ABI 10 requires rebuilding the bridge with these bindings. The API now has 65 exports, nine wrapper classes, 39 named generic functions and ten generic SETF writers. The docset contains 81 entries across API, guides and eight example sources; installation instructions remain in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ".") (:p "Local Apple Silicon macOS verification passes native preflight and all 27 GUI scenarios on SBCL 2.6.9 and CCL 1.13. Evidence is retained in " (:code "evidence/gauge/sbcl-20261028.log") " and " (:code "evidence/gauge/ccl-20261028/") "; a focused rerun on both Lisps also passes after the final helper refactor. The sandboxed initial SBCL gauge process stalled on macOS window-service access and was terminated; GUI verification passed with window-service access outside the agent sandbox. Reporter/inventory tests initially caught obsolete scenario and class counts, which were updated and pass on rerun. Actual-package docset validation caught colliding guide/example aliases for GAUGE; the alias fix and regression now pass, with zero " (:code "docset:check-docset") " problems, complete export and SETF lookup coverage, links, discovery and indexed guide/example access on both Lisps. An isolated install under a temporary docset root passes discovery and indexed reading. Python and pinned-upstream inventory regressions pass.") (:p "The rebuilt " (:code "dist/wxlambda-form-gauge") " passes all five packaging isolation, relocation, REPL and missing-library checks, with reports in " (:code "evidence/packaging/gauge-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. This slice does not complete C1 or C2. Independent static review found that the example resumed determinate progress from platform-dependent pulse readings. The example now stores completed work in Lisp and tests pulse-to-advance directly; the revised focused scenario passes on both Lisps. The reviewer verified the fix and reported no remaining actionable findings. The user has directed that unfinished C1 foundations take priority before further C2 widget expansion; finish and review this gauge slice, then return to C1.") (:heading 2 "C1 foundation: application event dispatch") (:list (:item (:p "[x] Expose " (:code "main-loop-running-p") ", " (:code "pending-events-p") " and"))) (:p (:code "process-pending-events") " for the active bridge application, distinguishing wx pending events from GUI/OS polling and idle processing.") (:list (:item (:p "[x] Guard RUN, both event pumps and native cleanup against callback/pump"))) (:p "reentrancy, including synchronous notifying setters before RUN starts.") (:list (:item (:p "[x] Add the runnable application-events example, focused regression scenario,"))) (:p "guide, API reference and pinned C1 declaration mappings.") (:p "This is an application-dispatch prerequisite within C1, not completion of the application or event-handler inventory. The next dependency is event-handler ownership and generic binding, followed by timer/idle/propagation and worker-to-GUI dispatch, with required value/ownership contracts before consumers. All new APIs require an active main-thread session. Queries return T/NIL; pending-only dispatch returns NIL and re-signals contained callback conditions after returning from native code. Existing synchronous notifications and the cooperative application REPL remain supported. Native ABI 11 adds these entry points and the dispatch boundary; rebuild the bridge alongside the bindings.") (:p "Local Apple Silicon macOS verification passes native preflight and all 28 GUI scenarios on SBCL 2.6.9 and CCL 1.13, including the example, loop/queue queries, pending dispatch, raw/native callback guards, notifying-setter boundaries, debugger pauses, inactive sessions and recovery after callback failure. The initial focused test used an incorrect zero-argument text callback; it was corrected to accept the event snapshot and both Lisp reruns pass. Full reports are retained in " (:code "evidence/application-events/{sbcl,ccl}-20261028/") ". Independent review found that fresh-ASDF-load calls initially raised an FFI lookup error instead of NATIVE-ERROR before bridge loading. All three new public functions now check the active session before calling the FFI. The fresh-load regression verifies NATIVE-ERROR without loading the bridge, then checks raw native pre-session errors. The reviewer independently verified this fix and reported no remaining actionable findings. Both full 28-scenario suites pass after the fix; final reports are under " (:code "evidence/application-events/{sbcl,ccl}-review-fix-20261028/") ".") (:p "Python reporter/docset regressions and all pinned-upstream inventory checks pass. The docset contains 86 entries and covers all 68 public exports, guides and nine example sources. Build/check and actual-package export/SETF lookup verification pass on both Lisps with zero " (:code "docset:check-docset") " problems; indexed reading, links, shared-reader discovery and an isolated temporary installation are verified. Installation instructions are in " (:ref "guide/docs/DOCSET.md" "DOCSET.md") ". The rebuilt " (:code "dist/wxlambda-form-application-events-reviewed") " passes all five packaging isolation, relocation, REPL and missing-library checks; evidence is in " (:code "evidence/packaging/application-events-reviewed-20261028/") ". Hosted Linux/Windows GUI execution and the graphical Cadre viewer remain unvalidated. The C1 inventory remains open, and no further C2 widget families were added.") (:heading 2 "C1 foundation: event-handler ownership and state") (:list (:item (:p "[x] Add native-backed " (:code "event-handler") " construction, thin validated standalone"))) (:p "factory, explicit standalone destruction, liveness and generic enabled state.") (:list (:item (:p "[x] Make " (:code "window") " inherit the event-handler interface while borrowing its existing"))) (:p "native widget identity; retain a single allocation per window and managed CLOS subclass/default/initarg/AFTER semantics.") (:list (:item (:p "[x] Generalize initializer rollback across standalone handlers, nested windows"))) (:p "and callback roots; session cleanup frees remaining standalone handlers.") (:list (:item (:p "[x] Track windows weakly so disabling handler event processing cannot leave"))) (:p "dereferenceable dead pointers when destroy-event delivery is suppressed.") (:list (:item (:p "[x] Add standalone/subclass and window callback examples, focused ownership/"))) (:p "state/lifetime tests, API/guide/docset content and persistent C1 coverage.") (:p "Native ABI 12 adds standalone handlers and own event-processing state. " (:code "handler-enabled-p") " is distinct from window input " (:code "enabled-p") "; native routing and parent propagation rules still apply. Native lifetime observation returns NIL for stale identities only within an active session. Borrowed window handlers reject standalone destruction. Dead weak registry entries can remain until session cleanup; they do not retain or dereference destroyed native windows. Legacy control callback roots still require explicit unbinding before window destruction or remain rooted until session cleanup. No generic binding, standalone event queues, pushed-handler ownership or native virtual overrides are implemented.") (:p "Local Apple Silicon macOS native preflight and all 29 GUI scenarios pass on SBCL 2.6.9 and CCL 1.13, with evidence in " (:code "evidence/event-handlers/{sbcl,ccl}-20261028/") ". Tests include the actual example callbacks, disabled-window/child destruction, owned/borrowed misuse, direct/factory class-object construction, native AFTER access, mixed-resource/callback-root rollback, invalid construction, stale identities and inactive sessions. The initial focused test mistakenly expected REINITIALIZE-INSTANCE to re-run native construction; it was corrected to test repeated INITIALIZE-INSTANCE, matching the existing construction contract. Both focused reruns and complete suites pass.") (:p "Independent static review found no actionable correctness issues. Its wording nit about dead weak entries was corrected to state that entries can remain until session cleanup. Python and pinned-upstream inventory regressions pass. The generated docset contains 94 entries covering all 73 public exports, guides and ten example sources. Build/check reports zero problems and verifies links, shared-reader discovery and indexed guide/example access. Actual-package and isolated-install checks accompany this slice; graphical Cadre and hosted Linux/Windows GUI validation remain open.") (:p "The rebuilt " (:code "dist/wxlambda-form-event-handlers") " passes all five packaging isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-handlers-20261028/") ". The next C1 slice is generic multi-event/ID binding and safe unbinding, using the ownership base established here. Full event-handler and C1 coverage remain open.") (:heading 2 "C1 foundation: independent command-event bindings") (:list (:item (:p "[x] Add immutable " (:code "event-binding") " identities with " (:code "bind-event") ", " (:code "unbind-event")))) (:p "and " (:code "binding-active-p") ", using native Bind/Unbind with exact registration identity.") (:list (:item (:p "[x] Support independent observers for four existing command-event kinds on"))) (:p "standalone/window handlers, including signed command IDs and inclusive ranges.") (:list (:item (:p "[x] Add copied synthetic " (:code "queue-event") " payloads, immutable " (:code "event-id") " snapshots"))) (:p "and explicit UTF-8 payload lengths preserving embedded NUL text.") (:list (:item (:p "[x] Keep active native callbacks alive across self/peer unbinding; defer"))) (:p "callback-time receiver deletion through application CallAfter, with immediate target invalidation and root pruning at Lisp boundaries.") (:list (:item (:p "[x] Make control-specific hooks observers too, preserving ordinary command"))) (:p "routing to parent observers; add examples, API/guide and coverage/docset updates.") (:p "Native ABI 13 extends snapshots with command IDs and text byte lengths. Snapshot " (:code "event-source") " is the binding receiver, not necessarily the native originating child; origin-object lookup remains unbound. All command callbacks automatically Skip; mutable Skip/veto/propagation contexts, arbitrary native event types and userData, pushed chains and worker dispatch remain open. Generic roots can remain until a Lisp boundary during a blocking RUN; the control-specific explicit-unbind root contract remains unchanged. Initializer rollback removes generic registrations across nested resources. Owned/borrowed lifetime restrictions remain in force.") (:p "Initial full suites pass native preflight and all 30 scenarios on local macOS SBCL 2.6.9 and CCL 1.13, in " (:code "evidence/event-bindings/{sbcl,ccl}-20261028/") ". Independent review confirmed a propagation issue: dormant control-specific hooks consumed commands before parent generic observers. All four hooks now Skip, including after convenience callback delivery. Final full reruns pass all 30 scenarios in " (:code "evidence/event-bindings/{sbcl,ccl}-observers-20261028/") ", including parent/child receiver/ID checks and self-disposal in synchronous notifying text, checkbox and choice setters. Additional focused checks cover disabled-receiver expiration and active-registration state while event processing is disabled.") (:p "Review verified exact binding lifetime, self/peer unbinding, deferred receiver disposal, snapshot copying, rollback and the final documentation; no actionable findings remain. An initial Lisp compile caught an extra parenthesis, which was corrected; the first pre-session test incorrectly supplied a symbol to ALLOCATE-INSTANCE instead of a class object, also corrected before passing reruns. Python and pinned-upstream inventory regressions pass. The docset has 103 entries covering all 80 exports, project guides and eleven example sources, with zero checker problems. Actual-package/SETF lookup and isolated install checks verify shared-reader discovery and guide/example access. Graphical Cadre and hosted Linux/Windows GUI behavior remain unverified.") (:p "The final " (:code "dist/wxlambda-form-event-bindings-reviewed") " passes all five package isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-bindings-reviewed-20261028/") ". Next establish native event class/type representation and separate scoped mutable event contexts before dependent event families. This does not complete wxEvtHandler or C1 coverage.") (:heading 2 "C1 foundation: scoped native event contexts") (:list (:item (:p "[x] Add " (:code "event-context") " values for " (:code "bind-event :with-context t") "; contextual"))) (:p "callbacks receive " (:code "(snapshot context)") " and explicitly control native Skip.") (:list (:item (:p "[x] Add generic " (:code "event-skipped-p") " with canonical SETF, " (:code "event-propagates-p") ","))) (:p "stop/resume propagation actions and " (:code "event-context-active-p") ".") (:list (:item (:p "[x] Guard native event borrowing with monotonically allocated tokens, native"))) (:p "callback depth and an RAII scope stack. Nested contextual, observer and control-specific callbacks cannot use a suspended outer context; it becomes usable again when they return. Expired readers/writers reject native access.") (:list (:item (:p "[x] Copy native event type integers into immutable snapshots, with lookup for"))) (:p "four existing command tags; add guides, runnable example and C1 coverage.") (:p "Native ABI 14 extends snapshot metadata and the binding mode. Observer mode keeps automatic Skip; contextual mode starts unskipped and consumes unless the callback sets Skip true. Propagation level is separate from Skip. Unbinding or deferred disposal does not invalidate a context before its current callback returns; errors expire it on return without rolling back native mutations. Snapshot and context tokens remain immutable. Native type IDs are process-local metadata, not stable serialized identifiers or arbitrary type registration.") (:p "Local Apple Silicon macOS native preflight and all 31 GUI scenarios pass on SBCL 2.6.9 and CCL 1.13, with reports in " (:code "evidence/event-contexts/{sbcl,ccl}-20261028/") ". Focused checks also pass on both Lisps for native type copying in all four control-specific callback modes and outer-context restoration after a handled nested contextual error. Tests cover consumption/forwarding, propagation stop/restore/zero, nested suspension, stale readers/writers, callback conditions, self-unbinding and deferred receiver disposal. The first compile caught an extra closing parenthesis in the extended native binding call; it was corrected before the passing focused and full-suite runs.") (:p "Independent runtime and documentation review found no actionable correctness issues. A docstring was clarified to distinguish contextual consumption from observer mode. Python and pinned-upstream inventory regressions pass. The docset contains 114 entries covering all 89 exports, guides and twelve example sources, with zero checker problems. Actual-package/SETF lookup, links, shared-reader discovery and isolated-install guide/example checks accompany this slice. Hosted Linux/Windows GUI and the graphical Cadre viewer remain unverified.") (:p "The rebuilt " (:code "dist/wxlambda-form-event-contexts") " passes all five packaging isolation, relocation, REPL and missing-library checks, recorded in " (:code "evidence/packaging/event-contexts-20261028/") ". Full wxEvent/C1 coverage remains open: veto-capable classes, arbitrary event-family/type registration, native event construction/cloning, origin/ID/type mutation, userData, linked/pushed handlers, timer/idle and worker dispatch remain future work. The next dependency is broader event-family representation and veto-capable event classes with checked borrowed lifetimes, before dependent event families.") (:heading 2 "C1 foundation: close-event family and checked veto") (:list (:item (:p "[x] Generalize native binding dispatch to the wxEvent base with checked family"))) (:p "payload extraction; add " (:code ":close") " / " (:code "wxEVT_CLOSE_WINDOW") " / " (:code "wxCloseEvent") ".") (:list (:item (:p "[x] Add immutable " (:code "event-family") " and close-flag snapshot reads, plus current"))) (:p "context " (:code "event-can-veto-p") " and generic SETF " (:code "event-vetoed-p") ", guarding actual class and native CanVeto before setting or clearing veto.") (:list (:item (:p "[x] Add copied synthetic close events with an initial " (:code ":can-veto-p") " option and"))) (:p "a frame-only synchronous " (:code "close-window") " request preserving native acceptance.") (:list (:item (:p "[x] Rename the command-only type lookup to " (:code "event-type") ", without an alias,"))) (:p "and migrate examples, tests, references and persistent coverage mappings.") (:list (:item (:p "[x] Add the veto-policy example and close-family tests, guides and docset."))) (:p "Native ABI 15 extends snapshots with close flags. Snapshot values are copied before each callback and stay immutable; live veto access is limited to the current close context. Non-close contexts and non-vetoable close requests reject veto writes before wx assertions. Force disallows veto but does not bypass a consuming contextual handler. Acceptance is not a destruction guarantee. A veto handler should consume the event rather than delegate to default closing. Queued close events on frames can invoke native default closing. Observer errors do not implicitly veto; their automatic Skip can still allow default closing.") (:p "Native preflight and all 32 local Apple Silicon macOS GUI scenarios pass on SBCL 2.6.9 and CCL 1.13. Reports are in " (:code "evidence/close-events/{sbcl,ccl}-20261028/") ". Focused checks also pass on both Lisps for immutable snapshot SETF rejection and observer-error/default-close behavior. Tests distinguish real veto, consumption, force and default deletion; cover synthetic CanVeto flags, wrong-family/expired access and handled nested close errors while RUN continues. A snapshot-extension compile warning exposed a leftover variable in the edited constructor call; it was corrected to explicit boolean conversions before passing verification.") (:p "Independent runtime/documentation review found no actionable correctness issues. The queue docstring and a stale four-keyword sentence were corrected for the new family. Python and pinned-upstream inventory regressions pass. The docset has 120 entries for all 93 public exports, guides and thirteen example sources, with zero checker problems; actual-package/SETF lookup, links, shared-reader discovery and isolated-install navigation checks accompany this slice. The rebuilt " (:code "dist/wxlambda-form-close-events") " passes all five package checks, with evidence in " (:code "evidence/packaging/close-events-20261028/") ".") (:p "Full wxCloseEvent/C1 support remains open: wxNotifyEvent, query/end-session tags, logging-off state, arbitrary event tags/registration, persistent event cloning, context capability mutation, userData, pushed handlers, timer/idle and worker dispatch remain required work. " (:code "wxWindow::Close") " is mapped only for wxFrame; other receiver types are not complete. Hosted Linux/Windows GUI and graphical Cadre validation remain unverified. Continue C1 notify/session/event registration and ownership prerequisites before dependent event families or new widgets.") (:heading 2 "Registered command/notify types and synchronous dispatch (2026-10-28)") (:p "Bridge ABI 16 adds session-scoped REGISTER-EVENT-TYPE declarations, copied command/notify text and integer snapshots, current-context notify Veto/Allow, and PROCESS-EVENT. Synchronous dispatch returns native handled-p and final vetoed-p independently: skipped observers can run while handled-p is NIL. Synthetic events remain owned through callbacks and deferred receiver disposal. Registration metadata expires with the session; saved snapshots remain readable. There is no unregister or rollback of a declaration after failed initialization.") (:p "Both local SBCL and CCL pass native preflight and all 33 GUI scenarios, including the runnable notify example. Python and pinned inventory regressions pass. The docset contains 125 entries covering all 96 exports, guides and fourteen examples. Five relocated-package checks pass; evidence paths are in the handoff. Independent runtime and documentation review found no runtime issues; stale snapshot/type/veto reference descriptions identified in review were corrected.") (:p "Native session routing is deliberately deferred: it requires a borrowed wxApp handler view with defined lifetime, and default END_SESSION handling can exit the process. Complete that prerequisite before query/end-session and logging-off support. Derived notify classes, broader event ownership and all remaining C1–C7 backlog items remain open. Hosted Windows/Linux GUI and graphical Cadre checks remain unverified.") (:heading 2 "Borrowed application handler prerequisite (2026-10-28)") (:p "Bridge ABI 17 adds APPLICATION-HANDLER and CURRENT-APPLICATION-HANDLER as a cached, borrowed view of the bridge-managed wxApp. It reuses inherited event binding, queueing, synchronous processing, liveness and enabled-state generics. Direct construction (including subclasses/factories) and explicit destruction are rejected. Bindings are removed before native wxApp cleanup; saved snapshots remain readable while saved views reject native operations outside the session. Every lookup validates the native main-thread/session boundary, even when cached.") (:p "Actual-package docset validation caught a missing Construction section for the borrowed class; review independently identified it, and the section was added before repeating the checks. Independent static review found no runtime issue. Its documentation note was applied: disabling the real application handler can delay application-queued work, including deferred disposal, until restoration or cleanup. The example and regression test cover identity, delivery, notify veto, enable/restore, rejected construction/disposal, session cleanup and saved snapshots.") (:p "Local SBCL and CCL pass all 34 GUI scenarios plus native preflight. The Python and pinned inventory tests pass; five relocated package checks pass. The docset has 129 entries for all 98 exports, guides and fifteen examples; checker, actual-package export/SETF coverage, isolated-install discovery and guide/example navigation checks pass. Evidence paths are in the handoff. Hosted Linux/Windows GUI and graphical Cadre validation remain unverified.") (:p "Continue C1 with session-family metadata and synthetic owned-handler tests before validating OS application routing. Default END_SESSION may exit the process; never emit it on the managed application as an ordinary regression test. All required missing/partial C1–C7 APIs remain open in the coverage inventory.") (:heading 2 "Query/end-session and logging-off metadata (2026-10-28)") (:p "ABI 18 adds :QUERY-END-SESSION and :END-SESSION to the close family, with immutable logging-off snapshots and generic EVENT-LOGGING-OFF-P context SETF. Native bindings accept the borrowed application view and owned standalone handlers; window bindings reject. Synthetic queue/process accepts only owned handlers. Internal StandaloneHandler::TryAfter blocks wxApp fallback for session tags, including unmatched, skipped and disabled dispatch. Upstream source inspection showed that plain wxEvtHandler otherwise forwards unhandled events to wxApp; native default END_SESSION can exit the process. Other kinds retain normal dispatch. Native application bindings are tested without emitting events.") (:p "Focused example/regressions and all 35 GUI scenarios plus preflight pass on local SBCL and CCL. Python and pinned inventory regressions pass. Five relocated package checks pass; evidence paths are in the handoff. The 132-entry docset covers all 99 exports, guides and sixteen examples, with zero checker problems and actual-package export/SETF coverage, discovery, isolated installation and API/guide/example lookup checks on both Lisps.") (:p "Independent review identified missing reserved-kind snapshot decoding while the slice was being assembled; the decoder was corrected before verification. Review then found no actionable runtime issue. Documentation distinguishes synthetic CanVeto defaults from native flags; changing logging-off metadata does not change OS intent. Real OS session delivery/policy, hosted Windows/Linux GUI and graphical Cadre validation remain unverified. All native session-event coverage remains partial. Next complete scoped CanVeto mutation and remaining native snapshot metadata, then event ownership/family prerequisites in C1.") (:heading 2 "Scoped CanVeto and native event metadata (2026-10-28)") (:p "ABI 19 adds EVENT-TIMESTAMP and EVENT-COMMAND-P for saved snapshots and current contexts. Timestamp SETF accepts the signed native C LONG range, with Lisp and native checks before narrowing the fixed int64 transport. Native status/output separation preserves negative timestamps, including -1. Synthetic timestamps start at zero; no timestamp-construction option or scheduling behavior is added. Command classification copies native IsCommandEvent, including notify=true.") (:p "SETF EVENT-CAN-VETO-P maps current wxCloseEvent::SetCanVeto directly. False can be re-enabled; native GetVeto hides a stored veto while CanVeto is false and reveals it if re-enabled. Every veto write checks the current flag. Notify capability remains intrinsic/read-only, and snapshots have no property writers. Explicit CanVeto mutation can affect forced native close results, but cannot guarantee OS veto acceptance. Updated guides remove the prior permanent-false forced-close assumption. Native context lifetime/isolation remains enforced.") (:p "Independent runtime review found no actionable issue. The runnable example and focused regression pass both Lisps; all 36 local GUI scenarios and preflight pass on SBCL and CCL. Python and pinned inventory regressions pass. Five rebuilt relocated-package checks pass, with evidence paths in the handoff. The docset has 136 entries for all 101 exports, guides and seventeen examples; checker, actual export/SETF coverage, isolated-install discovery and API/guide/example access checks pass on both Lisps. No implementation test failures were observed. Hosted Windows/Linux GUI, actual OS session routing and graphical Cadre remain unverified; do not claim full native event class coverage. Continue C1 with scoped ID mutation/routing semantics, then native type/origin and ownership prerequisites.") (:heading 2 "Scoped event-ID mutation and routing (2026-10-28)") (:p "ABI 20 extends EVENT-ID to a generic saved/current reader and context-only SETF. Signed32 bounds apply; native SetId permits -1 as literal metadata, while binding filters and synthetic initial IDs keep their existing -1 restriction. Status/output separation preserves negative IDs. Snapshot construction uses a private identifier slot; no mutable snapshot accessor is introduced.") (:p "Native ID changes affect later exact/range matching without changing windows, filters or earlier snapshots, restarting dispatch or promising local callback order. Parent-routing tests establish order structurally and verify matching, Skip/consumption, wildcard behavior, queued delivery, signed bounds and current/ nested/expired context isolation. The standalone example verifies original and forwarded snapshots and releases its resources.") (:p "Independent review found no remaining actionable issues. Focused example/tests and all 37 GUI scenarios plus preflight pass locally on SBCL/CCL. Python and pinned inventory regressions and five rebuilt relocated-package checks pass. The 138-entry docset covers all 101 exports, guides and eighteen examples, with zero checker problems and actual export/SETF lookup, isolated-install discovery and guide/example navigation checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next define native type/origin contracts without permitting tag mutation to authorize unsafe native casts; broader ownership remains C1 work.") (:heading 2 "Read-only native event type and origin identity (2026-10-28)") (:p "ABI 21 adds generic EVENT-ORIGIN-ID and current-context EVENT-NATIVE-TYPE reads. Origin is an opaque registered bridge identity, not a native pointer or public receiver. Null/untracked origins map to NIL. Native lookup compares identities without dereferencing the origin, captures at each callback and grants no ownership, liveness or historical pointer-lifetime guarantee. Saved snapshots remain readable after cleanup; context readers preserve nested/expired isolation. Null/untracked native-origin branches are not exercised by the public synthetic API, which always supplies a known receiver; that validation gap remains open. Type/origin writers remain open because unchecked tags can authorize invalid native casts, and arbitrary origin pointers need retention/lifetime contracts.") (:p "The runnable example distinguishes native child origin from parent binding receiver. Tests cover all supported kinds, standalone/application identity, nested contexts, cleanup and absence of public writers. Independent review found no remaining actionable issues. Focused example/tests and all 38 GUI scenarios plus preflight pass locally on SBCL/CCL. Python and pinned inventory regressions and five rebuilt relocated-package checks pass. The 141-entry docset covers all 102 exports, guides and nineteen examples, with zero checker problems, actual export/SETF lookup, isolated-install discovery and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next implement event-category metadata before typed mutation and native ownership prerequisites.") (:heading 2 "Native event-category metadata (2026-10-28)") (:p "ABI 22 adds EVENT-CATEGORY for snapshots/current contexts and EVENT-CATEGORY-MASK for compiled :UI/:USER-INPUT/:SOCKET/:TIMER/:THREAD/:ALL values. Mask lookup loads the native library without starting a GUI session. Category reads are immutable or innermost-context scoped; no virtual override/setter/selective pump is added.") (:p "Verification exposed two gaps between pinned interface docs and implementation: ALL31 assertion failed because installed3.2.12 includes internal32/64 bits and returns127. The mapping now queries compiled constants, preserving ALL exactly. A focused test also corrected the assumption that command/notify inherit UI: native wxCommandEvent overrides to USER_INPUT, omitted in interface docs. Close family remains UI. Retain these for C7 reconciliation without exporting internal category names. Public bits do not imply socket/timer/thread event bindings. The generator rejected initial per-enumerator status records because it groups this enum body in one source entry; mappings were corrected to its exact pinned entries.") (:p "Independent review found no remaining actionable issue; its stale assertion-message note was corrected. Focused example/regressions and all 39 GUI scenarios plus preflight pass locally on SBCL/CCL. Python/inventory regressions and five rebuilt relocated package checks pass. The 145-entry docset covers all 104 exports, guides and twenty examples with zero checker problems, actual export/SETF lookup, isolated installation/discovery and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre remain unverified. Next implement bounded registered-tag mutation using actual native class checks; preserve session fallback isolation and reject incompatible tags before broader native ownership/origin-retention contracts.") (:heading 2 "Bounded registered native tag mutation (2026-10-28)") (:p "ABI 23 adds context SETF EVENT-NATIVE-TYPE: registered source+target, same family, actual wxCommandEvent without wxNotifyEvent for command tags or wxNotifyEvent for notify tags. Built-in/session/unknown/incompatible tags reject before mutation. Snapshots report actual current tags; binding identities retain registration tags. The writer never changes native class/storage, restarts dispatch or guarantees local callback delivery/order. Native origin and arbitrary tag writers stay open.") (:p "An initial focused test incorrectly required an old-tag local observer after mutation; the backend rematched the changed tag and skipped it. That ordering assumption was removed. Parent routing verifies changed tags with structural order for synchronous/queued delivery. Command/notify checks also cover rejected targets, unchanged state after failure, veto after change and nested/expired contexts. Public APIs cannot create a mismatched native object with a registered tag; actual-class rejection is statically reviewed, not directly exercised.") (:p "Independent runtime/documentation review found no remaining actionable issue. All 40 GUI scenarios plus preflight pass locally on SBCL/CCL, as do focused example/regressions, Python/inventory tests and five relocated-package checks. The 147-entry docset covers all 104 exports, guides and twenty-one examples, with zero checker problems, actual export/SETF lookup, isolated discovery/install and guide/example checks on both Lisps. Evidence paths are in the handoff. Hosted Windows/Linux GUI, actual OS session delivery and graphical Cadre remain unverified. Next define origin retention and persistent native event ownership contracts; preserve actual-class checks and isolated session fallback.") (:heading 2 "Larger owned-event construction, cloning and dispatch batch (2026-10-28)") (:p "ABI 24 adds OWNED-EVENT, MAKE-EVENT, CLONE-EVENT, DESTROY-EVENT and EVENT-ALIVE-P. Native-backed CLOS initialization supports subclass slots/defaults/AFTER hooks and mixed-resource rollback. Clone construction preserves source state over inherited payload defaults; factory calls reject explicit payload overrides. Direct MAKE-INSTANCE :CLONE-FROM uses source state over all payload initargs. Owned objects remain session-registered until explicit destruction or cleanup; there is no GC finalizer. An independent clone, queue copy or processing copy survives disposal of its source. Snapshots remain immutable; contexts remain innermost-callback scoped. EVENT-KIND/FAMILY/TEXT/INTEGER are generic and native command text/integer SETF now accepts owned values and current contexts.") (:p "Only exact wxCommandEvent/wxNotifyEvent/wxCloseEvent classes clone. Borrowed userdata/client pointers reject, native origin is detached, and effective string payload is captured before origin removal. Copy dispatch attaches its receiver as native origin; no source ownership is transferred. Native session event copies still require isolated standalone receivers. Arbitrary origin writes/retention, native derived classes, generic wxObject wrappers and direct transfer remain gaps.") (:p "Implementation verification caught a renamed BOA snapshot field mismatch, an overstrict clone-payload check that rejected inherited default KIND, and a rollback test that needed to pump asynchronous wxFrame destruction. Independent review found mixed OWNED-EVENT/EVENT-HANDLER ancestry could overwrite handles; both construction paths now reject it before allocation. Review also found lazy wxEVT_TEXT GetString can read a text-entry origin instead of stored payload: context text SETF rejects tracked text-entry/unknown origin cases, detached clones freeze effective text, and owned text-change copies reject text-entry receivers before emission. Existing keyword synthetic behavior is unchanged.") (:p "Docset generation initially caught a missing class syntax field; it was added before rebuilding.") (:p "Final batch inventory: 109 exports, 69 named generics, 20 generic SETF writers, 41 GUI scenarios, 154 docset entries and twenty-two example sources. Independent runtime and documentation reviews pass after resolving the findings above. All 41 local GUI scenarios and native preflight pass on SBCL and CCL. The five rebuilt relocated-package checks pass. Python/inventory regressions and actual export/SETF lookup checks pass; docset checker reports zero problems, with isolated installation, discovery and API/guide/example access verified on both Lisps. Evidence is in " (:code "evidence/owned-events/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/owned-events-20261028/") ". Two user-authorized subagents handled documentation/coverage and expanded tests in parallel; independent review remained separate. One test-only STRING= arity error was corrected before passing checks. Hosted Windows/Linux GUI, real OS-session delivery and graphical Cadre remain unverified, as do safe-public-API-inaccessible null/untracked origins and incompatible actual-class rejection branches. Next define explicit origin retention/ownership or another prerequisite C1 slice before widening pointer-bearing native events; retain no unchecked native pointer.") (:heading 2 "Pending posting, consuming transfer, local copies and cancellation (2026-10-28)") (:p "ABI 25 adds POST-EVENT (GUI wxPostEvent/AddPendingEvent copy), TRANSFER-EVENT (genuine wxQueueEvent handoff), PROCESS-EVENT-LOCALLY (independent local copy) and DELETE-PENDING-EVENTS (one non-application receiver, no callbacks). Post and local processing preserve the source; transfer validates before consuming it, then removes bridge ownership before native handoff. No rollback or delivery guarantee exists after handoff. Session-isolated receivers, exact supported classes and lazy wxEVT_TEXT/text-entry receiver restrictions remain in force.") (:p "Local processing avoids normal outer global-filter/parent/application fallback, retaining native local pre-processing/chain behavior. Target deletion rejects the borrowed application handler and callback/pump/RUN use, removes pending events without bindings/callbacks, then synchronizes wxApp's pending-handler membership. Native DeletePendingEvents alone leaves that list entry, so the wrapper uses RemovePendingEventHandler from the implementation header. It is not present in the pinned documentation interface and must remain a C7 reconciliation dependency, not an asserted public binding. wxAppConsole::DeletePendingEvents and per-handler ProcessPendingEvents remain unbound; the latter requires a nonempty target queue without a safe public per-handler pending query. Existing app-wide processing is unchanged.") (:p "Final batch counts: 113 exports, 73 named generics, 20 generic SETF writers, 42 GUI scenarios, 160 docset entries and twenty-three examples. Independent runtime and documentation review pass. Local native static/default handlers can still execute under local processing, as clarified in the guide/reference. All 42 GUI scenarios plus native preflight pass locally on SBCL and CCL. Five rebuilt relocated-package checks pass. Python/inventory regressions, actual export/SETF lookup, isolated docset installation/discovery and API/guide/example navigation pass; the docset checker reports zero problems. Evidence is in " (:code "evidence/pending-events/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/pending-events-20261028/") "; package: " (:code "dist/wxlambda-form-pending-events") ".") (:p "An initial script reused the package text buffer while appending API methods, temporarily replacing lisp/api.lisp and causing CLASS-NOT-FOUND on example load. The committed source was restored and only the intended 28 new lines reapplied; the example and all subsequent checks pass. Expanded regression tests passed on both Lisps on their first run. Two user-authorized subagents handled docs/coverage and regressions in parallel, with independent review separate. Hosted Windows/Linux GUI, actual OS-session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Next continue C1 origin retention/ownership or handler-chain prerequisites; worker posting, arbitrary native pointers and global queue cancellation remain gaps.") (:heading 2 "Managed standalone handler chains (2026-10-28)") (:p "ABI 26 adds NEXT-HANDLER/PREVIOUS-HANDLER generic readers and SETF, plus HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER. Sources/peers are owned standalone handlers only; borrowed window/app inputs reject before mutation. Reciprocal vacant endpoints can join whole segments, existing links are idempotent, and self/cycle/occupied-endpoint attempts reject unchanged. SETF NIL splits one edge; UNLINK splices neighbors and leaves the node alive. Native ownership remains session-owned. A session map strongly roots canonical wrappers until explicit destruction, rollback or cleanup so peer lookups return EQ original subclasses.") (:p "Reads are callback-safe under lifetime guards. All structural writes reject RUN/pump/callback use. Linked callback-time destruction rejects; outside callbacks native destruction unlinks/splices normally, while unlinked callback disposal retains existing deferral. Normal/local/pending dispatch traverses native chains; disabled nodes do not disable followers. Chain-node traversal follows next links; callback order within one node is still native behavior. Queues belong to target nodes, not all future chain observers. Native session tags remain isolated from app fallback. Constructor rollback cleans created resources/canonical roots, not arbitrary edits to external graph state: native Unlink can leave surviving prefix/suffix segments joined after the failed node is removed.") (:p "The pinned setter prose forbids NULL, while implementation setters and native Unlink permit paired pointer clearing. NIL is a bounded reciprocal detach mapping, not a one-sided raw setter; retain the discrepancy for C7 reconciliation. Native Push/Pop/Remove, borrowed chains, external adoption and arbitrary origin retention remain open.") (:p "Final counts: 117 exports, 77 named generics, 22 generic SETF writers, 43 GUI scenarios, 166 docset entries and twenty-four examples. Independent runtime and documentation review pass with no actionable findings. The example and expanded focused regressions pass on SBCL and CCL without implementation/test corrections. All 43 local GUI scenarios plus native preflight and five rebuilt relocated-package checks pass. Python/inventory regressions and actual export/SETF lookup pass; docset checker reports zero problems, including isolated install, discovery and API/guide/example navigation on both Lisps. Evidence: " (:code "evidence/handler-chains/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/handler-chains-20261028/") "; package: " (:code "dist/wxlambda-form-handler-chains") ". Two user-authorized subagents handled regressions and docs/coverage in parallel, with separate independent review. Hosted Windows/Linux GUI, actual OS-session delivery, graphical Cadre and previous inaccessible pointer/class-mismatch branches remain unverified. Next define borrowed window handler-stack ownership before widening chain peers or adding Push/Pop; preserve reciprocal identity, session lifetime and dispatch mutation restrictions.") (:heading 2 "Managed window handler stacks and explicit routing (2026-10-28)") (:p "ABI 27 adds WINDOW-EVENT-HANDLER, PUSH/POP/REMOVE-EVENT-HANDLER and copied PROCESS-WINDOW-EVENT/LOCALLY. Push requires unlinked unattached owned standalone handlers and preserves bridge native ownership/canonical roots. Default pop and remove detach alive; deleting pop releases registry ownership before native Pop(true) deletion and clears roots/bindings. Empty pop rejects; valid detached or other-window remove probes return NIL without native assertion. Getter returns canonical pushed handler or the identical window when empty, never an adopted external native pointer.") (:p "All structural stack operations reject RUN/pump/callback use. Attached nodes reject general next/previous reads/SETF and Unlink, avoiding exposure of borrowed window tails; IsUnlinked returns false. Attached handler destruction removes it before outside-callback deletion; linked/attached callback deletion rejects. All eight concrete native widget types use internal managed destructors that Pop(false) before wxWindowBase teardown, so handlers survive actual window or ancestor destruction independent of destroy-event Skip/enabled flags. A destroy request is not completed detachment; asynchronous native deletion still applies. Session finish detaches stacks before window cleanup. Native window teardown requires stack removal and does not take deleting ownership of these handlers. Constructor rollback cleans resources, not arbitrary restoration of external edits.") (:p "Explicit window processing enters managed pushed stacks; generic/local/queued window APIs retain wxEvtHandler stack bypass. Copy origin is the window and snapshot receiver can be a pushed handler. Session binding/delivery on attached handlers rejects; push also rejects active session bindings or queued session events, tracked until native processing/deletion. No real OS session event, worker facility, arbitrary SetEventHandler or native virtual Lisp hook is added.") (:p "An initial C++ variable-shadow build error was corrected before example checks. Coverage validation rejected approximate ProcessWindowEvent source lines; exact pinned declarations at lines 2669/2682 were used before regeneration. Broad focused regression/example passes both Lisps (quiet-run.kZR9FBII), covering all eight widget destructors/parent cascade with disabled event processing, session guards, pending delivery after detachment and rollback directions. Public wxEVT_DESTROY binding is absent: consuming a real destroy notification remains untested, while ManagedWindow destructor cleanup is structurally independent of observer Skip.") (:p "Final counts: 123 exports, 83 named generics, 22 generic SETF writers, 44 GUI scenarios, 174 docset entries and twenty-five examples. Independent runtime and documentation reviews pass with no remaining actionable findings. All 44 local GUI scenarios plus native preflight pass on SBCL and CCL. The five rebuilt relocated-package checks pass. Python/inventory regressions, actual export/SETF lookup, isolated docset install/discovery and API/guide/example reading pass; checker reports zero problems. Evidence: " (:code "evidence/window-handler-stacks/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/window-handler-stacks-20261028/") "; package: " (:code "dist/wxlambda-form-window-handler-stacks") ". Two user-authorized subagents handled tests and docs/coverage in parallel; independent review remained separate. Hosted Windows/Linux GUI, native OS-session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 external stack adoption/retained origin or other lifetime prerequisites before exposing arbitrary borrowed native chains.") (:heading 2 "Command payload views and bounded origin clearing (2026-10-28)") (:p "ABI 28 adds EVENT-EXTRA-LONG and raw EVENT-SELECTION-P saved/current/owned readers; extra LONG SETF uses signed native LONG bounds, is independent of signed32 integer and drives raw IsSelection (nonzero extra flag). It is not a kind/index-validity predicate: a native choice event can have extra0 and flagfalse. Owned construction accepts command/notify-only :EXTRA-LONG; keyword synthetic dispatch does not. Clone source state wins defaults and factories reject explicit clone extra overrides.") (:p "EVENT-CHECKED-P/EVENT-SELECTION become uniform kind-specific generic views while preserving snapshot meanings. Live checked SETF is :TOGGLE-only, generalized bool stored as 0/1; selection SETF is :SELECTION-only, NIL as -1 or nonnegative signed32 index. Raw integer writes can expose other negatives; only -1 maps to NIL. Direct setters change event fields, not control setters/item lists; later handlers can react, so whole-dispatch control state is not guaranteed unchanged.") (:p "Clear-only EVENT-ORIGIN-ID SETF accepts NIL. Owned/actual-null origins are idempotent; non-null current origins require registered compatible command/notify native class. Built-in/nonregistered non-null origins reject, even if the bounded reader returns NIL for untracked state. No object is dereferenced, retained or destroyed; source receiver and old snapshots stay unchanged, later snapshots can capture NIL. Arbitrary new origins, retained objects and user/client-data ownership remain gaps.") (:p "Verified counts: 125 exports, 87 named generics, 26 generic SETF writers, 45 GUI scenarios, 178 docset entries and twenty-six examples. Independent runtime, documentation and final test-adjustment reviews found no actionable issues. Both local Lisp GUI suites and native preflights pass, as do five relocated package checks, sixteen Python tests, twelve coverage-inventory tests, and the focused example/regressions on both Lisps. Docset checking reports zero problems; actual public exports/SETF coverage, isolated installation, discovery, symbol lookup and guide/example access pass. Reports: evidence/command-event-payloads/{sbcl,ccl}-20261028-final/ and evidence/packaging/command-event-payloads-20261028/; package: dist/wxlambda-form-command-event-payloads.") (:p "The initial full-suite run caught an obsolete origin test asserting no writer exists. Updated it to require the new live writer and verify saved snapshots remain immutable; independent review passed and both full suites were rerun. Hosted Windows/Linux GUI, actual OS session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 retained origin/client/userData lifetime or broader native class prerequisites; do not equate raw flags with full derived payload semantics.") (:heading 2 "Managed handler Lisp client-data roots (2026-10-28)") (:p "ABI 29 adds EVENT-HANDLER-CLIENT-DATA/SETF for standalone handlers, windows and the managed application. A native wxClientData subclass owns only a numeric root token; the Lisp session table retains the actual object by EQ. NIL clears, replacement/clear releases prior roots, and failed candidate assignments remove their root. No constructor initarg, Lisp/native pointer exposure, event payload, per-item client data, generic wxClientData wrapper or untyped binding is added.") (:p "Foreign non-null typed objects and all untyped/Void storage modes (even NULL raw pointer) reject untouched. Fresh None/typedNULL read NIL. Private native interfaces on managed App/StandaloneHandler/ManagedWindow expose protected m_clientDataType before GetClientObject because wxEvtHandler has no public mode getter. Retain that implementation-header dependency for C7; do not export the protected field. Native asynchronous destruction can retain Lisp roots until actual deletion and next client/generic cleanup, rollback or session end; the session table clears after finish. Detached pushed handlers keep their own datum; deleting handlers or windows releases their separate association. Returned ordinary Lisp references remain valid. Immutable snapshots do not capture handler client data.") (:p "Verified counts: 126 exports, 88 named generics, 27 generic SETF writers, 46 GUI scenarios, 181 docset entries and twenty-seven examples. Independent runtime/harness and documentation reviews pass. Both local full GUI suites and native preflights, the example/focused regressions on SBCL and CCL, five relocated package checks, sixteen Python tests and twelve coverage-inventory tests pass. The native foreign typed/untyped/voidNULL regression passes with zero captured wx assertions (quiet-run.xAmVX0T2). Build the optional WXLAMBDA_BUILD_NATIVE_TESTS target wxlambda-client-data-native from tests/client-data-native.cpp; commands are in docs/HANDLER-CLIENT-DATA.md. The local separate build used /private/tmp/wxlambda-client-data-native-build and the pinned /opt/homebrew/opt/wxwidgets@3.2/bin/wx-config-3.2.") (:p "Docset checking reports zero problems, with actual public-export/SETF coverage, isolated installation, discovery, symbol lookup and guide/example access verified. Reports: evidence/handler-client-data/{sbcl,ccl}-20261028/ and evidence/packaging/handler-client-data-20261028-final/; final package: dist/wxlambda-form-handler-client-data-final. An early Python run preceded the API reference update and failed its export-reference consistency checks; the final run passed after documentation generation. No runtime test failures occurred. Hosted Windows/Linux GUI, actual OS session delivery, graphical Cadre and prior inaccessible pointer/class-mismatch branches remain unverified. Continue C1 event/userData, retained-origin or broader client-data ownership contracts explicitly; this handler slot does not complete generic client containers or derived control item data.") (:heading 2 "Decisions") (:list (:item (:p "D1 Keep a bounded first release as an intermediate milestone. The user has"))) (:p "clarified that the final goal is complete wxWidgets coverage through C1–C7; the first release and individual slices do not satisfy final acceptance.") (:list (:item (:p "D2 Gate editor support on prototype evidence because main-thread integration"))) (:p "remains unproven; rejected: making release completion depend indefinitely on SLIME/SLY.") (:list (:item (:p "D3 Accept both existing lifecycle limits for the first release because restart"))) (:p "support and destruction notifications require separate lifecycle designs; rejected: silently expanding their scope.") (:list (:item (:p "D4 Pause GUI processing during debugging because nested event dispatch adds"))) (:p "reentrancy risks; rejected: implicitly pumping events inside the debugger.") (:list (:item (:p "D5 Default the application REPL to the host debugger and require explicit"))) (:p (:code ":on-error :report") " for automatic recovery because interactive diagnosis needs live evaluation restarts; rejected: silently discarding restarts by default.") (:list (:item (:p "D6 Defer editor integration and scheduling for the first release because thread"))) (:p "probes do not establish a persistent editor/debugger workflow; rejected: advertising SLIME/SLY support from single-request thread checks.") (:list (:item (:p "D7 Ship the packaging example as a separate SBCL runtime/core with sibling"))) (:p "native libraries because relocation can patch/sign the runtime without modifying an appended Lisp core; rejected: a single Mach-O/core executable for this first packaging example.") (:list (:item (:p "D8 Use public CLOS wrapper classes and generic widget operations because the"))) (:p "user requested Lisp dispatch and specialization before further expansion; rejected: continuing ordinary functions with native-only type dispatch.") (:list (:item (:p "D9 Use native-backed INITIALIZE-INSTANCE construction and canonical SETF"))) (:p "properties because the user requested a ground-up CLOS API without backward compatibility; rejected: factory-then-CHANGE-CLASS construction and legacy setter/receiver compatibility scaffolding.") (:list (:item (:p "D10 Name the mutable properties " (:code "text") " and " (:code "label-text") " because the same"))) (:p "names read naturally for reads and SETF writes; rejected: get-prefixed readers and compatibility aliases during ground-up API development.") (:p "Implement these as separate reviewable changes, beginning with baseline corrections and REPL regression tests. Platform work can proceed alongside local development when runners become available."))))
(:entry "guide/docs/APPLICATION-EVENTS.md" :names ("docs/APPLICATION-EVENTS.md" "APPLICATION-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/APPLICATION-EVENTS.md" :sections (("Guide" (:heading 1 "Application event dispatch") (:p "This C1 foundation slice defines dispatch entry and observation for the existing bridge application. It precedes broader event-handler, timer and worker-dispatch bindings. It does not introduce arbitrary application or event-loop objects.") (:p "All operations require the active GUI session on its process main thread. Inactive-session calls signal " (:code "native-error") ", including boolean queries. The three new APIs enforce this before any FFI call, so it also holds immediately after loading the Lisp system, before loading the native bridge.") (:heading 2 "Observe the application") (:code-block "lisp" "(wxlambda:main-loop-running-p) ; T while the native blocking main loop runs
(wxlambda:pending-events-p)    ; T if wxWidgets has queued pending events") (:p (:code "main-loop-running-p") " maps to " (:code "wxAppConsole::IsMainLoopRunning") ". It is false during standalone " (:code "process-events") ", " (:code "process-pending-events") " and the cooperative application REPL. Those modes can still invoke callbacks; a false query does not mean it is safe to enter another pump. Inside a " (:code "run") " callback, the query reports the native main-loop state.") (:p (:code "pending-events-p") " maps to " (:code "wxAppConsole::HasPendingEvents") ". It observes the application's wx pending-event handlers, including events queued by " (:code "queue-click") ". It does not inspect OS input, idle work or timers that have not queued events. Its result is an observation rather than a promise about subsequent dispatch. Both queries return T/NIL and are safe to call from callbacks.") (:heading 2 "Dispatch queued wx events") (:code-block "lisp" "(wxlambda:queue-click button)
(assert (wxlambda:pending-events-p))
(wxlambda:process-pending-events) ; returns NIL") (:p (:code "process-pending-events") " maps to " (:code "wxAppConsole::ProcessPendingEvents") " across all pending handlers in the bridge application. It dispatches queued wx events, without yielding to OS input or running " (:code "ProcessIdle") ". It does not wait for new events, but callbacks and continuously requeued work can delay its return. It is not a replacement for the GUI loop needed to keep an application responsive.") (:p "Use " (:code "process-events") " to yield to GUI events and process idle work, or " (:code "run") " to enter the blocking native main loop. " (:code "stop") " exits that loop; in the cooperative application REPL it instead ends the REPL. Pending-only dispatch does not create a native main loop, so " (:code "stop") " outside RUN/REPL still signals " (:code "native-error") ".") (:heading 2 "Callback and pump boundaries") (:p (:code "run") ", " (:code "process-events") " and " (:code "process-pending-events") " reject entry while RUN, either pump, or any native-to-Lisp callback is active. These failures signal " (:code "native-error") "; the same protection applies to raw bridge calls. This includes synchronous command callbacks invoked by a notifying SETF writer before any main loop starts. Native cleanup is also forbidden from pumps and callbacks. RAII guards restore dispatch state after native exceptions and callback failures.") (:p "Property reads, queries, ordinary window operations, handler replacement and synchronous notifying setters retain their existing callback behavior. This boundary prevents recursive event pumping; it does not disable synchronous command notifications or provide native virtual-method callbacks.") (:p "Both pump functions reject dispatch in the application REPL debugger, keeping the documented pause while debugging. Callback conditions never unwind through C++; they are recorded and re-signaled when the native operation returns. Handled boundary failures allow the callback to continue; an escaping condition uses the existing callback-error recovery rules. A subsequent pump remains usable.") (:p "Application dispatch was introduced in ABI 11; the current bridge is ABI 29. Rebuild it alongside the Lisp bindings. This uses the wxWidgets 3.2.12 inventory baseline; application traits, arbitrary event-loop objects, generic event binding, pending-event suspension/deletion, filters, propagation, idle handlers, timers and worker dispatch remain open C1 work.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/application-events.lisp" "application-events example") " displays main-loop state from a button callback:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-events.lisp \\
  --eval '(wxlambda-application-events:start)'") (:p "The reusable " (:code "exercise") " invokes that same callback once through explicit pending dispatch and once through RUN, verifying the different loop states and cleaning up handlers/windows. The focused scenario also tests reentrancy from pending, GUI-poll and blocking-loop callbacks, synchronous text notifications, inactive sessions, debugger pauses and recovery after an escaping callback error:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/application-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/application-events.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete GUI runner includes this scenario. " (:ref "guide/docs/DOCSET.md" "Install the Cadre docset") " with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") to browse these APIs, this guide and the example together.") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound."))))
(:entry "guide/docs/APPLICATION-HANDLER.md" :names ("docs/APPLICATION-HANDLER.md") :kind :guide :kind-name "Guide" :summary "docs/APPLICATION-HANDLER.md" :sections (("Guide" (:heading 1 "Borrowed application event handler") (:p (:code "current-application-handler") " returns the session's unique " (:code "application-handler") " view of the bridge-owned wxApp. It is an " (:code "event-handler") ", not a window or a user-constructible application. It borrows native ownership; only application session cleanup destroys wxApp. Repeated lookups return the same Lisp object, including inside callbacks. Lookup requires the active main-thread session. The bridge supports one application session per process.") (:code-block "lisp" "(wxlambda:with-application ()
  (wxlambda:register-event-type :application-message :family :command)
  (let* ((app (wxlambda:current-application-handler))
         (binding (wxlambda:bind-event app :application-message
                    (lambda (event) (print (wxlambda:event-text event))))))
    (unwind-protect
         (progn
           (wxlambda:queue-event app :application-message :text \"Hello\")
           (wxlambda:process-pending-events))
      (wxlambda:unbind-event binding))))") (:p "The inherited generic binding, unbinding, queueing, synchronous dispatch, handler liveness and handler-enabled SETF operations apply to this view. Observer callbacks still Skip, so delivery does not imply a true PROCESS-EVENT handled result. Contexts and notify Veto/Allow retain their existing lifetime and snapshot rules. " (:code "event-source") " is the cached application view when it is the binding receiver. Supported types remain built-ins and registered command/ notify types; no new native event families are introduced.") (:p (:code "make-instance") " on APPLICATION-HANDLER or its subclasses signals an error; MAKE-EVENT-HANDLER cannot manufacture it either. Subclassing cannot replace the managed native wxApp or install virtual overrides. DESTROY-EVENT-HANDLER rejects the borrowed view before deleting anything, including during a callback. Native application identity uses an opaque handle distinct from windows and owned standalone handlers. No native pointer is public.") (:p "HANDLER-ENABLED-P reads or writes wxApp's own wxEvtHandler enabled flag. Disabling it can suppress application event processing and delay application-queued work, including deferred receiver disposal, potentially until session cleanup. Restore it with UNWIND-PROTECT when temporarily changing it. It is independent of RUN's loop state. Bindings are removed before native application cleanup. A saved view cannot perform native operations outside the session; these signal NATIVE-ERROR. Saved immutable event snapshots remain readable, including their source view, without implying that the source is still live.") (:p "This is a bounded wxWidgets 3.2.12 GetInstance/wxTheApp mapping. Application construction, subclass hooks, traits, top-window operations, replacement of an external wxApp and native application overrides remain unbound. Session-event bindings and logging-off metadata are available; real OS delivery remains unverified. In particular, native query/end-session events route to wxApp and default END_SESSION can exit the process. Synthetic session events are restricted to isolated owned handlers; application/window receivers reject emission before event creation. See " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " for routing restrictions and native policy.") (:p "Run the example (it queues a message, verifies delivery, unbinds and exits):") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/application-handler.lisp --eval '(wxlambda-application-handler:start)'") (:p (:code "tests/application-handler.lisp") " also checks cached identity, inherited notify dispatch and final veto, disabling/restoration, construction and destruction rejection, binding cleanup, expired native access and saved snapshots.") (:p "Build/check the docset with " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery, API lookup and examples. See " (:ref "guide/docs/DOCSET.md" "docset installation") ", " (:ref "guide/docs/EVENT-HANDLERS.md" "handlers") " and " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify events") "."))))
(:entry "guide/docs/CLOS-API.md" :names ("docs/CLOS-API.md" "CLOS-API") :kind :guide :kind-name "Guide" :summary "docs/CLOS-API.md" :sections (("Guide" (:heading 1 "CLOS widget API") (:p "Widgets are native-backed CLOS instances. The public classes are " (:code "window") ", " (:code "frame") ", " (:code "panel") ", " (:code "button") ", " (:code "text-control") ", " (:code "label") ", " (:code "checkbox") ", " (:code "choice") " and " (:code "gauge") ". " (:code "window") " inherits from " (:code "event-handler") " and is abstract. Standalone " (:code "event-handler") " instances are native-backed session-owned resources; window instances reuse their existing native widget as a borrowed handler identity. See " (:ref "guide/docs/EVENT-HANDLERS.md" "ownership and handler state") ". Every concrete window wrapper inherits from " (:code "window") " and represents one native widget kind. Native handles remain private and validated.") (:heading 2 "Construction") (:p "Use " (:code "make-instance") " directly, including for your own subclasses:") (:code-block "lisp" "(defclass document-frame (wxlambda:frame)
  ((project :initarg :project :reader project)
   (title-changes :initform 0 :accessor title-changes))
  (:default-initargs :title \"Document\"))

(defmethod initialize-instance :after ((frame document-frame) &key)
  ;; Inherited initialization has already created the native widget.
  (setf (wxlambda:window-name frame) (project frame)))

(defmethod (setf wxlambda:frame-title) :after (value (frame document-frame))
  (declare (ignore value))
  (incf (title-changes frame)))

(wxlambda:with-application ()
  (let ((frame (make-instance 'document-frame :project \"example\")))
    (setf (wxlambda:frame-title frame) \"Document — λ\")
    (assert (= 1 (title-changes frame)))
    (assert (string= \"example\" (wxlambda:window-name frame)))
    (wxlambda:destroy-window frame)))") (:p "Concrete native initargs are:") (:list (:item (:p (:code "frame") ": " (:code ":title") " (default \"wxlambda\"), " (:code ":width") " (480), " (:code ":height") " (240)."))) (:list (:item (:p (:code "panel") ": required " (:code ":parent") " window."))) (:list (:item (:p (:code "button") ": required " (:code ":parent") ", " (:code ":label") " (\"Button\")."))) (:list (:item (:p (:code "text-control") ": required " (:code ":parent") ", " (:code ":value") " (empty string)."))) (:list (:item (:p (:code "label") ": required " (:code ":parent") ", " (:code ":label") " (empty string)."))) (:list (:item (:p (:code "checkbox") ": required " (:code ":parent") ", " (:code ":label") " (empty string), " (:code ":checked") " (NIL)."))) (:list (:item (:p (:code "gauge") ": required " (:code ":parent") ", " (:code ":range") " (100), " (:code ":value") " (0), " (:code ":orientation")))) (:p "(" (:code ":horizontal") " or " (:code ":vertical") "). See " (:ref "guide/docs/GAUGE.md" "gauge behavior") ".") (:list (:item (:p (:code "choice") ": required " (:code ":parent") ", " (:code ":items") " (NIL), " (:code ":selection") " (NIL)."))) (:p "Construction requires an active main-thread application session. Inherited " (:code "initialize-instance") " methods allocate exactly one native widget. Subclass " (:code ":default-initargs") ", slot initargs and ordinary " (:code ":after") " hooks work normally; these hooks can read/write native properties. An overriding primary initializer must call its inherited method. Unsupported abstract classes, missing parents, unknown initargs, repeated initialization and multiple native widget bases are rejected with clear errors. Supplying a raw " (:code ":handle") " is unsupported.") (:p "Failures during inherited initialization and subclass " (:code ":before") "/" (:code ":after") " hooks roll back native widgets created through this protocol in that initialization, including nested construction, and remove their callback roots. Cleanup preserves the original condition or nonlocal exit. Custom outer " (:code ":around") " methods remain responsible for failures they introduce after the inherited initialization has completed.") (:heading 2 "Factory conveniences") (:p "The " (:code "make-*") " functions are thin wrappers around " (:code "make-instance") ". Each accepts " (:code ":class") " as a class name or class object and forwards additional initargs:") (:code-block "lisp" "(wxlambda:make-frame :class 'document-frame :project \"example\")
(wxlambda:make-button parent :class 'wxlambda:button :label \"Run\")") (:p "A factory validates that " (:code ":class") " is a subclass of its corresponding concrete widget class. Child factories dispatch on their parent; methods extending a factory should accept " (:code "&rest") "/" (:code "&allow-other-keys") " to forward subclass initargs. " (:code "make-frame") " remains an ordinary function because it has no required dispatch argument. Application lifecycle functions/macros and immutable event snapshots keep their separate roles.") (:heading 2 "Generic properties") (:p "Use these thirteen generic " (:code "setf") " accessors:") (:code-block "lisp" "(setf (wxlambda:text input) \"Text\")
(setf (wxlambda:label-text caption) \"Ready\")
(setf (wxlambda:checked-p checkbox) t)
(setf (wxlambda:selection choice) 0)
(setf (wxlambda:window-name window) \"logical-name\")
(setf (wxlambda:frame-title frame) \"Title\")
(setf (wxlambda:shown-p window) nil)
(setf (wxlambda:enabled-p window) t)
(setf (wxlambda:gauge-value gauge) 25)
(setf (wxlambda:gauge-range gauge) 100)
(setf (wxlambda:handler-enabled-p handler) t)
(setf (wxlambda:event-skipped-p context) t) ; only in its contextual callback
(setf (wxlambda:event-vetoed-p context) t)  ; only in a vetoable close context") (:p "A writer's method lambda list starts with the new value, followed by the receiver. Specialize " (:code "(setf accessor)") " with primary, " (:code ":around") ", " (:code ":before") " or " (:code ":after") " methods; " (:code "call-next-method") " retains inherited behavior. Assignment returns the supplied value. Boolean reads normalize generalized booleans to T/NIL. The shown/enabled writers also return a native changed-state flag as a second value; " (:code "show-window") "/" (:code "enable-window") " are action conveniences returning the window and that flag.") (:p "Text, checkbox and selection writes are silent by default. Use " (:code ":notify t") " on the place for synchronous command events:") (:code-block "lisp" "(setf (wxlambda:text input :notify t) \"Changed\")
(setf (wxlambda:checked-p checkbox :notify t) t)
(incf (wxlambda:selection choice :notify t))") (:p "The corresponding readers accept and ignore " (:code ":notify") ", so modifying macros can read the same place. Callback conditions are re-signaled at the writer's Lisp boundary. Reads of " (:code "shown-p") " use the own shown flag; reads of " (:code "enabled-p") " include disabled ancestors, while its writer requests the own enabled state.") (:p "This project is establishing its API from the ground up: the six separate " (:code "set-*") " property aliases and compatibility-only wrong-receiver methods have been removed. Unsupported receiver types signal standard Lisp dispatch errors; native handle/state failures still signal " (:code "native-error") ".") (:heading 2 "Scope and verification") (:p "The " (:ref "example/examples/window-metadata.lisp" "metadata example") " uses direct subclass construction and a generic writer hook. Lisp subclassing extends the wrapper; it does not change the native C++ class or provide native virtual callbacks. Native ownership, main-thread restrictions and explicit handler unbinding before destruction still apply. Start a fresh Lisp when changing these class definitions.") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/clos.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/clos.lisp") (:p "The CLOS test covers direct native construction for the original seven concrete types, subclass slots/defaults/hooks, all factory " (:code ":class") " paths, invalid construction, initializer rollback of nested native objects and callback roots, eight generic writers, method combination and native handle protection. Those checks exercise the original 34 named generic functions and eight generic SETF functions. The docset includes construction instructions on class pages and indexed SETF forms on property pages.") (:p "The gauge scenario additionally verifies direct and factory subclass construction, subclass AFTER access, rollback, and the two gauge SETF writers. Across the public API there are now 55 named generic functions and thirteen generic SETF functions.") (:p "Independent " (:code "event-binding") " values are immutable registration identities rather than native-backed CLOS resources. The generic " (:code "bind-event") ", " (:code "unbind-event") ", " (:code "binding-active-p") " and " (:code "queue-event") " operations cover the four current command kinds; see " (:ref "guide/docs/EVENT-BINDINGS.md" "binding scope and lifecycle") ".") (:p (:code "event-context") " is a borrowed, immutable-token view whose generic operations mutate a native event only during its current callback. Its scoped SETF writer does not change immutable snapshot semantics. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "context lifetime") ".") (:p "Close capability/veto readers accept immutable snapshots or current contexts; the veto SETF writer accepts only a current vetoable close context. Frame close requests use the generic " (:code "close-window") "; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close-family scope") ".") (:p (:code "process-event") " synchronously dispatches supported copied events and returns native handled/final-veto values. Registered custom families remain session-scoped metadata; see " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify type scope") ".") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. Event/client/ userData and item-pointer ownership remain separate unbound APIs."))))
(:entry "guide/docs/CLOSE-EVENTS.md" :names ("docs/CLOSE-EVENTS.md" "CLOSE-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/CLOSE-EVENTS.md" :sections (("Guide" (:heading 1 "Close-event family and veto") (:p "This C1 slice extends bindings beyond command events with " (:code ":close") ", backed by " (:code "wxEVT_CLOSE_WINDOW") " and " (:code "wxCloseEvent") ". The four command kinds remain supported. " (:code "event-family") " classifies these snapshots as " (:code ":command") " or " (:code ":close") "; registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify events") " additionally use " (:code ":notify") "; this is a portable supported-kind classification, not arbitrary native RTTI or event registration. The baseline is wxWidgets 3.2.12 and the native bridge is ABI 29.") (:p "The native type lookup is now " (:b "`event-type`") ", replacing " (:code "command-event-type") " without an alias. It accepts the seven built-in kinds and registered command/notify names. Native type IDs remain process-local; saved snapshots keep immutable copied values.") (:heading 2 "Veto a real frame close request") (:code-block "lisp" "(wxlambda:bind-event frame :close
  (lambda (snapshot context)
    (format t \"Close can be vetoed: ~S~%\" (wxlambda:event-can-veto-p snapshot))
    (if (wxlambda:event-can-veto-p context)
        (setf (wxlambda:event-vetoed-p context) t)
        (setf (wxlambda:event-skipped-p context) t)))
  :with-context t)
(wxlambda:close-window frame) ; NIL if that handler vetoes") (:p (:code "event-can-veto-p") " reads the snapshot's captured capability or the current native context's " (:code "CanVeto") ". Command snapshots/contexts report NIL. " (:code "event-vetoed-p") " reads the snapshot's captured flag or the current close context's " (:code "GetVeto") ". Snapshots capture state " (:b "before this callback") " and never reflect later context mutation. Saved flags can be read without a native session; snapshots have no SETF method.") (:p "The canonical generic " (:code "(setf event-vetoed-p)") " writer applies only to the current close context. It checks the actual native event class and " (:code "CanVeto") " before calling " (:code "Veto(bool)") ". Setting or clearing a non-vetoable close, accessing live veto state on a command context, or using an expired/suspended context signals " (:code "native-error") " before any wx assertion or invalid pointer access. The writer returns the supplied generalized boolean. Vetoable contexts permit both veto and clearing a veto. Context SETF " (:code "event-can-veto-p") " now maps SetCanVeto directly, including false to true. It changes metadata and can hide/restore a stored veto; see " (:ref "guide/docs/EVENT-METADATA.md" "metadata semantics") ".") (:heading 2 "Acceptance, consumption, veto and destruction") (:p (:code "close-window") " is a generic frame-only operation that synchronously calls " (:code "wxWindow::Close(force)") ". It preserves the native acceptance boolean; it does not promise destruction. A contextual callback begins unskipped and may consume the request without deleting anything. An accepted request can therefore return T while the frame remains alive. Delegate with Skip true when native default frame closing should run. Use " (:code "destroy-window") " to request explicit destruction.") (:p "A vetoing contextual handler should consume the close event (leave Skip false), so native default closing is not run. Veto and Skip are independent: setting veto is not a substitute for controlling which later native handlers execute. Veto also cannot undo an independent " (:code "destroy-window") " request.") (:p (:code ":force t") " sets native " (:code "CanVeto") " false. Both true and NIL veto assignments then signal " (:code "native-error") " while CanVeto stays false. A handler can explicitly change CanVeto through SETF, affecting native closing results. Force does not bypass a contextual handler's consumption or guarantee deletion. A handler should check capability and choose the appropriate native default/explicit closing action.") (:p "Observer bindings still automatically Skip. " (:b "A callback error does not itself veto") " an observer-delivered close: native default handling may continue before the condition is re-signaled. Use contextual policy and explicit veto when rejection is required. Callback errors from " (:code "close-window") " have a nearer Lisp boundary, like notifying writers; handling a nested close error does not stop an enclosing RUN. Errors escaping an actual native UI callback use the existing callback error/loop-stop rules.") (:heading 2 "Synthetic close events") (:code-block "lisp" "(wxlambda:queue-event receiver :close :id 42)                 ; vetoable
(wxlambda:queue-event receiver :close :id 42 :can-veto-p nil) ; not vetoable") (:p "The queue makes an owned copy of a " (:code "wxCloseEvent") ", rather than incorrectly treating it as " (:code "wxCommandEvent") ". " (:code ":can-veto-p") " defaults T and is accepted only for " (:code ":close") "; it sets initial capability, not an existing context's native flag. Close events reject non-default text/checked/selection payloads. They do not normally propagate to parents as command events do, although base event context Skip/propagation operations remain available.") (:p "A synthetic close queued to a frame " (:b "may invoke its native default closing action") ". A standalone handler has no frame default. Queuing provides no synchronous acceptance result and is not a substitute for " (:code "close-window") " when that result is needed. Session/main-thread, ID filter, weak lifetime, safe unbinding and deferred callback-disposal rules remain as documented in " (:ref "guide/docs/EVENT-BINDINGS.md" "bindings") " and " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") ".") (:heading 2 "Scope still missing") (:p "This guide covers " (:code "wxEVT_CLOSE_WINDOW") "; " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " add query/end-session tags and logging-off state. Registered command/notify types are supported. Native control-specific notify subclasses, arbitrary native event classes/factories, persistent event ownership/cloning, origin/type mutation and userData remain open. The frame-only close request is a bounded mapping of an inherited window operation; panel/dialog/other top-level receivers are not exposed here. Native virtual callbacks, pushed handler ownership, timer/idle and worker dispatch also remain C1 work. No claim of full wxCloseEvent, wxEvent or C1 coverage is made.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/close-events.lisp" "close-events example") " blocks frame closing until a checkbox permits it. Its callback releases the button's control-specific closure before delegating to default closing. The reusable " (:code "exercise") " runs real close requests through the button callback and checks veto, liveness and cleanup:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/close-events.lisp \\
  --eval '(wxlambda-close-events:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/close-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/close-events.lisp
python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover real close acceptance versus deletion, forced requests, immutable flags, synthetic events, wrong-family rejection, expired contexts and handled nested close errors while RUN continues. These APIs, this guide and example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted GUI and graphical Cadre checks remain separate from local shared-reader validation.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open."))))
(:entry "guide/docs/COMMAND-EVENT-PAYLOADS.md" :names ("docs/COMMAND-EVENT-PAYLOADS.md" "COMMAND-EVENT-PAYLOADS") :kind :guide :kind-name "Guide" :summary "docs/COMMAND-EVENT-PAYLOADS.md" :sections (("Guide" (:heading 1 "Command payload views and bounded origin detachment") (:p "ABI 29 adds EVENT-EXTRA-LONG and EVENT-SELECTION-P, extends EVENT-CHECKED-P and EVENT-SELECTION to generic saved/current/owned readers with live SETF writers, and adds clear-only SETF EVENT-ORIGIN-ID. The baseline is wxWidgets 3.2.12. Snapshots remain immutable; current-context access remains innermost-callback scoped and owned-event access remains valid only while the native resource lives.") (:heading 2 "Extra LONG and raw selection-action metadata") (:p "EVENT-EXTRA-LONG reads the copied/current wxCommandEvent GetExtraLong value for command/notify-derived events. SETF accepts signed native C LONG values and calls SetExtraLong; native bounds are platform dependent (normally 32 bits on Windows, 64 bits on 64-bit Unix). Malformed/out-of-range writes reject before narrowing. Close-family reads return zero and writes reject. This field is independent of the signed32 EVENT-INTEGER payload and of a selection item's index.") (:p "MAKE-EVENT/MAKE-INSTANCE accepts optional " (:code ":extra-long") " for command/notify construction only. Clones preserve the source native value rather than inherited payload defaults; clone factories reject explicit extra-long overrides just as they reject other explicit payload overrides. Keyword synthetic QUEUE-EVENT and PROCESS-EVENT do not add an :EXTRA-LONG option: construct or clone an owned event, set its value, and dispatch it when that field is needed.") (:p "EVENT-SELECTION-P copies/reads raw native IsSelection for any command/notify event: it is true when extra LONG is nonzero, and NIL when zero. Close-family reads are NIL. It has no SETF writer; change EXTRA-LONG when raw action metadata is intended. This is not an EVENT-KIND predicate, a test for :SELECTION or proof that a choice index is valid. A normal choice event can have extra LONG zero and therefore report NIL even though it has :SELECTION kind and a valid item index. For listbox-like native events the flag can describe selection versus deselection, but this batch does not bind listbox classes or reconstruct their item state.") (:heading 2 "Semantic checked and selection views") (:p "EVENT-CHECKED-P retains the snapshot contract: only :TOGGLE reports checkbox-like checked state; other supported kinds read NIL. Current/owned reads use the same kind restriction. SETF accepts a generalized boolean only for a current/owned :TOGGLE event, writes native SetInt as 0/1 and returns the supplied value. It changes event payload metadata without calling a checkbox-control setter.") (:p "EVENT-SELECTION retains its kind restriction too: only :SELECTION returns the native command selection integer, with -1 mapped to NIL; other kinds read NIL. SETF is allowed only on current/owned :SELECTION events and accepts NIL (stored as -1) or a nonnegative signed32 index. It validates no control item list and does not call a choice-control setter or synthesize another native notification.") (:p "Raw EVENT-INTEGER still accepts any signed32 value for command/notify events. Thus nonzero raw toggle values can read as checked, and raw selection mutation can make GetSelection return another negative number. The semantic selection reader preserves that native number; only -1 maps to NIL. Its SETF protocol is stricter than raw integer access and rejects other negative indices. Raw EVENT-SELECTION-P remains driven by EXTRA-LONG, not by this integer field. Earlier snapshots retain their pre-callback values after any live mutation. Later native or user handlers can react to changed metadata and change controls; there is no guarantee that the whole dispatch leaves UI state unchanged.") (:code-block "lisp" "(let ((event (wxlambda:make-event :kind :selection :selection 0 :extra-long 0)))
  (unwind-protect
       (progn
         (assert (= 0 (wxlambda:event-selection event)))
         (assert (not (wxlambda:event-selection-p event)))
         (setf (wxlambda:event-extra-long event) 1)
         (assert (wxlambda:event-selection-p event))
         (setf (wxlambda:event-selection event) nil))
    (wxlambda:destroy-event event)))") (:heading 2 "Clear-only native origin detachment") (:p "SETF EVENT-ORIGIN-ID accepts only NIL; non-NIL values signal TYPE-ERROR after the active-session check. It never accepts a bridge integer ID, wrapper or native pointer and never installs a new native origin. Owned events are already detached, so NIL is an idempotent native-validated no-op while the resource is live.") (:p "For a current context with an actual non-null native origin, clearing is allowed only for a registered command/notify tag whose actual native class matches its registered family. Built-in/nonregistered non-null origins reject before change. An actual null origin permits a no-op. EVENT-ORIGIN-ID reader NIL can also mean untracked, so reader NIL alone is not proof that this no-op condition holds. No origin object is dereferenced, retained or destroyed by dropping the event's pointer. This bounded policy avoids changing built-in semantics such as lazy wxEVT_TEXT origin-backed strings; registered custom strings retain their payload.") (:p "EVENT-SOURCE remains the callback's Lisp registration receiver. Earlier snapshot origin IDs remain unchanged; later callbacks can capture NIL after a successful clear. Clearing does not change native class, type, ID, payload, ownership or propagation policy. New copies dispatched from owned events still acquire their receiver as origin, independently of the owned source's detached state.") (:p "All live reads/writes require the active main-thread session. Expired/suspended contexts, destroyed/consumed owned events and unsupported field families reject. Snapshot writers have no methods. There is no pointer retention/pinning protocol, arbitrary SetEventObject, client/userData ownership or raw native adoption.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/command-event-payloads.lisp --eval '(wxlambda-command-event-payloads:start)'") (:p "Validation should distinguish the raw action flag from semantic kind/index, extra LONG bounds from signed32 payload bounds, detached no-op from guarded context clearing, and immutable snapshots from current native state. Safe APIs do not manufacture arbitrary native class mismatches or untracked origins; those prior coverage limitations remain. Hosted Windows/Linux GUI, real OS session delivery and graphical Cadre validation remain separate requirements.") (:p "Remaining C1 work includes retained arbitrary origins, full SetEventObject, client/userData ownership, broader command-derived native classes and their specific payload semantics, timer/idle and worker dispatch. Do not treat a native extra field or generic flag reader as completion of every derived event class.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") ", " (:ref "guide/docs/EVENT-ORIGINS.md" "origin/type access") ", " (:ref "guide/docs/EVENT-METADATA.md" "metadata") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/DOCSET.md" :names ("docs/DOCSET.md" "DOCSET") :kind :guide :kind-name "Guide" :summary "docs/DOCSET.md" :sections (("Guide" (:heading 1 "Cadre docset") (:p "The primary documentation artifact is " (:code "docs/docset/") ". It contains the public wxlambda API reference, guides and explained example sources together, in the " (:code "docset") " library's format version 1 (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "). The generated files are committed so readers can use them without building the bridge or opening a GUI.") (:heading 2 "Build and check") (:p "Requirements: Python 3, SBCL and the shared " (:link "https://github.com/crazymevt/docset" "docset library") ". The baseline used here is commit " (:code "481f57e7222925c3157e41a7e3deaeb628ecc9a7") " (format version 1). Check it out beside wxlambda as " (:code "../docset") ", or set " (:code "WXLAMBDA_DOCSET_SOURCE") " to its directory. The library has no runtime dependencies; it is a documentation tool dependency, not a wxlambda runtime dependency.") (:code-block "sh" "python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper when running these in an agent session. " (:code "--library /path/to/docset") " overrides the library location and " (:code "--lisp") " selects the SBCL executable. Builds do not load the native bridge or start a GUI.") (:p "The build requires one authored reference record per public export, derives function, macro and generic-function lambda lists from the implementation (including method defaults while omitting specializers), converts README, the implementation roadmap and " (:code "docs/*.md") " guides and the generated " (:code "docs/coverage/README.md") " coverage summary into docset blocks, and embeds every " (:code "examples/*.lisp") " source with usage notes. Agent instruction files (" (:code "AGENTS.md") " and " (:code "CLAUDE.md") ") are excluded from the guide list. Bundled guides and examples must not contain machine-specific paths. Update " (:code "docs/api-reference.json") " and " (:code "docs/example-reference.json") " with implementation changes. API entries must state arguments, returns, behavior, errors/scope and the related wxWidgets APIs. Class pages include Construction sections; mutable-property pages include SETF sections and searchable compound function names such as " (:code "(setf frame-title)") ". Bordered Markdown pipe tables with a separator row become format-v1 " (:code ":table") " blocks, retaining headers, rows and inline code/links. Escaped pipes and pipes inside inline code stay within their cell; inconsistent column counts are rejected. The generated coverage summary exercises this conversion for phase totals and all 398 header rows, so the backlog stays readable in Cadre. Guide/example filename stems that coincide with public symbols are omitted as aliases, so symbol lookup stays unambiguous. Their source paths remain indexed. Build/check requires exactly one matching API record for each symbol and SETF name.") (:p "Both commands run " (:code "docset:check-docset") " and require zero problems, then exercise the same discovery, symbol lookup and indexed entry reader used by Cadre. Every API entry and guide/example entry is read back and compared with source content; " (:code "check") " also rejects stale generated content. Cadre's graphical viewer is a separate manual integration check; shared-reader success alone is not a claim that the viewer was manually tested.") (:heading 2 "Install for Cadre") (:code-block "sh" "python3 tools/docset.py install") (:p "This verifies the build, copies the three files into " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "), and verifies discovery and reading there. Use " (:code "--destination /path/to/wxlambda") " for an isolated installation. Only the three generated files are overwritten. The install command does not alter Cadre's source or its bundled Common Lisp docs.") (:p "Open Cadre after installation, or restart it if it already cached its docsets. In Lisp source, use Look Up in Docs/HyperSpec on " (:code "wxlambda:make-frame") " to open its API entry. Search for " (:code "README") " or an example filename such as " (:code "hello.lisp") " to open guides and example source. Use the docset table of contents for the API reference, Guides and Examples groups.") (:heading 2 "Maintaining the artifact") (:p "Run examples affected by a change, build the docset, and run " (:code "check") ". Commit all three generated files alongside source/reference changes. The generator uses only the tracked reference, guides and examples. It adds no build timestamps or machine-specific output paths; source text is preserved. A repeated build from identical sources produces identical bytes. The checker verifies internal references and index positions; external guide links still require ordinary documentation review. Links between bundled guides and examples become docset references. Links to repository files that are not bundled are shown as source paths, without broken relative hyperlinks."))))
(:entry "guide/docs/EVENT-BINDINGS.md" :names ("docs/EVENT-BINDINGS.md" "EVENT-BINDINGS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-BINDINGS.md" :sections (("Guide" (:heading 1 "Command-event bindings") (:p "This C1 slice adds independent observer bindings on standalone " (:code "event-handler") " objects and borrowed window identities. It covers " (:code ":click") " (" (:code "wxEVT_BUTTON") "), " (:code ":text-change") " (" (:code "wxEVT_TEXT") "), " (:code ":toggle") " (" (:code "wxEVT_CHECKBOX") ") and " (:code ":selection") " (" (:code "wxEVT_CHOICE") "), using the wxWidgets 3.2.12 baseline. The bridge is ABI 29. Optional " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped contexts") " now support Skip/propagation; close-veto support is now available through the " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") ". Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify/command types") " now add named native tags and synchronous dispatch; native control-specific notify subclasses/session routing remain open.") (:heading 2 "Register and remove independent observers") (:code-block "lisp" "(defvar receiver (wxlambda:make-event-handler))
(defvar subscription
  (wxlambda:bind-event receiver :click
    (lambda (event)
      (format t \"Receiver ~S; command ID ~D~%\"
              (wxlambda:event-source event) (wxlambda:event-id event)))
    :id 40 :last-id 49))
(wxlambda:binding-active-p subscription) ; T
(wxlambda:queue-event receiver :click :id 42)
(wxlambda:process-pending-events)
(wxlambda:unbind-event subscription)     ; T
(wxlambda:unbind-event subscription)     ; NIL") (:p "Use these forms inside an active main-thread " (:code "with-application") " session. Every call to " (:code "bind-event") " returns a distinct opaque, read-only " (:code "event-binding") " value; " (:code "event-binding-p") " tests its type without consulting native state. There is no public constructor or callback-function slot on that value. Keep it to remove or query exactly that registration. Bindings may share a receiver, kind, ID filter and callback function; none replaces another binding.") (:p "An omitted/NIL " (:code ":id") " matches any command ID. A supplied ID matches exactly unless " (:code ":last-id") " specifies an inclusive range. IDs must fit signed 32-bit integers; " (:code "-1") " is reserved for native " (:code "wxID_ANY") ", represented by NIL in binding filters. " (:code ":last-id") " requires " (:code ":id") " and must be at least as large. Invalid registration releases its temporary Lisp roots. Native unbinding uses the exact receiver, event tag, ID range and native binding identity.") (:p (:code "unbind-event") " is safe from inside the binding's own callback or a peer callback. It returns T for an active removed registration, NIL after removal/receiver expiration. The current callback can finish, but removed callbacks cannot receive later deliveries. The native callback object stays alive until its current call returns. Relative callback order follows wxWidgets; no Lisp ordering guarantee is provided, including for bindings added during dispatch.") (:heading 2 "Observer and source semantics") (:p "Each observer callback takes one immutable " (:code "event") " snapshot. With " (:code ":with-context t") ", a generic callback instead receives " (:code "(snapshot context)") " and starts unskipped; it must explicitly set Skip to continue routing. Generic bindings and the control-specific " (:code "on-click") ", " (:code "on-text-change") ", " (:code "on-toggle") " and " (:code "on-selection") " callbacks are observers by default: their native hooks call " (:code "Skip") " after delivery, including when no control-specific callback is installed. Remaining matching native handlers and normal command-parent routing can therefore continue. The control-specific APIs still provide one replacement slot per control; generic registrations coexist independently and are removed with " (:code "unbind-event") ".") (:p "The default observer policy is unchanged. Contextual bindings can now consume commands and control Skip/propagation levels through borrowed, callback-scoped access. Veto is supported for current veto-capable close contexts and registered notify contexts. Native notify subclasses/session routing and native virtual overrides remain missing; do not infer full wxEvent coverage from these command APIs. " (:code "handler-enabled-p") " still controls only the receiving handler's own processing.") (:p (:code "event-source") " is the " (:b "Lisp receiver on which that callback was registered") ". For a parent binding that observes a child's command, it is the parent, not necessarily the native originating child. EVENT-ORIGIN-ID now reports a known bridge origin identity; arbitrary native origin-object wrapping remains unbound. " (:code "event-id") " copies the native command ID; it is not a globally unique event or native handle. Existing control-specific snapshots likewise carry their registered control as source. Snapshots and copied strings survive callbacks, unbinding and native receiver destruction, without requiring a session to read.") (:heading 2 "Queue copied synthetic events") (:code-block "lisp" "(wxlambda:queue-event receiver :text-change :id 42 :text \"Copied Unicode λ\")
(wxlambda:queue-event receiver :toggle :checked-p t)
(wxlambda:queue-event receiver :selection :selection 3)") (:p (:code "queue-event") " returns the supplied handler and queues a fresh " (:code "wxCommandEvent") " using " (:code "wxEvtHandler::QueueEvent") ". It works on exposed standalone handlers and windows, on the main thread only. " (:code ":id") " defaults to 0. " (:code ":text") " defaults to an empty string and applies only to text-change events; explicit UTF-8 byte counts preserve Unicode, empty strings and embedded NULs. Non-default payloads for the wrong kind are rejected. " (:code ":checked-p") " is a generalized boolean for toggles; " (:code ":selection") " is NIL (no selection) or a nonnegative signed-32-bit index.") (:p "Queuing only supplies event data: it does not change a text control's contents, checkbox state or choice selection. Use generic SETF properties to change those values and optionally notify. Synthetic selections are payload indices, not validated against a choice's items. Native origin override, arbitrary custom event classes, userData and worker-to-GUI dispatch are not implemented. Synthetic " (:code ":close") " events use a separate native event class and may run default frame closing; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close events") ".") (:heading 2 "Lifetime, errors and cleanup") (:p "Native weak references invalidate bindings when receivers disappear. Lisp roots for generic callbacks are reaped when RUN, a pump or a notifying setter returns, after explicit destruction, or when " (:code "binding-active-p") " is called. A closed window during a still-blocking RUN may retain roots until one of these boundaries or explicit unbinding. Session cleanup releases remaining bindings. This does not alter the control-specific callback-root rule: explicitly unbind those callbacks before destruction or they remain rooted until session cleanup.") (:p "Disposal requested during a native-to-Lisp callback marks the target identity invalid immediately and defers actual deletion through application " (:code "CallAfter") ". This lets native event and notifying-setter stacks return before their receiver is deleted. Descendants follow their actual parent/window destruction lifetime. Already queued events for a pending-disposal target cannot invoke its bindings. If the application exits before deferred deletion runs, session cleanup owns remaining native resources. Outside callbacks, owned-handler destruction remains immediate and windows retain their existing native destruction behavior.") (:p "Inactive sessions signal " (:code "native-error") " for registration, queuing, unbinding and liveness queries, including before native-library loading. Stale/deleting receivers reject operations; unbinding an expired registration returns NIL during the active session. Unsupported Lisp receiver types signal CLOS dispatch errors. Callback errors are contained at the native boundary and re-signaled after the native call returns; event-pump reentrancy is still rejected. Initializer rollback removes new generic registrations and callback roots across nested resources.") (:heading 2 "Runnable example and verification") (:p "The " (:ref "example/examples/event-bindings.lisp" "event-bindings example") " installs two observers on a standalone handler. A button queues an ID-42 notification; its reusable " (:code "exercise") " verifies that removing one subscription leaves the other:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-bindings.lisp \\
  --eval '(wxlambda-event-bindings:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-bindings.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-bindings.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover ID filters, duplicate registrations, all four payload kinds, text copying, self/peer unbinding, error recovery, disabled handlers, initializer rollback, parent/child observer routing and disposal during queued and synchronous setter callbacks. The API, guide and example are indexed in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Graphical Cadre and hosted-platform GUI verification remain separate checks.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound."))))
(:entry "guide/docs/EVENT-CATEGORIES.md" :names ("docs/EVENT-CATEGORIES.md" "EVENT-CATEGORIES") :kind :guide :kind-name "Guide" :summary "docs/EVENT-CATEGORIES.md" :sections (("Guide" (:heading 1 "Event-category metadata") (:p "ABI 29 adds EVENT-CATEGORY for saved immutable snapshots and current innermost contexts, plus EVENT-CATEGORY-MASK for compiled native category values. The coverage baseline is wxWidgets 3.2.12. Categories are numeric flags, not native type IDs, EVENT-ID routing values or EVENT-FAMILY keywords.") (:p "EVENT-CATEGORY reads/copies virtual GetEventCategory. Current supported command and notify-derived events report USER_INPUT; close/query-end/end-session events report UI. This follows the native class override even for registered synthetic command/notify tags; a synthetic event is not proof of actual user input. All generic and control-specific snapshots capture native category at callback entry and remain readable after native receiver/session cleanup.") (:p "EVENT-CATEGORY-MASK accepts :UI, :USER-INPUT, :SOCKET, :TIMER, :THREAD or :ALL. It loads the bridge and reads compiled native constants without creating an application or requiring an active GUI session. Native library/ABI loading can fail normally. Unknown keywords signal a Lisp error before native lookup. The five public bits in the pinned baseline are 1,2,4,8,16; use the lookup rather than hardcoding them. Combine flags with LOGIOR and test membership with LOGTEST.") (:p ":ALL is the actual compiled wxEVT_CATEGORY_ALL mask, including any internal bits. It is not necessarily the OR of only the five public category values. The pinned interface documentation shows 31, but the local 3.2.12 implementation header also includes internal UNKNOWN/CLIPBOARD bits and reports 127. Those internal names are not public bindings here. Likewise, the documentation interface omits the wxCommandEvent GetEventCategory override present in the implementation header. These discrepancies are retained as evidence for C7 public-interface reconciliation; they do not authorize binding undocumented implementation APIs.") (:code-block "lisp" "(logtest (wxlambda:event-category-mask :user-input)
         (wxlambda:event-category event))") (:p "No SETF writer is supplied: category is native virtual behavior, not a mutable base event field. No native override/subclass callback is introduced. Context reads require an active main-thread session and the innermost callback; expired or suspended outer contexts signal NATIVE-ERROR. Saved snapshots need no native session. Mask lookup is session-independent and does not pump events.") (:p "Run the isolated synthetic example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-categories.lisp --eval '(wxlambda-event-categories:start)'") (:p "Tests cover all seven built-in and registered command/notify kinds, each of the four convenience snapshot paths, saved values, nested/expired context isolation, invalid mask names and public-bit inclusion in the native ALL mask. No native socket/timer/thread events or real OS session events are generated. Category constants do not imply those event families are bound.") (:p "wxEventLoopBase::YieldFor and category-selective pumping remain unbound. Existing PROCESS-EVENTS/PROCESS-PENDING-EVENTS behavior is unchanged. Remaining C1 work includes typed tag mutation, origin retention, persistent event ownership/cloning, userData, pushed handlers, timer/idle and worker dispatch. Next design bounded registered-tag mutation using actual native class checks, retaining the session fallback isolation and rejecting incompatible native tag changes.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-METADATA.md" "metadata") ", " (:ref "guide/docs/EVENT-ORIGINS.md" "origin/type readers") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded."))))
(:entry "guide/docs/EVENT-CONTEXTS.md" :names ("docs/EVENT-CONTEXTS.md" "EVENT-CONTEXTS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-CONTEXTS.md" :sections (("Guide" (:heading 1 "Scoped native event contexts") (:p "This C1 slice adds borrowed " (:code "event-context") " values for native Skip and propagation control. Existing " (:code "event") " snapshots remain immutable Lisp-owned data. The bridge is ABI 29, using the wxWidgets 3.2.12 inventory baseline. Supported events now include four command kinds plus the " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") "; arbitrary classes and native notify subclasses/session routing remain open. Registered " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify types") " now support scoped Veto/Allow.") (:heading 2 "Opt into contextual callbacks") (:code-block "lisp" "(wxlambda:bind-event button :click
  (lambda (snapshot context)
    (format t \"Command ~D; native type ~D~%\"
            (wxlambda:event-id snapshot) (wxlambda:event-native-type snapshot))
    (setf (wxlambda:event-skipped-p context) t))
  :with-context t)") (:p "With " (:code ":with-context") " true, the callback takes two arguments: an immutable snapshot and a borrowed native-event context. " (:b "Contextual bindings begin unskipped") ": returning without setting Skip consumes the command at that handler. Callback return values do not determine routing. Set " (:code "(event-skipped-p context)") " true to continue to later native handlers and normal parent routing; set it false to consume. The generic writer returns the supplied generalized boolean, while the reader normalizes the native flag to T/NIL.") (:p "The default " (:code ":with-context nil") " remains an observer binding: its callback receives only a snapshot and the bridge automatically Skips afterwards. Control-specific " (:code "on-*") " callbacks also remain observers. Callback order is still governed by wxWidgets, with no Lisp ordering guarantee. A consuming contextual binding can prevent later observers from running, but cannot undo an earlier delivery. See " (:ref "guide/docs/EVENT-BINDINGS.md" "command binding and queue scope") ".") (:heading 2 "Propagation is separate from Skip") (:code-block "lisp" "(let ((previous-level (wxlambda:stop-event-propagation context)))
  (assert (not (wxlambda:event-propagates-p context)))
  ;; Restore the level when parent routing is wanted again.
  (wxlambda:resume-event-propagation context previous-level)
  (setf (wxlambda:event-skipped-p context) t))") (:p (:code "event-propagates-p") " maps to " (:code "wxEvent::ShouldPropagate") ": it tests whether the native propagation level is positive. " (:code "stop-event-propagation") " sets that level to zero and returns its previous value. " (:code "resume-event-propagation") " restores a nonnegative signed-32-bit level and returns the supplied context. Zero is allowed. Invalid levels signal a Lisp type error.") (:p "Neither operation changes Skip. Stop plus Skip true allows later handlers on the current receiver while preventing parent propagation. A positive propagation level alone does not forward a consumed event. This exposes native command propagation behavior, not a complete propagation/filter/handler-chain API.") (:heading 2 "Exact borrowed lifetime") (:p "Contexts have private immutable tokens, not native pointers. They have no public constructor and cannot be used to construct or clone native events. A native scope registry validates both the token and callback depth before every access. Only the " (:b "currently executing innermost native-to-Lisp callback") " can use its own context. A nested contextual callback suspends outer access. A nested observer or control-specific callback also suspends outer access, even though it receives no context of its own. After the nested callback returns, the outer context is usable again until its own callback returns.") (:p (:code "event-context-p") " only tests the Lisp value's type; it needs no session and remains true for an expired value. " (:code "event-context-active-p") " returns T for the currently usable context and NIL for suspended/expired contexts in an active session. Outside a session, the activity query signals " (:code "native-error") ". All native readers, writers and propagation actions reject suspended or expired contexts with " (:code "native-error") " rather than dereferencing an old event pointer.") (:p "The context expires on callback return, including after a callback condition. Errors are contained and re-signaled using the existing native boundary; native event mutations are not rolled back. Unbinding the current registration or requesting deferred receiver disposal does not expire its still-running context: the native event remains on the dispatch stack until return. Event-pump reentrancy continues to be rejected. All operations require the active main-thread session; worker-thread context access is not supported.") (:p "Keep the snapshot to inspect data after return. Do not keep a context expecting to mutate the event later. The snapshot's source remains the binding receiver, not necessarily the native originating child. General native origin-object wrapping and origin/type mutation, userData, arbitrary event classes and native virtual overrides remain open. Veto is available for current vetoable close contexts and registered notify contexts; plain command kinds do not provide veto state. See " (:ref "guide/docs/CLOSE-EVENTS.md" "close semantics") ".") (:heading 2 "Native event type values") (:p (:code "event-native-type") " reads a copied native " (:code "wxEventType") " integer from any current supported snapshot, including observer/control-specific callbacks:") (:code-block "lisp" "(= (wxlambda:event-native-type snapshot)
   (wxlambda:event-type :click))") (:p "The lookup accepts " (:code ":click") ", " (:code ":text-change") ", " (:code ":toggle") ", " (:code ":selection") " and " (:code ":close") ", or a registered command/notify name, and requires an active main-thread session. Saved snapshot integers can be read without a session. These are process-local runtime IDs; do not serialize them as stable type identifiers or compare IDs from different processes. " (:code "event-kind") " retains the supported portable keywords. This is bounded native type-value introspection, not custom type registration or arbitrary numeric-type binding. The old " (:code "command-event-type") " name was removed when the non-command close family was added.") (:heading 2 "Example and checks") (:p "The " (:ref "example/examples/event-contexts.lisp" "event-contexts example") " uses a checkbox to decide whether a contextual button callback forwards commands to its parent:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-contexts.lisp \\
  --eval '(wxlambda-event-contexts:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-contexts.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-contexts.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Its reusable " (:code "exercise") " runs the actual callback, checks forwarding/consumption, native type copying and scope expiration, and cleans up bindings and windows. Focused tests additionally cover stop/resume, suspended outer contexts across all three callback modes, stale readers/writers, callback conditions, self-unbinding and deferred disposal. The API, this guide and the example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted-platform GUI and graphical Cadre verification remain separate checks.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " adds copied/current timestamps and command classification, bounded timestamp SETF and close-family CanVeto SETF.") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects."))))
(:entry "guide/docs/EVENT-HANDLERS.md" :names ("docs/EVENT-HANDLERS.md" "EVENT-HANDLERS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-HANDLERS.md" :sections (("Guide" (:heading 1 "Event-handler ownership and lifetime") (:p "This C1 foundation slice introduces " (:code "event-handler") ", a native-backed CLOS wrapper for " (:code "wxEvtHandler") " and the superclass of " (:code "window") ". It establishes ownership and state before generic binding/unbinding, timers and broader event routing. The coverage baseline is wxWidgets 3.2.12; current native ABI is 16. Four command-event observer kinds now have " (:ref "guide/docs/EVENT-BINDINGS.md" "independent bindings") ".") (:heading 2 "Owned standalone handlers") (:code-block "lisp" "(defclass named-handler (wxlambda:event-handler)
  ((name :initarg :name :reader name))
  (:default-initargs :name \"worker-results\"))

(defvar handler (wxlambda:make-event-handler :class 'named-handler))
(wxlambda:handler-alive-p handler)           ; T
(setf (wxlambda:handler-enabled-p handler) nil)
(wxlambda:handler-enabled-p handler)         ; NIL
(wxlambda:destroy-event-handler handler)     ; T
(wxlambda:handler-alive-p handler)           ; NIL in this active session") (:p "Use these forms inside " (:code "with-application") ". Direct " (:code "make-instance") " is supported; subclass slot initargs, defaults and AFTER hooks work normally. A subclass AFTER hook can read native state. No native initargs are currently exposed on the standalone base. The thin keyword-only factory forwards subclass initargs and accepts a class symbol or class object, rejecting window and non-handler classes.") (:p "The session owns each standalone native handler. Explicit destruction deletes it immediately outside callbacks. During callbacks the target is invalidated and native deletion is deferred until its dispatch/setter stack returns; any remaining standalone handlers are deleted during session cleanup, before native application exit. Dropping a Lisp wrapper does not delete its native object: no GC finalizer is installed. Failed managed initialization rolls back native handlers/windows allocated in that initialization and releases callback roots, preserving the original condition or nonlocal exit.") (:p "Repeated explicit destruction is an error. Reads/writes on destroyed handlers signal " (:code "native-error") ", except " (:code "handler-alive-p") ", which returns NIL for a stale native identity during an active session. Failed/uninitialized wrappers have no handle and signal " (:code "native-error") ". All three operations require an active session; after session cleanup even the liveness query signals " (:code "native-error") ".") (:heading 2 "Borrowed window identities") (:p "Every concrete window inherits " (:code "event-handler") ". It uses its existing " (:code "wxWindow") " as the native " (:code "wxEvtHandler") " base, allocating " (:b "one native widget") ", with no second standalone handler. Existing window construction, subclass defaults and AFTER hooks remain unchanged. The window is still owned according to its window/parent lifetime. " (:code "destroy-event-handler") " rejects window wrappers; use " (:code "destroy-window") " and the existing parent-ownership rules. The raw bridge enforces this distinction.") (:p "This interface refers to the window's own native base identity. It does not wrap an arbitrary " (:code "GetEventHandler()") " chain, push/pop handlers, transfer ownership or allow supplied native handles. The base " (:code "window") " class remains abstract.") (:heading 2 "Event processing versus window input") (:code-block "lisp" "(assert (typep button 'wxlambda:event-handler))
(setf (wxlambda:handler-enabled-p button) nil)
(wxlambda:handler-enabled-p button) ; NIL: its handler skips processing
(wxlambda:enabled-p button)         ; window input state is unchanged") (:p (:code "handler-enabled-p") " reads " (:code "wxEvtHandler::GetEvtHandlerEnabled") "; its canonical generic SETF writer calls " (:code "SetEvtHandlerEnabled") ", normalizes a generalized boolean and returns the supplied value. This is the own event-processing flag, separate from " (:code "enabled-p") " and ancestor input state. It does not grey out a control, synthesize a command event or promise to suppress processing elsewhere in a native handler chain or parent propagation route. Native wxWidgets routing rules still apply.") (:p "Disabling event processing can suppress " (:code "wxEVT_DESTROY") " delivery. Native window lookup therefore also uses weak tracking, independent of that event, before dereferencing a pointer. Destruction invalidates the window and child identities even if their handlers are disabled. The existing native destroy hook removes ordinary registry entries; dead weak entries may remain until session cleanup but cannot be dereferenced. This is internal tracking, not a public " (:code "wxWeakRef") " wrapper.") (:p "All operations are restricted to the main-thread GUI session. Callback roots for the existing control-specific handlers still require explicit unbinding before window destruction, or they remain rooted until session cleanup. Standalone handlers, windows and the borrowed application view support built-in and registered command/notify observer kinds, ID filters, safe generic unbinding and copied synthetic queues; see " (:ref "guide/docs/EVENT-BINDINGS.md" "command-event bindings") ". Arbitrary event types, borrowed window/app chains and pushed handler ownership, filters, derived notify/session event classes, timer/idle handlers, worker dispatch and native virtual overrides remain open C1 work. " (:ref "guide/docs/EVENT-CONTEXTS.md" "Scoped contexts") " provide Skip/propagation for supported built-in and registered kinds, plus checked close/notify veto, without making saved snapshots mutable. Immutable event snapshots retain their existing contract.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/event-handlers.lisp" "event-handlers example") " constructs a handler subclass with native state read in its AFTER hook. Separate window callbacks toggle a target button's own event-processing flag. The button stays enabled for input while its callback is gated:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-handlers.lisp \\
  --eval '(wxlambda-event-handlers:start)'") (:p "Its " (:code "exercise") " runs those same callbacks, verifies event counts and restores the handler state before unbinding and destroying resources. The focused scenario also verifies factories/class objects, slots/defaults, initializer rollback, borrowed-destruction errors, stale handles and disabled-parent/child destruction:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/event-handlers.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/event-handlers.lisp
python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Rebuild the ABI 29 bridge alongside the bindings. The GUI runner includes this scenario; broader platform and graphical Cadre verification remain separate. The API, this guide and example are included in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ").") (:p "The non-command " (:ref "guide/docs/CLOSE-EVENTS.md" "close family") " now supports checked scoped veto and real frame close requests; standalone handlers can receive synthetic close events.") (:p "Registered command/notify names and synchronous " (:code "process-event") " extend the standalone/window interface; see " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify payload and dispatch scope") ".") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session bindings and logging-off metadata are available; real OS delivery remains unverified.") (:p (:ref "guide/docs/SESSION-EVENTS.md" "Session events") " extend the close family with query/end-session kinds, scoped logging-off metadata and isolated synthetic dispatch. Native OS session delivery remains unverified.") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending-event operations") " now distinguish GUI post copies, consuming native transfer, local copy processing and non-application target cancellation. Per-handler pending processing and application-wide cancellation remain unbound.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Managed standalone chains") " now have canonical peer access, reciprocal SETF joins/splits and explicit unlink. Window/application sources and peers remain excluded; native ownership stays with the session.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. Event/client/ userData and item-pointer ownership remain separate unbound APIs."))))
(:entry "guide/docs/EVENT-METADATA.md" :names ("docs/EVENT-METADATA.md" "EVENT-METADATA") :kind :guide :kind-name "Guide" :summary "docs/EVENT-METADATA.md" :sections (("Guide" (:heading 1 "Event metadata and mutable CanVeto") (:p "Native bridge ABI 29 adds EVENT-TIMESTAMP and EVENT-COMMAND-P readers for immutable snapshots and current innermost event contexts. EVENT-TIMESTAMP also has a context-only SETF writer. EVENT-CAN-VETO-P now has a context-only SETF writer for wxCloseEvent: window-close, query-end-session and end-session events. The baseline is wxWidgets 3.2.12. These extend existing native event views; they do not create persistent mutable native event objects.") (:heading 2 "Timestamp and command classification") (:p "EVENT-TIMESTAMP returns the native signed C long timestamp, widened without loss across the ABI. wxWidgets describes it as milliseconds since a fixed moment, not necessarily the Unix epoch; do not convert it to a calendar date. Native documentation warns that nonzero timestamps are normally supplied only for mouse/key events, which this bridge does not yet bind. Synthetic supported events start at zero. Negative values, including -1, are valid metadata and do not double as native error sentinels.") (:p "SETF accepts a signed native C long integer (32 bits on Windows; typically 64 bits on 64-bit Unix). Lisp validation uses CFFI's native LONG size; native validation repeats the range check before narrowing the fixed-width ABI value. Out-of-range or non-integer values signal TYPE-ERROR. Changing a timestamp only changes metadata: it neither schedules nor delays delivery. Synthetic queue and process calls have no timestamp initialization keyword; change it in a current context if needed.") (:p "EVENT-COMMAND-P copies/reads native IsCommandEvent. It is true for command and notify-derived events and false for close-family events. It is read-only; there is no classification writer or native event-class replacement.") (:heading 2 "CanVeto is mutable native metadata") (:p "SETF EVENT-CAN-VETO-P maps directly to wxCloseEvent::SetCanVeto. It accepts a generalized boolean and returns the supplied value. It can change false to true, including an event that began non-vetoable. Every subsequent SETF EVENT-VETOED-P still checks the *current* CanVeto flag before invoking Veto. No CanVeto writer exists for snapshots or notify/command contexts; live access on those non-close contexts rejects with NATIVE-ERROR. Notify veto capability is intrinsic and cannot be changed by SetCanVeto.") (:p "Native GetVeto is CanVeto AND the stored veto bit. Setting CanVeto false hides an existing veto without clearing that bit; setting it true again exposes the stored veto. Explicitly clear veto while CanVeto is true if that is the intended policy. A forced close starts with CanVeto false, but code that explicitly changes this flag can change the result observed by native closing logic. The flag is not proof that the OS permits cancelling shutdown; changing event metadata does not change OS intent or guarantee that a veto will be honored.") (:p "Snapshots capture each callback's pre-callback timestamp, command classification and CanVeto/veto state. Changes through a live context do not alter a snapshot already captured. Later callbacks can capture changed native metadata. Native callback ordering remains wxWidgets behavior, not a Lisp ordering guarantee. All native reads/writes require the active main-thread session and the innermost current context. Expired or suspended outer contexts signal NATIVE-ERROR; saved snapshot readers need no native session and remain usable after cleanup.") (:code-block "lisp" "(wxlambda:bind-event receiver :close
  (lambda (event context)
    (assert (not (wxlambda:event-command-p event)))
    (setf (wxlambda:event-timestamp context) 123
          (wxlambda:event-can-veto-p context) t
          (wxlambda:event-vetoed-p context) t))
  :with-context t)") (:p "Run the isolated synthetic example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-metadata.lisp --eval '(wxlambda-event-metadata:start)'") (:p "The regression covers all seven built-in and both registered families, native LONG extremes and negative timestamps, malformed/range errors, immutable snapshots, later snapshot capture, stored-veto hiding/restoration, non-close writer rejection and nested/expired context isolation. It does not emit real OS session events or claim hosted Windows/Linux runtime verification.") (:p "Native origin/type mutation, persistent event ownership/cloning, userData, derived notify classes, pushed handlers, mouse/key, timer/idle and worker dispatch remain required C1 work. Next consider native type/origin access and broader event ownership.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-ROUTING.md" "Scoped event IDs") " now provide current ID reads/SETF and document effects on later matching. Snapshots remain immutable.") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects."))))
(:entry "guide/docs/EVENT-ORIGINS.md" :names ("docs/EVENT-ORIGINS.md" "EVENT-ORIGINS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-ORIGINS.md" :sections (("Guide" (:heading 1 "Native event type and origin identity") (:p "ABI 29 extends EVENT-NATIVE-TYPE to a generic reader for immutable snapshots and current innermost contexts. EVENT-ORIGIN-ID is a new generic reader with the same saved/current lifetime distinction. Baseline: wxWidgets 3.2.12.") (:p "EVENT-NATIVE-TYPE returns the actual process-local native type integer from GetEventType. Compare it with EVENT-TYPE during the active session; registry names expire at cleanup, while saved integer metadata remains readable. Type numbers are not stable serialized IDs or authority to cast native objects. A bounded " (:ref "guide/docs/EVENT-TAGS.md" "registered-tag writer") " now exists for native type; origin now has bounded " (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "clear-only detachment") ". Changing a type tag does not change the native C++ event class, so unvalidated type mutation could make native handlers cast incompatible storage. Unrestricted mutation remains unbound; the registered-tag writer checks both registry families and actual native class.") (:p "EVENT-ORIGIN-ID returns a positive opaque bridge identity if GetEventObject matches a currently registered application, owned handler or tracked window. It returns NIL for null or untracked origins; it does not distinguish those two cases. The bridge compares pointer identities without dereferencing the origin. This is not a general wxObject wrapper, native pointer, native window ID or EVENT-ID value. It cannot be passed as a public receiver or used to reconstruct a wrapper. It transfers no ownership and makes no liveness guarantee. A pending destruction object can still have a captured origin identity. Lookup reflects the registry at capture/read time, not a historical reconstruction of arbitrary native pointer lifetimes.") (:p "EVENT-SOURCE remains the Lisp receiver on which the callback was registered. A child command observed on its parent has the parent as EVENT-SOURCE, but its native origin identity can still identify the child. The origin ID alone does not tell you the originating object's class. Synthetic events use their initial receiving handler as native origin; parent forwarding does not change it. Each generic and control-specific callback copies origin metadata independently. Already captured snapshots remain unchanged after later dispatch or source cleanup. Saved integer type/origin metadata requires no GUI session.") (:p "Context reads require an active main-thread session and the innermost callback. Expired or suspended outer contexts signal NATIVE-ERROR. No native event pointer escapes. There is no new-origin setter or retention/pinning protocol yet; using a borrowed object as native origin would require explicit lifetime rules. Unsupported/untracked objects remain a coverage gap, rather than being silently wrapped or adopted.") (:p "Run the example, which compares child and parent observations, checks current native type and cleans up its bindings/windows:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-origins.lisp --eval '(wxlambda-event-origins:start)'") (:p "Regression checks cover all supported kinds, registered command/notify types, standalone/application origin identity, child/parent receiver distinctions, context expiration/suspension and saved reads after cleanup. Null/untracked native-origin lookup is bounded to NIL by implementation; the public synthetic API always supplies a known receiver and cannot manufacture arbitrary native origin pointers. Real OS session events are not emitted.") (:p "GetEventObject coverage is partial: generic wxObject wrappers, origin retention, full SetEventObject, arbitrary SetEventType, userData and broader native event ownership/cloning remain C1 work. Bounded owned-event/cloning, registered tags, clear-only origins and category metadata are now bound. Next design typed mutation/ownership contracts that preserve native storage compatibility and session isolation. Existing read-only type lookups must not become an unchecked route to native tag mutation.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/EVENT-ROUTING.md" "ID routing") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-CATEGORIES.md" "Event categories") " now provide saved/current native category flags and compiled keyword mask lookup, including the actual native ALL mask. Selective pumping remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open."))))
(:entry "guide/docs/EVENT-ROUTING.md" :names ("docs/EVENT-ROUTING.md" "EVENT-ROUTING") :kind :guide :kind-name "Guide" :summary "docs/EVENT-ROUTING.md" :sections (("Guide" (:heading 1 "Scoped event IDs and routing") (:p "ABI 29 extends EVENT-ID to a generic reader for saved immutable snapshots and current innermost contexts. Context-only SETF maps wxEvent::SetId. Supported scope is the existing seven built-in kinds and registered command/notify types, using the wxWidgets 3.2.12 baseline. No native event ownership is transferred.") (:p "SETF accepts signed 32-bit integers and returns the assigned integer. Native GetId uses status plus a separate output, so -1 is a valid ID rather than an error sentinel. Non-integer/out-of-range assignments signal TYPE-ERROR before FFI. Direct SetId accepts -1 as native metadata. Binding filters and initial synthetic IDs still reserve -1: use NIL for an unfiltered binding, and another initial ID for QUEUE-EVENT/PROCESS-EVENT. A mutated event ID of -1 does not make all exact filters match; an unfiltered binding still matches any event ID.") (:p "Changing an event ID affects later native matching against that event, including parent exact-ID and inclusive-range filters. It does not change the native window's own ID, change binding filters, restart dispatch or re-run handlers already visited. A consuming contextual callback still stops normal delivery; set EVENT-SKIPPED-P true when forwarding is intended. Native propagation rules still apply. Do not use ID mutation as a substitute for explicit Skip/propagation policy. This API does not promise local handler callback order.") (:p "A snapshot captures the ID before its callback. Mutating the context never changes an earlier snapshot. A later callback can capture the new ID; EVENT-SOURCE remains the Lisp receiver on which that callback was registered, not a newly inferred native origin. Saved snapshots remain readable after source/session cleanup. There is no snapshot writer. Native context access requires an active main-thread session and the innermost current callback; expired or suspended outer contexts signal NATIVE-ERROR.") (:code-block "lisp" "(wxlambda:bind-event child :routed-command
  (lambda (event context)
    (assert (= 10 (wxlambda:event-id event)))
    (setf (wxlambda:event-id context) 42
          (wxlambda:event-skipped-p context) t))
  :id 10 :with-context t)
;; A parent binding filtered to ID 42 can now match the forwarded event.") (:p "The complete runnable example constructs the child/parent, registers the custom command, verifies both snapshots and releases its bindings/windows:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-routing.lisp --eval '(wxlambda-event-routing:start)'") (:p "The regression verifies signed bounds and -1, malformed assignments, all existing event families, unchanged snapshots, nested-context suspension and expiration, parent exact/range/wildcard matching, consumption and queued delivery. It does not generate native OS logout/shutdown events. Synthetic session events retain their isolated owned-handler restrictions.") (:p "Native type mutation, origin access/mutation, categories/userData, persistent event ownership/cloning, derived notify classes, pushed handlers, timer/idle and worker dispatch remain C1 work. Next define safe native type/origin contracts; a type tag must never authorize casting an incompatible native event object.") (:p "Build/check using " (:code "python3 tools/docset.py build") " and " (:code "check") "; install using " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "contexts") ", " (:ref "guide/docs/EVENT-METADATA.md" "metadata") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/EVENT-ORIGINS.md" "Native origin/type readers") " now distinguish captured origin identity from binding receiver and provide current native type access; origin/arbitrary-tag writers and general wxObject wrappers remain open.") (:p (:ref "guide/docs/EVENT-TAGS.md" "Registered-tag mutation") " now supports same-family SETF with actual native class checks; built-in/session tags and origin writes remain excluded."))))
(:entry "guide/docs/EVENT-TAGS.md" :names ("docs/EVENT-TAGS.md" "EVENT-TAGS") :kind :guide :kind-name "Guide" :summary "docs/EVENT-TAGS.md" :sections (("Guide" (:heading 1 "Bounded registered event-tag mutation") (:p "ABI 29 adds context-only SETF EVENT-NATIVE-TYPE. The reader still returns the captured/current native type integer; assign an integer returned by EVENT-TYPE for a name registered in the active session. Baseline: wxWidgets 3.2.12.") (:p "Both the current native tag and target must be registered command/notify tags. The registry families must match, and native dynamic class checks must confirm wxCommandEvent without wxNotifyEvent for command tags, or wxNotifyEvent for notify tags. A changed tag never changes native C++ storage/class. Built-in sources and targets reject, even if the apparent family matches. Window-close and both OS session tags cannot be assigned or changed by this writer. These restrictions preserve native cast compatibility and isolated synthetic session fallback. Arbitrary native type mutation remains a coverage gap.") (:p "SETF accepts signed32 integers, validates registration/family/class natively and returns the supplied integer. Unknown/built-in/cross-family types signal NATIVE-ERROR before mutation; malformed/out-of-range values signal TYPE-ERROR. Assigning the current registered type is allowed. A failed write leaves the native tag unchanged. Snapshot SETF has no method. Native reads/writes require the active main-thread session and innermost callback; expired or suspended outer contexts signal NATIVE-ERROR.") (:p "Each callback snapshot reflects the actual current supported native tag, not an assumption that it still equals the binding's registered kind. Earlier snapshots retain their original EVENT-KIND and EVENT-NATIVE-TYPE. Binding identities and Unbind retain their original registration tag. Changing a tag does not rebind, restart dispatch or guarantee which remaining local callbacks will run. Native dynamic/static lookup can match tags at different points; local callback order is not a Lisp API promise. Explicit Skip and normal propagation rules still control whether the event continues. A parent searches the changed tag when it receives a forwarded command.") (:code-block "lisp" "(wxlambda:bind-event child :raw-tag
  (lambda (event context)
    (assert (eq :raw-tag (wxlambda:event-kind event)))
    (setf (wxlambda:event-native-type context)
          (wxlambda:event-type :translated-tag)
          (wxlambda:event-skipped-p context) t))
  :with-context t)
;; Both names must have been registered with :family :command.") (:p "Text/integer, ID, timestamp, category, native class and origin are unchanged by the writer. Notify veto behavior remains available after a same-family change; PROCESS-EVENT copies the final native veto state. Type values are process-local, not stable serialized IDs. Saved snapshots remain readable after registry/session cleanup and confer no native cast or object-lifetime authority.") (:p "Run the example, which registers both command tags and verifies changed-tag parent delivery for synchronous and queued dispatch, then cleans up:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/event-tags.lisp --eval '(wxlambda-event-tags:start)'") (:p "Regression checks cover command/notify changes, built-in/session/cross-family and unknown targets, bad integers, failed-write preservation, immutable snapshots, nested/expired contexts and payload-preserving parent delivery. Public APIs cannot manufacture an incompatible native object carrying a registered tag, so the actual-class rejection branch is statically reviewed rather than directly exercised. Tests do not impose local callback order or emit real OS session events.") (:p "SetEventType coverage remains partial. Native origin retention/SetEventObject, generic wxObject wrappers, persistent native event ownership/cloning, userData, pushed handlers and broader event families remain C1 work. Next define the ownership/lifetime policy needed for origin writes and persistent events before exposing borrowed native object pointers or widening mutable tags.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-ORIGINS.md" "type/origin readers") ", " (:ref "guide/docs/EVENT-ROUTING.md" "ID routing") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open."))))
(:entry "guide/docs/GAUGE.md" :names ("docs/GAUGE.md") :kind :guide :kind-name "Guide" :summary "docs/GAUGE.md" :sections (("Guide" (:heading 1 "Progress gauges") (:p (:code "gauge") " is a native-backed CLOS " (:code "window") " subclass for " (:code "wxGauge") ", using the wxWidgets 3.2.12 coverage baseline. Construct it directly or through the thin " (:code "make-gauge") " factory:") (:code-block "lisp" "(defclass progress (wxlambda:gauge)
  ((job :initarg :job :reader job))
  (:default-initargs :range 100 :value 0))

(defvar progress
  (wxlambda:make-gauge panel :class 'progress :job :download
                       :orientation :horizontal))
(setf (wxlambda:gauge-value progress) 25)
(setf (wxlambda:gauge-range progress) 200)
(wxlambda:gauge-value progress)       ; 25
(wxlambda:gauge-range progress)       ; 200
(wxlambda:gauge-vertical-p progress)  ; NIL") (:p "PARENT is required. RANGE defaults to 100 and must be a positive signed 32-bit integer. VALUE defaults to zero and must be between zero and RANGE, inclusive. ORIENTATION defaults to " (:code ":horizontal") "; " (:code ":vertical") " is also supported, with no orientation writer. These restrictions are checked before passing invalid values to wxWidgets. Lisp type/range checks signal " (:code "type-error") "; a value above the current range signals " (:code "native-error") ". Invalid assignments preserve state.") (:p "The canonical writers are generic " (:code "(setf gauge-value)") " and " (:code "(setf gauge-range)") "; both return the supplied integer. Reducing a range clamps existing progress to the new maximum. Increasing it preserves progress. Range assignment calls " (:code "SetRange") " followed by " (:code "SetValue") " to restore determinate mode consistently. This explicit clamping policy is part of the Lisp binding contract.") (:p "For work with an unknown completion fraction:") (:code-block "lisp" "(wxlambda:pulse-gauge progress) ; returns PROGRESS
;; Call periodically while processing GUI events.
(setf (wxlambda:gauge-value progress) 50) ; resume determinate progress") (:p (:code "pulse-gauge") " maps to " (:code "wxGauge::Pulse") "; animation and progress readings while pulsing are platform-dependent. Neither reading the value nor changing the range after a pulse measures completed work. Assign an explicit value to resume measured progress. Pulsing does not provide a timer or thread dispatch, and it does not make blocking work responsive. Gauges emit no command events here.") (:p "The inherited layout, visibility, enabled state, logical name and destruction operations work on gauges. Native ownership stays with the parent; destroyed handles are invalid. All operations require an active main-thread GUI session. Subclass slot initargs, defaults and AFTER hooks work as described in the " (:ref "guide/docs/CLOS-API.md" "CLOS guide") ", including rollback when initialization fails.") (:p "This slice binds " (:code "wxGauge") " construction, " (:code "GetValue") ", " (:code "SetValue") ", " (:code "GetRange") ", " (:code "SetRange") ", " (:code "IsVertical") " and " (:code "Pulse") ". The constructor fixes ID to " (:code "wxID_ANY") ", position/size to native defaults and validator/name to native defaults; styles are limited to horizontal/vertical. Two-step creation, custom IDs, additional styles such as taskbar progress, and the remaining inherited API stay open. Gauge support was introduced in native ABI 10. Registered event dispatch now requires ABI 29; rebuild the bridge alongside the current Lisp bindings.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/gauge.lisp" "gauge example") " uses a subclass with a custom step slot. It keeps completed work in a Lisp slot so the advance button resumes from measured progress after a pulse, independent of native animation readings. Buttons advance/restart progress and request indeterminate pulsing:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/gauge.lisp \\
  --eval '(wxlambda-gauge:start)'") (:p "Its " (:code "exercise") " runs those same callbacks, restores determinate mode and cleans up handlers and windows. The focused test runs it and verifies orientations, factory/subclass initargs, range clamping, invalid arguments, native type checks, initialization rollback, inherited operations and stale/session handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/gauge.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/gauge.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. The complete scenario runner also includes " (:code "gauge") ". See " (:ref "guide/docs/DOCSET.md" "docset installation") " to install the API, this guide and the example under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre."))))
(:entry "guide/docs/HANDLER-CHAINS.md" :names ("docs/HANDLER-CHAINS.md" "HANDLER-CHAINS") :kind :guide :kind-name "Guide" :summary "docs/HANDLER-CHAINS.md" :sections (("Guide" (:heading 1 "Managed standalone event-handler chains") (:p "ABI 29 adds NEXT-HANDLER, PREVIOUS-HANDLER, HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER for session-owned standalone EVENT-HANDLER objects and subclasses. The two peer properties have generic SETF writers. The baseline is wxWidgets 3.2.12. Borrowed window/application sources and peers reject these operations; dedicated managed " (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "window stack APIs") " now cover Push/Pop/Remove while preserving bridge ownership. General standalone peer operations still exclude attached/borrowed window chains.") (:heading 2 "Canonical peers and native ownership") (:p "NEXT-HANDLER and PREVIOUS-HANDLER return the existing managed Lisp peer, or NIL for a vacant endpoint. Repeated lookup is EQ to the original wrapper, including subclasses and their slot state. These are wrapper references, not native pointer values or reconstructed objects. HANDLER-UNLINKED-P is true only when both peer links are NIL.") (:p "The session strongly roots standalone wrappers in a canonical identity map until explicit destruction, failed-construction rollback or session cleanup. This is true even for unlinked handlers: dropping application references does not make a new wrapper appear on lookup or destroy native state. Native ownership remains in the session registry; linking does not adopt, transfer or parent a handler. There is no GC finalizer. Native fields remain available in subclass AFTER hooks and constructor rollback removes canonical registrations and native resources. It does not undo arbitrary edits made to pre-existing external chains. Removing a failed node invokes native Unlink, which can leave surviving prefix/suffix segments joined. Resource cleanup is not a graph-state transaction.") (:p "Reads require the active main-thread session and valid non-deleting standalone handles, but are permitted during callbacks. Outside-session and stale/pending native access signal NATIVE-ERROR. Window/application receivers and peers signal NATIVE-ERROR before mutation rather than exposing a borrowed native chain.") (:heading 2 "Reciprocal linking and splitting") (:p "The Lisp SETF protocol preserves both directions of each edge. It is deliberately stronger than calling one raw native setter and leaving the other link stale.") (:code-block "lisp" "(wxlambda:with-application ()
  (let ((first (wxlambda:make-event-handler))
        (middle (wxlambda:make-event-handler))
        (last (wxlambda:make-event-handler)))
    (unwind-protect
         (progn
           (setf (wxlambda:next-handler first) middle
                 (wxlambda:next-handler middle) last)
           (assert (eq first (wxlambda:previous-handler middle)))
           (wxlambda:unlink-event-handler middle)
           (assert (eq last (wxlambda:next-handler first)))
           (assert (wxlambda:handler-unlinked-p middle)))
      (dolist (handler (list first middle last))
        (wxlambda:destroy-event-handler handler)))))") (:p "Setting NEXT-HANDLER joins the source's vacant next endpoint to the peer's vacant previous endpoint; setting PREVIOUS-HANDLER is the mirror operation. Existing segments can be joined at compatible vacant endpoints. Repeating an already reciprocal pair is idempotent. Self-links, cycles, occupied conflicting endpoints and invalid peers reject before changing either chain. SETF returns the supplied peer wrapper.") (:p "The pinned interface text says native SetNextHandler/SetPreviousHandler cannot receive NULL, but the implementation setters permit pointer clearing and native Unlink uses the same paired clearing pattern. Lisp NIL is a bounded reciprocal detach operation, not an exposed one-sided null setter. Retain this interface/ implementation discrepancy for C7 reconciliation.") (:p "SETF NIL detaches just that edge and its reciprocal link, splitting a chain into two segments; it returns NIL. It does not remove the source from both neighbors. UNLINK-EVENT-HANDLER instead splices the source's previous and next neighbors together and leaves the source detached and alive, returning the source handler. Unlinking an already detached handler is harmless.") (:p "All mutations require a non-dispatch boundary: RUN, native pumps and callbacks reject linking, edge detachment and UNLINK, even if the requested change would be idempotent. Read peers during a callback and schedule structural changes for after dispatch instead. No new asynchronous mutation scheduler is supplied. Attached pushed nodes also reject general peer reads/SETF/UNLINK; HANDLER-UNLINKED-P can report false. Use the window stack APIs to inspect or detach those nodes.") (:heading 2 "Dispatch and lifetime") (:p "Normal processing, native pending delivery and PROCESS-EVENT-LOCALLY now traverse these standalone native chains using wxWidgets rules. An observer Skips, so a following node can run. A consuming contextual callback can stop local chain handling. Disabling a node's HANDLER-ENABLED-P skips its own handling without disabling following nodes. Skip, parent propagation and local chain traversal remain distinct native mechanisms; STOP-EVENT-PROPAGATION is not a promised replacement for consuming a chain event.") (:p "Each snapshot's EVENT-SOURCE is the wrapper on which that callback was registered. It can be a downstream handler while EVENT-ORIGIN-ID still identifies the original delivery receiver. Callback modifications remain subject to native matching and snapshot immutability; native node traversal follows the next-link chain, but linking does not promise callback registration order within an individual node.") (:p "Destroying a linked handler during a callback rejects before native deletion so the active chain is not edited under native traversal. Destroying an unlinked handler from a callback keeps the existing deferred-destruction behavior. Outside callbacks, native handler destruction unlinks/splices a linked node; its neighbors remain alive and reciprocal. Explicit UNLINK never destroys the node. Session cleanup removes bindings, canonical roots and remaining native handlers safely.") (:p "Pending queues belong to their target handler, not to every node that might later observe an event through a chain. DELETE-PENDING-EVENTS deletes only its receiver's own queue. It does not cancel upstream queued events merely because they might later traverse that node. Linking/unlinking does not move queued objects between queues. Destination destruction and consuming TRANSFER-EVENT retain their existing ownership rules.") (:p "Session tags remain isolated from wxApp fallback. Managed chains cannot include a borrowed application/window handler, and standalone session fallback remains blocked. Native chain support does not authorize synthetic OS session delivery, window pushed-handler ownership or arbitrary native chain edits.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-chains.lisp --eval '(wxlambda-handler-chains:start)'") (:p "Validation should cover reciprocal/canonical peers, segment joining/splitting, cycle/occupied-endpoint rejection without mutation, unlink/destructor splicing, Skip/consumption/disabled-node delivery, pending/local dispatch, callback mutation rejection and constructor rollback. Local results do not establish hosted Windows/Linux GUI, real OS-session or graphical Cadre validation.") (:p "Coverage remains partial: borrowed window/app chains, native Push/Pop/Remove, external/native handler adoption, worker access, ownership transfer, native virtual overrides and arbitrary event-origin retention remain required C1 work. Next define borrowed window handler-stack ownership before exposing Push/Pop or widening chain receivers; preserve managed reciprocal identity and dispatch guards.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/PENDING-EVENTS.md" "pending delivery") ", " (:ref "guide/docs/EVENT-BINDINGS.md" "bindings") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window stacks") " now provide bounded Push/Pop/ Remove and explicit stack-aware synchronous processing; external adoption and general SetEventHandler remain gaps.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. Event/client/ userData and item-pointer ownership remain separate unbound APIs."))))
(:entry "guide/docs/HANDLER-CLIENT-DATA.md" :names ("docs/HANDLER-CLIENT-DATA.md" "HANDLER-CLIENT-DATA") :kind :guide :kind-name "Guide" :summary "docs/HANDLER-CLIENT-DATA.md" :sections (("Guide" (:heading 1 "Lisp client data attached to managed handlers") (:p "ABI 29 adds EVENT-HANDLER-CLIENT-DATA and its generic SETF writer. The receiver is any current public EVENT-HANDLER wrapper: an owned standalone handler, a managed window/control or the borrowed managed APPLICATION-HANDLER. The baseline is wxWidgets 3.2.12. OWNED-EVENT and immutable event snapshots are different resources and are not handler-client-data receivers.") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((handler (wxlambda:make-event-handler))
         (state (list :count 0)))
    (unwind-protect
         (progn
           (setf (wxlambda:event-handler-client-data handler) state)
           (assert (eq state (wxlambda:event-handler-client-data handler)))
           (setf (getf state :count) 1))
      (setf (wxlambda:event-handler-client-data handler) nil)
      (wxlambda:destroy-event-handler handler))))") (:heading 2 "Value identity and native representation") (:p "The property accepts any non-NIL Lisp object, retains it strongly and returns the same object by EQ. It does not copy/serialize the object or snapshot its mutable contents. Multiple handler associations can refer to the same Lisp value without making it native-owned memory. SETF returns the supplied value. NIL clears the bridge association and reads NIL when no bridge datum is present; NIL is not a distinct stored payload.") (:p "A native wxClientData subclass carries only an opaque numeric root token. The Lisp session root table holds the actual object. No native pointer to a Lisp object, raw client-data address or generic wxClientData wrapper is exposed. Native handler ownership deletes the adapter; it does not directly destroy the Lisp object or call Lisp finalizers. An ordinary Lisp reference to a previously returned value stays valid independently of the handler association.") (:p "Fresh native storage and an empty typed slot read NIL. Replacing or clearing an association deletes the old native adapter and releases its root through normal cleanup. A candidate root is established before native assignment and removed if the write fails, leaving prior native state intact on preflight rejection. There is no new constructor initarg: a subclass AFTER hook may use SETF once its native handler exists. The property does not alter handler-enabled state, bindings, event IDs, stack links or native ownership.") (:heading 2 "Foreign storage and typed mode safety") (:p "Native wxEvtHandler supports either typed wxClientData or untyped void* storage, not both. This binding supports only an empty slot or its own typed adapter. Foreign non-null typed client objects reject get/set without replacement or deletion. Every untyped/Void mode rejects too, including a slot whose raw pointer was set to NULL: clearing an untyped pointer does not reset its native mode. NIL assignment does not grant permission to erase foreign storage or switch between native modes.") (:p "The implementation checks mode before GetClientObject, avoiding native assertions from calling a typed getter on untyped storage. wxEvtHandler has no public mode getter. A private implementation interface on the bridge's managed App, StandaloneHandler and ManagedWindow classes exposes their protected m_clientDataType solely for this guard. This implementation-header dependency must be reviewed when advancing the wxWidgets baseline and retained for C7 reconciliation. It is not a new public field/mode getter, arbitrary native handler adoption or wxClientDataContainer binding.") (:p "Untyped GetClientData/SetClientData remains unbound. This property is also not wxCommandEvent::GetClientObject/SetClientObject, event userData or per-item client data on a choice/list control. Those pointer lifetimes and ownership rules remain separate gaps. Owned-event clone/dispatch rejection of borrowed event client or userData pointers is unchanged by storing a Lisp value on a handler.") (:heading 2 "Lifetime and cleanup boundaries") (:p "All accesses require the active main-thread application session and a live managed receiver. Expired/stale/pending-destruction native access rejects through existing lifetime guards. Native slot mutation is allowed during callbacks; it is not a structural handler-chain/stack edit and does not pump native events.") (:p "Lisp roots are reaped at client-data access and existing generic binding cleanup and rollback boundaries; the session root table is cleared after native finish. Asynchronous native destruction can retain a root until actual deletion followed by the next cleanup boundary or session end. Do not infer immediate garbage collection from DESTROY-WINDOW or a weak-reference observation. There is no GC finalizer, worker access, pointer retention API or cross-session value lookup.") (:p "Unlinking a standalone handler, default pop/remove or window destruction that detaches a pushed handler leaves that handler alive with its own client datum. Deleting a handler, deleting pop, or actual window/application destruction drops the associated native adapter; roots are subsequently released as above. Data on a window and data on its pushed handler are separate associations. Constructor rollback cleans created native resources and their client roots, without undoing arbitrary side effects on pre-existing external objects.") (:p "Immutable event snapshots do not capture this property. EVENT-SOURCE can identify a live callback receiver that has handler client data, but saving an event does not create a separate client-data snapshot or extend native handler lifetime. Already retained Lisp values remain ordinary valid objects after native cleanup.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/handler-client-data.lisp --eval '(wxlambda-handler-client-data:start)'") (:p "It associates Lisp state, observes it through a callback's receiver, checks EQ identity and clears the association before disposing resources. Validation must also distinguish retained values from native pointer payloads, replacement/clear from foreign-mode overwrite, requested from actual asynchronous deletion, and managed window data from detached pushed-handler data. Local checks do not establish hosted Windows/Linux GUI, native OS-session or graphical Cadre behavior.") (:p "A separate optional native regression creates otherwise-unreachable foreign storage states without adding public injection exports. It includes the bridge implementation in a dedicated test translation unit and checks typed/untyped rejection with a captured native assertion counter. Build/run in a separate GUI capable process:") (:code-block "sh" "cmake -S . -B build-native-tests -DWXLAMBDA_BUILD_NATIVE_TESTS=ON
cmake --build build-native-tests --target wxlambda-client-data-native
./build-native-tests/wxlambda-client-data-native") (:p "The option is OFF by default; this target is development verification, not a packaged library API or worker-thread facility. Native GUI/display prerequisites still apply. Require a passing result and zero captured assertions before claiming safe foreign-mode validation.") (:p "Coverage is partial: this supplies managed-handler typed client objects with Lisp root identity, not arbitrary wxClientData construction, untyped storage, event client/userData, item data, foreign object adoption or complete client-data container APIs. Continue those C1 ownership prerequisites explicitly before widening pointer-bearing APIs.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "window stacks") ", " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/NOTIFY-EVENTS.md" :names ("docs/NOTIFY-EVENTS.md" "NOTIFY-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/NOTIFY-EVENTS.md" :sections (("Guide" (:heading 1 "Registered command and notify events") (:p "This C1 slice binds " (:code "wxNewEventType") ", synthetic " (:code "wxCommandEvent") "/" (:code "wxNotifyEvent") " families and synchronous " (:code "wxEvtHandler::ProcessEvent") ". The baseline is wxWidgets 3.2.12 and the native bridge is ABI 29. It does not bind native control-specific notify subclasses or OS session routing.") (:heading 2 "Register a named native type") (:code-block "lisp" "(wxlambda:register-event-type :before-apply :family :notify) ; :BEFORE-APPLY
(wxlambda:event-type :before-apply)                        ; native integer ID
(wxlambda:register-event-type :result-ready :family :command)") (:p "Names must be unique keywords in the active main-thread session. The default family is " (:code ":notify") "; " (:code ":command") " is also supported. Built-in kinds cannot be redefined, and duplicate names or unsupported families are errors. Registration does not replace existing handlers or type definitions. There is no unregister operation. Names and bridge mappings last until session cleanup; native IDs are allocated by wxWidgets and must not be treated as stable serialized identifiers. Register each name once per session before binding or dispatching it.") (:p "Type declarations are session-wide metadata, not owned resource allocations. If an initializer registers a type and later fails, that declaration is not rolled back; managed rollback still removes its native handlers, windows and callback registrations. Saved snapshots retain copied kind, family and native type data after the registry/session ends.") (:heading 2 "Validate synchronously with Veto and Allow") (:code-block "lisp" "(defvar receiver (wxlambda:make-event-handler))
(wxlambda:bind-event receiver :before-apply
  (lambda (event context)
    (setf (wxlambda:event-vetoed-p context)
          (minusp (wxlambda:event-integer event))))
  :with-context t)

(multiple-value-bind (handled vetoed)
    (wxlambda:process-event receiver :before-apply :integer -1 :text \"Proposed change\")
  (when (and handled (not vetoed))
    ;; Apply the change here, after validation.
    (format t \"Accepted~%\")))") (:p (:code "process-event") " creates a fresh native event, dispatches it synchronously and returns two values: native " (:b "handled-p") " and final " (:b "vetoed-p") ". These are independent. Observer callbacks can run while handled-p is NIL because they Skip; it reports native consumption/default handling, not whether a callback ran. An initial veto can remain true even if no binding matched. The example uses a consuming contextual policy handler and requires both handling and no veto before applying the proposed change.") (:p "Notify contexts support veto intrinsically: " (:code "event-can-veto-p") " returns T. " (:code "event-vetoed-p") " reads " (:code "NOT IsAllowed") "; SETF true calls " (:code "wxNotifyEvent::Veto") ", and SETF NIL calls " (:code "Allow") ". This is distinct from close-event " (:code "CanVeto") " restrictions, which remain checked. Neither notify veto nor Allow changes Skip. Contextual bindings still begin unskipped; observers still automatically Skip.") (:p "Snapshots capture veto state before their callback. They do not change after a context calls Veto/Allow. The existing innermost-callback checks, nested context suspension and expiration rules apply; saved contexts cannot mutate a later event.") (:heading 2 "Payloads and asynchronous queuing") (:p "Registered command and notify types accept:") (:list (:item (:p (:code ":id") ": signed 32-bit command identifier, default 0, excluding reserved -1."))) (:list (:item (:p (:code ":text") ": copied UTF-8 string, default empty; Unicode and embedded NULs survive."))) (:list (:item (:p (:code ":integer") ": signed 32-bit value, default 0, copied from native " (:code "GetInt") "."))) (:list (:item (:p (:code ":vetoed-p") ": initial generalized-boolean veto, default NIL, notify family only."))) (:p (:code "queue-event") " accepts the same payloads and returns the supplied receiver, but offers no synchronous final result. Mutating the original Lisp string after the call does not change the queued event. " (:code "event-integer") " reads the copied command integer in saved snapshots; close snapshots report zero. Built-in toggle and selection events keep their specialized payload accessors. Custom kinds use " (:code "event-integer") ", not the built-in " (:code "event-selection") " slot.") (:p (:code "event-family") " now reads stored " (:code ":command") ", " (:code ":close") " or " (:code ":notify") " classification; it does not consult a live registry. Registered types work with existing ID filters, independent bindings, safe unbinding, disabled-handler behavior and borrowed window identities. They do not automatically change a control or apply the proposed operation. Use the returned decision to implement application policy.") (:heading 2 "Dispatch lifetime and errors") (:p "The bridge owns the temporary native event during synchronous dispatch, copies the final veto flag and deletes the event after dispatch returns. Deferred receiver disposal during its callback does not invalidate that event or its still-running context. Native callback objects remain pinned across unbinding. Managed initialization failure removes callback roots and registrations for its constructed resources.") (:p "Callback errors are re-signaled at the " (:code "process-event") " Lisp boundary, so handling a nested error need not stop an enclosing RUN. No result values are returned when a condition escapes; earlier handler mutations are not rolled back. An error is not an implicit veto. Existing " (:ref "guide/docs/CLOSE-EVENTS.md" "close-event default actions") " also apply when a close is synchronously dispatched. Synchronous dispatch is not an event pump; nested calls are permitted with context isolation, while recursive RUN/poll entry remains forbidden. All calls are main-thread/session restricted. Worker-to-GUI dispatch is not supplied here.") (:heading 2 "Session and remaining family prerequisites") (:p "Native query/end-session events belong to " (:code "wxApp") ", not a window handler. The default end-session action may exit the process. A borrowed application handler view and session-family bindings/metadata are now available; synthetic session events require isolated owned handlers and never reach wxApp fallback. Real OS delivery remains unverified. See " (:ref "guide/docs/SESSION-EVENTS.md" "session events") ". Tests do not emit real OS logout/shutdown events.") (:p "Native control-specific notify subclasses, arbitrary native class registration, userData, persistent event ownership/cloning, remaining native payload fields, context text/integer mutation, pushed/linked handlers, timer/idle and worker dispatch remain required coverage work. The registered base notify mapping does not complete those classes or the full C1 phase.") (:heading 2 "Example and verification") (:p "The " (:ref "example/examples/notify-events.lisp" "notify-events example") " registers a notify policy, vetoes while a checkbox blocks changes, then Allows and applies a change. Its reusable " (:code "exercise") " invokes the same button callback in both cases:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/notify-events.lisp \\
  --eval '(wxlambda-notify-events:start)'
sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/notify-events.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/notify-events.lisp
python3 tools/docset.py build
python3 tools/docset.py check") (:p "Use the project quiet-command wrapper in agent sessions. Focused tests cover registration conflicts, synchronous handled/veto distinctions, initial-veto Allow, integer bounds, copied NUL/Unicode text, saved registry-independent snapshots, disposal, initializer rollback and nested error recovery while RUN continues. The API, guide and example are indexed in the " (:ref "guide/docs/DOCSET.md" "Cadre docset") ", installable under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") "). Hosted GUI and graphical Cadre remain separate validation work.") (:p "See the " (:ref "guide/docs/APPLICATION-HANDLER.md" "borrowed application-handler view") " for managed wxApp identity, inherited dispatch and lifetime restrictions. Session-event routing remains unbound.") (:p (:ref "guide/docs/OWNED-EVENTS.md" "Owned events") " now provide detached native construction/cloning, explicit disposal, mutable value fields and copied dispatch. Earlier immutable snapshots and scoped contexts keep their lifetime rules. Arbitrary native classes, origin retention and client/userData ownership remain open.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " distinguish raw extra-LONG selection-action metadata from kind-specific checked/selection views and add bounded clear-only native origin detachment without retaining objects."))))
(:entry "guide/docs/OWNED-EVENTS.md" :names ("docs/OWNED-EVENTS.md" "OWNED-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/OWNED-EVENTS.md" :sections (("Guide" (:heading 1 "Owned native events, detached clones and copied dispatch") (:p "ABI 29 adds the native-backed " (:code "owned-event") " CLOS class and " (:code "make-event") ", " (:code "clone-event") ", " (:code "destroy-event") " and " (:code "event-alive-p") ". These are independently owned native resources, distinct from immutable " (:code "event") " snapshots and borrowed callback-scoped " (:code "event-context") " values. The baseline is wxWidgets 3.2.12.") (:heading 2 "Construction and disposal") (:p (:code "make-instance") " on OWNED-EVENT or a subclass creates the native event through inherited initialization. " (:code "make-event") " is a thin factory with validated " (:code ":class") " and forwarded initargs. Subclass slots, " (:code ":default-initargs") " and AFTER hooks work; native properties are available in subclass AFTER hooks. Combining OWNED-EVENT with EVENT-HANDLER or a window class is invalid and must reject before native allocation. These wrappers do not install native C++ virtual overrides.") (:code-block "lisp" "(wxlambda:with-application ()
  (wxlambda:register-event-type :message :family :command)
  (let ((event (wxlambda:make-event :kind :message :text \"Hello\" :integer 1)))
    (unwind-protect
         (setf (wxlambda:event-text event) \"Reusable payload\"
               (wxlambda:event-integer event) 2)
      (wxlambda:destroy-event event))))") (:p (:code ":kind") " defaults to :CLICK and accepts the seven built-in kinds or a registered command/notify name. The other base construction initargs match synthetic event payloads: " (:code ":id") " defaults to 0, " (:code ":text") " to an empty string, " (:code ":integer") " to 0, " (:code ":checked-p") " and " (:code ":selection") " apply only to their built-in kinds, " (:code ":can-veto-p") " defaults T for close-family construction, initial " (:code ":vetoed-p") " applies only to registered notify kinds, and " (:code ":logging-off-p") " applies only to session kinds. Explicit wrong-family payload options follow QUEUE-EVENT validation. Initial ID -1 remains reserved; subsequent EVENT-ID SETF can assign it as native metadata. No native handle can be supplied as an initarg.") (:p "Native wxEVT_TEXT can lazily read the originating text control instead of its stored command string. Context EVENT-TEXT SETF therefore rejects that type when its tracked origin exposes a text entry, and rejects unknown native origins; it does not silently edit the control. Detached context cloning first captures the effective GetString value and stores it before clearing origin, freezing the observed text. Copied owned :TEXT-CHANGE dispatch to a text-entry receiver rejects before queueing or processing, rather than allowing receiver text to shadow the owned payload. Other receivers and custom command tags support payload copying. Existing keyword synthetic dispatch behavior is unchanged.") (:p "An owned event stays in the native session registry until explicit DESTROY-EVENT or session cleanup, even if its Lisp wrapper is garbage collected. There is no GC finalizer or cross-session reuse. EVENT-ALIVE-P returns NIL for an explicitly destroyed resource during the active session. Other native access and repeated destruction signal NATIVE-ERROR. A failed/uninitialized wrapper has no handle and also signals NATIVE-ERROR, including for EVENT-ALIVE-P. Outside a GUI session, all native resource operations signal NATIVE-ERROR. Native operations remain restricted to the main thread.") (:p "Initialization failure rolls back native events, widgets, standalone handlers and callback roots created in the same managed construction transaction. Window rollback still follows native asynchronous destruction; event deletion is immediate. Session cleanup destroys remaining owned events before handler/app teardown.") (:heading 2 "Detached native cloning") (:p "CLONE-EVENT accepts a live OWNED-EVENT or the current innermost EVENT-CONTEXT and returns a new OWNED-EVENT. It calls native Clone only for exact wxCommandEvent, wxNotifyEvent or wxCloseEvent classes with supported tags. Other native subclasses and events carrying userData or command client pointers reject cloning. A saved snapshot is not a native event and has no CLONE-EVENT method.") (:p "Native origin is cleared on every clone: a clone never retains a borrowed GetEventObject pointer. EVENT-ORIGIN-ID on an owned event therefore returns NIL. No new-origin setter, arbitrary wxObject wrapper or origin pinning/retention protocol is added. Clone preserves supported value metadata, payload, Skip/propagation and veto flags. Source and clone can be changed or destroyed independently.") (:p "CLONE-EVENT supports " (:code ":class") " and forwarded subclass slot initargs. The factory and MAKE-EVENT with " (:code ":clone-from") " reject explicit payload override initargs: clone first and use SETF to change its values. Inherited payload default initargs do not replace cloned values. Direct MAKE-INSTANCE with " (:code ":clone-from") " uses the source native state and ignores payload initargs, including inherited defaults; subclass slot initialization and AFTER hooks still apply. This source-wins rule avoids accidentally reconstructing a clone from subclass defaults.") (:p "Cloning a suspended outer or expired context signals NATIVE-ERROR. Snapshot readers stay independent of native lifetime; cloning does not extend a context's lifetime or expose a native event pointer.") (:heading 2 "Mutable properties") (:p "Owned events support generic reads for kind, family, ID, native type, timestamp, command classification, category, CanVeto/veto, session logging-off, Skip and propagation. SETF is supported for ID, timestamp, bounded registered native type, CanVeto/veto, session logging-off and Skip. STOP-EVENT-PROPAGATION and RESUME-EVENT-PROPAGATION also accept owned events. Kind/family/classification and category are derived read-only metadata; origin remains detached.") (:p "EVENT-TEXT and EVENT-INTEGER are now generic readers for snapshots, current contexts and owned events, with SETF for current/owned command and notify events. Strings use explicit UTF-8 byte counts and retain embedded NULs. Integer writes accept signed32 values. They alter native command payload fields, so built-in checked/selection interpretations can reflect the same underlying integer. EVENT-SELECTION snapshots normally contain an index, but explicitly mutated raw integers can be other signed values; -1 maps to NIL. No live item-list validation is implied by raw payload mutation. Live text reads return a string for command/notify events, including empty strings; close-family text reads return NIL and writes reject. Close-family integer reads return zero and writes reject. Saved snapshots retain their existing kind-specific copied payload interpretation and have no SETF methods.") (:p "Other validation is unchanged: timestamps must fit signed native C LONG; native type mutation requires registered same-family tags and actual native class; CanVeto writes require wxCloseEvent, veto writes check its current capability or use notify Veto/Allow, and logging-off requires a session event. Context methods remain valid only in the innermost callback. These metadata changes do not grant OS veto authority or change the native class.") (:heading 2 "Dispatch always copies") (:p (:code "(process-event receiver owned-event)") " dispatches a fresh detached clone and returns handled-p and final-vetoed-p from that copy. " (:code "(queue-event receiver owned-event)") " queues another independent native clone and returns RECEIVER. Both reject synthetic payload keyword overrides; mutate the owned event before copying instead. The receiver becomes the dispatch copy's native origin.") (:p "Mutations made by callbacks affect only that dispatch copy. The source owned event remains unchanged and may be destroyed inside the callback or immediately after queueing. Callback errors re-signal at the existing nearer Lisp boundary; previous copy mutations are not transactional. The source is never transferred to wxWidgets or consumed by dispatch. A contextual callback can CLONE-EVENT its current native copy to retain the changed state, with origin detached again. Observer Skip/handled-result and callback-time receiver-disposal rules remain in force.") (:p "Session event copies still require an isolated owned standalone receiver. Application/window receivers reject before dispatch, and standalone session fallback to wxApp stays blocked. Owned session construction is not OS event delivery and does not relax that rule. No live logout/shutdown is generated by automated checks.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/owned-events.lisp --eval '(wxlambda-owned-events:start)'") (:p "It constructs a reusable message, changes the synchronous copy, captures a detached clone of the current context, queues a copy, destroys its source before delivery, and verifies unchanged snapshots and independent payloads. Regressions also cover CLOS defaults/subclasses, mixed-resource rollback, explicit disposal, session cleanup, all built-in constructions, live payload writes and session receiver guards.") (:p "This is partial native ownership coverage. Arbitrary derived event classes, retained origin objects, client/userData ownership, snapshot-to-native conversion, arbitrary native source transfer, origin writes and broader worker or pushed-handler ownership remain open. Existing null/untracked-origin lookup and actual-class mismatch rejection branches are not manufactured by the safe public API. Hosted Windows/Linux GUI, native OS session delivery and graphical Cadre validation remain unverified.") (:p "Build/check the docset with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "event contexts") ", " (:ref "guide/docs/EVENT-TAGS.md" "tag mutation") ", " (:ref "guide/docs/SESSION-EVENTS.md" "session events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/PENDING-EVENTS.md" "Pending delivery modes") " now add GUI posting copies, genuine TRANSFER-EVENT ownership handoff, synchronous local copies and handler-specific pending deletion. PROCESS-EVENT/QUEUE-EVENT retain the copy semantics above; transferred source wrappers are consumed and cannot be reused or destroyed.") (:p (:ref "guide/docs/HANDLER-CHAINS.md" "Standalone handler chains") " now preserve canonical wrapper identity and session ownership while participating in normal/local/pending delivery. Structural edits and linked destruction during callbacks reject; borrowed window/application stacks remain unbound.") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Managed window handler stacks") " now attach owned standalone handlers without transferring native ownership, detach them on actual window destruction and provide explicit stack-aware copy processing. Standalone peer editing excludes attached nodes; arbitrary SetEventHandler/external adoption remain unbound.") (:p (:ref "guide/docs/COMMAND-EVENT-PAYLOADS.md" "Command payload views") " add native extra LONG, raw selection-action metadata, uniform checked/selection semantic SETF and clear-only origin detachment. Owned construction accepts command/notify :EXTRA-LONG; keyword synthetic queue/process calls do not add that option.") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. Event/client/ userData and item-pointer ownership remain separate unbound APIs."))))
(:entry "guide/docs/PENDING-EVENTS.md" :names ("docs/PENDING-EVENTS.md" "PENDING-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/PENDING-EVENTS.md" :sections (("Guide" (:heading 1 "Pending-event copies, transfer and local processing") (:p "ABI 29 adds POST-EVENT, TRANSFER-EVENT, PROCESS-EVENT-LOCALLY and DELETE-PENDING-EVENTS as generic handler operations. They build on detached OWNED-EVENT resources and the wxWidgets 3.2.12 event-handler interface. This batch distinguishes copy delivery from genuine native ownership handoff.") (:table :header (("Operation") ("Input resource after success") ("Native operation") ("Delivery")) :rows ((("POST-EVENT") ("Still live and unchanged") ("GUI wxPostEvent / AddPendingEvent copy") ("Queued")) (("QUEUE-EVENT with owned input") ("Still live and unchanged") ("QueueEvent with independent clone") ("Queued")) (("TRANSFER-EVENT") ("Consumed; no longer owned by the bridge") ("wxQueueEvent / QueueEvent ownership handoff") ("Queued")) (("PROCESS-EVENT") ("Still live and unchanged") ("ProcessEvent on independent clone") ("Synchronous normal routing")) (("PROCESS-EVENT-LOCALLY") ("Still live and unchanged") ("ProcessEventLocally on independent clone") ("Synchronous local routing")))) (:p "The four new operations require an active main-thread GUI session. They accept event-handler/window receivers as described below; event-delivery operations accept a live OWNED-EVENT rather than a kind keyword or snapshot. No payload override keywords are supported. Mutate the owned resource first, or clone it when a distinct reusable input is needed.") (:heading 2 "Posting a GUI copy") (:p "POST-EVENT returns RECEIVER after posting a detached copy using wxPostEvent, which uses AddPendingEvent in this GUI application. It does not process callbacks before returning. Its input remains live and unchanged and can be changed or destroyed immediately afterward without changing the queued copy. The receiver is the copy's native origin, just as for owned QUEUE-EVENT dispatch.") (:p "This mapping deliberately requires the existing GUI session; wxPostEvent's non-GUI immediate-dispatch behavior is not exposed. AddPendingEvent string copying is not a worker-thread facility here. Worker-to-GUI posting remains unbound, including any broader thread-safety guarantees.") (:code-block "lisp" "(wxlambda:post-event receiver message)
(assert (wxlambda:event-alive-p message))
(wxlambda:process-pending-events) ; existing application-wide pending dispatch") (:heading 2 "Transferring native ownership") (:p "TRANSFER-EVENT returns RECEIVER after handing the actual owned native object to wxQueueEvent. It validates the receiver, supported event and receiver-family restrictions before consuming the input. A validation failure leaves the owned resource live so it can be corrected, copied or destroyed normally.") (:p "After preflight, the native object is removed from the bridge-owned registry and handed off to wxWidgets. EVENT-ALIVE-P on the original wrapper then returns NIL during the active session; native property access, cloning and DESTROY-EVENT on that consumed wrapper reject. Its integer handle is not another owner's public receiver. The receiver becomes the transferred event's native origin.") (:p "There is no rollback after handoff or delivery guarantee. If the destination is later destroyed, pending events are deleted, or native delivery otherwise does not happen, ownership is not returned to the consumed wrapper. A failure after the handoff boundary does not restore bridge ownership either. Use POST-EVENT or QUEUE-EVENT when the input must remain reusable.") (:code-block "lisp" "(wxlambda:transfer-event receiver (wxlambda:clone-event message))
(assert (wxlambda:event-alive-p message)) ; original message was not transferred") (:p "Callbacks can retain immutable snapshots or clone their current context into a new detached resource. They cannot regain ownership of the consumed wrapper. The bridge never exposes the native event pointer during transfer.") (:heading 2 "Synchronous local processing") (:p "PROCESS-EVENT-LOCALLY returns two values: native handled-p and final-vetoed-p from an independent detached copy. It leaves the input alive and unchanged. Like native ProcessEventLocally, it tries the receiver and native chained handlers, including local pre-processing such as TryBefore/validators. Native local static/default handlers can still run, including frame-close behavior. Local processing is not an observer-only or no-default-action mode. It does not run the normal outer global-filter and parent/application fallback path of ProcessEvent. Managed standalone " (:ref "guide/docs/HANDLER-CHAINS.md" "handler chains") " are now available; dedicated managed window stacks are also bound, while external/native stack adoption, arbitrary SetEventHandler and virtual overrides remain unbound.") (:p "An observing callback can run and Skip while handled-p is NIL. Final veto state is independent of handled-p. Nested current-context lifetime rules and the nearer callback-error boundary remain the same as PROCESS-EVENT. Local processing is synchronous; it neither pumps unrelated pending queues nor converts them into local delivery. Choose PROCESS-EVENT for normal native parent/application routing.") (:heading 2 "Deleting one handler's pending events") (:p "DELETE-PENDING-EVENTS returns T after deleting every pending native event on the selected receiver. It does not execute callbacks or remove bindings. Later posts and queues on that handler still work. It does not delete another handler's queue, report a deletion count, restore transferred resources or perform application-wide queue deletion. An empty target queue is allowed.") (:p "The borrowed APPLICATION-HANDLER rejects this operation: application-queued work includes bridge deferred cleanup and must not be discarded through this API. The operation also rejects during RUN, a native pump or any callback. Call it at a non-dispatch boundary, not from the delivery being cancelled.") (:p "The wrapper synchronizes the target with wxApp's pending-handler list after native DeletePendingEvents. The implementation uses the native RemovePendingEventHandler management method because DeletePendingEvents alone does not remove the list entry. That method exists in the implementation header, but is absent from the pinned documentation-interface inventory; it is an implementation dependency for C7 reconciliation, not a new public Lisp binding.") (:p "Per-handler ProcessPendingEvents remains unbound. Native code requires a known nonempty target queue, and this bridge does not expose a safe per-handler pending query. Existing PROCESS-PENDING-EVENTS remains the application-wide dispatcher. wxAppConsole::DeletePendingEvents also remains unbound; target-handler deletion must not be mistaken for application-wide pending cancellation.") (:heading 2 "Shared restrictions and verification") (:p "All new delivery modes retain existing supported exact native classes, detached origin policy and session isolation. Session event delivery still requires an isolated owned standalone receiver; application/window targets reject before handoff or posting. Copied owned :TEXT-CHANGE delivery to text-entry receivers rejects before emission, preventing lazy native GetString from shadowing the owned payload. Transfer applies the same text-entry restriction. These APIs add no arbitrary origin retention, raw pointers, native class replacement, userdata/ client ownership, real OS session delivery or worker-thread posting.") (:p "Run the example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/pending-events.lisp --eval '(wxlambda-pending-events:start)'") (:p "It demonstrates the distinct copy/transfer/local/cancellation semantics using owned events and releases resources. Regression validation should distinguish consumed handles from surviving copies, preflight failure from handoff, local routing from normal parent routing, handler-specific cancellation from other pending queues, and callback/pump/application restrictions. Local results do not validate hosted Windows/Linux GUI behavior, real OS session events or graphical Cadre. Remaining C1 gaps include origin retention, broader native classes, client/userdata ownership, application-wide cancellation, per-handler pending queries, pushed handlers, timer/idle and worker dispatch.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") ", " (:ref "guide/docs/APPLICATION-EVENTS.md" "application dispatch") ", " (:ref "guide/docs/EVENT-BINDINGS.md" "event bindings") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/WINDOW-HANDLER-STACKS.md" "Window stack routing") " is explicit: generic and queued window operations retain wxEvtHandler stack-bypass behavior; PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY enter managed pushed handlers synchronously."))))
(:entry "guide/docs/SESSION-EVENTS.md" :names ("docs/SESSION-EVENTS.md" "SESSION-EVENTS") :kind :guide :kind-name "Guide" :summary "docs/SESSION-EVENTS.md" :sections (("Guide" (:heading 1 "Session events and logging-off metadata") (:p "The wxWidgets 3.2.12 close family includes " (:code ":query-end-session") " and " (:code ":end-session") ", alongside window " (:code ":close") ". EVENT-FAMILY returns " (:code ":close") " for all three. EVENT-TYPE returns their process-local native tags; immutable snapshots retain kind, native type, ID, CanVeto, pre-callback veto and logging-off metadata after callback and session cleanup. Native bridge ABI: 18.") (:p "Bind native session tags on CURRENT-APPLICATION-HANDLER with BIND-EVENT. The operating system routes these events to wxApp; window receivers reject session bindings. Existing observer callbacks Skip after delivery. Contextual callbacks start unskipped and choose whether to delegate with EVENT-SKIPPED-P. Native query/default policy and OS behavior remain in wxWidgets. Default END_SESSION handling can terminate the process. An observer or callback error that Skips can therefore reach that default. Do not use an observer to prevent shutdown, and do not infer that a consumed event can cancel an irrevocable OS shutdown. Any veto write requires EVENT-CAN-VETO-P true, including writes of NIL.") (:p "This slice installs/removes application bindings locally but does not trigger real OS logout/shutdown. Native delivery and OS policy remain unverified on all ports; the declaration mappings remain partial. In particular, support for native session notifications varies by wxWidgets port. There is no managed shutdown transaction, persistence hook, native wxApp override or guarantee that all platforms deliver both events or permit veto.") (:heading 2 "Logging-off access") (:p "EVENT-LOGGING-OFF-P is a generic reader for a saved session snapshot or the current innermost session-event context. True means logging off; NIL means system shutdown. SETF changes the current native session event's flag and returns the supplied generalized boolean. This changes event metadata, not OS intent. Snapshots are immutable and preserve pre-callback state. Non-session snapshots signal a Lisp error; non-session/expired/suspended contexts signal NATIVE-ERROR. Native context access requires the active main-thread session. No SETF method exists for snapshots.") (:p "QUEUE-EVENT and PROCESS-EVENT accept " (:code ":logging-off-p") " (default NIL) only for session kinds, and " (:code ":can-veto-p") " (default T) for all close-family kinds. These are synthetic construction defaults, including CanVeto T for synthetic END_SESSION; native OS events retain their actual flags and may be non-vetoable. Initial " (:code ":vetoed-p") " remains restricted to registered notify types. Session construction rejects command text, integer, selection and toggle payloads. PROCESS-EVENT returns native handled-p and final-vetoed-p independently.") (:heading 2 "Isolated synthetic probes") (:p "Synthetic session dispatch/queueing requires an owned standalone EVENT-HANDLER. The native bridge rejects application and window receivers before creating or queueing the event. The internal standalone native handler suppresses wxApp fallback specifically for the two session tags. This matters even with no matching binding, a skipped observer or disabled handler: ordinary wxEvtHandler TryAfter can otherwise forward an unhandled event to the application and run its shutdown defaults. Other event kinds retain their native fallback behavior. Synthetic probes never simulate OS delivery or change the real session.") (:code-block "lisp" "(wxlambda:with-application ()
  (let* ((receiver (wxlambda:make-event-handler))
         (binding (wxlambda:bind-event receiver :query-end-session
                    (lambda (event context)
                      (declare (ignore event))
                      (when (wxlambda:event-can-veto-p context)
                        (setf (wxlambda:event-vetoed-p context) t)))
                    :with-context t)))
    (unwind-protect
         (wxlambda:process-event receiver :query-end-session :logging-off-p t)
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event-handler receiver))))") (:p "Run the isolated example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/session-events.lisp --eval '(wxlambda-session-events:start)'") (:p "The regression also checks both kinds, unmatched/observer/disabled fallback isolation, queue copies, native application binding removal without emission, window binding rejection, synthetic receiver guards, snapshot independence, nested context suspension/expiration and guarded veto. No real OS logout or shutdown is used in automated checks.") (:p (:ref "guide/docs/EVENT-METADATA.md" "Event metadata") " now adds timestamps, command classification and current close-family SetCanVeto, including explicit false-to-true changes. These do not grant OS shutdown cancellation. Persistent event objects/cloning, mutable native types/origin, derived notify classes, pushed handlers, timer/idle and worker dispatch remain required C1 work. Scoped ID mutation and routing are now implemented; next define native type/origin contracts before broader event ownership/families.") (:p "Build/check using " (:code "python3 tools/docset.py build") " and " (:code "check") ". Install using " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre lookup and examples. See " (:ref "guide/docs/APPLICATION-HANDLER.md" "application identity") ", " (:ref "guide/docs/CLOSE-EVENTS.md" "close events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") "."))))
(:entry "guide/docs/WINDOW-HANDLER-STACKS.md" :names ("docs/WINDOW-HANDLER-STACKS.md" "WINDOW-HANDLER-STACKS") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-HANDLER-STACKS.md" :sections (("Guide" (:heading 1 "Managed window event-handler stacks") (:p "ABI 29 adds WINDOW-EVENT-HANDLER, PUSH-EVENT-HANDLER, POP-EVENT-HANDLER, REMOVE-EVENT-HANDLER, PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY. The wxWidgets 3.2.12 mapping supports bridge-managed windows and session-owned standalone handlers, including Lisp subclasses. It adds no external handler adoption, arbitrary SetEventHandler, raw pointer or native virtual Lisp callback.") (:heading 2 "Stack ownership and identity") (:p "WINDOW-EVENT-HANDLER returns the top managed pushed handler as its canonical Lisp wrapper. An empty managed stack returns the same window object passed to the reader, matching native GetEventHandler's default self identity. The reader checks that the native stack is known to the bridge; it does not wrap or adopt an unknown native handler. It is read-only and may run during callbacks while the window remains valid and is not being deleted.") (:p "PUSH-EVENT-HANDLER takes a live window and an unlinked session-owned standalone handler, returns the handler, and places it above the prior top. Last pushed is first in native stack traversal. Already attached or linked handlers reject; window/application objects cannot be pushed as peers. Pushing does not move the native unique ownership registry entry: the bridge session still owns the handler and strongly roots its canonical wrapper. The window does not become its deleting owner merely because it appears on the native event stack.") (:code-block "lisp" "(wxlambda:push-event-handler window handler)
(assert (eq handler (wxlambda:window-event-handler window)))
(wxlambda:pop-event-handler window) ; handler stays alive and unlinked") (:p "POP-EVENT-HANDLER without DELETE detaches and returns the top handler, alive and unlinked. With " (:code ":delete t") ", bridge ownership is released, native PopEventHandler performs deletion, Lisp canonical roots/bindings are cleared, and NIL is returned. The former wrapper is no longer live; native access and repeated destruction reject. Popping an empty stack is an error, including with DELETE true.") (:p "REMOVE-EVENT-HANDLER detaches a specified live managed handler without deletion, returning T if it belonged to that window and NIL otherwise. A live detached handler or one attached to another window is a safe nonmember probe: no native assertion is triggered and no stack changes. Wrong borrowed peers and destroyed handlers reject instead of being treated as absent. Removal preserves other stack entries, the native owned registry and the handler's own pending queue.") (:p "All structural stack operations require an active main-thread session at a non-dispatch boundary. Callback, native pump and RUN use reject before mutation. This includes pop/remove attempts that would be empty or absent. General NEXT-HANDLER/PREVIOUS-HANDLER peer reads and SETF, and UNLINK-EVENT-HANDLER, reject attached nodes so the standalone protocol cannot expose or edit the borrowed window tail. Use the window stack API to inspect/detach them. HANDLER-UNLINKED-P is the exception: it can read attached owned nodes and returns NIL.") (:heading 2 "Window destruction and explicit handler destruction") (:p "All eight concrete native widget kinds use an internal managed destructor that pops managed handlers with native deletion disabled before wxWindowBase teardown. Deleting a window or an ancestor therefore detaches pushed handlers; they remain alive, unlinked and session-owned. Their own pending queues remain with them and can deliver after the window is gone; window teardown does not cancel those queues. This cleanup does not depend on a destroy-event observer, its Skip choice or HANDLER-ENABLED-P. These internal native subclasses do not add public CLOS classes or expose native virtual overrides.") (:p "This policy matters because the native window destructor requires pushed handlers to have been removed; it does not act as their deleting owner. The bridge also detaches managed stacks before application session window cleanup. A requested asynchronous window destruction may leave the stack attached until actual native teardown; do not equate a destruction request with completed handler detachment.") (:p "DESTROY-EVENT-HANDLER on an attached handler removes it from its window before native deletion when called outside callbacks. During callbacks, linked/attached handler destruction rejects so an active traversal is not structurally edited. Unlinked handler callback disposal retains its prior deferral behavior. Constructor rollback removes/deletes a failed owned handler even if its AFTER hook attached it; a failed window's eventual native destruction detaches pushed handlers. Resource rollback is not arbitrary restoration of external stack/graph edits made by user hooks. No GC finalizer or cross-session reuse is introduced.") (:heading 2 "Explicit window routing") (:p "PROCESS-WINDOW-EVENT and PROCESS-WINDOW-EVENT-LOCALLY take a window and a live OWNED-EVENT, process an independent detached copy, and return handled-p and final-vetoed-p from that copy. The source owned event stays alive/unchanged and can be destroyed during callbacks. Copy origin is the window, while a pushed handler's callback snapshot source is that handler's canonical Lisp wrapper. No payload override keywords are accepted.") (:p "PROCESS-WINDOW-EVENT enters native GetEventHandler routing and can continue from the stack through the window and normal parent/application fallback. PROCESS-WINDOW-EVENT-LOCALLY searches this window and its pushed handlers, including applicable native validators/local pre-processing, without normal upward window propagation. Native local static/default handlers may still run, including frame-close behavior; local routing is not observer-only. Observer Skip/consumption and nearer callback-error boundaries retain their existing meaning; a callback can run while handled is NIL, and veto is independent of handled.") (:p "Existing PROCESS-EVENT, PROCESS-EVENT-LOCALLY and queued/post/transfer operations on a window deliberately retain wxEvtHandler receiver semantics and bypass its pushed stack. Use the explicit synchronous window operations when that stack must participate. They do not change where native pending objects are queued, move pending events between nodes, install Lisp callback chains or promise callback order within a node. Native window input routing still follows its own wxWidgets entry paths.") (:heading 2 "Session and payload restrictions") (:p "Synthetic query/end-session delivery and session bindings are not allowed on attached pushed handlers. PUSH rejects a handler with active session bindings or queued session events before attachment. Native standalone session tracking is cleared when those events are processed or deleted; it introduces no worker posting or Lisp native virtual hook. These restrictions prevent the borrowed window tail from becoming a route to process-exiting wxApp session defaults. Native app session delivery remains separately unverified.") (:p "The owned-event copied-dispatch and lazy wxEVT_TEXT/text-entry receiver guards also apply to the explicit window operations. No native class replacement, arbitrary tag mutation, borrowed client/userData ownership or retained origin pointer is added. Window SetEventHandler and adoption of external native stack entries remain unbound.") (:p "Run the complete example:") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-handler-stacks.lisp --eval '(wxlambda-window-handler-stacks:start)'") (:p "Focused regression covers stack-aware explicit routing versus generic window bypass, pop/remove/deleting-pop lifetime, nonmember/stale probes, all eight widget destructors, parent-cascade detachment with window event processing disabled, pending delivery after pop/window deletion, session guards and rollback in both construction directions. wxEVT_DESTROY is not publicly bindable, so consuming a real destroy notification is not directly tested; teardown independence is structural/native review rather than a claimed destroy-callback test. A destroy request still differs from actual native detachment. Local checks do not establish hosted Windows/Linux GUI or graphical Cadre behavior. Remaining C1 work includes external/native stack adoption, arbitrary SetEventHandler, origin retention, client/userData ownership, timer/idle and worker dispatch.") (:p "Build/check with " (:code "python3 tools/docset.py build") " and " (:code "check") "; install with " (:code "python3 tools/docset.py install") " under " (:code "$XDG_DATA_HOME/docsets/wxlambda/") " (default " (:code "~/.local/share/docsets/wxlambda/") ") for Cadre discovery and lookup. See " (:ref "guide/docs/HANDLER-CHAINS.md" "standalone chains") ", " (:ref "guide/docs/EVENT-HANDLERS.md" "handler lifetime") ", " (:ref "guide/docs/OWNED-EVENTS.md" "owned events") " and " (:ref "guide/docs/DOCSET.md" "docset installation") ".") (:p (:ref "guide/docs/HANDLER-CLIENT-DATA.md" "Handler Lisp client data") " now retains EQ values through a native typed token adapter with safe foreign-mode rejection. Event/client/ userData and item-pointer ownership remain separate unbound APIs."))))
(:entry "guide/docs/WINDOW-METADATA.md" :names ("docs/WINDOW-METADATA.md" "WINDOW-METADATA") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-METADATA.md" :sections (("Guide" (:heading 1 "Window names and frame titles") (:p "This coverage slice adds logical window names and mutable frame titles. These are CLOS generic functions; names work with every currently bound window/control. Title operations accept frames; other top-level window types remain future work.") (:heading 2 "Logical names") (:code-block "lisp" "(setf (wxlambda:window-name window) \"search-input\") ; returns the supplied string
(wxlambda:window-name window)                    ; independent string") (:p "A name is a logical string property, separate from a control's displayed label, its text value, a frame's title and the native integer ID. Names need not be unique. Changing a name does not synthesize a command event or change the label. Unicode, empty names and embedded NUL characters are preserved using explicit UTF-8 byte counts across the bridge. A setter copies its input; changing the Lisp string afterwards does not change the native name. A getter returns an independent Lisp string that survives later queries and window destruction.") (:heading 2 "Frame titles") (:code-block "lisp" "(wxlambda:frame-title frame)                     ; includes initial make-frame title
(setf (wxlambda:frame-title frame) \"Results — λ\")  ; returns the supplied string") (:p "Title setters update the existing frame, and getters return independent strings. Empty titles and Unicode are accepted. Display and platform normalization follow wxWidgets and the native window system. A frame's logical name is unaffected. These operations expose " (:code "wxTopLevelWindow::GetTitle") " and " (:code "SetTitle") " for the currently bound " (:code "wxFrame") " type; passing a panel or control signals a Lisp dispatch error.") (:p "All four functions require a live window in an active main-thread GUI session. Invalid/destroyed handles and inactive sessions signal " (:code "native-error") "; wrong Lisp argument types signal Lisp conditions. Empty successful results are strings, not failure sentinels. No parent ownership or handler lifetime rules change.") (:heading 2 "Example and checks") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-metadata.lisp \\
  --eval '(wxlambda-window-metadata:start)'") (:p "The example constructs a subclass directly with " (:code "make-instance") " and counts title updates using an " (:code ":after") " method on " (:code "(setf frame-title)") ". Click the button to update both the frame name and its Unicode title. Close the frame to exit. The example's reusable " (:code "exercise") " queues that same callback, checks the resulting properties and subclass hook, explicitly unbinds it and destroys the frame. See " (:ref "guide/docs/CLOS-API.md" "the CLOS API guide") " for the dispatch and subclassing contract. The automated test runs this example, checks names on all seven widget types, independent labels/text, Unicode/empty/NUL names, saved string lifetime, non-frame title errors, invalid native pointers and destroyed/inactive handles:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-metadata.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-metadata.lisp") (:p "Native ABI 9 adds length-aware metadata strings. Rebuild the bridge with the updated Lisp bindings. Getter pointers are borrowed until the next name/title query on the same thread; the public Lisp getters copy them immediately. Existing text and label getter buffers retain their previous lifetime contracts."))))
(:entry "guide/docs/WINDOW-STATE.md" :names ("docs/WINDOW-STATE.md" "WINDOW-STATE") :kind :guide :kind-name "Guide" :summary "docs/WINDOW-STATE.md" :sections (("Guide" (:heading 1 "Window visibility and input state") (:p "The first coverage slice completes the " (:code "wxWindow::Show(bool)") ", " (:code "IsShown()") ", " (:code "Enable(bool)") " and " (:code "IsEnabled()") " operations for all currently bound windows. Hiding through " (:code "show-window") " with NIL also covers " (:code "Hide()") "; disabling through " (:code "enable-window") " with NIL covers " (:code "Disable()") ", preserving their changed-state results as second values. It builds on the existing handle/lifecycle support; the rest of the window API and C1 foundation inventory remain open.") (:heading 2 "Showing and hiding") (:code-block "lisp" "(wxlambda:show-window window)       ; show, preserving the existing API
(wxlambda:show-window window nil)   ; hide
(wxlambda:shown-p window)           ; own shown flag") (:p (:code "show-window") " returns the window as its primary value, so existing callers retain their result. Its second value is true when wxWidgets changed the shown state and false for an unchanged request. SHOW is a generalized boolean.") (:p (:code "shown-p") " reads the window's own shown flag. A child can have this flag true while a parent is hidden; this query does not promise it is visible on screen. Frames initially have their shown flag false; child controls normally start true. Use " (:code "layout-window") " on the parent after hiding/showing a sizer child when the layout should reclaim or restore its space.") (:heading 2 "Enabling and disabling input") (:code-block "lisp" "(wxlambda:enable-window window nil) ; disable user input
(wxlambda:enable-window window)     ; enable it again
(wxlambda:enabled-p window)         ; effective state, including ancestors") (:p (:code "enable-window") " returns the window and the native changed-state boolean as two values. ENABLE is a generalized boolean. " (:code "enabled-p") " includes disabled ancestors: a child is effectively disabled while a parent is disabled. A child explicitly disabled before disabling its parent stays disabled after the parent is enabled.") (:p "These functions require a live window in the active main-thread session. Invalid or destroyed native handles signal " (:code "native-error") "; false query results and unchanged setters are ordinary results. Setters do not synthesize command events. Hiding/disabling a control retains its handlers and ownership; explicitly unbind handlers before destroying it under the existing lifecycle contract.") (:heading 2 "Example and verification") (:code-block "sh" "sbcl --load ~/quicklisp/setup.lisp --load examples/window-state.lisp \\
  --eval '(wxlambda-window-state:start)'") (:p "The example has separate buttons that toggle text visibility and input. Close the frame to exit. Its " (:code "exercise") " function queues the actual callbacks twice, verifies both state transitions, unbinds handlers and destroys the window. The focused test runs this example and checks setter return values, repeated requests, ancestor semantics and destroyed/inactive handle errors:") (:code-block "sh" "sbcl --noinform --no-sysinit --no-userinit --non-interactive \\
  --load ci/setup.lisp --load tests/window-state.lisp
ccl --no-init --batch --load ci/setup.lisp --load tests/window-state.lisp") (:p "Native ABI 8 introduces distinct boolean/error results (" (:code "0") "/" (:code "1") " versus " (:code "-1") "). Rebuild the native bridge with the Lisp changes. The old C " (:code "wxl_show") " status contract remains available; the Lisp wrapper uses " (:code "wxl_show_state") " to expose its second value. This does not implement " (:code "IsShownOnScreen") ", intrinsic " (:code "IsThisEnabled") ", general event bindings or window subclassing."))))
(:entry "guide/docs/WXWIDGETS-COVERAGE.md" :names ("docs/WXWIDGETS-COVERAGE.md" "WXWIDGETS-COVERAGE") :kind :guide :kind-name "Guide" :summary "docs/WXWIDGETS-COVERAGE.md" :sections (("Guide" (:heading 1 "wxWidgets coverage plan") (:p "This is the deliverable for implementation " (:b "Phase 6") ". The former release preparation phase is now " (:b "Phase 7") " in " (:ref "guide/IMPLEMENTATION.md" "IMPLEMENTATION.md") ". The final goal is " (:b "complete wxWidgets coverage") ". A bounded first release is an intermediate milestone; neither the plan nor individual implemented slices satisfy final acceptance. All required missing and partial APIs remain work. Coverage implementation has its own phases " (:b "C1–C7") " below, distinct from release roadmap numbering.") (:heading 2 "Scope and inventory") (:p "Target: the published wxWidgets " (:b "3.2.12") " API, the version recorded by the project's existing local verification. CMake currently accepts 3.2 or newer; this inventory does not claim to cover APIs added after 3.2.12. When advancing the coverage target, regenerate and review the inventory delta explicitly.") (:p "The authoritative inventory is upstream's " (:link "https://github.com/wxWidgets/wxWidgets/tree/v3.2.12/interface/wx" "`v3.2.12/interface/wx`") ", not just the " (:code "core") " and " (:code "base") " components currently linked by this bridge. Extracted declarations retain the upstream " (:code "wxWindows Library Licence (coverage/UPSTREAM-LICENCE.txt)") " and its " (:code "GNU Library GPL terms (coverage/UPSTREAM-LGPL.txt)") ". The checked-in " (:code "manifest (coverage/manifest.json)") " records every header's SHA-256, phase and entry count. The " (:ref "guide/docs/coverage/README.md" "generated coverage summary") " gives current implemented, partial and pending counts by phase and header. The " (:code "class/widget index (coverage/classes.md)") " lists every class/struct definition found there. Each C-phase links to the full source checklist: methods, constructors, destructors, overloads, operators, free functions, callback types, enums, constants, macros, templates, and documented style/event table entries. Supporting source chunks are retained conservatively as context without checkboxes; entry counts are " (:b "not counts of distinct functions") ". No platform branch is preprocessed away. Each entry links to its upstream source line.") (:p "This is a complete inventory of the pinned " (:b "interface headers") ", not proof that these documentation headers contain every public symbol in the full wxWidgets source tree. The final reconciliation task below must resolve any additional documented public API, generated declarations, port headers and inherited interfaces before claiming full wxWidgets support. Undocumented implementation internals are not binding requirements. Deprecated public APIs remain visible; any decision to omit an API must be recorded explicitly rather than checked off as implemented. APIs unavailable on a particular port remain required on their supported ports. Optional components need selectable builds, feature detection and clear unavailable-feature errors.") (:heading 2 "Status rules") (:list (:item (:p (:code "[x]") " in the baseline below means the " (:b "named, bounded operation") " exists in the"))) (:p "current native bridge, FFI and exported Lisp API. It does not mean the whole upstream class or every constructor option is supported, or that all platforms passed.") (:list (:item (:p "In generated checklists, " (:code "[x]") " means the declaration's operation is implemented"))) (:p "with its stated Lisp mapping, " (:code "[~]") " means partial support with the supported arguments/receivers and remaining limits stated inline, and " (:code "[ ]") " means pending. The class index uses " (:code "[~]") " for the managed " (:code "wxAppConsole") "/" (:code "wxApp") " interfaces, " (:code "wxEvtHandler") ", eight bound widgets, " (:code "wxBoxSizer") ", " (:code "wxWindow") " and " (:code "wxTopLevelWindow") "; none has complete class coverage. Applications have lifecycle functions and a borrowed application-handler view; native application construction and subclass hooks remain unbound. Constructors with fixed IDs/styles remain partial.") (:list (:item (:p (:code "status.json (coverage/status.json)") " is the persistent source of declaration and"))) (:p "class statuses, Lisp exports, native ABI names and supported scopes. Exact header/line/signature matching prevents silently transferring a mark to the wrong overload. The generator rejects missing/stale or duplicate mappings, unknown Lisp/native names, and overlapping phase assignments.") (:list (:item (:p "Conditional directives, includes, include guards and inline implementation"))) (:p "statements are labeled " (:b "Context") " without checkboxes. Public macro definitions and constants remain API tasks. Context is retained for platform interpretation and is counted separately in the manifest.") (:list (:item (:p "The baseline is based on " (:code "native/wxlambda.{h,cpp}") ", " (:code "lisp/{ffi,api,package}.lisp")))) (:p "and existing tests. Historical test results remain in the implementation plan; no GUI or hosted-platform checks were rerun for this documentation change.") (:list (:item (:p "For each binding, record the Lisp name, native ABI entry, supported arguments,"))) (:p "return values, receiver types, ownership, events, platform availability and focused verification before closing its full declaration. One mapping can implement several overloads when all semantics remain expressible.") (:list (:item (:p "C++ conveniences may map to Lisp strings, numbers, sequences, conditions or"))) (:p "scoped resource forms instead of literal C++ wrappers. Such equivalences require an explicit mapping, including Unicode, range and lifetime behavior.") (:heading 2 "Current gaps and final acceptance") (:p "Use the " (:ref "guide/docs/coverage/README.md" "generated phase/header backlog") " for counts and the linked C1–C7 checklists for exact declarations. " (:code "[ ]") " means no public binding is recorded; " (:code "[~]") " means only the annotated scope exists, and its missing portion remains required. A class marked partial is not complete because its constructor works. Context, class-definition and declaration counts must not be interpreted as percentages of distinct wxWidgets APIs.") (:p "Current implementation is limited to managed application/event-dispatch APIs, standalone event-handler ownership/state, command/close observer/contextual bindings and queuing, and eight concrete widget kinds with a subset of inherited/layout/control APIs. C1 remains the active priority: event-handler ownership/state now has bounded support. Generic bindings, scoped Skip/propagation and copied native type IDs cover command and close kinds. Checked close veto is implemented; registered notify support is also implemented. Native notify subclasses, the borrowed application handler view is implemented; session bindings/metadata and isolated synthetic routing are implemented; native OS delivery remains unverified, then timer/idle and worker dispatch, with required value and lifetime contracts first. C2 remains partial; C3–C7 have no public bindings recorded. See the " (:code "C1 details (coverage/phase-c1.md)") ", " (:code "C2 details (coverage/phase-c2.md)") " and " (:code "class index (coverage/classes.md)") " for the remaining work within bound families.") (:p "The current bridge is ABI 29, with 126 public Lisp exports. The handler-client-data batch passes 46 GUI scenarios on both local Apple Silicon macOS SBCL/CCL configurations and five packaging checks. These are local results retained under " (:code "evidence/handler-client-data/{sbcl,ccl}-20261028/") " and " (:code "evidence/packaging/handler-client-data-20261028-final/") "; they do not validate Linux/Windows or the graphical Cadre viewer. The handler-client-data implementation reruns the GUI suites; documentation-only updates must distinguish retained results from newly run checks.") (:p "Full coverage is finished only when:") (:list (:item (:p "All required C1–C7 declarations, constructor options, overloads, styles/events,"))) (:p "inherited APIs and native subclass/virtual-callback behavior are implemented or covered by documented, verified equivalent Lisp mappings.") (:list (:item (:p "No required API remains pending, partial or explicitly unsupported. An"))) (:p "unsupported decision records a gap; it does not close one.") (:list (:item (:p "C7 reconciliation covers documented public APIs beyond these interface headers,"))) (:p "including generated declarations, port headers and optional build components.") (:list (:item (:p "Applicable platform/Lisp/backend combinations pass behavior, lifetime, callback,"))) (:p "Unicode and packaging checks; unavailable local runners do not close port work.") (:list (:item (:p "Public reference, guides, runnable examples and the Cadre docset match the"))) (:p "complete implementation, with zero docset checker problems and verified viewer discovery, symbol lookup and guide/example navigation.") (:heading 2 "Already implemented: bounded baseline") (:p "All entries here are checked only for the behavior stated. None of the eight widget classes has complete wxWidgets coverage yet.") (:heading 3 "C1: Application and bridge") (:list (:item (:p "[x] Native loading: " (:code "load-native-library") "; explicit-path packaged loading."))) (:list (:item (:p "[x] Application initialization/cleanup: " (:code "call-with-application") ", " (:code "with-application") "."))) (:list (:item (:p "[x] Main loop and stopping: " (:code "run") ", " (:code "stop") "."))) (:list (:item (:p "[x] Nonblocking event polling: " (:code "process-events") "."))) (:list (:item (:p "[x] Active-application main-loop/queued-event state: " (:code "main-loop-running-p") ","))) (:p (:code "pending-events-p") "; explicit wx pending dispatch: " (:code "process-pending-events") ". These do not complete arbitrary wxApp/event-loop bindings. All dispatch entries reject pump/callback reentrancy; see " (:ref "guide/docs/APPLICATION-EVENTS.md" "application events") ".") (:list (:item (:p "[x] Interactive application loop and debugger return: " (:code "with-repl-application") ","))) (:p (:code "return-to-application-repl") " (SBCL/CCL; one GUI session per process).") (:list (:item (:p "[x] Native-backed standalone " (:code "event-handler") " ownership, borrowed window base"))) (:p "identities, " (:code "handler-alive-p") ", " (:code "handler-enabled-p") " and its generic SETF writer, plus " (:code "destroy-event-handler") " for standalone objects. Weak window tracking prevents stale pointer access when destroy-event delivery is disabled. Arbitrary event types and pushed-handler ownership remain open; see " (:ref "guide/docs/EVENT-HANDLERS.md" "event-handler scope") ".") (:list (:item (:p "[x] Independent " (:code "bind-event") "/" (:code "unbind-event") " and " (:code "binding-active-p") ", with"))) (:p "four-kind command observers, exact IDs/ranges, safe self/peer removal, and " (:code "queue-event") " on standalone/window handlers. " (:code "event-id") " is a copied native ID; " (:code "event-source") " is the registered receiver, including on parent observers. Observers Skip automatically; optional contextual bindings now explicitly control Skip and propagation. Arbitrary event families and veto remain open; see " (:ref "guide/docs/EVENT-BINDINGS.md" "supported binding scope") ".") (:list (:item (:p "[x] Borrowed " (:code "event-context") " values from " (:code "bind-event :with-context t") ", with"))) (:p (:code "event-skipped-p") " SETF, " (:code "event-propagates-p") ", stop/resume actions, nested callback isolation and stale-context checks. " (:code "event-native-type") " copies runtime IDs; " (:code "event-type") " looks up four supported tags. See " (:ref "guide/docs/EVENT-CONTEXTS.md" "scoped context limits") "; close-veto is now scoped and CanVeto-guarded.") (:list (:item (:p "[x] " (:code ":close") " / wxCloseEvent family, immutable " (:code "event-family") " and close flags,"))) (:p "scoped " (:code "event-can-veto-p") " / " (:code "event-vetoed-p") " with generic SETF, copied close queues and frame-only " (:code "close-window") " requests. " (:code "event-type") " replaces the old command-only lookup. Notify/session events and arbitrary families remain open; see " (:ref "guide/docs/CLOSE-EVENTS.md" "close-event limits") ".") (:list (:item (:p "[x] " (:code "register-event-type") " for unique session command/notify names, copied"))) (:p (:code "event-integer") "/text metadata, scoped notify Veto/Allow and " (:code "process-event") " with native handled plus final-veto results. No unregister or type-declaration rollback; session-event routing remains open. See " (:ref "guide/docs/NOTIFY-EVENTS.md" "notify limits") ".") (:list (:item (:p "[x] Borrowed " (:code "application-handler") " identity via " (:code "current-application-handler") ", with inherited binding/dispatch/state and rejected construction/destruction. Native application hooks and session routing remain open."))) (:list (:item (:p "[x] Query/end-session tags, current/saved " (:code "event-logging-off-p") ", scoped SETF, application bindings and isolated owned-handler synthetic queues/dispatch. Real OS delivery and native shutdown policy validation remain open."))) (:list (:item (:p "[x] Copied/current event timestamp and native command classification, bounded native LONG timestamp SETF and close-family CanVeto SETF. Snapshot immutability and scoped lifetime remain enforced."))) (:list (:item (:p "[x] Current event-ID reads and SETF with signed bounds, unchanged snapshots and verified later parent exact/range/wildcard matching."))) (:list (:item (:p "[x] Current native type reads and captured/current opaque origin IDs for registered bridge objects. Native origin/type writers, general wxObject wrappers and ownership remain open."))) (:list (:item (:p "[x] Saved/current event category and compiled :UI/:USER-INPUT/:SOCKET/:TIMER/:THREAD/:ALL mask lookup. ALL includes actual native bits; category-specific families and YieldFor remain open."))) (:list (:item (:p "[x] Registered same-family event-native-type SETF with actual native class checks; built-in/session/unknown tags reject. Origin retention and arbitrary tag mutation remain open."))) (:list (:item (:p "[x] OWNED-EVENT construction/cloning/disposal/liveness, generic command text/integer SETF and copy-based native dispatch. Exact native classes and detached origins only; arbitrary classes, retained origin, source transfer and client/userData ownership remain open."))) (:list (:item (:p "[x] GUI POST-EVENT copies, consuming TRANSFER-EVENT handoff, PROCESS-EVENT-LOCALLY copies and non-application DELETE-PENDING-EVENTS with pending-list synchronization. Worker posting, app-wide deletion and per-handler pending processing remain open."))) (:list (:item (:p "[x] Standalone handler NEXT/PREVIOUS peer readers and reciprocal SETF, HANDLER-UNLINKED-P and UNLINK-EVENT-HANDLER. Strong canonical roots preserve wrapper identity; dispatch-time edits and borrowed window/app chains reject. Native Push/Pop/Remove remain open."))) (:list (:item (:p "[x] Managed window Get/Push/Pop/RemoveEventHandler and explicit ProcessWindowEvent/Locally copies. Push preserves bridge ownership; actual native window destruction detaches handlers. External stack adoption/SetEventHandler remain open."))) (:list (:item (:p "[x] Native extra LONG and raw IsSelection metadata, kind-specific live checked/selection SETF and clear-only compatible registered origin detachment. Retained/new origins and full derived-class payload semantics remain open."))) (:list (:item (:p "[x] Managed EVENT-HANDLER-CLIENT-DATA EQ Lisp storage through typed native root-token adapters, with foreign typed/untyped rejection. Generic wxClientData/container, untyped/event/item/userData ownership remain open."))) (:list (:item (:p "[x] Native errors translated to Lisp " (:code "native-error") " conditions."))) (:list (:item (:p "[x] Event snapshots: " (:code "event") ", " (:code "event-p") ", " (:code "event-kind") ", " (:code "event-source") ","))) (:p (:code "event-text") ", " (:code "event-checked-p") ", " (:code "event-selection") " for four command kinds plus :close.") (:heading 3 "C2: Windows, controls and layout") (:list (:item (:p "[x] " (:code "wxFrame") ": " (:code "make-frame") " with title, width and height."))) (:list (:item (:p "[x] " (:code "wxPanel") ": " (:code "make-panel") " with parent."))) (:list (:item (:p "[x] " (:code "wxButton") ": " (:code "make-button") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxTextCtrl") ": " (:code "make-text") " with parent and initial value."))) (:list (:item (:p "[x] " (:code "wxStaticText") ": " (:code "make-label") " with parent and label."))) (:list (:item (:p "[x] " (:code "wxCheckBox") ": " (:code "make-checkbox") " with parent, label and initial boolean value."))) (:list (:item (:p "[x] " (:code "wxChoice") ": " (:code "make-choice") " with copied item strings and initial selection."))) (:list (:item (:p "[x] Static-text label get/set: " (:code "label-text") ", " (:code "(setf label-text)") " (not all controls)."))) (:list (:item (:p "[x] Text value get/set: " (:code "text") ", " (:code "(setf text)") "; silent " (:code "ChangeValue") " versus"))) (:p "notifying " (:code "SetValue") " for " (:code "wxTextCtrl") ".") (:list (:item (:p "[x] Checkbox boolean get/set: " (:code "checked-p") ", " (:code "(setf checked-p)") ", optional notification."))) (:list (:item (:p "[x] Progress gauges: native-backed " (:code "gauge") " construction, " (:code "make-gauge") ","))) (:p (:code "gauge-value") ", " (:code "gauge-range") ", " (:code "gauge-vertical-p") " and " (:code "pulse-gauge") ". Both numeric properties have generic SETF writers; range reductions clamp progress.") (:list (:item (:p "[x] Choice index get/set: " (:code "selection") ", " (:code "(setf selection)") ", optional notification;"))) (:p "Lisp NIL means no selection. Item mutation and three-state checkboxes remain open.") (:list (:item (:p "[x] Parent-owned horizontal/vertical " (:code "wxBoxSizer") ": " (:code "make-row") ", " (:code "make-column") "."))) (:list (:item (:p "[x] Add window children: " (:code "add-child") " with proportion, uniform border, expand and"))) (:p "minor-axis alignment; nested standalone sizers and full flags remain open.") (:list (:item (:p "[x] Fixed/stretch spacing: " (:code "add-spacer") ", " (:code "add-stretch") "."))) (:list (:item (:p "[x] Relayout and geometry queries: " (:code "layout-window") ", " (:code "window-position") ", " (:code "window-size") "."))) (:list (:item (:p "[x] Logical name get/set: " (:code "window-name") ", " (:code "(setf window-name)") ", with copied Unicode"))) (:p "strings and explicit byte lengths preserving empty and embedded-NUL names.") (:list (:item (:p "[x] Frame title get/set: " (:code "frame-title") ", " (:code "(setf frame-title)") "; other top-level"))) (:p "receiver types remain unbound and their declarations are marked partial.") (:list (:item (:p "[x] Show/hide: " (:code "show-window") " accepts an optional boolean and returns the window"))) (:p "plus the native changed-state boolean; " (:code "shown-p") " queries its own shown flag.") (:list (:item (:p "[x] Enable/disable input: " (:code "enable-window") " returns the window plus changed-state"))) (:p "boolean; " (:code "enabled-p") " includes disabled ancestors.") (:list (:item (:p "[x] Destruction requests: " (:code "destroy-window") "; destruction notifications remain open."))) (:list (:item (:p "[x] Button bind/unbind/post: " (:code "on-click") ", " (:code "off-click") ", " (:code "queue-click") "."))) (:list (:item (:p "[x] Text-change bind/unbind: " (:code "on-text-change") ", " (:code "off-text-change") "."))) (:list (:item (:p "[x] Checkbox toggle bind/unbind: " (:code "on-toggle") ", " (:code "off-toggle") "."))) (:list (:item (:p "[x] Choice selection bind/unbind: " (:code "on-selection") ", " (:code "off-selection") "."))) (:list (:item (:p "[x] Handler replacement and callback condition containment for those events;"))) (:p "explicit unbinding of control-specific callbacks before window destruction is still required; generic registrations use weak invalidation and boundary pruning.") (:p "No APIs in C3–C7 currently have public bindings. Using wxWidgets types internally for conversions or implementation is not public API coverage.") (:p "The widget-facing Lisp API has nine window wrapper classes plus the public event-handler base, direct native construction, 55 named generic functions and thirteen SETF generic functions; see " (:ref "guide/docs/CLOS-API.md" "CLOS API") ". This establishes Lisp dispatch and method combination, not native C++ subclass/virtual-callback coverage.") (:heading 2 "Coverage implementation phases") (:p "These phases group " (:b "all") " headers in the manifest; the linked lists are the individual widget/function work items, not examples of an unspecified larger set. Within a phase, implement prerequisite value types and base classes before their consumers. A cross-phase dependency can be pulled forward without marking the entire dependent phase complete.") (:heading 3 "C1: Foundation, values, application, events, and base utilities") (:p (:code "Full C1 declaration checklist (coverage/phase-c1.md)")) (:p "The next dependency chain starts with application dispatch boundaries (now implemented for the bridge session), then event-handler ownership/state (bounded support implemented) and generic binding (four-kind observer support implemented), then timer/idle/propagation support and worker-to-GUI dispatch. Prerequisite value and ownership contracts must precede each consumer. Application dispatch does not close the broader application or event checklist.") (:list (:item (:p "[ ] Complete application traits, initialization, event loops, generic"))) (:p (:code "wxEvtHandler") " binding/unbinding, event filters,ok  event classes, propagation, veto/skip, idle processing, timers and thread-to-GUI dispatch.") (:list (:item (:p "[ ] Complete object/type information, client data, strings/encodings, buffers,"))) (:p "arrays/containers, variants/any, numeric/date/time types and conversions.") (:list (:item (:p "[ ] Complete base utilities: files/directories/paths, streams, archives and"))) (:p "compression, configuration, persistence prerequisites, logging/debugging, processes, dynamic libraries, environment/system utilities and command lines.") (:list (:item (:p "[ ] Complete networking, protocols, web requests, IPC, threading/synchronization,"))) (:p "translation/locales, regular expressions, security/secret storage and platform info.") (:list (:item (:p "[ ] Define ownership, borrowed values, invalidation, subclass/virtual dispatch,"))) (:p "callback lifetimes, thread restrictions and ABI compatibility for expanded APIs.") (:heading 3 "C2: Windows, layout, basic controls, and input") (:p (:code "Full C2 declaration checklist (coverage/phase-c2.md)")) (:list (:item (:p "[ ] Finish existing eight widget classes, all constructor options and inherited APIs."))) (:list (:item (:p "[ ] Complete window/top-level/control bases: parenting, IDs, focus, capture,"))) (:p "enable/show/hide, sizing/positioning, scrolling, styles, colours/fonts, DPI, tooltips, accessibility hooks and lifecycle notifications.") (:list (:item (:p "[x] Add bounded wxGauge construction, range/value properties, orientation query"))) (:p "and indeterminate pulsing; see " (:ref "guide/docs/GAUGE.md" "the gauge guide") ". Advanced gauge constructor options and inherited interfaces remain open.") (:list (:item (:p "[ ] Bind every remaining C2 widget in the class index: bitmap/command-link/toggle"))) (:p "buttons, radio controls, combos, list/checklist boxes, sliders, spin controls, pickers, date/time/calendar, search, static controls and other controls.") (:list (:item (:p "[ ] Complete all sizer families/items/flags, nested layouts, splitters,"))) (:p "scrolled/virtual windows, validators, keyboard/mouse and control-specific events.") (:heading 3 "C3: Dialogs, navigation, menus, and application services") (:p (:code "Full C3 declaration checklist (coverage/phase-c3.md)")) (:list (:item (:p "[ ] Complete modal/modeless and standard dialogs, custom file-dialog controls,"))) (:p "wizards, preferences and help APIs.") (:list (:item (:p "[ ] Complete menus/items, toolbars/status bars, books/notebooks, popups,"))) (:p "mini/MDI windows, notifications/taskbar and splash windows.") (:list (:item (:p "[ ] Complete clipboard/data formats, drag/drop, art/stock resources,"))) (:p "display/settings, accessibility and UI action simulation.") (:heading 3 "C4: Models, complex controls, and document frameworks") (:p (:code "Full C4 declaration checklist (coverage/phase-c4.md)")) (:list (:item (:p "[ ] Complete list/tree/tree-list/data-view/grid controls and all related models,"))) (:p "renderers, editors, selection, sorting, virtual data and event classes.") (:list (:item (:p "[ ] Complete headers/columns, image lists and item attributes."))) (:list (:item (:p "[ ] Complete document/view, document MDI, command/undo and persistent-object APIs."))) (:heading 3 "C5: Drawing, images, graphics, and printing") (:p (:code "Full C5 declaration checklist (coverage/phase-c5.md)")) (:list (:item (:p "[ ] Complete geometry/transforms, colours, pens/brushes/fonts, cursors/regions,"))) (:p "bitmap bundles/icons/images, image handlers, animation and raw pixel access.") (:list (:item (:p "[ ] Complete every DC/backend, graphics contexts/paths, overlays, native renderer,"))) (:p "text metrics, paint events and buffered drawing with scoped resource ownership.") (:list (:item (:p "[ ] Complete print/page setup/preview, print data and platform print integration."))) (:heading 3 "C6: Optional libraries, rich content, and integration") (:p (:code "Full C6 declaration checklist (coverage/phase-c6.md)")) (:list (:item (:p "[ ] Complete AUI docking, ribbons, property grids and related managers/events."))) (:list (:item (:p "[ ] Complete HTML, rich text and Styled Text Control, including editing models,"))) (:p "commands, styles, printing and callbacks.") (:list (:item (:p "[ ] Complete XML/XRC resource loading and custom handlers."))) (:list (:item (:p "[ ] Complete web views/handlers, media/sound, OpenGL contexts and rich tooltips."))) (:list (:item (:p "[ ] Extend component selection/builds beyond current " (:code "core") "/" (:code "base") ", and document"))) (:p "native dependencies, backend availability and packaging for each optional library.") (:heading 3 "C7: Platform extensions and remaining portability APIs") (:p (:code "Full C7 declaration checklist (coverage/phase-c7.md)")) (:list (:item (:p "[ ] Complete Windows-specific interface declarations, native-window embedding,"))) (:p "DDE, dial-up, joystick and power APIs on their applicable platforms.") (:list (:item (:p "[ ] Reconcile the interface-header inventory against upstream public headers,"))) (:p "generated API documentation, event/style tables and build options; inventory and phase any additional public widgets/functions discovered before closure.") (:list (:item (:p "[ ] Audit inherited APIs and all overloads, enum values, style combinations,"))) (:p "virtual overrides, callback signatures and ownership across every class.") (:list (:item (:p "[ ] Run binding, GUI, Unicode, callback/lifetime and packaged-application checks"))) (:p "on supported OS/Lisp combinations; record feature-specific skips and reasons.") (:list (:item (:p "[ ] Publish the supported API/feature matrix and resolve every remaining item"))) (:p "as implemented, equivalent Lisp mapping, or explicitly unsupported. Unsupported required APIs prevent claiming full coverage; they are not completed bindings.") (:heading 2 "Completion and maintenance") (:p "Focused generator/inventory verification (using the same extracted sources):") (:code-block "sh" "python3 tests/coverage-inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "Each phase closes only when its detailed inventory is reviewed and its required bindings have public Lisp exports, native/FFI mappings, matching documentation, required runnable examples, docset updates, and focused positive/error/lifetime/ event checks. Follow the " (:code "project implementation rule (../AGENTS.md)") " for every implementation change: build the Cadre-format version 1 docset in " (:code "docs/docset/") " (" (:code "manifest.sexp") ", " (:code "index.sexp") ", " (:code "entries.sexp") "), containing the indexed reference for every implemented public wxlambda export, project guides and explained example sources together. Run the relevant examples, require zero problems from " (:code "docset:check-docset") ", and verify export coverage, links and Cadre discovery, symbol lookup and guide/example navigation. The docset is the primary documentation deliverable. The initial Phase 7 build prerequisite is implemented in " (:ref "guide/docs/DOCSET.md" "the docset tooling") "; maintain the generated artifact with each implementation change. Platform-only work must be verified on its supported platform; local macOS success cannot close Linux/Windows work. Existing Phase 3 hosted checks remain pending.") (:p "To reproduce the baseline inventory, extract the pinned release's " (:code "interface/") " directory and run:") (:code-block "sh" "python3 tools/coverage_inventory.py /path/to/wxWidgets-3.2.12/interface") (:p "The generator is documentation-only and does not require an installed wxWidgets build. Multiline preprocessor directives are kept together so their parentheses do not swallow following classes or function declarations. It preserves source declarations rather than attempting C++ semantic resolution; declaration fragments and helper tokens intentionally remain visible. Compare the resulting header hashes with the committed manifest when verifying the same source version. Update " (:code "docs/coverage/status.json") " when implementing bindings; regeneration preserves those marks in the function lists and class index. Do not edit generated checkboxes directly. A new upstream version requires reviewing and migrating the exact declaration mappings before regeneration.") (:p "Native pending-list synchronization uses an implementation-header management method absent from the pinned documentation interface and remains a C7 reconciliation dependency; target cancellation does not close app-wide deletion.") (:p "Paired NIL standalone edge-detach semantics follow native implementation/Unlink behavior although the pinned setter prose forbids NULL; retain that discrepancy for C7 reconciliation.") (:p "Native window teardown requires pushed handlers to be removed; managed native widget destructors pop without deleting bridge-owned handlers before base teardown.") (:p "Raw IsSelection reports extra-LONG action metadata, not event kind or choice-index validity; origin mutation remains NIL-only and never retains a native object.") (:p "The ABI 29 handler-client-data batch expands the runner to 46 scenarios. Local GUI/package checks, the zero-assert native guard regression and independent review pass. Protected wxEvtHandler storage-mode inspection avoids typed/untyped native assertions; it is an implementation-header C7 dependency, not a public field/mode API."))))
(:entry "guide/docs/coverage/README.md" :names ("docs/coverage/README.md" "README") :kind :guide :kind-name "Guide" :summary "docs/coverage/README.md" :sections (("Guide" (:heading 1 "wxWidgets coverage summary") (:p "Generated by " (:code "tools/coverage_inventory.py") " from wxWidgets 3.2.12 interface headers and " (:code "status.json (status.json)") ". " (:ref "guide/docs/WXWIDGETS-COVERAGE.md" "Coverage goal and status rules") ".") (:p "The goal is complete wxWidgets coverage. Every pending entry and the unsupported portion of every partial entry remains required work. A bounded release or a completed slice does not complete this inventory. Required APIs recorded as unsupported still prevent a full-coverage claim.") (:p "Counts are source-inventory tasks, including declarations, overloads, classes, styles and event tables; they are not distinct API counts or percent completion. Context is excluded from tasks. Class-definition counts overlap declaration tasks and must not be added to them. Full coverage also requires the upstream public-header/documentation reconciliation and platform verification in C7.") (:heading 2 "Phases") (:table :header (("Phase") ("Headers") ("Tasks") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "C1: Foundation, values, application, events, and base utilities (phase-c1.md)")) ("119") ("5292") ("5") ("79") ("5208") ("26")) (((:code "C2: Windows, layout, basic controls, and input (phase-c2.md)")) ("82") ("2862") ("23") ("46") ("2793") ("0")) (((:code "C3: Dialogs, navigation, menus, and application services (phase-c3.md)")) ("57") ("1875") ("0") ("0") ("1875") ("0")) (((:code "C4: Models, complex controls, and document frameworks (phase-c4.md)")) ("20") ("2328") ("0") ("0") ("2328") ("4")) (((:code "C5: Drawing, images, graphics, and printing (phase-c5.md)")) ("52") ("2245") ("0") ("0") ("2245") ("0")) (((:code "C6: Optional libraries, rich content, and integration (phase-c6.md)")) ("57") ("8912") ("0") ("0") ("8912") ("380")) (((:code "C7: Platform extensions and remaining portability APIs (phase-c7.md)")) ("11") ("279") ("0") ("0") ("279") ("3")) (("Total") ("398") ("23793") ("28") ("125") ("23640") ("413")))) (:heading 2 "Classes and widgets") (:p "1016 class/struct definitions: 0 complete; 19 partial; 997 pending.") (:p "See the " (:code "complete class/widget index (classes.md)") " for partial scopes and missing types. An implemented constructor does not complete a class or its inherited API.") (:heading 2 "Header backlog") (:p "Use each linked header section to see the exact missing and partial declarations. A zero pending count alone cannot close a header with partial entries or unreviewed inherited/platform behavior.") (:heading 3 "C1: Foundation, values, application, events, and base utilities") (:table :header (("Header") ("Implemented") ("Partial") ("Pending") ("Context")) :rows ((((:code "wx/any.h (phase-c1.md#wxanyh)")) ("0") ("0") ("62") ("0")) (((:code "wx/app.h (phase-c1.md#wxapph)")) ("0") ("11") ("93") ("0")) (((:code "wx/appprogress.h (phase-c1.md#wxappprogressh)")) ("0") ("0") ("7") ("0")) (((:code "wx/apptrait.h (phase-c1.md#wxapptraith)")) ("0") ("0") ("15") ("0")) (((:code "wx/archive.h (phase-c1.md#wxarchiveh)")) ("0") ("0") ("55") ("0")) (((:code "wx/arrstr.h (phase-c1.md#wxarrstrh)")) ("0") ("0") ("49") ("0")) (((:code "wx/atomic.h (phase-c1.md#wxatomich)")) ("0") ("0") ("2") ("0")) (((:code "wx/base64.h (phase-c1.md#wxbase64h)")) ("0") ("0") ("11") ("0")) (((:code "wx/buffer.h (phase-c1.md#wxbufferh)")) ("0") ("0") ("59") ("0")) (((:code "wx/chartype.h (phase-c1.md#wxchartypeh)")) ("0") ("0") ("8") ("0")) (((:code "wx/clntdata.h (phase-c1.md#wxclntdatah)")) ("0") ("3") ("17") ("0")) (((:code "wx/cmdline.h (phase-c1.md#wxcmdlineh)")) ("0") ("0") ("70") ("0")) (((:code "wx/config.h (phase-c1.md#wxconfigh)")) ("0") ("0") ("70") ("0")) (((:code "wx/convauto.h (phase-c1.md#wxconvautoh)")) ("0") ("0") ("12") ("0")) (((:code "wx/cpp.h (phase-c1.md#wxcpph)"))