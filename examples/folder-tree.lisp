(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-folder-tree (:use #:cl) (:export #:exercise #:start #:icon))
(in-package #:wxlambda-folder-tree)
(defun icon (colour)
  (let ((rgb (make-array (* 16 16 3) :element-type '(unsigned-byte 8) :initial-element 0))
        (alpha (make-array (* 16 16) :element-type '(unsigned-byte 8) :initial-element 0)))
    (loop for y from 3 below 13 do (loop for x from 3 below 13 for pixel = (+ x (* y 16)) do
      (setf (aref alpha pixel) 255)
      (loop for channel in colour for offset from 0 do (setf (aref rgb (+ (* pixel 3) offset)) channel))))
    (let ((image (wxlambda:make-image :width 16 :height 16 :rgb rgb :alpha alpha)))
      (unwind-protect (wxlambda:make-bitmap :image image) (wxlambda:destroy-image image)))))
(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title "Folder tree"))
         (tree (wxlambda:make-tree-control frame))
         (folder (icon '(210 155 55))) (file (icon '(150 95 220)))
         (root (wxlambda:add-tree-root tree "Project"))
         (item (wxlambda:append-tree-item root "example.lisp")))
    (unwind-protect
         (progn
           (setf (wxlambda:tree-icons tree) (list folder file)
                 (wxlambda:tree-item-icon root) 0 (wxlambda:tree-item-icon item) 1)
           (assert (= 1 (wxlambda:tree-item-icon item)))
           (let ((copies (wxlambda:tree-icons tree)))
             (unwind-protect (assert (= 2 (length copies)))
               (dolist (bitmap copies) (wxlambda:destroy-bitmap bitmap))))
           (let ((dialog (wxlambda:make-directory-dialog :parent frame :path (uiop:temporary-directory))))
             (unwind-protect (assert (uiop:directory-exists-p (wxlambda:directory-dialog-path dialog)))
               (wxlambda:destroy-window dialog))) t)
      (wxlambda:destroy-bitmap folder) (wxlambda:destroy-bitmap file)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Folder chooser"))
           (button (wxlambda:make-button frame :label "Open Folder…")))
      (wxlambda:on-click button
        (lambda ()
          (wxlambda:defer-ui-action
           (lambda ()
             (let ((dialog (wxlambda:make-directory-dialog :parent frame)))
               (unwind-protect
                    (when (eq :ok (wxlambda:show-modal dialog))
                      (setf (wxlambda:label-text button) (wxlambda:directory-dialog-path dialog)))
                 (wxlambda:destroy-window dialog)))) :owner frame)))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))))))
