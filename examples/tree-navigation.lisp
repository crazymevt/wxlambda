;;; START is interactive; EXERCISE runs within an active application session.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-tree-navigation (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-tree-navigation)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Managed tree navigation" :width 620 :height 460))
         (panel (wxlambda:make-panel frame)) (tree (wxlambda:make-tree-control panel))
         (root (wxlambda:add-tree-root tree "Workspace λ"))
         (folder (wxlambda:append-tree-item root "Documents"))
         (file (wxlambda:append-tree-item folder "日本語 😀.txt"))
         (allow (wxlambda:make-checkbox panel :label "Allow navigation" :checked t))
         (add (wxlambda:make-button panel :label "Append child to selection/root"))
         (remove (wxlambda:make-button panel :label "Delete selected subtree"))
         (status (wxlambda:make-label panel :label "Select an item")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame panel :proportion 1 :border 0)
    (wxlambda:make-column panel)
    (wxlambda:add-child panel tree :proportion 1)
    (dolist (child (list allow add remove status)) (wxlambda:add-child panel child))
    (setf (wxlambda:tree-item-expanded-p root) t (wxlambda:tree-item-expanded-p folder) t)
    (wxlambda:bind-event tree :tree-selection-changing
      (lambda (event context)
        (declare (ignore event))
        (unless (wxlambda:checked-p allow) (setf (wxlambda:event-vetoed-p context) t)))
      :with-context t)
    (wxlambda:bind-event tree :tree-selection-changed
      (lambda (event)
        (let ((item (wxlambda:event-tree-item event)))
          (setf (wxlambda:label-text status) (if item (wxlambda:tree-item-text item) "No selection")))))
    ;; Button callbacks run outside tree selection callbacks, so structural edits are safe.
    (wxlambda:on-click add
      (lambda ()
        (let* ((parent (or (wxlambda:selection tree) (wxlambda:tree-root tree)))
               (item (if parent (wxlambda:append-tree-item parent "New item")
                         (wxlambda:add-tree-root tree "Workspace λ"))))
          (when parent (setf (wxlambda:tree-item-expanded-p parent) t))
          (setf (wxlambda:selection tree :notify t) item))))
    (wxlambda:on-click remove
      (lambda ()
        (let ((item (wxlambda:selection tree)))
          (when item (wxlambda:delete-tree-item item)
                (setf (wxlambda:label-text status) "Subtree deleted")))))
    (values frame tree root folder file allow)))

(defun exercise ()
  (multiple-value-bind (frame tree root folder file allow) (build-window)
    (unwind-protect
         (progn
           (assert (eq root (wxlambda:tree-root tree)))
           (assert (eq folder (first (wxlambda:tree-item-children root))))
           (assert (eq folder (wxlambda:tree-item-parent file)))
           (setf (wxlambda:tree-item-text file) "Edited 日本語 😀")
           (assert (string= "Edited 日本語 😀" (wxlambda:tree-item-text file)))
           (setf (wxlambda:selection tree) root (wxlambda:checked-p allow) nil)
           (setf (wxlambda:selection tree :notify t) file)
           (assert (eq root (wxlambda:selection tree)))
           (setf (wxlambda:checked-p allow) t)
           (setf (wxlambda:selection tree :notify t) file)
           (assert (eq file (wxlambda:selection tree)))
           (wxlambda:delete-tree-item folder)
           (assert (not (wxlambda:tree-item-alive-p folder)))
           (assert (not (wxlambda:tree-item-alive-p file)))
           (assert (wxlambda:tree-item-alive-p root))
           (assert (eq root (wxlambda:selection tree)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame tree) (build-window)
      (declare (ignore tree))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
