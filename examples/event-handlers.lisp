;;; Load and call (wxlambda-event-handlers:start).
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-event-handlers
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-event-handlers)

(defclass named-handler (wxlambda:event-handler)
  ((name :initarg :name :reader name)
   (initially-enabled :reader initially-enabled))
  (:default-initargs :name "application-owned handler"))
(defmethod initialize-instance :after ((handler named-handler) &key)
  (setf (slot-value handler 'initially-enabled) (wxlambda:handler-enabled-p handler)))

(defun open-window ()
  (let* ((handler (wxlambda:make-event-handler :class 'named-handler))
         (frame (wxlambda:make-frame :title "Event handler ownership"))
         (panel (wxlambda:make-panel frame))
         (caption (wxlambda:make-label panel :label (name handler)))
         (target (wxlambda:make-button panel :label "Count events"))
         (toggle (wxlambda:make-button panel :label "Toggle target handler"))
         (clicks 0))
    (wxlambda:make-column panel)
    (dolist (child (list caption target toggle)) (wxlambda:add-child panel child))
    (wxlambda:on-click target
      (lambda () (incf clicks) (setf (wxlambda:label-text caption) (format nil "Events: ~D" clicks))))
    (wxlambda:on-click toggle
      (lambda ()
        (setf (wxlambda:handler-enabled-p target) (not (wxlambda:handler-enabled-p target)))))
    (wxlambda:show-window frame)
    ;; HANDLER is an independently owned object, not a pushed window handler.
    (values frame handler target toggle (lambda () clicks))))

(defun exercise ()
  (multiple-value-bind (frame handler target toggle clicks) (open-window)
    (assert (initially-enabled handler))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (assert (not (wxlambda:handler-enabled-p target)))
    (assert (wxlambda:enabled-p target))
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 1 (funcall clicks)))
    (wxlambda:queue-click toggle)
    (wxlambda:process-pending-events)
    (wxlambda:queue-click target)
    (wxlambda:process-pending-events)
    (assert (= 2 (funcall clicks)))
    (wxlambda:off-click target)
    (wxlambda:off-click toggle)
    (wxlambda:destroy-event-handler handler)
    (assert (not (wxlambda:handler-alive-p handler)))
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
