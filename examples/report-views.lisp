(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-report-views (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-report-views)
(defclass generated-report (wxlambda:list-control)
 ((prefix :initarg :prefix :reader prefix))
 (:default-initargs :virtual-p t :prefix "Generated λ"))
(defmethod wxlambda:list-item-text ((control generated-report) row column)
 (if (zerop column) (format nil "~A ~D" (prefix control) row) (format nil "~D" (* row row))))
(defun build-window ()
 (let* ((frame (wxlambda:make-frame :title "Native report and tree views" :width 900 :height 500))
        (splitter (wxlambda:make-splitter-window frame :sash-position 220))
        (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
        (tree (wxlambda:make-tree-control left))
        (report (wxlambda:make-list-control right :class 'generated-report))
        (feedback (wxlambda:make-label right :label "Activate a row or tree item")))
  (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :expand t)
  (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :expand t)
  (wxlambda:make-column right) (wxlambda:add-child right report :proportion 1 :expand t)
  (wxlambda:add-child right feedback :border 8)
  (wxlambda:split-window splitter left right)
  (wxlambda:insert-list-column report 0 "Generated row" :width 260)
  (wxlambda:insert-list-column report 1 "Square" :width 180)
  (setf (wxlambda:item-count report) 1000000)
  (let* ((root (wxlambda:add-tree-root tree "Views λ"))
         (child (wxlambda:append-tree-item root "One million virtual rows")))
   (setf (wxlambda:tree-item-bold-p root) t
         (wxlambda:tree-item-foreground child) #x28558a
         (wxlambda:tree-item-expanded-p root) t))
  (wxlambda:bind-event report :list-item-activated
   (lambda (event)
    (let ((row (wxlambda:event-list-index event)))
     (wxlambda:defer-ui-action
      (lambda () (setf (wxlambda:label-text feedback) (if row (wxlambda:list-item-text report row 0) "No native row"))) :owner report))))
  (wxlambda:bind-event tree :tree-item-activated
   (lambda (event)
    (let ((item (wxlambda:event-tree-item event)))
     (wxlambda:defer-ui-action
      (lambda () (when (and item (wxlambda:tree-item-alive-p item))
                   (setf (wxlambda:label-text feedback) (wxlambda:tree-item-text item)))) :owner tree))))
  (values frame report tree)))
(defun exercise ()
 (multiple-value-bind (frame report tree) (build-window)
  (unwind-protect
   (progn
    (wxlambda:show-window frame) (wxlambda:process-events)
    (assert (= 1000000 (wxlambda:item-count report)))
    (assert (string= "Generated λ 999999" (wxlambda:list-item-text report 999999 0)))
    (assert (string= "998001" (wxlambda:list-item-text report 999 1)))
    (setf (wxlambda:selection report) 500000)
    (assert (= 500000 (wxlambda:selection report)))
    (assert (wxlambda:tree-item-bold-p (wxlambda:tree-root tree))) t)
   (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
 (wxlambda:with-application ()
  (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
