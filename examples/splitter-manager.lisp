;;; START is interactive; EXERCISE runs inside an active GUI session.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-splitter-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-splitter-manager)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Two-pane tree/list manager" :width 760 :height 460))
         (splitter (wxlambda:make-splitter-window frame :sash-position 220 :minimum-pane-size 80 :sash-gravity 0.3d0))
         (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
         (tree (wxlambda:make-tree-control left))
         (root (wxlambda:add-tree-root tree "Workspace λ"))
         (documents (wxlambda:append-tree-item root "Documents"))
         (images (wxlambda:append-tree-item root "Images"))
         (items (wxlambda:make-list-box right))
         (status (wxlambda:make-label right :label "Select a folder"))
         (model (list (cons root '("All documents" "All images"))
                      (cons documents '("notes.txt" "日本語 😀.txt"))
                      (cons images '("diagram.png" "photo.jpg")))))
    (labels ((refresh (item)
               (wxlambda:clear-items items)
               (dolist (value (cdr (assoc item model :test #'eq))) (wxlambda:append-item items value))
               (setf (wxlambda:label-text status) (if item (wxlambda:tree-item-text item) "No folder"))))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame splitter :proportion 1 :border 0)
      (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :border 0)
      (wxlambda:make-column right) (wxlambda:add-child right items :proportion 1)
      (wxlambda:add-child right status)
      (wxlambda:split-window splitter left right)
      (setf (wxlambda:tree-item-expanded-p root) t)
      (refresh root)
      (wxlambda:bind-event tree :tree-selection-changed (lambda (event) (refresh (wxlambda:event-tree-item event))))
      (wxlambda:on-selection items (lambda (event) (setf (wxlambda:label-text status) (wxlambda:event-text event))))
      (wxlambda:bind-event splitter :splitter-sash-changed
        (lambda (event) (setf (wxlambda:frame-title frame)
                             (format nil "Two-pane manager — sash ~D" (wxlambda:event-sash-position event)))))
      (values frame splitter left right tree documents images items))))

(defun exercise ()
  (multiple-value-bind (frame splitter left right tree documents images items) (build-window)
    (unwind-protect
         (progn
           (assert (wxlambda:splitter-split-p splitter))
           (assert (eq left (wxlambda:splitter-pane splitter 0)))
           (assert (eq right (wxlambda:splitter-pane splitter 1)))
           (setf (wxlambda:selection tree :notify t) documents)
           (assert (string= "日本語 😀.txt" (wxlambda:item-text items 1)))
           (setf (wxlambda:selection tree :notify t) images)
           (assert (string= "photo.jpg" (wxlambda:item-text items 1)))
           (setf (wxlambda:splitter-sash-position splitter) 240)
           (wxlambda:process-events)
           (assert (plusp (wxlambda:splitter-sash-position splitter)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame splitter) (build-window)
      (declare (ignore splitter))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
