;;; START is interactive; EXERCISE runs inside an existing session.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-notebook (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-notebook)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Notebook navigation" :width 620 :height 440))
         (book (wxlambda:make-notebook frame))
         (editor (wxlambda:make-panel book))
         (settings (wxlambda:make-panel book))
         (text (wxlambda:make-text editor :multiline t :value (format nil "Editor page λ~%日本語 😀")))
         (allow (wxlambda:make-checkbox editor :label "Allow leaving this page" :checked t))
         (info (wxlambda:make-label settings :label "Settings page"))
         (back (wxlambda:make-button settings :label "Back to editor")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame book :proportion 1 :border 0)
    (wxlambda:make-column editor)
    (wxlambda:add-child editor text :proportion 1)
    (wxlambda:add-child editor allow)
    (wxlambda:make-column settings)
    (wxlambda:add-child settings info)
    (wxlambda:add-child settings back)
    (wxlambda:add-notebook-page book editor :label "Editor λ")
    (wxlambda:add-notebook-page book settings :label "Settings")
    (wxlambda:bind-event book :notebook-page-changing
      (lambda (event context)
        (declare (ignore event))
        (when (not (wxlambda:checked-p allow))
          (setf (wxlambda:event-vetoed-p context) t)))
      :with-context t)
    (wxlambda:bind-event book :notebook-page-changed
      (lambda (event)
        (setf (wxlambda:frame-title frame)
              (format nil "Notebook — page ~D" (wxlambda:event-selection event)))))
    (wxlambda:on-click back (lambda () (setf (wxlambda:selection book :notify t) 0)))
    (values frame book editor settings allow)))

(defun exercise ()
  (multiple-value-bind (frame book editor settings allow) (build-window)
    (unwind-protect
         (progn
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (assert (eq editor (wxlambda:notebook-page book 0)))
           (assert (eq settings (wxlambda:notebook-page book 1)))
           (setf (wxlambda:selection book) 0 (wxlambda:checked-p allow) nil)
           (setf (wxlambda:selection book :notify t) 1)
           (assert (= 0 (wxlambda:selection book)))
           ;; Programmatic veto does not require a later OS input event.
           (wxlambda:process-events)
           (assert (= 0 (wxlambda:selection book)))
           (setf (wxlambda:checked-p allow) t)
           (setf (wxlambda:selection book :notify t) 1)
           (assert (= 1 (wxlambda:selection book)))
           t)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame book) (build-window)
      (declare (ignore book))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
