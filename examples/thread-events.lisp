(require :asdf)
(asdf:load-asd (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-thread-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-thread-events)
(defun current-thread () #+sbcl sb-thread:*current-thread* #+ccl ccl:*current-process*)
(defun launch-worker (function)
  #+sbcl (sb-thread:make-thread function :name "wx copied-event worker")
  #+ccl (ccl:process-run-function "wx copied-event worker" function)
  #-(or sbcl ccl) (error "This example has thread adapters for SBCL/CCL"))
(defun join-worker (thread)
  #+sbcl (sb-thread:join-thread thread)
  #+ccl (ccl:join-process thread))
(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title "Worker event delivery"))
         (gui (current-thread)) (received nil) (worker nil)
         (payload (concatenate 'string "Worker λ" (string #\Null) "😀")))
    (unwind-protect
         (progn
           (wxlambda:bind-event frame :thread
             (lambda (event)
               (assert (eq gui (current-thread)))
               (assert (eq :base (wxlambda:event-family event)))
               (push (wxlambda:event-text event) received)))
           (wxlambda:show-window frame)
           (setf worker (launch-worker (lambda () (wxlambda:queue-thread-event frame payload))))
           (join-worker worker) (setf worker nil)
           (let ((expected (copy-seq payload)))
             (setf (char payload 0) #\X)
             (loop repeat 100 until received do (wxlambda:process-events) (sleep .005))
             (assert (equal (list expected) received))) t)
      (when worker (join-worker worker))
      (wxlambda:destroy-window frame))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Thread event example" :width 500 :height 180))
           (panel (wxlambda:make-panel frame))
           (status (wxlambda:make-label panel :label "Waiting for worker"))
           (worker nil))
      (wxlambda:make-column panel) (wxlambda:add-child panel status :border 16)
      (wxlambda:bind-event frame :thread
        (lambda (event) (setf (wxlambda:label-text status) (wxlambda:event-text event))))
      (unwind-protect
           (progn
             (wxlambda:show-window frame)
             (setf worker (launch-worker (lambda () (wxlambda:queue-thread-event frame "Copied worker result λ 😀"))))
             (wxlambda:run))
        (when worker (join-worker worker))))))
