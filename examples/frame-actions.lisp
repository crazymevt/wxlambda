;;; Shared menu/toolbar action IDs with application-owned status text.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-frame-actions (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-frame-actions)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Frame actions λ" :width 640 :height 360))
         (bar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame :fields 2))
         (menus (wxlambda:make-menu-bar frame))
         (actions (wxlambda:make-menu menus :label "&Actions"))
         (new (wxlambda:make-menu-item actions :id 2101 :label "&New"))
         (details (wxlambda:make-menu-item actions :id 2102 :label "&Details" :kind :check))
         (content (wxlambda:make-panel frame))
         (label (wxlambda:make-label content :label "Use New or Details in the toolbar or menu."))
         (count 0))
    (wxlambda:add-toolbar-tool bar 2101 "New" :art :new :help "Create an in-memory entry")
    (wxlambda:add-toolbar-separator bar)
    (wxlambda:add-toolbar-tool bar 2102 "Details" :art :information :kind :check)
    (wxlambda:realize-toolbar bar)
    (wxlambda:make-column content)
    (wxlambda:add-child content label :border 16)
    (setf (wxlambda:status-text status) "Ready λ" (wxlambda:status-text status 1) "Details off")
    (labels ((dispatch-action (event from-toolbar)
               (case (wxlambda:event-id event)
                 (2101 (incf count) (setf (wxlambda:status-text status) (format nil "Created ~D" count)))
                 (2102
                  (let ((checked (wxlambda:event-checked-p event)))
                    (setf (wxlambda:checked-p details) checked)
                    ;; Native tools toggle before dispatch. Menu actions must
                    ;; synchronize tool state; same-toolbar callback writes defer.
                    (unless from-toolbar (setf (wxlambda:tool-checked-p bar 2102) checked))
                    (setf (wxlambda:status-text status 1) (if checked "Details on" "Details off")))))))
      (wxlambda:bind-event bar :menu
        (lambda (event context) (declare (ignore context)) (dispatch-action event t))
        :id 2101 :last-id 2102 :with-context t) ; consume before frame propagation
      (wxlambda:bind-event frame :menu (lambda (event) (dispatch-action event nil))
        :id 2101 :last-id 2102))
    (values frame bar status new details)))

(defun exercise ()
  (multiple-value-bind (frame bar status new details) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (wxlambda:process-events)
           (assert (wxlambda:activate-toolbar-tool bar 2101))
           (assert (string= "Created 1" (wxlambda:status-text status)))
           (wxlambda:activate-menu-item new)
           (assert (string= "Created 2" (wxlambda:status-text status)))
           (wxlambda:activate-toolbar-tool bar 2102)
           (assert (wxlambda:checked-p details))
           (assert (string= "Details on" (wxlambda:status-text status 1)))
           (wxlambda:activate-menu-item details)
           (assert (not (wxlambda:tool-checked-p bar 2102)))
           (assert (string= "Details off" (wxlambda:status-text status 1)))
           (setf (wxlambda:tool-enabled-p bar 2101) nil)
           (assert (not (wxlambda:activate-toolbar-tool bar 2101)))
           t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
