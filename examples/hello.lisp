(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(wx:with-application ()
  (let* ((frame (wx:make-frame :title "Hello from Common Lisp"))
         (panel (wx:make-panel frame))
         (text (wx:make-text panel :value "Hello, wxWidgets — λ"))
         (button (wx:make-button panel :label "Click me"))
         (clicks 0))
    (wx:make-column panel)
    (wx:add-child panel text)
    (wx:add-child panel button)
    (wx:on-text-change text
      (lambda (event)
        (format t "Text edited: ~A~%" (wx:event-text event))))
    (wx:on-click button
      (lambda (event)
        (assert (eq button (wx:event-source event)))
        (format t "Text before click: ~A~%" (wx:text text))
        (setf (wx:text text :notify t) (format nil "Clicked ~D times" (incf clicks))))
      :with-event t)
    (wx:show-window frame)
    (wx:run)))
