;;; Retained drawing, native activity, and bounded safe-idle timer monitoring.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-drawing-monitor (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-drawing-monitor)
(defun badge-pixels ()
  (let ((pixels (make-array (* 16 16 4) :element-type '(unsigned-byte 8))))
    (dotimes (i 256 pixels)
      (let ((colour (if (evenp (+ (floor (floor i 16) 4) (floor (mod i 16) 4))) '(77 225 193) '(255 197 92))))
        (loop for byte in colour for j from 0 do (setf (aref pixels (+ (* i 4) j)) byte))
        (setf (aref pixels (+ (* i 4) 3)) (if (or (zerop (mod i 16)) (zerop (floor i 16))) 0 220))))))
(defun monitor-scene (tick width height)
  (let* ((width (max 320 (min width 1200))) (height (max 180 (min height 700)))
         (bottom (- height 30)) (graph-height (- bottom 78)) (span (- width 50))
         (items (list (list :text 20 14 "Signal monitor λ" 18 '(238 244 255))
                      (list :text 20 43 (format nil "Simulated samples / update ~D" tick) 10 '(160 178 203))
                      (list :rgba-bitmap (- width 40) 18 16 16 (badge-pixels))
                      (list :line 20 bottom (- width 20) bottom '(87 109 138) 1))))
    (dotimes (i 5)
      (let ((y (+ 78 (round (* i (/ graph-height 4))))))
        (push (list :line 20 y (- width 20) y '(37 51 72) 1) items)))
    (dotimes (i 32)
      (let* ((amplitude (+ 0.12d0 (* 0.82d0 (/ (+ 1d0 (sin (+ (* i 0.24d0) (* tick 0.20d0)))) 2d0))))
             (bar-height (max 1 (round (* amplitude graph-height))))
             (x (+ 24 (round (* i (/ span 32))))))
        (push (list :rect x (- bottom bar-height) (max 2 (- (floor span 32) 4)) bar-height '(77 225 193)) items)))
    (push (list :ellipse (- width 28) (- height 23) 8 8 '(255 197 92)) items)
    (list :background '(18 24 38) :items (nreverse items))))
(defun build-window (&key (interval 180) max-ticks)
  (let* ((frame (wxlambda:make-frame :title "Drawing / monitoring workflow" :width 680 :height 420))
         (panel (wxlambda:make-panel frame))
         (canvas (wxlambda:make-drawing-canvas panel))
         (indicator (wxlambda:make-activity-indicator panel))
         (toggle (wxlambda:make-button panel :label "Pause / Resume"))
         (feedback (wxlambda:make-label panel :label "Waiting for a native timer tick"))
         (timer nil) (count 0))
    (labels ((redraw ()
               (destructuring-bind (width height) (wxlambda:canvas-client-size canvas)
                 (setf (wxlambda:canvas-content canvas) (monitor-scene count width height))))
             (stop-monitor ()
               (when timer (wxlambda:cancel-ui-timer timer))
               (setf (wxlambda:activity-running-p indicator) nil
                     (wxlambda:label-text feedback) (format nil "Paused after ~D updates" count)))
             (begin ()
               (setf (wxlambda:activity-running-p indicator) t)
               (setf timer (wxlambda:start-ui-timer
                 (lambda ()
                   (incf count) (redraw)
                   (setf (wxlambda:label-text feedback) (format nil "Update ~D — retained scene, no paint callback" count))
                   (when (and max-ticks (>= count max-ticks)) (stop-monitor))) interval :owner frame))))
      (wxlambda:make-column panel)
      (wxlambda:add-child panel canvas :proportion 1 :expand t :border 10)
      (dolist (child (list indicator toggle feedback)) (wxlambda:add-child panel child :border 6))
      (redraw)
      (wxlambda:on-click toggle
        (lambda () (wxlambda:defer-ui-action
          (lambda () (if (and timer (wxlambda:ui-timer-active-p timer)) (stop-monitor) (begin))) :owner frame)))
      (begin))
    (values frame canvas indicator (lambda () timer) (lambda () count) toggle)))
(defun exercise (&key export-path)
  (multiple-value-bind (frame canvas indicator ticket count toggle) (build-window :interval 10 :max-ticks 3)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (loop repeat 300 while (wxlambda:ui-timer-active-p (funcall ticket)) do (wxlambda:process-events) (sleep 0.005))
           (assert (= 3 (funcall count))) (assert (not (wxlambda:activity-running-p indicator)))
           (setf (wxlambda:canvas-content canvas) (monitor-scene (funcall count) 640 300))
           (wxlambda:save-canvas-image canvas
             (or export-path (merge-pathnames (format nil "wxl-monitor-~A.png" (lisp-implementation-type))
                                              (uiop:temporary-directory))) :width 640 :height 300)
           (wxlambda:queue-click toggle)
           (loop repeat 30 until (wxlambda:ui-timer-active-p (funcall ticket)) do (wxlambda:process-events))
           (assert (wxlambda:ui-timer-active-p (funcall ticket)))
           (assert (wxlambda:activity-running-p indicator)) t)
      (wxlambda:cancel-ui-timer (funcall ticket))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
