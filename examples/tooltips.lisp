;;; Contextual form guidance with owner-bound deferred tooltip changes.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-tooltips (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-tooltips)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Form guidance λ" :width 440 :height 230))
         (panel (wxlambda:make-panel frame))
         (name (wxlambda:make-text panel :value ""))
         (button (wxlambda:make-button panel :label "Toggle guidance"))
         (guidance "Enter your display name — λ is welcome."))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel (wxlambda:make-label panel :label "Display name") :border 8)
    (wxlambda:add-child panel name :border 8)
    (wxlambda:add-child panel button :border 8)
    (setf (wxlambda:tooltip-text name) guidance
          (wxlambda:tooltip-text button) "Show or remove the name field's hover guidance.")
    (wxlambda:on-click button
      (lambda ()
        (wxlambda:defer-ui-action
          (lambda () (setf (wxlambda:tooltip-text name)
                           (unless (wxlambda:tooltip-text name) guidance))) :owner name)))
    (values frame name button)))
(defun exercise ()
  (multiple-value-bind (frame name button) (build-window)
    (unwind-protect
         (progn
           (assert (search "λ" (wxlambda:tooltip-text name)))
           (wxlambda:show-window frame) (wxlambda:process-events)
           (wxlambda:queue-click button)
           (loop repeat 30 while (wxlambda:tooltip-text name) do (wxlambda:process-events))
           (assert (null (wxlambda:tooltip-text name)))
           (wxlambda:queue-click button)
           (loop repeat 30 until (wxlambda:tooltip-text name) do (wxlambda:process-events))
           (assert (search "λ" (wxlambda:tooltip-text name))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
