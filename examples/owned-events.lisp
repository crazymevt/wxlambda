;;; Load and call (wxlambda-owned-events:start).
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-owned-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-owned-events)
(defun exercise ()
  (wxlambda:register-event-type :reusable-message :family :command)
  (let* ((receiver (wxlambda:make-event-handler))
         (message (wxlambda:make-event :kind :reusable-message :text "original" :integer 1))
         (captured nil) (clone nil)
         (binding (wxlambda:bind-event receiver :reusable-message
                    (lambda (event context)
                      (setf captured event)
                      (setf (wxlambda:event-text context) "changed live copy"
                            (wxlambda:event-integer context) 7)
                      (setf clone (wxlambda:clone-event context))) :with-context t)))
    (unwind-protect
         (progn
           (wxlambda:process-event receiver message)
           (assert (string= "original" (wxlambda:event-text message)))
           (assert (string= "original" (wxlambda:event-text captured)))
           (assert (string= "changed live copy" (wxlambda:event-text clone)))
           (assert (= 7 (wxlambda:event-integer clone)))
           (assert (null (wxlambda:event-origin-id clone)))
           (wxlambda:unbind-event binding)
           (setf binding (wxlambda:bind-event receiver :reusable-message (lambda (e) (setf captured e))))
           (wxlambda:queue-event receiver clone)
           (wxlambda:destroy-event clone) (setf clone nil)
           (wxlambda:process-pending-events)
           (assert (string= "changed live copy" (wxlambda:event-text captured))))
      (when clone (wxlambda:destroy-event clone))
      (wxlambda:unbind-event binding)
      (wxlambda:destroy-event message)
      (wxlambda:destroy-event-handler receiver))))
(defun start () (wxlambda:with-application () (exercise)))
