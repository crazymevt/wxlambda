(require :asdf)
(asdf:load-asd (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-image-viewer (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-image-viewer)
(defun build-window ()
  ;; This pixel-inspection behavior is application code; wxLambda exposes resources.
  (let* ((rgb (make-array (* 32 32 3) :element-type '(unsigned-byte 8)))
         (alpha (make-array (* 32 32) :element-type '(unsigned-byte 8)))
         (frame (wxlambda:make-frame :title "Native image resources" :width 420 :height 390))
         (panel (wxlambda:make-panel frame))
         (status (wxlambda:make-status-bar frame)))
    (dotimes (y 32)
      (dotimes (x 32)
        (let ((pixel (+ x (* y 32))))
          (setf (aref rgb (* pixel 3)) (* x 8)
                (aref rgb (+ 1 (* pixel 3))) (* y 8)
                (aref rgb (+ 2 (* pixel 3))) 180
                (aref alpha pixel) (if (< x 8) 64 255)))))
    (let* ((source (wxlambda:make-image :width 32 :height 32 :rgb rgb :alpha alpha))
           (scaled (wxlambda:scale-image source 256 256 :quality :nearest))
           (bitmap (wxlambda:make-bitmap :image scaled))
           (view (wxlambda:make-static-bitmap panel bitmap)))
      (wxlambda:make-column panel) (wxlambda:add-child panel view :border 16)
      (wxlambda:bind-event view :mouse-motion
        (lambda (event)
          (destructuring-bind (x y) (wxlambda:event-position event)
            (when (and (<= 0 x 255) (<= 0 y 255))
              (setf (wxlambda:status-text status)
                (format nil "Pixel (~D,~D): ~S" x y (wxlambda:image-pixel scaled x y)))))))
      (values frame source scaled bitmap view))))
(defun release (frame source scaled bitmap)
  (wxlambda:destroy-window frame)
  (wxlambda:destroy-bitmap bitmap) (wxlambda:destroy-image scaled) (wxlambda:destroy-image source))
(defun exercise ()
  (multiple-value-bind (frame source scaled bitmap view) (build-window)
    (unwind-protect
         (progn
           (assert (equal '(32 32) (wxlambda:image-size source)))
           (assert (equal '(256 256) (wxlambda:bitmap-size bitmap)))
           (assert (equal '(0 0 180 64) (wxlambda:image-pixel scaled 0 0)))
           (wxlambda:show-window frame) (wxlambda:process-events)
           (let ((copy (wxlambda:bitmap-value view)))
             (unwind-protect
                  (assert (equal '(256 256) (wxlambda:bitmap-logical-size copy)))
               (wxlambda:destroy-bitmap copy))) t)
      (release frame source scaled bitmap))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame source scaled bitmap) (build-window)
      (declare (ignore source scaled bitmap))
      (wxlambda:show-window frame) (wxlambda:run))))
