;;; Larger form with a scrolling viewport and owner-bound deferred navigation.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-scrolling-panels (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-scrolling-panels)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Scrollable form λ" :width 480 :height 300))
         (outer (wxlambda:make-panel frame))
         (top (wxlambda:make-button outer :label "Back to top"))
         (viewport (wxlambda:make-scrolled-panel outer :scroll-rate '(0 16))))
    (wxlambda:make-column outer)
    (wxlambda:add-child outer top :border 8)
    (wxlambda:add-child outer viewport :proportion 1 :expand t :border 8)
    (wxlambda:make-column viewport)
    (dotimes (index 24)
      (wxlambda:add-child viewport
        (wxlambda:make-text viewport :value (format nil "Field ~D — λ" (1+ index))) :border 8))
    (wxlambda:fit-scroll-content viewport)
    (wxlambda:on-click top
      (lambda ()
        (wxlambda:defer-ui-action (lambda () (setf (wxlambda:scroll-position viewport) '(0 0))) :owner viewport)))
    (values frame viewport top)))
(defun exercise ()
  (multiple-value-bind (frame viewport top) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (wxlambda:fit-scroll-content viewport)
           (assert (> (second (wxlambda:scroll-extent viewport)) 600))
           (setf (wxlambda:scroll-position viewport) '(0 12))
           (assert (plusp (second (wxlambda:scroll-position viewport))))
           (wxlambda:queue-click top)
           (loop repeat 30 until (equal '(0 0) (wxlambda:scroll-position viewport))
                 do (wxlambda:process-events))
           (assert (equal '(0 0) (wxlambda:scroll-position viewport))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
