(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-aui-notebook (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-aui-notebook)
(defun add-page (book label)
  (let ((page (wxlambda:make-panel book)))
    (wxlambda:make-column page)
    (wxlambda:add-child page (wxlambda:make-label page :label label) :border 12)
    (wxlambda:add-notebook-page book page :label label :select t)))
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Dynamic window workspace λ" :width 850 :height 500))
         (splitter (wxlambda:make-splitter-window frame :sash-position 180))
         (sidebar (wxlambda:make-panel splitter)) (workspace (wxlambda:make-panel splitter))
         (book (wxlambda:make-aui-notebook workspace))
         (add (wxlambda:make-button sidebar :label "Add page"))
         (close (wxlambda:make-button sidebar :label "Delete selected"))
         (move (wxlambda:make-button sidebar :label "Move last to first"))
         (split (wxlambda:make-button sidebar :label "Split selected right")) (counter 1))
    (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :expand t)
    (wxlambda:make-column sidebar)
    (dolist (button (list add close move split)) (wxlambda:add-child sidebar button :border 8))
    (wxlambda:make-column workspace) (wxlambda:add-child workspace book :proportion 1 :expand t)
    (wxlambda:initialize-splitter splitter sidebar)
    (wxlambda:resplit-window splitter workspace)
    (add-page book "First λ")
    (wxlambda:on-click add (lambda ()
      (wxlambda:defer-ui-action (lambda () (add-page book (format nil "Page ~D" (incf counter)))) :owner book)))
    (wxlambda:on-click close (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (let ((index (wxlambda:selection book))) (when index (wxlambda:delete-notebook-page book index)))) :owner book)))
    (wxlambda:on-click move (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (let ((count (wxlambda:notebook-page-count book)))
          (when (> count 1) (wxlambda:move-notebook-page book (1- count) 0)))) :owner book)))
    (wxlambda:on-click split (lambda ()
      (wxlambda:defer-ui-action (lambda ()
        (when (> (wxlambda:notebook-page-count book) 1)
          (wxlambda:split-notebook-page book (wxlambda:selection book) :right))) :owner book)))
    (values frame book add close move splitter)))
(defun exercise ()
  (multiple-value-bind (frame book add close move splitter) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (let ((sidebar (wxlambda:splitter-pane splitter 0))
                 (workspace (wxlambda:splitter-pane splitter 1)))
             (assert (eq sidebar (wxlambda:unsplit-window splitter :remove 0)))
             (assert (eq workspace (wxlambda:splitter-pane splitter 0)))
             (assert (eq workspace (wxlambda:replace-splitter-pane splitter 0 sidebar)))
             (wxlambda:resplit-window splitter workspace)
             (setf (wxlambda:splitter-orientation splitter) :horizontal)
             (assert (eq :horizontal (wxlambda:splitter-orientation splitter)))
             (setf (wxlambda:splitter-orientation splitter) :vertical)
             (assert (eq sidebar (wxlambda:splitter-pane splitter 0)))
             (assert (eq workspace (wxlambda:splitter-pane splitter 1))))
           (wxlambda:queue-click add)
           (loop repeat 40 until (= 2 (wxlambda:notebook-page-count book)) do (wxlambda:process-events))
           (assert (= 2 (wxlambda:notebook-page-count book)))
           (wxlambda:split-notebook-page book 1 :right)
           (let ((last (wxlambda:notebook-page book 1)))
             (wxlambda:queue-click move)
             (loop repeat 40 until (eq last (wxlambda:notebook-page book 0)) do (wxlambda:process-events))
             (assert (eq last (wxlambda:notebook-page book 0))))
           (wxlambda:queue-click close)
           (loop repeat 40 until (= 1 (wxlambda:notebook-page-count book)) do (wxlambda:process-events))
           (assert (= 1 (wxlambda:notebook-page-count book))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
