;;; Safe menu/tool/keyboard requests. EXERCISE uses injected file/clipboard/confirmation functions.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-deferred-actions (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-deferred-actions)
(defun pick-file (frame)
  (let ((dialog (wxlambda:make-file-dialog :parent frame :title "Choose a file")))
    (unwind-protect
         (when (eq :ok (wxlambda:show-modal dialog)) (wxlambda:file-dialog-path dialog))
      (wxlambda:destroy-window dialog))))
(defun confirm-close (frame)
  (let ((dialog (wxlambda:make-message-dialog :parent frame :message "Close this example?" :buttons :yes-no)))
    (unwind-protect (eq :yes (wxlambda:show-modal dialog)) (wxlambda:destroy-window dialog))))
(defun build-window (&key (choose #'pick-file) (copy-text (lambda (text) (setf (wxlambda:clipboard-text) text)))
                          (confirm #'confirm-close))
  (let* ((frame (wxlambda:make-frame :title "Deferred UI actions λ" :width 660 :height 400
                                  :accelerators '((#\o 32101 :ctrl) (#\c 32102 :ctrl :shift) (#\w 32103 :ctrl))))
         (toolbar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame))
         (bar (wxlambda:make-menu-bar frame))
         (menu (wxlambda:make-menu bar :label "&Actions"))
         (panel (wxlambda:make-panel frame))
         (editor (wxlambda:make-text panel :multiline t :value "Copy this text λ 日本語 😀"))
         (latest nil))
    (loop for id in '(32101 32102 32103) for label in '("Choose file" "Copy text" "Close")
          for art in '(:open :copy :quit) do
            (wxlambda:make-menu-item menu :id id :label label)
            (wxlambda:add-toolbar-tool toolbar id label :art art))
    (wxlambda:realize-toolbar toolbar)
    (wxlambda:make-column panel) (wxlambda:add-child panel editor :proportion 1 :expand t :border 8)
    (setf (wxlambda:status-text status) "Ready — choose file, copy text or close")
    (labels ((request (event context)
               (declare (ignore context))
               (let ((id (wxlambda:event-id event)))
                 (setf latest
                       (wxlambda:defer-ui-action
                         (lambda ()
                           (case id
                             (32101 (let ((path (funcall choose frame)))
                                      (setf (wxlambda:status-text status) (or path "File selection canceled"))))
                             (32102 (funcall copy-text (wxlambda:text editor))
                                    (setf (wxlambda:status-text status) "Text copied"))
                             (32103 (if (funcall confirm frame) (wxlambda:close-window frame)
                                        (setf (wxlambda:status-text status) "Close canceled")))))
                         :owner frame)))))
      ;; Consume toolbar commands before frame propagation; each request queues once.
      (wxlambda:bind-event toolbar :menu #'request :id 32101 :last-id 32103 :with-context t)
      (wxlambda:bind-event frame :menu #'request :id 32101 :last-id 32103 :with-context t))
    (values frame toolbar status (lambda () latest))))
(defun drain (ticket)
  (loop repeat 30 while (wxlambda:ui-action-pending-p ticket) do (wxlambda:process-events))
  (assert (not (wxlambda:ui-action-pending-p ticket))))
(defun exercise ()
  (let ((chosen 0) (copied nil) (permit-close nil))
    (multiple-value-bind (frame toolbar status latest)
        (build-window :choose (lambda (frame) (declare (ignore frame)) (incf chosen) "/example/notes λ.txt")
                      :copy-text (lambda (text) (setf copied text))
                      :confirm (lambda (frame) (declare (ignore frame)) permit-close))
      (unwind-protect
           (progn
             (wxlambda:show-window frame)
             (wxlambda:process-event frame :menu :id 32101)
             (assert (zerop chosen)) ; scheduling is never inline
             (wxlambda:process-pending-events)
             (assert (zerop chosen)) ; pending-only dispatch does not run the idle queue
             (drain (funcall latest))
             (assert (= 1 chosen))
             (assert (string= "/example/notes λ.txt" (wxlambda:status-text status)))
             (wxlambda:activate-toolbar-tool toolbar 32102)
             (assert (null copied)) (drain (funcall latest))
             (assert (string= "Copy this text λ 日本語 😀" copied))
             (wxlambda:process-event frame :menu :id 32103) (drain (funcall latest))
             (assert (string= "Close canceled" (wxlambda:status-text status)))
             (setf permit-close t)
             (wxlambda:process-event frame :menu :id 32103) (drain (funcall latest))
             t)
        (ignore-errors (wxlambda:destroy-window frame)) (wxlambda:process-events)))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
