;;; Pixel artwork does not depend on the selected font or Unicode glyph support.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-bitmap-toggles (:use #:cl) (:export #:start #:exercise #:make-icon))
(in-package #:wxlambda-bitmap-toggles)
(defun make-icon (&optional (colour '(45 95 160)))
  (let ((rgb (make-array (* 16 16 3) :element-type '(unsigned-byte 8) :initial-element 0))
        (alpha (make-array (* 16 16) :element-type '(unsigned-byte 8) :initial-element 0)))
    (loop for y from 3 below 13 do
      (loop for x from 3 below 13 for pixel = (+ x (* y 16)) do
        (setf (aref alpha pixel) 255)
        (loop for channel in colour for offset from 0 do (setf (aref rgb (+ (* pixel 3) offset)) channel))))
    (let ((image (wxlambda:make-image :width 16 :height 16 :rgb rgb :alpha alpha)))
      (unwind-protect (wxlambda:make-bitmap :image image) (wxlambda:destroy-image image)))))
(defun exercise ()
  (unless (wxlambda:bitmap-toggle-button-supported-p) (error "Bitmap toggles unavailable on this port"))
  (let* ((frame (wxlambda:make-frame :title "Bitmap toggle"))
         (icon (make-icon (nth-value 0 (wxlambda:window-colours frame)))) (button (wxlambda:make-bitmap-toggle-button frame icon :checked t :border :none))
         (changes 0))
    (wxlambda:destroy-bitmap icon)
    (unwind-protect
         (progn
           (setf (wxlambda:tooltip-text button) "A font-independent bitmap toggle"
                 (wxlambda:window-name button) "Bitmap option")
           (wxlambda:bind-event button :toggle-button-change
             (lambda (event) (assert (not (wxlambda:event-checked-p event))) (incf changes)))
           (setf (wxlambda:checked-p button :notify t) nil)
           (assert (= changes 1))
           (let ((copy (wxlambda:bitmap-value button)))
             (unwind-protect (assert (equal '(16 16) (wxlambda:bitmap-size copy)))
               (wxlambda:destroy-bitmap copy)))
           (wxlambda:show-window frame) (wxlambda:process-events) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Bitmap toggle buttons" :width 360 :height 180))
           (icon (make-icon (nth-value 0 (wxlambda:window-colours frame)))) (button (wxlambda:make-bitmap-toggle-button frame icon :border :none)))
      (wxlambda:destroy-bitmap icon)
      (setf (wxlambda:tooltip-text button) "Toggle bitmap option")
      (wxlambda:make-column frame) (wxlambda:add-child frame button)
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
