;;; Select a preset or type a custom destination. START interactive, EXERCISE automatic.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-combo-boxes (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-combo-boxes)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Destination" :width 460 :height 230))
         (panel (wxlambda:make-panel frame))
         (combo (wxlambda:make-combo-box panel :items '("Inbox" "Archive" "Review λ") :selection 0))
         (feedback (wxlambda:make-label panel :label "Destination: Inbox")) (changes 0))
    (flet ((update (event)
             (incf changes)
             (setf (wxlambda:label-text feedback) (format nil "Destination: ~A" (wxlambda:event-text event)))))
      (wxlambda:bind-event combo :combo-selection #'update)
      (wxlambda:bind-event combo :text-change #'update))
    (wxlambda:make-column panel)
    (dolist (child (list combo feedback)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame combo feedback (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame combo feedback changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (= 0 (wxlambda:selection combo))) (assert (string= "Inbox" (wxlambda:text combo)))
           (setf (wxlambda:selection combo) 1) (assert (zerop (funcall changes)))
           (setf (wxlambda:selection combo :notify t) 2)
           (assert (string= "Destination: Review λ" (wxlambda:label-text feedback)))
           (setf (wxlambda:text combo :notify t) "Custom λ")
           (assert (string= "Destination: Custom λ" (wxlambda:label-text feedback)))
           (assert (= 2 (funcall changes)))
           (setf (wxlambda:selection combo) nil)
           (assert (and (null (wxlambda:selection combo)) (string= "" (wxlambda:text combo)))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
