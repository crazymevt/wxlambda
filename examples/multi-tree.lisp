(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-multi-tree (:use #:cl) (:export #:exercise #:start))
(in-package #:wxlambda-multi-tree)
(defun exercise ()
  (let* ((frame (wxlambda:make-frame)) (tree (wxlambda:make-tree-control frame :multiple-p t))
         (root (wxlambda:add-tree-root tree "Root"))
         (a (wxlambda:append-tree-item root "A")) (b (wxlambda:append-tree-item root "B"))
         (events 0))
    (unwind-protect
         (progn
           (wxlambda:bind-event tree :tree-selection-changed (lambda (event) (declare (ignore event)) (incf events)))
           (setf (wxlambda:tree-selections tree) (list a b))
           (assert (= 2 (length (wxlambda:tree-selections tree))))
           (wxlambda:append-tree-item root "C")
           (assert (= 2 (length (wxlambda:tree-selections tree))))
           (setf (wxlambda:tree-item-expanded-p root) t)
           (assert (= 2 (length (wxlambda:tree-selections tree))))
           (setf (wxlambda:tree-item-expanded-p root) nil)
           (assert (= 2 (length (wxlambda:tree-selections tree))))
           (wxlambda:delete-tree-item a)
           (assert (equal (list b) (wxlambda:tree-selections tree)))
           (wxlambda:process-events)
           (assert (equal (list b) (wxlambda:tree-selections tree)))
           (setf (wxlambda:selection tree) nil)
           (assert (null (wxlambda:tree-selections tree)))
           (assert (zerop events)) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Shift/Cmd/Ctrl-click to select several items"))
           (tree (wxlambda:make-tree-control frame :multiple-p t)) (root (wxlambda:add-tree-root tree "Root")))
      (dolist (name '("A" "B" "C" "D")) (wxlambda:append-tree-item root name))
      (setf (wxlambda:tree-item-expanded-p root) t)
      (wxlambda:make-column frame) (wxlambda:add-child frame tree :proportion 1)
      (wxlambda:bind-event tree :tree-selection-changed
        (lambda (event) (declare (ignore event))
          (format t "Selected: ~S~%" (mapcar #'wxlambda:tree-item-text (wxlambda:tree-selections tree)))))
      (wxlambda:show-window frame) (wxlambda:run))))
