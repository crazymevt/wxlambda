;;; A bounded periodic status update; START is interactive, EXERCISE cancels after two ticks.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-periodic-status (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-periodic-status)
(defun build-window (&key (interval 250) max-ticks)
  (let* ((frame (wxlambda:make-frame :title "Periodic UI status λ" :width 500 :height 240))
         (panel (wxlambda:make-panel frame))
         (label (wxlambda:make-label panel :label "Waiting for a timer tick"))
         (toggle (wxlambda:make-button panel :label "Pause / Resume"))
         (status (wxlambda:make-status-bar frame))
         (count 0) (timer nil))
    (labels ((begin ()
               (setf timer
                     (wxlambda:start-ui-timer
                       (lambda ()
                         (incf count)
                         (setf (wxlambda:label-text label) (format nil "Update ~D — λ" count)
                               (wxlambda:status-text status) "Periodic UI update")
                         (when (and max-ticks (>= count max-ticks))
                           (wxlambda:cancel-ui-timer timer)
                           (setf (wxlambda:status-text status) "Stopped after bounded updates")))
                       interval :owner frame))))
      (wxlambda:make-column panel)
      (wxlambda:add-child panel label :border 12)
      (wxlambda:add-child panel toggle :border 12)
      (wxlambda:on-click toggle
        (lambda ()
          (if (and timer (wxlambda:ui-timer-active-p timer))
              (progn (wxlambda:cancel-ui-timer timer) (setf (wxlambda:status-text status) "Paused"))
              (begin))))
      (begin))
    (values frame (lambda () timer) (lambda () count))))
(defun exercise ()
  (multiple-value-bind (frame ticket count) (build-window :interval 10 :max-ticks 2)
    (unwind-protect
         (progn
           (assert (zerop (funcall count)))
           (wxlambda:show-window frame)
           (loop repeat 300 while (wxlambda:ui-timer-active-p (funcall ticket))
                 do (wxlambda:process-events) (sleep 0.005))
           (assert (= 2 (funcall count)))
           (assert (not (wxlambda:ui-timer-active-p (funcall ticket))))
           (assert (not (wxlambda:cancel-ui-timer (funcall ticket)))) t)
      (wxlambda:cancel-ui-timer (funcall ticket))
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
