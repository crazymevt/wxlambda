;;; Cohesive tree/list manager: stable model identities, deferred actions and adapters.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-record-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-record-manager)

(defconstant +new+ 32201)
(defconstant +edit+ 32202)
(defconstant +delete+ 32203)
(defconstant +copy+ 32204)
(defconstant +details+ 32205)
(defstruct record id category title note)
(defstruct manager frame tree categories query listing book details status toolbar menu-items
  records visible-ids selected-id category (next-id 4) pending refresh-ticket refresh-clear-p active disposed prompt confirm copy-text)

(defun prompt-field (frame message value)
  (let ((dialog (wxlambda:make-text-entry-dialog :parent frame :message message :value value)))
    (unwind-protect
         (when (eq :ok (wxlambda:show-modal dialog)) (values (wxlambda:dialog-value dialog) t))
      (wxlambda:destroy-window dialog))))
(defun prompt-record (frame operation current)
  (multiple-value-bind (title accepted)
      (prompt-field frame (if (eq operation :new) "Record title:" "Rename record:")
                    (if current (record-title current) "Untitled"))
    (when accepted
      (multiple-value-bind (note note-accepted)
          (prompt-field frame "Record note:" (if current (record-note current) ""))
        (values title note note-accepted)))))
(defun confirm-delete (frame record)
  (let ((dialog (wxlambda:make-message-dialog :parent frame :title "Delete record"
                 :message (format nil "Delete ~A?" (record-title record)) :buttons :yes-no :icon :question)))
    (unwind-protect (eq :yes (wxlambda:show-modal dialog)) (wxlambda:destroy-window dialog))))
(defun find-record (manager id) (find id (manager-records manager) :key #'record-id))
(defun selected-record (manager) (find-record manager (manager-selected-id manager)))
(defun status (manager message)
  (setf (wxlambda:status-text (manager-status manager)) message))
(defun update-details (manager)
  (let ((record (selected-record manager)))
    (setf (wxlambda:text (manager-details manager))
          (if record (format nil "~A~%Category: ~A~%ID: ~D~%~%~A"
                             (record-title record) (record-category record) (record-id record) (record-note record))
              "Select a record to inspect it."))
    (dolist (id (list +edit+ +delete+ +copy+ +details+))
      (setf (wxlambda:enabled-p (cdr (assoc id (manager-menu-items manager)))) (not (null record))
            (wxlambda:tool-enabled-p (manager-toolbar manager) id) (not (null record))))))
(defun refresh-records (manager)
  (let* ((query (wxlambda:text (manager-query manager)))
         (category (manager-category manager))
         (matches (remove-if-not
                    (lambda (record)
                      (and (or (null category) (eq category (record-category record)))
                           (search query (record-title record) :test #'char-equal)))
                    (manager-records manager)))
         (selected (manager-selected-id manager)))
    (setf (manager-visible-ids manager) (mapcar #'record-id matches))
    (wxlambda:clear-items (manager-listing manager))
    (dolist (record matches) (wxlambda:append-item (manager-listing manager) (record-title record)))
    (let ((index (position selected (manager-visible-ids manager))))
      (setf (manager-selected-id manager) (and index selected)
            (wxlambda:selection (manager-listing manager)) index))
    (setf (wxlambda:status-text (manager-status manager) 1)
          (format nil "~D visible / ~D records" (length matches) (length (manager-records manager))))
    (update-details manager)))
(defun request-refresh (manager &optional clear-p)
  (when (and clear-p (not (manager-disposed manager))) (setf (manager-refresh-clear-p manager) t))
  (unless (or (manager-disposed manager) (manager-refresh-ticket manager))
    (setf (manager-refresh-ticket manager)
          (wxlambda:defer-ui-action
            (lambda ()
              (let ((clear (manager-refresh-clear-p manager)))
                (setf (manager-refresh-ticket manager) nil (manager-refresh-clear-p manager) nil)
                (unless (manager-disposed manager)
                  (when clear (setf (wxlambda:text (manager-query manager)) ""))
                  (refresh-records manager)))) :owner (manager-frame manager)))))
(defun valid-fields-p (title note)
  (and (stringp title) (plusp (length title)) (stringp note)
       (notany (lambda (character) (find character title)) (list #\Null #\Return #\Newline))
       (not (find #\Null note))))
(defun perform-action (manager operation target-id category)
  (let ((record (find-record manager target-id)))
    (case operation
      ((:new :edit)
       (when (or (eq operation :new) record)
         (multiple-value-bind (title note accepted)
             (funcall (manager-prompt manager) (manager-frame manager) operation (and (eq operation :edit) record))
           (cond ((not accepted) (status manager "Edit canceled"))
                 ((not (valid-fields-p title note)) (status manager "Title must be nonempty single-line text; NUL is not allowed"))
                 (t
                  (if (eq operation :new)
                      (let ((created (make-record :id (manager-next-id manager) :category (or category :documents)
                                                  :title (copy-seq title) :note (copy-seq note))))
                        (incf (manager-next-id manager))
                        (setf (manager-records manager) (append (manager-records manager) (list created))
                              (manager-selected-id manager) (record-id created)))
                      (setf (record-title record) (copy-seq title) (record-note record) (copy-seq note)))
                  (refresh-records manager)
                  (status manager (if (eq operation :new) "Record created" "Record updated")))))))
      (:delete
       (when record
         (if (funcall (manager-confirm manager) (manager-frame manager) record)
             (progn
               (setf (manager-records manager) (remove (record-id record) (manager-records manager) :key #'record-id))
               (when (eql (manager-selected-id manager) (record-id record))
                 (setf (manager-selected-id manager) nil))
               (refresh-records manager) (status manager "Record deleted"))
             (status manager "Delete canceled"))))
      (:copy
       (when record
         (funcall (manager-copy-text manager) (format nil "~A~%~A" (record-title record) (record-note record)))
         (status manager "Record copied")))
      (:details
       (when record
         (let ((index (position (record-id record) (manager-visible-ids manager))))
           (if index
               (progn
                 (setf (manager-selected-id manager) (record-id record)
                       (wxlambda:selection (manager-listing manager)) index)
                 (update-details manager)
                 (setf (wxlambda:selection (manager-book manager)) 1))
               (status manager "Requested record is no longer visible"))))))))
(defun request-action (manager operation)
  ;; First request wins. Stable model IDs, not row indices or borrowed tree views,
  ;; identify action targets while the idle phase is pending.
  (unless (or (manager-disposed manager) (manager-pending manager) (manager-active manager))
    (let ((target-id (manager-selected-id manager)) (category (manager-category manager)))
      (setf (manager-pending manager)
            (wxlambda:defer-ui-action
              (lambda ()
                (setf (manager-pending manager) nil)
                (unless (manager-disposed manager)
                  (setf (manager-active manager) t)
                  (unwind-protect (perform-action manager operation target-id category)
                    (setf (manager-active manager) nil)))) :owner (manager-frame manager))))))
(defun dispose-manager (manager)
  (unless (manager-disposed manager)
    (setf (manager-disposed manager) t)
    (dolist (ticket (list (manager-pending manager) (manager-refresh-ticket manager)))
      (when ticket (wxlambda:cancel-ui-action ticket)))
    (setf (manager-pending manager) nil (manager-refresh-ticket manager) nil)
    (when (wxlambda:handler-alive-p (manager-frame manager)) (wxlambda:destroy-window (manager-frame manager)))))

(defun build-manager (&key (prompt #'prompt-record) (confirm #'confirm-delete)
                           (copy-text (lambda (text) (setf (wxlambda:clipboard-text) text))))
  (let* ((frame (wxlambda:make-frame :title "Record manager λ" :width 900 :height 560
                                  :accelerators '((#\n 32201 :ctrl) (#\e 32202 :ctrl) (#\c 32204 :ctrl :shift) (:f1 32205))))
         (toolbar (wxlambda:make-toolbar frame))
         (status (wxlambda:make-status-bar frame :fields 2))
         (bar (wxlambda:make-menu-bar frame)) (menu (wxlambda:make-menu bar :label "&Records"))
         (splitter (wxlambda:make-splitter-window frame :sash-position 220 :minimum-pane-size 80))
         (left (wxlambda:make-panel splitter)) (right (wxlambda:make-panel splitter))
         (tree (wxlambda:make-tree-control left)) (root (wxlambda:add-tree-root tree "All records"))
         (documents (wxlambda:append-tree-item root "Documents"))
         (images (wxlambda:append-tree-item root "Images"))
         (book (wxlambda:make-notebook right))
         (records-page (wxlambda:make-panel book)) (details-page (wxlambda:make-panel book))
         (query (wxlambda:make-search-control records-page :hint "Filter record titles"))
         (listing (wxlambda:make-list-box records-page))
         (details (wxlambda:make-text details-page :multiline t :editable-p nil))
         (manager (make-manager :frame frame :tree tree :categories (list (cons root nil) (cons documents :documents) (cons images :images))
                     :query query :listing listing :book book :details details :status status :toolbar toolbar
                     :prompt prompt :confirm confirm :copy-text copy-text
                     :records (list (make-record :id 1 :category :documents :title "Notes λ" :note "Initial document")
                                    (make-record :id 2 :category :documents :title "日本語 😀" :note "Unicode record")
                                    (make-record :id 3 :category :images :title "Diagram" :note "Retained scene reference")))))
    (loop for id in (list +new+ +edit+ +delete+ +copy+ +details+)
          for label in '("&New" "&Edit" "&Delete" "&Copy record" "&Details")
          for art in '(:new :open :information :copy :information)
          do (push (cons id (wxlambda:make-menu-item menu :id id :label label)) (manager-menu-items manager))
             (wxlambda:add-toolbar-tool toolbar id label :art art))
    (wxlambda:realize-toolbar toolbar)
    (wxlambda:make-column frame) (wxlambda:add-child frame splitter :proportion 1 :border 0)
    (wxlambda:make-column left) (wxlambda:add-child left tree :proportion 1 :border 0)
    (wxlambda:make-column right) (wxlambda:add-child right book :proportion 1 :border 0)
    (wxlambda:make-column records-page) (wxlambda:add-child records-page query :border 8)
    (wxlambda:add-child records-page listing :proportion 1 :expand t :border 8)
    (wxlambda:make-column details-page) (wxlambda:add-child details-page details :proportion 1 :expand t :border 8)
    (wxlambda:add-notebook-page book records-page :label "Records")
    (wxlambda:add-notebook-page book details-page :label "Details")
    (wxlambda:split-window splitter left right)
    (setf (wxlambda:tree-item-expanded-p root) t (wxlambda:selection tree) root)
    (status manager "Ready — model changes stay in memory")
    (refresh-records manager)
    (wxlambda:bind-event tree :tree-selection-changed
      (lambda (event)
        (setf (manager-category manager) (cdr (assoc (wxlambda:event-tree-item event) (manager-categories manager) :test #'eq)))
        (request-refresh manager)))
    (dolist (kind '(:text-change :search))
      (wxlambda:bind-event query kind (lambda (event) (declare (ignore event)) (request-refresh manager))))
    (wxlambda:bind-event query :search-cancel (lambda (event) (declare (ignore event)) (request-refresh manager t)))
    (wxlambda:on-selection listing
      (lambda (event)
        (let ((index (wxlambda:event-selection event)))
          (setf (manager-selected-id manager) (and index (nth index (manager-visible-ids manager)))))
        (update-details manager)))
    (wxlambda:bind-event listing :listbox-double-click (lambda (event) (declare (ignore event)) (request-action manager :details)))
    (labels ((command (event context)
               (declare (ignore context))
               (let ((operation (cdr (assoc (wxlambda:event-id event)
                                     (list (cons +new+ :new) (cons +edit+ :edit) (cons +delete+ :delete)
                                           (cons +copy+ :copy) (cons +details+ :details))))))
                 (when operation (request-action manager operation)))))
      (wxlambda:bind-event toolbar :menu #'command :id +new+ :last-id +details+ :with-context t)
      (wxlambda:bind-event frame :menu #'command :id +new+ :last-id +details+ :with-context t))
    manager))
(defun drain-manager (manager)
  (loop repeat 80 while (or (manager-pending manager) (manager-refresh-ticket manager)) do (wxlambda:process-events))
  (assert (not (or (manager-pending manager) (manager-refresh-ticket manager)))))
(defun exercise ()
  (let ((replies (list (list "Created λ" "New note" t) (list "Renamed λ" (format nil "Line 1~%Line 2") t)
                       (list nil nil nil) (list "" "invalid" t)))
        (copied nil) (confirm nil) (prompt-count 0))
    (let ((manager (build-manager :prompt (lambda (frame operation current)
                                          (declare (ignore frame operation current))
                                          (incf prompt-count) (values-list (pop replies)))
                                 :confirm (lambda (frame record) (declare (ignore frame record)) confirm)
                                 :copy-text (lambda (text) (setf copied text)))))
      (unwind-protect
           (progn
             (wxlambda:show-window (manager-frame manager)) (wxlambda:process-events)
             (assert (= 3 (wxlambda:item-count (manager-listing manager))))
             (setf (wxlambda:selection (manager-tree manager) :notify t) (car (second (manager-categories manager))))
             (drain-manager manager) (assert (= 2 (wxlambda:item-count (manager-listing manager))))
             (setf (wxlambda:text (manager-query manager) :notify t) "λ")
             (drain-manager manager) (assert (equal '(1) (manager-visible-ids manager)))
             (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
             (wxlambda:activate-toolbar-tool (manager-toolbar manager) +copy+)
             (assert (null copied)) (drain-manager manager)
             (assert (string= (format nil "Notes λ~%Initial document") copied))
             (setf (wxlambda:text (manager-query manager) :notify t) "") (drain-manager manager)
             (wxlambda:process-event (manager-frame manager) :menu :id +new+)
             (wxlambda:process-event (manager-frame manager) :menu :id +new+) ; first request wins
             (assert (zerop prompt-count)) (drain-manager manager)
             (assert (= 1 prompt-count)) (assert (= 4 (length (manager-records manager))))
             (assert (= 4 (manager-selected-id manager)))
             (assert (eq :documents (record-category (find-record manager 4))))
             (wxlambda:activate-menu-item (cdr (assoc +edit+ (manager-menu-items manager))))
             (drain-manager manager)
             (assert (string= "Renamed λ" (record-title (find-record manager 4))))
             (assert (search "Line 2" (wxlambda:text (manager-details manager))))
             (wxlambda:process-event (manager-frame manager) :menu :id +details+) (drain-manager manager)
             (assert (= 1 (wxlambda:selection (manager-book manager))))
             (request-action manager :edit) (drain-manager manager) ; cancel preserves model
             (assert (string= "Renamed λ" (record-title (find-record manager 4))))
             (request-action manager :new) (drain-manager manager) ; invalid title preserves model
             (assert (= 4 (length (manager-records manager))))
             (request-action manager :delete) (drain-manager manager)
             (assert (find-record manager 4))
             (setf confirm t) (request-action manager :delete) (drain-manager manager)
             (assert (not (find-record manager 4)))
             (assert (null (manager-selected-id manager)))
             (assert (not (wxlambda:tool-enabled-p (manager-toolbar manager) +edit+)))
             ;; Stable ID targeting survives row/filter changes between request/delivery.
             (setf (wxlambda:selection (manager-listing manager) :notify t) 0)
             (request-action manager :copy)
             (setf (wxlambda:text (manager-query manager) :notify t) "日本語")
             (drain-manager manager)
             (assert (string= (format nil "Notes λ~%Initial document") copied))
             (assert (equal '(2) (manager-visible-ids manager)))
             t)
        (dispose-manager manager) (wxlambda:process-events)))))
(defun start ()
  (wxlambda:with-application ()
    (let ((manager (build-manager)))
      (unwind-protect (progn (wxlambda:show-window (manager-frame manager)) (wxlambda:run))
        (dispose-manager manager) (wxlambda:process-events)))))
