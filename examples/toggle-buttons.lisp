;;; Persistent preview option. START interactive; EXERCISE uses notified writes.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-toggle-buttons (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-toggle-buttons)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Preview option" :width 400 :height 220))
         (panel (wxlambda:make-panel frame))
         (toggle (wxlambda:make-toggle-button panel :label "Live preview" :checked t))
         (status (wxlambda:make-label panel :label "Preview enabled")) (changes 0))
    (wxlambda:bind-event toggle :toggle-button-change
      (lambda (event)
        (incf changes)
        (setf (wxlambda:label-text status)
              (if (wxlambda:event-checked-p event) "Preview enabled" "Preview paused"))))
    (wxlambda:make-column panel)
    (dolist (child (list toggle status)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame toggle status (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame toggle status changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (wxlambda:checked-p toggle))
           (setf (wxlambda:checked-p toggle) nil)
           (assert (zerop (funcall changes)))
           (setf (wxlambda:checked-p toggle :notify t) nil)
           (assert (string= "Preview paused" (wxlambda:label-text status)))
           (setf (wxlambda:checked-p toggle :notify t) t)
           (assert (= 2 (funcall changes)))
           (assert (string= "Preview enabled" (wxlambda:label-text status))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
