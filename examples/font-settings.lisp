(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-font-settings (:use #:cl) (:export #:exercise #:start))
(in-package #:wxlambda-font-settings)
(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title "Fonts"))
         (panel (wxlambda:make-panel frame))
         (editor (wxlambda:make-styled-text-control panel :value (format nil "a~Cb" #\Tab)))
         (gui (wxlambda:default-font))
         (fixed (wxlambda:default-font :fixed-width-p t)))
    (unwind-protect
         (progn
           (assert (plusp (length (wxlambda:available-fonts))))
           (assert (plusp (length (wxlambda:available-fonts :fixed-width-p t))))
           (setf (wxlambda:window-font frame :recursive-p t) (list (first gui) 15))
           (assert (= 15 (second (wxlambda:window-font panel))))
           (setf (wxlambda:stc-style-font editor 32) (first fixed)
                 (wxlambda:stc-style-size editor 32) 16)
           (wxlambda:clear-stc-styles editor)
           (assert (equal (first fixed) (wxlambda:stc-style-font editor 33)))
           (assert (= 16 (wxlambda:stc-style-size editor 33)))
           (setf (wxlambda:stc-tab-width editor) 8)
           (assert (= 8 (wxlambda:stc-tab-width editor)))
           (assert (string= (format nil "a~Cb" #\Tab) (wxlambda:stc-text editor)))
           (setf (wxlambda:window-font frame :recursive-p t) nil)
           (assert (equal gui (wxlambda:window-font panel))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start () (wxlambda:with-application () (exercise)))
