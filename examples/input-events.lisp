(require :asdf)
(asdf:load-asd (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-input-events (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-input-events)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Input observer — native editing preserved" :width 620 :height 360))
         (panel (wxlambda:make-panel frame))
         (input (wxlambda:make-text panel :multiline t :value "Type, select text and scroll here. λ 😀"))
         (status (wxlambda:make-status-bar frame)) (seen nil))
    (wxlambda:make-column panel) (wxlambda:add-child panel input :proportion 1 :expand t :border 12)
    (dolist (kind '(:key-down :key-up :char :char-hook :mouse-motion :mouse-wheel
                    :left-down :left-up :context-menu :focus-gained :focus-lost))
      (wxlambda:bind-event input kind
        (lambda (event)
          (push event seen)
          (when (> (length seen) 64) (setf seen (subseq seen 0 64)))
          (setf (wxlambda:status-text status)
            (case (wxlambda:event-kind event)
              ((:key-down :key-up :char :char-hook)
               (format nil "~A key=~D unicode=~S modifiers=~D command=~S raw-control=~S"
                 (wxlambda:event-kind event) (wxlambda:event-key-code event)
                 (wxlambda:event-unicode-key event) (wxlambda:event-modifiers event)
                 (wxlambda:event-cmd-down-p event) (wxlambda:event-raw-control-down-p event)))
              ((:focus-gained :focus-lost) (format nil "~A" (wxlambda:event-kind event)))
              (otherwise (format nil "~A ~S" (wxlambda:event-kind event) (wxlambda:event-position event))))))))
    (wxlambda:bind-event frame :size
      (lambda (event)
        (push event seen)
        (when (> (length seen) 64) (setf seen (subseq seen 0 64)))))
    (values frame input (lambda () seen))))
(defun exercise ()
  (multiple-value-bind (frame input seen) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame)
           (wxlambda:layout-window frame)
           (loop repeat 8 do (wxlambda:process-events))
           (let ((sizes (remove-if-not (lambda (event) (eq :size (wxlambda:event-kind event))) (funcall seen))))
             (assert sizes)
             (dolist (event sizes)
               (assert (eq :base (wxlambda:event-family event)))
               (assert (= 2 (length (wxlambda:event-size event))))))
           (assert (search "λ" (wxlambda:text input))) t)
      (wxlambda:destroy-window frame))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame input) (build-window)
      (declare (ignore input)) (wxlambda:show-window frame) (wxlambda:run))))
