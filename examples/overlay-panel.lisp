(require :asdf)
(asdf:load-asd (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :width 700 :height 400))
         (content (wxlambda:make-panel frame))
         (overlay (wxlambda:make-panel content)))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame content :proportion 1)
    (wxlambda:make-column overlay)
    (wxlambda:add-child overlay (wxlambda:make-text overlay :value "Find a command"))
    (wxlambda:show-window frame)
    (wxlambda:position-panel overlay 100 30 500 180)
    (assert (= 2 (length (wxlambda:window-descendants content))))
    (wxlambda:destroy-window frame)
    (wxlambda:process-events)))
