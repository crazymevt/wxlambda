(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-context-menus (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-context-menus)
(defun exercise ()
  (let* ((frame (wxlambda:make-frame :title "Context menus"))
         (bar (wxlambda:make-menu-bar frame))
         (file (wxlambda:make-menu bar :label "File"))
         (recent (wxlambda:make-menu file :label "Recent Files"))
         (item (wxlambda:make-menu-item recent :id 15001 :label "source.lisp")))
    (unwind-protect
         (progn (assert (= 1 (wxlambda:menu-item-count file)))
                (assert (string= "Recent Files" (wxlambda:menu-label recent)))
                (setf (wxlambda:menu-label recent) "Recent λ")
                (assert (string= "Recent λ" (wxlambda:menu-label recent)))
                (wxlambda:destroy-menu-resource recent)
                (assert (not (wxlambda:menu-resource-alive-p item)))
                (assert (= 0 (wxlambda:menu-item-count file))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let* ((frame (wxlambda:make-frame :title "Right-click the tree"))
           (tree (wxlambda:make-tree-control frame))
           (bar (wxlambda:make-menu-bar frame))
           (file (wxlambda:make-menu bar :label "File"))
           (recent (wxlambda:make-menu file :label "Recent Files")))
      (wxlambda:make-menu-item recent :id 15001 :label "source.lisp")
      (wxlambda:add-tree-root tree "Right-click me")
      (wxlambda:make-column frame) (wxlambda:add-child frame tree :proportion 1)
      (wxlambda:bind-event tree :tree-item-menu
        (lambda (event) (declare (ignore event))
          (wxlambda:defer-ui-action
            (lambda () (format t "Choice: ~S~%" (wxlambda:popup-choice tree '("New File" "New Folder" "Rename" "Delete")))))))
      (wxlambda:show-window frame) (wxlambda:run))))
