;;; A busy indicator with owner-bound deferred state changes.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-activity-indicator (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-activity-indicator)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Busy feedback λ" :width 400 :height 210))
         (panel (wxlambda:make-panel frame))
         (indicator (wxlambda:make-activity-indicator panel))
         (feedback (wxlambda:make-label panel :label "Idle"))
         (toggle (wxlambda:make-button panel :label "Toggle busy state")))
    (wxlambda:make-column panel)
    (dolist (child (list indicator feedback toggle)) (wxlambda:add-child panel child :border 8))
    (wxlambda:on-click toggle
      (lambda ()
        (wxlambda:defer-ui-action
          (lambda ()
            (setf (wxlambda:activity-running-p indicator) (not (wxlambda:activity-running-p indicator))
                  (wxlambda:label-text feedback) (if (wxlambda:activity-running-p indicator) "Busy — animation only" "Idle")))
          :owner indicator)))
    (values frame indicator feedback toggle)))
(defun exercise ()
  (multiple-value-bind (frame indicator feedback toggle) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (not (wxlambda:activity-running-p indicator)))
           (wxlambda:queue-click toggle)
           (loop repeat 30 until (wxlambda:activity-running-p indicator) do (wxlambda:process-events))
           (assert (wxlambda:activity-running-p indicator))
           (assert (string= "Busy — animation only" (wxlambda:label-text feedback)))
           (wxlambda:queue-click toggle)
           (loop repeat 30 while (wxlambda:activity-running-p indicator) do (wxlambda:process-events))
           (assert (not (wxlambda:activity-running-p indicator)))
           (assert (string= "Idle" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
