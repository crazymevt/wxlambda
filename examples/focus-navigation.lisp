;;; Focus a form field after a command returns to the safe idle phase.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-focus-navigation (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-focus-navigation)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Keyboard form λ" :width 420 :height 230))
         (panel (wxlambda:make-panel frame))
         (name (wxlambda:make-text panel :value "Name λ"))
         (address (wxlambda:make-text panel :value "Address"))
         (button (wxlambda:make-button panel :label "Return to name")))
    (wxlambda:make-column panel)
    (dolist (child (list name address button)) (wxlambda:add-child panel child :border 8))
    (wxlambda:on-click button
      (lambda () (wxlambda:defer-ui-action
                   (lambda () (wxlambda:focus-window name :from-keyboard t)) :owner name)))
    (values frame name address button)))
(defun exercise ()
  (multiple-value-bind (frame name address button) (build-window)
    (declare (ignore address))
    (unwind-protect
         (progn (wxlambda:show-window frame) (wxlambda:process-events)
                (assert (eq name (wxlambda:focus-window name)))
                (wxlambda:navigate-focus name)
                (wxlambda:navigate-focus name :forward nil)
                (wxlambda:queue-click button)
                (dotimes (i 8) (wxlambda:process-events)) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame name) (build-window)
      (wxlambda:show-window frame) (wxlambda:focus-window name) (wxlambda:run))))
