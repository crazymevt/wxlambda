;;; Load and call (wxlambda-notify-events:start).
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-notify-events
  (:use #:cl)
  (:export #:start #:exercise))
(in-package #:wxlambda-notify-events)

(defun open-window ()
  (wxlambda:register-event-type :before-apply :family :notify)
  (let* ((frame (wxlambda:make-frame :title "Synchronous notify policy"))
         (panel (wxlambda:make-panel frame))
         (receiver (wxlambda:make-event-handler))
         (reject (wxlambda:make-checkbox panel :label "Reject changes" :checked t))
         (apply (wxlambda:make-button panel :label "Validate then apply"))
         (caption (wxlambda:make-label panel :label "No change applied"))
         (applied 0)
         (binding (wxlambda:bind-event receiver :before-apply
                    (lambda (event context)
                      (assert (eq :notify (wxlambda:event-family event)))
                      (setf (wxlambda:event-vetoed-p context) (wxlambda:checked-p reject)))
                    :with-context t)))
    (wxlambda:make-column panel)
    (dolist (child (list reject apply caption)) (wxlambda:add-child panel child))
    (wxlambda:on-click apply
      (lambda ()
        (multiple-value-bind (handled vetoed)
            (wxlambda:process-event receiver :before-apply :text "Apply change" :integer (1+ applied))
          (if (and handled (not vetoed))
              (progn (incf applied) (setf (wxlambda:label-text caption) (format nil "Applied ~D" applied)))
              (setf (wxlambda:label-text caption) "Change rejected")))))
    (wxlambda:show-window frame)
    (values frame receiver reject apply binding (lambda () applied))))

(defun exercise ()
  (multiple-value-bind (frame receiver reject apply binding applied) (open-window)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (zerop (funcall applied)))
    (setf (wxlambda:checked-p reject) nil)
    (wxlambda:queue-click apply)
    (wxlambda:process-events)
    (assert (= 1 (funcall applied)))
    (wxlambda:off-click apply)
    (wxlambda:unbind-event binding)
    (wxlambda:destroy-event-handler receiver)
    (wxlambda:destroy-window frame)))

(defun start ()
  (wxlambda:with-application () (open-window) (wxlambda:run)))
