;;; Native search input with Lisp-native filtering and deferred cancel policy.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-search-controls (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-search-controls)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Search records λ" :width 480 :height 330))
         (panel (wxlambda:make-panel frame))
         (query (wxlambda:make-search-control panel :hint "Filter records — λ"))
         (records '("Alpha" "Lambda λ" "Lisp notes" "Calendar"))
         (results (wxlambda:make-list-box panel :items records))
         (feedback (wxlambda:make-label panel :label "4 results"))
         (clear (wxlambda:make-button panel :label "Clear filter")))
    (wxlambda:make-column panel)
    (wxlambda:add-child panel query :border 8)
    (wxlambda:add-child panel results :proportion 1 :expand t :border 8)
    (wxlambda:add-child panel feedback :border 8)
    (wxlambda:add-child panel clear :border 8)
    (labels ((filter-records ()
               (let* ((text (wxlambda:text query))
                      (matches (remove-if-not (lambda (record) (search text record :test #'char-equal)) records)))
                 (wxlambda:clear-items results)
                 (dolist (record matches) (wxlambda:append-item results record))
                 (setf (wxlambda:label-text feedback) (format nil "~D results" (length matches)))))
             (request-filter (&optional clear-p)
               (wxlambda:defer-ui-action
                 (lambda ()
                   (when clear-p (setf (wxlambda:text query) ""))
                   (filter-records)) :owner query)))
      (dolist (kind '(:text-change :search))
        (wxlambda:bind-event query kind (lambda (event) (declare (ignore event)) (request-filter))))
      (wxlambda:bind-event query :search-cancel
        (lambda (event) (declare (ignore event)) (request-filter t)))
      (wxlambda:on-click clear (lambda () (request-filter t))))
    (values frame query results clear feedback)))
(defun exercise ()
  (multiple-value-bind (frame query results clear feedback) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:text query :notify t) "λ")
           (loop repeat 30 until (= 1 (wxlambda:item-count results)) do (wxlambda:process-events))
           (assert (= 1 (wxlambda:item-count results)))
           (assert (string= "Lambda λ" (wxlambda:item-text results 0)))
           (wxlambda:queue-click clear)
           (loop repeat 30 until (= 4 (wxlambda:item-count results)) do (wxlambda:process-events))
           (assert (string= "" (wxlambda:text query)))
           (assert (= 4 (wxlambda:item-count results)))
           (assert (string= "4 results" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
