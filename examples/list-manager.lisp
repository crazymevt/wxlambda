;;; START is interactive; EXERCISE uses an existing application session.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-list-manager (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-list-manager)

(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Single-selection list manager" :width 580 :height 460))
         (panel (wxlambda:make-panel frame))
         (items (wxlambda:make-list-box panel :items '("Ada" "Grace λ" "日本語 😀")))
         (entry (wxlambda:make-text panel :value "New item"))
         (add (wxlambda:make-button panel :label "Append"))
         (rename (wxlambda:make-button panel :label "Rename selected"))
         (remove (wxlambda:make-button panel :label "Delete selected"))
         (clear (wxlambda:make-button panel :label "Clear all"))
         (status (wxlambda:make-label panel :label "Select one item")))
    (labels ((refresh ()
               (setf (wxlambda:label-text status)
                     (format nil "~D items; selection ~S" (wxlambda:item-count items) (wxlambda:selection items)))))
      (wxlambda:make-column frame)
      (wxlambda:add-child frame panel :proportion 1 :border 0)
      (wxlambda:make-column panel)
      (wxlambda:add-child panel items :proportion 1)
      (dolist (child (list entry add rename remove clear status)) (wxlambda:add-child panel child))
      (wxlambda:on-selection items
        (lambda (event)
          (when (wxlambda:event-selection event)
            (setf (wxlambda:text entry) (wxlambda:event-text event)))
          (refresh)))
      (wxlambda:bind-event items :listbox-double-click
        (lambda (event)
          (setf (wxlambda:label-text status) (format nil "Activated ~S" (wxlambda:event-text event)))))
      (wxlambda:on-click add
        (lambda ()
          (setf (wxlambda:selection items :notify t)
                (wxlambda:append-item items (wxlambda:text entry)))))
      (wxlambda:on-click rename
        (lambda ()
          (let ((index (wxlambda:selection items)))
            (when index (setf (wxlambda:item-text items index) (wxlambda:text entry))))
          (refresh)))
      (wxlambda:on-click remove
        (lambda ()
          (let ((index (wxlambda:selection items))) (when index (wxlambda:delete-item items index)))
          (refresh)))
      (wxlambda:on-click clear (lambda () (wxlambda:clear-items items) (refresh)))
      (values frame items entry (list add rename remove clear)))))

(defun exercise ()
  (multiple-value-bind (frame items entry buttons) (build-window)
    (declare (ignore buttons))
    (unwind-protect
         (progn
           (assert (null (wxlambda:selection items)))
           (setf (wxlambda:selection items :notify t) 1)
           (assert (string= "Grace λ" (wxlambda:text entry)))
           (assert (= 3 (wxlambda:append-item items "Another λ")))
           (wxlambda:delete-item items 0)
           (assert (= 0 (wxlambda:selection items)))
           (assert (string= "Grace λ" (wxlambda:item-text items 0)))
           (wxlambda:delete-item items 0)
           (assert (null (wxlambda:selection items)))
           (wxlambda:clear-items items)
           (assert (zerop (wxlambda:item-count items)))
           t)
      (wxlambda:destroy-window frame)
      (wxlambda:process-events))))

(defun start ()
  (wxlambda:with-application ()
    (multiple-value-bind (frame items) (build-window)
      (declare (ignore items))
      (unwind-protect (progn (wxlambda:show-window frame) (wxlambda:run))
        (when (wxlambda:handler-alive-p frame) (wxlambda:destroy-window frame))
        (wxlambda:process-events)))))
