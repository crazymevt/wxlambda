;;; START interactive. EXERCISE synchronizes through explicit numeric notifications.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-numeric-input (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-numeric-input)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Numeric input λ" :width 560 :height 300))
         (panel (wxlambda:make-panel frame))
         (slider (wxlambda:make-slider panel :minimum -100 :maximum 100 :value 25))
         (spin (wxlambda:make-spin-control panel :minimum -100 :maximum 100 :value 25))
         (label (wxlambda:make-label panel :label "Value: 25"))
         (narrow (wxlambda:make-button panel :label "Use range 0..10"))
         (changes 0))
    (labels ((update (event target)
               (incf changes)
               ;; Silent cross-control writes avoid recursive update callbacks.
               (let ((value (wxlambda:event-numeric-value event)))
                 (setf (wxlambda:numeric-value target) value
                       (wxlambda:label-text label) (format nil "Value: ~D" value)))))
      (wxlambda:bind-event slider :slider-change (lambda (event) (update event spin)))
      (wxlambda:bind-event spin :spin-change (lambda (event) (update event slider))))
    (wxlambda:on-click narrow
      (lambda ()
        (setf (wxlambda:numeric-range slider) '(0 10) (wxlambda:numeric-range spin) '(0 10)
              (wxlambda:label-text label) (format nil "Value: ~D" (wxlambda:numeric-value slider)))))
    (wxlambda:make-column panel)
    (dolist (child (list slider spin label narrow)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame slider spin label (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame slider spin label changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (setf (wxlambda:numeric-value slider :notify t) 40)
           (assert (= 40 (wxlambda:numeric-value spin)))
           (setf (wxlambda:numeric-value spin :notify t) -30)
           (assert (= -30 (wxlambda:numeric-value slider)))
           (assert (= 2 (funcall changes)))
           (assert (string= "Value: -30" (wxlambda:label-text label)))
           (setf (wxlambda:numeric-range slider) '(0 10) (wxlambda:numeric-range spin) '(0 10))
           (assert (= 0 (wxlambda:numeric-value slider) (wxlambda:numeric-value spin)))
           (assert (= 2 (funcall changes))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
