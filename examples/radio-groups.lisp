;;; Fixed mutually exclusive choices; START interactive, EXERCISE deterministic.
(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")
(defpackage #:wxlambda-radio-groups (:use #:cl) (:export #:start #:exercise))
(in-package #:wxlambda-radio-groups)
(defun build-window ()
  (let* ((frame (wxlambda:make-frame :title "Export options" :width 440 :height 260))
         (panel (wxlambda:make-panel frame))
         (format-choice (wxlambda:make-radio-box panel :label "Format" :items '("Text" "HTML" "Markdown")))
         (feedback (wxlambda:make-label panel :label "Format: Text"))
         (changes 0))
    (wxlambda:bind-event format-choice :radio-selection
      (lambda (event)
        (incf changes)
        (setf (wxlambda:label-text feedback)
              (format nil "Format: ~A" (wxlambda:item-text format-choice (wxlambda:event-selection event))))))
    (wxlambda:make-column panel)
    (dolist (child (list format-choice feedback)) (wxlambda:add-child panel child :border 12 :expand t))
    (values frame format-choice feedback (lambda () changes))))
(defun exercise ()
  (multiple-value-bind (frame choice feedback changes) (build-window)
    (unwind-protect
         (progn
           (wxlambda:show-window frame) (wxlambda:process-events)
           (assert (= 0 (wxlambda:selection choice)))
           (setf (wxlambda:selection choice) 1)
           (assert (zerop (funcall changes)))
           (setf (wxlambda:selection choice :notify t) 2)
           (assert (= 1 (funcall changes)))
           (assert (string= "Format: Markdown" (wxlambda:label-text feedback))) t)
      (wxlambda:destroy-window frame) (wxlambda:process-events))))
(defun start ()
  (wxlambda:with-application ()
    (let ((frame (build-window))) (wxlambda:show-window frame) (wxlambda:run))))
