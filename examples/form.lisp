(require :asdf)
(load (merge-pathnames "../wxlambda.asd" *load-truename*))
(asdf:load-system "wxlambda")

(wxlambda:with-application ()
  (let* ((frame (wxlambda:make-frame :title "A Lisp form" :width 560 :height 320))
         (root (wxlambda:make-panel frame))
         (name-row (wxlambda:make-panel root))
         (name-label (wxlambda:make-label name-row :label "Name"))
         (name (wxlambda:make-text name-row :value "Ada"))
         (greeting (wxlambda:make-checkbox root :label "Include a greeting" :checked t))
         (status (wxlambda:make-label root :label "Ready"))
         (submit (wxlambda:make-button root :label "Submit")))
    (wxlambda:make-column frame)
    (wxlambda:add-child frame root :border 0 :proportion 1)
    (wxlambda:make-column root)
    (wxlambda:make-row name-row)
    (wxlambda:add-child name-row name-label :border 0 :expand nil :align :center)
    (wxlambda:add-spacer name-row 12)
    (wxlambda:add-child name-row name :border 0 :proportion 1)
    (wxlambda:add-child root name-row :border 12)
    (wxlambda:add-child root greeting :border 12 :expand nil)
    (wxlambda:add-child root status :border 12)
    (wxlambda:add-stretch root)
    (wxlambda:add-child root submit :border 12 :expand nil :align :end)
    (wxlambda:on-toggle greeting
      (lambda (event)
        (wxlambda:set-label status
          (if (wxlambda:event-checked-p event) "Greeting enabled" "Greeting disabled"))
        (wxlambda:layout-window root)))
    (wxlambda:on-click submit
      (lambda ()
        (wxlambda:set-label status
          (format nil (if (wxlambda:checked-p greeting) "Hello, ~A!" "Name: ~A")
                  (wxlambda:get-text name)))
        (wxlambda:layout-window root)))
    (wxlambda:show-window frame)
    (wxlambda:run)))
